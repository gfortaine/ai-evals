+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  include PushTestHelper
+
+  setup do
+    @user = users(:david)
+  end
+
+  test "blocked notification permission reveals browser help instructions" do
+    sign_in_as(@user)
+
+    with_vapid_keys do
+      visit notifications_settings_url
+
+      assert_selector "button", text: "Turn on notifications"
+      assert_no_selector ".notifications-help", visible: :visible
+
+      click_button "Turn on notifications"
+
+      assert_text "Notifications are blocked for this browser."
+      assert_selector ".notifications-help", visible: :visible
+    end
+  end
+
+  test "turning on notifications subscribes with VAPID key, posts subscription, and updates UI" do
+    sign_in_as(@user)
+
+    with_vapid_keys do |vapid_key|
+      visit notifications_settings_url
+
+      assert_selector "button", text: "Turn on notifications"
+
+      # Stub browser Notification and PushManager APIs to simulate granting permission
+      page.execute_script(<<~JS)
+        window.__capturedSubscribeOptions = null;
+
+        const fakeSubscription = {
+          endpoint: "https://fcm.googleapis.com/fcm/send/system-test-token",
+          options: {},
+          toJSON() {
+            return {
+              endpoint: this.endpoint,
+              keys: {
+                p256dh: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+                auth: "tBHItJI5svbpez7KI4CCXg"
+              }
+            };
+          }
+        };
+
+        const fakeRegistration = {
+          pushManager: {
+            async getSubscription() { return null; },
+            async subscribe(options) {
+              window.__capturedSubscribeOptions = {
+                userVisibleOnly: options.userVisibleOnly,
+                applicationServerKey: Array.from(options.applicationServerKey)
+              };
+              fakeSubscription.options = options;
+              return fakeSubscription;
+            }
+          }
+        };
+
+        Object.defineProperty(Notification, "permission", {
+          configurable: true,
+          get: () => window.__fakePermission || "default"
+        });
+        Notification.requestPermission = async () => {
+          window.__fakePermission = "granted";
+          return "granted";
+        };
+        Object.defineProperty(navigator, "serviceWorker", {
+          configurable: true,
+          value: {
+            async getRegistration() { return fakeRegistration; },
+            async register() { return fakeRegistration; },
+            ready: Promise.resolve(fakeRegistration)
+          }
+        });
+      JS
+
+      click_button "Turn on notifications"
+
+      assert_selector ".notifications--on"
+      assert_text "Notifications are on for this device."
+      assert_no_selector "button", text: "Turn on notifications", visible: :visible
+
+      # Verify applicationServerKey matched VAPID_PUBLIC_KEY bytes
+      captured = page.evaluate_script("window.__capturedSubscribeOptions")
+      assert_equal true, captured["userVisibleOnly"]
+      assert_equal Base64.urlsafe_decode64(vapid_key.public_key).bytes, captured["applicationServerKey"]
+
+      # Verify subscription was persisted on the server
+      subscription = @user.push_subscriptions.find_by(endpoint: "https://fcm.googleapis.com/fcm/send/system-test-token")
+      assert subscription.present?, "Expected Push::Subscription to be persisted"
+      assert_equal "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM", subscription.p256dh_key
+      assert_equal "tBHItJI5svbpez7KI4CCXg", subscription.auth_key
+
+      # Verify help toggle works when notifications are enabled
+      click_button "Not getting notifications?"
+      assert_selector ".notifications-help", visible: :visible
+    end
+  end
+end
diff --git a/test/test_helpers/push_test_helper.rb b/test/test_helpers/push_test_helper.rb
new file mode 100644
index 0000000..4e04a14
--- /dev/null
+++ b/test/test_helpers/push_test_helper.rb
@@ -0,0 +1,75 @@
+module PushTestHelper
+  PUBLIC_TEST_IP = "93.184.216.34"
+
+  private
+    def with_vapid_keys(vapid_key = WebPush.generate_key)
+      original_public = ENV["VAPID_PUBLIC_KEY"]
+      original_private = ENV["VAPID_PRIVATE_KEY"]
+
+      ENV["VAPID_PUBLIC_KEY"] = vapid_key.public_key
+      ENV["VAPID_PRIVATE_KEY"] = vapid_key.private_key
+
+      yield vapid_key
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = original_public
+      ENV["VAPID_PRIVATE_KEY"] = original_private
+    end
+
+    def without_vapid_keys
+      original_public = ENV["VAPID_PUBLIC_KEY"]
+      original_private = ENV["VAPID_PRIVATE_KEY"]
+
+      ENV.delete("VAPID_PUBLIC_KEY")
+      ENV.delete("VAPID_PRIVATE_KEY")
+
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = original_public
+      ENV["VAPID_PRIVATE_KEY"] = original_private
+    end
+
+    def generate_push_client_keys
+      ec_key = OpenSSL::PKey::EC.generate("prime256v1")
+      auth_bytes = Random.bytes(16)
+
+      {
+        ec_key: ec_key,
+        p256dh_key: Base64.urlsafe_encode64(ec_key.public_key.to_octet_string(:uncompressed), padding: false),
+        auth_key: Base64.urlsafe_encode64(auth_bytes, padding: false),
+        auth_bytes: auth_bytes
+      }
+    end
+
+    def decrypt_web_push_payload(body, ec_key:, auth_bytes:)
+      body = body.b
+      salt = body.byteslice(0, 16)
+      idlen = body.getbyte(20)
+      server_public_key_bytes = body.byteslice(21, idlen)
+      ciphertext_and_tag = body.byteslice(21 + idlen..)
+
+      group = OpenSSL::PKey::EC::Group.new("prime256v1")
+      server_point = OpenSSL::PKey::EC::Point.new(group, OpenSSL::BN.new(server_public_key_bytes, 2))
+      shared_secret = ec_key.dh_compute_key(server_point)
+
+      client_public_key_bytes = ec_key.public_key.to_bn.to_s(2)
+      info = "WebPush: info\0".b + client_public_key_bytes + server_public_key_bytes
+
+      prk = OpenSSL::KDF.hkdf(shared_secret, salt: auth_bytes, info: info, hash: "SHA256", length: 32)
+      cek = OpenSSL::KDF.hkdf(prk, salt: salt, info: "Content-Encoding: aes128gcm\0", hash: "SHA256", length: 16)
+      nonce = OpenSSL::KDF.hkdf(prk, salt: salt, info: "Content-Encoding: nonce\0", hash: "SHA256", length: 12)
+
+      ciphertext = ciphertext_and_tag.byteslice(0...-16)
+      auth_tag = ciphertext_and_tag.byteslice(-16, 16)
+
+      decipher = OpenSSL::Cipher.new("aes-128-gcm")
+      decipher.decrypt
+      decipher.key = cek
+      decipher.iv = nonce
+      decipher.auth_tag = auth_tag
+
+      plaintext = decipher.update(ciphertext) + decipher.final
+      # Strip RFC 8188 record delimiter (0x02) and trailing 0x00 padding
+      delimiter_index = plaintext.rindex("\x02".b)
+      JSON.parse(plaintext.byteslice(0, delimiter_index).force_encoding("UTF-8"))
+    end
+end
