@@ -0,0 +1,191 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  include PushTestHelper
+
+  setup do
+    @user = users(:kevin)
+    stub_dns_resolution(PUBLIC_TEST_IP)
+  end
+
+  test "validates endpoint, p256dh_key, and auth_key presence" do
+    subscription = @user.push_subscriptions.new
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "validates endpoint must be HTTPS" do
+    invalid_endpoints = [
+      "not a url",
+      "http://fcm.googleapis.com/fcm/send/123",
+      "ftp://example.com/push",
+      "javascript:alert(1)",
+      "//example.com/push",
+      "https:///push"
+    ]
+
+    invalid_endpoints.each do |endpoint|
+      subscription = @user.push_subscriptions.new(endpoint: endpoint, p256dh_key: "key", auth_key: "auth")
+      assert_not subscription.valid?, "Expected #{endpoint.inspect} to be invalid"
+      assert_includes subscription.errors[:endpoint], "must be a valid HTTPS URL"
+    end
+  end
+
+  test "rejects private, loopback, and local endpoint hosts" do
+    blocked_endpoints = [
+      "https://localhost/push",
+      "https://sub.localhost/push",
+      "https://127.0.0.1/push",
+      "https://169.254.169.254/latest/meta-data/",
+      "https://10.0.0.1/push",
+      "https://192.168.1.1/push",
+      "https://[::1]/push",
+      "https://[fd00:ec2::254]/push"
+    ]
+
+    blocked_endpoints.each do |endpoint|
+      subscription = @user.push_subscriptions.new(endpoint: endpoint, p256dh_key: "key", auth_key: "auth")
+      assert_not subscription.valid?, "Expected #{endpoint.inspect} to be rejected"
+      assert_includes subscription.errors[:endpoint], "cannot point to a private or local address"
+    end
+  end
+
+  test "normalizes whitespace around endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "  https://fcm.googleapis.com/fcm/send/abc123  ",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_equal "https://fcm.googleapis.com/fcm/send/abc123", subscription.endpoint
+    assert_equal @user.account, subscription.account
+  end
+
+  test "deliver encrypts payload with aes128gcm, signs VAPID header, and pins resolved IP" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://example.com/push/device-1"
+    subscription = @user.push_subscriptions.create!(
+      endpoint: endpoint,
+      p256dh_key: client_keys[:p256dh_key],
+      auth_key: client_keys[:auth_key]
+    )
+
+    captured_request = nil
+    stub = stub_request(:post, endpoint)
+      .with(ipaddr: PUBLIC_TEST_IP)
+      .with { |req| captured_request = req; true }
+      .to_return(status: 201)
+
+    with_vapid_keys do |vapid_key|
+      subscription.deliver(
+        title: "RE: Layout is broken",
+        options: { body: "Looks good!", icon: "/app-icon-192.png", data: { path: "/897362094/cards/2" } }
+      )
+
+      assert_requested stub
+      assert_equal "aes128gcm", captured_request.headers["Content-Encoding"]
+      assert_equal "application/octet-stream", captured_request.headers["Content-Type"]
+      assert_match(/\Avapid t=[^,]+,k=#{Regexp.escape(vapid_key.public_key_for_push_header)}\z/, captured_request.headers["Authorization"])
+
+      # Verify VAPID JWT signature with VAPID public key
+      jwt_token = captured_request.headers["Authorization"][/t=([^,]+)/, 1]
+      decoded_jwt, = JWT.decode(jwt_token, vapid_key.curve, true, algorithm: "ES256")
+      assert_equal "https://example.com", decoded_jwt["aud"]
+      assert_match(/\Amailto:/, decoded_jwt["sub"])
+
+      # Decrypt the RFC 8291 payload and verify plaintext JSON
+      decrypted = decrypt_web_push_payload(
+        captured_request.body,
+        ec_key: client_keys[:ec_key],
+        auth_bytes: client_keys[:auth_bytes]
+      )
+      assert_equal "RE: Layout is broken", decrypted["title"]
+      assert_equal "Looks good!", decrypted.dig("options", "body")
+      assert_equal "/897362094/cards/2", decrypted.dig("options", "data", "path")
+    end
+  end
+
+  test "deliver blocks DNS rebinding to private IP" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://rebind.attacker.example/push"
+    subscription = @user.push_subscriptions.create!(
+      endpoint: endpoint,
+      p256dh_key: client_keys[:p256dh_key],
+      auth_key: client_keys[:auth_key]
+    )
+
+    stub_dns_resolution("169.254.169.254")
+    stub = stub_request(:post, endpoint).to_return(status: 201)
+
+    with_vapid_keys do
+      subscription.deliver(title: "Test", options: { body: "Blocked" })
+    end
+
+    assert_not_requested stub
+    assert Push::Subscription.exists?(subscription.id)
+  end
+
+  test "deliver destroys subscription on 410 Gone (expired)" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://example.com/push/expired"
+    subscription = @user.push_subscriptions.create!(
+      endpoint: endpoint,
+      p256dh_key: client_keys[:p256dh_key],
+      auth_key: client_keys[:auth_key]
+    )
+
+    stub_request(:post, endpoint).to_return(status: 410)
+
+    with_vapid_keys do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.deliver(title: "Test", options: { body: "Expired" })
+      end
+    end
+  end
+
+  test "deliver destroys subscription on 404 Not Found (invalid)" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://example.com/push/not-found"
+    subscription = @user.push_subscriptions.create!(
+      endpoint: endpoint,
+      p256dh_key: client_keys[:p256dh_key],
+      auth_key: client_keys[:auth_key]
+    )
+
+    stub_request(:post, endpoint).to_return(status: 404)
+
+    with_vapid_keys do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.deliver(title: "Test", options: { body: "Invalid" })
+      end
+    end
+  end
+
+  test "deliver keeps subscription on transient server error or timeout" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://example.com/push/transient"
+    subscription = @user.push_subscriptions.create!(
+      endpoint: endpoint,
+      p256dh_key: client_keys[:p256dh_key],
+      auth_key: client_keys[:auth_key]
+    )
+
+    stub_request(:post, endpoint).to_return(status: 503)
+
+    with_vapid_keys do
+      assert_no_difference -> { Push::Subscription.count } do
+        subscription.deliver(title: "Test", options: { body: "Retry later" })
+      end
+    end
+
+    stub_request(:post, endpoint).to_timeout
+
+    with_vapid_keys do
+      assert_no_difference -> { Push::Subscription.count } do
+        subscription.deliver(title: "Test", options: { body: "Timeout" })
+      end
+    end
+  end
+end
