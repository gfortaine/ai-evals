+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,35 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    if subscription = @user.push_subscriptions.find_by(endpoint: push_subscription_params[:endpoint])
+      subscription.assign_attributes(push_subscription_params.merge(user_agent: request.user_agent&.first(4096)))
+      subscription.changed? ? subscription.save! : subscription.touch
+      head :ok
+    else
+      @user.push_subscriptions.create!(push_subscription_params.merge(user_agent: request.user_agent&.first(4096)))
+      head :created
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..36beee1
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,202 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+import { isIos } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static classes = [ "enabled" ]
+  static targets = [ "bell", "details", "help", "notAllowedNotice", "notSupportedNotice", "status" ]
+  static values = { subscriptionsUrl: String }
+
+  async connect() {
+    if (!this.#isSupported) {
+      this.#showNotSupported()
+      return
+    }
+
+    switch (Notification.permission) {
+      case "granted":
+        await this.#syncExistingSubscription()
+        break
+      case "denied":
+        this.#showNotAllowed()
+        break
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (!this.#isSupported) {
+      this.#showNotSupported()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#showNotAllowed()
+      return
+    }
+
+    if (this.hasBellTarget) this.bellTarget.disabled = true
+
+    try {
+      const permission = Notification.permission === "granted"
+        ? "granted"
+        : await Notification.requestPermission()
+
+      if (permission === "granted") {
+        await this.#subscribe()
+      } else if (permission === "denied") {
+        this.#showNotAllowed()
+      }
+    } finally {
+      if (this.hasBellTarget) this.bellTarget.disabled = false
+    }
+  }
+
+  toggleHelp() {
+    if (!this.hasHelpTarget) return
+
+    const shouldShow = this.helpTarget.hidden
+    this.helpTarget.hidden = !shouldShow
+    this.detailsTargets.forEach((target) => {
+      target.hidden = !shouldShow
+    })
+  }
+
+  async #syncExistingSubscription() {
+    const registration = await this.#existingServiceWorkerRegistration()
+    const subscription = await registration?.pushManager?.getSubscription()
+
+    if (subscription && this.#matchesVapidKey(subscription)) {
+      const synced = await this.#syncSubscription(subscription)
+      if (synced) {
+        this.#showEnabled()
+      }
+    }
+  }
+
+  async #subscribe() {
+    const registration = await this.#serviceWorkerRegistration()
+    if (!registration?.pushManager) return
+
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && !this.#matchesVapidKey(subscription)) {
+      await subscription.unsubscribe()
+      subscription = null
+    }
+
+    if (!subscription) {
+      const vapidPublicKey = this.#vapidPublicKey
+      if (!vapidPublicKey) return
+
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#urlBase64ToUint8Array(vapidPublicKey)
+      })
+    }
+
+    if (await this.#syncSubscription(subscription)) {
+      this.#showEnabled()
+    }
+  }
+
+  async #syncSubscription(subscription) {
+    const push_subscription = this.#extractSubscriptionParams(subscription)
+    if (!push_subscription.endpoint || !push_subscription.p256dh_key || !push_subscription.auth_key) {
+      return false
+    }
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription }
+    })
+
+    return response.ok
+  }
+
+  async #existingServiceWorkerRegistration() {
+    const registration = await navigator.serviceWorker.getRegistration("/")
+    if (registration) {
+      return await navigator.serviceWorker.ready
+    }
+    return null
+  }
+
+  async #serviceWorkerRegistration() {
+    let registration = await navigator.serviceWorker.getRegistration("/")
+    if (!registration) {
+      registration = await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+    return await navigator.serviceWorker.ready
+  }
+
+  #extractSubscriptionParams(subscription) {
+    const json = typeof subscription.toJSON === "function" ? subscription.toJSON() : subscription
+    return {
+      endpoint: json.endpoint || subscription.endpoint,
+      p256dh_key: json.keys?.p256dh,
+      auth_key: json.keys?.auth
+    }
+  }
+
+  #matchesVapidKey(subscription) {
+    const existingKey = subscription.options?.applicationServerKey
+    const vapidPublicKey = this.#vapidPublicKey
+    if (!existingKey || !vapidPublicKey) return true
+
+    const existingBytes = new Uint8Array(existingKey)
+    const expectedBytes = this.#urlBase64ToUint8Array(vapidPublicKey)
+    if (existingBytes.length !== expectedBytes.length) return false
+
+    return existingBytes.every((byte, index) => byte === expectedBytes[index])
+  }
+
+  #showEnabled() {
+    this.element.classList.add(this.enabledClass)
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = true
+    if (this.hasNotSupportedNoticeTarget) this.notSupportedNoticeTarget.hidden = true
+    if (this.hasHelpTarget) this.helpTarget.hidden = true
+    this.detailsTargets.forEach((target) => {
+      target.hidden = true
+    })
+  }
+
+  #showNotAllowed() {
+    this.element.classList.remove(this.enabledClass)
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = false
+    if (this.hasNotSupportedNoticeTarget) this.notSupportedNoticeTarget.hidden = true
+    if (this.hasHelpTarget) this.helpTarget.hidden = false
+    this.detailsTargets.forEach((target) => {
+      target.hidden = false
+    })
+  }
+
+  #showNotSupported() {
+    this.element.classList.remove(this.enabledClass)
+    if (this.hasStatusTarget) this.statusTarget.hidden = true
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = true
+
+    if (isIos() && this.hasHelpTarget && this.helpTarget.querySelector(".pwa__instructions")) {
+      this.helpTarget.hidden = false
+      this.detailsTargets.forEach((target) => {
+        target.hidden = true
+      })
+    } else if (this.hasNotSupportedNoticeTarget) {
+      this.notSupportedNoticeTarget.hidden = false
+    }
+  }
+
+  get #isSupported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #vapidPublicKey() {
+    return getMetaContent("vapid-public-key")
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    return Uint8Array.from(rawData, (char) => char.charCodeAt(0))
+  }
+}
