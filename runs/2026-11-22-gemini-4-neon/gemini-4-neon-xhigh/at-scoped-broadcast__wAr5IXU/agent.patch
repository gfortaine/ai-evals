diff --git a/test/channels/leaves/being_edited_channel_test.rb b/test/channels/leaves/being_edited_channel_test.rb
new file mode 100644
index 0000000..548a2d4
--- /dev/null
+++ b/test/channels/leaves/being_edited_channel_test.rb
@@ -0,0 +1,199 @@
+require "test_helper"
+
+class Leaves::BeingEditedChannelTest < ActionCable::Channel::TestCase
+  test "allows active editor to subscribe to their own stream" do
+    leaf = leaves(:welcome_page)
+    kevin = users(:kevin)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, kevin))
+
+    stub_connection current_user: kevin
+    subscribe signed_stream_name: signed
+
+    assert subscription.confirmed?
+    assert_has_stream Leaves::BeingEditedChannel.stream_name_for(leaf, kevin)
+  end
+
+  test "allows active administrator with reader access to subscribe" do
+    leaf = leaves(:welcome_page)
+    jason = users(:jason)
+    books(:handbook).access_for(user: jason).update!(level: :reader)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, jason))
+
+    stub_connection current_user: jason
+    subscribe signed_stream_name: signed
+
+    assert subscription.confirmed?
+    assert_has_stream Leaves::BeingEditedChannel.stream_name_for(leaf, jason)
+  end
+
+  test "allows active administrator on published book without explicit access to subscribe" do
+    leaf = leaves(:welcome_page)
+    jason = users(:jason)
+    books(:handbook).update!(published: true, everyone_access: false)
+    books(:handbook).access_for(user: jason).destroy!
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, jason))
+
+    stub_connection current_user: jason
+    subscribe signed_stream_name: signed
+
+    assert subscription.confirmed?
+    assert_has_stream Leaves::BeingEditedChannel.stream_name_for(leaf, jason)
+  end
+
+  test "rejects reader" do
+    leaf = leaves(:welcome_page)
+    jz = users(:jz)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, jz))
+
+    stub_connection current_user: jz
+    subscribe signed_stream_name: signed
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects removed collaborator resubscribing with previously issued signed stream name" do
+    leaf = leaves(:welcome_page)
+    kevin = users(:kevin)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, kevin))
+
+    books(:handbook).update!(everyone_access: false)
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    stub_connection current_user: kevin
+    subscribe signed_stream_name: signed
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects downgraded collaborator resubscribing with previously issued signed stream name" do
+    leaf = leaves(:welcome_page)
+    kevin = users(:kevin)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, kevin))
+
+    books(:handbook).access_for(user: kevin).update!(level: :reader)
+
+    stub_connection current_user: kevin
+    subscribe signed_stream_name: signed
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects deactivated collaborator even when connection holds stale user object" do
+    leaf = leaves(:welcome_page)
+    stale_kevin = User.find(users(:kevin).id)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, stale_kevin))
+
+    users(:kevin).deactivate
+
+    stub_connection current_user: stale_kevin
+    subscribe signed_stream_name: signed
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects demoted administrator even when connection holds stale user object" do
+    leaf = leaves(:welcome_page)
+    books(:handbook).access_for(user: users(:jason)).update!(level: :reader)
+    stale_jason = User.find(users(:jason).id)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, stale_jason))
+
+    users(:jason).update!(role: :member)
+
+    stub_connection current_user: stale_jason
+    subscribe signed_stream_name: signed
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects subscribing to another editor's signed stream name" do
+    leaf = leaves(:welcome_page)
+    signed_for_jason = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, users(:jason)))
+
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: signed_for_jason
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects legacy shared stream name" do
+    leaf = leaves(:welcome_page)
+    legacy_signed = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited ])
+
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: legacy_signed
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects trashed leaf" do
+    leaf = leaves(:welcome_page)
+    kevin = users(:kevin)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, kevin))
+    leaf.trashed!
+
+    stub_connection current_user: kevin
+    subscribe signed_stream_name: signed
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects tampered or missing signed stream name" do
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: "invalid"
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects connection without current_user" do
+    leaf = leaves(:welcome_page)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, users(:kevin)))
+
+    stub_connection current_user: nil
+    subscribe signed_stream_name: signed
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "broadcast_being_edited_by delivers to subscribed editor and stops after removal" do
+    leaf = leaves(:welcome_page)
+    kevin = users(:kevin)
+    signed = Leaves::BeingEditedChannel.signed_stream_name(Leaves::BeingEditedChannel.streamables_for(leaf, kevin))
+
+    stub_connection current_user: kevin
+    subscribe signed_stream_name: signed
+    assert subscription.confirmed?
+
+    stream = subscription.streams.first
+
+    assert_broadcasts stream, 1 do
+      Leaves::BeingEditedChannel.broadcast_being_edited_by(leaf, users(:david))
+    end
+    assert_includes broadcasts(stream).last, "David"
+    assert_includes broadcasts(stream).last, "being_edited_leaf_#{leaf.id}"
+
+    books(:handbook).access_for(user: kevin).destroy!
+
+    assert_no_broadcasts stream do
+      Leaves::BeingEditedChannel.broadcast_being_edited_by(leaf, users(:david))
+    end
+  end
+
+  test "broadcast_being_edited_by does not broadcast for trashed leaves" do
+    leaf = leaves(:welcome_page)
+    leaf.trashed!
+
+    assert_no_broadcasts Leaves::BeingEditedChannel.stream_name_for(leaf, users(:kevin)) do
+      Leaves::BeingEditedChannel.broadcast_being_edited_by(leaf, users(:david))
+    end
+  end
+end
