diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..0a26ad3 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,46 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors returns active users who can edit the book" do
+    book = books(:handbook)
+
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort_by(&:id), book.editors.order(:id).to_a
+
+    # Downgrade member to reader
+    book.access_for(user: users(:kevin)).update!(level: :reader)
+    assert_not_includes book.editors, users(:kevin)
+
+    # Administrator with reader access can still edit
+    book.access_for(user: users(:jason)).update!(level: :reader)
+    assert_includes book.editors, users(:jason)
+
+    # Demoted administrator with reader access can no longer edit
+    users(:jason).update!(role: :member)
+    assert_not_includes book.editors, users(:jason)
+
+    # Deactivated editor is excluded even though their access row remains
+    users(:david).deactivate
+    assert_not_includes book.editors, users(:david)
+  end
+
+  test "editors respects published status for administrators without an access row" do
+    book = books(:manual)
+    book.update!(everyone_access: false, published: false)
+    book.access_for(user: users(:jason)).destroy!
+
+    assert_not_includes book.editors, users(:jason)
+
+    book.update!(published: true)
+    assert_includes book.editors, users(:jason)
+    assert_not_includes book.editors, users(:kevin)
+  end
+
+  test "accessable_or_published uses the explicit user argument" do
+    Current.user = users(:david)
+    assert_not_includes Book.accessable_or_published(user: users(:kevin)), books(:manual)
+    assert_includes Book.accessable_or_published(user: users(:kevin)), books(:handbook)
+  ensure
+    Current.reset
+  end
 end
