+    card1.image.attach(io: StringIO.new("file-one-contents"), filename: "one.png", content_type: "image/png")
+    card2.image.attach(io: StringIO.new("file-two-contents"), filename: "two.png", content_type: "image/png")
+
+    # Add a brand new user whose identity we will delete before import so import creates it
