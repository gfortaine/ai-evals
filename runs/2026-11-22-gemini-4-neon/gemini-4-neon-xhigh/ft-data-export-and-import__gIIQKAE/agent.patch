+    assert email.text_part.present?
+    assert_includes email.html_part.body.to_s, "The uploaded file is not a valid ZIP archive."
+    assert_includes email.text_part.body.to_s, "The uploaded file is not a valid ZIP archive."
+    assert_includes email.html_part.body.to_s, "/account/imports/new"
+  end
+end
diff --git a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
index 6017f88..93fe155 100644
--- a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
+++ b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
@@ -1,4 +1,106 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  test "exports sgids as portable gids and re-signs them for remapped records on import" do
+    source_account = accounts(:"37s")
+    Current.account = source_account
+
+    user = users(:david)
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    blob_html = ActionText::Attachment.from_attachable(blob).to_html
+    user_html = ActionText::Attachment.from_attachable(user).to_html
+    remote_html = %(<action-text-attachment url="https://example.com/demo.mp4" content-type="video/mp4" filename="demo.mp4"></action-text-attachment>)
+    card.update!(description: "<p>Hello #{user_html} check #{blob_html} and #{remote_html}</p>")
+
+    tempfile = Tempfile.new([ "richtext", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(source_account)
+    record_set.export(to: writer)
+    writer.close
+
+    tempfile.rewind
+    ZipFile.open(tempfile) do |reader|
+      exported_lines = reader.each_line("data/action_text_rich_texts/records.ndjson").map { |l| JSON.parse(l) }
+      card_rt = exported_lines.find { |r| r["record_type"] == "Card" && r["record_id"] == card.id && r["name"] == "description" }
+      assert_not_nil card_rt
+
+      fragment = Nokogiri::HTML::DocumentFragment.parse(card_rt["body"])
+      attachments = fragment.css("action-text-attachment")
+      assert_equal 3, attachments.size
+
+      # User attachment exported with gid, no sgid
+      user_node = attachments.find { |n| n["gid"]&.include?("/User/") }
+      assert_not_nil user_node
+      assert_nil user_node["sgid"]
+      assert_equal "gid://fizzy/User/#{user.id}", user_node["gid"]
+
+      # Blob attachment exported with gid, no sgid, no stale url
+      blob_node = attachments.find { |n| n["gid"]&.include?("/ActiveStorage::Blob/") }
+      assert_not_nil blob_node
+      assert_nil blob_node["sgid"]
+      assert_nil blob_node["url"]
+      assert_equal "gid://fizzy/ActiveStorage::Blob/#{blob.id}", blob_node["gid"]
+
+      # Remote attachment preserved as-is
+      remote_node = attachments.find { |n| n["url"] == "https://example.com/demo.mp4" }
+      assert_not_nil remote_node
+    end
+
+    # Now import into a brand new account and verify SGIDs & URLs point to NEW records
+    target_account = Account.create!(name: "Target Account")
+    new_user = target_account.users.create!(name: "David Copy", role: :member, identity: identities(:david))
+    Current.account = target_account
+    Current.user = new_user
+    new_board = target_account.boards.create!(name: "Target Board", creator: new_user)
+    new_card = new_board.cards.create!(title: "Target Card", creator: new_user, status: "published")
+    new_blob = Current.with_account(target_account) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+    end
+
+    context = Account::DataTransfer::ImportContext.new(identity: identities(:david))
+    context.account = target_account
+    context.register_id("User", user.id, new_user.id)
+    context.register_id("Card", card.id, new_card.id)
+    context.register_id("ActiveStorage::Blob", blob.id, new_blob.id)
+
+    tempfile.rewind
+    ZipFile.open(tempfile) do |reader|
+      Account::DataTransfer::ActionText::RichTextRecordSet.new(nil).import(from: reader, context: context)
+    end
+
+    imported_rt = ActionText::RichText.find_by!(account_id: target_account.id, record_type: "Card", record_id: new_card.id, name: "description")
+    attachables = imported_rt.body.attachments.map(&:attachable)
+
+    assert_includes attachables, new_user
+    assert_includes attachables, new_blob
+    assert_not_includes attachables, user
+    assert_not_includes attachables, blob
+
+    # Verify blob URL points to the new account slug
+    imported_fragment = Nokogiri::HTML::DocumentFragment.parse(imported_rt.read_attribute_before_type_cast("body"))
+    imported_blob_node = imported_fragment.css("action-text-attachment").find { |n| n["filename"] == "moon.jpg" }
+    assert_match %r{\A#{target_account.slug}/rails/active_storage/blobs/redirect/}, imported_blob_node["url"]
+    assert_nil imported_blob_node["gid"]
+    assert_not_nil imported_blob_node["sgid"]
+
+    # Verify SGID does not expire even years later
+    travel 10.years do
+      assert_equal new_blob, ActionText::Attachable.from_attachable_sgid(imported_blob_node["sgid"])
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
 end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..74f1807
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @owner = users(:jason)
+    @member = users(:david)
+  end
+
+  test "build_now creates zip archive, marks completed, and enqueues email" do
+    export = @account.exports.create!(user: @admin)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    export.reload
+    assert export.completed?
+    assert_not_nil export.completed_at
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    ZipFile.read_from(export.file) do |zip|
+      assert zip.exists?("manifest.json")
+      assert zip.exists?("data/accounts/records.ndjson")
+      assert zip.exists?("data/users/records.ndjson")
+      assert zip.exists?("data/boards/records.ndjson")
+      assert zip.exists?("data/cards/records.ndjson")
+      assert zip.exists?("data/comments/records.ndjson")
+    end
+  end
+
+  test "excludes previous export blobs and attachments from new exports" do
+    first_export = @account.exports.create!(user: @admin)
+    first_export.build_now
+    first_blob_id = first_export.file.blob.id
+
+    second_export = @account.exports.create!(user: @admin)
+    second_export.build_now
+
+    ZipFile.read_from(second_export.file) do |zip|
+      if zip.exists?("data/active_storage_blobs/records.ndjson")
+        blob_ids = zip.each_line("data/active_storage_blobs/records.ndjson").map { |l| JSON.parse(l)["id"] }
+        assert_not_includes blob_ids, first_blob_id
+      end
+      assert_not zip.exists?("storage/files/#{first_export.file.blob.key}")
+    end
+  end
+
+  test "accessible_to? enforces admin role, account match, and 24-hour expiration" do
+    export = @account.exports.create!(user: @admin)
+    assert_not export.accessible_to?(@admin), "Pending export should not be accessible"
+
+    export.build_now
+    assert export.accessible_to?(@admin)
+    assert export.accessible_to?(@owner)
+    assert_not export.accessible_to?(@member)
+    assert_not export.accessible_to?(users(:mike))
+    assert_not export.accessible_to?(nil)
+
+    travel 23.hours do
+      assert export.accessible_to?(@admin)
+    end
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.accessible_to?(@admin)
+    end
+  end
+
+  test "cleanup destroys expired exports and preserves current ones" do
+    fresh = @account.exports.create!(user: @admin)
+    fresh.build_now
+
+    expired = @account.exports.create!(user: @admin)
+    expired.build_now
+    expired.update_column(:completed_at, 25.hours.ago)
+
+    stale_pending = @account.exports.create!(user: @admin)
+    stale_pending.update_column(:updated_at, 3.days.ago)
+
+    Export.cleanup
+
+    assert Export.exists?(fresh.id)
+    assert_not Export.exists?(expired.id)
+    assert_not Export.exists?(stale_pending.id)
+  end
+end
