+  test "reader reads deflated and stored entries and streams lines with multibyte utf-8" do
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+
+    # Build a line that spans past a 64KB chunk boundary with 4-byte emoji
+    big_line = ("a" * 65_534) + "🎉" + "end"
+    lines_content = "#{big_line}\nsecond line 🚀\n"
+    binary_content = (0..255).to_a.pack("C*") * 500
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("data/lines.ndjson", lines_content, compress: true)
+    writer.add_file("storage/files/bin", binary_content, compress: false)
+    writer.add_file("empty.txt", "", compress: false)
+    writer.close
+
+    tempfile.rewind
+    ZipFile.open(tempfile) do |reader|
+      assert_equal [ "data/lines.ndjson", "empty.txt", "storage/files/bin" ], reader.entries
+      assert_equal [ "data/lines.ndjson" ], reader.glob("data/*.ndjson")
+      assert_equal binary_content.bytesize, reader.entry_size("storage/files/bin")
+
+      collected_lines = []
+      reader.each_line("data/lines.ndjson") { |line| collected_lines << line }
+      assert_equal [ "#{big_line}\n", "second line 🚀\n" ], collected_lines
+
+      streamed = +"".b
+      reader.read_stream("storage/files/bin", chunk_size: 4096) { |chunk| streamed << chunk }
+      assert_equal binary_content, streamed
+
+      # Test EntryIO with IO.copy_stream and rewind and read(0)
+      reader.open_entry("storage/files/bin") do |entry_io|
+        assert_equal "", entry_io.read(0)
+        out = StringIO.new(+"")
+        out.binmode
+        IO.copy_stream(entry_io, out)
+        assert_equal binary_content, out.string
+
+        entry_io.rewind
+        assert_equal binary_content, entry_io.read
+      end
+
+      assert_equal "", reader.read("empty.txt")
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "reader rejects invalid zip archives" do
+    assert_raises ZipFile::InvalidZipError do
