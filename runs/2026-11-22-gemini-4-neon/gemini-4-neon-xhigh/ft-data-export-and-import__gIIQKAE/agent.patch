+class Users::DataExportsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+  before_action :set_export, only: :show
+
+  def show
+    if @export
+      respond_to do |format|
+        format.html
+        format.zip { redirect_to rails_blob_path(@export.file, disposition: :attachment), allow_other_host: false }
+      end
+    else
+      respond_to do |format|
+        format.html { render :expired, status: :not_found }
+        format.any { head :not_found }
+      end
+    end
+  end
+
+  def create
+    export = @user.data_exports.create!(account: Current.account)
+    export.build_later
+
+    redirect_to @user, notice: "Export started. We’ll email you a link when it’s ready."
+  end
