+      parsed = JSON.parse(zip.read("#{card.number}.json"))
+      assert_equal card.title, parsed["title"]
+      assert_equal 5, parsed["comments"].size
+    end
+
+    # Link stops working after 1 day
+    travel 25.hours do
+      get user_data_export_path(users(:david), export)
+      assert_response :not_found
+
+      get rails_blob_path(export.file, disposition: :attachment)
+      assert_response :forbidden
+    end
+  end
+
+  test "user cannot create or download another user's data export even as an admin" do
+    export = users(:david).data_exports.create!(account: accounts(:"37s"))
+    export.build_now
+
+    sign_in_as :kevin # Kevin is admin, not David
+
+    assert_no_difference -> { User::DataExport.count } do
+      post user_data_exports_path(users(:david))
+    end
+    assert_response :forbidden
+
+    get user_data_export_path(users(:david), export)
+    assert_response :forbidden
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+end
