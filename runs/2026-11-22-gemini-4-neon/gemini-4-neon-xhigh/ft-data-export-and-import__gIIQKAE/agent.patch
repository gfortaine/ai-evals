+require "test_helper"
+
+class Users::DataExportsControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "user sees export section on own profile page but not on another user's profile page" do
+    sign_in_as :david
+
+    get user_path(users(:david))
+    assert_response :success
+    assert_select "h2", text: "Export data"
+
+    get user_path(users(:kevin))
+    assert_response :success
+    assert_select "h2", text: "Export data", count: 0
+  end
+
+  test "any signed-in user can export the cards they can see, receive email, and download within 24 hours" do
+    Current.account = accounts(:"37s")
+    Current.user = users(:kevin)
+    private_card = boards(:private).cards.create!(title: "Secret Card", creator: users(:kevin), status: "published")
+
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "logo.jpg", content_type: "image/jpeg")
+
+    sign_in_as :david
+    clear_enqueued_jobs
+
+    assert_difference -> { User::DataExport.count }, +1 do
+      assert_enqueued_with job: ExportJob do
+        post user_data_exports_path(users(:david))
+      end
+    end
+
+    assert_redirected_to user_path(users(:david))
+    export = User::DataExport.last
+
+    perform_enqueued_jobs # run export/import job
+    perform_enqueued_jobs # deliver email
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_includes email.body.encoded, user_data_export_path(users(:david), export)
+
+    get user_data_export_path(users(:david), export)
+    assert_response :success
+    assert_select "a[data-controller='auto-click']"
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+
+    ZipFile.open(StringIO.new(response.body)) do |zip|
+      assert zip.exists?("#{card.number}.json")
+      assert zip.exists?("#{card.number}/logo.jpg")
+      assert_not zip.exists?("#{private_card.number}.json")
