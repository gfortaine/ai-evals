diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
new file mode 100644
index 0000000..a07c9e5
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @david = users(:david)
+    @kevin = users(:kevin)
+    Current.account = @account
+    Current.user = @kevin
+  end
+
+  test "exports only published cards visible to user with comments and all attached pictures and files" do
+    # Add a published card on a private board David cannot access
+    private_board = boards(:private)
+    private_card = private_board.cards.create!(title: "Top Secret", creator: @kevin, status: "published")
+
+    # Add a drafted card on Writebook (accessible board, but unpublished)
+    draft_card = boards(:writebook).cards.create!(title: "Unpublished Draft", creator: @david, status: "drafted")
+
+    # Attach header image, description embed, and comment embed to card :logo (visible to David)
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "header.jpg", content_type: "image/jpeg")
+
+    desc_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("PDF document content"),
+      filename: "spec.pdf",
+      content_type: "application/pdf"
+    )
+    desc_embed = ActionText::Attachment.from_attachable(desc_blob).to_html
+    card.update!(description: "<p>See attached spec #{desc_embed}</p>")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "header.jpg", # Deliberately duplicate filename to test deduplication
+      content_type: "image/jpeg"
+    )
+    comment_embed = ActionText::Attachment.from_attachable(comment_blob).to_html
+    comment = card.comments.create!(creator: @kevin, body: "<p>Screenshot attached #{comment_embed}</p>")
+
+    export = @david.data_exports.create!(account: @account)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    export.reload
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      # Should contain published accessible cards (1..5), NOT private_card or draft_card
+      assert zip.exists?("#{card.number}.json")
+      assert_not zip.exists?("#{private_card.number}.json")
+      assert_not zip.exists?("#{draft_card.number}.json")
+
+      # Should NOT contain cards from other accounts
+      assert_not zip.entries.any? { |e| e.include?("radio") }
+
+      card_json = JSON.parse(zip.read("#{card.number}.json"))
+      assert_equal card.title, card_json["title"]
+      assert_equal "Writebook", card_json["board"]
+      assert_equal card.number, card_json["number"]
+      assert_includes card_json["description_plain_text"], "See attached spec"
+
+      # Header image exported and matches original bytes
+      assert_equal "#{card.number}/header.jpg", card_json["image"]
+      assert zip.exists?(card_json["image"])
+      assert_equal file_fixture("moon.jpg").binread, zip.read(card_json["image"])
+
+      # Description file attachment exported and matches original bytes
+      assert_equal 1, card_json["attachments"].size
+      assert_equal "spec.pdf", card_json["attachments"].first["filename"]
+      assert_equal "PDF document content", zip.read(card_json["attachments"].first["path"])
+
+      # Comments included chronologically with their attached picture (deduplicated filename)
+      exported_comment = card_json["comments"].find { |c| c["id"] == comment.id }
+      assert_not_nil exported_comment
+      assert_includes exported_comment["body_plain_text"], "Screenshot attached"
+      assert_equal 1, exported_comment["attachments"].size
+      comment_att_path = exported_comment["attachments"].first["path"]
+      assert_equal "#{card.number}/header-1.jpg", comment_att_path
+      assert_equal file_fixture("moon.jpg").binread, zip.read(comment_att_path)
+    end
+  end
+
+  test "accessible_to? only permits owning user within 24 hours" do
+    export = @david.data_exports.create!(account: @account)
+    assert_not export.accessible_to?(@david)
+
+    export.build_now
+    assert export.accessible_to?(@david)
+    assert_not export.accessible_to?(@kevin), "Even admins cannot download another user's personal export"
+    assert_not export.accessible_to?(users(:jason))
+    assert_not export.accessible_to?(nil)
+
+    travel 25.hours do
+      assert_not export.accessible_to?(@david)
+    end
+  end
+end
