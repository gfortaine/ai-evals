+<% @page_title = "Import an account" %>
+
+<div class="panel panel--centered flex flex-column gap">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <p class="margin-none">
+    Upload a Fizzy account export (.zip) to create a new account with all of its boards, cards, comments, files, and people. We’ll email <strong><%= Current.identity.email_address %></strong> when it’s done.
+  </p>
+
+  <%= form_with model: @import, url: account_imports_path(script_name: nil), class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+    <label class="btn input--upload" data-controller="upload-preview">
+      <%= form.file_field :file, accept: ".zip,application/zip", required: true, direct_upload: true,
+          data: { upload_preview_target: "input", action: "change->upload-preview#previewFileName" } %>
+      <span data-upload-preview-target="placeholder">Choose a Fizzy export (.zip)</span>
+      <span data-upload-preview-target="fileName" hidden></span>
+    </label>
+
+    <% if @import.errors.any? %>
+      <div class="margin-block-half txt-negative txt-small" style="text-align: left;">
+        <p class="margin-block-none font-weight-bold">Your import couldn’t be started:</p>
+        <ul class="margin-block-none">
+          <% @import.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Start import</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
