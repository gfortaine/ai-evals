+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.account
+    @identity = import.identity
+
+    mail(
+      to: @identity.email_address,
+      subject: "Your Fizzy account import is ready"
+    )
+  end
+
+  def failed(import)
+    @import = import
+    @identity = import.identity
+
+    mail(
+      to: @identity.email_address,
+      subject: "Your Fizzy account import couldn't be completed"
+    )
+  end
+end
