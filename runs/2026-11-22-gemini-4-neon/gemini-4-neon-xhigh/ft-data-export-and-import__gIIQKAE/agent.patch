+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_export, only: :show
+
+  def show
+    if @export
+      respond_to do |format|
+        format.html
+        format.zip { redirect_to rails_blob_path(@export.file, disposition: :attachment), allow_other_host: false }
+      end
+    else
+      respond_to do |format|
+        format.html { render :expired, status: :not_found }
+        format.any { head :not_found }
+      end
+    end
+  end
+
+  def create
+    export = Current.account.exports.create!(user: Current.user)
+    export.build_later
+
+    redirect_to account_settings_path, notice: "Export started. We’ll email you a link when it’s ready."
+  end
+
+  private
+    def set_export
+      @export = Current.account.exports.completed.current.find_by(id: params[:id])
+    end
+end
