+      <strong><%= @import.account.name %></strong> has been imported with all of its boards, cards, comments, files, and people.
+    </p>
+
+    <div class="flex justify-center">
+      <%= link_to "Open #{@import.account.name}", root_path(script_name: @import.account.slug), class: "btn btn--link" %>
+    </div>
+  <% elsif @import.failed? %>
+    <h1 class="txt-x-large font-weight-black margin-none txt-negative">Import couldn’t be completed</h1>
+
+    <p class="margin-none">
+      <%= @import.error_message.presence || "We couldn’t import your account." %>
+    </p>
+
+    <p class="txt-small txt-subtle margin-none">
+      No partial account or data was left behind.
+    </p>
+
+    <div class="flex justify-center">
+      <%= link_to "Try again", new_account_import_path(script_name: nil), class: "btn btn--link" %>
+    </div>
+  <% else %>
+    <h1 class="txt-x-large font-weight-black margin-none">Importing your account…</h1>
+
+    <p class="margin-none">
+      We’re importing your account in the background. We’ll send an email to <strong><%= Current.identity.email_address %></strong> as soon as it’s done.
+    </p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
