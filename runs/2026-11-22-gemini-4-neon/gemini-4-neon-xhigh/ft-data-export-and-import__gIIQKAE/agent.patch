diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..b68d2be
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,70 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  validate :file_must_be_attached, on: :create
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    processing!
+
+    imported_account = ZipFile.read_from(file) do |zip|
+      Account::DataTransfer::Manifest.import(from: zip, identity: identity)
+    end
+
+    update!(status: :completed, account: imported_account, error_message: nil)
+    purge_uploaded_file
+    ImportMailer.completed(self).deliver_later
+  rescue ZipFile::InvalidZipError, Account::DataTransfer::Error, ActiveStorage::IntegrityError,
+         ActiveRecord::RecordInvalid, ActiveRecord::RecordNotUnique, JSON::ParserError => e
+    fail_import(human_error_message(e))
+  rescue StandardError => e
+    Rails.error.report(e, context: { account_import_id: id, identity_id: identity_id })
+    fail_import("An unexpected error occurred while importing your account.")
+  end
+
+  private
+    def file_must_be_attached
+      unless file.attached?
+        errors.add(:file, "must be selected")
+      end
+    end
+
+    def fail_import(reason)
+      update!(status: :failed, account: nil, error_message: reason)
+      purge_uploaded_file
+      ImportMailer.failed(self).deliver_later
+    end
+
+    def purge_uploaded_file
+      file.purge if file.attached?
+    rescue StandardError => e
+      Rails.error.report(e, context: { account_import_id: id, message: "Failed to purge import file" })
+    end
+
+    def human_error_message(error)
+      case error
+      when ZipFile::InvalidZipError
+        "The uploaded file is not a valid ZIP archive."
+      when Account::DataTransfer::Error
+        error.message
+      when ActiveStorage::IntegrityError
+        "One or more files in the export archive failed integrity verification."
+      when ActiveRecord::RecordInvalid
+        "The export contains invalid data: #{error.record.errors.full_messages.to_sentence}."
+      when ActiveRecord::RecordNotUnique
+        "The export contains duplicate records that could not be imported."
+      when JSON::ParserError
+        "The export contains malformed JSON data."
+      else
+        "An unexpected error occurred while importing your account."
+      end
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..a3fc736
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,67 @@
+class Export < ApplicationRecord
+  EXPORT_EXPIRATION = 24.hours
+  STALE_INCOMPLETE_THRESHOLD = 2.days
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :status, %w[ pending completed failed ].index_by(&:itself), default: :pending
+
+  scope :current, -> { where(completed_at: EXPORT_EXPIRATION.ago..) }
+  scope :expired, -> { where(completed_at: ...EXPORT_EXPIRATION.ago) }
+  scope :stale_incomplete, -> { where(status: %w[ pending failed ], updated_at: ...STALE_INCOMPLETE_THRESHOLD.ago) }
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy)
+      stale_incomplete.find_each(&:destroy)
+    end
+  end
+
+  def build_later
+    ExportJob.perform_later(self)
+  end
+
+  def build_now
+    Current.with_account(account) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        populate_zip(zip)
+      end
+
+      mark_completed
+      notify_user
+    end
+  rescue StandardError
+    update(status: :failed) if persisted?
+    raise
+  end
+
+  def expired?
+    completed_at.present? && completed_at < EXPORT_EXPIRATION.ago
+  end
+
+  def accessible_to?(_accessor)
+    false
+  end
+
+  def filename
+    "fizzy-export-#{id}.zip"
+  end
+
+  private
+    def populate_zip(_zip)
+      raise NotImplementedError, "Subclasses must implement populate_zip"
+    end
+
+    def mark_completed
+      update!(status: :completed, completed_at: Time.current)
+    end
+
+    def notify_user
+      if user.identity&.email_address.present?
+        ExportMailer.completed(self).deliver_later
+      end
+    end
+end
