+
+  test "empty account can be exported and imported cleanly" do
+    empty_account = Account.create!(name: "Empty Corp")
+    empty_account.users.create!(role: :system, name: "System")
+    owner = empty_account.users.create!(role: :owner, name: "Solo Owner", identity: identities(:mike), verified_at: Time.current)
