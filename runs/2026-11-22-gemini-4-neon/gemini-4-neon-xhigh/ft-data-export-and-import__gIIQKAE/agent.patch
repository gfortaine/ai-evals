@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "admin sees export section in account settings and member does not" do
+    sign_in_as :kevin
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: "Export account"
+
+    logout_and_sign_in_as :david
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: "Export account", count: 0
+  end
+
+  test "admin can create account export, receive email, and download zip within 24 hours" do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+
+    assert_difference -> { Account::Export.count }, +1 do
+      assert_enqueued_with job: ExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    export = Account::Export.last
+
+    # Pending export cannot be downloaded yet
+    get account_export_path(export)
+    assert_response :not_found
+
+    # Perform export job and mail delivery
+    perform_enqueued_jobs # run export/import job
+    perform_enqueued_jobs # deliver email
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_includes email.body.encoded, account_export_path(export)
+
+    # Admin can open the download page and download the zip
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a[data-controller='auto-click']"
+
+    # Following the blob download link returns the valid zip file
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+
+    ZipFile.open(StringIO.new(response.body)) do |zip|
+      assert zip.exists?("manifest.json")
+      assert zip.exists?("data/accounts/records.ndjson")
+      assert zip.exists?("data/cards/records.ndjson")
+    end
+
+    # .zip format redirects to attachment download
+    get account_export_path(export, format: :zip)
+    assert_response :redirect
+
+    # Still works at 23 hours
+    travel 23.hours do
+      get account_export_path(export)
+      assert_response :success
+    end
+
+    # Link stops working after 1 day (24 hours)
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :not_found
+
+      get rails_blob_path(export.file, disposition: :attachment)
+      assert_response :forbidden
+    end
+  end
+
+  test "owner can create and download account export" do
+    sign_in_as :jason
+
+    assert_difference -> { Account::Export.count }, +1 do
+      post account_exports_path
+    end
+    assert_redirected_to account_settings_path
+  end
+
+  test "non-admin member cannot create or download account export" do
+    export = accounts(:"37s").exports.create!(user: users(:kevin))
+    export.build_now
+
+    sign_in_as :david
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    get account_export_path(export)
+    assert_response :forbidden
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+
+  test "admin from another account cannot download export" do
+    export = accounts(:"37s").exports.create!(user: users(:kevin))
+    export.build_now
+
+    sign_in_as :mike
+    get account_export_path(export, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+end
