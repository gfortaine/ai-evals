+class User::DataExport < Export
+  def accessible_to?(accessor)
+    accessor.present? && accessor == user && completed? && !expired?
+  end
+
+  def filename
+    "fizzy-export-#{id}.zip"
+  end
+
+  private
+    def populate_zip(zip)
+      cards_scope.find_each(batch_size: 100) do |card|
+        export_card(card, zip)
+      end
+    end
+
+    def cards_scope
+      user.accessible_cards.published.includes(
+        :board, :column, :tags, :steps, :closure, :goldness, :not_now,
+        creator: :identity,
+        assignees: :identity,
+        reactions: :reacter,
+        image_attachment: :blob,
+        rich_text_description: { embeds_attachments: :blob }
+      )
+    end
+
+    def export_card(card, zip)
+      blob_paths = {}
+      used_paths = Set.new
+
+      image_path = if card.image.attached?
+        add_blob_to_zip(card.image.blob, card.number, zip, blob_paths, used_paths)
+      end
+
+      description_attachments = export_rich_text_embeds(
+        card.rich_text_description, card.number, zip, blob_paths, used_paths
+      )
+
+      comments_payload = card.comments.chronologically.includes(
+        creator: :identity,
+        reactions: :reacter,
+        rich_text_body: { embeds_attachments: :blob }
+      ).map do |comment|
+        comment_attachments = export_rich_text_embeds(
+          comment.rich_text_body, card.number, zip, blob_paths, used_paths
+        )
+
+        {
+          id: comment.id,
+          creator: serialize_user(comment.creator),
+          body: rewrite_rich_text_html(comment.rich_text_body, blob_paths),
+          body_plain_text: comment.body.to_plain_text,
+          created_at: comment.created_at.utc.iso8601,
+          updated_at: comment.updated_at.utc.iso8601,
+          attachments: comment_attachments,
+          reactions: serialize_reactions(comment.reactions)
+        }
+      end
+
+      payload = {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        board: card.board.name,
+        column: card.column&.name,
+        creator: serialize_user(card.creator),
+        assignees: card.assignees.map { |assignee| serialize_user(assignee) },
+        tags: card.tags.map(&:title).sort,
+        steps: card.steps.map { |step| { id: step.id, content: step.content, completed: step.completed } },
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        due_on: card.due_on&.iso8601,
+        created_at: card.created_at.utc.iso8601,
+        updated_at: card.updated_at.utc.iso8601,
+        last_active_at: card.last_active_at.utc.iso8601,
+        description: rewrite_rich_text_html(card.rich_text_description, blob_paths),
+        description_plain_text: card.description.to_plain_text,
+        image: image_path,
+        attachments: description_attachments,
+        reactions: serialize_reactions(card.reactions),
+        comments: comments_payload
+      }
+
+      zip.add_file("#{card.number}.json", JSON.pretty_generate(payload))
+    end
+
+    def export_rich_text_embeds(rich_text, card_number, zip, blob_paths, used_paths)
+      return [] unless rich_text
+
+      blobs = rich_text.embeds_attachments.map(&:blob)
+      if rich_text.body
+        blobs.concat(rich_text.body.attachables.grep(ActiveStorage::Blob))
+      end
+
+      blobs.uniq(&:id).filter_map do |blob|
+        path = add_blob_to_zip(blob, card_number, zip, blob_paths, used_paths)
+        next unless path
+
+        {
+          filename: blob.filename.to_s,
+          content_type: blob.content_type,
+          byte_size: blob.byte_size,
+          path: path
+        }
+      end
+    end
+
+    def add_blob_to_zip(blob, card_number, zip, blob_paths, used_paths)
+      return blob_paths[blob.id] if blob_paths.key?(blob.id)
+      return nil unless blob.service.exist?(blob.key)
+
+      path = unique_attachment_path(card_number, blob.filename.to_s, used_paths)
+      zip.add_file(path, compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+
+      blob_paths[blob.id] = path
+      used_paths << path
+      path
+    rescue ActiveStorage::FileNotFoundError
+      nil
+    end
+
+    def unique_attachment_path(card_number, raw_filename, used_paths)
+      safe_name = File.basename(raw_filename.to_s).gsub(/\A\.+/, "")
+      safe_name = "attachment" if safe_name.blank?
+
+      candidate = "#{card_number}/#{safe_name}"
+      return candidate unless used_paths.include?(candidate)
+
+      ext = File.extname(safe_name)
+      base = File.basename(safe_name, ext)
+      counter = 1
+
+      loop do
+        candidate = "#{card_number}/#{base}-#{counter}#{ext}"
+        return candidate unless used_paths.include?(candidate)
+
+        counter += 1
+      end
+    end
+
+    def rewrite_rich_text_html(rich_text, blob_paths)
+      html = rich_text&.read_attribute_before_type_cast("body")
+      return "" if html.blank?
+      return html unless html.include?("action-text-attachment")
+
+      fragment = Nokogiri::HTML::DocumentFragment.parse(html)
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        parsed = SignedGlobalID.parse(node["sgid"], for: "attachable")
+        next unless parsed
+
+        if parsed.model_name == "ActiveStorage::Blob" && blob_paths[parsed.model_id]
+          node["url"] = blob_paths[parsed.model_id]
+        end
+        node.remove_attribute("sgid")
+      end
+
+      fragment.to_html
+    end
+
+    def serialize_user(record)
+      return nil unless record
+
+      {
+        id: record.id,
+        name: record.name,
+        email_address: record.identity&.email_address
+      }
+    end
+
+    def serialize_reactions(reactions)
+      reactions.map do |reaction|
+        {
+          content: reaction.content,
+          reacter: reaction.reacter ? { id: reaction.reacter.id, name: reaction.reacter.name } : nil,
+          created_at: reaction.created_at.utc.iso8601
+        }
+      end
+    end
+end
