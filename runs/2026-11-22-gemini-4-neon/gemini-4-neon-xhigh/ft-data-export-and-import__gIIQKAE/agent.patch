+    assert_equal [ imported_triage.id ], imported_filter.column_ids
+    assert_equal [ "web" ], imported_filter.tags.pluck(:title)
+    assert_equal [ imported_david.id ], imported_filter.assignees.pluck(:id)
+
+    # Full-text search works immediately on imported account
+    Current.with_account(imported) do
