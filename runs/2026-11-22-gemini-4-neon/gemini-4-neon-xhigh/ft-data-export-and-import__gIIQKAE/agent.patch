+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "unauthenticated user is redirected from /account/imports/new" do
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :redirect
+  end
+
+  test "signed-in user can view /account/imports/new" do
+    sign_in_as :kevin
+
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :success
+    assert_select "h1", text: "Import an account"
+    assert_select "input[type=file][data-direct-upload-url]"
+  end
+
+  test "tenanted request to account/imports/new redirects to root" do
+    sign_in_as :kevin
+
+    get new_account_import_path
+    assert_redirected_to root_url
+  end
+
+  test "submitting without a file returns 422" do
+    sign_in_as :kevin
+
+    untenanted do
+      assert_no_difference -> { Account::Import.count } do
+        post account_imports_path
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "uploading a valid account export creates a new account and emails the user" do
+    export = accounts(:"37s").exports.create!(user: users(:kevin))
+    export.build_now
+    zip_tempfile = Tempfile.new([ "account-export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    sign_in_as :kevin
+    clear_enqueued_jobs
+    ActionMailer::Base.deliveries.clear
+
+    uploaded = Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip", true, original_filename: "account.zip")
+
+    untenanted do
+      assert_difference -> { Account::Import.count }, +1 do
+        assert_enqueued_with job: Account::ImportJob do
+          post account_imports_path, params: { account_import: { file: uploaded } }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    untenanted do
+      assert_redirected_to account_import_path(import)
+
+      get account_import_path(import)
+      assert_response :success
+      assert_select "h1", text: /Importing/i
+    end
+
+    assert_difference -> { Account.count }, +1 do
+      perform_enqueued_jobs # run export/import job
+    perform_enqueued_jobs # deliver email
+    end
+
+    import.reload
+    assert import.completed?
+    assert_not_nil import.account
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_includes email.subject, "import is ready"
+    assert_includes email.body.encoded, import.account.slug
+
+    untenanted do
+      get account_import_path(import)
+      assert_response :success
+      assert_select "h1", text: "Your account is ready"
+      assert_select "a[href='#{root_path(script_name: import.account.slug)}']"
+    end
+
+    # Verify the newly imported account is fully browsable end-to-end
+    imported = import.account
+    imported_board = imported.boards.find_by!(name: "Writebook")
+    imported_card = imported.cards.find_by!(number: cards(:logo).number)
+
+    get board_path(imported_board, script_name: imported.slug)
+    assert_response :success
+
+    get card_path(imported_card, script_name: imported.slug)
+    assert_response :success
+    assert_select "title", /#{Regexp.escape(imported_card.title)}/
+
+    get account_settings_path(script_name: imported.slug)
+    assert_response :success
+
+    get account_join_code_path(script_name: imported.slug)
+    assert_response :success
+
+    get search_path(q: "logo", script_name: imported.slug)
+    assert_response :success
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "uploading an invalid file fails, sends failure email with reason, and leaves nothing behind" do
+    bad_file = Tempfile.new([ "bad", ".zip" ])
+    bad_file.write("not a valid zip")
+    bad_file.rewind
+
+    sign_in_as :kevin
+    clear_enqueued_jobs
+    ActionMailer::Base.deliveries.clear
+
+    uploaded = Rack::Test::UploadedFile.new(bad_file.path, "application/zip", true, original_filename: "bad.zip")
+
+    untenanted do
+      post account_imports_path, params: { account_import: { file: uploaded } }
+    end
+
+    import = Account::Import.last
+
+    assert_no_difference -> { Account.count } do
+      perform_enqueued_jobs # run export/import job
+    perform_enqueued_jobs # deliver email
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account
+    assert_match(/not a valid ZIP/i, import.error_message)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_match(/couldn't be completed/i, email.subject)
+    assert_includes email.body.encoded, import.error_message
+
+    untenanted do
+      get account_import_path(import)
+      assert_response :success
+      assert_select "h1", text: /couldn’t be completed/i
+      assert_includes response.body, import.error_message
+    end
+  ensure
+    bad_file&.close
+    bad_file&.unlink
+  end
+
+  test "user cannot view another identity's import" do
+    sign_in_as :kevin
+    import = identities(:kevin).account_imports.new
+    import.file.attach(io: StringIO.new("zip"), filename: "test.zip", content_type: "application/zip")
+    import.save!
+
+    logout_and_sign_in_as :david
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :not_found
+  end
+end
