--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,74 @@
+require "net/http"
+
+class ZipFile::RemoteIO < ZipKit::RemoteIO
+  URL_REFRESH_INTERVAL = 30.minutes
+
+  def initialize(url, ssl_verify_peer: true)
+    @ssl_verify_peer = ssl_verify_peer
+
+    if url.respond_to?(:call)
+      @url_generator = url
+      @url_generated_at = Time.current
+      super(@url_generator.call)
+    else
+      super(url)
+    end
+  end
+
+  protected
+    def request_range(range)
+      refresh_uri_if_needed
+
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = range
+        response = http.request(request)
+
+        case response.code
+        when "206", "200"
+          response.body
+        else
+          raise ZipFile::InvalidZipError, "Remote storage replied with HTTP #{response.code}"
+        end
+      end
+    end
+
+    def request_object_size
+      refresh_uri_if_needed
+
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = 0..0
+        response = http.request(request)
+
+        case response.code
+        when "206"
+          response["Content-Range"].to_s.split("/").last.to_i
+        when "200"
+          response["Content-Length"].to_i
+        else
+          raise ZipFile::InvalidZipError, "Remote storage replied with HTTP #{response.code}"
+        end
+      end
+    end
+
+  private
+    def with_http
+      http = Net::HTTP.new(@uri.hostname, @uri.port)
+      http.use_ssl = (@uri.scheme == "https")
+      http.verify_mode = OpenSSL::SSL::VERIFY_NONE unless @ssl_verify_peer
+      http.open_timeout = 30
+      http.read_timeout = 60
+
+      http.start { |conn| yield conn }
+    end
+
+    def refresh_uri_if_needed
+      return unless @url_generator
+
+      if Time.current - @url_generated_at >= URL_REFRESH_INTERVAL
+        @uri = URI(@url_generator.call)
+        @url_generated_at = Time.current
+      end
+    end
+end
