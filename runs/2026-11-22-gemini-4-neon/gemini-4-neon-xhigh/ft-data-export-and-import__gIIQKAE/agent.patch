+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  test "completed email links to the new imported account" do
+    import = identities(:kevin).account_imports.new(status: :completed, account: accounts(:"37s"))
+    import.save!(validate: false)
+
+    email = ImportMailer.completed(import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "Your Fizzy account import is ready", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert_includes email.html_part.body.to_s, accounts(:"37s").slug
+    assert_includes email.text_part.body.to_s, accounts(:"37s").name
+  end
+
+  test "failed email explains why the import failed" do
+    import = identities(:kevin).account_imports.new(
+      status: :failed,
+      error_message: "The uploaded file is not a valid ZIP archive."
+    )
+    import.save!(validate: false)
+
+    email = ImportMailer.failed(import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "Your Fizzy account import couldn't be completed", email.subject
