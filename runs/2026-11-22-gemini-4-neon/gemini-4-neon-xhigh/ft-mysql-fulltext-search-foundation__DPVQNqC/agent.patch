index 0000000..fbb6a40
--- /dev/null
+++ b/test/models/search/highlighter_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Search::HighlighterTest < ActiveSupport::TestCase
+  test "wraps matched words in mark tags preserving original case" do
+    highlighter = Search::Highlighter.new(Search::Query.new("logo"))
+    assert_equal "The <mark>Logo</mark> isn&#39;t big enough", highlighter.highlight("The Logo isn't big enough")
+  end
+
+  test "wraps prefix-matched words in mark tags" do
+    highlighter = Search::Highlighter.new(Search::Query.new("overflow"))
+    assert_equal "The text is <mark>overflowing</mark> the container.", highlighter.highlight("The text is overflowing the container.")
+  end
+
+  test "wraps multiple matched words in mark tags" do
+    highlighter = Search::Highlighter.new(Search::Query.new("big logo"))
+    assert_equal "The <mark>logo</mark> isn&#39;t <mark>big</mark> enough", highlighter.highlight("The logo isn't big enough")
+  end
+
+  test "handles overlapping terms longest first" do
+    highlighter = Search::Highlighter.new(Search::Query.new("foo foobar"))
+    assert_equal "<mark>foobar</mark> and <mark>foo</mark>", highlighter.highlight("foobar and foo")
+  end
+
+  test "escapes HTML and avoids corrupting entities or mark tags" do
+    highlighter = Search::Highlighter.new(Search::Query.new("mark &"))
+    result = highlighter.highlight("Tom & Jerry <script>mark</script>")
+
+    assert result.html_safe?
+    assert_equal "Tom <mark>&amp;</mark> Jerry &lt;script&gt;<mark>mark</mark>&lt;/script&gt;", result
+    assert_not_includes result, "<script>"
+  end
+
+  test "searching amp does not corrupt escaped ampersand" do
+    highlighter = Search::Highlighter.new(Search::Query.new("amp"))
+    assert_equal "Guitar <mark>amp</mark> &amp; cable", highlighter.highlight("Guitar amp & cable")
+  end
+
+  test "excerpt centers around match in long text" do
+    long_text = ("padding word " * 80) + "found the needle right here " + ("trailing word " * 30)
+    highlighter = Search::Highlighter.new(Search::Query.new("needle"))
+
+    result = highlighter.excerpt(long_text, length: 120)
+    assert_includes result, "<mark>needle</mark>"
+    assert result.start_with?("…")
+    assert result.end_with?("…")
+  end
+
+  test "excerpt includes both distant matched terms in long text" do
+    long_text = "Start with alpha here " + ("filler word " * 80) + "and finish with omega there."
+    highlighter = Search::Highlighter.new(Search::Query.new("alpha omega"))
+
+    result = highlighter.excerpt(long_text, length: 160)
+    assert_includes result, "<mark>alpha</mark>"
+    assert_includes result, "<mark>omega</mark>"
+    assert_includes result, "…"
+  end
+
+  test "excerpt truncates from start when text has no match" do
+    long_text = "Start of text " + ("more words " * 40)
+    highlighter = Search::Highlighter.new(Search::Query.new("unmatched"))
+
+    result = highlighter.excerpt(long_text, length: 50)
+    assert result.start_with?("Start of text")
+    assert result.end_with?("…")
+    assert_not_includes result, "<mark>"
+  end
+end
diff --git a/test/models/search/query_test.rb b/test/models/search/query_test.rb
new file mode 100644
index 0000000..be2e816
--- /dev/null
+++ b/test/models/search/query_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Search::QueryTest < ActiveSupport::TestCase
+  test "blank and non-string inputs produce empty query" do
+    [ nil, "", "   ", "\"\"", "\"   \"", [ "foo" ], { a: 1 } ].each do |input|
+      query = Search::Query.new(input)
+      assert query.blank?, "Expected #{input.inspect} to be blank"
+      assert_not query.present?
+      assert_empty query.terms
+    end
+  end
+
+  test "parses single and multiple words with case-insensitive deduplication" do
+    query = Search::Query.new("  Logo   BIG   logo  ")
+    assert query.present?
+    assert_equal [ "Logo", "BIG" ], query.terms
+  end
+
+  test "parses quoted phrases alongside individual words" do
+    query = Search::Query.new('"big enough" logo')
+    assert_equal [ "big enough", "logo" ], query.terms
+  end
+
+  test "handles unclosed quotes gracefully" do
+    query = Search::Query.new('foo "bar baz')
+    assert_equal [ "foo", "bar", "baz" ], query.terms
+  end
+
+  test "matches words and prefixes case-insensitively without mid-word false positives" do
+    query = Search::Query.new("overflow")
+    assert query.matches?("The text is overflowing the container.")
+    assert query.matches?("OVERFLOW error")
+    assert_not query.matches?("no match here")
+
+    log_query = Search::Query.new("log")
+    assert log_query.matches?("Check the log file")
+    assert log_query.matches?("Logo design")
+    assert_not log_query.matches?("Update dialog box")
+    assert_not log_query.matches?("Update catalog")
+  end
+
+  test "matches across hyphens and underscores" do
+    query = Search::Query.new("bar")
+    assert query.matches?("foo-bar")
+    assert query.matches?("foo_bar")
+  end
+
+  test "matches quoted phrases in order with flexible whitespace" do
+    query = Search::Query.new('"big enough"')
+    assert query.matches?("The logo isn't big enough")
+    assert query.matches?("The logo isn't big\n  enough")
+    assert_not query.matches?("enough big")
+  end
+
+  test "handles punctuation and special regex characters safely" do
+    assert Search::Query.new("isn't").matches?("The logo isn't big enough")
+    assert Search::Query.new("C++").matches?("Compile the C++ binary")
+    assert Search::Query.new("#42").matches?("See issue #42 for details")
+    assert Search::Query.new("AT&T").matches?("Call AT&T support")
+    assert Search::Query.new("100%").matches?("Progress is 100% complete")
+    assert Search::Query.new("a+b*(c)").matches?("Formula a+b*(c) works")
+  end
+
+  test "handles unicode case-insensitivity and CJK" do
+    assert Search::Query.new("éclair").matches?("Éclair au chocolat")
+    assert Search::Query.new("CAFÉ").matches?("Meet at the café")
+    assert Search::Query.new("привет").matches?("Привет мир")
+    assert Search::Query.new("日本語").matches?("テスト日本語テスト")
+  end
+
+  test "caps terms at MAX_TERMS" do
+    words = (1..30).map { |i| "word#{i}" }.join(" ")
+    query = Search::Query.new(words)
+    assert_equal Search::Query::MAX_TERMS, query.terms.size
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
