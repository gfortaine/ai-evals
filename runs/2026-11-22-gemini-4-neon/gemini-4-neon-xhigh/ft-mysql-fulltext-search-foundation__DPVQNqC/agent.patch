+<% card = result.card %>
+
+<article id="<%= dom_id(card, :search_result) %>" class="search-result" role="listitem" style="--card-color: <%= card.color %>">
+  <header class="search-result__header flex align-center gap-half txt-x-small">
+    <span class="search-result__number">#<%= card.number %></span>
+    <span class="search-result__board overflow-ellipsis"><%= card.board.name %></span>
+    <% if card.closed? %>
+      <span class="search-result__status">Done</span>
+    <% elsif card.postponed? %>
+      <span class="search-result__status">Not Now</span>
+    <% elsif card.column.present? %>
+      <span class="search-result__status"><%= card.column.name %></span>
+    <% end %>
+    <span class="search-result__meta margin-inline-start-auto txt-nowrap">
+      <%= card.creator.familiar_name %> · <%= local_datetime_tag(card.created_at, style: :daysago) %>
+    </span>
+  </header>
+
+  <h2 class="search-result__title">
+    <%= link_to result.title_html, card_path(card), class: "search-result__link", data: { turbo_frame: "_top" } %>
+  </h2>
+
+  <% if result.description_html.present? %>
+    <p class="search-result__excerpt"><%= result.description_html %></p>
+  <% end %>
+
+  <% if result.visible_comments.any? %>
+    <ul class="search-result__comments" role="list">
+      <% result.visible_comments.each do |comment| %>
+        <li class="search-result__comment">
+          <%= link_to card_path(card, anchor: dom_id(comment)), class: "search-result__comment-link", data: { turbo_frame: "_top" } do %>
+            <span class="search-result__comment-author"><%= comment.creator.familiar_name %>:</span>
+            <span class="search-result__comment-body"><%= result.comment_html(comment) %></span>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
