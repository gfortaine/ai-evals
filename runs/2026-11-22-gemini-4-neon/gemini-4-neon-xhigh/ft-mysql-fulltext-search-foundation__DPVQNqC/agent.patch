+@layer components {
+  .search {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space);
+  }
+
+  .search__form {
+    inline-size: 100%;
+  }
+
+  .search__input {
+    --input-background: var(--color-canvas);
+  }
+
+  .search__results {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space-half);
+  }
+
+  .search__prompt {
+    margin-block: var(--block-space-double);
+  }
+
+  .search__blank-slate {
+    align-self: center;
+  }
+
+  .search-result {
+    background-color: var(--color-canvas);
+    border: 1px solid var(--color-ink-lighter);
+    border-inline-start: 4px solid var(--card-color, var(--color-card-default));
+    border-radius: 0.75em;
+    display: flex;
+    flex-direction: column;
+    gap: 0.4em;
+    padding: var(--block-space-half) var(--block-space);
+    text-align: start;
+
+    mark {
+      background-color: var(--color-highlight);
+      border-radius: 0.2em;
+      color: inherit;
+      padding-inline: 0.1em;
+    }
+  }
+
+  .search-result__header {
+    color: var(--color-ink-dark);
+  }
+
+  .search-result__number {
+    font-weight: 700;
+  }
+
+  .search-result__board {
+    font-weight: 600;
+  }
+
+  .search-result__status {
+    background-color: var(--color-ink-lightest);
+    border-radius: 0.35em;
+    padding: 0.1em 0.45em;
+  }
+
+  .search-result__title {
+    font-size: var(--text-medium);
+    font-weight: 700;
+    line-height: 1.3;
+    margin: 0;
+  }
+
+  .search-result__link {
+    color: var(--color-ink);
+
+    &:hover {
+      text-decoration: underline;
+    }
+  }
+
+  .search-result__excerpt {
+    color: var(--color-ink-dark);
+    font-size: var(--text-small);
+    margin: 0;
+  }
+
+  .search-result__comments {
+    border-block-start: 1px solid var(--color-ink-lightest);
+    display: flex;
+    flex-direction: column;
+    gap: 0.35em;
+    padding-block-start: 0.4em;
+  }
+
+  .search-result__comment-link {
+    color: var(--color-ink-dark);
+    display: block;
+    font-size: var(--text-small);
+
+    &:hover {
+      color: var(--color-ink);
+    }
+  }
+
+  .search-result__comment-author {
+    font-weight: 600;
+  }
+}
