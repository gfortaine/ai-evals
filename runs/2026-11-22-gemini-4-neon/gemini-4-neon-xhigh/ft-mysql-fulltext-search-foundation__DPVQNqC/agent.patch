+
+    postponed_card = boards(:writebook).cards.create!(title: "Solstice postponed", status: :published, creator: users(:david), created_at: 1.day.ago)
+    postponed_card.postpone(user: users(:david))
+
+    results = Search.new(user: users(:david), query: "solstice").results
+    assert_equal [ postponed_card, closed_card ], results.map(&:card)
+  end
+
+  test "only returns cards from boards the user currently has access to" do
+    private_card = boards(:private).cards.create!(
+      title: "Secret cobalt plan",
+      description: "Top secret cobalt details",
+      status: :published,
+      creator: users(:kevin)
+    )
+    private_card.comments.create!(body: "Cobalt comment", creator: users(:kevin))
+
+    assert_equal [ private_card ], Search.new(user: users(:kevin), query: "cobalt").results.map(&:card)
+    assert_empty Search.new(user: users(:david), query: "cobalt").results
+
+    # Granting access makes the card appear immediately
+    boards(:private).accesses.grant_to(users(:david))
+    assert_equal [ private_card ], Search.new(user: users(:david), query: "cobalt").results.map(&:card)
+
+    # Revoking access hides the card immediately
+    boards(:private).accesses.revoke_from(users(:david))
+    assert_empty Search.new(user: users(:david), query: "cobalt").results
+  end
+
+  test "moving a card between boards immediately updates visibility in search" do
+    card = boards(:writebook).cards.create!(title: "Portable sapphire", status: :published, creator: users(:kevin))
+    card.comments.create!(body: "Sapphire note", creator: users(:kevin))
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "sapphire").results.map(&:card)
+
+    card.move_to(boards(:private))
+    assert_empty Search.new(user: users(:david), query: "sapphire").results
+    assert_equal [ card ], Search.new(user: users(:kevin), query: "sapphire").results.map(&:card)
+
+    card.move_to(boards(:writebook))
+    assert_equal [ card ], Search.new(user: users(:david), query: "sapphire").results.map(&:card)
+  end
+
+  test "user with no board access gets empty results" do
+    assert_empty users(:jason).boards
+    assert_empty Search.new(user: users(:jason), query: "logo").results
+  end
+
+  test "isolates search results by account" do
+    assert_empty Search.new(user: users(:david), query: "radio").results
+    assert_empty Search.new(user: users(:david), query: "paycheck").results
+
+    Current.with_account(accounts(:initech)) do
+      assert_equal [ cards(:radio) ], Search.new(user: users(:mike), query: "radio").results.map(&:card)
+      assert_empty Search.new(user: users(:mike), query: "logo").results
+    end
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft = boards(:writebook).cards.create!(
+      title: "Draft obsidian title",
+      description: "Draft obsidian description",
+      status: :drafted,
+      creator: users(:david)
+    )
+    # Force a comment onto the draft card directly
+    forced_comment = Comment.new(account: draft.account, card: draft, creator: users(:david), body: "Draft obsidian comment")
+    forced_comment.rich_text_body.account = draft.account
+    forced_comment.save!(validate: false)
+
+    assert_empty Search.new(user: users(:david), query: "obsidian").results
+
+    # Existing draft fixture never turns up even for its creator
+    Current.with_account(accounts(:initech)) do
+      assert_empty Search.new(user: users(:mike), query: "unfinished").results
+    end
+
+    # Publishing makes the card searchable
+    draft.publish
+    assert_equal [ draft ], Search.new(user: users(:david), query: "obsidian").results.map(&:card)
+
+    # Reverting back to draft hides the card and its comments again
+    draft.drafted!
+    assert_empty Search.new(user: users(:david), query: "obsidian").results
+  end
+
+  test "reflects edits and deletions immediately" do
+    card = boards(:writebook).cards.create!(title: "Initial emerald", status: :published, creator: users(:david))
+    comment = card.comments.create!(body: "Comment topaz", creator: users(:david))
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "emerald").results.map(&:card)
+    assert_equal [ card ], Search.new(user: users(:david), query: "topaz").results.map(&:card)
+
+    card.update!(title: "Updated ruby")
+    assert_empty Search.new(user: users(:david), query: "emerald").results
+    assert_equal [ card ], Search.new(user: users(:david), query: "ruby").results.map(&:card)
+
+    comment.destroy!
+    assert_empty Search.new(user: users(:david), query: "topaz").results
+
+    card.destroy!
+    assert_empty Search.new(user: users(:david), query: "ruby").results
+  end
+
+  test "ignores HTML tags and attributes in rich text descriptions and comments" do
+    card = boards(:writebook).cards.create!(
+      title: "Markup test",
+      description: '<div class="custombox"><p>Visit <a href="https://hiddenurl.example">our docs</a> and <strong>read</strong> carefully.</p></div>',
+      status: :published,
+      creator: users(:david)
+    )
+    card.comments.create!(
+      body: '<p>Another <em class="italicized">note</em> here</p>',
+      creator: users(:david)
+    )
+
+    assert_empty Search.new(user: users(:david), query: "div").results
+    assert_empty Search.new(user: users(:david), query: "strong").results
+    assert_empty Search.new(user: users(:david), query: "custombox").results
+    assert_empty Search.new(user: users(:david), query: "hiddenurl").results
+    assert_empty Search.new(user: users(:david), query: "italicized").results
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "docs").results.map(&:card)
+    assert_equal [ card ], Search.new(user: users(:david), query: "read carefully").results.map(&:card)
+  end
+
+  test "handles HTML entities and SQL LIKE wildcards in descriptions and titles" do
+    card = boards(:writebook).cards.create!(
+      title: "Upgrade 100% of foo_bar systems",
+      description: "<p>AT&amp;T says it&#39;s ready for a &lt; b</p>",
+      status: :published,
+      creator: users(:david)
+    )
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "100%").results.map(&:card)
+    assert_equal [ card ], Search.new(user: users(:david), query: "foo_bar").results.map(&:card)
+    assert_equal [ card ], Search.new(user: users(:david), query: "AT&T").results.map(&:card)
+    assert_equal [ card ], Search.new(user: users(:david), query: "it's").results.map(&:card)
+    assert_equal [ card ], Search.new(user: users(:david), query: "%").results.map(&:card)
+    assert_equal [ card ], Search.new(user: users(:david), query: "_").results.map(&:card)
+  end
+
+  test "matches unicode terms case-insensitively" do
+    card = boards(:writebook).cards.create!(
+      title: "Éclair recipe",
+      description: "<p>Serve at the Café</p>",
+      status: :published,
+      creator: users(:david)
+    )
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "éclair").results.map(&:card)
+    assert_equal [ card ], Search.new(user: users(:david), query: "CAFÉ").results.map(&:card)
+  end
+
+  test "paginates results newest first and handles HTML false positives cleanly" do
+    # Create noise cards containing <div> HTML tag in description (false positives for "div")
+    3.times do |i|
+      boards(:writebook).cards.create!(
+        title: "Noise #{i}",
+        description: "<div>No real match here</div>",
+        status: :published,
+        creator: users(:david),
+        created_at: (10 - i).minutes.ago
+      )
+    end
+
+    true_cards = (1..3).map do |i|
+      boards(:writebook).cards.create!(
+        title: "Use a div element #{i}",
+        status: :published,
+        creator: users(:david),
+        created_at: (5 - i).minutes.ago
+      )
+    end
+
+    search = Search.new(user: users(:david), query: "div", per_page: 2)
+
+    page_1 = search.page(1)
+    assert_equal 1, page_1.number
+    assert page_1.before_last?
+    assert_equal [ true_cards[2], true_cards[1] ], page_1.records.map(&:card)
+
+    page_2 = search.page(2)
+    assert_equal 2, page_2.number
+    assert_not page_2.before_last?
+    assert_equal [ true_cards[0] ], page_2.records.map(&:card)
+
+    page_3 = search.page(3)
+    assert page_3.empty?
+    assert_not page_3.before_last?
+  end
+
+  test "handles blank query and invalid page numbers" do
