+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_redirected_to new_session_url(script_name: nil)
+  end
+
+  test "show without query renders search form and prompt" do
+    get search_path
+    assert_response :success
+    assert_select "input[name='q'][type='search']"
+    assert_select ".search-result", count: 0
+  end
+
+  test "show with blank query renders no results" do
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "finds card by title and wraps matched word in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select ".search-result", count: 1
+    assert_select "a[href='#{card_path(cards(:logo))}']" do
+      assert_select "mark", "logo"
+    end
+  end
+
+  test "finds card by description and wraps matched word in mark" do
+    card = boards(:writebook).cards.create!(
+      title: "Performance issue",
+      description: "<p>Memory leaks during nightly <strong>compaction</strong> job.</p>",
+      status: :published,
+      creator: users(:david)
+    )
+
+    get search_path(q: "compaction")
+    assert_response :success
+
+    assert_select ".search-result", count: 1
+    assert_select "a[href='#{card_path(card)}']", text: "Performance issue"
+    assert_select ".search-result__excerpt mark", "compaction"
+  end
+
+  test "highlights matched word even when far into a long description" do
+    long_description = ("filler text " * 100) + "found the elusive chameleon right here " + ("more text " * 30)
+    card = boards(:writebook).cards.create!(
+      title: "Long card",
+      description: long_description,
+      status: :published,
+      creator: users(:david)
+    )
+
+    get search_path(q: "chameleon")
+    assert_response :success
+
+    assert_select "a[href='#{card_path(card)}']"
+    assert_select ".search-result__excerpt mark", "chameleon"
+  end
+
+  test "finds card by comment body and wraps matched word in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select ".search-result", count: 1
+    assert_select "a[href='#{card_path(cards(:layout))}']", text: "Layout is broken"
+    assert_select "a[href='#{card_path(cards(:layout), anchor: dom_id(comments(:layout_overflowing_david)))}']" do
+      assert_select "mark", "overflowing"
+    end
+  end
+
+  test "renders results newest first" do
+    older = boards(:writebook).cards.create!(title: "Phoenix older", status: :published, creator: users(:david), created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Phoenix newer", status: :published, creator: users(:david), created_at: 1.day.ago)
+
+    get search_path(q: "phoenix")
+    assert_response :success
+
+    result_ids = css_select(".search-result").map { |node| node["id"] }
+    assert_equal [ dom_id(newer, :search_result), dom_id(older, :search_result) ], result_ids
+  end
+
+  test "wraps multiple matched words in mark preserving case" do
+    get search_path(q: "BIG logo")
+    assert_response :success
+
+    assert_select ".search-result__title mark", count: 2
+    assert_select ".search-result__title mark", "logo"
+    assert_select ".search-result__title mark", "big"
+  end
+
+  test "shows empty state when nothing matches" do
+    get search_path(q: "zzznomatchzzz")
+    assert_response :success
+
+    assert_select ".search-result", count: 0
+    assert_select ".blank-slate", /zzznomatchzzz/
+  end
+
+  test "only returns results from boards user currently has access to" do
+    private_card = boards(:private).cards.create!(
+      title: "Confidential tungsten",
+      status: :published,
+      creator: users(:kevin)
+    )
+
+    get search_path(q: "tungsten")
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    boards(:private).accesses.grant_to(users(:david))
+    get search_path(q: "tungsten")
+    assert_response :success
+    assert_select "a[href='#{card_path(private_card)}']"
+
+    boards(:private).accesses.revoke_from(users(:david))
+    get search_path(q: "tungsten")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft = boards(:writebook).cards.create!(
+      title: "Unpublished titanium",
+      description: "Titanium spec",
+      status: :drafted,
+      creator: users(:david)
+    )
+    comment = Comment.new(account: draft.account, card: draft, creator: users(:david), body: "Titanium comment")
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    get search_path(q: "titanium")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "escapes XSS in card content and query parameter" do
+    boards(:writebook).cards.create!(
+      title: "<script>alert('xss')</script> widget",
+      description: "<p>Safe widget text</p>",
+      status: :published,
+      creator: users(:david)
+    )
+
+    get search_path(q: "widget")
+    assert_response :success
+    assert_select "script", text: /alert/i, count: 0
+    assert_select ".search-result__title mark", "widget"
+
+    get search_path(q: "<script>alert(1)</script>")
+    assert_response :success
+    assert_select "script", text: /alert/i, count: 0
+  end
+
+  test "handles special characters and malformed params without errors" do
+    [ "%", "_", "C++", "isn't", '"unclosed', '""' ].each do |term|
+      get search_path(q: term)
+      assert_response :success
+    end
+
+    get "#{search_path}?q[]=array"
+    assert_response :success
+  end
+
+  test "paginates across pages preserving query" do
+    26.times do |i|
+      boards(:writebook).cards.create!(
+        title: "Paginated zircon #{i}",
+        status: :published,
+        creator: users(:david),
+        created_at: (30 - i).minutes.ago
+      )
+    end
+
+    get search_path(q: "zircon")
+    assert_response :success
+    assert_select ".search-result", count: 25
+    assert_select "a.pagination-link[href*='page=2'][href*='q=zircon']"
+
+    get search_path(q: "zircon", page: 2)
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select "a.pagination-link", count: 0
+  end
+  test "highlights matched word far into a long comment" do
+    card = boards(:writebook).cards.create!(title: "Comment card", status: :published, creator: users(:david))
+    long_body = ("filler words " * 100) + "buried salamander detail " + ("trailing words " * 30)
+    comment = card.comments.create!(body: long_body, creator: users(:david))
+
+    get search_path(q: "salamander")
+    assert_response :success
+
+    assert_select "a[href='#{card_path(card, anchor: dom_id(comment))}']" do
+      assert_select "mark", "salamander"
+    end
+  end
+
+  test "does not return cards from other accounts" do
+    get search_path(q: "radio")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "card moved to inaccessible board disappears from search" do
+    card = boards(:writebook).cards.create!(title: "Moving alabaster", status: :published, creator: users(:kevin))
+
+    get search_path(q: "alabaster")
+    assert_response :success
+    assert_select "a[href='#{card_path(card)}']"
+
+    card.move_to(boards(:private))
+    get search_path(q: "alabaster")
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    logout_and_sign_in_as :kevin
+    get search_path(q: "alabaster")
+    assert_response :success
+    assert_select "a[href='#{card_path(card)}']"
+  end
+
+  test "includes closed and postponed cards in results" do
+    closed = boards(:writebook).cards.create!(title: "Closed basalt", status: :published, creator: users(:david), created_at: 2.days.ago)
+    closed.close(user: users(:david))
+
+    postponed = boards(:writebook).cards.create!(title: "Postponed basalt", status: :published, creator: users(:david), created_at: 1.day.ago)
+    postponed.postpone(user: users(:david))
+
+    get search_path(q: "basalt")
+    assert_response :success
+
+    result_ids = css_select(".search-result").map { |node| node["id"] }
+    assert_equal [ dom_id(postponed, :search_result), dom_id(closed, :search_result) ], result_ids
+    assert_select ".search-result__status", "Not Now"
+    assert_select ".search-result__status", "Done"
+  end
+end
diff --git a/test/models/search/highlighter_test.rb b/test/models/search/highlighter_test.rb
