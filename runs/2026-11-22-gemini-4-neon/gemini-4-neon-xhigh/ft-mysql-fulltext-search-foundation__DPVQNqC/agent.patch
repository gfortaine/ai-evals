@@ -0,0 +1,335 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finds fixture cards by title" do
+    results = Search.new(user: users(:david), query: "logo").results
+    assert_equal [ cards(:logo) ], results.map(&:card)
+  end
+
+  test "finds fixture cards by comment body" do
+    results = Search.new(user: users(:david), query: "overflowing").results
+    assert_equal [ cards(:layout) ], results.map(&:card)
+    assert_equal [ comments(:layout_overflowing_david) ], results.first.matching_comments
+  end
+
+  test "finds cards by description" do
+    card = boards(:writebook).cards.create!(
+      title: "Regular card",
+      description: "<p>Investigate the <strong>quantum</strong> anomaly in staging.</p>",
+      status: :published,
+      creator: users(:david)
+    )
+
+    results = Search.new(user: users(:david), query: "quantum").results
+    assert_equal [ card ], results.map(&:card)
+    assert_includes results.first.description_html, "<mark>quantum</mark>"
+  end
+
+  test "finds cards case-insensitively" do
+    results = Search.new(user: users(:david), query: "LOGO").results
+    assert_equal [ cards(:logo) ], results.map(&:card)
+  end
+
+  test "multi-word query matches across title, description, and comments" do
+    results = Search.new(user: users(:david), query: "layout overflowing").results
+    assert_equal [ cards(:layout) ], results.map(&:card)
+    assert_includes results.first.title_html, "<mark>Layout</mark>"
+    assert_includes results.first.comment_html(comments(:layout_overflowing_david)), "<mark>overflowing</mark>"
+  end
+
+  test "multi-word query matches across title and description" do
+    card = boards(:writebook).cards.create!(
+      title: "Nebula tracker",
+      description: "Contains telescope telemetry",
+      status: :published,
+      creator: users(:david)
+    )
+
+    results = Search.new(user: users(:david), query: "nebula telemetry").results
+    assert_equal [ card ], results.map(&:card)
+  end
+
+  test "multi-word query matches across two different comments on the same card" do
+    card = boards(:writebook).cards.create!(title: "Discussion", status: :published, creator: users(:david))
+    comment_a = card.comments.create!(body: "First mentions zeppelin", creator: users(:david))
+    comment_b = card.comments.create!(body: "Second mentions dirigible", creator: users(:kevin))
+
+    results = Search.new(user: users(:david), query: "zeppelin dirigible").results
+    assert_equal [ card ], results.map(&:card)
+    assert_equal [ comment_b, comment_a ], results.first.matching_comments
+  end
+
+  test "does not return duplicate cards when term matches title, description, and multiple comments" do
+    card = boards(:writebook).cards.create!(
+      title: "Quasar report",
