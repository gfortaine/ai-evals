@@ -0,0 +1,43 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide borderless center">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap-half align-center" do |form| %>
+    <%= form.search_field :q,
+          value: @query.raw,
+          placeholder: "Search cards and comments…",
+          aria: { label: "Search cards and comments" },
+          autofocus: @query.blank?,
+          autocomplete: "off",
+          class: "input search__input flex-item-grow" %>
+    <%= form.button type: :submit, name: nil, class: "btn btn--reversed" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.any? %>
+      <div class="search__results" role="list">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :result %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate search__blank-slate">
+        No cards match “<%= @query %>”
+      </div>
+    <% end %>
+  <% else %>
+    <p class="search__prompt txt-subtle txt-align-center">
+      Search cards by title, description, or comment.
+    </p>
+  <% end %>
+</section>
