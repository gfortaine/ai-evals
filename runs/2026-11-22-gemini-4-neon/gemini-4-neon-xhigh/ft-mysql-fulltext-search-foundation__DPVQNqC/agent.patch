+
+    results = Search.new(user: users(:david), query: "quasar").results
+    assert_equal [ card ], results.map(&:card)
+    assert_equal [ comment_2, comment_1 ], results.first.matching_comments
+  end
+
+  test "orders results newest first" do
+    oldest = boards(:writebook).cards.create!(title: "Aurora oldest", status: :published, creator: users(:david), created_at: 3.days.ago)
+    middle = boards(:writebook).cards.create!(title: "Aurora middle", status: :published, creator: users(:david), created_at: 2.days.ago)
+    newest = boards(:writebook).cards.create!(title: "Aurora newest", status: :published, creator: users(:david), created_at: 1.day.ago)
+
+    results = Search.new(user: users(:david), query: "aurora").results
+    assert_equal [ newest, middle, oldest ], results.map(&:card)
+  end
+
+  test "includes closed and postponed published cards" do
