@@ -0,0 +1,382 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes only accounts cancelled more than 30 days ago" do
+    freeze_time do
+      active_account = Account.create!(name: "Active")
+      recent_account = create_cancelled_account(name: "Recent", cancelled_at: 29.days.ago)
+      boundary_account = create_cancelled_account(name: "Boundary", cancelled_at: 30.days.ago)
+      just_due_account = create_cancelled_account(name: "Just Due", cancelled_at: 30.days.ago - 1.second)
+      overdue_account = create_cancelled_account(name: "Overdue", cancelled_at: 31.days.ago)
+
+      reactivated_account = create_cancelled_account(name: "Reactivated", cancelled_at: 31.days.ago)
+      reactivated_account.reactivate
+
+      due = Account.due_for_incineration
+
+      assert_not_includes due, active_account
+      assert_not_includes due, recent_account
+      assert_not_includes due, boundary_account
+      assert_not_includes due, reactivated_account
+      assert_includes due, just_due_account
+      assert_includes due, overdue_account
+    end
+  end
+
+  test "incinerate permanently removes all data across every account-scoped table and storage files" do
+    identity = identities(:david)
+    target = Account.create_with_owner(
+      account: { name: "Doomed Account" },
+      owner: { name: "Doomed Owner", identity: identity }
+    )
+    owner = target.users.owner.first
+    member = target.users.create!(name: "Doomed Member", role: :member)
+
+    blob_keys = []
+    board_ids = []
+    filter_ids = []
+    search_record_ids = []
+
+    Current.set(account: target, user: owner) do
+      board = target.boards.create!(name: "Doomed Board", creator: owner, all_access: true)
+      board.update!(public_description: "Public description")
+      board.publish
+      board.create_entropy!(auto_postpone_period: 7.days, account: target)
+      column = board.columns.create!(name: "In Progress", color: Color::COLORS.first)
+      tag = target.tags.create!(title: "doomed-tag")
+
+      embed_blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "embed.jpg",
+        content_type: "image/jpeg"
+      )
+      embed_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+
+      card = board.cards.create!(
+        title: "Doomed Card",
+        creator: owner,
+        status: :published,
+        column: column,
+        description: "<p>Card body #{embed_html}</p>"
+      )
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "card.jpg", content_type: "image/jpeg")
+      card.toggle_tag_with(tag.title)
+      card.assignments.create!(assignee: member, assigner: owner)
+      card.steps.create!(content: "Finish incineration")
+      card.pin_by(owner)
+      card.gild
+      card.reactions.create!(content: "👍", reacter: owner)
+
+      comment_blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("comment attachment"),
+        filename: "note.txt",
+        content_type: "text/plain"
+      )
+      comment_embed_html = ActionText::Attachment.from_attachable(comment_blob).to_html
+      comment = card.comments.create!(body: "<p>Comment #{comment_embed_html}</p>", creator: owner)
+      comment.reactions.create!(content: "🎉", reacter: member)
+      Mention.create!(account: target, source: comment, mentioner: owner, mentionee: member)
+
+      card.close(user: owner)
+      postponed_card = board.cards.create!(title: "Postponed Card", creator: owner, status: :published)
+      postponed_card.postpone(user: owner)
+      card.create_activity_spike!(account: target)
+
+      event = card.events.first
+      webhook = board.webhooks.create!(name: "Hook", url: "https://example.com/hook", subscribed_actions: [ "card_published" ])
+      webhook.deliveries.create!(account: target, event: event, state: "completed")
+
+      Notification.create!(account: target, user: member, creator: owner, source: event, card: card)
+      Notification::Bundle.create!(account: target, user: member, starts_at: 1.hour.ago, ends_at: Time.current)
+
+      filter = owner.filters.create!(
+        fields: { indexed_by: "all" },
+        boards: [ board ],
+        tags: [ tag ],
+        assignees: [ member ],
+        creators: [ owner ],
+        closers: [ owner ]
+      )
+      bin_uid = ActiveRecord::Type::Uuid.new.serialize(owner.id)
+      bin_fid = ActiveRecord::Type::Uuid.new.serialize(filter.id)
+      Account.connection.execute(
+        "INSERT INTO assigners_filters (assigner_id, filter_id) VALUES (#{Account.connection.quote(bin_uid)}, #{Account.connection.quote(bin_fid)})"
+      )
+
+      owner.remember_search("doomed search")
+      push_sub = owner.push_subscriptions.build(
+        account: target,
+        endpoint: "https://fcm.googleapis.com/fcm/send/doomed",
+        p256dh_key: "key",
+        auth_key: "auth"
+      )
+      push_sub.save!(validate: false)
+
+      owner.avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+      owner.avatar.variant(:thumb).processed
+
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("unattached direct upload"),
+        filename: "orphan.txt",
+        content_type: "text/plain"
+      )
+
+      account_export = Account::Export.create!(account: target, user: owner)
+      account_export.file.attach(io: StringIO.new("account export"), filename: "account.zip", content_type: "application/zip")
+
+      user_export = User::DataExport.create!(account: target, user: owner)
+      user_export.file.attach(io: StringIO.new("user export"), filename: "user.zip", content_type: "application/zip")
+
+      import = Account::Import.create!(account: target, identity: identity, status: :completed)
+      import.file.attach(io: StringIO.new("import data"), filename: "import.zip", content_type: "application/zip")
+
+      Storage::Entry.record(account: target, board: board, delta: 2048, operation: "attach")
+      target.materialize_storage
+      board.materialize_storage
+
+      card.reindex
+      comment.reindex
+
+      target.cancel(initiated_by: owner)
+
+      blob_keys = ActiveStorage::Blob.where(account_id: target.id).pluck(:key)
+      board_ids = target.boards.ids
+      filter_ids = Filter.where(account_id: target.id).ids
+      search_record_ids = Search::Record.for(target.id).where(account_id: target.id).pluck(:id)
+    end
+
+    assert_operator blob_keys.size, :>=, 7
+    assert_operator search_record_ids.size, :>=, 2
+    blob_keys.each do |key|
+      assert ActiveStorage::Blob.service.exist?(key), "Expected blob #{key} to exist before incineration"
+    end
+
+    # Verify every account-scoped table actually has test rows populated before incineration
+    assert_every_account_table_populated(target.id, board_ids, filter_ids)
+
+    enqueued_jobs.clear
+
+    target.incinerate
+
+    assert target.destroyed?
+    assert_not Account.exists?(target.id)
+    assert_empty enqueued_jobs, "Incineration should not enqueue background jobs"
+
+    # Verify zero rows remain in EVERY table in the database for the incinerated account
+    assert_no_records_remain_for_account(target.id, board_ids, filter_ids, search_record_ids)
+
+    # Verify all physical files were purged from storage
+    blob_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key), "Expected blob #{key} to be deleted from storage"
+    end
+  end
+
+  test "incinerate preserves other accounts and global identity records" do
+    other_account = accounts(:initech)
+    shared_identity = identities(:david)
+
+    other_card = cards(:radio)
+    other_blob = nil
+    Current.set(account: other_account, user: users(:mike)) do
+      other_card.image.attach(io: StringIO.new("initech image"), filename: "initech.png", content_type: "image/png")
+      other_blob = other_card.image.blob
+      other_card.reindex
+    end
+
+    snapshot_before = account_snapshot(other_account)
+    identity_count_before = Identity.count
+    session_count_before = Session.count
+    sequence_value_before = Account::ExternalIdSequence.value
+
+    @account.cancel(initiated_by: @user)
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(other_account.id)
+    assert_equal snapshot_before, account_snapshot(other_account)
+    assert ActiveStorage::Blob.service.exist?(other_blob.key)
+
+    assert Identity.exists?(shared_identity.id)
+    assert_equal identity_count_before, Identity.count
+    assert_equal session_count_before, Session.count
+    assert_equal sequence_value_before, Account::ExternalIdSequence.value
+  end
+
+  test "incinerate does nothing for an active account" do
+    assert_not @account.cancelled?
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert_not @account.destroyed?
+  end
+
+  test "incinerate is idempotent when called twice" do
+    @account.cancel(initiated_by: @user)
+    @account.incinerate
+
+    assert_nothing_raised do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "incinerate handles missing blob files on disk gracefully" do
+    target = create_cancelled_account(name: "Missing Blob Account", cancelled_at: 31.days.ago)
+
+    missing_blob = Current.with_account(target) do
+      ActiveStorage::Blob.create!(
+        account: target,
+        key: "missing-file-key-#{SecureRandom.hex}",
+        filename: "missing.txt",
+        byte_size: 42,
+        checksum: "abc",
+        service_name: ActiveStorage::Blob.service.name
+      )
+    end
+
+    assert_nothing_raised do
+      target.incinerate
+    end
+
+    assert_not Account.exists?(target.id)
+    assert_not ActiveStorage::Blob.exists?(missing_blob.id)
+  end
+
+  test "incinerate preserves a blob if another account still has an attachment to it" do
+    target = create_cancelled_account(name: "Shared Blob Owner", cancelled_at: 31.days.ago)
+    other_account = accounts(:initech)
+    other_card = cards(:radio)
+
+    shared_blob = Current.with_account(target) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("shared content"),
+        filename: "shared.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    # Insert cross-account attachment directly to simulate a shared template blob
+    cross_attachment = ActiveStorage::Attachment.new(
+      name: "image",
+      record: other_card,
+      blob: shared_blob,
+      account: other_account
+    )
+    cross_attachment.save!(validate: false)
+
+    target.incinerate
+
+    assert_not Account.exists?(target.id)
+    assert ActiveStorage::Blob.exists?(shared_blob.id)
+    assert ActiveStorage::Attachment.exists?(cross_attachment.id)
+    assert ActiveStorage::Blob.service.exist?(shared_blob.key)
+  ensure
+    cross_attachment&.delete
+    shared_blob&.purge if shared_blob && ActiveStorage::Blob.exists?(shared_blob.id)
+  end
+
+  test "incinerate_due skips accounts reactivated before incineration" do
+    target = create_cancelled_account(name: "Reactivated Race", cancelled_at: 31.days.ago)
+    target.reactivate
+
+    Account.incinerate_due
+
+    assert Account.exists?(target.id)
+  end
+
+  test "incinerate_due skips accounts reactivated and re-cancelled within grace period" do
+    target = create_cancelled_account(name: "Re-cancelled Account", cancelled_at: 31.days.ago)
+    target.reactivate
+    target.cancel(initiated_by: target.users.owner.first)
+
+    Account.incinerate_due
+
+    assert Account.exists?(target.id)
+    assert target.reload.cancelled?
+  end
+
+  private
+    def create_cancelled_account(name:, cancelled_at:)
+      account = Account.create_with_owner(
+        account: { name: name },
+        owner: { name: "#{name} Owner", identity: identities(:david) }
+      )
+      account.cancel(initiated_by: account.users.owner.first)
+      account.cancellation.update_column(:created_at, cancelled_at)
+      account
+    end
+
+    def account_snapshot(account)
+      {
