+    def assert_every_account_table_populated(account_id, board_ids, filter_ids)
+      conn = ActiveRecord::Base.connection
+      quoted_aid = conn.quote(ActiveRecord::Type::Uuid.new.serialize(account_id))
+      account_search_table = Search::Record.for(account_id).table_name
+
+      conn.tables.sort.each do |table|
+        next if table.start_with?("search_records_") && table != account_search_table
+
+        cols = conn.columns(table).map(&:name)
+        if cols.include?("account_id")
+          count = conn.select_value("SELECT COUNT(*) FROM #{conn.quote_table_name(table)} WHERE account_id = #{quoted_aid}")
+          assert_operator count, :>, 0, "Expected test setup to populate #{table}"
+        elsif table == "storage_totals"
+          count = Storage::Total.where(owner_id: [ account_id, *board_ids ]).count
+          assert_operator count, :==, 1 + board_ids.size, "Expected test setup to populate storage_totals for account and boards"
+        elsif Account::Incineration::FILTER_JOIN_TABLES.include?(table)
+          subquery = filter_ids.map { |fid| conn.quote(ActiveRecord::Type::Uuid.new.serialize(fid)) }.join(",")
+          count = conn.select_value("SELECT COUNT(*) FROM #{conn.quote_table_name(table)} WHERE filter_id IN (#{subquery})")
+          assert_operator count, :>, 0, "Expected test setup to populate #{table}"
+        end
+      end
+    end
+
+    def assert_no_records_remain_for_account(account_id, board_ids, filter_ids, search_record_ids)
+      conn = ActiveRecord::Base.connection
+      quoted_aid = conn.quote(ActiveRecord::Type::Uuid.new.serialize(account_id))
+
+      conn.tables.sort.each do |table|
+        cols = conn.columns(table).map(&:name)
+        if cols.include?("account_id")
+          count = conn.select_value("SELECT COUNT(*) FROM #{conn.quote_table_name(table)} WHERE account_id = #{quoted_aid}")
+          assert_equal 0, count, "Expected 0 remaining rows in #{table} for incinerated account"
+        elsif table == "accounts"
+          assert_not Account.exists?(account_id), "Expected account to be deleted"
+        elsif table == "storage_totals"
+          count = Storage::Total.where(owner_id: [ account_id, *board_ids ]).count
+          assert_equal 0, count, "Expected 0 remaining rows in storage_totals for incinerated account and its boards"
+        elsif Account::Incineration::FILTER_JOIN_TABLES.include?(table)
+          subquery = filter_ids.map { |fid| conn.quote(ActiveRecord::Type::Uuid.new.serialize(fid)) }.join(",")
+          count = conn.select_value("SELECT COUNT(*) FROM #{conn.quote_table_name(table)} WHERE filter_id IN (#{subquery})")
+          assert_equal 0, count, "Expected 0 remaining rows in #{table} for incinerated account filters"
+        end
+      end
+
+      if conn.adapter_name == "SQLite"
+        fts_count = Search::Record::SQLite::Fts.where(rowid: search_record_ids).count
+        assert_equal 0, fts_count, "Expected 0 remaining rows in search_records_fts for incinerated account"
+      end
+    end
+end
