index 0000000..b940a18
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+require "fugit"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than 30 days ago and keeps others" do
+    freeze_time do
+      due_account = create_cancelled_account(name: "Due Account", cancelled_at: 31.days.ago)
+      just_due_account = create_cancelled_account(name: "Just Due Account", cancelled_at: 30.days.ago - 1.second)
+      boundary_account = create_cancelled_account(name: "Boundary Account", cancelled_at: 30.days.ago)
+      recent_account = create_cancelled_account(name: "Recent Account", cancelled_at: 29.days.ago)
+      active_account = accounts(:initech)
+
+      reactivated_account = create_cancelled_account(name: "Reactivated Account", cancelled_at: 31.days.ago)
+      reactivated_account.reactivate
+
+      Account::IncinerateDueJob.perform_now
+
+      assert_not Account.exists?(due_account.id)
+      assert_not Account.exists?(just_due_account.id)
+      assert_equal 0, User.where(account_id: due_account.id).count
+      assert_equal 0, Board.where(account_id: due_account.id).count
+      assert_equal 0, Card.where(account_id: due_account.id).count
+      assert_equal 0, Account::Cancellation.where(account_id: due_account.id).count
+
+      assert Account.exists?(boundary_account.id)
+      assert Account.exists?(recent_account.id)
+      assert Account.exists?(active_account.id)
+      assert Account.exists?(reactivated_account.id)
+    end
+  end
+
+  test "works when enqueued and performed asynchronously" do
+    due_account = create_cancelled_account(name: "Async Due Account", cancelled_at: 31.days.ago)
+
+    perform_enqueued_jobs do
+      Account::IncinerateDueJob.perform_later
+    end
+
+    assert_not Account.exists?(due_account.id)
+  end
+
+  test "queued to backend queue with concurrency limit" do
+    job = Account::IncinerateDueJob.new
+
+    assert_equal "backend", job.queue_name
+    assert_predicate job, :concurrency_limited?
+  end
+
+  test "configured as a recurring job in config/recurring.yml" do
+    path = Rails.root.join("config/recurring.yml")
+    erb = ERB.new(File.read(path))
+    erb.filename = path.to_s
+    config = YAML.safe_load(erb.result, aliases: true)
+
+    entry = config.fetch("production").values.find { |task| task["class"] == "Account::IncinerateDueJob" }
+
+    assert_not_nil entry, "Expected Account::IncinerateDueJob to be configured in config/recurring.yml"
+    assert_instance_of Fugit::Cron, Fugit.parse(entry["schedule"], multi: :fail)
+  end
+
+  private
+    def create_cancelled_account(name:, cancelled_at:)
+      account = Account.create_with_owner(
+        account: { name: name },
+        owner: { name: "#{name} Owner", identity: identities(:david) }
+      )
+      owner = account.users.owner.first
+      Current.set(account: account, user: owner) do
+        board = account.boards.create!(name: "#{name} Board", creator: owner)
+        board.cards.create!(title: "#{name} Card", creator: owner, status: :published)
+      end
+      account.cancel(initiated_by: owner)
+      account.cancellation.update_column(:created_at, cancelled_at)
+      account
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
