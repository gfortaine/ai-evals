+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "particulars_for_api for assignment events" do
+    event = events(:logo_assignment_jz)
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.particulars_for_api)
+
+    unassigned = Event.new(action: "card_unassigned", particulars: { "assignee_ids" => [ users(:david).id ] })
+    assert_equal({ assignee_ids: [ users(:david).id ] }, unassigned.particulars_for_api)
+
+    missing = Event.new(action: "card_assigned", particulars: {})
+    assert_equal({ assignee_ids: [] }, missing.particulars_for_api)
+  end
+
+  test "particulars_for_api for board change events" do
+    event = Event.new(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old", "new_board" => "New" } }
+    )
+    assert_equal({ old_board: "Old", new_board: "New" }, event.particulars_for_api)
+
+    missing = Event.new(action: "card_board_changed", particulars: {})
+    assert_equal({ old_board: "", new_board: "" }, missing.particulars_for_api)
+
+    nil_particulars = Event.new(action: "card_board_changed", particulars: nil)
+    assert_equal({ old_board: "", new_board: "" }, nil_particulars.particulars_for_api)
+  end
+
+  test "particulars_for_api for title change events" do
+    event = Event.new(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old Title", "new_title" => "New Title" } }
+    )
+    assert_equal({ old_title: "Old Title", new_title: "New Title" }, event.particulars_for_api)
+
+    missing = Event.new(action: "card_title_changed", particulars: {})
+    assert_equal({ old_title: "", new_title: "" }, missing.particulars_for_api)
+  end
+
+  test "particulars_for_api for triage events" do
+    event = Event.new(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+    assert_equal({ column: "In Progress" }, event.particulars_for_api)
+
+    missing = Event.new(action: "card_triaged", particulars: {})
+    assert_equal({ column: "" }, missing.particulars_for_api)
+  end
+
+  test "particulars_for_api returns empty hash for other events" do
+    %w[ card_published card_closed card_reopened card_postponed card_auto_postponed card_sent_back_to_triage comment_created ].each do |action|
+      event = Event.new(action: action, particulars: {})
+      assert_equal({}, event.particulars_for_api, "Expected empty particulars for #{action}")
+    end
+  end
+end
