+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,25 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events
+      end
+    end
+  end
+
+  private
+    def filtered_events
+      events = Current.user.accessible_events.for_activity_feed.preloaded_for_api.reverse_chronologically
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+
+    def creator_ids
+      Array.wrap(params[:creator_ids]).grep(String).compact_blank
+    end
+
+    def board_ids
+      Array.wrap(params[:board_ids]).grep(String).compact_blank
+    end
+end
