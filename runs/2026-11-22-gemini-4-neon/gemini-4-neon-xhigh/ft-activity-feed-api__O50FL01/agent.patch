diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..9b21909
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,452 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns flat array newest first with expected fields" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+
+    expected_events = users(:kevin).accessible_events.for_activity_feed.reverse_chronologically.to_a
+    assert_equal expected_events.map(&:id), activities.map { |a| a["id"] }
+    assert_equal expected_events.size.to_s, @response.headers["X-Total-Count"]
+
+    expected_keys = %w[ id action created_at description particulars url eventable_type eventable board creator ]
+    activities.each do |activity|
+      assert_equal expected_keys.sort, activity.keys.sort
+    end
+  end
+
+  test "index works via explicit /:account_slug/activities.json URL and Accept header" do
+    get "/#{accounts("37s").external_account_id}/activities.json"
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index returns card event with card representation and card URL" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_not_nil activity
+
+    assert_equal event.id, activity["id"]
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    # Matches existing card, board, and user API representations
+    get cards_path(format: :json)
+    expected_card = @response.parsed_body.find { |c| c["id"] == event.eventable.id }
+
+    get boards_path(format: :json)
+    expected_board = @response.parsed_body.find { |b| b["id"] == event.board.id }
+
+    get user_path(event.creator, format: :json)
+    expected_creator = @response.parsed_body
+
+    assert_equal expected_card, activity["eventable"]
+    assert_equal expected_board, activity["board"]
+    assert_equal expected_creator, activity["creator"]
+  end
+
+  test "index returns comment event with comment representation and comment anchor URL" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_not_nil activity
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+
+    get card_comment_path(comment.card, comment, format: :json)
+    expected_comment = @response.parsed_body
+
+    assert_equal expected_comment, activity["eventable"]
+  end
+
+  test "index includes card_title_changed and omits deprecated card_collection_changed and other non-timeline actions" do
+    card = cards(:logo)
+    title_changed = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => card.title } }
+    )
+    collection_changed = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_collection_changed",
+      particulars: { "particulars" => { "old_collection" => "Old", "new_collection" => "New" } }
+    )
+    resumed = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_resumed"
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    ids = @response.parsed_body.map { |a| a["id"] }
+    assert_includes ids, title_changed.id
+    assert_not_includes ids, collection_changed.id
+    assert_not_includes ids, resumed.id
+  end
+
+  test "index includes all timelineable actions and exposes expected particulars" do
+    card = cards(:logo)
+    board = card.board
+    creator = users(:david)
+    now = Time.current
+
+    assigned = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_assigned",
+      particulars: { "assignee_ids" => [ users(:jz).id ] }, created_at: now + 1.second
+    )
+    unassigned = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_unassigned",
+      particulars: { "assignee_ids" => [ users(:jz).id ] }, created_at: now + 2.seconds
+    )
+    board_changed = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old Board", "new_board" => "Writebook" } }, created_at: now + 3.seconds
+    )
+    title_changed = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Before", "new_title" => "After" } }, created_at: now + 4.seconds
+    )
+    triaged = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In progress" } }, created_at: now + 5.seconds
+    )
+    reopened = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_reopened", created_at: now + 6.seconds
+    )
+    postponed = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_postponed", created_at: now + 7.seconds
+    )
+    auto_postponed = Event.create!(
+      board: board, creator: accounts("37s").system_user, eventable: card, action: "card_auto_postponed", created_at: now + 8.seconds
+    )
+    sent_back = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_sent_back_to_triage", created_at: now + 9.seconds
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |a| a["id"] }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_id[assigned.id]["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_id[unassigned.id]["particulars"])
+    assert_equal({ "old_board" => "Old Board", "new_board" => "Writebook" }, by_id[board_changed.id]["particulars"])
+    assert_equal({ "old_title" => "Before", "new_title" => "After" }, by_id[title_changed.id]["particulars"])
+    assert_equal({ "column" => "In progress" }, by_id[triaged.id]["particulars"])
+    assert_equal({}, by_id[reopened.id]["particulars"])
+    assert_equal({}, by_id[postponed.id]["particulars"])
+    assert_equal({}, by_id[auto_postponed.id]["particulars"])
+    assert_equal({}, by_id[sent_back.id]["particulars"])
+    assert_equal accounts("37s").system_user.id, by_id[auto_postponed.id].dig("creator", "id")
+  end
+
+  test "end-to-end domain actions produce expected activity particulars and descriptions" do
+    card = cards(:buy_domain)
+    old_title = card.title
+    column = columns(:writebook_in_progress)
+
+    Current.set(session: sessions(:kevin), account: accounts("37s")) do
+      card.update!(title: "Buy a great domain")
+      card.triage_into(column)
+      card.toggle_assignment(users(:jz))
+      card.move_to(boards(:private))
+    end
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+
+    by_action = @response.parsed_body.index_by { |a| a["action"] }
+
+    assert_equal({ "old_title" => old_title, "new_title" => "Buy a great domain" }, by_action["card_title_changed"]["particulars"])
+    assert_equal({ "column" => column.name }, by_action["card_triaged"]["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_action["card_assigned"]["particulars"])
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, by_action["card_board_changed"]["particulars"])
+  end
+
+  test "missing board, title, or column particulars return empty strings" do
+    card = cards(:logo)
+    board = card.board
+    creator = users(:david)
+    now = Time.current
+
+    board_changed_missing = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_board_changed",
+      particulars: {}, created_at: now + 1.second
+    )
+    title_changed_missing = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => nil } }, created_at: now + 2.seconds
+    )
+    triaged_missing = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_triaged",
+      particulars: {}, created_at: now + 3.seconds
+    )
+    assigned_missing = Event.create!(
+      board: board, creator: creator, eventable: card, action: "card_assigned",
+      particulars: {}, created_at: now + 4.seconds
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |a| a["id"] }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, by_id[board_changed_missing.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, by_id[title_changed_missing.id]["particulars"])
+    assert_equal({ "column" => "" }, by_id[triaged_missing.id]["particulars"])
+    assert_equal({ "assignee_ids" => [] }, by_id[assigned_missing.id]["particulars"])
+  end
+
+  test "filter by creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_not_empty activities
+    assert activities.all? { |a| a.dig("creator", "id") == users(:kevin).id }
+
+    expected_ids = users(:kevin).accessible_events.for_activity_feed.where(creator_id: users(:kevin).id).reverse_chronologically.pluck(:id)
+    assert_equal expected_ids, activities.map { |a| a["id"] }
+  end
+
+  test "filter by multiple creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id, users(:david).id ] }
+    assert_response :success
+
+    creator_ids = @response.parsed_body.map { |a| a.dig("creator", "id") }.uniq
+    assert_includes creator_ids, users(:kevin).id
+    assert_includes creator_ids, users(:david).id
+  end
+
+  test "filter by board_ids" do
+    private_event = create_private_board_event
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_equal [ private_event.id ], activities.map { |a| a["id"] }
+  end
+
+  test "filter by creator_ids and board_ids combined" do
+    private_event = create_private_board_event
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.map { |a| a["id"] }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:david).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "filter ignores blank values and supports scalar params" do
+    get activities_path(format: :json), params: { creator_ids: [ "" ], board_ids: [ "" ] }
+    assert_response :success
+    expected_count = users(:kevin).accessible_events.for_activity_feed.count
+    assert_equal expected_count, @response.parsed_body.size
+
+    get activities_path(format: :json), params: { creator_ids: users(:kevin).id }
+    assert_response :success
+    assert @response.parsed_body.all? { |a| a.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "returns only activity from boards current user can access" do
+    private_event = create_private_board_event
+
+    # Kevin has access to private board
+    get activities_path(format: :json)
+    assert_response :success
+    assert_includes @response.parsed_body.map { |a| a["id"] }, private_event.id
+
+    # David does not have access to private board
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.map { |a| a["id"] }, private_event.id
+  end
+
+  test "filtering by inaccessible board returns empty array instead of falling back to all boards" do
+    create_private_board_event
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+    assert_equal "0", @response.headers["X-Total-Count"]
+  end
+
+  test "filtering by mix of accessible and inaccessible boards only returns accessible board events" do
+    private_event = create_private_board_event
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_response :success
+
+    ids = @response.parsed_body.map { |a| a["id"] }
+    assert_not_empty ids
+    assert_not_includes ids, private_event.id
+    assert @response.parsed_body.all? { |a| a.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "filtering by nonexistent creator_id or board_id returns empty array" do
+    get activities_path(format: :json), params: { creator_ids: [ "nonexistent" ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ "nonexistent" ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "does not leak events from another account" do
+    other_event = Event.create!(
+      account: accounts(:initech),
+      board: boards(:miltons_wish_list),
+      creator: users(:mike),
+      eventable: cards(:radio),
+      action: "card_published"
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.map { |a| a["id"] }, other_event.id
+  end
+
+  test "paginates results following API conventions" do
+    card = cards(:logo)
+    base_time = Time.current
+
+    20.times do |index|
+      Event.create!(
+        board: card.board,
+        creator: users(:david),
+        eventable: card,
+        action: "card_reopened",
+        created_at: base_time + index.seconds
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events.for_activity_feed.reverse_chronologically.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.map { |activity| activity["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "paginates filtered results preserving query parameters" do
+    card = cards(:logo)
+    base_time = Time.current
+
+    20.times do |index|
+      Event.create!(
+        board: card.board,
+        creator: users(:kevin),
+        eventable: card,
+        action: "card_reopened",
+        created_at: base_time + index.seconds
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events.for_activity_feed
+      .where(creator_id: users(:kevin).id)
+      .reverse_chronologically
+      .pluck(:id)
+
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.map { |activity| activity["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "works with personal access token authentication" do
+    sign_out
+    read_token = { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:jasons_api_token).token}" }
+
+    get activities_path(format: :json), env: read_token
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "rejects invalid bearer token" do
+    sign_out
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer invalid-token" }
+    assert_response :unauthorized
+  end
+
+  test "rejects HTML format" do
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  private
+    def create_private_board_event
+      Current.set(session: sessions(:kevin), account: accounts("37s")) do
+        private_card = boards(:private).cards.create!(title: "Private Card", creator: users(:kevin), status: :published)
+        private_card.events.find_by!(action: "card_published")
+      end
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
