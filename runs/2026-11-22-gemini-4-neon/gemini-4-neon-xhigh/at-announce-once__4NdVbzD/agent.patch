diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..a5102f0
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,286 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "announces once when going live" do
+    book = books(:manual)
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        book.update!(published: true)
+      end
+    end
+  end
+
+  test "announces once when going live and adding a page in the same transaction" do
+    book = books(:manual)
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        book.transaction do
+          book.update!(published: true)
+          book.press Page.new(body: ""), title: "Launch Note"
+        end
+      end
+    end
+
+    assert book.reload.published?
+    assert_equal 1, book.leaves.count
+  end
+
+  test "announces once when going live alongside multiple page and book updates in the same transaction" do
+    book = books(:handbook)
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        book.transaction do
+          book.update!(published: true)
+          book.press Page.new(body: ""), title: "New Page"
+          book.leaves.find(leaves(:welcome_page).id).update!(title: "Updated Welcome")
+          book.leaves.find(leaves(:summary_page).id).update!(status: :trashed)
+          book.update!(slug: "launched-handbook")
+          book.touch
+        end
+      end
+    end
+
+    assert book.reload.published?
+    assert_equal "launched-handbook", book.slug
+  end
+
+  test "announces once when another in-memory Book or Leaf instance touches the book in the same transaction" do
+    book = books(:handbook)
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        book.transaction do
+          book.update!(published: true)
+          Book.find(book.id).update!(slug: "other-instance-slug")
+          Leaf.find(leaves(:welcome_page).id).update!(title: "Separate Leaf Update")
+        end
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "does not announce when taking a live book back down" do
+    book = books(:manual)
+    book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "does not announce when saving an already-live book again" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true, slug: "still-live")
+        book.press Page.new(body: ""), title: "Bonus Chapter"
+        book.leaves.find(leaves(:welcome_page).id).update!(title: "Edited Welcome")
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "does not announce when saving a draft book without going live" do
+    book = books(:handbook)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: false, slug: "still-draft")
+        book.press Page.new(body: ""), title: "Draft Page"
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "leaves a draft and announces nothing when transaction fails after marking live" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(ActiveRecord::RecordNotFound) do
+        book.transaction do
+          book.update!(published: true)
+          book.leaves.find(-1).update!(status: :trashed)
+        end
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "leaves a draft and announces nothing on explicit rollback" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "does not announce when taken live and taken back down in the same transaction" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.update!(published: false)
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "announces once when toggled live, down, and live again in the same transaction" do
+    book = books(:manual)
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        book.transaction do
+          book.update!(published: true)
+          book.update!(published: false)
+          book.update!(published: true)
+        end
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "does not announce when already-live book is taken down and put back live in the same transaction" do
+    book = books(:manual)
+    book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: false)
+        book.update!(published: true)
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "announces once when created already live and announces nothing when created as draft" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create!(title: "Fresh Draft")
+    end
+
+    live_book = nil
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      live_book = Book.create!(title: "Born Live", published: true)
+    end
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ live_book ])
+  end
+
+  test "announces once when created as draft and published in the same transaction" do
+    book = nil
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        book = Book.create!(title: "Draft Then Live")
+        book.update!(published: true)
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "does not announce when published then destroyed in the same transaction" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.destroy!
+      end
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "handles nested savepoint rollbacks and commits accurately" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(slug: "outer-change")
+        book.transaction(requires_new: true) do
+          book.update!(published: true)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+    assert_not book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.transaction(requires_new: true) do
+          book.update!(published: false)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+    assert book.reload.published?
+
+    book.update!(published: false)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.transaction(requires_new: true) do
+          book.update!(published: true)
+        end
+        raise ActiveRecord::Rollback
+      end
+    end
+    assert_not book.reload.published?
+  end
+
+  test "announces each book once when multiple books go live in the same transaction" do
+    manual = books(:manual)
+    handbook = books(:handbook)
+
+    assert_enqueued_jobs 2, only: AnnouncePublicationJob do
+      Book.transaction do
+        manual.update!(published: true)
+        handbook.update!(published: true)
+        manual.press Page.new(body: ""), title: "Manual Page"
+        handbook.press Page.new(body: ""), title: "Handbook Page"
+      end
+    end
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ manual ])
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ handbook ])
+  end
+
+  test "announces again if taken down and later republished in a new sitting" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.update!(published: true)
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.update!(published: true)
+    end
+  end
+end
