--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+require "rake"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions! preserves hand-arranged order and compacts scores to 1..n" do
+    leaves(:reading_picture).move_to_position(0)
+    leaves(:summary_page).move_to_position(1)
+    leaves(:welcome_page).update!(position_score: 50.0)
+
+    expected = [ leaves(:reading_picture), leaves(:summary_page), leaves(:welcome_section), leaves(:welcome_page) ]
+    assert_equal expected, books(:handbook).leaves.positioned.to_a
+
+    books(:handbook).compact_positions!
+
+    compacted = books(:handbook).leaves.positioned.to_a
+    assert_equal expected, compacted
+    assert_equal [ 1.0, 2.0, 3.0, 4.0 ], compacted.map(&:position_score)
+  end
+
+  test "compact_positions! preserves restore position of a hand-arranged trashed leaf" do
+    leaves(:reading_picture).move_to_position(1)
+    leaves(:reading_picture).trashed!
+
+    books(:handbook).compact_positions!
+    leaves(:reading_picture).reload.active!
+
+    expected = [ leaves(:welcome_section), leaves(:reading_picture), leaves(:welcome_page), leaves(:summary_page) ]
+    assert_equal expected, books(:handbook).leaves.active.positioned.to_a
+    assert_equal [ 1.0, 2.0, 3.0, 4.0 ], books(:handbook).leaves.active.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! keeps trashed leaves aligned with compacted active leaves" do
+    leaves(:welcome_section).update!(position_score: 10.0)
+    leaves(:welcome_page).update!(position_score: 20.0)
+    leaves(:summary_page).update!(position_score: 30.0)
+    leaves(:reading_picture).update!(position_score: 40.0)
+    leaves(:welcome_page).trashed!
+
+    books(:handbook).compact_positions!
+    leaves(:welcome_page).reload.active!
+
+    expected = [ leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page), leaves(:reading_picture) ]
+    assert_equal expected, books(:handbook).leaves.active.positioned.to_a
+  end
+
+  test "compact_positions! only affects leaves in the target book" do
+    other_leaf = books(:manual).press Page.new(body: "Other"), title: "Other"
+    other_leaf.update!(position_score: 42.0)
+
+    books(:handbook).compact_positions!
+
+    assert_equal 42.0, other_leaf.reload.position_score
+  end
+
+  test "compact_positions! handles a book with no leaves" do
+    assert_nothing_raised { books(:manual).compact_positions! }
+  end
+
+  test "maintenance:compact_positions rake task compacts all books while preserving order" do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("maintenance:compact_positions")
+
+    leaves(:reading_picture).move_to_position(0)
+    leaves(:welcome_page).update!(position_score: 50.0)
+    expected = books(:handbook).leaves.positioned.to_a
+
+    Rake::Task["maintenance:compact_positions"].reenable
+    Rake::Task["maintenance:compact_positions"].invoke
+
+    compacted = books(:handbook).leaves.positioned.to_a
+    assert_equal expected, compacted
+    assert_equal [ 1.0, 2.0, 3.0, 4.0 ], compacted.map(&:position_score)
+  end
+
+  test "live_leaf_count returns how many leaves are not trashed" do
+    assert_equal 4, books(:handbook).live_leaf_count
+    assert_equal 0, books(:manual).live_leaf_count
+
+    leaves(:summary_page).trashed!
+    assert_equal 3, books(:handbook).live_leaf_count
+
+    leaves(:summary_page).active!
+    assert_equal 4, books(:handbook).live_leaf_count
+  end
+
+  test "sqlite strict strings mode rejects misspelled double-quoted identifiers" do
+    assert ActiveRecord::ConnectionAdapters::SQLite3Adapter.strict_strings_by_default
+
+    assert_raises(ActiveRecord::StatementInvalid) do
+      Book.connection.execute('SELECT "position_socre" FROM leaves')
+    end
+  end
+end
