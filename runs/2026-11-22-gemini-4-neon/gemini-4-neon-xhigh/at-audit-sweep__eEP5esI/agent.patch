diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..405e1d1
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,197 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @secret_leaf = books(:manual).press Page.new(body: "Top secret"), title: "Secret Manual Page"
+  end
+
+  test "show renders search page without query" do
+    sign_in :kevin
+
+    get library_search_path
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show treats whitespace-only query as empty" do
+    sign_in :kevin
+
+    get library_search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show returns matching pages from readable books" do
+    sign_in :kevin
+
+    get library_search_path, params: { q: "welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 2
+    assert_in_body "Welcome to The Handbook!"
+    assert_in_body "The Welcome Section"
+    assert_not_in_body "Summary"
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "show returns no matches when signed-in user has no readable books" do
+    outsider = User.create!(name: "Outsider", email_address: "outsider@example.com", password: "secret123456")
+    outsider.accesses.delete_all
+    sign_in outsider
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_in_body "No matches."
+  end
+
+  test "show excludes trashed leaves" do
+    sign_in :kevin
+    leaves(:summary_page).trashed!
+
+    get library_search_path, params: { q: "Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_in_body "No matches."
+  end
+
+  test "show only returns results from published books when signed out" do
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_not_in_body "Welcome to The Handbook!"
+
+    books(:handbook).update!(published: true)
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "show includes results from published books for signed-in users without explicit access" do
+    sign_in :kevin
+    books(:manual).update!(published: true)
+
+    get library_search_path, params: { q: "Secret Manual" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Secret Manual Page"
+  end
+
+  test "show prevents SQL injection from returning unreadable books" do
+    sign_in :kevin
+
+    [
+      "' OR 1=1 --",
+      "') OR 1=1 --",
+      "' OR '1'='1",
+      "%' OR 1=1 --",
+      "' UNION SELECT * FROM leaves --"
+    ].each do |payload|
+      get library_search_path, params: { q: payload }
+
+      assert_response :success, "Expected 200 for payload #{payload.inspect}"
+      assert_select "a.search__result", count: 0
+      assert_not_in_body "Secret Manual Page"
+      assert_not_in_body "Welcome to The Handbook!"
+    end
+  end
+
+  test "show prevents SQL injection when signed out" do
+    get library_search_path, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_not_in_body "Secret Manual Page"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show handles apostrophes and punctuation as literal search terms" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "Body"), title: "O'Brien's \"Quoted\" Guide; Part 1"
+
+    get library_search_path, params: { q: "O'Brien's" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "O&#39;Brien&#39;s"
+
+    get library_search_path, params: { q: "'" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "O&#39;Brien&#39;s"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: '"' }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Quoted"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show treats percent sign as literal rather than wildcard" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "Discount details"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "Other discount"), title: "Save 500 off"
+    books(:manual).press Page.new(body: "Secret discount"), title: "Secret 90% off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 500 off"
+    assert_not_in_body "Secret 90% off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 500 off"
+    assert_not_in_body "Secret 90% off"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Summary"
+  end
+
+  test "show treats underscore as literal rather than wildcard" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "Snake case"), title: "snake_case_title"
+    books(:handbook).press Page.new(body: "No underscore"), title: "snakexcasextitle"
+
+    get library_search_path, params: { q: "snake_case" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "snake_case_title"
+    assert_not_in_body "snakexcasextitle"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "snake_case_title"
+    assert_not_in_body "snakexcasextitle"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Summary"
+  end
+
+  test "show treats backslash as literal rather than escape syntax" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "Windows path"), title: 'C:\Users\Docs'
+
+    get library_search_path, params: { q: "\\" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body 'C:\Users\Docs'
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Summary"
+  end
+end
