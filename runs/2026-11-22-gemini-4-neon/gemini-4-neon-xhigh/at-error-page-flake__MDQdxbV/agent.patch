@@ -0,0 +1,49 @@
+require "test_helper"
+
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises exceptions inside the block and renders error pages outside" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "restores error page rendering when an exception escapes the block" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "supports nested blocks without restoring prematurely" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_path(books(:manual))
+        end
+      end
+
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "returns the value of the block" do
+    assert_equal :ok, with_raised_exceptions { :ok }
+  end
+end
