@@ -26,4 +28,65 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges uploaded markdown blobs and files" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = page.body.uploads.attachments.last
+    blob = attachment.blob
+    page.update!(body: "![reading](#{attachment.slug_path})")
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert ActiveStorage::Blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
+
+  test "destroying a page with multiple embedded images purges all of them" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    page.body.uploads.attach io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp"
+
+    attachments = page.body.uploads.attachments.to_a
+    blobs = attachments.map(&:blob)
+
+    assert_equal 2, blobs.size
+    blobs.each { |blob| assert ActiveStorage::Blob.service.exist?(blob.key) }
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    attachments.each { |attachment| assert_not ActiveStorage::Attachment.exists?(attachment.id) }
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not ActiveStorage::Blob.service.exist?(blob.key)
+    end
+  end
+
+  test "destroying a page does not purge uploads belonging to other pages" do
+    pages(:welcome).body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    pages(:summary).body.uploads.attach io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp"
+
+    welcome_blob = pages(:welcome).body.uploads.attachments.last.blob
+    summary_attachment = pages(:summary).body.uploads.attachments.last
+    summary_blob = summary_attachment.blob
+
+    perform_enqueued_jobs do
+      pages(:welcome).destroy!
+    end
+
+    assert_not ActiveStorage::Blob.exists?(welcome_blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(welcome_blob.key)
+
+    assert ActiveStorage::Attachment.exists?(summary_attachment.id)
+    assert ActiveStorage::Blob.exists?(summary_blob.id)
+    assert ActiveStorage::Blob.service.exist?(summary_blob.key)
+  end
 end
