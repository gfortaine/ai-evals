@@ -63,4 +65,51 @@ class Leaf::EditableTest < ActiveSupport::TestCase
     assert leaves(:welcome_page).edits.last.trash?
     assert_equal "This is _such_ a great handbook.", leaves(:welcome_page).edits.last.page.body.content
   end
+
+  test "destroying an edited leaf purges uploads from its revision history" do
+    leaf = leaves(:welcome_page)
+    original_page = leaf.page
+    original_page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = original_page.body.uploads.attachments.last
+    blob = attachment.blob
+
+    leaf.edit leafable_params: { body: "![reading](#{attachment.slug_path})" }
+
+    perform_enqueued_jobs do
+      Leaf.find(leaf.id).destroy!
+    end
+
+    assert_not Page.exists?(original_page.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
+
+  test "destroying a trashed leaf purges its uploads cleanly" do
+    leaf = leaves(:welcome_page)
+    page = leaf.page
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = page.body.uploads.attachments.last
+    blob = attachment.blob
+
+    leaf.trashed!
+
+    perform_enqueued_jobs do
+      Leaf.find(leaf.id).destroy!
+    end
+
+    assert_not Page.exists?(page.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
+
+  test "destroying a trash edit does not destroy the leaf's current leafable" do
+    leaf = leaves(:welcome_page)
+    leaf.trashed!
+
+    leaf.edits.trash.first.destroy!
+
+    assert Page.exists?(leaf.leafable_id)
+  end
 end
