+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot publish board" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot publish board as JSON" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot unpublish board" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "non-admin cannot unpublish board as JSON" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "member without board access gets not found" do
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(boards(:private))
+
+    assert_response :not_found
+    assert_not boards(:private).reload.published?
+  end
+
+  test "edit page shows publication toggle and public url when published" do
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input[name='published']:not([disabled]):not([checked])"
+
+    @board.publish
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input[name='published'][checked]:not([disabled])"
+    assert_select "input[readonly][value=?]", public_board_url(@board.publication.key)
+  end
+
+  test "edit page disables publication toggle for non-admin" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input[name='published'][disabled]"
+  end
+
+test "publish and unpublish with bearer token" do
+  sign_out
+  write_token = Identity::AccessToken.create!(identity: identities(:kevin), permission: :write)
+  read_token = Identity::AccessToken.create!(identity: identities(:kevin), permission: :read)
+
+  post board_publication_path(@board), as: :json, headers: { "Authorization" => "Bearer #{read_token.token}" }
+  assert_response :unauthorized
+  assert_not @board.reload.published?
+
+  post board_publication_path(@board), as: :json, headers: { "Authorization" => "Bearer #{write_token.token}" }
+  assert_response :created
+  assert @board.reload.published?
+  assert_equal public_board_url(@board.publication.key), @response.parsed_body["public_url"]
+
+  delete board_publication_path(@board), as: :json, headers: { "Authorization" => "Bearer #{write_token.token}" }
+  assert_response :no_content
+  assert_not @board.reload.published?
+end
+end
