diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..2fc0b5d
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,34 @@
+<%= turbo_frame_tag board, :publication do %>
+  <section class="settings__section">
+    <header>
+      <h2 class="divider">Public link</h2>
+      <p class="margin-none-block-start">Publish this board so anyone with the secret link can view it.</p>
+    </header>
+
+    <%= form_with url: board_publication_path(board), method: board.published? ? :delete : :post, data: { controller: "form" } do %>
+      <div class="flex align-center justify-center gap-half">
+        <label class="switch">
+          <%= check_box_tag :published, "1", board.published?,
+                class: "switch__input",
+                disabled: !Current.user.can_administer_board?(board),
+                data: { action: "change->form#submit" } %>
+          <span class="switch__btn round"></span>
+          <span class="for-screen-reader"><%= board.published? ? "Unpublish this board" : "Publish this board" %></span>
+        </label>
+        <span><%= board.published? ? "Published" : "Publish this board" %></span>
+      </div>
+    <% end %>
+
+    <% if board.published? %>
+      <% url = published_board_url(board) %>
+      <div class="flex align-center gap-half">
+        <input type="text" class="input fill-white flex-item-grow" value="<%= url %>" aria-label="Public board URL" readonly>
+
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      </div>
+    <% end %>
+  </section>
+<% end %>
