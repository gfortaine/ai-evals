diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..2c53ee9
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,32 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication"
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  class_methods do
+    def find_by_published_key(key)
+      joins(:publication).find_by(publication: { key: key })
+    end
+  end
+
+  def publish
+    create_publication! unless published?
+  end
+
+  def unpublish
+    if published?
+      publication.destroy
+      association(:publication).reset
+    end
+  end
+
+  def published?
+    publication.present?
+  end
+
+  alias_method :publicly_accessible?, :published?
+end
