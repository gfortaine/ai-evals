diff --git a/saas/test/controllers/account/billing_portals_controller_test.rb b/saas/test/controllers/account/billing_portals_controller_test.rb
new file mode 100644
index 0000000..cc223fd
--- /dev/null
+++ b/saas/test/controllers/account/billing_portals_controller_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Account::BillingPortalsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admin can open Stripe Customer Portal" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_portal_1",
+      stripe_subscription_id: "sub_portal_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    portal_session = Struct.new(:url).new("https://billing.stripe.com/p/session/test_123")
+    Stripe::BillingPortal::Session.expects(:create).once.with do |args|
+      args[:customer] == "cus_portal_1" && args[:return_url].end_with?("#{@account.slug}/account/settings")
+    end.returns(portal_session)
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/test_123"
+  end
+
+  test "admin without stripe customer is redirected back to settings" do
+    sign_in_as :mike
+
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+  end
+
+  test "non-admin cannot open Stripe Customer Portal" do
+    sign_in_as :jz
+
+    post saas.account_billing_portal_path(script_name: accounts(:"37s").slug)
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..ccd2e10
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,234 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admin sees plan and Upgrade button in settings on Free plan" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_match "Free", response.body
+    assert_match "$20/month", response.body
+    assert_match "$25/month", response.body
+    assert_select "form[action=?] button", "#{@account.slug}/account/subscription", text: "Upgrade"
+    assert_select "form[action=?] button", "#{@account.slug}/account/subscription", text: "Upgrade to Unlimited+"
+  end
+
+  test "non-admin does not see plan or Upgrade in settings" do
+    sign_in_as :jz
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "button", text: "Upgrade", count: 0
+    assert_select "h2", text: "Subscription", count: 0
+  end
+
+  test "admin sees Unlimited plan and Manage billing when subscribed" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_settings_1",
+      stripe_subscription_id: "sub_settings_1",
+      plan_key: "monthly_v1",
+      status: "active",
+      current_period_end: 1.month.from_now,
+      next_amount_due_in_cents: 2000
+    )
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_match "Unlimited", response.body
+    assert_match "$20/month", response.body
+    assert_match "5 GB", response.body
+    assert_select "form[action=?] button", "#{@account.slug}/account/billing_portal", text: "Manage billing"
+    assert_select "button", text: "Upgrade", count: 0
+  end
+
+  test "admin sees Unlimited+ plan and 500 GB storage when subscribed" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_settings_plus",
+      stripe_subscription_id: "sub_settings_plus",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active",
+      current_period_end: 1.month.from_now,
+      next_amount_due_in_cents: 2500
+    )
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_match "Unlimited+", response.body
+    assert_match "$25/month", response.body
+    assert_match "500 GB", response.body
+    assert_select "button", text: "Manage billing"
+  end
+
+  test "admin sees past due notice when subscription is past due" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_past_due",
+      stripe_subscription_id: "sub_past_due",
+      plan_key: "monthly_v1",
+      status: "past_due"
+    )
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_match(/payment failed/i, response.body)
+    assert_select "button", text: "Manage billing"
+  end
+
+  test "admin sees cancellation date when subscription is scheduled to cancel" do
+    sign_in_as :mike
+    cancel_date = Date.new(2026, 12, 31).to_time
+    @account.create_subscription!(
+      stripe_customer_id: "cus_canceling",
+      stripe_subscription_id: "sub_canceling",
+      plan_key: "monthly_v1",
+      status: "active",
+      cancel_at: cancel_date
+    )
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_match(/will end on/i, response.body)
+    assert_select "button", text: "Manage billing"
+  end
+
+  test "admin sees complimentary Unlimited plan when comped" do
+    sign_in_as :mike
+    @account.comp
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_match "Unlimited", response.body
+    assert_match(/complimentary/i, response.body)
+    assert_select "button", text: "Upgrade", count: 0
+  end
+
+  test "admin can create Stripe Checkout session for Unlimited" do
+    sign_in_as :mike
+
+    with_stripe_price_ids(monthly: "price_monthly_v1", extra_storage: "price_extra_v1") do
+      customer = Struct.new(:id).new("cus_new_checkout")
+      checkout_session = Struct.new(:url).new("https://checkout.stripe.com/c/pay/cs_test_123")
+
+      Stripe::Customer.expects(:create).once.returns(customer)
+      Stripe::Checkout::Session.expects(:create).once.with do |args|
+        args[:customer] == "cus_new_checkout" &&
+          args[:mode] == "subscription" &&
+          args[:line_items] == [ { price: "price_monthly_v1", quantity: 1 } ] &&
+          args[:client_reference_id] == @account.id &&
+          args[:metadata][:plan_key] == "monthly_v1"
+      end.returns(checkout_session)
+
+      post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_v1" }
+
+      assert_response :see_other
+      assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+      assert_equal "cus_new_checkout", @account.reload.subscription.stripe_customer_id
+    end
+  end
+
+  test "admin can create Stripe Checkout session for Unlimited+ and reuses existing customer" do
+    sign_in_as :mike
+    @account.create_subscription!(stripe_customer_id: "cus_existing_1")
+
+    with_stripe_price_ids(monthly: "price_monthly_v1", extra_storage: "price_extra_v1") do
+      checkout_session = Struct.new(:url).new("https://checkout.stripe.com/c/pay/cs_test_plus")
+
+      Stripe::Customer.expects(:create).never
+      Stripe::Checkout::Session.expects(:create).once.with do |args|
+        args[:customer] == "cus_existing_1" &&
+          args[:line_items] == [ { price: "price_extra_v1", quantity: 1 } ] &&
+          args[:metadata][:plan_key] == "monthly_extra_storage_v1"
+      end.returns(checkout_session)
+
+      post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_extra_storage_v1" }
+
+      assert_response :see_other
+      assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_plus"
+    end
+  end
+
+  test "checkout rejects non-paid plan_key" do
+    sign_in_as :mike
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "free_v1" }
+    assert_response :unprocessable_entity
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "bogus" }
+    assert_response :unprocessable_entity
+  end
+
+  test "checkout redirects to settings when account already has active subscription" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_already_active",
+      stripe_subscription_id: "sub_already_active",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug)
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+  end
+
+  test "non-admin cannot start checkout" do
+    sign_in_as :jz
+
+    post saas.account_subscription_path(script_name: accounts(:"37s").slug)
+    assert_response :forbidden
+  end
+
+  test "checkout success return redirects to settings with notice" do
+    sign_in_as :mike
+
+    get saas.account_subscription_path(script_name: @account.slug)
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    assert_predicate flash[:notice], :present?
+  end
+
+test "account cancellation modal mentions subscription cancellation when active" do
+  sign_in_as :jason
+  account = accounts(:"37s")
+
+  with_multi_tenant_mode(true) do
+    get account_settings_path(script_name: account.slug)
+    assert_no_match "Your subscription will be canceled.", response.body
+
+    account.create_subscription!(
+      stripe_customer_id: "cus_cancel_modal",
+      stripe_subscription_id: "sub_cancel_modal",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    get account_settings_path(script_name: account.slug)
+    assert_match "Your subscription will be canceled.", response.body
+  end
+end
+
+  private
+    def with_stripe_price_ids(monthly:, extra_storage:)
+      old_monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      old_extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = monthly
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = extra_storage
+      yield
+    ensure
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = old_monthly
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = old_extra
+    end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..0fbae14
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts and open each account page" do
+    sign_in_as :david
+
+    untenanted do
+      get "/admin/accounts"
+      assert_response :success
+      assert_select "a[href=?]", "/admin/accounts/#{@account.id}", text: @account.name
+      assert_select "a[href=?]", "/admin/accounts/#{accounts(:"37s").id}", text: accounts(:"37s").name
+
+      get "/admin/accounts/#{@account.id}"
+      assert_response :success
+      assert_select "h1", text: @account.name
+      assert_select "button", text: "Comp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value=Override]"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "staff can filter accounts by query" do
+    sign_in_as :david
+
+    untenanted do
+      get "/admin/accounts", params: { q: "Initech" }
+      assert_response :success
+      assert_select "a", text: "Initech LLC"
+      assert_select "a", text: "37signals", count: 0
+    end
+  end
+
+  test "non-staff cannot access admin accounts or billing tools" do
+    sign_in_as :jz
+
+    untenanted do
+      get "/admin/accounts"
+      assert_response :forbidden
+
+      get "/admin/accounts/#{@account.id}"
+      assert_response :forbidden
+
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+
+      post saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 950 } }
+      assert_response :forbidden
+
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_response :forbidden
+    end
+  end
+
+  test "staff can comp and uncomp an account" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.comped?
+
+      follow_redirect!
+      assert_select "button", text: "Uncomp"
+      assert_select "button", text: "Comp", count: 0
+
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_not @account.reload.comped?
+
+      follow_redirect!
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp", count: 0
+    end
+  end
+
+  test "staff can override card count and bytes used and reset the override" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_overridden_limits_path(@account),
+        params: { overridden_limits: { card_count: 950, bytes_used: 2.gigabytes } }
+      assert_redirected_to saas.admin_account_path(@account)
+
+      @account.reload
+      assert_equal 950, @account.card_count
+      assert_equal 2.gigabytes, @account.bytes_used
+      assert @account.nearing_card_limit?
+      assert @account.exceeding_storage_limit?
+
+      post saas.admin_account_overridden_limits_path(@account),
+        params: { overridden_limits: { card_count: 1_000, bytes_used: "" } }
+      assert_redirected_to saas.admin_account_path(@account)
+
+      @account.reload
+      assert_equal 1_000, @account.card_count
+      assert_nil @account.overridden_limits.bytes_used
+      assert_equal 0, @account.bytes_used
+      assert @account.exceeding_card_limit?
+      assert_not @account.exceeding_storage_limit?
+
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+
+      @account.reload
+      assert_nil @account.overridden_limits
+      assert_equal @account.cards_count, @account.card_count
+      assert_not @account.exceeding_card_limit?
+    end
+  end
+
+  test "end-to-end support workflow: override limits, comp, uncomp, and reset affect publishing" do
+    sign_in_as :david
+    draft = cards(:unfinished_thoughts)
+
+    # Override card count to 1,000 as staff
+    untenanted do
+      post saas.admin_account_overridden_limits_path(@account),
+        params: { overridden_limits: { card_count: 1_000, bytes_used: "" } }
+    end
+
+    # Account user cannot publish when overridden to 1,000 cards
+    logout_and_sign_in_as :mike
+    post card_publish_path(draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert draft.reload.drafted?
+
+    # Staff comps the account -> publishing is now allowed
+    logout_and_sign_in_as :david
+    untenanted do
+      post saas.admin_account_billing_waiver_path(@account)
+    end
+
+    logout_and_sign_in_as :mike
+    get card_draft_path(draft, script_name: @account.slug)
+    assert_select ".card-perma__notch-new-card-buttons"
+
+    # Staff uncomps -> blocked again
+    logout_and_sign_in_as :david
+    untenanted do
+      delete saas.admin_account_billing_waiver_path(@account)
+    end
+
+    logout_and_sign_in_as :mike
+    post card_publish_path(draft, script_name: @account.slug)
+    assert_response :forbidden
+
+    # Staff resets override -> publishing succeeds
+    logout_and_sign_in_as :david
+    untenanted do
+      delete saas.admin_account_overridden_limits_path(@account)
+    end
+
+    logout_and_sign_in_as :mike
+    post card_publish_path(draft, script_name: @account.slug)
+    assert_response :redirect
+    assert draft.reload.published?
+  end
+
+  test "overriding bytes_used enforces storage limit even for staff" do
+    logout_and_sign_in_as :david
+    account = accounts(:"37s")
+
+    untenanted do
+      post saas.admin_account_overridden_limits_path(account),
+        params: { overridden_limits: { card_count: "", bytes_used: 2.gigabytes } }
+    end
+
+    assert_no_difference -> { Comment.count } do
+      post card_comments_path(cards(:logo), script_name: account.slug),
+        params: { comment: { body: "Blocked by override" } },
+        as: :turbo_stream
+    end
+    assert_response :forbidden
+
+    untenanted do
+      delete saas.admin_account_overridden_limits_path(account)
+    end
+
+    assert_difference -> { Comment.count }, 1 do
+      post card_comments_path(cards(:logo), script_name: account.slug),
+        params: { comment: { body: "Allowed after reset" } },
+        as: :turbo_stream
+    end
+    assert_response :success
+  end
+end
diff --git a/saas/test/controllers/card/limited_test.rb b/saas/test/controllers/card/limited_test.rb
new file mode 100644
index 0000000..b1e4903
--- /dev/null
+++ b/saas/test/controllers/card/limited_test.rb
@@ -0,0 +1,171 @@
+require "test_helper"
+
+class Card::LimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+  end
+
+  test "free account out of cards can still draft via HTML" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "free account out of cards is refused publishing via HTML and JSON" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+
+    post card_publish_path(@draft, script_name: @account.slug), as: :json
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "free account out of cards is refused creating via JSON API" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Blocked API card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "free account out of cards replaces create buttons with Upgrade pitch for admin" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message" do
+      assert_select "strong", text: /1,000/
+      assert_select "form[action=?] button", "#{@account.slug}/account/subscription", text: "Upgrade"
+    end
+  end
+
+  test "free account out of cards replaces create buttons with Upgrade pitch for non-admin member" do
+    sign_in_as :jz
+    account = accounts(:"37s")
+    account.update_column(:cards_count, 1_000)
+    draft = boards(:writebook).cards.create!(creator: users(:jz), status: :drafted)
+
+    get card_draft_path(draft, script_name: account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message", text: /Upgrade/
+    assert_select ".card-perma__account-limit-message button", text: "Upgrade", count: 0
+  end
+
+  test "free account out of cards can still comment on existing cards" do
+    sign_in_as :jz
+    account = accounts(:"37s")
+    account.update_column(:cards_count, 1_000)
+
+    assert_difference -> { Comment.count }, 1 do
+      post card_comments_path(cards(:logo), script_name: account.slug),
+        params: { comment: { body: "Still allowed" } },
+        as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "free account counts down from 100 cards remaining on draft page" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 899)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_no_match(/cards? left/, response.body)
+
+    @account.update_column(:cards_count, 900)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_match "100 cards left", response.body
+
+    @account.update_column(:cards_count, 950)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_match "50 cards left", response.body
+
+    @account.update_column(:cards_count, 999)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_match "1 card left", response.body
+  end
+
+  test "paid Unlimited account can publish and create via API beyond 1,000 cards and up to 5 GB storage" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_paid_cards",
+      stripe_subscription_id: "sub_paid_cards",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    @account.update_column(:cards_count, 1_500)
+    Account.any_instance.stubs(:bytes_used).returns(3.gigabytes)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_no_match(/cards? left/, response.body)
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Unlimited API card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "paid Unlimited+ account allows up to 500 GB storage" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_plus_storage",
+      stripe_subscription_id: "sub_plus_storage",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+    Account.any_instance.stubs(:bytes_used).returns(250.gigabytes)
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "comped account can publish beyond 1,000 cards" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_500)
+    @account.comp
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..e3dda7c
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,335 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  WEBHOOK_SECRET = "whsec_test_signing_secret"
+
+  setup do
+    @account = accounts(:initech)
+    @old_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    @old_monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    @old_extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = WEBHOOK_SECRET
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited_v1"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus_v1"
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @old_secret
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @old_monthly
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = @old_extra
+  end
+
+  test "rejects invalid Stripe signature" do
+    untenanted do
+      post "/stripe/webhooks",
+        params: { id: "evt_bad", type: "customer.subscription.created", data: { object: {} } }.to_json,
+        headers: {
+          "CONTENT_TYPE" => "application/json",
+          "Stripe-Signature" => "t=123,v1=bad_signature"
+        }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "rejects missing webhook secret" do
+    ENV["STRIPE_WEBHOOK_SECRET"] = ""
+
+    post_stripe_event({ id: "evt_nosecret", type: "customer.subscription.created", data: { object: {} } })
+
+    assert_response :bad_request
+  end
+
+  test "checkout.session.completed links customer and subscription to account" do
+    post_stripe_event({
+      id: "evt_checkout_1",
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          id: "cs_test_1",
+          object: "checkout.session",
+          mode: "subscription",
+          customer: "cus_checkout_1",
+          subscription: "sub_checkout_1",
+          client_reference_id: @account.id,
+          payment_status: "paid",
+          metadata: { account_id: @account.id, plan_key: "monthly_v1" }
+        }
+      }
+    })
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert_equal "cus_checkout_1", subscription.stripe_customer_id
+    assert_equal "sub_checkout_1", subscription.stripe_subscription_id
+    assert_equal "monthly_v1", subscription.plan_key
+    assert subscription.active?
+    assert_equal Plan.paid, @account.plan
+  end
+
+  test "customer.subscription.created activates Unlimited plan" do
+    period_end = 1.month.from_now.to_i
+
+    post_stripe_event({
+      id: "evt_sub_created",
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_created_1",
+          object: "subscription",
+          customer: "cus_created_1",
+          status: "active",
+          current_period_end: period_end,
+          cancel_at: nil,
+          cancel_at_period_end: false,
+          metadata: { account_id: @account.id },
+          items: {
+            object: "list",
+            data: [
+              {
+                id: "si_1",
+                price: { id: "price_unlimited_v1", unit_amount: 2000 }
+              }
+            ]
+          }
+        }
+      }
+    })
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert_equal "sub_created_1", subscription.stripe_subscription_id
+    assert_equal "cus_created_1", subscription.stripe_customer_id
+    assert_equal "monthly_v1", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal Time.at(period_end), subscription.current_period_end
+    assert_equal 2000, subscription.next_amount_due_in_cents
+    assert_equal Plan.paid, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "customer.subscription.updated switches plan to Unlimited+ with item-level period end" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_upgrade_1",
+      stripe_subscription_id: "sub_upgrade_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    period_end = 1.month.from_now.to_i
+
+    post_stripe_event({
+      id: "evt_sub_upgraded",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_upgrade_1",
+          object: "subscription",
+          customer: "cus_upgrade_1",
+          status: "active",
+          cancel_at: nil,
+          cancel_at_period_end: false,
+          items: {
+            object: "list",
+            data: [
+              {
+                id: "si_2",
+                current_period_end: period_end,
+                price: { id: "price_unlimited_plus_v1", unit_amount: 2500 }
+              }
+            ]
+          }
+        }
+      }
+    })
+
+    assert_response :ok
+    @account.reload
+    assert_equal Plan.paid_extra_storage, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_equal 2500, @account.subscription.next_amount_due_in_cents
+    assert_equal Time.at(period_end), @account.subscription.current_period_end
+  end
+
+  test "customer.subscription.updated records scheduled cancellation and resumption" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_sched_1",
+      stripe_subscription_id: "sub_sched_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    period_end = 1.month.from_now.to_i
+
+    post_stripe_event({
+      id: "evt_sched_cancel",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_sched_1",
+          object: "subscription",
+          customer: "cus_sched_1",
+          status: "active",
+          current_period_end: period_end,
+          cancel_at_period_end: true,
+          cancel_at: period_end,
+          items: { object: "list", data: [ { price: { id: "price_unlimited_v1", unit_amount: 2000 } } ] }
+        }
+      }
+    })
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert subscription.active?
+    assert subscription.to_be_canceled?
+    assert_equal Time.at(period_end), subscription.cancel_at
+    assert_nil subscription.next_amount_due_in_cents
+
+    post_stripe_event({
+      id: "evt_sched_resume",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_sched_1",
+          object: "subscription",
+          customer: "cus_sched_1",
+          status: "active",
+          current_period_end: period_end,
+          cancel_at_period_end: false,
+          cancel_at: nil,
+          items: { object: "list", data: [ { price: { id: "price_unlimited_v1", unit_amount: 2000 } } ] }
+        }
+      }
+    })
+
+    assert_response :ok
+    subscription.reload
+    assert_not subscription.to_be_canceled?
+    assert_nil subscription.cancel_at
+    assert_equal 2000, subscription.next_amount_due_in_cents
+  end
+
+  test "customer.subscription.deleted cancels subscription and reverts account to Free" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_del_1",
+      stripe_subscription_id: "sub_del_1",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active",
+      next_amount_due_in_cents: 2500
+    )
+
+    post_stripe_event({
+      id: "evt_sub_deleted",
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_del_1",
+          object: "subscription",
+          customer: "cus_del_1",
+          status: "canceled",
+          canceled_at: Time.current.to_i
+        }
+      }
+    })
+
+    assert_response :ok
+    @account.reload
+    assert @account.subscription.canceled?
+    assert_nil @account.active_subscription
+    assert_nil @account.subscription.next_amount_due_in_cents
+    assert_equal Plan.free, @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "stale customer.subscription.deleted does not cancel a newer active subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_stale_1",
+      stripe_subscription_id: "sub_new_active",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    post_stripe_event({
+      id: "evt_stale_del",
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_old_canceled",
+          object: "subscription",
+          customer: "cus_stale_1",
+          status: "canceled"
+        }
+      }
+    })
+
+    assert_response :ok
+    assert @account.reload.subscription.active?
+    assert_equal "sub_new_active", @account.subscription.stripe_subscription_id
+  end
+
+  test "invoice.payment_failed and invoice.paid update past_due status" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_inv_1",
+      stripe_subscription_id: "sub_inv_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    post_stripe_event({
+      id: "evt_inv_fail",
+      type: "invoice.payment_failed",
+      data: {
+        object: {
+          id: "in_fail_1",
+          object: "invoice",
+          customer: "cus_inv_1",
+          subscription: "sub_inv_1"
+        }
+      }
+    })
+    assert_response :ok
+    assert @account.reload.subscription.past_due?
+
+    post_stripe_event({
+      id: "evt_inv_paid",
+      type: "invoice.paid",
+      data: {
+        object: {
+          id: "in_paid_1",
+          object: "invoice",
+          customer: "cus_inv_1",
+          subscription: "sub_inv_1"
+        }
+      }
+    })
+    assert_response :ok
+    assert_equal "active", @account.reload.subscription.status
+  end
+
+  test "unhandled event type returns 200 ok" do
+    post_stripe_event({
+      id: "evt_other",
+      type: "payment_intent.succeeded",
+      data: { object: { id: "pi_1" } }
+    })
+
+    assert_response :ok
+  end
+
+  private
+    def post_stripe_event(event_hash)
+      payload = event_hash.to_json
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, WEBHOOK_SECRET)
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      untenanted do
+        post "/stripe/webhooks",
+          params: payload,
+          headers: {
+            "CONTENT_TYPE" => "application/json",
+            "HTTP_USER_AGENT" => "Stripe/1.0 (+https://stripe.com/docs/webhooks)",
+            "Stripe-Signature" => header
+          }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..672d12d
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,220 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free account defaults" do
+    assert_equal Plan.free, @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_not @account.comped?
+    assert_nil @account.active_subscription
+  end
+
+  test "card limit countdown and exceeding boundaries on free plan" do
+    @account.update_column(:cards_count, 899)
+    assert_equal 101, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert_equal 100, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 950)
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 999)
+    assert_equal 1, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1_000)
+    assert_equal 0, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1_250)
+    assert_equal 0, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert @account.exceeding_card_limit?
+  end
+
+  test "active Unlimited subscription removes card limit and sets 5 GB storage allowance" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_unlimited_1",
+      stripe_subscription_id: "sub_unlimited_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    @account.update_column(:cards_count, 2_000)
+
+    assert_equal Plan.paid, @account.plan
+    assert_equal Float::INFINITY, @account.card_limit
+    assert_equal Float::INFINITY, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.stubs(:bytes_used).returns(2.gigabytes)
+    assert_not @account.exceeding_storage_limit?
+
+    @account.stubs(:bytes_used).returns(5.gigabytes + 1)
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "active Unlimited+ subscription sets 500 GB storage allowance" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_plus_1",
+      stripe_subscription_id: "sub_plus_1",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+
+    assert_equal Plan.paid_extra_storage, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.stubs(:bytes_used).returns(100.gigabytes)
+    assert_not @account.exceeding_storage_limit?
+
+    @account.stubs(:bytes_used).returns(500.gigabytes + 1)
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "storage limit uses greater of plan allowance and storage exception" do
+    @account.add_storage_exception(2.gigabytes)
+    assert_equal 2.gigabytes, @account.storage_limit
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_exc_1",
+      stripe_subscription_id: "sub_exc_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.add_storage_exception(10.gigabytes)
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+
+  test "canceled subscription reverts account to free plan" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_canceled_1",
+      stripe_subscription_id: "sub_canceled_1",
+      plan_key: "monthly_v1",
+      status: "canceled"
+    )
+
+    assert_nil @account.active_subscription
+    assert_equal Plan.free, @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp toggle billing waiver and plan" do
+    @account.update_column(:cards_count, 1_500)
+    assert @account.exceeding_card_limit?
+
+    @account.comp
+    @account.reload
+    assert @account.comped?
+    assert_equal Plan.paid, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+
+    @account.uncomp
+    @account.reload
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert @account.exceeding_card_limit?
+  end
+
+  test "override limits overrides card_count and bytes_used without mutating real cards_count" do
+    @account.update_column(:cards_count, 10)
+    @account.override_limits(card_count: 950, bytes_used: 2.gigabytes)
+    @account.reload
+
+    assert_equal 10, @account.cards_count
+    assert_equal 950, @account.card_count
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.override_limits(card_count: 0, bytes_used: nil)
+    @account.reload
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+    assert_not @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+    @account.reload
+    assert_nil @account.overridden_limits
+    assert_equal 10, @account.card_count
+  end
+
+  test "cancelling account cancels active Stripe subscription" do
+    subscription = @account.create_subscription!(
+      stripe_customer_id: "cus_cancel_acct",
+      stripe_subscription_id: "sub_cancel_acct",
+      plan_key: "monthly_v1",
+      status: "active",
+      next_amount_due_in_cents: 2000
+    )
+
+    Stripe::Subscription.expects(:cancel).with("sub_cancel_acct").once
+
+    with_multi_tenant_mode(true) do
+      @account.cancel(initiated_by: users(:mike))
+    end
+
+    subscription.reload
+    assert subscription.canceled?
+    assert_nil subscription.next_amount_due_in_cents
+  end
+
+  test "cancelling account ignores missing Stripe subscription on resource_missing" do
+    subscription = @account.create_subscription!(
+      stripe_customer_id: "cus_missing",
+      stripe_subscription_id: "sub_missing",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    error = Stripe::InvalidRequestError.new("No such subscription", "id", code: "resource_missing")
+    Stripe::Subscription.expects(:cancel).with("sub_missing").raises(error)
+
+    with_multi_tenant_mode(true) do
+      @account.cancel(initiated_by: users(:mike))
+    end
+
+    assert subscription.reload.canceled?
+  end
+
+  test "destroying account destroys associated saas billing records" do
+    @account.create_subscription!(stripe_customer_id: "cus_destroy", plan_key: "monthly_v1", status: "canceled")
+    @account.comp
+    @account.override_limits(card_count: 500, bytes_used: 100)
+    @account.add_storage_exception(2.gigabytes)
+
+    assert_difference -> { Account::Subscription.count }, -1 do
+      assert_difference -> { Account::BillingWaiver.count }, -1 do
+        assert_difference -> { Account::OverriddenLimits.count }, -1 do
+          assert_difference -> { Account::StorageException.count }, -1 do
+            @account.destroy!
+          end
+        end
+      end
+    end
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..84dd1a3
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan pricing and limits" do
+    plan = Plan.free
+
+    assert_equal :free_v1, plan.key
+    assert_equal "Free", plan.name
+    assert_equal 0, plan.price
+    assert_equal 1_000, plan.card_limit
+    assert_equal 1.gigabyte, plan.storage_limit
+    assert plan.free?
+    assert_not plan.paid?
+    assert_not plan.unlimited?
+  end
+
+  test "unlimited plan pricing and limits" do
+    plan = Plan.paid
+
+    assert_equal :monthly_v1, plan.key
+    assert_equal "Unlimited", plan.name
+    assert_equal 20, plan.price
+    assert_equal Float::INFINITY, plan.card_limit
+    assert_equal 5.gigabytes, plan.storage_limit
+    assert plan.paid?
+    assert_not plan.free?
+    assert plan.unlimited?
+    assert_not plan.extra_storage?
+  end
+
+  test "unlimited+ plan pricing and limits" do
+    plan = Plan.paid_extra_storage
+
+    assert_equal :monthly_extra_storage_v1, plan.key
+    assert_equal "Unlimited+", plan.name
+    assert_equal 25, plan.price
+    assert_equal Float::INFINITY, plan.card_limit
+    assert_equal 500.gigabytes, plan.storage_limit
+    assert plan.paid?
+    assert_not plan.free?
+    assert plan.unlimited?
+    assert plan.extra_storage?
+  end
+
+  test "find resolves string and symbol keys" do
+    assert_equal Plan.free, Plan.find("free_v1")
+    assert_equal Plan.paid, Plan.find(:monthly_v1)
+    assert_equal Plan.paid_extra_storage, Plan.find("monthly_extra_storage_v1")
+    assert_nil Plan.find("nonexistent")
+    assert_nil Plan.find(nil)
+  end
+
+  test "find_by_price_id resolves configured Stripe price IDs" do
+    with_stripe_price_ids(monthly: "price_unlimited_test", extra_storage: "price_unlimited_plus_test") do
+      assert_equal Plan.paid, Plan.find_by_price_id("price_unlimited_test")
+      assert_equal Plan.paid_extra_storage, Plan.find_by_price_id("price_unlimited_plus_test")
+      assert_nil Plan.find_by_price_id("price_unknown")
+      assert_nil Plan.find_by_price_id("")
+      assert_nil Plan.find_by_price_id(nil)
+    end
+  end
+
+  test "find_by_price_id returns nil for nil even when env vars are unset" do
+    with_stripe_price_ids(monthly: nil, extra_storage: nil) do
+      assert_nil Plan.find_by_price_id(nil)
+      assert_nil Plan.find_by_price_id("")
+    end
+  end
+
+  private
+    def with_stripe_price_ids(monthly:, extra_storage:)
+      old_monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      old_extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = monthly
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = extra_storage
+      yield
+    ensure
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = old_monthly
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = old_extra
+    end
+end
