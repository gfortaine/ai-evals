+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "← Accounts", saas.admin_accounts_path, class: "btn" %>
+  </div>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account details</h2>
+      </header>
+
+      <div class="flex flex-column gap-quarter txt-align-start txt-small">
+        <div><strong>Name:</strong> <%= @account.name %></div>
+        <div><strong>Account ID:</strong> #<%= @account.external_account_id %></div>
+        <div><strong>Owner:</strong> <%= @account.owner_name || "None" %> (<%= @account.owner_email || "No email" %>)</div>
+        <div><strong>Plan:</strong> <%= @account.plan.name %><% if @account.comped? %> (Comped)<% end %></div>
+        <div>
+          <strong>Cards:</strong>
+          <%= number_with_delimiter(@account.cards_count) %>
+          <% if @account.overridden_limits&.card_count %>
+            (overridden to <%= number_with_delimiter(@account.overridden_limits.card_count) %>)
+          <% end %>
+          / <%= @account.card_limit.infinite? ? "Unlimited" : number_with_delimiter(@account.card_limit) %>
+        </div>
+        <div>
+          <strong>Storage:</strong>
+          <%= number_to_human_size(@account.real_bytes_used) %> (<%= number_with_delimiter(@account.real_bytes_used) %> bytes)
+          <% if @account.overridden_limits&.bytes_used %>
+            (overridden to <%= number_to_human_size(@account.overridden_limits.bytes_used) %> / <%= number_with_delimiter(@account.overridden_limits.bytes_used) %> bytes)
+          <% end %>
+          / <%= number_to_human_size(@account.storage_limit) %>
+        </div>
+        <% if @account.subscription %>
+          <div><strong>Subscription status:</strong> <%= @account.subscription.status || "pending" %></div>
+          <div><strong>Stripe customer:</strong> <%= @account.subscription.stripe_customer_id %></div>
+          <% if @account.subscription.stripe_subscription_id %>
+            <div><strong>Stripe subscription:</strong> <%= @account.subscription.stripe_subscription_id %></div>
+          <% end %>
+          <% if @account.subscription.current_period_end %>
+            <div><strong>Current period end:</strong> <%= @account.subscription.current_period_end.to_date.to_fs(:long) %></div>
+          <% end %>
+          <% if @account.subscription.cancel_at %>
+            <div><strong>Cancels at:</strong> <%= @account.subscription.cancel_at.to_date.to_fs(:long) %></div>
+          <% end %>
+        <% end %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing waiver</h2>
+        <div>
+          <% if @account.comped? %>
+            This account is comped and receives Fizzy <%= Plan.paid.name %> at no charge.
+          <% else %>
+            Comp this account to grant Fizzy <%= Plan.paid.name %> at no charge.
+          <% end %>
+        </div>
+      </header>
+
+      <div>
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn btn--negative" %>
+        <% else %>
+          <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+        <% end %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override limits</h2>
+        <div>Override card count and storage usage for this account.</div>
+      </header>
+
+      <%= form_with url: saas.admin_account_overridden_limits_path(@account), scope: :overridden_limits, method: :post, class: "flex flex-column gap-half" do |form| %>
+        <div class="flex flex-column gap-quarter txt-align-start">
+          <%= form.label :card_count, "Card count", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :card_count, value: @account.overridden_limits&.card_count, min: 0, class: "input", placeholder: @account.cards_count %>
+        </div>
+
+        <div class="flex flex-column gap-quarter txt-align-start">
+          <%= form.label :bytes_used, "Bytes used", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :bytes_used, value: @account.overridden_limits&.bytes_used, min: 0, class: "input", placeholder: @account.real_bytes_used %>
+        </div>
+
+        <div class="margin-block-start-half">
+          <%= form.submit "Override", class: "btn" %>
+        </div>
+      <% end %>
+
+      <div>
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn btn--negative" %>
+      </div>
+    </section>
+  </div>
+</section>
