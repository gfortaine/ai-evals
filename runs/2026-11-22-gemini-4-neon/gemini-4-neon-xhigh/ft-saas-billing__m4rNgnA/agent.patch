+<section class="settings__section">
+  <header>
+    <h2 class="divider">Subscription</h2>
+    <% if subscription = Current.account.active_subscription %>
+      <div>
+        You’re on <strong><%= Current.account.plan.name %></strong> — $<%= Current.account.plan.price %>/month (unlimited cards, <%= number_to_human_size(Current.account.storage_limit) %> storage).
+      </div>
+    <% elsif Current.account.comped? %>
+      <div>
+        You’re on <strong><%= Current.account.plan.name %></strong> (complimentary) — unlimited cards, <%= number_to_human_size(Current.account.storage_limit) %> storage.
+      </div>
+    <% else %>
+      <div>
+        You’re on the <strong><%= Current.account.plan.name %></strong> plan (<%= number_with_delimiter(Current.account.card_limit) %> cards, <%= number_to_human_size(Current.account.storage_limit) %> storage).
+      </div>
+    <% end %>
+  </header>
+
+  <div class="txt-small txt-ink-medium">
+    <% if Current.account.card_limit.infinite? %>
+      <%= number_with_delimiter(Current.account.card_count) %> cards •
+    <% else %>
+      <%= number_with_delimiter(Current.account.card_count) %> of <%= number_with_delimiter(Current.account.card_limit) %> cards •
+    <% end %>
+    <%= number_to_human_size(Current.account.bytes_used) %> of <%= number_to_human_size(Current.account.storage_limit) %> storage used
+  </div>
+
+  <% if subscription = Current.account.active_subscription %>
+    <% if subscription.past_due? %>
+      <div class="txt-small txt-negative">
+        Your last payment failed. Please update your payment method in the billing portal.
+      </div>
+    <% elsif subscription.to_be_canceled? %>
+      <div class="txt-small">
+        Your subscription will end on <strong><%= subscription.cancel_at.to_date.to_fs(:long) %></strong>.
+      </div>
+    <% elsif subscription.current_period_end.present? %>
+      <div class="txt-small">
+        Next payment<% if subscription.next_amount_due_in_cents %> of <strong><%= number_to_currency(subscription.next_amount_due_in_cents / 100.0) %></strong><% end %> on <strong><%= subscription.current_period_end.to_date.to_fs(:long) %></strong>.
+      </div>
+    <% end %>
+
+    <div>
+      <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), method: :post, class: "btn", form: { data: { turbo: false } } %>
+    </div>
+  <% elsif !Current.account.comped? %>
+    <div class="flex flex-column gap-half">
+      <div class="flex flex-column gap-quarter">
+        <div><strong><%= Plan.paid.name %></strong> — $<%= Plan.paid.price %>/month (unlimited cards, <%= number_to_human_size(Plan.paid.storage_limit) %> storage)</div>
+        <div>
+          <%= button_to "Upgrade", saas.account_subscription_path(script_name: Current.account.slug), method: :post,
+                params: { plan_key: Plan.paid.key },
+                class: "btn btn--link settings-subscription__button",
+                form: { data: { turbo: false } } %>
+        </div>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <div><strong><%= Plan.paid_extra_storage.name %></strong> — $<%= Plan.paid_extra_storage.price %>/month (unlimited cards, <%= number_to_human_size(Plan.paid_extra_storage.storage_limit) %> storage)</div>
+        <div>
+          <%= button_to "Upgrade to #{Plan.paid_extra_storage.name}", saas.account_subscription_path(script_name: Current.account.slug), method: :post,
+                params: { plan_key: Plan.paid_extra_storage.key },
+                class: "btn settings-subscription__button",
+                form: { data: { turbo: false } } %>
+        </div>
+      </div>
+
+      <% if Current.account.subscription&.stripe_customer_id.present? %>
+        <div>
+          <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), method: :post, class: "btn btn--plain txt-link txt-small", form: { data: { turbo: false } } %>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+</section>
