+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,49 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    notice = if Current.account.active_subscription
+      "Welcome to Fizzy #{Current.account.plan.name}!"
+    else
+      "Thanks for upgrading! Your subscription will be active shortly."
+    end
+
+    redirect_to main_app.account_settings_path, notice: notice
+  end
+
+  def create
+    if Current.account.active_subscription
+      redirect_to main_app.account_settings_path
+    elsif (plan = requested_plan)&.paid?
+      stripe_session = Stripe::Checkout::Session.create(
+        customer: Current.account.ensure_stripe_customer(email: Current.user.identity.email_address),
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: saas.account_subscription_url,
+        cancel_url: main_app.account_settings_url,
+        client_reference_id: Current.account.id,
+        metadata: {
+          account_id: Current.account.id,
+          plan_key: plan.key.to_s
+        },
+        subscription_data: {
+          metadata: {
+            account_id: Current.account.id
+          }
+        }
+      )
+      redirect_to stripe_session.url, allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def requested_plan
+      if params[:plan_key].present?
+        Plan.find(params[:plan_key])
+      else
+        Plan.paid
+      end
+    end
+end
