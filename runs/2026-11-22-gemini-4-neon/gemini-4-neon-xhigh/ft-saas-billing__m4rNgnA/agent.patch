@@ -0,0 +1,28 @@
+class Admin::Accounts::OverriddenLimitsController < AdminController
+  include Admin::AccountScoped
+
+  def create
+    card_count = overridden_limits_params[:card_count].presence
+    bytes_used = overridden_limits_params[:bytes_used].presence
+
+    if card_count.nil? && bytes_used.nil?
+      @account.reset_overridden_limits
+      redirect_to saas.admin_account_path(@account), notice: "Overrides reset"
+    else
+      @account.override_limits(card_count: card_count, bytes_used: bytes_used)
+      redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+    end
+  rescue ActiveRecord::RecordInvalid => error
+    redirect_to saas.admin_account_path(@account), alert: error.record.errors.full_messages.to_sentence
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Overrides reset"
+  end
+
+  private
+    def overridden_limits_params
+      params.expect(overridden_limits: [ :card_count, :bytes_used ])
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..f07ca00
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,33 @@
+class Admin::AccountsController < AdminController
+  include Admin::AccountScoped
+  skip_before_action :set_account, only: :index
+
+  layout "public"
+
+  def index
+    @query = params[:q].to_s.strip
+    @accounts = filtered_accounts.preload(:subscription, :billing_waiver, :overridden_limits, :storage_total, users: :identity)
+  end
+
+  def show
+  end
+
+  private
+    def filtered_accounts
+      scope = Account.order(created_at: :desc)
+
+      if @query.present?
+        if @query.match?(/\A\d+\z/)
+          scope.where(external_account_id: @query.to_i)
+        else
+          pattern = "%#{Account.sanitize_sql_like(@query)}%"
+          matching_account_ids = User.joins(:identity)
+            .where("identities.email_address LIKE ?", pattern)
+            .select(:account_id)
+          scope.where("accounts.name LIKE ? OR accounts.id IN (?)", pattern, matching_account_ids)
+        end
+      else
+        scope
+      end
+    end
+end
