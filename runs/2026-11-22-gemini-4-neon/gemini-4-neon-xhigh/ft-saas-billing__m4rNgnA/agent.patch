+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow" style="max-inline-size: 100%; inline-size: 100%;">
+    <div class="flex align-center justify-space-between gap-half">
+      <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half flex-item-grow" do |form| %>
+        <%= form.search_field :q, value: @query, placeholder: "Search by name, ID, or email...", class: "input flex-item-grow" %>
+        <%= form.submit "Search", class: "btn" %>
+      <% end %>
+
+      <%= link_to "Stats", saas.admin_stats_path, class: "btn" %>
+    </div>
+
+    <ul class="margin-block-half">
+      <% @accounts.each do |account| %>
+        <% owner = account.users.find(&:owner?) %>
+        <li class="flex align-start gap-half margin-block-start-half">
+          <div class="flex-item-grow min-width overflow-ellipsis" style="text-align: left">
+            <strong><%= link_to account.name, saas.admin_account_path(account) %></strong>
+            <br>
+            <span class="txt-x-small txt-ink-medium">
+              #<%= account.external_account_id %> •
+              <%= owner&.identity&.email_address || "No owner" %> •
+              <%= account.plan.name %><% if account.comped? %> (Comped)<% end %><% if account.overridden_limits %> (Overridden)<% end %>
+            </span>
+          </div>
+
+          <div class="txt-small txt-ink-medium" style="text-align: right">
+            <strong><%= number_with_delimiter(account.card_count) %></strong> cards
+            <br>
+            <%= number_to_human_size(account.bytes_used) %> / <%= number_to_human_size(account.storage_limit) %>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+  </div>
+</section>
