index 0000000..4ba3e52
--- /dev/null
+++ b/test/channels/being_edited_channel_test.rb
@@ -0,0 +1,165 @@
+require "test_helper"
+
+class BeingEditedChannelTest < ActionCable::Channel::TestCase
+  test "editor subscribes to their own stream for an active leaf" do
+    leaf = leaves(:welcome_page)
+    user = users(:kevin)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, user, :being_edited ])
+
+    stub_connection current_user: user
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.confirmed?
+    assert_has_stream BeingEditedChannel.verified_stream_name(signed_name)
+  end
+
+  test "administrator with reader access can subscribe" do
+    leaf = leaves(:welcome_page)
+    admin = users(:jason)
+    books(:handbook).access_for(user: admin).update!(level: :reader)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, admin, :being_edited ])
+
+    stub_connection current_user: admin
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.confirmed?
+    assert_has_stream BeingEditedChannel.verified_stream_name(signed_name)
+  end
+
+  test "administrator without access can subscribe to a published book" do
+    leaf = leaves(:welcome_page)
+    admin = users(:jason)
+    books(:handbook).access_for(user: admin).destroy!
+    books(:handbook).update!(published: true)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, admin, :being_edited ])
+
+    stub_connection current_user: admin
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.confirmed?
+    assert_has_stream BeingEditedChannel.verified_stream_name(signed_name)
+  end
+
+  test "administrator without access is rejected on an unpublished book" do
+    leaf = leaves(:welcome_page)
+    admin = users(:jason)
+    books(:handbook).access_for(user: admin).destroy!
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, admin, :being_edited ])
+
+    stub_connection current_user: admin
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "reader is rejected" do
+    leaf = leaves(:welcome_page)
+    reader = users(:jz)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, reader, :being_edited ])
+
+    stub_connection current_user: reader
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "removed collaborator is rejected even with previously issued signed stream name" do
+    leaf = leaves(:welcome_page)
+    user = users(:kevin)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, user, :being_edited ])
+
+    books(:handbook).access_for(user: user).destroy!
+
+    stub_connection current_user: user
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "deactivated user is rejected even when connection holds stale user record" do
+    leaf = leaves(:welcome_page)
+    stale_user = User.find(users(:kevin).id)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, stale_user, :being_edited ])
+
+    users(:kevin).deactivate
+
+    stub_connection current_user: stale_user
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "demoted administrator with reader access is rejected even with stale connection user" do
+    leaf = leaves(:welcome_page)
+    stale_admin = User.find(users(:jason).id)
+    books(:handbook).access_for(user: stale_admin).update!(level: :reader)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, stale_admin, :being_edited ])
+
+    users(:jason).update!(role: :member)
+
+    stub_connection current_user: stale_admin
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "user cannot subscribe to another editor's stream" do
+    leaf = leaves(:welcome_page)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, users(:jason), :being_edited ])
+
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "trashed leaf is rejected" do
+    leaf = leaves(:welcome_page)
+    user = users(:kevin)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, user, :being_edited ])
+    leaf.trashed!
+
+    stub_connection current_user: user
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects legacy shared stream format and malformed params" do
+    leaf = leaves(:welcome_page)
+    user = users(:kevin)
+    stub_connection current_user: user
+
+    [
+      BeingEditedChannel.signed_stream_name([ leaf, :being_edited ]),
+      BeingEditedChannel.signed_stream_name([ books(:handbook), user, :being_edited ]),
+      BeingEditedChannel.signed_stream_name([ leaf, user, :other ]),
+      BeingEditedChannel.signed_stream_name([ leaf, user, :being_edited, :extra ]),
+      "tampered",
+      "",
+      nil,
+      123
+    ].each do |signed_name|
+      subscribe signed_stream_name: signed_name
+      assert subscription.rejected?, "Expected rejection for #{signed_name.inspect}"
+      assert_no_streams
+    end
+  end
+
+  test "rejects connection without current_user" do
+    leaf = leaves(:welcome_page)
+    signed_name = BeingEditedChannel.signed_stream_name([ leaf, users(:kevin), :being_edited ])
+
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+end
