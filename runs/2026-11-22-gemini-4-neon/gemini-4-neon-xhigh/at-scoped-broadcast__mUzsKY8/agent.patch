index 0000000..65c4d63
--- /dev/null
+++ b/test/jobs/being_edited_broadcast_job_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class BeingEditedBroadcastJobTest < ActiveJob::TestCase
+  include ActionCable::TestHelper
+
+  test "broadcasts only to current active editors of the book" do
+    leaf = leaves(:welcome_page)
+    books(:handbook).access_for(user: users(:kevin)).destroy!
+
+    BeingEditedBroadcastJob.perform_now(leaf, users(:david))
+
+    assert_broadcasts stream_for(leaf, users(:jason)), 1
+    assert_broadcasts stream_for(leaf, users(:david)), 1
+    assert_no_broadcasts stream_for(leaf, users(:kevin))
+    assert_no_broadcasts stream_for(leaf, users(:jz))
+
+    payload = ActiveSupport::JSON.decode(broadcasts(stream_for(leaf, users(:jason))).first)
+    assert_includes payload, "David"
+    assert_includes payload, "being_edited_leaf_#{leaf.id}"
+  end
+
+  test "does not broadcast for a trashed leaf" do
+    leaf = leaves(:welcome_page)
+    leaf.trashed!
+
+    BeingEditedBroadcastJob.perform_now(leaf, users(:david))
+
+    assert_no_broadcasts stream_for(leaf, users(:jason))
+    assert_no_broadcasts stream_for(leaf, users(:david))
+  end
+
+  test "does not broadcast to deactivated users even when access row remains" do
+    leaf = leaves(:welcome_page)
+    users(:kevin).deactivate
+
+    BeingEditedBroadcastJob.perform_now(leaf, users(:david))
+
+    assert_broadcasts stream_for(leaf, users(:jason)), 1
+    assert_no_broadcasts stream_for(leaf, users(:kevin))
+  end
+
+  private
+    def stream_for(leaf, user)
+      BeingEditedChannel.verified_stream_name(BeingEditedChannel.signed_stream_name([ leaf, user, :being_edited ]))
+    end
+end
