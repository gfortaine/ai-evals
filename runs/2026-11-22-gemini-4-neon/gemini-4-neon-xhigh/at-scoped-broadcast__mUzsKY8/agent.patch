@@ -33,4 +33,36 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors returns active editors and administrators who can access the book" do
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort_by(&:id),
+      books(:handbook).editors.order(:id).to_a
+
+    assert_equal [ users(:david), users(:jason) ].sort_by(&:id),
+      books(:manual).editors.order(:id).to_a
+  end
+
+  test "editors includes administrators with reader access and excludes removed or downgraded members" do
+    books(:handbook).update_access(editors: [ users(:david).id ], readers: [])
+
+    assert_equal [ users(:david), users(:jason) ].sort_by(&:id),
+      books(:handbook).editors.order(:id).to_a
+  end
+
+  test "editors excludes deactivated users and demoted administrators without editor access" do
+    books(:handbook).access_for(user: users(:jason)).update!(level: :reader)
+    users(:jason).update!(role: :member)
+    users(:kevin).deactivate
+
+    assert_equal [ users(:david) ], books(:handbook).editors.to_a
+  end
+
+  test "editors includes administrators without access only when book is published" do
+    books(:handbook).access_for(user: users(:jason)).destroy!
+    assert_not_includes books(:handbook).editors, users(:jason)
+
+    books(:handbook).update!(published: true)
+    assert_includes books(:handbook).editors, users(:jason)
+    assert_not_includes books(:handbook).editors, users(:jz)
+  end
 end
