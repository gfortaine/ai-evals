diff --git a/test/integration/with_raised_exceptions_test.rb b/test/integration/with_raised_exceptions_test.rb
new file mode 100644
index 0000000..d3c8b23
--- /dev/null
+++ b/test/integration/with_raised_exceptions_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises controller exceptions inside the block and restores error rendering afterward" do
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "raises controller exceptions even after a prior request rendered an error page" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "restores error rendering when an exception escapes the block" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "supports nested blocks" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_path(books(:manual))
+        end
+      end
+
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+end
