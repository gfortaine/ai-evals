@@ -0,0 +1,36 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events
+      end
+    end
+  end
+
+  private
+    def filtered_events
+      events = Current.user.accessible_events.for_activity.reverse_chronologically.preloaded_for_activity
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+
+    def creator_ids
+      @creator_ids ||= filter_ids(:creator_ids)
+    end
+
+    def board_ids
+      @board_ids ||= filter_ids(:board_ids)
+    end
+
+    def filter_ids(param_name)
+      case value = params[param_name]
+      when Array
+        value.grep(String).compact_blank
+      when String
+        value.present? ? [ value ] : []
+      else
+        []
+      end
+    end
+end
