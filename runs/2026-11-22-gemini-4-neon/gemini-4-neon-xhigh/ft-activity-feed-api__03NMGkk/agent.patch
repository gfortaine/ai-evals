@@ -0,0 +1,347 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array ordered newest first" do
+    expected_ids = users(:kevin).accessible_events.for_activity.reverse_chronologically.pluck(:id)
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+    assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+  end
+
+  test "index as JSON includes expected attributes for card events" do
+    event = events(:logo_published)
+    card = event.eventable
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |entry| entry["id"] == event.id }
+    assert_not_nil activity
+
+    expected_keys = %w[ id action created_at description particulars url eventable_type eventable board creator ]
+    assert_equal expected_keys.sort, activity.keys.sort
+
+    assert_equal event.id, activity["id"]
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    get cards_path(format: :json)
+    expected_card = @response.parsed_body.find { |c| c["id"] == card.id }
+    assert_equal expected_card, activity["eventable"]
+
+    get board_path(event.board, format: :json)
+    assert_equal @response.parsed_body, activity["board"]
+
+    get user_path(event.creator, format: :json)
+    assert_equal @response.parsed_body, activity["creator"]
+  end
+
+  test "index as JSON includes expected attributes for comment events" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |entry| entry["id"] == event.id }
+    assert_not_nil activity
+
+    assert_equal event.id, activity["id"]
+    assert_equal "comment_created", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+
+    get card_comment_path(comment.card, comment, format: :json)
+    assert_equal @response.parsed_body, activity["eventable"]
+  end
+
+  test "index as JSON mirrors timeline events except omitting card_collection_changed and including card_title_changed" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+    now = Time.current
+
+    included_events = [
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_assigned", particulars: { assignee_ids: [ users(:jz).id ] }, created_at: now + 1.second),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_unassigned", particulars: { assignee_ids: [ users(:jz).id ] }, created_at: now + 2.seconds),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_published", created_at: now + 3.seconds),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_closed", created_at: now + 4.seconds),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_reopened", created_at: now + 5.seconds),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_title_changed", particulars: { particulars: { old_title: "Old", new_title: "New" } }, created_at: now + 6.seconds),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_board_changed", particulars: { particulars: { old_board: "Writebook", new_board: "Private board" } }, created_at: now + 7.seconds),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_postponed", created_at: now + 8.seconds),
+      Event.create!(board: board, creator: accounts("37s").system_user, eventable: card, action: "card_auto_postponed", created_at: now + 9.seconds),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_triaged", particulars: { particulars: { column: "Triage" } }, created_at: now + 10.seconds),
+      Event.create!(board: board, creator: creator, eventable: card, action: "card_sent_back_to_triage", created_at: now + 11.seconds),
+      Event.create!(board: board, creator: creator, eventable: comments(:layout_overflowing_david), action: "comment_created", created_at: now + 12.seconds)
+    ]
+
+    excluded_collection = Event.create!(board: board, creator: creator, eventable: card, action: "card_collection_changed", particulars: { particulars: { old_collection: "A", new_collection: "B" } }, created_at: now + 13.seconds)
+    excluded_resumed = Event.create!(board: board, creator: creator, eventable: card, action: "card_resumed", created_at: now + 14.seconds)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    returned_ids = @response.parsed_body.pluck("id")
+
+    included_events.each do |event|
+      assert_includes returned_ids, event.id, "Expected #{event.action} event to be included"
+    end
+
+    assert_not_includes returned_ids, excluded_collection.id
+    assert_not_includes returned_ids, excluded_resumed.id
+  end
+
+  test "index as JSON exposes event-specific particulars from real model actions" do
+    card = cards(:buy_domain)
+
+    with_current_user(:kevin) do
+      card.toggle_assignment(users(:jz))
+      card.toggle_assignment(users(:jz))
+      card.update!(title: "Buy the best domain")
+      card.triage_into(columns(:writebook_in_progress))
+      card.move_to(boards(:private))
+    end
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+
+    by_action = @response.parsed_body.index_by { |entry| entry["action"] }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_action.dig("card_assigned", "particulars"))
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_action.dig("card_unassigned", "particulars"))
+    assert_equal({ "old_title" => "Buy domain", "new_title" => "Buy the best domain" }, by_action.dig("card_title_changed", "particulars"))
+    assert_equal({ "column" => columns(:writebook_in_progress).name }, by_action.dig("card_triaged", "particulars"))
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, by_action.dig("card_board_changed", "particulars"))
+    assert_equal({}, by_action.dig("card_sent_back_to_triage", "particulars"))
+  end
+
+  test "index as JSON returns empty strings for missing board, title, or column particulars" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+    now = Time.current
+
+    board_changed_missing = Event.create!(board: board, creator: creator, eventable: card, action: "card_board_changed", particulars: {}, created_at: now + 1.second)
+    title_changed_missing = Event.create!(board: board, creator: creator, eventable: card, action: "card_title_changed", particulars: nil, created_at: now + 2.seconds)
+    triaged_missing = Event.create!(board: board, creator: creator, eventable: card, action: "card_triaged", particulars: {}, created_at: now + 3.seconds)
+    closed = Event.create!(board: board, creator: creator, eventable: card, action: "card_closed", created_at: now + 4.seconds)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |entry| entry["id"] }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, by_id.dig(board_changed_missing.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, by_id.dig(title_changed_missing.id, "particulars"))
+    assert_equal({ "column" => "" }, by_id.dig(triaged_missing.id, "particulars"))
+    assert_equal({}, by_id.dig(closed.id, "particulars"))
+  end
+
+  test "index as JSON filters by creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |entry| entry.dig("creator", "id") == users(:kevin).id }
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id, users(:david).id ] }
+    assert_response :success
+
+    expected_ids = users(:kevin).accessible_events.for_activity.where(creator_id: [ users(:kevin).id, users(:david).id ]).reverse_chronologically.pluck(:id)
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { creator_ids: users(:kevin).id }
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |entry| entry.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index as JSON filters by board_ids" do
+    private_event = with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(title: "Private task", creator: users(:kevin), status: :published)
+      private_card.events.find_by!(action: "card_published")
+    end
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+    assert @response.parsed_body.all? { |entry| entry.dig("board", "id") == boards(:private).id }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ] }
+    assert_response :success
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |entry| entry.dig("board", "id") == boards(:writebook).id }
+
+    get activities_path(format: :json), params: { board_ids: boards(:private).id }
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "index as JSON combines creator_ids and board_ids filters" do
+    private_event = with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(title: "Private task", creator: users(:kevin), status: :published)
+      private_card.events.find_by!(action: "card_published")
+    end
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:david).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "index as JSON only returns activity from accessible boards and current account" do
+    private_event = with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(title: "Top secret", creator: users(:kevin), status: :published)
+      private_card.events.find_by!(action: "card_published")
+    end
+
+    other_account_event = Event.create!(
+      account: accounts(:initech),
+      board: boards(:miltons_wish_list),
+      creator: users(:mike),
+      eventable: cards(:radio),
+      action: "card_published"
+    )
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    returned_ids = @response.parsed_body.pluck("id")
+    assert_not_includes returned_ids, private_event.id
+    assert_not_includes returned_ids, other_account_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:miltons_wish_list).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |entry| entry.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index as JSON paginates newest first with Link headers" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+    base_time = 1.minute.from_now
+
+    20.times do |index|
+      Event.create!(
+        board: board,
+        creator: creator,
+        eventable: card,
+        action: "card_reopened",
+        created_at: base_time + index.seconds
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events.for_activity.reverse_chronologically.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "index as JSON preserves filter parameters across paginated requests" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+    base_time = 1.minute.from_now
+
+    20.times do |index|
+      Event.create!(
+        board: board,
+        creator: creator,
+        eventable: card,
+        action: "card_reopened",
+        created_at: base_time + index.seconds
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events.for_activity.where(creator_id: creator.id).reverse_chronologically.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ creator.id ])
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "index authenticates with bearer access token" do
+    sign_out
+
+    get activities_path(format: :json), headers: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:jasons_api_token).token}" }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+
+    get activities_path(format: :json), headers: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_equal users(:david).accessible_events.for_activity.reverse_chronologically.pluck(:id), @response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), headers: { "HTTP_AUTHORIZATION" => "Bearer invalid-token" }
+    assert_response :unauthorized
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
