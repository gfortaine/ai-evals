--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,39 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      {
+        old_board: detail_particular("old_board").to_s,
+        new_board: detail_particular("new_board").to_s
+      }
+    when "card_title_changed"
+      {
+        old_title: detail_particular("old_title").to_s,
+        new_title: detail_particular("new_title").to_s
+      }
+    when "card_triaged"
+      { column: detail_particular("column").to_s }
+    else
+      {}
+    end
+  end
+
+  private
+    def detail_particular(key)
+      detail_particulars[key]
+    end
+
+    def detail_particulars
+      if particulars.is_a?(Hash)
+        nested = particulars["particulars"]
+        nested.is_a?(Hash) ? nested : particulars
+      else
+        {}
+      end
+    end
 end
