diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
new file mode 100644
index 0000000..4c3c4b8
--- /dev/null
+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "api_particulars for assignment changes returns assignee_ids" do
+    event = events(:logo_assignment_jz)
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.api_particulars)
+
+    unassigned = Event.new(action: "card_unassigned", particulars: { "assignee_ids" => [ users(:kevin).id ] })
+    assert_equal({ assignee_ids: [ users(:kevin).id ] }, unassigned.api_particulars)
+
+    missing = Event.new(action: "card_assigned", particulars: {})
+    assert_equal({ assignee_ids: [] }, missing.api_particulars)
+  end
+
+  test "api_particulars for board changes returns old_board and new_board" do
+    event = Event.new(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } }
+    )
+    assert_equal({ old_board: "Writebook", new_board: "Private board" }, event.api_particulars)
+
+    missing = Event.new(action: "card_board_changed", particulars: {})
+    assert_equal({ old_board: "", new_board: "" }, missing.api_particulars)
+
+    nil_particulars = Event.new(action: "card_board_changed", particulars: nil)
+    assert_equal({ old_board: "", new_board: "" }, nil_particulars.api_particulars)
+  end
+
+  test "api_particulars for title changes returns old_title and new_title" do
+    event = Event.new(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } }
+    )
+    assert_equal({ old_title: "Old", new_title: "New" }, event.api_particulars)
+
+    missing = Event.new(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old" } })
+    assert_equal({ old_title: "Old", new_title: "" }, missing.api_particulars)
+  end
+
+  test "api_particulars for triage events returns column" do
+    event = Event.new(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+    assert_equal({ column: "In Progress" }, event.api_particulars)
+
+    missing = Event.new(action: "card_triaged", particulars: {})
+    assert_equal({ column: "" }, missing.api_particulars)
+  end
+
+  test "api_particulars for other events returns an empty hash" do
+    %w[
+      card_published
+      card_closed
+      card_reopened
+      card_postponed
+      card_auto_postponed
+      card_sent_back_to_triage
+      comment_created
+    ].each do |action|
+      event = Event.new(action: action, particulars: { "particulars" => { "extra" => "ignored" } })
+      assert_equal({}, event.api_particulars, "Expected empty particulars for #{action}")
+    end
+  end
+end
