diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..86c7d7e
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,31 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+let cachedRaw
+let cachedTranslations = {}
+
+export function getI18n() {
+  const raw = getMetaContent("i18n")
+  if (raw !== cachedRaw) {
+    cachedRaw = raw
+    try {
+      cachedTranslations = raw ? JSON.parse(raw) : {}
+    } catch {
+      cachedTranslations = {}
+    }
+  }
+  return cachedTranslations
+}
+
+export function t(path, interpolations = {}) {
+  let value = path.split(".").reduce((obj, key) => obj?.[key], getI18n())
+  if (typeof value !== "string") return path
+
+  for (const [ key, replacement ] of Object.entries(interpolations)) {
+    value = value.replaceAll(`%{${key}}`, replacement)
+  }
+  return value
+}
+
+export function intlLocale() {
+  return getI18n().intl_locale || document.documentElement.lang || "en-US"
+}
