+    def with_locale_for(recipient, override: nil, &block)
+      I18n.with_locale(resolve_locale_for(recipient, override: override), &block)
+    end
+
+    def resolve_locale_for(recipient, override: nil)
+      identity = recipient.is_a?(Identity) ? recipient : recipient&.identity
+      candidate = override.presence || identity&.locale.presence
+
+      if candidate.present? && I18n.available_locales.map(&:to_s).include?(candidate.to_s)
+        candidate.to_sym
+      else
+        I18n.locale
+      end
+    end
