+require "test_helper"
+
+class JapaneseMailersTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @identity = @user.identity
+    @identity.update!(locale: "ja")
+    @user.notifications.delete_all
+  end
+
+  test "AccountMailer.cancellation renders in Japanese for Japanese recipient even when caller locale is English" do
+    @account.cancel(initiated_by: @user)
+    email = I18n.with_locale(:en) { AccountMailer.cancellation(@account.cancellation) }
+
+    assert_equal "Fizzyアカウントがキャンセルされました", email.subject
+    html = email.html_part.body.decoded
+    text = email.text_part.body.decoded
+
+    assert_includes html, 'lang="ja"'
+    assert_includes html, "キャンセルされました"
+    assert_includes html, "今後の流れ"
+    assert_match(/約?\d+(日|か月)後/, html)
+    assert_not_includes html, "What happens now?"
+    assert_not_includes html, "30 days"
+
+    assert_includes text, "キャンセルされました"
+    assert_includes text, "今後の流れ"
+    assert_not_includes text, "WHAT HAPPENS NOW?"
+  end
+
+  test "ExportMailer.completed renders in Japanese for Japanese recipient" do
+    export = Account::Export.create!(account: @account, user: @user)
+    email = I18n.with_locale(:en) { ExportMailer.completed(export) }
+
+    assert_equal "Fizzyデータのエクスポートがダウンロード可能になりました", email.subject
+    assert_includes email.html_part.body.decoded, "データをダウンロード"
+    assert_not_includes email.html_part.body.decoded, "Download your Fizzy data"
+    assert_includes email.text_part.body.decoded, "データをダウンロード"
+  end
+
+  test "ImportMailer.completed and failed render in Japanese for Japanese recipient" do
+    completed = I18n.with_locale(:en) { ImportMailer.completed(@identity, @account) }
+    assert_equal "Fizzyアカウントのインポートが完了しました", completed.subject
+    assert_includes completed.html_part.body.decoded, "アカウントへ移動"
+    assert_includes completed.text_part.body.decoded, "インポートが完了しました"
+
+    import = Account::Import.create!(account: @account, identity: @identity, status: :failed, failure_reason: :conflict)
+    failed = I18n.with_locale(:en) { ImportMailer.failed(import) }
+    assert_equal "Fizzyアカウントのインポートに失敗しました", failed.subject
+    assert_includes failed.html_part.body.decoded, "すでに存在するようです"
+    assert_includes failed.text_part.body.decoded, "すでに存在するようです"
+    assert_not_includes failed.html_part.body.decoded, "Unfortunately"
+  end
+
+  test "MagicLinkMailer.sign_in_instructions renders in Japanese for sign_in and sign_up" do
+    sign_in_link = @identity.magic_links.create!(purpose: :sign_in)
+    email = I18n.with_locale(:en) { MagicLinkMailer.sign_in_instructions(sign_in_link) }
+
+    assert_equal "Fizzyの確認コード: #{sign_in_link.code}", email.subject
+    assert_includes email.html_part.body.decoded, "Fizzy 確認コード"
+    assert_includes email.html_part.body.decoded, "15分間有効です"
+    assert_not_includes email.html_part.body.decoded, "15 minutes"
+    assert_includes email.text_part.body.decoded, "15分間有効です"
+
+    sign_up_link = @identity.magic_links.create!(purpose: :sign_up)
+    sign_up_email = I18n.with_locale(:en) { MagicLinkMailer.sign_in_instructions(sign_up_link) }
+    assert_includes sign_up_email.html_part.body.decoded, "Fizzyへようこそ！"
+    assert_includes sign_up_email.text_part.body.decoded, "アカウント作成を完了するには"
+  end
+
+  test "Notification::BundleMailer.notification renders Japanese dates, counts, notifications, and footer" do
+    bundle = Notification::Bundle.create!(
+      user: @user,
+      starts_at: Time.zone.local(2025, 11, 22, 14, 0, 0),
+      ends_at: Time.zone.local(2025, 11, 22, 18, 0, 0)
+    )
+    Notification.create!(user: @user, creator: users(:jz), source: events(:logo_published), created_at: bundle.starts_at + 10.minutes, updated_at: bundle.starts_at + 10.minutes)
+
+    email = I18n.with_locale(:en) { Notification::BundleMailer.notification(bundle) }
+
+    assert_match(/Fizzy.*: 新しい通知/, email.subject)
+    html = email.html_part.body.decoded
+    text = email.text_part.body.decoded
+
+    assert_includes html, "11月22日(土) 14:00以降の通知"
+    assert_includes html, "1件の新しい通知"
+    assert_includes html, "さんが追加しました"
+    assert_includes html, "配信頻度を変更する"
+    assert_not_includes html, "Notifications since"
+    assert_not_includes html, "new notification"
+    assert_not_includes html, "November"
+
+    assert_includes text, "11月22日(土) 14:00以降の通知"
+    assert_includes text, "1件の新しい通知"
+    assert_not_includes text, "Notifications since"
+  end
+
+  test "UserMailer.email_change_confirmation renders in Japanese for Japanese recipient" do
+    email = I18n.with_locale(:en) do
+      UserMailer.email_change_confirmation(email_address: "new@example.com", token: "tok", user: @user)
+    end
+
+    assert_equal "新しいメールアドレスの確認", email.subject
+    assert_includes email.body.decoded, "メールアドレス変更の確認"
+    assert_includes email.body.decoded, "はい、このメールアドレスを使用します"
+    assert_not_includes email.body.decoded, "Confirm your email address change"
+  end
+
+  test "push notification payload renders in Japanese for Japanese recipient" do
+    notification = Notification.create!(user: @user, creator: users(:jz), source: events(:logo_published))
+    payload = I18n.with_locale(@user.preferred_locale) { notification.payload.to_h }
+    assert_includes payload[:body], "さんが追加しました"
+    assert_not_includes payload[:body], "Added by"
+  end
+end
diff --git a/test/system/japanese_i18n_test.rb b/test/system/japanese_i18n_test.rb
new file mode 100644
index 0000000..26f58c0
--- /dev/null
+++ b/test/system/japanese_i18n_test.rb
@@ -0,0 +1,66 @@
+require "application_system_test_case"
+
+class JapaneseI18nTest < ApplicationSystemTestCase
+  test "switching to Japanese localizes client-side dates, navigation, filters, and persists in a clean browser" do
+    sign_in_as users(:david)
+
+    # Switch to Japanese via ?locale=ja
+    visit card_path(cards(:logo), locale: "ja")
+    assert_selector "html[lang='ja']"
+    assert_text "完了にする"
+    assert_text "Writebookに戻る"
+    assert_no_text "Back to"
+
+    # local_time_controller.js formatted <time> elements in Japanese
+    card_meta_text = find(".card__meta").text
+    assert_match(/(今日|昨日|\d+日前)/, card_meta_text)
+    assert_no_match(/\b(today|yesterday|days ago|Added|Updated|Assigned to|Not assigned)\b/i, card_meta_text)
+
+    # Auto-close notice uses InDaysFormatter in Japanese
+    assert_text "「あとで」に移動します。"
+    assert_no_text "Moves to"
+
+    # Navigating from Home to a card via Turbo Drive triggers turbo_navigation_controller.js ("ホームに戻る")
+    visit root_path
+    assert_selector "html[lang='ja']"
+    assert_text "カードを追加"
+    assert_no_text "Add a card"
+
+    first(".event").click
+    assert_selector "html[lang='ja']"
+    assert_text "ホームに戻る"
+    assert_no_text "Back to"
+
+    # Multi-selection combobox renders Japanese labels on cards index
+    visit cards_path(expand_all: true)
+    assert_text "担当者…"
+    assert_text "タグ…"
+    assert_no_text "Assigned to…"
+    assert_no_text "Tagged…"
+
+    # Invalid locale does not break page or switch away from Japanese
+    visit card_path(cards(:logo), locale: "xx")
+    assert_selector "html[lang='ja']"
+    assert_text "完了にする"
+
+    # Clean browser (new session with cleared cookies & storage) still gets Japanese on sign-in
+    Capybara.reset_sessions!
+    sign_in_as users(:david)
+    assert_selector "html[lang='ja']"
+    assert_text "カードを追加"
+    assert_no_text "Add a card"
+  end
+
+  test "people who never chose a locale continue seeing exact English including JS dates" do
+    sign_in_as users(:jz)
+
+    visit card_path(cards(:logo))
+    assert_selector "html[lang='en']"
+    assert_text "Mark as Done"
+    assert_text "Back to"
+
+    card_meta_text = find(".card__meta").text
+    assert_match(/(today|yesterday|\d+ days ago)/i, card_meta_text)
+    assert_no_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, card_meta_text)
+  end
+end
