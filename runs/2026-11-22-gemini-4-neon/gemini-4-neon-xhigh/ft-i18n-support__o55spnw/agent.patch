+++ b/test/integration/i18n_locale_switching_test.rb
@@ -0,0 +1,241 @@
+require "test_helper"
+
+class I18nLocaleSwitchingTest < ActionDispatch::IntegrationTest
+  test "default users see exact English and identity locale remains nil" do
+    sign_in_as :david
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_includes response.body, "Skip to main content"
+    assert_includes response.body, "Add a card"
+    assert_nil identities(:david).reload.locale
+  end
+
+  test "opening a page with ?locale=ja switches to Japanese and sticks for session and clean browser sign-in" do
+    sign_in_as :david
+
+    # Switch to Japanese via query param
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "メインコンテンツへスキップ"
+    assert_includes response.body, "カードを追加"
+    assert_equal "ja", identities(:david).reload.locale
+
+    # Subsequent request without ?locale param stays in Japanese
+    get account_settings_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "アカウント設定"
+
+    # Simulate clean browser: reset session and cookies completely
+    reset!
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+
+    # Request magic link from clean browser (unauthenticated) -> magic link email should be in Japanese!
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      post session_path(script_name: nil), params: { email_address: identities(:david).email_address }
+    end
+    assert_redirected_to session_magic_link_url(script_name: nil)
+
+    magic_link_email = ActionMailer::Base.deliveries.last
+    assert_match(/Fizzyの確認コード/, magic_link_email.subject)
+    assert_match(/確認コードを入力してください/, magic_link_email.html_part.body.decoded)
+
+    # Complete sign-in in clean browser without any ?locale param
+    magic_link = identities(:david).magic_links.last
+    post session_magic_link_path(script_name: nil), params: { code: magic_link.code }
+    assert_response :redirect
+
+    # Clean browser is immediately in Japanese!
+    get root_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "メインコンテンツへスキップ"
+    assert_includes response.body, "カードを追加"
+  end
+
+  test "unsupported or malformed locale never breaks a page and does not switch locale" do
+    sign_in_as :david
+
+    # Default English user tries ?locale=xx
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_includes response.body, "Skip to main content"
+    assert_nil identities(:david).reload.locale
+
+    # Malformed array/hash locale params
+    get "#{root_path}?locale[]=ja"
+    assert_response :success
+    assert_select "html[lang='en']"
+
+    get "#{root_path}?locale[foo]=ja"
+    assert_response :success
+    assert_select "html[lang='en']"
+
+    # Japanese user tries ?locale=xx -> stays Japanese
+    get root_path(locale: "ja")
+    assert_select "html[lang='ja']"
+
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "switching back to English with ?locale=en persists across session and clean browser" do
+    identities(:david).update!(locale: "ja")
+    sign_in_as :david
+
+    get root_path
+    assert_select "html[lang='ja']"
+
+    get root_path(locale: "en")
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_equal "en", identities(:david).reload.locale
+
+    # Clean browser stays in English
+    reset!
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+    sign_in_as :david
+    get root_path
+    assert_select "html[lang='en']"
+  end
+
+  test "unauthenticated ?locale=ja persists through redirect and sign-in" do
+    # Hitting protected page unauthenticated with ?locale=ja redirects to /session/new in Japanese
+    get boards_path(locale: "ja")
+    assert_redirected_to new_session_path(script_name: nil)
+    follow_redirect!
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "Fizzyへサインイン"
+
+    # Signing in persists Japanese to identity
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      post session_path(script_name: nil), params: { email_address: identities(:jz).email_address }
+    end
+    magic_link_email = ActionMailer::Base.deliveries.last
+    assert_match(/Fizzyの確認コード/, magic_link_email.subject)
+
+    follow_redirect!
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "メールを確認してください"
+
+    magic_link = identities(:jz).magic_links.last
+    post session_magic_link_path(script_name: nil), params: { code: magic_link.code }
+    assert_equal "ja", identities(:jz).reload.locale
+  end
+
+  test "root redirect without account slug preserves ?locale=ja and persists to identity" do
+    sign_in_as :david
+
+    get "/?locale=ja"
+    assert_redirected_to session_menu_path(script_name: nil)
+    follow_redirect!
+    follow_redirect! if response.redirect?
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "signing out clears session locale so another user does not inherit it" do
+    sign_in_as :david
+    get root_path(locale: "ja")
+    assert_select "html[lang='ja']"
+
+    delete session_path(script_name: nil)
+    assert_response :redirect
+
+    # Different user (jz, whose locale is nil) signs in on same browser -> gets English
+    sign_in_as :jz
+    get root_path
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_nil identities(:jz).reload.locale
+  end
+
+  test "public board supports ?locale=ja and sticks across public card navigation" do
+    board = boards(:writebook)
+    board.publish
+
+    get "#{published_board_path(board)}?locale=ja"
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "検討中？"
+
+    card = board.cards.published.first
+    get published_card_path(card)
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "に戻る"
+  end
+
+  test "fragment caching and ETags do not leak English to Japanese users or vice versa" do
+    sign_in_as :david
+
+    original_perform_caching = ActionController::Base.perform_caching
+    original_cache_store = ActionController::Base.cache_store
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = ActiveSupport::Cache::MemoryStore.new
+    begin
+      card = cards(:logo)
+
+      # Render in English to populate fragment cache and capture ETag
+      get card_path(card)
+      assert_response :success
+      en_etag = response.headers["ETag"]
+      assert_includes response.body, "Mark as Done"
+
+      # Switch to Japanese: fragment cache & ETag must differ and render Japanese
+      get card_path(card, locale: "ja"), headers: { "If-None-Match" => en_etag }
+      assert_response :success
+      ja_etag = response.headers["ETag"]
+      assert_not_equal en_etag, ja_etag
+      assert_includes response.body, "完了にする"
+      assert_not_includes response.body, "Mark as Done"
+
+      # Switch back to English: no Japanese leaked from fragment cache
+      get card_path(card, locale: "en")
+      assert_response :success
+      assert_includes response.body, "Mark as Done"
+      assert_not_includes response.body, "完了にする"
+
+      # Verify ETag varies by locale on fresh_when endpoint (board_path)
+      board = boards(:writebook)
+      get board_path(board, locale: "en")
+      assert_response :success
+      board_en_etag = response.headers["ETag"]
+      assert_includes response.body, "Maybe?"
+
+      get board_path(board, locale: "ja"), headers: { "If-None-Match" => board_en_etag }
+      assert_response :success
+      board_ja_etag = response.headers["ETag"]
+      assert_not_equal board_en_etag, board_ja_etag
+      assert_includes response.body, "検討中？"
+
+      get board_path(board), headers: { "If-None-Match" => board_ja_etag }
+      assert_response :not_modified
+    ensure
+      ActionController::Base.perform_caching = original_perform_caching
+      ActionController::Base.cache_store = original_cache_store
+    end
+  end
+
+  test "javascript i18n meta tag delivers Japanese strings and ja-JP locale" do
+    sign_in_as :david
+
+    get root_path(locale: "ja")
+    assert_response :success
+    doc = Nokogiri::HTML5(response.body)
+    meta = doc.at_css('meta[name="i18n"]')
+    assert_not_nil meta
+    i18n_data = JSON.parse(meta["content"])
+    assert_equal "ja-JP", i18n_data["intl_locale"]
+    assert_equal "1分未満前", i18n_data.dig("local_time", "less_than_a_minute_ago")
+    assert_equal "%{label}に戻る", i18n_data["back_to"]
+  end
+end
