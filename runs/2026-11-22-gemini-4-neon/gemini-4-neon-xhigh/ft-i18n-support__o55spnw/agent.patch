diff --git a/test/i18n_completeness_test.rb b/test/i18n_completeness_test.rb
new file mode 100644
index 0000000..526fe69
--- /dev/null
+++ b/test/i18n_completeness_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class I18nCompletenessTest < ActiveSupport::TestCase
+  LOCALE_PAIRS = [
+    [ "config/locales/en.yml", "config/locales/ja.yml" ],
+    [ "config/locales/mailers.en.yml", "config/locales/mailers.ja.yml" ],
+    [ "config/locales/views_core.en.yml", "config/locales/views_core.ja.yml" ],
+    [ "config/locales/views_boards.en.yml", "config/locales/views_boards.ja.yml" ],
+    [ "config/locales/views_cards.en.yml", "config/locales/views_cards.ja.yml" ],
+    [ "config/locales/views_activity.en.yml", "config/locales/views_activity.ja.yml" ]
+  ].freeze
+
+  STATIC_ERROR_PAGES = %w[
+    public/400.html
+    public/404.html
+    public/406-unsupported-browser.html
+    public/422.html
+    public/500.html
+  ].freeze
+
+  test "all en and ja locale files have matching keys" do
+    LOCALE_PAIRS.each do |en_path, ja_path|
+      en_keys = flatten_keys(YAML.safe_load_file(Rails.root.join(en_path))["en"]).to_set
+      ja_keys = flatten_keys(YAML.safe_load_file(Rails.root.join(ja_path))["ja"])
+        .reject { |k| k.match?(/\A(activerecord|activemodel)\.(models|attributes)\./) }
+        .to_set
+
+      assert_empty (en_keys - ja_keys).to_a, "Missing keys in #{ja_path}"
+      assert_empty (ja_keys - en_keys).to_a, "Extra keys in #{ja_path}"
+    end
+  end
+
+  test "all static error pages render in both English and Japanese" do
+    STATIC_ERROR_PAGES.each do |path|
+      html = File.read(Rails.root.join(path))
+      assert_match(/[A-Za-z]{4,}/, html, "#{path} should contain English text")
+      assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]+/, html, "#{path} should contain Japanese text")
+      assert_includes html, 'lang="ja"', "#{path} should mark Japanese elements with lang=\"ja\""
+      assert_includes html, "Back home", "#{path} should contain English back link"
+      assert_includes html, "ホームに戻る", "#{path} should contain Japanese back link"
+    end
+  end
+
+  test "model strings and validations translate in Japanese and stay unchanged in English" do
+    # Color names
+    assert_equal "Blue", Color::COLORS.first.name
+    I18n.with_locale(:ja) do
+      assert_equal "ブルー", Color::COLORS.first.name
+    end
+
+    # Event::Description
+    desc_en = events(:logo_published).description_for(users(:jz)).to_plain_text
+    assert_includes desc_en, "David added"
+
+    desc_ja = I18n.with_locale(:ja) { events(:logo_published).description_for(users(:jz)).to_plain_text }
+    assert_includes desc_ja, "を追加しました"
+    assert_no_match(/\badded\b/, desc_ja)
+
+    # Filter::Summarized & TimeWindowParser
+    assert_equal "Today", TimeWindowParser.human_name_for("today")
+    I18n.with_locale(:ja) do
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+      assert_equal "完了", Filter.indexed_by_human_name("closed")
+      assert_includes filters(:jz_assignments).summary, "新しい順"
+    end
+
+    # ActiveRecord validation errors in Japanese
+    I18n.with_locale(:ja) do
+      webhook = Webhook.new(board: boards(:writebook), name: "", url: "ftp://example.com")
+      assert_not webhook.valid?
+      assert webhook.errors.full_messages.all? { |m| m.match?(/[\p{Hiragana}\p{Katakana}\p{Han}]/) },
+        "Expected Japanese validation errors, got: #{webhook.errors.full_messages}"
+    end
+
+    # Signup::AccountNameGenerator in Japanese
+    identity = Identity.create!(email_address: "tokyo.user@example.com", locale: "ja")
+    I18n.with_locale(:ja) do
+      generator = Signup::AccountNameGenerator.new(identity: identity, name: "太郎 山田")
+      first_name = generator.generate
+      assert_equal "太郎のFizzy", first_name
+
+      account = Account.create!(external_account_id: 9999901, name: first_name)
+      Current.without_account do
+        identity.users.create!(account: account, name: "太郎 山田")
+        identity.reload
+      end
+      assert_equal "太郎のFizzy 2", generator.generate
+    end
+
+    # Card default title
+    Current.user = users(:david)
+    I18n.with_locale(:ja) do
+      card = boards(:writebook).cards.create!(creator: users(:david), status: "published", title: "")
+      assert_equal "無題", card.title
+    end
+  end
+
+  private
+    def flatten_keys(hash, prefix = nil, out = [])
+      hash.each do |k, v|
+        key = prefix ? "#{prefix}.#{k}" : k.to_s
+        if v.is_a?(Hash)
+          flatten_keys(v, key, out)
+        else
+          out << key
+        end
+      end
+      out
+    end
+end
diff --git a/test/integration/i18n_locale_switching_test.rb b/test/integration/i18n_locale_switching_test.rb
