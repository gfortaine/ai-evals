diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..c68ca51
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,234 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "bell", "details", "notAllowedNotice", "prompt" ]
+  static values = {
+    subscriptionsUrl: String
+  }
+
+  async connect() {
+    if (!this.#isSupported) {
+      this.#showNotSupported()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#showNotAllowed()
+      return
+    }
+
+    if (Notification.permission === "granted") {
+      await this.#syncExistingSubscription()
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (!this.#isSupported) {
+      this.#showNotSupported()
+      return
+    }
+
+    if (this.hasBellTarget) this.bellTarget.disabled = true
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      switch (permission) {
+        case "granted":
+          await this.#subscribe()
+          break
+        case "denied":
+          this.#showNotAllowed()
+          break
+      }
+    } finally {
+      if (this.hasBellTarget) this.bellTarget.disabled = false
+    }
+  }
+
+  async unsubscribe() {
+    try {
+      const registration = await this.#existingServiceWorkerRegistration()
+      const subscription = await registration?.pushManager?.getSubscription()
+
+      if (subscription) {
+        await subscription.unsubscribe()
+      }
+
+      if (this.subscriptionId) {
+        await destroy(`${this.subscriptionsUrlValue}/${this.subscriptionId}`, { responseKind: "json" })
+        this.subscriptionId = null
+      }
+
+      this.#markOff()
+    } catch (error) {
+      console.error("Failed to unsubscribe from push notifications:", error)
+    }
+  }
+
+  async #syncExistingSubscription() {
+    try {
+      const registration = await this.#existingServiceWorkerRegistration()
+      const subscription = await registration?.pushManager?.getSubscription()
+
+      if (!subscription) return
+
+      if (!this.#matchesApplicationServerKey(subscription)) {
+        await subscription.unsubscribe()
+        await this.#subscribe()
+        return
+      }
+
+      if (await this.#postSubscription(subscription)) {
+        this.#markOn()
+      }
+    } catch (error) {
+      console.error("Failed to sync push subscription:", error)
+    }
+  }
+
+  async #subscribe() {
+    const applicationServerKey = this.#applicationServerKey
+    if (!applicationServerKey) return
+
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (subscription && !this.#matchesApplicationServerKey(subscription)) {
+        await subscription.unsubscribe()
+        subscription = null
+      }
+
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey
+        })
+      }
+
+      if (await this.#postSubscription(subscription)) {
+        this.#markOn()
+      }
+    } catch (error) {
+      if (error.name === "NotAllowedError" || Notification.permission === "denied") {
+        this.#showNotAllowed()
+      } else {
+        console.error("Failed to subscribe to push notifications:", error)
+      }
+    }
+  }
+
+  async #postSubscription(subscription) {
+    const { endpoint, p256dh_key, auth_key } = this.#extractSubscriptionData(subscription)
+    if (!endpoint || !p256dh_key || !auth_key) return false
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key,
+          auth_key
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      if (response.contentType.includes("json")) {
+        const data = await response.json
+        this.subscriptionId = data.id
+      }
+      return true
+    }
+
+    return false
+  }
+
+  #extractSubscriptionData(subscription) {
+    const json = subscription.toJSON ? subscription.toJSON() : {}
+
+    return {
+      endpoint: json.endpoint || subscription.endpoint,
+      p256dh_key: json.keys?.p256dh || this.#encodeKey(subscription.getKey?.("p256dh")),
+      auth_key: json.keys?.auth || this.#encodeKey(subscription.getKey?.("auth"))
+    }
+  }
+
+  #encodeKey(key) {
+    if (!key) return null
+
+    const bytes = new Uint8Array(key)
+    let binary = ""
+    for (const byte of bytes) {
+      binary += String.fromCharCode(byte)
+    }
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  #matchesApplicationServerKey(subscription) {
+    const expectedKey = this.#applicationServerKey
+    const existingKey = subscription.options?.applicationServerKey
+    if (!expectedKey || !existingKey) return true
+
+    const existingBytes = new Uint8Array(existingKey)
+    if (existingBytes.length !== expectedKey.length) return false
+
+    return existingBytes.every((byte, index) => byte === expectedKey[index])
+  }
+
+  async #serviceWorkerRegistration() {
+    if (!await this.#existingServiceWorkerRegistration()) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+    return await navigator.serviceWorker.ready
+  }
+
+  async #existingServiceWorkerRegistration() {
+    return await navigator.serviceWorker.getRegistration("/") || await navigator.serviceWorker.getRegistration()
+  }
+
+  #markOn() {
+    this.element.classList.add(this.onClass)
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = true
+  }
+
+  #markOff() {
+    this.element.classList.remove(this.onClass)
+  }
+
+  #showNotAllowed() {
+    this.#markOff()
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = false
+    this.detailsTargets.forEach(detail => detail.hidden = false)
+  }
+
+  #showNotSupported() {
+    this.#markOff()
+    if (this.hasPromptTarget) this.promptTarget.hidden = true
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = false
+    this.detailsTargets.forEach(detail => detail.hidden = true)
+  }
+
+  get #isSupported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const vapidPublicKey = getMetaContent("vapid-public-key")
+    if (!vapidPublicKey) return null
+
+    return this.#urlBase64ToUint8Array(vapidPublicKey)
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const clean = base64String.replace(/=+$/, "")
+    const padding = "=".repeat((4 - clean.length % 4) % 4)
+    const base64 = (clean + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    return Uint8Array.from(rawData, (char) => char.charCodeAt(0))
+  }
+}
