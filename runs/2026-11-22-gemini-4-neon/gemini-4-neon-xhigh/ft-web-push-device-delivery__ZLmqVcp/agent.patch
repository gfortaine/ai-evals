@@ -0,0 +1,148 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @valid_params = {
+      push_subscription: {
+        endpoint: "https://fcm.googleapis.com/fcm/send/device-123",
+        p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+        auth_key: "tBHItJI5svbpez7KI4CCXg"
+      }
+    }
+  end
+
+  test "create registers a new push subscription for current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: @valid_params,
+        headers: { "User-Agent" => "Mozilla/5.0 TestBrowser" }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal @valid_params[:push_subscription][:endpoint], subscription.endpoint
+    assert_equal @valid_params[:push_subscription][:p256dh_key], subscription.p256dh_key
+    assert_equal @valid_params[:push_subscription][:auth_key], subscription.auth_key
+    assert_equal "Mozilla/5.0 TestBrowser", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create as JSON returns subscription id" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @valid_params, as: :json
+    end
+
+    assert_response :created
+    assert_equal @user.push_subscriptions.last.id, @response.parsed_body["id"]
+  end
+
+  test "create updates existing subscription for same endpoint without duplicating" do
+    existing = @user.push_subscriptions.create!(
+      endpoint: @valid_params[:push_subscription][:endpoint],
+      p256dh_key: "old_p256dh_key",
+      auth_key: "old_auth_key",
+      updated_at: 2.days.ago
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: @valid_params, as: :json
+    end
+
+    assert_response :ok
+    assert_equal existing.id, @response.parsed_body["id"]
+    existing.reload
+    assert_equal @valid_params[:push_subscription][:p256dh_key], existing.p256dh_key
+    assert_equal @valid_params[:push_subscription][:auth_key], existing.auth_key
+    assert existing.updated_at > 1.minute.ago
+  end
+
+  test "same endpoint can be registered by two different users independently" do
+    users(:kevin).push_subscriptions.create!(@valid_params[:push_subscription])
+
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @valid_params
+    end
+
+    assert_response :created
+  end
+
+  test "create rejects invalid endpoint or missing keys" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "http://insecure.example.com/push",
+          p256dh_key: "key",
+          auth_key: "auth"
+        }
+      }
+    end
+
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/abc",
+          p256dh_key: "",
+          auth_key: ""
+        }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+    assert @response.parsed_body["errors"].present?
+  end
+
+  test "create forbids registering subscription for another user in the same account" do
+    other_user = users(:kevin)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_user), params: @valid_params
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create returns not found for user in another account" do
+    other_account_user = users(:mike)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_account_user), params: @valid_params
+    end
+
+    assert_response :not_found
+  end
+
+  test "create requires authentication" do
+    sign_out
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: @valid_params
+    end
+
+    assert_response :redirect
+  end
+
+  test "destroy deletes current user's push subscription" do
+    subscription = @user.push_subscriptions.create!(@valid_params[:push_subscription])
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy forbids deleting another user's push subscription" do
+    other_user = users(:kevin)
+    subscription = other_user.push_subscriptions.create!(@valid_params[:push_subscription])
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(other_user, subscription)
+    end
+
+    assert_response :forbidden
+  end
+end
