@@ -0,0 +1,235 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "blocked notifications show browser help copy" do
+    with_vapid_keys do
+      visit notifications_settings_path
+
+      assert_text "Push Notifications"
+      assert_button "Turn on notifications"
+      assert_no_text "Turn on notifications for this website."
+
+      # Headless Chrome denies permission prompts automatically (--deny-permission-prompts)
+      click_button "Turn on notifications"
+
+      assert_text "Turn on notifications for this website."
+    end
+  end
+
+  test "turning on and off push notifications subscribes and posts to /users/:user_id/push_subscriptions" do
+    keys = generate_push_client_keys
+    endpoint = "https://fcm.googleapis.com/fcm/send/browser-device-1"
+
+    with_vapid_keys do
+      visit notifications_settings_path
+
+      # Stub browser Notification and PushManager APIs to simulate user granting permission
+      page.execute_script(<<~JS, endpoint, keys[:p256dh_key], keys[:auth_key])
+        const [endpoint, p256dh, auth] = arguments
+        window.__pushTestState = { subscribed: null, subscribeOptions: null, unsubscribed: false }
+
+        window.Notification = {
+          permission: "default",
+          requestPermission: async () => {
+            window.Notification.permission = "granted"
+            return "granted"
+          }
+        }
+        window.PushManager = window.PushManager || function() {}
+
+        const fakeSubscription = {
+          endpoint,
+          options: {},
+          toJSON() {
+            return { endpoint, keys: { p256dh, auth } }
+          },
+          async unsubscribe() {
+            window.__pushTestState.unsubscribed = true
+            window.__pushTestState.subscribed = null
+            return true
+          }
+        }
+
+        const fakeRegistration = {
+          pushManager: {
+            async getSubscription() {
+              return window.__pushTestState.subscribed
+            },
+            async subscribe(options) {
+              window.__pushTestState.subscribeOptions = {
+                userVisibleOnly: options.userVisibleOnly,
+                keyLength: options.applicationServerKey?.byteLength
+              }
+              fakeSubscription.options.applicationServerKey = options.applicationServerKey
+              window.__pushTestState.subscribed = fakeSubscription
+              return fakeSubscription
+            }
+          }
+        }
+
+        Object.defineProperty(navigator, "serviceWorker", {
+          configurable: true,
+          value: {
+            getRegistration: async () => fakeRegistration,
+            register: async () => fakeRegistration,
+            ready: Promise.resolve(fakeRegistration)
+          }
+        })
+      JS
+
+      click_button "Turn on notifications"
+
+      assert_text "Notifications are on for this device."
+      assert_no_button "Turn on notifications"
+
+      subscribe_options = page.evaluate_script("window.__pushTestState.subscribeOptions")
+      assert_equal true, subscribe_options["userVisibleOnly"]
+      assert_equal 65, subscribe_options["keyLength"]
+
+      subscription = @user.push_subscriptions.reload.find_by(endpoint: endpoint)
+      assert_not_nil subscription
+      assert_equal keys[:p256dh_key], subscription.p256dh_key
+      assert_equal keys[:auth_key], subscription.auth_key
+
+      click_button "Turn off notifications"
+
+      assert_button "Turn on notifications"
+      assert_no_text "Notifications are on for this device."
+      assert page.evaluate_script("window.__pushTestState.unsubscribed")
+      assert_not Push::Subscription.exists?(subscription.id)
+    end
+  end
+
+  test "service worker push and notificationclick handlers display notification and open the card" do
+    card_path = "/#{accounts("37s").external_account_id}/cards/#{cards(:layout).number}#comment_abc"
+
+    result = page.evaluate_async_script(<<~JS, card_path)
+      const [cardPath, done] = arguments
+
+      fetch("/service-worker.js")
+        .then(r => r.text())
+        .then((swSource) => {
+          const harness = `
+            const listeners = {};
+            const shown = [];
+            const badges = [];
+            const opened = [];
+            const navigated = [];
+            let focused = false;
+            let closed = false;
+            let mockClients = [];
+
+            const origin = ${JSON.stringify(window.location.origin)};
+            const cardPath = ${JSON.stringify(cardPath)};
+
+            const fakeSelf = {
+              location: { origin },
+              navigator: {
+                setAppBadge: async (n) => badges.push(n),
+                clearAppBadge: async () => badges.push(0)
+              },
+              registration: {
+                showNotification: async (title, options) => shown.push({ title, options })
+              },
+              clients: {
+                claim: async () => {},
+                matchAll: async () => mockClients,
+                openWindow: async (url) => opened.push(url)
+              },
+              addEventListener: (type, fn) => {
+                listeners[type] = listeners[type] || [];
+                listeners[type].push(fn);
+              }
+            };
+
+            const TurboOffline = {
+              addRule: () => {},
+              handlers: { networkFirst: () => {}, cacheFirst: () => {} },
+              start: () => {}
+            };
+
+            const importScripts = () => {};
+
+            (function(self) {
+              ${swSource}
+            })(fakeSelf);
+
+            (async () => {
+              const pushPromises = [];
+              for (const fn of listeners.push || []) {
+                fn({
+                  data: {
+                    json: () => ({
+                      title: "RE: Layout is broken",
+                      body: "Fixed the header!",
+                      path: cardPath,
+                      icon: "/app-icon-192.png",
+                      badge: 3
+                    })
+                  },
+                  waitUntil: (p) => pushPromises.push(p)
+                });
+              }
+              await Promise.all(pushPromises);
+
+              // Case 1: no existing window -> opens new window
+              const clickPromises1 = [];
+              for (const fn of listeners.notificationclick || []) {
+                fn({
+                  notification: {
+                    data: shown[0]?.options?.data,
+                    close: () => { closed = true; }
+                  },
+                  waitUntil: (p) => clickPromises1.push(p)
+                });
+              }
+              await Promise.all(clickPromises1);
+
+              // Case 2: existing Fizzy window -> focuses and navigates it to card
+              mockClients = [{
+                url: origin + "/",
+                focus: async () => { focused = true; },
+                navigate: async (url) => { navigated.push(url); }
+              }];
+              const clickPromises2 = [];
+              for (const fn of listeners.notificationclick || []) {
+                fn({
+                  notification: {
+                    data: shown[0]?.options?.data,
+                    close: () => {}
+                  },
+                  waitUntil: (p) => clickPromises2.push(p)
+                });
+              }
+              await Promise.all(clickPromises2);
+
+              postMessage({ shown, badges, opened, navigated, focused, closed, origin });
+            })().catch(err => postMessage({ error: err.message }));
+          `
+
+          const blob = new Blob([harness], { type: "application/javascript" })
+          const worker = new Worker(URL.createObjectURL(blob))
+          worker.onmessage = (e) => { worker.terminate(); done(e.data) }
+          worker.onerror = (e) => { worker.terminate(); done({ error: e.message }) }
+        })
+        .catch((err) => done({ error: err.message }))
+    JS
+
+    assert_nil result["error"], "Service worker evaluation error: #{result["error"]}"
+    assert_equal 1, result["shown"].length
+    assert_equal "RE: Layout is broken", result["shown"].first["title"]
+    assert_equal "Fixed the header!", result["shown"].dig(0, "options", "body")
+    assert_equal "/app-icon-192.png", result["shown"].dig(0, "options", "icon")
+    assert_equal card_path, result["shown"].dig(0, "options", "data", "path")
+    assert_equal [ 3 ], result["badges"]
+    assert_equal true, result["closed"]
+    assert_equal [ "#{result["origin"]}#{card_path}" ], result["opened"]
+    assert_equal true, result["focused"]
+    assert_equal [ "#{result["origin"]}#{card_path}" ], result["navigated"]
+  end
+end
