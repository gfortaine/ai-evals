diff --git a/test/integration/with_raised_exceptions_test.rb b/test/integration/with_raised_exceptions_test.rb
new file mode 100644
index 0000000..b1ade13
--- /dev/null
+++ b/test/integration/with_raised_exceptions_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises exceptions inside the block and renders error pages before and after" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    result = with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+
+      assert_raises ActionController::RoutingError do
+        get "/nonexistent-path"
+      end
+
+      :block_return_value
+    end
+
+    assert_equal :block_return_value, result
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    get "/nonexistent-path"
+    assert_response :not_found
+  end
+
+  test "restores normal error rendering when an exception escapes the block" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "supports nested blocks without restoring early" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_path(books(:manual))
+        end
+      end
+
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+end
