+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :unauthorized
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal avery_id, json_body["ticket"]["requester_id"]
+  end
+
+  test "cannot suspend the last active admin even when suspended admins or active agents exist" do
+    signup_and_verify!
+    owner_login = sign_in!
+    owner_token = owner_login["session"]["token"]
+    owner_id = owner_login["user"]["id"]
+
+    # Add an active agent (not an admin!)
+    sam_data = invite_and_accept!(admin_token: owner_token, email: "sam@example.test", role: "agent", name: "Sam")
+    assert_equal "agent", sam_data[:user]["role"]
+
+    # Sole active admin cannot be suspended
+    patch "/api/v1/users/#{owner_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["suspended"].present?
+
+    # Session still works
+    get "/api/v1/me", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+
+    # Add a second admin Pat -> now there are 2 active admins
+    pat_data = invite_and_accept!(admin_token: owner_token, email: "pat@example.test", role: "admin", name: "Pat")
+    pat_id = pat_data[:user]["id"]
+    pat_token = sign_in!(email: "pat@example.test", password: "my-team-password")["session"]["token"]
+
+    # Owner suspends Pat -> succeeds
+    patch "/api/v1/users/#{pat_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body["user"]["suspended"]
+
+    # Pat's session is revoked
+    get "/api/v1/users", headers: account_headers("acme", token: pat_token)
+    assert_response :unauthorized
+
+    # Now owner is AGAIN the last active admin (Pat is suspended) -> cannot suspend owner!
+    patch "/api/v1/users/#{owner_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["suspended"].present?
+
+    # Unsuspend Pat -> now owner CAN even suspend self because Pat is an active admin
+    patch "/api/v1/users/#{pat_id}",
+      params: { user: { suspended: false } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+
+    patch "/api/v1/users/#{owner_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body["user"]["suspended"]
+
+    # Owner's own session was immediately revoked
+    get "/api/v1/me", headers: account_headers("acme", token: owner_token)
+    assert_response :unauthorized
+
+    # Pat can sign in and is now the last active admin -> Pat cannot be suspended
+    new_pat_token = sign_in!(email: "pat@example.test", password: "my-team-password")["session"]["token"]
+    patch "/api/v1/users/#{pat_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: new_pat_token),
+      as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "enforces validation atomicity, admin-only people management, multi-tenant isolation, and cancellation" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", email: "jo@shared.test")
+    signup_and_verify!(name: "Beta", subdomain: "beta", email: "jo@shared.test")
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    acme_admin_token = sign_in!(subdomain: "acme", email: "jo@shared.test")["session"]["token"]
+    beta_admin_token = sign_in!(subdomain: "beta", email: "jo@shared.test")["session"]["token"]
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    sam_data = invite_and_accept!(subdomain: "acme", admin_token: acme_admin_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_id = sam_data[:user]["id"]
+    sam_token = sign_in!(subdomain: "acme", email: "sam@example.test", password: "my-team-password")["session"]["token"]
+
+    # Invalid suspended type -> 422
+    [ "true", "false", nil, 1, [] ].each do |bad_val|
+      patch "/api/v1/users/#{sam_id}",
+        params: { user: { suspended: bad_val } },
+        headers: account_headers("acme", token: acme_admin_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 for suspended=#{bad_val.inspect}"
