+
+    get "/api/v1/staff", headers: account_headers("acme", token: new_sam_token)
+    assert_response :ok
+    assert_equal [ owner_id, sam_id, pat_id ], json_body["staff"].map { |s| s["id"] }
+
+    # Suspend customer -> revokes customer's sessions, blocks login, keeps customer's ticket intact
+    patch "/api/v1/users/#{avery_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
