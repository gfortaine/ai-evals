+
+    sam_data = invite_and_accept!(admin_token: owner_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_id = sam_data[:user]["id"]
+    pat_data = invite_and_accept!(admin_token: owner_token, email: "pat@example.test", role: "admin", name: "Pat")
+    pat_id = pat_data[:user]["id"]
+    avery_data = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_id = avery_data["user"]["id"]
+
+    sam_token1 = sign_in!(email: "sam@example.test", password: "my-team-password")["session"]["token"]
+    sam_token2 = sign_in!(email: "sam@example.test", password: "my-team-password")["session"]["token"]
+    avery_token = sign_in!(email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    # Customer opens a ticket and staff assigns it to Sam
+    t0 = Time.zone.parse("2026-06-01 10:00:00 UTC")
+    ticket_id = nil
+    travel_to t0 do
+      post "/api/v1/requests",
+        params: { request: { subject: "Billing question", comment: { body: "Need help" } } },
