diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..0586fa1
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,66 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < BaseController
+      before_action :resolve_account!
+      before_action :require_active_account!
+
+      def create
+        acceptance_params = require_object_param(:invitation_acceptance)
+          .permit(:token, :name, :password, :password_confirmation)
+        raw_token = acceptance_params[:token].to_s
+
+        invitation = nil
+        user = nil
+        token_invalid = false
+        validation_failed = false
+
+        current_account.with_lock do
+          invitation = Invitation.find_pending(account: current_account, raw_token: raw_token)
+          if invitation.nil?
+            token_invalid = true
+            next
+          end
+
+          user = current_account.users.build(
+            name: acceptance_params[:name],
+            email: invitation.email,
+            role: invitation.role,
+            password: acceptance_params[:password],
+            email_verified_at: Time.current
+          )
+          if acceptance_params.key?(:password_confirmation)
+            user.password_confirmation = acceptance_params[:password_confirmation]
+          end
+
+          unless user.valid?
+            validation_failed = true
+            next
+          end
+
+          user.save!
+          invitation.update!(accepted_at: Time.current, accepted_user: user)
+        end
+
+        if token_invalid
+          render json: { error: "Invalid or expired invitation token" }, status: :unprocessable_content
+          return
+        end
+
+        if validation_failed
+          render_validation_errors(user)
+          return
+        end
+
+        render json: {
+          user: serialize_user(user),
+          account: serialize_account(current_account)
+        }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        render json: {
+          error: "Email has already been taken",
+          errors: { email: [ "has already been taken" ] }
+        }, status: :unprocessable_content
+      end
+    end
+  end
+end
