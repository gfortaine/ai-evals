+
+    get "/api/v1/requests/#{ticket_id}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    original_request_json = json_body["request"]
+
+    travel_to t0 + 5.minutes do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { assignee_id: sam_id } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :ok
+      assert_equal sam_id, json_body["ticket"]["assignee_id"]
+    end
+
+    # GET /users lists by ID ascending with pagination and suspended field
+    get "/api/v1/users", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ owner_id, sam_id, pat_id, avery_id ], json_body["users"].map { |u| u["id"] }
+    assert_equal [ false, false, false, false ], json_body["users"].map { |u| u["suspended"] }
+    assert_equal 4, json_body["count"]
+
+    get "/api/v1/users?page=2&per_page=2", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ pat_id, avery_id ], json_body["users"].map { |u| u["id"] }
+    assert_equal 1, json_body["previous_page"]
+    assert_nil json_body["next_page"]
+
+    # GET /users/:id inspects user
+    get "/api/v1/users/#{sam_id}", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal "Sam", json_body["user"]["name"]
+    assert_equal "agent", json_body["user"]["role"]
+    assert_equal false, json_body["user"]["suspended"]
+
+    # GET /staff returns active staff (admins + agents) ordered by ID ascending for both admin and agent
+    [ owner_token, sam_token1 ].each do |staff_token|
+      get "/api/v1/staff", headers: account_headers("acme", token: staff_token)
+      assert_response :ok
+      assert_equal [ owner_id, sam_id, pat_id ], json_body["staff"].map { |s| s["id"] }
+      assert_equal %w[Jo Sam Pat], json_body["staff"].map { |s| s["name"] }
+      assert_equal 3, json_body["count"]
+    end
+
+    # Suspend Sam -> revokes all sessions, clears ticket assignments without changing customer request, removes from /staff
+    travel_to t0 + 10.minutes do
+      patch "/api/v1/users/#{sam_id}",
+        params: { user: { suspended: true } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :ok
+      assert_equal true, json_body["user"]["suspended"]
+      assert json_body["user"]["suspended_at"].present?
+    end
+
+    # Both of Sam's existing sessions are immediately revoked (401)
+    get "/api/v1/me", headers: account_headers("acme", token: sam_token1)
+    assert_response :unauthorized
+    get "/api/v1/tickets", headers: account_headers("acme", token: sam_token2)
+    assert_response :unauthorized
+
+    # Sam cannot sign in while suspended (403)
+    post "/api/v1/sessions",
+      params: { session: { email: "sam@example.test", password: "my-team-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Sam's ticket assignment is cleared
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_nil json_body["ticket"]["assignee_id"]
+    assert_nil json_body["ticket"]["assignee"]
+
+    # Customer-facing request was NOT changed by assignment or clearing assignment on suspension
+    get "/api/v1/requests/#{ticket_id}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal original_request_json, json_body["request"]
+
+    # Sam no longer appears in GET /staff
+    get "/api/v1/staff", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ owner_id, pat_id ], json_body["staff"].map { |s| s["id"] }
+
+    # Filter GET /users by role, suspension, and both combined
+    get "/api/v1/users?role=admin", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ owner_id, pat_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?role=agent", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ sam_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?role=customer", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ avery_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?suspended=true", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ sam_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?suspended=false", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ owner_id, pat_id, avery_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?role=agent&suspended=false", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [], json_body["users"]
+
+    get "/api/v1/users?role=agent&suspended=true", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ sam_id ], json_body["users"].map { |u| u["id"] }
+
+    # Invalid filters return 422
+    get "/api/v1/users?role=boss", headers: account_headers("acme", token: owner_token)
+    assert_response :unprocessable_content
+    get "/api/v1/users?suspended=maybe", headers: account_headers("acme", token: owner_token)
+    assert_response :unprocessable_content
+
+    # Unsuspend Sam -> can sign in again and returns to /staff (ticket stays unassigned)
+    patch "/api/v1/users/#{sam_id}",
+      params: { user: { suspended: false } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal false, json_body["user"]["suspended"]
+    assert_nil json_body["user"]["suspended_at"]
+
+    new_sam_token = sign_in!(email: "sam@example.test", password: "my-team-password")["session"]["token"]
