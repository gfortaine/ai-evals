diff --git a/test/integration/api/v1/invitations_test.rb b/test/integration/api/v1/invitations_test.rb
new file mode 100644
index 0000000..c254be6
--- /dev/null
+++ b/test/integration/api/v1/invitations_test.rb
@@ -0,0 +1,438 @@
+require "test_helper"
+
+class Api::V1::InvitationsTest < ActionDispatch::IntegrationTest
+  test "admin invites agent and admin, previews invitation, accepts without verification email, and signs in" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    ActionMailer::Base.deliveries.clear
+
+    # Admin invites Sam as agent
+    with_env("HELPDESK_FRONTEND_URL" => "https://app.acme.test", "HELPDESK_MAIL_FROM" => "team@acme.test") do
+      post "/api/v1/invitations",
+        params: { invitation: { email: "  Sam@Example.Test ", role: "agent" } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :created
+    end
+
+    inv = json_body["invitation"]
+    assert inv["id"].is_a?(Integer)
+    assert_equal "sam@example.test", inv["email"]
+    assert_equal "agent", inv["role"]
+    assert_equal "pending", inv["status"]
+    assert inv["expires_at"].present?
+    assert_nil inv["accepted_at"]
+    assert_nil inv["revoked_at"]
+    assert_not inv.key?("token")
+    assert_not inv.key?("token_digest")
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "team@acme.test" ], mail.from
+    assert_equal [ "sam@example.test" ], mail.to
+    parsed = extract_token_from_mail(mail, path: "/accept-invitation")
+    assert_equal "acme", parsed[:account]
+    assert_includes mail.body.decoded, "https://app.acme.test/accept-invitation?account=acme&token=#{parsed[:token]}"
+    sam_token = parsed[:token]
+
+    # Preview invitation without authentication
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: sam_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    preview = json_body["invitation_preview"]
+    assert_equal "sam@example.test", preview["email"]
+    assert_equal "agent", preview["role"]
+    assert_equal "Acme", preview["account_name"]
+    assert_equal "acme", preview["subdomain"]
+    assert_equal({ "name" => "Acme", "subdomain" => "acme" }, preview["account"])
+    assert_equal inv["expires_at"], preview["expires_at"]
+
+    # Invalid acceptance payload does NOT consume token
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: sam_token, name: "Sam", password: "short" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["password"].present?
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: sam_token, name: "   ", password: "my-team-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["name"].present?
+
+    # Accept invitation (role/email spoofing ignored)
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/invitation_acceptances",
+      params: {
+        invitation_acceptance: {
+          token: sam_token,
+          name: "Sam",
+          password: "my-team-password",
+          role: "admin",
+          email: "spoofed@example.test"
+        }
+      },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    sam = json_body["user"]
+    acc = json_body["account"]
+    assert sam["id"].is_a?(Integer)
