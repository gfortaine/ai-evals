+require "test_helper"
+
+class Api::V1::UsersAndStaffTest < ActionDispatch::IntegrationTest
+  test "admins list, inspect, filter, suspend, and unsuspend users; suspension revokes sessions and clears assignments" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_login = sign_in!(subdomain: "acme", email: "jo@acme.test")
+    owner_token = owner_login["session"]["token"]
+    owner_id = owner_login["user"]["id"]
