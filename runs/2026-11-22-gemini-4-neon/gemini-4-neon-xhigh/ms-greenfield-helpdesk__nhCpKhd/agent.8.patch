+    assert_equal [ agents[1]["id"], agents[2]["id"] ], json_body["staff"].map { |s| s["id"] }
+    assert_equal true, json_body["meta"]["has_more"]
+
+    get json_body["links"]["next"], headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ agents[3]["id"] ], json_body["staff"].map { |s| s["id"] }
+    assert_equal false, json_body["meta"]["has_more"]
+
+    # All 6 bulk-unassigned tickets share the exact same updated_at timestamp:
+    # cursor pagination over assignee_id=unassigned must traverse all 6 cleanly without duplicates or skips!
+    collected = []
+    url = "/api/v1/tickets?page[size]=2&assignee_id=unassigned"
+    while url
+      get url, headers: account_headers("acme", token: owner_token)
+      assert_response :ok
+      collected.concat(json_body["tickets"].map { |t| t["id"] })
+      url = json_body["links"]["next"]
+    end
+    assert_equal assigned_ticket_ids.reverse, collected
+  end
+
+  test "invitations and group_memberships stay stable when boundary records are revoked, accepted, expired, or deleted" do
+    signup_and_verify!
+    owner_token = sign_in!(email: "jo@acme.test")["session"]["token"]
+
+    inv_ids = 5.times.map do |i|
+      create_invitation(token: owner_token, email: "inv#{i + 1}@acme.test", role: "agent")
+      assert_response :created
+      json_body["invitation"]["id"]
+    end
+    i1, i2, i3, i4, i5 = inv_ids
+
+    # Page 1 of pending invitations: [i1, i2]
+    get "/api/v1/invitations?page[size]=2&status=pending", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ i1, i2 ], json_body["invitations"].map { |inv| inv["id"] }
+    inv_next = json_body["links"]["next"]
+
+    # Revoke i2 (the boundary invitation!) and expire i1
+    delete "/api/v1/invitations/#{i2}", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    Invitation.find(i1).update_columns(expires_at: 1.hour.ago)
+
+    # Following inv_next still works cleanly -> [i3, i4], and links.prev is nil because no pending invitations remain before i3!
+    get inv_next, headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ i3, i4 ], json_body["invitations"].map { |inv| inv["id"] }
+    assert_equal true, json_body["meta"]["has_more"]
+    assert_nil json_body["links"]["prev"]
+
+    get json_body["links"]["next"], headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ i5 ], json_body["invitations"].map { |inv| inv["id"] }
+    assert_equal false, json_body["meta"]["has_more"]
+
+    # Group memberships boundary deletion stability
+    owner_id = Account.find_by!(subdomain: "acme").owner_id
+    membership_ids = 4.times.map do |i|
+      post "/api/v1/groups",
+        params: { group: { name: "GM Group #{i + 1}" } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :created
+      gid = json_body["group"]["id"]
+
+      post "/api/v1/group_memberships",
+        params: { group_membership: { group_id: gid, user_id: owner_id } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :created
+      json_body["group_membership"]["id"]
+    end
+    m1, m2, m3, m4 = membership_ids
+
+    get "/api/v1/group_memberships?page[size]=2&user_id=#{owner_id}", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ m1, m2 ], json_body["group_memberships"].map { |m| m["id"] }
+    gm_next = json_body["links"]["next"]
+
+    # Delete m2 (the boundary record!)
+    delete "/api/v1/group_memberships/#{m2}", headers: account_headers("acme", token: owner_token)
+    assert_response :no_content
+
+    get gm_next, headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ m3, m4 ], json_body["group_memberships"].map { |m| m["id"] }
+    assert_equal false, json_body["meta"]["has_more"]
+    assert json_body["links"]["prev"].present?
+  end
+
+  test "edge cases: single item, null-relation invalid cursor, per_page stripping, conflicting page param, and auth guards" do
+    signup_and_verify!
+    owner_token = sign_in!(email: "jo@acme.test")["session"]["token"]
+    register_and_verify_customer!
+    customer_token = sign_in!(email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    # Single group in account
+    post "/api/v1/groups",
+      params: { group: { name: "Solo Group" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
+    solo_id = json_body["group"]["id"]
+
+    get "/api/v1/groups?page[size]=25", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ solo_id ], json_body["groups"].map { |g| g["id"] }
+    assert_equal false, json_body["meta"]["has_more"]
+    assert json_body["meta"]["before_cursor"].present?
+    assert_equal json_body["meta"]["before_cursor"], json_body["meta"]["after_cursor"]
+    assert_nil json_body["links"]["next"]
+    assert_nil json_body["links"]["prev"]
+
+    solo_cursor = json_body["meta"]["after_cursor"]
+
+    # Paging after or before the sole record yields empty page with null cursors & links
+    get "/api/v1/groups", params: { page: { size: 5, after: solo_cursor } }, headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [], json_body["groups"]
+    assert_equal false, json_body["meta"]["has_more"]
+    assert_nil json_body["meta"]["after_cursor"]
+    assert_nil json_body["meta"]["before_cursor"]
+    assert_nil json_body["links"]["next"]
+    assert_nil json_body["links"]["prev"]
+
+    get "/api/v1/groups", params: { page: { size: 5, before: solo_cursor } }, headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [], json_body["groups"]
+    assert_equal false, json_body["meta"]["has_more"]
+    assert_nil json_body["meta"]["after_cursor"]
+    assert_nil json_body["meta"]["before_cursor"]
+    assert_nil json_body["links"]["next"]
+    assert_nil json_body["links"]["prev"]
+
+    # Invalid cursor with NullRelation filter (q with NUL byte or huge assignee_id) MUST still return 422
+    get "/api/v1/tickets?q=abc%00def&page[after]=bogus", headers: account_headers("acme", token: owner_token)
+    assert_response :unprocessable_content
+
+    get "/api/v1/tickets?assignee_id=99999999999999999999999&page[after]=bogus", headers: account_headers("acme", token: owner_token)
+    assert_response :unprocessable_content
+
+    # per_page alongside page[size] uses page[size] and omits per_page from links
+    2.times do |i|
+      post "/api/v1/groups",
+        params: { group: { name: "Extra Group #{i + 1}" } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :created
+    end
+
+    get "/api/v1/groups?page[size]=1&per_page=10", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["groups"].size
+    next_query = Rack::Utils.parse_nested_query(URI.parse(json_body["links"]["next"]).query)
+    assert_equal "1", next_query.dig("page", "size")
+    assert_nil next_query["per_page"]
+
+    # Conflicting scalar + hash page parameter in query string returns 400 Bad Request JSON
+    get "/api/v1/tickets?page=1&page[size]=10", headers: account_headers("acme", token: owner_token)
+    assert_response :bad_request
+    assert json_body["error"].present?
+
+    # Auth / role / cancelled account guards still apply in cursor mode
+    get "/api/v1/tickets?page[size]=5", headers: account_headers("acme", token: customer_token)
+    assert_response :forbidden
+
+    get "/api/v1/requests?page[size]=5", headers: account_headers("acme", token: owner_token)
+    assert_response :forbidden
+
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: owner_token), as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets?page[size]=5", headers: account_headers("acme", token: owner_token)
+    assert_response :unauthorized
+  end
+
+end
