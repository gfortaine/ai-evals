+      refute_match(/COUNT\(/i, sql, "Unexpected COUNT query in cursor mode: #{sql}")
+      refute_match(/OFFSET/i, sql, "Unexpected OFFSET clause in cursor mode: #{sql}")
+    end
+  end
+
+  test "suspending staff keeps staff, users, and bulk-unassigned tickets pagination stable" do
+    signup_and_verify!
+    owner_token = sign_in!(email: "jo@acme.test")["session"]["token"]
+
+    agents = 4.times.map do |i|
+      invite_and_accept!(
+        admin_token: owner_token,
+        email: "staff#{i + 1}@acme.test",
+        role: "agent",
+        name: "Staff #{i + 1}"
+      )[:user]
+    end
+
+    register_and_verify_customer!
+    customer_token = sign_in!(email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    # Create 6 tickets assigned to agents[0]
+    assigned_ticket_ids = 6.times.map do |i|
+      post "/api/v1/requests",
+        params: { request: { subject: "Assigned #{i + 1}", comment: { body: "Body #{i + 1}" } } },
+        headers: account_headers("acme", token: customer_token),
+        as: :json
+      assert_response :created
+      tid = json_body["request"]["id"]
+
+      patch "/api/v1/tickets/#{tid}",
+        params: { ticket: { assignee_id: agents[0]["id"] } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :ok
+      tid
+    end
+
+    # Page 1 of active staff: [owner, agents[0]]
+    get "/api/v1/staff?page[size]=2", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal 2, json_body["staff"].size
+    assert_equal agents[0]["id"], json_body["staff"].last["id"]
+    staff_next = json_body["links"]["next"]
+
+    # Suspend agents[0] (the exact boundary staff member!) -> also bulk-updates all 6 tickets with the exact same updated_at!
+    patch "/api/v1/users/#{agents[0]['id']}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+
+    # Following staff_next still works cleanly and returns [agents[1], agents[2]]
+    get staff_next, headers: account_headers("acme", token: owner_token)
