diff --git a/test/integration/api/v1/groups_and_memberships_test.rb b/test/integration/api/v1/groups_and_memberships_test.rb
new file mode 100644
index 0000000..a91ab2c
--- /dev/null
+++ b/test/integration/api/v1/groups_and_memberships_test.rb
@@ -0,0 +1,567 @@
+require "test_helper"
+
+class Api::V1::GroupsAndMembershipsTest < ActionDispatch::IntegrationTest
+  test "admins create, list, inspect, rename, and delete groups; staff can browse them" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+
+    invite_and_accept!(admin_token: owner_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_token = sign_in!(subdomain: "acme", email: "sam@example.test", password: "my-team-password")["session"]["token"]
+
+    # Create groups
+    post "/api/v1/groups",
+      params: { group: { name: "  Billing  " } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
+    billing = json_body["group"]
+    assert_equal "Billing", billing["name"]
+    assert billing["id"].is_a?(Integer)
+    assert billing["account_id"].is_a?(Integer)
+    assert billing["created_at"].present?
+    assert billing["updated_at"].present?
+
+    post "/api/v1/groups",
+      params: { group: { name: "Technical Support" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
+    support = json_body["group"]
+
+    post "/api/v1/groups",
+      params: { group: { name: "Account Management" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
+    acct_mgmt = json_body["group"]
+
+    # List by ID ascending for both admin and agent
+    [ owner_token, sam_token ].each do |staff_token|
+      get "/api/v1/groups", headers: account_headers("acme", token: staff_token)
+      assert_response :ok
+      assert_equal [ billing["id"], support["id"], acct_mgmt["id"] ], json_body["groups"].map { |g| g["id"] }
+      assert_equal [ "Billing", "Technical Support", "Account Management" ], json_body["groups"].map { |g| g["name"] }
+      assert_equal 3, json_body["count"]
+      assert_equal 1, json_body["page"]
+      assert_equal 25, json_body["per_page"]
+      assert_nil json_body["next_page"]
+      assert_nil json_body["previous_page"]
+
+      # Detail
+      get "/api/v1/groups/#{billing["id"]}", headers: account_headers("acme", token: staff_token)
+      assert_response :ok
+      assert_equal billing["id"], json_body["group"]["id"]
+      assert_equal "Billing", json_body["group"]["name"]
+    end
+
+    # Pagination
+    get "/api/v1/groups?page=1&per_page=2", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_equal [ billing["id"], support["id"] ], json_body["groups"].map { |g| g["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    get "/api/v1/groups?page=2&per_page=2", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_equal [ acct_mgmt["id"] ], json_body["groups"].map { |g| g["id"] }
+    assert_equal 1, json_body["previous_page"]
+    assert_nil json_body["next_page"]
+
+    # Rename with PATCH
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: { name: "  Billing & Invoices  " } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "Billing & Invoices", json_body["group"]["name"]
+
+    # Case-only rename on self succeeds
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: { name: "billing & invoices" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "billing & invoices", json_body["group"]["name"]
+
+    # Patch with unrecognized field is a no-op; empty envelope returns 400
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: { ignored: "value" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "billing & invoices", json_body["group"]["name"]
+
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: {} },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :bad_request
+
+    # PUT also works for rename
+    put "/api/v1/groups/#{billing["id"]}",
+      params: { group: { name: "Billing" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "Billing", json_body["group"]["name"]
+
+    # Delete group -> 204, subsequent GET -> 404, name can be reused
+    delete "/api/v1/groups/#{acct_mgmt["id"]}", headers: account_headers("acme", token: owner_token)
+    assert_response :no_content
+
+    get "/api/v1/groups/#{acct_mgmt["id"]}", headers: account_headers("acme", token: owner_token)
+    assert_response :not_found
+
+    post "/api/v1/groups",
+      params: { group: { name: "Account Management" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
+    assert_operator json_body["group"]["id"], :>, acct_mgmt["id"]
+  end
+
+  test "group memberships lifecycle, defaults, make_default, filtering, and ordering" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_login = sign_in!(subdomain: "acme", email: "jo@acme.test")
+    owner_token = owner_login["session"]["token"]
+    jo_id = owner_login["user"]["id"]
+
+    sam_data = invite_and_accept!(admin_token: owner_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_id = sam_data[:user]["id"]
