+    [ [ :sam_billing, billing_id ], [ :sam_support, support_id ], [ :sam_ops, ops_id ] ].each do |key, expected_group_id|
+      get "/api/v1/tickets/#{ids[key]}", headers: account_headers("acme", token: jo_token)
+      assert_response :ok
+      assert_equal expected_group_id, json_body["ticket"]["group_id"]
+      assert_nil json_body["ticket"]["assignee_id"]
+    end
+
+    # Sam's memberships are KEPT intact while suspended!
+    get "/api/v1/group_memberships?user_id=#{sam_id}", headers: account_headers("acme", token: jo_token)
+    assert_response :ok
+    assert_equal [ m_sam_billing, m_sam_support, m_sam_ops ], json_body["group_memberships"].map { |m| m["id"] }
+    assert_equal [ true, false, false ], json_body["group_memberships"].map { |m| m["default"] }
+
+    # While suspended, Sam cannot be assigned
+    patch "/api/v1/tickets/#{ids[:sam_billing]}",
+      params: { ticket: { assignee_id: sam_id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Unsuspend Sam -> memberships still intact, assigning ungrouped ticket uses Sam's preserved default (Billing)!
+    patch "/api/v1/users/#{sam_id}",
+      params: { user: { suspended: false } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+
+    patch "/api/v1/tickets/#{ids[:ungrouped]}",
+      params: { ticket: { assignee_id: sam_id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+    assert_equal billing_id, json_body["ticket"]["group_id"]
+
+    # Re-assign Sam to sam_billing, sam_support, sam_ops
+    patch "/api/v1/tickets/#{ids[:sam_billing]}", params: { ticket: { assignee_id: sam_id } }, headers: account_headers("acme", token: jo_token), as: :json
+    assert_response :ok
+    patch "/api/v1/tickets/#{ids[:sam_support]}", params: { ticket: { assignee_id: sam_id } }, headers: account_headers("acme", token: jo_token), as: :json
+    assert_response :ok
+    patch "/api/v1/tickets/#{ids[:sam_ops]}", params: { ticket: { assignee_id: sam_id } }, headers: account_headers("acme", token: jo_token), as: :json
+    assert_response :ok
+
+    # B. Deleting Sam's Billing membership (Sam's default):
+    # - clears Sam from sam_billing & ungrouped (which are in Billing), KEEPING group_id=billing_id
+    # - leaves pat_billing (Pat in Billing) untouched
+    # - leaves sam_support & sam_ops untouched
+    # - promotes m_sam_support to Sam's default!
+    delete "/api/v1/group_memberships/#{m_sam_billing}", headers: account_headers("acme", token: jo_token)
+    assert_response :no_content
+
+    [ :sam_billing, :ungrouped ].each do |key|
+      get "/api/v1/tickets/#{ids[key]}", headers: account_headers("acme", token: jo_token)
+      assert_equal billing_id, json_body["ticket"]["group_id"]
+      assert_nil json_body["ticket"]["assignee_id"]
+    end
+
+    get "/api/v1/tickets/#{ids[:pat_billing]}", headers: account_headers("acme", token: jo_token)
+    assert_equal billing_id, json_body["ticket"]["group_id"]
+    assert_equal pat_id, json_body["ticket"]["assignee_id"]
+
+    get "/api/v1/tickets/#{ids[:sam_support]}", headers: account_headers("acme", token: jo_token)
+    assert_equal support_id, json_body["ticket"]["group_id"]
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+
+    get "/api/v1/group_memberships?user_id=#{sam_id}", headers: account_headers("acme", token: jo_token)
+    assert_equal [ m_sam_support, m_sam_ops ], json_body["group_memberships"].map { |m| m["id"] }
+    assert_equal [ true, false ], json_body["group_memberships"].map { |m| m["default"] }
+
+    # C. Deleting Billing group:
+    # - clears group_id AND assignee_id on ALL tickets in Billing (sam_billing, pat_billing, ungrouped)
+    # - promotes Pat's remaining membership (Support) to default!
+    # - leaves Support & Ops tickets untouched
+    delete "/api/v1/groups/#{billing_id}", headers: account_headers("acme", token: jo_token)
+    assert_response :no_content
+
+    [ :sam_billing, :pat_billing, :ungrouped ].each do |key|
+      get "/api/v1/tickets/#{ids[key]}", headers: account_headers("acme", token: jo_token)
+      assert_nil json_body["ticket"]["group_id"]
+      assert_nil json_body["ticket"]["group"]
+      assert_nil json_body["ticket"]["assignee_id"]
+      assert_nil json_body["ticket"]["assignee"]
+    end
+
+    get "/api/v1/group_memberships?user_id=#{pat_id}", headers: account_headers("acme", token: jo_token)
+    assert_equal [ m_pat_support ], json_body["group_memberships"].map { |m| m["id"] }
+    assert_equal [ true ], json_body["group_memberships"].map { |m| m["default"] }
+
+    # Support & Ops tickets untouched
+    get "/api/v1/tickets/#{ids[:sam_support]}", headers: account_headers("acme", token: jo_token)
+    assert_equal support_id, json_body["ticket"]["group_id"]
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+
+    get "/api/v1/tickets/#{ids[:pat_support]}", headers: account_headers("acme", token: jo_token)
+    assert_equal support_id, json_body["ticket"]["group_id"]
+    assert_equal pat_id, json_body["ticket"]["assignee_id"]
+
+    get "/api/v1/tickets/#{ids[:sam_ops]}", headers: account_headers("acme", token: jo_token)
+    assert_equal ops_id, json_body["ticket"]["group_id"]
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+
+    # Customer request timestamps untouched throughout all group/membership/suspension mutations!
+    get "/api/v1/requests/#{ids[:sam_billing]}", headers: account_headers("acme", token: avery_token)
+    assert_equal base.iso8601, json_body["request"]["updated_at"]
+  end
+
+  test "edge cases: invalid group_id on ticket update, cross-tenant group_id, and ungrouped assignee joining group later" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    signup_and_verify!(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test")
+
+    jo_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    bo_token = sign_in!(subdomain: "beta", email: "bo@beta.test")["session"]["token"]
+
+    sam_data = invite_and_accept!(subdomain: "acme", admin_token: jo_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_id = sam_data[:user]["id"]
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    post "/api/v1/groups", params: { group: { name: "Beta Billing" } }, headers: account_headers("beta", token: bo_token), as: :json
+    beta_group_id = json_body["group"]["id"]
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Pre-group ticket", comment: { body: "Created before groups" } } },
+      headers: account_headers("acme", token: avery_token),
+      as: :json
+    ticket_id = json_body["request"]["id"]
+
+    # Invalid group_id values on PATCH /tickets/:id -> 422
+    [ "", "abc", 0, -1, true, [], beta_group_id, 999_999, 99_999_999_999_999_999_999_999 ].each do |bad_gid|
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { group_id: bad_gid } },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 for group_id=#{bad_gid.inspect}"
+      assert json_body["errors"]["group_id"].present?
+    end
+
+    # Assign Sam BEFORE Sam has any groups -> ticket is (nil, Sam)
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { assignee_id: sam_id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_nil json_body["ticket"]["group_id"]
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+
+    # Later, create Billing & Support and add Sam to Billing
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: account_headers("acme", token: jo_token), as: :json
+    billing_id = json_body["group"]["id"]
+    post "/api/v1/groups", params: { group: { name: "Support" } }, headers: account_headers("acme", token: jo_token), as: :json
+    support_id = json_body["group"]["id"]
+
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing_id, user_id: sam_id, default: true } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :created
+
+    # Updating status & adding comment on pre-existing (nil, Sam) ticket still succeeds!
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "pending", comment: { body: "Working on it", public: true } } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal "pending", json_body["ticket"]["status"]
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+    assert_nil json_body["ticket"]["group_id"]
+
+    # Moving (nil, Sam) ticket into Billing keeps Sam
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { group_id: billing_id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal billing_id, json_body["ticket"]["group_id"]
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+
+    # Moving to Support (Sam not in Support) clears Sam
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { group_id: support_id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal support_id, json_body["ticket"]["group_id"]
+    assert_nil json_body["ticket"]["assignee_id"]
+  end
+
+  test "email-origin ticket group routing delivers staff replies only on valid updates" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    jo_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    sam_data = invite_and_accept!(admin_token: jo_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_id = sam_data[:user]["id"]
+
+    acme = Account.find_by!(subdomain: "acme")
+    customer = acme.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+    email_ticket = acme.tickets.create!(requester: customer, subject: "Email inquiry", channel: Ticket::EMAIL)
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: account_headers("acme", token: jo_token), as: :json
+    billing_id = json_body["group"]["id"]
+    post "/api/v1/groups", params: { group: { name: "Support" } }, headers: account_headers("acme", token: jo_token), as: :json
+    support_id = json_body["group"]["id"]
+
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing_id, user_id: sam_id, default: true } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+
+    ActionMailer::Base.deliveries.clear
+
+    # Invalid group + assignee + public comment -> 422, no email delivered
+    patch "/api/v1/tickets/#{email_ticket.id}",
+      params: { ticket: { group_id: support_id, assignee_id: sam_id, comment: { body: "Should not send", public: true } } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Valid assignment to Sam (uses default Billing) + public comment -> 200, email delivered
+    patch "/api/v1/tickets/#{email_ticket.id}",
+      params: { ticket: { assignee_id: sam_id, comment: { body: "We received your billing question.", public: true } } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal billing_id, json_body["ticket"]["group_id"]
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    assert_includes ActionMailer::Base.deliveries.last.body.decoded, "We received your billing question."
+  end
+end
diff --git a/test/models/group_membership_test.rb b/test/models/group_membership_test.rb
new file mode 100644
index 0000000..87ea2b9
--- /dev/null
+++ b/test/models/group_membership_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class GroupMembershipTest < ActiveSupport::TestCase
+  test "enforces staff-only, tenant isolation, uniqueness, and default membership invariants" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+
+    admin = acme.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    agent = acme.users.create!(name: "Sam", email: "sam@acme.test", password: "my-team-password", role: "agent")
+    suspended_agent = acme.users.create!(name: "Pat", email: "pat@acme.test", password: "my-team-password", role: "agent", suspended: true)
+    customer = acme.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+    beta_admin = beta.users.create!(name: "Bo", email: "bo@beta.test", password: "my-first-password", role: "admin")
+
+    g1 = acme.groups.create!(name: "Billing")
+    g2 = acme.groups.create!(name: "Support")
+    g3 = acme.groups.create!(name: "Ops")
+    beta_g = beta.groups.create!(name: "Beta Group")
+
+    # Customer rejected
+    cust_mem = acme.group_memberships.build(group: g1, user: customer)
+    assert_not cust_mem.valid?
+    assert cust_mem.errors[:user_id].any?
+
+    # Cross-tenant rejected
+    cross_user = acme.group_memberships.build(group: g1, user: beta_admin)
+    assert_not cross_user.valid?
+    assert cross_user.errors[:user_id].any?
+
+    cross_group = acme.group_memberships.build(group: beta_g, user: admin)
+    assert_not cross_group.valid?
+    assert cross_group.errors[:group_id].any?
+
+    # Suspended staff allowed
+    susp_mem = acme.group_memberships.create!(group: g1, user: suspended_agent, default: false)
+    assert_equal true, susp_mem.default?
+
+    # First membership automatically defaults to true even if default: false
+    m1 = acme.group_memberships.create!(group: g1, user: agent, default: false)
+    assert_equal true, m1.default?
+    assert_equal g1.id, agent.default_group.id
+
+    # Duplicate membership rejected without touching existing default
+    dup = acme.group_memberships.build(group: g1, user: agent, default: true)
+    assert_not dup.valid?
+    assert dup.errors[:user_id].any?
+    assert_equal true, m1.reload.default?
+
+    # Second membership with default: false keeps m1 as default
+    m2 = acme.group_memberships.create!(group: g2, user: agent, default: false)
+    assert_equal false, m2.default?
+    assert_equal true, m1.reload.default?
+
+    # Third membership with default: true switches default to m3
+    m3 = acme.group_memberships.create!(group: g3, user: agent, default: true)
+    assert_equal true, m3.default?
+    assert_equal false, m1.reload.default?
+    assert_equal false, m2.reload.default?
+    assert_equal g3.id, agent.default_group.id
+
+    # Cannot unset the sole default directly
+    assert_not m3.update(default: false)
+    assert m3.errors[:default].any?
+    assert_equal true, m3.reload.default?
+
+    # make_default! switches default and is idempotent
+    m2.make_default!
+    assert_equal true, m2.reload.default?
+    assert_equal false, m3.reload.default?
+    assert_equal false, m1.reload.default?
+
+    m2.make_default!
+    assert_equal true, m2.reload.default?
+
+    # Destroying default promotes lowest remaining ID (m1)
+    m2.destroy!
+    assert_equal true, m1.reload.default?
+    assert_equal false, m3.reload.default?
+
+    # Destroying non-default keeps m1 as default
+    m3.destroy!
+    assert_equal true, m1.reload.default?
+
+    # Destroying last membership leaves 0 memberships
+    m1.destroy!
+    assert_equal 0, agent.group_memberships.count
+    assert_nil agent.default_group
+  end
+
+  test "destroying a membership clears invalid ticket assignments in that group while keeping the group" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    jo = acme.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    sam = acme.users.create!(name: "Sam", email: "sam@acme.test", password: "my-team-password", role: "agent")
+    avery = acme.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+
+    g1 = acme.groups.create!(name: "Billing")
+    g2 = acme.groups.create!(name: "Support")
+
+    m_jo_g1 = acme.group_memberships.create!(group: g1, user: jo, default: true)
+    m_jo_g2 = acme.group_memberships.create!(group: g2, user: jo, default: false)
+    acme.group_memberships.create!(group: g1, user: sam, default: true)
+
+    base = Time.zone.parse("2026-06-01 10:00:00 UTC")
+    t_jo_g1 = t_sam_g1 = t_jo_g2 = nil
+    travel_to base do
+      t_jo_g1 = acme.tickets.create!(requester: avery, subject: "Jo G1", group: g1, assignee: jo)
+      t_sam_g1 = acme.tickets.create!(requester: avery, subject: "Sam G1", group: g1, assignee: sam)
+      t_jo_g2 = acme.tickets.create!(requester: avery, subject: "Jo G2", group: g2, assignee: jo)
+    end
+
+    travel_to base + 5.minutes do
+      m_jo_g1.destroy!
+    end
+
+    t_jo_g1.reload
+    t_sam_g1.reload
+    t_jo_g2.reload
+
+    # Invalid assignment cleared, group preserved, customer_updated_at untouched
+    assert_equal g1.id, t_jo_g1.group_id
+    assert_nil t_jo_g1.assignee_id
+    assert_equal base, t_jo_g1.customer_updated_at
+    assert_operator t_jo_g1.updated_at, :>, base
+
+    # Other assignments untouched
+    assert_equal g1.id, t_sam_g1.group_id
+    assert_equal sam.id, t_sam_g1.assignee_id
+    assert_equal g2.id, t_jo_g2.group_id
+    assert_equal jo.id, t_jo_g2.assignee_id
+
+    # Jo's remaining membership promoted to default
+    assert_equal true, m_jo_g2.reload.default?
+  end
+end
