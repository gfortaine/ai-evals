new file mode 100644
index 0000000..cdd6e4b
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,97 @@
+class User < ApplicationRecord
+  ROLES = %w[admin agent customer].freeze
+  STAFF_ROLES = %w[admin agent].freeze
+  EMAIL_FORMAT = /\A[^@\s]+@[^@\s]+\.[^@\s]+\z/
+  MIN_PASSWORD_LENGTH = 8
+
+  belongs_to :account
+  has_many :sessions, dependent: :delete_all
+  has_many :user_tokens, dependent: :delete_all
+  has_many :requested_tickets, class_name: "Ticket", foreign_key: :requester_id, dependent: :destroy, inverse_of: :requester
+  has_many :assigned_tickets, class_name: "Ticket", foreign_key: :assignee_id, dependent: :nullify, inverse_of: :assignee
+  has_many :comments, foreign_key: :author_id, dependent: :destroy, inverse_of: :author
+  has_many :sent_invitations, class_name: "Invitation", foreign_key: :invited_by_id, dependent: :nullify, inverse_of: :invited_by
+  has_many :accepted_invitations, class_name: "Invitation", foreign_key: :accepted_user_id, dependent: :nullify, inverse_of: :accepted_user
+  has_many :group_memberships, dependent: :delete_all, inverse_of: :user
+  has_many :groups, through: :group_memberships
+
+  has_secure_password
+
+  normalizes :name, with: ->(value) { value.strip }
+  normalizes :email, with: ->(value) { value.strip.downcase }
+
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :email,
+    presence: true,
+    format: { with: EMAIL_FORMAT },
+    uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, presence: true, inclusion: { in: ROLES }
+  validates :suspended, inclusion: { in: [ true, false ] }
+  validates :password, length: { minimum: MIN_PASSWORD_LENGTH }, if: -> { password.present? }
+
+  before_save :sync_suspended_at
+
+  scope :active, -> { where(suspended: false) }
+  scope :suspended_only, -> { where(suspended: true) }
+  scope :staff, -> { where(role: STAFF_ROLES) }
+  scope :active_staff, -> { staff.active }
+  scope :active_admins, -> { where(role: "admin", suspended: false) }
+  scope :ordered_by_id, -> { order(id: :asc) }
+
+  def verified?
+    email_verified_at.present?
+  end
+
+  def active?
+    !suspended?
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def agent?
+    role == "agent"
+  end
+
+  def customer?
+    role == "customer"
+  end
+
+  def staff?
+    admin? || agent?
+  end
+
+  def owner?
+    account.owner?(self)
+  end
+
+  def default_group
+    account.groups.joins(:group_memberships).find_by(group_memberships: { account_id: account_id, user_id: id, default: true })
+  end
+
+  def verify_email!
+    transaction do
+      update!(email_verified_at: Time.current) unless verified?
+      user_tokens.for_purpose(UserToken::EMAIL_VERIFICATION).delete_all
+    end
+  end
+
+  def revoke_all_sessions!
+    sessions.delete_all
+  end
+
+  def clear_assigned_tickets!
+    account.tickets.where(assignee_id: id).update_all(assignee_id: nil, updated_at: Time.current)
+  end
+
+  private
+
+  def sync_suspended_at
+    if suspended?
+      self.suspended_at ||= Time.current
+    else
+      self.suspended_at = nil
+    end
+  end
+end
diff --git a/app/models/user_token.rb b/app/models/user_token.rb
new file mode 100644
index 0000000..bec18f9
--- /dev/null
+++ b/app/models/user_token.rb
@@ -0,0 +1,50 @@
+require "digest"
+require "securerandom"
+
+class UserToken < ApplicationRecord
+  EMAIL_VERIFICATION = "email_verification"
+  PASSWORD_RESET = "password_reset"
+  PURPOSES = [ EMAIL_VERIFICATION, PASSWORD_RESET ].freeze
+  TTL = {
+    EMAIL_VERIFICATION => 24.hours,
+    PASSWORD_RESET => 2.hours
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+
+  validates :purpose, presence: true, inclusion: { in: PURPOSES }
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  scope :for_purpose, ->(purpose) { where(purpose: purpose) }
+  scope :active, -> { where("expires_at > ?", Time.current) }
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  def self.issue_for!(user:, purpose:)
+    raw_token = SecureRandom.urlsafe_base64(32)
+    transaction do
+      user.user_tokens.for_purpose(purpose).delete_all
+      create!(
+        account: user.account,
+        user: user,
+        purpose: purpose,
+        token_digest: digest(raw_token),
+        expires_at: TTL.fetch(purpose).from_now
+      )
+    end
+    raw_token
+  end
+
+  def self.find_valid(account:, purpose:, raw_token:)
+    return nil if account.nil? || raw_token.blank?
+
+    includes(:user, :account)
+      .for_purpose(purpose)
+      .active
+      .find_by(account_id: account.id, token_digest: digest(raw_token))
+  end
+end
