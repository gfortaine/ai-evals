@@ -0,0 +1,47 @@
+require "test_helper"
+
+class TicketMailerTest < ActionMailer::TestCase
+  test "staff_reply uses default sender and support domain with private reply-to and threading headers" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    staff = account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    customer = account.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+    ticket = account.tickets.create!(requester: customer, subject: "Cannot download receipt", channel: Ticket::EMAIL)
+    Comment.create!(
+      account: account,
+      ticket: ticket,
+      author: customer,
+      body: "Original email",
+      public: true,
+      inbound_message_id: "orig-1@example.test"
+    )
+    reply = Comment.create!(account: account, ticket: ticket, author: staff, body: "Please try again now.", public: true)
+
+    with_env("HELPDESK_MAIL_FROM" => nil, "HELPDESK_SUPPORT_DOMAIN" => nil) do
+      mail = TicketMailer.staff_reply(ticket: ticket, comment: reply)
+
+      assert_equal [ "support@example.test" ], mail.from
+      assert_equal [ "avery@example.test" ], mail.to
+      assert_equal [ "acme+#{ticket.reply_token}@support.example.test" ], mail.reply_to
+      assert_equal "Re: Cannot download receipt", mail.subject
+      assert_equal "orig-1@example.test", mail.in_reply_to
+      assert_equal "orig-1@example.test", mail.references
+      assert_includes mail.body.decoded, "Please try again now."
+    end
+  end
+
+  test "staff_reply honors HELPDESK_MAIL_FROM and HELPDESK_SUPPORT_DOMAIN and avoids double Re prefix" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    staff = account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    customer = account.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+    ticket = account.tickets.create!(requester: customer, subject: "Re: Existing subject", channel: Ticket::EMAIL)
+    reply = Comment.create!(account: account, ticket: ticket, author: staff, body: "Follow up.", public: true)
+
+    with_env("HELPDESK_MAIL_FROM" => "helpdesk@acme.test", "HELPDESK_SUPPORT_DOMAIN" => "mail.helpdesk.test") do
+      mail = TicketMailer.staff_reply(ticket: ticket, comment: reply)
+
+      assert_equal [ "helpdesk@acme.test" ], mail.from
+      assert_equal [ "acme+#{ticket.reply_token}@mail.helpdesk.test" ], mail.reply_to
+      assert_equal "Re: Existing subject", mail.subject
+    end
+  end
+end
