--- /dev/null
+++ b/test/integration/api/v1/ticket_groups_and_routing_test.rb
@@ -0,0 +1,617 @@
+require "test_helper"
+
+class Api::V1::TicketGroupsAndRoutingTest < ActionDispatch::IntegrationTest
+  test "ticket group assignment, auto-default group, moving groups, clearing rules, filtering, and staff visibility" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    jo_login = sign_in!(subdomain: "acme", email: "jo@acme.test")
+    jo_token = jo_login["session"]["token"]
+    jo_id = jo_login["user"]["id"]
+
+    sam_data = invite_and_accept!(admin_token: jo_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_id = sam_data[:user]["id"]
+    sam_token = sign_in!(subdomain: "acme", email: "sam@example.test", password: "my-team-password")["session"]["token"]
+
+    pat_data = invite_and_accept!(admin_token: jo_token, email: "pat@example.test", role: "agent", name: "Pat")
+    pat_id = pat_data[:user]["id"]
+    pat_token = sign_in!(subdomain: "acme", email: "pat@example.test", password: "my-team-password")["session"]["token"]
+
+    lee_data = invite_and_accept!(admin_token: jo_token, email: "lee@example.test", role: "agent", name: "Lee")
+    lee_id = lee_data[:user]["id"]
+    lee_token = sign_in!(subdomain: "acme", email: "lee@example.test", password: "my-team-password")["session"]["token"]
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    # Create groups: Billing, Technical Support
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: account_headers("acme", token: jo_token), as: :json
+    billing_id = json_body["group"]["id"]
+    post "/api/v1/groups", params: { group: { name: "Technical Support" } }, headers: account_headers("acme", token: jo_token), as: :json
+    support_id = json_body["group"]["id"]
+
+    # Memberships:
+    # Jo: Billing (default), Technical Support
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing_id, user_id: jo_id, default: true } },
+      headers: account_headers("acme", token: jo_token), as: :json
+    m_jo_billing_id = json_body["group_membership"]["id"]
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: support_id, user_id: jo_id, default: false } },
+      headers: account_headers("acme", token: jo_token), as: :json
+    m_jo_support_id = json_body["group_membership"]["id"]
+
+    # Sam: Billing (default) ONLY
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing_id, user_id: sam_id, default: true } },
+      headers: account_headers("acme", token: jo_token), as: :json
+
+    # Pat: Technical Support (default) ONLY
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: support_id, user_id: pat_id, default: true } },
+      headers: account_headers("acme", token: jo_token), as: :json
+
+    # Lee: NO group memberships!
+
+    # Customer opens 4 tickets
+    base = Time.zone.parse("2026-07-01 09:00:00 UTC")
+    tickets = {}
+    [ :t1, :t2, :t3, :t4 ].each_with_index do |key, idx|
+      travel_to base + idx.minutes do
+        post "/api/v1/requests",
+          params: { request: { subject: "Ticket #{key}", comment: { body: "Help with #{key}" } } },
+          headers: account_headers("acme", token: avery_token),
+          as: :json
+        assert_response :created
+        assert_not json_body["request"].key?("group_id")
+        assert_not json_body["request"].key?("group")
+        tickets[key] = json_body["request"]["id"]
+      end
+    end
+
+    # Initial ticket serialization has group_id: nil, group: nil
+    get "/api/v1/tickets/#{tickets[:t1]}", headers: account_headers("acme", token: jo_token)
+    assert_response :ok
+    assert_nil json_body["ticket"]["group_id"]
+    assert_nil json_body["ticket"]["group"]
+
+    # 1. Assigning someone with a default group to an ungrouped ticket uses their default group
+    travel_to base + 10.minutes do
+      patch "/api/v1/tickets/#{tickets[:t1]}",
+        params: { ticket: { assignee_id: sam_id } },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :ok
+      assert_equal sam_id, json_body["ticket"]["assignee_id"]
+      assert_equal billing_id, json_body["ticket"]["group_id"]
+      assert_equal({ "id" => billing_id, "name" => "Billing" }, json_body["ticket"]["group"])
+    end
+
+    # Customer request never exposes group and customer_updated_at was not bumped
+    get "/api/v1/requests/#{tickets[:t1]}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_not json_body["request"].key?("group_id")
+    assert_not json_body["request"].key?("group")
+    assert_equal base.iso8601, json_body["request"]["updated_at"]
+
+    # 2. Assigning someone with NO group memberships to an ungrouped ticket leaves it ungrouped
+    travel_to base + 11.minutes do
+      patch "/api/v1/tickets/#{tickets[:t2]}",
+        params: { ticket: { assignee_id: lee_id } },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :ok
+      assert_equal lee_id, json_body["ticket"]["assignee_id"]
+      assert_nil json_body["ticket"]["group_id"]
+      assert_nil json_body["ticket"]["group"]
+    end
+
+    # 3. Assigning someone who does NOT belong to ticket's group -> 422
+    # t1 is in Billing; Pat is only in Technical Support, Lee is in no group
+    [ pat_id, lee_id ].each do |bad_assignee_id|
+      patch "/api/v1/tickets/#{tickets[:t1]}",
+        params: { ticket: { assignee_id: bad_assignee_id } },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :unprocessable_content
+      assert json_body["errors"]["assignee_id"].present?
+    end
+
+    # Assigning Jo (in both Billing & Support) to t1 in Billing succeeds and keeps Billing
+    # Switch Jo's default to Support first to prove grouped ticket does NOT switch to Jo's default!
+    put "/api/v1/group_memberships/#{m_jo_support_id}/make_default",
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+
+    patch "/api/v1/tickets/#{tickets[:t1]}",
+      params: { ticket: { assignee_id: jo_id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal jo_id, json_body["ticket"]["assignee_id"]
+    assert_equal billing_id, json_body["ticket"]["group_id"]
+
+    # Assigning Jo to ungrouped t3 uses Jo's NEW default group (Technical Support)
+    patch "/api/v1/tickets/#{tickets[:t3]}",
+      params: { ticket: { assignee_id: jo_id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal jo_id, json_body["ticket"]["assignee_id"]
+    assert_equal support_id, json_body["ticket"]["group_id"]
+    assert_equal({ "id" => support_id, "name" => "Technical Support" }, json_body["ticket"]["group"])
+
+    # Restore Jo's default back to Billing for later checks
