+require "test_helper"
+
+class Api::V1::TicketPriorityAndFilteringTest < ActionDispatch::IntegrationTest
+  test "staff mark tickets normal or high priority atomically while priority remains completely internal to customers" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    signup_and_verify!(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test")
+
+    owner_login = sign_in!(subdomain: "acme", email: "jo@acme.test")
+    owner_token = owner_login["session"]["token"]
+    owner_id = owner_login["user"]["id"]
+
+    sam_id = invite_and_accept!(admin_token: owner_token, email: "sam@example.test", role: "agent", name: "Sam")[:user]["id"]
+    sam_token = sign_in!(subdomain: "acme", email: "sam@example.test", password: "my-team-password")["session"]["token"]
+
+    beta_owner_token = sign_in!(subdomain: "beta", email: "bo@beta.test")["session"]["token"]
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    base_time = Time.zone.parse("2026-07-01 12:00:00 UTC")
+    t1 = nil
+    t2 = nil
+
+    # Customer attempting to set priority: "high" on create is ignored; defaults to "normal" and not returned
+    travel_to base_time do
+      post "/api/v1/requests",
+        params: { request: { subject: "First request", priority: "high", comment: { body: "Opening 1" } } },
+        headers: account_headers("acme", token: avery_token),
+        as: :json
+      assert_response :created
+      t1 = json_body["request"]["id"]
+      assert_not json_body["request"].key?("priority")
+    end
+
+    travel_to base_time + 1.minute do
+      post "/api/v1/requests",
+        params: { request: { subject: "Second request", comment: { body: "Opening 2" } } },
+        headers: account_headers("acme", token: avery_token),
+        as: :json
+      assert_response :created
+      t2 = json_body["request"]["id"]
+      assert_not json_body["request"].key?("priority")
+    end
+
+    # Capture customer baseline
+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    baseline_requests = json_body
+    assert_equal [ t2, t1 ], baseline_requests["requests"].map { |r| r["id"] }
+    baseline_requests["requests"].each { |r| assert_not r.key?("priority") }
+
+    get "/api/v1/requests/#{t1}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    baseline_t1_request = json_body["request"]
+    assert_not baseline_t1_request.key?("priority")
+
+    # Staff sees priority defaulting to "normal" on list and detail
+    [ owner_token, sam_token ].each do |staff_token|
+      get "/api/v1/tickets", headers: account_headers("acme", token: staff_token)
+      assert_response :ok
+      assert_equal %w[normal normal], json_body["tickets"].map { |t| t["priority"] }
+
+      get "/api/v1/tickets/#{t1}", headers: account_headers("acme", token: staff_token)
+      assert_response :ok
+      assert_equal "normal", json_body["ticket"]["priority"]
+    end
+
+    # Agent marks t1 as high priority -> staff inbox updates, customer sees ZERO change
+    travel_to base_time + 10.minutes do
+      patch "/api/v1/tickets/#{t1}",
+        params: { ticket: { priority: "high" } },
+        headers: account_headers("acme", token: sam_token),
+        as: :json
+      assert_response :ok
+      assert_equal "high", json_body["ticket"]["priority"]
+      assert_equal (base_time + 10.minutes).iso8601, json_body["ticket"]["updated_at"]
+    end
+
+    get "/api/v1/tickets", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [ t1, t2 ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal %w[high normal], json_body["tickets"].map { |t| t["priority"] }
+
+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_requests, json_body
+
+    get "/api/v1/requests/#{t1}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_t1_request, json_body["request"]
+
+    # Customer attempting to change priority via PATCH /requests/:id is ignored (stays "high")
+    travel_to base_time + 12.minutes do
+      patch "/api/v1/requests/#{t1}",
+        params: { request: { priority: "normal", comment: { body: "Following up" } } },
+        headers: account_headers("acme", token: avery_token),
