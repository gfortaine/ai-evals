+
+    # Now owner is AGAIN the last active admin (Pat is suspended) -> cannot suspend owner!
+    patch "/api/v1/users/#{owner_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["suspended"].present?
+
+    # Unsuspend Pat -> now owner CAN even suspend self because Pat is an active admin
+    patch "/api/v1/users/#{pat_id}",
+      params: { user: { suspended: false } },
