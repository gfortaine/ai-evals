@@ -0,0 +1,315 @@
+require "test_helper"
+
+class TicketTest < ActiveSupport::TestCase
+  test "normalizes subject, defaults to open and normal priority, and validates status, priority, and account ownership" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+    customer = acme.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+    beta_customer = beta.users.create!(name: "Bob", email: "bob@example.test", password: "my-customer-password", role: "customer")
+
+    ticket = acme.tickets.create!(requester: customer, subject: "  Cannot download receipt  ")
+    assert_equal "Cannot download receipt", ticket.subject
+    assert_equal "open", ticket.status
+    assert_equal "normal", ticket.priority
+    assert_nil ticket.assignee_id
+
+    assert ticket.update(priority: "high")
+    assert_equal "high", ticket.reload.priority
+    assert ticket.update(priority: "normal")
+    assert_equal "normal", ticket.reload.priority
+
+    invalid_status = acme.tickets.build(requester: customer, subject: "Test", status: "archived")
+    assert_not invalid_status.valid?
+    assert invalid_status.errors[:status].any?
+
+    [ "urgent", "low", "HIGH", "", nil ].each do |bad_priority|
+      invalid_priority = acme.tickets.build(requester: customer, subject: "Test", priority: bad_priority)
+      assert_not invalid_priority.valid?, "Expected priority=#{bad_priority.inspect} to be invalid"
+      assert invalid_priority.errors[:priority].any?
+    end
+
+    blank_subject = acme.tickets.build(requester: customer, subject: "   ")
+    assert_not blank_subject.valid?
+    assert blank_subject.errors[:subject].any?
+
+    cross_account = acme.tickets.build(requester: beta_customer, subject: "Cross tenant")
+    assert_not cross_account.valid?
+    assert cross_account.errors[:requester].any?
+  end
+
+  test "validates assignee must be active staff in same account" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+    admin = acme.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    agent = acme.users.create!(name: "Sam", email: "sam@acme.test", password: "my-team-password", role: "agent")
+    suspended_agent = acme.users.create!(name: "Pat", email: "pat@acme.test", password: "my-team-password", role: "agent", suspended: true)
+    customer = acme.users.create!(name: "Avery", email: "avery@acme.test", password: "my-customer-password", role: "customer")
+    beta_admin = beta.users.create!(name: "Bo", email: "bo@beta.test", password: "my-first-password", role: "admin")
+
+    ticket = acme.tickets.create!(requester: customer, subject: "Help")
+
+    assert ticket.update(assignee: admin)
+    assert ticket.update(assignee: agent)
+    assert ticket.update(assignee: nil)
+
+    assert_not ticket.update(assignee: customer)
+    assert ticket.errors[:assignee_id].any?
+
+    assert_not ticket.update(assignee: suspended_agent)
+    assert ticket.errors[:assignee_id].any?
+
+    assert_not ticket.update(assignee: beta_admin)
+    assert ticket.errors[:assignee_id].any?
+  end
+
+  test "comment creation touches ticket updated_at and private/internal activity leaves customer_updated_at unchanged" do
+    old_account = Account.create!(name: "Old", subdomain: "old", cancelled_at: 91.days.ago)
+    owner = old_account.users.create!(name: "Jo", email: "jo@old.test", password: "my-first-password", role: "admin", email_verified_at: 100.days.ago)
+    old_account.update!(owner: owner)
+    customer = old_account.users.create!(name: "Avery", email: "avery@old.test", password: "my-customer-password", role: "customer", email_verified_at: 100.days.ago)
+
+    ticket = nil
+    travel_to Time.zone.parse("2026-01-01 10:00:00 UTC") do
+      ticket = old_account.tickets.create!(requester: customer, subject: "Receipt issue")
+    end
+
+    original_updated_at = ticket.updated_at
+    assert_equal original_updated_at, ticket.customer_updated_at
+
+    # Internal assignment does not touch customer_updated_at
+    travel_to Time.zone.parse("2026-01-01 10:02:00 UTC") do
+      ticket.update!(assignee: owner)
+    end
+    ticket.reload
+    assert_operator ticket.updated_at, :>, original_updated_at
+    assert_equal original_updated_at, ticket.customer_updated_at
+
+    # Internal priority change does not touch customer_updated_at
+    after_assign = ticket.updated_at
+    travel_to Time.zone.parse("2026-01-01 10:02:30 UTC") do
+      ticket.update!(priority: Ticket::HIGH)
+    end
+    ticket.reload
+    assert_operator ticket.updated_at, :>, after_assign
+    assert_equal original_updated_at, ticket.customer_updated_at
+
+    # Private note touches updated_at only
+    after_priority = ticket.updated_at
+    travel_to Time.zone.parse("2026-01-01 10:03:00 UTC") do
+      Comment.create!(account: old_account, ticket: ticket, author: owner, body: "Internal check", public: false)
+    end
+    ticket.reload
+    assert_operator ticket.updated_at, :>, after_priority
+    assert_equal original_updated_at, ticket.customer_updated_at
+
+    # Public comment touches both updated_at and customer_updated_at
+    travel_to Time.zone.parse("2026-01-01 10:05:00 UTC") do
+      Comment.create!(account: old_account, ticket: ticket, author: owner, body: "Checking now", public: true)
+    end
+    ticket.reload
+    assert_operator ticket.updated_at, :>, original_updated_at
+    assert_equal ticket.updated_at, ticket.customer_updated_at
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_not Account.exists?(old_account.id)
+    assert_equal 0, Ticket.where(account_id: old_account.id).count
+    assert_equal 0, Comment.where(account_id: old_account.id).count
+  end
+
+  test "search_text searches subjects and public comments literally and excludes private notes" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    admin = acme.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    customer = acme.users.create!(name: "Avery", email: "avery@acme.test", password: "my-customer-password", role: "customer")
+
+    t_percent = acme.tickets.create!(requester: customer, subject: "100% discount coupon")
+    Comment.create!(account: acme, ticket: t_percent, author: customer, body: "Discount 100% failed", public: true)
+
+    t_number = acme.tickets.create!(requester: customer, subject: "1000 points missing")
+    Comment.create!(account: acme, ticket: t_number, author: admin, body: "Internal secret 100% note", public: false)
+
+    t_underscore = acme.tickets.create!(requester: customer, subject: "Issue with order_123")
+    t_non_underscore = acme.tickets.create!(requester: customer, subject: "Issue with orderX123")
+
+    t_backslash = acme.tickets.create!(requester: customer, subject: "Path error")
+    Comment.create!(account: acme, ticket: t_backslash, author: customer, body: 'Saved at C:\Users\Avery', public: true)
+
+    assert_equal [ t_percent.id ], acme.tickets.search_text("100%").pluck(:id)
+    assert_equal [ t_percent.id ], acme.tickets.search_text("%").pluck(:id)
+    assert_equal [ t_underscore.id ], acme.tickets.search_text("order_123").pluck(:id)
+    assert_equal [ t_underscore.id ], acme.tickets.search_text("_").pluck(:id)
+    assert_equal [ t_backslash.id ], acme.tickets.search_text('\\').pluck(:id)
+    assert_equal [ t_backslash.id ], acme.tickets.search_text('c:\users').pluck(:id)
+    assert_equal [], acme.tickets.search_text("secret").pluck(:id)
+    assert_equal [], acme.tickets.search_text("foo\x00bar").pluck(:id)
+  end
+
+  test "assigns unique private reply_token, defaults channel to portal, and formats support and reply addresses" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    customer = acme.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+
+    t1 = acme.tickets.create!(requester: customer, subject: "Portal ticket")
+    t2 = acme.tickets.create!(requester: customer, subject: "Email ticket", channel: Ticket::EMAIL)
+
+    assert_equal Ticket::PORTAL, t1.channel
+    assert_not t1.email_origin?
+    assert_equal Ticket::EMAIL, t2.channel
+    assert t2.email_origin?
+
+    assert t1.reply_token.present?
+    assert t2.reply_token.present?
+    assert_not_equal t1.reply_token, t2.reply_token
+
+    with_env("HELPDESK_SUPPORT_DOMAIN" => nil) do
+      assert_equal "acme@support.example.test", acme.support_address
+      assert_equal "acme+#{t2.reply_token}@support.example.test", t2.reply_address
+    end
+
+    with_env("HELPDESK_SUPPORT_DOMAIN" => "mail.acme-help.test") do
+      assert_equal "acme@mail.acme-help.test", acme.support_address
+      assert_equal "acme+#{t2.reply_token}@mail.acme-help.test", t2.reply_address
+    end
+
+    invalid_channel = acme.tickets.build(requester: customer, subject: "Bad channel", channel: "sms")
+    assert_not invalid_channel.valid?
+    assert invalid_channel.errors[:channel].any?
+  end
+
+  test "validates group ownership, assignee group membership, scopes, and preserves customer_updated_at" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+    jo = acme.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    sam = acme.users.create!(name: "Sam", email: "sam@acme.test", password: "my-team-password", role: "agent")
+    avery = acme.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+
+    billing = acme.groups.create!(name: "Billing")
+    support = acme.groups.create!(name: "Support")
+    beta_group = beta.groups.create!(name: "Billing")
+
+    acme.group_memberships.create!(group: billing, user: jo, default: true)
+
+    base = Time.zone.parse("2026-06-01 10:00:00 UTC")
+    t1 = t2 = nil
+    travel_to base do
+      t1 = acme.tickets.create!(requester: avery, subject: "T1")
+      t2 = acme.tickets.create!(requester: avery, subject: "T2", group: billing, assignee: jo)
+    end
+
+    # Cross-tenant group rejected
+    assert_not t1.update(group: beta_group)
+    assert t1.errors[:group_id].any?
+
+    # Non-existent group_id rejected
+    assert_not t1.update(group_id: 999_999_999)
+    assert t1.errors[:group_id].any?
+
+    # Assignee not in group rejected
+    t1.reload
+    assert_not t1.update(group: billing, assignee: sam)
+    assert t1.errors[:assignee_id].any?
+
+    assert_not t1.update(group: support, assignee: jo)
+    assert t1.errors[:assignee_id].any?
+
+    # Changing group updates updated_at without touching customer_updated_at
+    t1.reload
+    travel_to base + 5.minutes do
+      assert t1.update(group: support)
+    end
+    t1.reload
+    assert_equal support.id, t1.group_id
+    assert_operator t1.updated_at, :>, base
+    assert_equal base, t1.customer_updated_at
+
+    # Scopes
+    t3 = acme.tickets.create!(requester: avery, subject: "T3 ungrouped")
+    assert_equal [ t3.id ], acme.tickets.ungrouped.pluck(:id)
+    assert_equal [ t2.id ], acme.tickets.in_group_id(billing.id).pluck(:id)
+    assert_equal [ t1.id ], acme.tickets.in_group_id(support.id).pluck(:id)
+  end
+
+  test "validates closed status immutability and merged_into invariants" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+    avery = acme.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+    blake = acme.users.create!(name: "Blake", email: "blake@example.test", password: "my-customer-password", role: "customer")
+    beta_customer = beta.users.create!(name: "Bob", email: "bob@example.test", password: "my-customer-password", role: "customer")
+
+    t1 = acme.tickets.create!(requester: avery, subject: "Dup 1")
+    t2 = acme.tickets.create!(requester: avery, subject: "Target")
+    t3 = acme.tickets.create!(requester: avery, subject: "Chain Target")
+    other_customer_ticket = acme.tickets.create!(requester: blake, subject: "Blake ticket")
+    beta_ticket = beta.tickets.create!(requester: beta_customer, subject: "Beta ticket")
+
+    assert_nil t1.merged_into_id
+
+    # Cannot set merged_into without status: closed
+    assert_not t1.update(merged_into: t2)
+    assert t1.errors[:status].any?
+    t1.reload
+
+    # Cannot self-merge
+    assert_not t1.update(status: Ticket::CLOSED, merged_into: t1)
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Cannot merge into different customer
+    assert_not t1.update(status: Ticket::CLOSED, merged_into: other_customer_ticket)
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Cannot merge into another account
+    assert_not t1.update(status: Ticket::CLOSED, merged_into: beta_ticket)
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Cannot merge into nonexistent ticket
+    assert_not t1.update(status: Ticket::CLOSED, merged_into_id: 999_999_999)
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Valid merge closes t1 and updates customer_updated_at
+    base = Time.zone.parse("2026-09-01 10:00:00 UTC")
+    t1.update_columns(updated_at: base, customer_updated_at: base)
+    travel_to base + 10.minutes do
+      assert t1.update(status: Ticket::CLOSED, merged_into: t2)
+    end
+    t1.reload
+    assert t1.closed?
+    assert_equal t2.id, t1.merged_into_id
+    assert_equal base + 10.minutes, t1.updated_at
+    assert_equal base + 10.minutes, t1.customer_updated_at
+
+    # Closed ticket rejects further updates
+    assert_not t1.update(status: Ticket::OPEN)
+    assert t1.errors[:status].any?
+    t1.reload
+    assert_not t1.update(priority: Ticket::HIGH)
+    assert t1.errors[:status].any?
+    t1.reload
+    assert_not t1.update(subject: "Renamed")
+    assert t1.errors[:status].any?
+
+    # Cannot merge another ticket into already-closed t1
+    assert_not t3.update(status: Ticket::CLOSED, merged_into: t1)
+    assert t3.errors[:merged_into_id].any?
+    t3.reload
+
+    # Chained merge: t2 -> t3 leaves t1 -> t2 intact
+    assert t2.update(status: Ticket::CLOSED, merged_into: t3)
+    assert_equal t2.id, t1.reload.merged_into_id
+    assert_equal t3.id, t2.reload.merged_into_id
+    assert_nil t3.reload.merged_into_id
+
+    # DB check constraint blocks self-merge even via raw SQL
+    assert_raises(ActiveRecord::StatementInvalid) do
+      ActiveRecord::Base.transaction(requires_new: true) do
+        Ticket.where(id: t3.id).update_all(merged_into_id: t3.id)
+      end
+    end
+
+    # Cancelled account purge cleanly deletes merged and chained tickets
+    acme.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_cancelled!
+    assert_nil Account.find_by(id: acme.id)
+  end
+end
