+++ b/lib/json_exceptions_app.rb
@@ -0,0 +1,20 @@
+require "json"
+require "rack/utils"
+
+class JsonExceptionsApp
+  def call(env)
+    status = env["PATH_INFO"].to_s.delete_prefix("/").to_i
+    status = 500 if status < 400 || status > 599
+    message = Rack::Utils::HTTP_STATUS_CODES.fetch(status, "Internal Server Error")
+    body = JSON.generate({ error: message })
+
+    [
+      status,
+      {
+        "content-type" => "application/json; charset=utf-8",
+        "content-length" => body.bytesize.to_s
+      },
+      [ body ]
+    ]
+  end
+end
