+require "test_helper"
+
+class Api::V1::TicketAssignmentAndPrivateNotesTest < ActionDispatch::IntegrationTest
+  test "admins and agents assign, reassign, and clear tickets; invalid assignees fail atomically" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    signup_and_verify!(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test")
+
+    owner_login = sign_in!(subdomain: "acme", email: "jo@acme.test")
+    owner_token = owner_login["session"]["token"]
+    owner_id = owner_login["user"]["id"]
+    beta_owner_id = sign_in!(subdomain: "beta", email: "bo@beta.test")["user"]["id"]
+
+    sam_id = invite_and_accept!(admin_token: owner_token, email: "sam@example.test", role: "agent", name: "Sam")[:user]["id"]
+    pat_id = invite_and_accept!(admin_token: owner_token, email: "pat@example.test", role: "agent", name: "Pat")[:user]["id"]
+    avery_data = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_id = avery_data["user"]["id"]
+
+    sam_token = sign_in!(email: "sam@example.test", password: "my-team-password")["session"]["token"]
+    avery_token = sign_in!(email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    # Suspend Pat to verify assigning to suspended staff is rejected
+    patch "/api/v1/users/#{pat_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+
+    # Customer opens a request
+    post "/api/v1/requests",
+      params: { request: { subject: "Receipt issue", comment: { body: "Help please" } } },
+      headers: account_headers("acme", token: avery_token),
+      as: :json
+    assert_response :created
+    ticket_id = json_body["request"]["id"]
+    assert_not json_body["request"].key?("assignee_id")
+    assert_not json_body["request"].key?("assignee")
+
+    # Initially unassigned on staff ticket list and detail
+    get "/api/v1/tickets", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_nil json_body["tickets"].first["assignee_id"]
+    assert_nil json_body["tickets"].first["assignee"]
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_nil json_body["ticket"]["assignee_id"]
+    assert_nil json_body["ticket"]["assignee"]
+
+    # Agent assigns ticket to self
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { assignee_id: sam_id } },
+      headers: account_headers("acme", token: sam_token),
+      as: :json
+    assert_response :ok
+    assert_equal sam_id, json_body["ticket"]["assignee_id"]
+    assert_equal({ "id" => sam_id, "name" => "Sam" }, json_body["ticket"]["assignee"])
+
+    # Admin reassigns ticket to admin
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { assignee_id: owner_id } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal owner_id, json_body["ticket"]["assignee_id"]
+    assert_equal({ "id" => owner_id, "name" => "Jo" }, json_body["ticket"]["assignee"])
+
+    # Assignee name reflects profile updates
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Owner" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_equal({ "id" => owner_id, "name" => "Jo Owner" }, json_body["ticket"]["assignee"])
+
+    # Agent clears assignment with null
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { assignee_id: nil } },
+      headers: account_headers("acme", token: sam_token),
+      as: :json
+    assert_response :ok
+    assert_nil json_body["ticket"]["assignee_id"]
+    assert_nil json_body["ticket"]["assignee"]
+
+    # Invalid assignees rejected atomically (status and comment NOT persisted)
+    [
+      avery_id,                       # customer
+      pat_id,                         # suspended agent
+      beta_owner_id,                  # staff from another tenant
+      999_999,                        # nonexistent
+      99999999999999999999999,        # out of bigint range
+      0,
+      -1,
+      "",
+      "not-an-id",
+      true,
+      []
+    ].each do |bad_assignee|
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: {
+          ticket: {
+            assignee_id: bad_assignee,
+            status: "pending",
+            comment: { body: "Should not persist" }
+          }
+        },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 for assignee_id=#{bad_assignee.inspect}"
+      assert json_body["errors"]["assignee_id"].present?
+    end
+
+    ticket = Ticket.find(ticket_id)
+    assert_nil ticket.assignee_id
+    assert_equal "open", ticket.status
+    assert_equal 1, ticket.comments.count
+  end
+
+  test "private notes and ticket assignments never change customer-facing request timestamps, ordering, fields, or comments" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_login = sign_in!(subdomain: "acme", email: "jo@acme.test")
+    owner_token = owner_login["session"]["token"]
+    owner_id = owner_login["user"]["id"]
+
+    sam_id = invite_and_accept!(admin_token: owner_token, email: "sam@example.test", role: "agent", name: "Sam")[:user]["id"]
+    sam_token = sign_in!(email: "sam@example.test", password: "my-team-password")["session"]["token"]
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in!(email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    base_time = Time.zone.parse("2026-06-01 12:00:00 UTC")
+    ticket_ids = []
+
+    3.times do |i|
+      travel_to base_time + i.minutes do
+        post "/api/v1/requests",
+          params: { request: { subject: "Request #{i + 1}", comment: { body: "Opening #{i + 1}" } } },
+          headers: account_headers("acme", token: avery_token),
+          as: :json
+        assert_response :created
+        ticket_ids << json_body["request"]["id"]
+      end
+    end
+
+    t1, t2, t3 = ticket_ids
+    ActionMailer::Base.deliveries.clear
+
+    # Capture customer-facing baseline
+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    baseline_requests = json_body
+    assert_equal [ t3, t2, t1 ], baseline_requests["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{t1}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    baseline_t1_request = json_body["request"]
+
+    get "/api/v1/requests/#{t1}/comments", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    baseline_t1_comments = json_body
+
+    # 1. At +10m: Agent adds a private note on t1
+    travel_to base_time + 10.minutes do
+      patch "/api/v1/tickets/#{t1}",
+        params: { ticket: { comment: { body: "Checking this with billing.", public: false } } },
+        headers: account_headers("acme", token: sam_token),
+        as: :json
+      assert_response :ok
+      assert_equal "open", json_body["ticket"]["status"]
+      assert_equal (base_time + 10.minutes).iso8601, json_body["ticket"]["updated_at"]
+    end
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Staff sees t1 bumped to top and sees private note
+    get "/api/v1/tickets", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_equal [ t1, t3, t2 ], json_body["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets/#{t1}/comments", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal "Checking this with billing.", json_body["comments"][1]["body"]
+    assert_equal false, json_body["comments"][1]["public"]
+    assert_equal({ "id" => sam_id, "name" => "Sam" }, json_body["comments"][1]["author"])
+
+    # Customer sees ZERO change on /requests, /requests/:id, and /requests/:id/comments!
+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_requests, json_body
+
+    get "/api/v1/requests/#{t1}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_t1_request, json_body["request"]
+
+    get "/api/v1/requests/#{t1}/comments", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_t1_comments, json_body
+
+    # 2. At +15m: Admin assigns t1 to Sam AND adds another private note
+    travel_to base_time + 15.minutes do
+      patch "/api/v1/tickets/#{t1}",
+        params: {
+          ticket: {
+            assignee_id: sam_id,
+            comment: { body: "Handing off to Sam.", public: false }
+          }
+        },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :ok
+      assert_equal sam_id, json_body["ticket"]["assignee_id"]
+      assert_equal({ "id" => sam_id, "name" => "Sam" }, json_body["ticket"]["assignee"])
+    end
+
+    # Still ZERO change for customer!
+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_requests, json_body
+
+    get "/api/v1/requests/#{t1}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_t1_request, json_body["request"]
+
+    get "/api/v1/requests/#{t1}/comments", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_t1_comments, json_body
+
+    # 3. At +20m: Admin clears assignment on t1
+    travel_to base_time + 20.minutes do
+      patch "/api/v1/tickets/#{t1}",
+        params: { ticket: { assignee_id: nil } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :ok
+      assert_nil json_body["ticket"]["assignee_id"]
+    end
+
+    # Still ZERO change for customer!
+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_requests, json_body
+
+    get "/api/v1/requests/#{t1}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal baseline_t1_request, json_body["request"]
+
+    # 4. At +25m: Staff sends a PUBLIC reply on t1 -> NOW customer sees the update and t1 moves to top!
+    travel_to base_time + 25.minutes do
+      patch "/api/v1/tickets/#{t1}",
+        params: { ticket: { comment: { body: "Billing confirmed your refund.", public: true } } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal [ t1, t3, t2 ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{t1}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal (base_time + 25.minutes).iso8601, json_body["request"]["updated_at"]
+
+    get "/api/v1/requests/#{t1}/comments", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal [ "Opening 1", "Billing confirmed your refund." ], json_body["comments"].map { |c| c["body"] }
+
+    # Staff sees all 4 comments (2 public + 2 private)
+    get "/api/v1/tickets/#{t1}/comments", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal 4, json_body["count"]
+    assert_equal [ true, false, false, true ], json_body["comments"].map { |c| c["public"] }
+
+    # 5. At +30m: Staff changes status on t2 alongside a private note -> customer sees status & timestamp change, private note hidden
+    travel_to base_time + 30.minutes do
+      patch "/api/v1/tickets/#{t2}",
+        params: {
+          ticket: {
+            assignee_id: owner_id,
+            status: "pending",
+            comment: { body: "Waiting on customer info (internal).", public: false }
+          }
+        },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal [ t2, t1, t3 ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{t2}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal "pending", json_body["request"]["status"]
+    assert_equal (base_time + 30.minutes).iso8601, json_body["request"]["updated_at"]
+    assert_not json_body["request"].key?("assignee_id")
+
+    get "/api/v1/requests/#{t2}/comments", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal [ "Opening 2" ], json_body["comments"].map { |c| c["body"] }
+
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
+end
diff --git a/test/integration/api/v1/ticket_groups_and_routing_test.rb b/test/integration/api/v1/ticket_groups_and_routing_test.rb
