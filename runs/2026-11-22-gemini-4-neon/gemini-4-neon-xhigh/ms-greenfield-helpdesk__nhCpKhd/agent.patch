+require "test_helper"
+
+class AuthMailerTest < ActionMailer::TestCase
+  test "email_verification uses default frontend URL and sender" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    user = account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+
+    with_env("HELPDESK_FRONTEND_URL" => nil, "HELPDESK_MAIL_FROM" => nil) do
+      mail = AuthMailer.email_verification(user: user, token: "abc123")
+      assert_equal [ "support@example.test" ], mail.from
+      assert_equal [ "jo@acme.test" ], mail.to
+      assert_includes mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token=abc123"
+    end
+  end
+
+  test "password_reset honors HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    user = account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+
+    with_env("HELPDESK_FRONTEND_URL" => "https://support.acme.test/", "HELPDESK_MAIL_FROM" => "no-reply@acme.test") do
+      mail = AuthMailer.password_reset(user: user, token: "reset999")
+      assert_equal [ "no-reply@acme.test" ], mail.from
+      assert_equal [ "jo@acme.test" ], mail.to
+      assert_includes mail.body.decoded, "https://support.acme.test/reset-password?account=acme&token=reset999"
+    end
+  end
+
+  test "invitation sends accept-invitation link honoring HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM" do
