@@ -0,0 +1,1111 @@
+require "test_helper"
+
+class Api::V1::CursorPaginationTest < ActionDispatch::IntegrationTest
+  test "empty collection response format matches contract across collections" do
+    signup_and_verify!
+    owner_token = sign_in!(email: "jo@acme.test")["session"]["token"]
+
+    register_and_verify_customer!
+    customer_token = sign_in!(email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    expected_empty = lambda do |collection_key|
+      {
+        collection_key => [],
+        "meta" => {
+          "has_more" => false,
+          "after_cursor" => nil,
+          "before_cursor" => nil
+        },
+        "links" => {
+          "next" => nil,
+          "prev" => nil
+        }
+      }
+    end
+
+    get "/api/v1/tickets?page[size]=25&status=open", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal expected_empty.call("tickets"), json_body
+
+    get "/api/v1/requests?page[size]=25&status=open", headers: account_headers("acme", token: customer_token)
+    assert_response :ok
+    assert_equal expected_empty.call("requests"), json_body
+
+    get "/api/v1/groups?page[size]=25", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal expected_empty.call("groups"), json_body
+
+    get "/api/v1/group_memberships?page[size]=25", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal expected_empty.call("group_memberships"), json_body
+
+    get "/api/v1/invitations?page[size]=25", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal expected_empty.call("invitations"), json_body
+
+    get "/api/v1/users?page[size]=25&suspended=true", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal expected_empty.call("users"), json_body
+
+    # Empty comments on a ticket when customer sees no public comments
+    account = Account.find_by!(subdomain: "acme")
+    customer = account.users.find_by!(email: "avery@example.test")
+    owner = account.users.find_by!(email: "jo@acme.test")
+    ticket = account.tickets.create!(requester: customer, subject: "Quiet ticket")
+    Comment.create!(account: account, ticket: ticket, author: owner, body: "Internal only", public: false)
+
+    get "/api/v1/requests/#{ticket.id}/comments?page[size]=25", headers: account_headers("acme", token: customer_token)
+    assert_response :ok
+    assert_equal expected_empty.call("comments"), json_body
