diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..9b34e5c
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,135 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      before_action :resolve_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!
+
+      def index
+        relation = current_account.invitations.includes(:invited_by).ordered_by_id
+
+        if params.key?(:status) && params[:status].to_s.strip != ""
+          requested_status = params[:status].to_s.strip.downcase
+          unless Invitation::STATUSES.include?(requested_status)
+            render json: {
+              error: "Status is not included in the list",
+              errors: { status: [ "is not included in the list" ] }
+            }, status: :unprocessable_content
+            return
+          end
+          relation = relation.with_status(requested_status)
+        end
+
+        render_paginated(
+          relation,
+          key: :invitations,
+          order: CursorPaginator::ID_ASC,
+          scope_key: "invitations:#{current_account.id}"
+        ) { |invitation| serialize_invitation(invitation) }
+      end
+
+      def show
+        invitation = current_account.invitations.includes(:invited_by).find(params[:id])
+        render json: { invitation: serialize_invitation(invitation) }, status: :ok
+      end
+
+      def create
+        invitation_envelope = require_object_param(:invitation)
+        raw_email = invitation_envelope[:email]
+        raw_role = invitation_envelope[:role]
+
+        invitation = current_account.invitations.build(
+          invited_by: current_user,
+          email: raw_email.is_a?(String) ? raw_email : nil,
+          role: raw_role.is_a?(String) ? raw_role : nil
+        )
+        raw_token = invitation.assign_fresh_token!
+
+        created = false
+        current_account.with_lock do
+          invitation_valid = invitation.valid?
+
+          if raw_email.present? && !raw_email.is_a?(String)
+            invitation.errors.add(:email, "is invalid") unless invitation.errors[:email].include?("is invalid")
+            invitation_valid = false
+          end
+
+          if raw_role.present? && !raw_role.is_a?(String)
+            invitation.errors.add(:role, "is not included in the list") unless invitation.errors[:role].include?("is not included in the list")
+            invitation_valid = false
+          end
+
+          if invitation.email.present? && invitation.errors[:email].empty?
+            if current_account.users.exists?(email: invitation.email)
+              invitation.errors.add(:email, "has already been taken")
+              invitation_valid = false
+            elsif current_account.invitations.pending.exists?(email: invitation.email)
+              invitation.errors.add(:email, "already has a pending invitation")
+              invitation_valid = false
+            end
+          end
+
+          if invitation_valid
+            invitation.save!
+            created = true
+          end
+        end
+
+        unless created
+          render_validation_errors(invitation)
+          return
+        end
+
+        AuthMailer.invitation(invitation: invitation, token: raw_token).deliver_now
+
+        render json: { invitation: serialize_invitation(invitation) }, status: :created
+      end
+
+      def resend
+        invitation = nil
+        raw_token = nil
+        error_message = nil
+
+        current_account.with_lock do
+          invitation = current_account.invitations.includes(:invited_by).find(params[:id])
+          if invitation.pending?
+            raw_token = invitation.resend!
+          else
+            error_message = "Only pending invitations can be resent"
+          end
+        end
+
+        if error_message
+          render json: { error: error_message }, status: :unprocessable_content
+          return
+        end
+
+        AuthMailer.invitation(invitation: invitation, token: raw_token).deliver_now
+
+        render json: { invitation: serialize_invitation(invitation) }, status: :ok
+      end
+
+      def destroy
+        invitation = nil
+        error_message = nil
+
+        current_account.with_lock do
+          invitation = current_account.invitations.includes(:invited_by).find(params[:id])
+          if invitation.pending?
+            invitation.revoke!
+          else
+            error_message = "Only pending invitations can be revoked"
+          end
+        end
+
+        if error_message
+          render json: { error: error_message }, status: :unprocessable_content
+          return
+        end
+
+        render json: { invitation: serialize_invitation(invitation) }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..857f398
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,68 @@
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      before_action :resolve_account!
+      before_action :require_active_account!
+
+      def create
+        reset_params = require_object_param(:password_reset).permit(:email)
+        email = reset_params[:email].to_s.strip.downcase
+
+        if email.blank?
+          render json: {
+            error: "Email can't be blank",
+            errors: { email: [ "can't be blank" ] }
+          }, status: :unprocessable_content
+          return
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user.present?
+          token = UserToken.issue_for!(user: user, purpose: UserToken::PASSWORD_RESET)
+          AuthMailer.password_reset(user: user, token: token).deliver_now
+        end
+
+        render json: { message: "If an account exists for that email, a password reset link has been sent." }, status: :ok
+      end
+
+      def confirm
+        reset_params = require_object_param(:password_reset).permit(:token, :password, :password_confirmation)
+        raw_token = reset_params[:token].to_s
+
+        token_record = UserToken.find_valid(
+          account: current_account,
+          purpose: UserToken::PASSWORD_RESET,
+          raw_token: raw_token
+        )
+
+        if token_record.nil?
+          render json: { error: "Invalid or expired password reset token" }, status: :unprocessable_content
+          return
+        end
+
+        if reset_params[:password].blank?
+          render json: {
+            error: "Password can't be blank",
+            errors: { password: [ "can't be blank" ] }
+          }, status: :unprocessable_content
+          return
+        end
+
+        user = token_record.user
+        ActiveRecord::Base.transaction do
+          user.password = reset_params[:password]
+          if reset_params.key?(:password_confirmation)
+            user.password_confirmation = reset_params[:password_confirmation]
+          end
+          user.save!
+          user.user_tokens.for_purpose(UserToken::PASSWORD_RESET).delete_all
+          user.revoke_all_sessions!
+        end
+
+        render json: { message: "Password has been reset" }, status: :ok
+      rescue ActiveRecord::RecordInvalid
+        render_validation_errors(user)
+      end
+    end
+  end
+end
