@@ -0,0 +1,124 @@
+require "test_helper"
+
+class CursorPaginatorTest < ActiveSupport::TestCase
+  test "encode and decode round-trip preserves microsecond precision and integer ids" do
+    ts = Time.utc(2026, 11, 21, 14, 22, 33, 654321)
+    record = Ticket.new(id: 987_654, updated_at: ts, customer_updated_at: ts)
+
+    cursor = CursorPaginator.encode_cursor(record, order: CursorPaginator::UPDATED_AT_DESC, scope_key: "tickets:7")
+    assert_match(/\A[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\z/, cursor)
+
+    decoded = CursorPaginator.decode_cursor(cursor, order: CursorPaginator::UPDATED_AT_DESC, scope_key: "tickets:7")
+    assert_equal [ ts, 987_654 ], decoded
+    assert_equal 654321, decoded.first.usec
+    assert_equal "UTC", decoded.first.zone
+
+    id_cursor = CursorPaginator.encode_cursor(record, order: CursorPaginator::ID_ASC, scope_key: "groups:7")
+    assert_equal [ 987_654 ], CursorPaginator.decode_cursor(id_cursor, order: CursorPaginator::ID_ASC, scope_key: "groups:7")
+  end
+
+  test "decode rejects tampered, malformed, cross-scope, and invalid payload cursors" do
+    ts = Time.utc(2026, 11, 21, 14, 22, 33, 123456)
+    record = Ticket.new(id: 42, updated_at: ts)
+    valid = CursorPaginator.encode_cursor(record, order: CursorPaginator::UPDATED_AT_DESC, scope_key: "tickets:1")
+    payload_part, sig_part = valid.split(".")
+
+    tampered_char = sig_part[-1] == "A" ? "B" : "A"
+    tampered_sig = "#{payload_part}.#{sig_part[0..-2]}#{tampered_char}"
+    tampered_payload = "#{payload_part[0..-2]}#{payload_part[-1] == 'A' ? 'B' : 'A'}.#{sig_part}"
+
+    bad_cursors = [
+      nil,
+      "",
+      "not-a-cursor",
+      "123",
+      "#{payload_part}.",
+      ".#{sig_part}",
+      "#{payload_part}.#{sig_part}.extra",
+      "#{sig_part}.#{payload_part}",
+      tampered_sig,
+      tampered_payload,
+      " #{valid}",
+      "#{valid} ",
+      "#{valid}\x00",
+      "a" * 3000,
+      Base64.urlsafe_encode64('{"v":1,"s":"tickets:1","k":[42]}', padding: false) + ".fake"
+    ]
+
+    bad_cursors.each do |bad|
+      assert_raises(CursorPaginator::InvalidCursorError, "Expected InvalidCursorError for #{bad.inspect}") do
+        CursorPaginator.decode_cursor(bad, order: CursorPaginator::UPDATED_AT_DESC, scope_key: "tickets:1")
+      end
+    end
+
+    # Wrong scope_key
+    assert_raises(CursorPaginator::InvalidCursorError) do
+      CursorPaginator.decode_cursor(valid, order: CursorPaginator::UPDATED_AT_DESC, scope_key: "tickets:2")
+    end
+
+    # Wrong order spec arity/types
+    assert_raises(CursorPaginator::InvalidCursorError) do
+      CursorPaginator.decode_cursor(valid, order: CursorPaginator::ID_ASC, scope_key: "tickets:1")
+    end
+  end
+
+  test "cursor pagination executes no COUNT or OFFSET queries and uses keyset comparison" do
+    account = Account.create!(name: "SqlCheck", subdomain: "sqlcheck")
+    customer = account.users.create!(name: "Cust", email: "cust@sqlcheck.test", password: "password123", role: "customer")
+    base = Time.utc(2026, 11, 21, 10, 0, 0)
+
+    5.times do |i|
+      t = account.tickets.create!(requester: customer, subject: "T#{i + 1}")
+      t.update_columns(updated_at: base + i.seconds, customer_updated_at: base + i.seconds)
+    end
+
+    queries = []
+    callback = lambda do |_name, _start, _finish, _id, payload|
+      next if payload[:name] == "SCHEMA" || payload[:cached]
+      binds = payload[:type_casted_binds]
+      binds = binds.call if binds.respond_to?(:call)
+      queries << { sql: payload[:sql], binds: binds }
+    end
+
+    # Page 1 (initial): 1 query, no COUNT, no OFFSET
+    ActiveSupport::Notifications.subscribed(callback, "sql.active_record") do
+      @page1 = CursorPaginator.paginate(
+        relation: account.tickets.recently_active,
+        order: CursorPaginator::UPDATED_AT_DESC,
+        scope_key: "tickets:#{account.id}",
+        page_size: 2
+      )
+    end
+
+    assert_equal 1, queries.size
+    refute_match(/COUNT\(/i, queries.first[:sql])
+    refute_match(/OFFSET/i, queries.first[:sql])
+    assert_equal 3, queries.first[:binds].last
+    assert_equal true, @page1[:has_more]
+    assert_equal true, @page1[:has_next]
+    assert_equal false, @page1[:has_prev]
+
+    # Page 2 (after): 2 queries (page + adjacent LIMIT 1), no COUNT, no OFFSET
+    queries.clear
+    ActiveSupport::Notifications.subscribed(callback, "sql.active_record") do
+      @page2 = CursorPaginator.paginate(
+        relation: account.tickets.recently_active,
+        order: CursorPaginator::UPDATED_AT_DESC,
+        scope_key: "tickets:#{account.id}",
+        page_size: 2,
+        after: @page1[:after_cursor]
+      )
+    end
+
+    assert_equal 2, queries.size
+    queries.each do |q|
+      refute_match(/COUNT\(/i, q[:sql])
+      refute_match(/OFFSET/i, q[:sql])
+    end
+    assert_match(/\("tickets"\."updated_at", "tickets"\."id"\) </, queries.first[:sql])
+    assert_equal 3, queries.first[:binds].last
+    assert_match(/\("tickets"\."updated_at", "tickets"\."id"\) >/, queries.second[:sql])
+    assert_match(/LIMIT\b/i, queries.second[:sql])
+    assert_equal 1, queries.second[:binds].last
+  end
+end
