+  end
+
+  test "enforces validation atomicity, admin-only people management, multi-tenant isolation, and cancellation" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", email: "jo@shared.test")
+    signup_and_verify!(name: "Beta", subdomain: "beta", email: "jo@shared.test")
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    acme_admin_token = sign_in!(subdomain: "acme", email: "jo@shared.test")["session"]["token"]
+    beta_admin_token = sign_in!(subdomain: "beta", email: "jo@shared.test")["session"]["token"]
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    sam_data = invite_and_accept!(subdomain: "acme", admin_token: acme_admin_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_id = sam_data[:user]["id"]
+    sam_token = sign_in!(subdomain: "acme", email: "sam@example.test", password: "my-team-password")["session"]["token"]
+
+    # Invalid suspended type -> 422
+    [ "true", "false", nil, 1, [] ].each do |bad_val|
+      patch "/api/v1/users/#{sam_id}",
+        params: { user: { suspended: bad_val } },
+        headers: account_headers("acme", token: acme_admin_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 for suspended=#{bad_val.inspect}"
+      assert json_body["errors"]["suspended"].present?
+    end
+
+    # Atomic validation failure: blank name + suspended: true does NOT suspend or revoke Sam's session
+    patch "/api/v1/users/#{sam_id}",
+      params: { user: { name: "   ", suspended: true } },
+      headers: account_headers("acme", token: acme_admin_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["name"].present?
+
+    get "/api/v1/me", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_equal false, json_body["user"]["suspended"]
+
+    # Mass assignment of role/email ignored on PATCH /users/:id
+    patch "/api/v1/users/#{sam_id}",
+      params: { user: { name: "Sam Taylor", role: "admin", email: "hacked@example.test" } },
+      headers: account_headers("acme", token: acme_admin_token),
+      as: :json
+    assert_response :ok
+    assert_equal "Sam Taylor", json_body["user"]["name"]
+    assert_equal "agent", json_body["user"]["role"]
+    assert_equal "sam@example.test", json_body["user"]["email"]
+
+    # Agent cannot access /users endpoints (only admins manage people), CAN access /staff
+    get "/api/v1/users", headers: account_headers("acme", token: sam_token)
+    assert_response :forbidden
+    get "/api/v1/users/#{sam_id}", headers: account_headers("acme", token: sam_token)
+    assert_response :forbidden
+    patch "/api/v1/users/#{sam_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: sam_token),
+      as: :json
+    assert_response :forbidden
+    get "/api/v1/staff", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+
+    # Customer cannot access /users or /staff
+    get "/api/v1/users", headers: account_headers("acme", token: customer_token)
+    assert_response :forbidden
+    get "/api/v1/users/#{sam_id}", headers: account_headers("acme", token: customer_token)
+    assert_response :forbidden
+    patch "/api/v1/users/#{sam_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: customer_token),
+      as: :json
+    assert_response :forbidden
+    get "/api/v1/staff", headers: account_headers("acme", token: customer_token)
+    assert_response :forbidden
+
+    # Cross-tenant isolation: Beta admin cannot view or update Acme user
+    get "/api/v1/users/#{sam_id}", headers: account_headers("beta", token: beta_admin_token)
+    assert_response :not_found
+    patch "/api/v1/users/#{sam_id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("beta", token: beta_admin_token),
+      as: :json
+    assert_response :not_found
+
+    # Huge / nonexistent IDs -> 404
+    get "/api/v1/users/99999999999999999999999", headers: account_headers("acme", token: acme_admin_token)
+    assert_response :not_found
+
+    # Cancelled account blocks /users and /staff
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: acme_admin_token), as: :json
+    assert_response :ok
+    owner_cancelled_token = sign_in!(subdomain: "acme", email: "jo@shared.test")["session"]["token"]
+    get "/api/v1/users", headers: account_headers("acme", token: owner_cancelled_token)
+    assert_response :forbidden
+    get "/api/v1/staff", headers: account_headers("acme", token: owner_cancelled_token)
+    assert_response :forbidden
+  end
+end
diff --git a/test/lib/cursor_paginator_test.rb b/test/lib/cursor_paginator_test.rb
