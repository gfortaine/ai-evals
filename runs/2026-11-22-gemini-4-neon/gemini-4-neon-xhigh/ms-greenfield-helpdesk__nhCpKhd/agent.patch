diff --git a/test/integration/api/v1/account_cancellation_test.rb b/test/integration/api/v1/account_cancellation_test.rb
new file mode 100644
index 0000000..8ff4851
--- /dev/null
+++ b/test/integration/api/v1/account_cancellation_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+require "rake"
+
+class Api::V1::AccountCancellationTest < ActionDispatch::IntegrationTest
+  test "owner can cancel account, sessions are revoked, ordinary access stops, and owner can sign in to reactivate within 90 days" do
+    signup_and_verify!
+    account = Account.find_by!(subdomain: "acme")
+
+    # Add a second verified non-owner user (e.g. an agent)
+    agent = account.users.create!(
+      name: "Alex Agent",
+      email: "alex@acme.test",
+      password: "agent-password-1",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+
+    owner_token1 = sign_in!(email: "jo@acme.test", password: "my-first-password")["session"]["token"]
+    owner_token2 = sign_in!(email: "jo@acme.test", password: "my-first-password")["session"]["token"]
+    agent_token = sign_in!(email: "alex@acme.test", password: "agent-password-1")["session"]["token"]
+
+    # Non-owner cannot cancel
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: agent_token), as: :json
+    assert_response :forbidden
+
+    # Reactivate when active fails with 422
+    post "/api/v1/account/reactivate", headers: account_headers("acme", token: owner_token1), as: :json
+    assert_response :unprocessable_content
+
+    # Owner cancels account
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: owner_token1), as: :json
+    assert_response :ok
+    assert_equal "cancelled", json_body["account"]["status"]
+    assert json_body["account"]["cancelled_at"].present?
+
+    # All prior sessions are revoked
+    get "/api/v1/me", headers: account_headers("acme", token: owner_token1)
+    assert_response :unauthorized
+    get "/api/v1/account", headers: account_headers("acme", token: owner_token2)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers("acme", token: agent_token)
+    assert_response :unauthorized
+
+    # Ordinary public access stops
+    get "/api/v1/portal", headers: account_headers("acme")
+    assert_response :forbidden
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Non-owner cannot sign in while cancelled
+    post "/api/v1/sessions",
+      params: { session: { email: agent.email, password: "agent-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Owner CAN still sign in while cancelled
+    owner_cancelled_login = sign_in!(email: "jo@acme.test", password: "my-first-password")
+    reactivate_token = owner_cancelled_login["session"]["token"]
+    assert_equal "cancelled", owner_cancelled_login["account"]["status"]
+
+    # Even with valid owner token, ordinary business endpoints remain blocked while cancelled
+    get "/api/v1/account", headers: account_headers("acme", token: reactivate_token)
+    assert_response :forbidden
+    get "/api/v1/me", headers: account_headers("acme", token: reactivate_token)
+    assert_response :forbidden
+    patch "/api/v1/me",
+      params: { user: { name: "Blocked Name" } },
+      headers: account_headers("acme", token: reactivate_token),
+      as: :json
+    assert_response :forbidden
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: reactivate_token),
+      as: :json
+    assert_response :forbidden
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: reactivate_token), as: :json
+    assert_response :forbidden
+
+    # Owner can sign out while cancelled
+    temp_token = sign_in!(email: "jo@acme.test", password: "my-first-password")["session"]["token"]
+    delete "/api/v1/session", headers: account_headers("acme", token: temp_token)
+    assert_response :no_content
+
+    # Travel 89 days forward (still within 90 days) and reactivate
+    travel 89.days do
+      post "/api/v1/account/reactivate", headers: account_headers("acme", token: reactivate_token), as: :json
+      assert_response :ok
+      assert_equal "active", json_body["account"]["status"]
+      assert_nil json_body["account"]["cancelled_at"]
+
+      # Ordinary business access is restored immediately
+      get "/api/v1/portal", headers: account_headers("acme")
+      assert_response :ok
+      get "/api/v1/account", headers: account_headers("acme", token: reactivate_token)
+      assert_response :ok
+      get "/api/v1/me", headers: account_headers("acme", token: reactivate_token)
+      assert_response :ok
+    end
+  end
+
+  test "owner cannot reactivate account after 90 days and purge task permanently deletes it" do
+    signup_and_verify!(name: "Expired Co", subdomain: "expired", email: "jo@expired.test")
+    signup_and_verify!(name: "Recent Co", subdomain: "recent", email: "jo@recent.test")
+    signup_and_verify!(name: "Active Co", subdomain: "active", email: "jo@active.test")
+
+    expired_token = sign_in!(subdomain: "expired", email: "jo@expired.test")["session"]["token"]
+    post "/api/v1/account/cancel", headers: account_headers("expired", token: expired_token), as: :json
+    assert_response :ok
+
+    recent_token = sign_in!(subdomain: "recent", email: "jo@recent.test")["session"]["token"]
+    post "/api/v1/account/cancel", headers: account_headers("recent", token: recent_token), as: :json
+    assert_response :ok
+
+    expired_account = Account.find_by!(subdomain: "expired")
+    recent_account = Account.find_by!(subdomain: "recent")
+    active_account = Account.find_by!(subdomain: "active")
+
+    expired_account.update!(cancelled_at: 91.days.ago)
+    recent_account.update!(cancelled_at: 89.days.ago)
+
+    # Owner signs in on expired account, but reactivation is refused after 90 days
+    login_after_90 = sign_in!(subdomain: "expired", email: "jo@expired.test")
+    post "/api/v1/account/reactivate",
+      headers: account_headers("expired", token: login_after_90["session"]["token"]),
+      as: :json
+    assert_response :unprocessable_content
+    assert expired_account.reload.cancelled?
+
+    # Run rake task helpdesk:purge_cancelled_accounts
+    Rails.application.load_tasks if Rake::Task.tasks.empty?
+    Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+    assert_output(/Purged 1 cancelled account\(s\)\./) do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+    end
+
+    assert_not Account.exists?(expired_account.id)
+    assert_equal 0, User.where(account_id: expired_account.id).count
+    assert_equal 0, Session.where(account_id: expired_account.id).count
+    assert_equal 0, UserToken.where(account_id: expired_account.id).count
+
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+
+    get "/api/v1/portal", headers: account_headers("expired")
+    assert_response :not_found
+  end
+end
diff --git a/test/integration/api/v1/auth_and_sessions_test.rb b/test/integration/api/v1/auth_and_sessions_test.rb
new file mode 100644
index 0000000..21a0efb
--- /dev/null
+++ b/test/integration/api/v1/auth_and_sessions_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+class Api::V1::AuthAndSessionsTest < ActionDispatch::IntegrationTest
+  test "unverified admin cannot sign in; resending verification link replaces old link" do
+    signup_account
+    assert_response :created
+    first_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    # Wrong password returns 401 (does not leak verification state)
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "wrong-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    # Correct password still blocked while unverified
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Request a new verification link
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    second_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+    assert_not_equal first_token, second_token
+
+    # Old token no longer works
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: first_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # New token verifies the user
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: second_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body["user"]["verified"]
+    assert json_body["user"]["email_verified_at"].present?
+
+    # Replaying verified token fails
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: second_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Resending verification for already-verified or unknown email returns 200 and sends no mail
+    count_before = ActionMailer::Base.deliveries.size
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "nobody@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal count_before, ActionMailer::Base.deliveries.size
+  end
+
+  test "sign in, account access, profile update, and single-session sign out" do
+    signup_and_verify!
+
+    login1 = sign_in!
+    token1 = login1["session"]["token"]
+    assert token1.present?
+    assert_equal "jo@acme.test", login1["user"]["email"]
+    assert_equal true, login1["user"]["verified"]
+    assert_equal "admin", login1["user"]["role"]
+    assert_equal "acme", login1["account"]["subdomain"]
+    assert login1["account"]["id"].is_a?(Integer)
+
+    login2 = sign_in!
+    token2 = login2["session"]["token"]
+    assert_not_equal token1, token2
+
+    # Unauthenticated GET /account and GET /me fail with 401
+    get "/api/v1/account", headers: account_headers("acme")
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers("acme", token: "bogus")
+    assert_response :unauthorized
+
+    # Authenticated GET /account returns full account
+    get "/api/v1/account", headers: account_headers("acme", token: token1)
+    assert_response :ok
+    assert_equal "Acme", json_body["account"]["name"]
+    assert_equal "acme", json_body["account"]["subdomain"]
+    assert json_body["account"]["id"].is_a?(Integer)
+    assert json_body["account"]["created_at"].present?
+
+    # GET /me and PATCH /me
+    get "/api/v1/me", headers: account_headers("acme", token: token1)
+    assert_response :ok
+    assert_equal "Jo", json_body["user"]["name"]
+
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Smith", role: "customer", email: "hacked@acme.test" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :ok
+    assert_equal "Jo Smith", json_body["user"]["name"]
+    assert_equal "admin", json_body["user"]["role"]
+    assert_equal "jo@acme.test", json_body["user"]["email"]
+
+    # Blank name rejected
+    patch "/api/v1/me",
+      params: { user: { name: "   " } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :unprocessable_content
+
+    # DELETE /session signs out ONLY token1, keeping token2 active
+    delete "/api/v1/session", headers: account_headers("acme", token: token1)
+    assert_response :no_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: token1)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: account_headers("acme", token: token2)
+    assert_response :ok
+    assert_equal "Jo Smith", json_body["user"]["name"]
+  end
+
+  test "strict multi-tenant isolation for sessions and verification tokens" do
+    signup_account(name: "Acme", subdomain: "acme", admin_name: "Jo Acme", email: "jo@shared.test", password: "acme-password-1")
+    acme_verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    signup_account(name: "Beta", subdomain: "beta", admin_name: "Jo Beta", email: "jo@shared.test", password: "beta-password-2")
+    beta_verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    # Acme verification token fails under Beta tenant
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: acme_verify_token } },
+      headers: account_headers("beta"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Verify both properly under their own tenants
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: acme_verify_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: beta_verify_token } },
+      headers: account_headers("beta"),
+      as: :json
+    assert_response :ok
+
+    # Sign into Acme (Beta password fails under Acme)
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@shared.test", password: "beta-password-2" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    acme_token = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "acme-password-1")["session"]["token"]
+    beta_token = sign_in!(subdomain: "beta", email: "jo@shared.test", password: "beta-password-2")["session"]["token"]
+
+    # Acme bearer token rejected on Beta
+    get "/api/v1/me", headers: account_headers("beta", token: acme_token)
+    assert_response :unauthorized
+    get "/api/v1/account", headers: account_headers("beta", token: acme_token)
+    assert_response :unauthorized
+
+    # Beta bearer token works on Beta
+    get "/api/v1/me", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+    assert_equal "Jo Beta", json_body["user"]["name"]
+  end
+end
diff --git a/test/integration/api/v1/cors_test.rb b/test/integration/api/v1/cors_test.rb
new file mode 100644
index 0000000..5e37815
--- /dev/null
+++ b/test/integration/api/v1/cors_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Api::V1::CorsTest < ActionDispatch::IntegrationTest
+  test "allows preflight and actual requests from default frontend origin http://localhost:3001" do
+    with_env("HELPDESK_FRONTEND_URL" => nil) do
+      signup_account
+
+      process :options, "/api/v1/sessions",
+        headers: {
+          "Origin" => "http://localhost:3001",
+          "Access-Control-Request-Method" => "POST",
+          "Access-Control-Request-Headers" => "content-type, authorization, x-helpdesk-account"
+        }
+      assert_response :no_content
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+      assert_includes response.headers["Access-Control-Allow-Methods"], "POST"
+      assert_includes response.headers["Access-Control-Allow-Methods"], "DELETE"
+      assert_includes response.headers["Access-Control-Allow-Methods"], "PATCH"
+      assert_includes response.headers["Access-Control-Allow-Methods"], "PUT"
+      allow_headers = response.headers["Access-Control-Allow-Headers"].downcase
+      assert_includes allow_headers, "authorization"
+      assert_includes allow_headers, "content-type"
+      assert_includes allow_headers, "x-helpdesk-account"
+      assert_includes response.headers["Vary"], "Origin"
+
+      get "/api/v1/portal", headers: account_headers("acme", extra: { "Origin" => "http://localhost:3001" })
+      assert_response :ok
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+      assert_includes response.headers["Vary"], "Origin"
+
+      # Error responses also carry CORS header for allowed origin
+      get "/api/v1/portal", headers: account_headers("unknown", extra: { "Origin" => "http://localhost:3001" })
+      assert_response :not_found
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+
+  test "blocks disallowed origins and honors configured HELPDESK_FRONTEND_URL" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://app.helpdesk.test/subpath/") do
+      signup_account
+
+      # Disallowed origin on preflight
+      process :options, "/api/v1/sessions",
+        headers: {
+          "Origin" => "http://localhost:3001",
+          "Access-Control-Request-Method" => "POST"
+        }
+      assert_response :forbidden
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+
+      # Disallowed origin on actual request
+      get "/api/v1/portal", headers: account_headers("acme", extra: { "Origin" => "https://evil.example" })
+      assert_response :ok
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+
+      # Configured origin allowed (normalized without path/trailing slash)
+      process :options, "/api/v1/me",
+        headers: {
+          "Origin" => "https://app.helpdesk.test",
+          "Access-Control-Request-Method" => "PATCH"
+        }
+      assert_response :no_content
+      assert_equal "https://app.helpdesk.test", response.headers["Access-Control-Allow-Origin"]
+
+      get "/api/v1/portal", headers: account_headers("acme", extra: { "Origin" => "https://app.helpdesk.test" })
+      assert_response :ok
+      assert_equal "https://app.helpdesk.test", response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+end
diff --git a/test/integration/api/v1/cursor_pagination_test.rb b/test/integration/api/v1/cursor_pagination_test.rb
