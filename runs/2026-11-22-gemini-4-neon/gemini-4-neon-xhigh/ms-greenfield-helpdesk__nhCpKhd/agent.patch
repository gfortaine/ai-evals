+
+  test "malformed JSON returns 400 JSON and unknown route returns 404 JSON" do
+    post "/api/v1/account/create",
+      params: "{invalid json",
+      headers: { "CONTENT_TYPE" => "application/json", "ACCEPT" => "*/*" }
+    assert_response :bad_request
+    assert_includes response.content_type, "application/json"
+    assert json_body["error"].present?
+
+    get "/api/v1/nonexistent"
+    assert_response :not_found
+    assert_includes response.content_type, "application/json"
+    assert json_body["error"].present?
+  end
+
+  test "GET /api/v1/portal returns public name and subdomain for tenant header" do
+    signup_account(name: "Acme", subdomain: "acme")
+    assert_response :created
+
+    get "/api/v1/portal", headers: account_headers("acme")
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_body)
+
+    get "/api/v1/portal", headers: account_headers("ACME")
+    assert_response :ok
+    assert_equal "acme", json_body["portal"]["subdomain"]
+
+    get "/api/v1/portal"
+    assert_response :bad_request
+
+    get "/api/v1/portal", headers: account_headers("missing")
+    assert_response :not_found
+  end
+end
