+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    base = Time.zone.parse("2026-09-04 10:00:00 UTC")
+    ids = {}
+    %i[a b c d].each_with_index do |key, i|
+      travel_to base + i.minutes do
+        post "/api/v1/requests",
+          params: { request: { subject: "Ticket #{key.upcase}", comment: { body: "Body #{key.upcase}" } } },
+          headers: account_headers("acme", token: avery_token),
+          as: :json
+        assert_response :created
+        ids[key] = json_body["request"]["id"]
+      end
+    end
+
+    # 1. Merge A into B
+    travel_to base + 10.minutes do
+      post "/api/v1/tickets/#{ids[:a]}/merge",
+        params: { merge: { target_id: ids[:b] } },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :ok
+    end
+
+    a_after_first_merge = Ticket.find(ids[:a])
+    a_updated_at = a_after_first_merge.updated_at
+    a_comments_count = a_after_first_merge.comments.count
+
+    # 2. Later merge surviving B into C -> A must STILL point to B!
+    travel_to base + 20.minutes do
+      post "/api/v1/tickets/#{ids[:b]}/merge",
+        params: { merge: { target_id: ids[:c] } },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :ok
+      assert_equal "closed", json_body["source"]["status"]
+      assert_equal ids[:c], json_body["source"]["merged_into_id"]
+      assert_equal "open", json_body["target"]["status"]
+      assert_nil json_body["target"]["merged_into_id"]
+    end
+
+    # 3. Also merge D into C (multiple tickets into same surviving ticket)
+    travel_to base + 25.minutes do
+      post "/api/v1/tickets/#{ids[:d]}/merge",
+        params: { merge: { target_id: ids[:c] } },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :ok
+    end
+
+    # Verify original link A -> B was NOT rewritten to C, and A was untouched
+    a_final = Ticket.find(ids[:a])
+    assert_equal ids[:b], a_final.merged_into_id
+    assert_equal "closed", a_final.status
+    assert_equal a_updated_at, a_final.updated_at
+    assert_equal a_comments_count, a_final.comments.count
+
+    # Staff view shows exact chain: A -> B -> C -> null, D -> C
+    {
+      a: [ "closed", ids[:b] ],
+      b: [ "closed", ids[:c] ],
+      d: [ "closed", ids[:c] ],
+      c: [ "open", nil ]
+    }.each do |key, (expected_status, expected_merged_into)|
+      get "/api/v1/tickets/#{ids[key]}", headers: account_headers("acme", token: jo_token)
+      assert_response :ok
+      assert_equal expected_status, json_body["ticket"]["status"]
+      if expected_merged_into.nil?
+        assert json_body["ticket"].key?("merged_into_id")
+        assert_nil json_body["ticket"]["merged_into_id"]
+      else
+        assert_equal expected_merged_into, json_body["ticket"]["merged_into_id"]
+      end
+
+      get "/api/v1/requests/#{ids[key]}", headers: account_headers("acme", token: avery_token)
+      assert_response :ok
+      assert_equal expected_status, json_body["request"]["status"]
+      if expected_merged_into.nil?
+        assert json_body["request"].key?("merged_into_id")
+        assert_nil json_body["request"]["merged_into_id"]
+      else
+        assert_equal expected_merged_into, json_body["request"]["merged_into_id"]
+      end
+    end
+
+    # Cannot merge into B now that B is closed, nor merge already-closed A into C
+    post "/api/v1/tickets/#{ids[:c]}/merge",
+      params: { merge: { target_id: ids[:b] } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["target_id"].present?
+
+    post "/api/v1/tickets/#{ids[:a]}/merge",
+      params: { merge: { target_id: ids[:c] } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["status"].present?
+  end
