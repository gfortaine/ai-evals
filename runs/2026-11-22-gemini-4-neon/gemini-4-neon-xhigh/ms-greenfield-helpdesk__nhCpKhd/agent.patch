+++ b/app/mailers/auth_mailer.rb
@@ -0,0 +1,34 @@
+class AuthMailer < ApplicationMailer
+  def email_verification(user:, token:)
+    @user = user
+    @account = user.account
+    @verification_url = HelpdeskConfig.verification_url(account: @account, token: token)
+
+    mail(
+      to: @user.email,
+      subject: "Verify your email for #{@account.name}"
+    )
+  end
+
+  def password_reset(user:, token:)
+    @user = user
+    @account = user.account
+    @reset_url = HelpdeskConfig.password_reset_url(account: @account, token: token)
+
+    mail(
+      to: @user.email,
+      subject: "Reset your password for #{@account.name}"
+    )
+  end
+
+  def invitation(invitation:, token:)
+    @invitation = invitation
+    @account = invitation.account
+    @invitation_url = HelpdeskConfig.invitation_url(account: @account, token: token)
+
+    mail(
+      to: @invitation.email,
+      subject: "You have been invited to join #{@account.name}"
+    )
+  end
+end
diff --git a/app/mailers/ticket_mailer.rb b/app/mailers/ticket_mailer.rb
new file mode 100644
index 0000000..40fc3c1
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,40 @@
+class TicketMailer < ApplicationMailer
+  def staff_reply(ticket:, comment:)
+    @ticket = ticket
+    @account = ticket.account
+    @comment = comment
+    @requester = ticket.requester
+    @author = comment.author
+
+    references = ticket.comments
+      .where.not(inbound_message_id: nil)
+      .chronological
+      .pluck(:inbound_message_id)
+      .map { |id| format_message_id_header(id) }
+      .compact
+
+    if references.any?
+      headers["In-Reply-To"] = references.last
+      headers["References"] = references.join(" ")
+    end
+
+    mail(
+      to: @requester.email,
+      reply_to: @ticket.reply_address,
+      subject: reply_subject(@ticket.subject)
+    )
+  end
+
+  private
+
+  def reply_subject(subject)
+    subject.match?(/\ARe:/i) ? subject : "Re: #{subject}"
+  end
+
+  def format_message_id_header(message_id)
+    cleaned = message_id.to_s.strip.delete_prefix("<").delete_suffix(">").strip
+    return nil if cleaned.empty? || cleaned.match?(/\s/) || !cleaned.include?("@")
+
+    "<#{cleaned}>"
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..9c8da2f
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,87 @@
+class Account < ApplicationRecord
+  CANCELLED_RETENTION_PERIOD = 90.days
+  SUBDOMAIN_FORMAT = /\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/
+
+  belongs_to :owner, class_name: "User", optional: true
+  has_many :comments, dependent: :delete_all
+  has_many :tickets, dependent: :delete_all
+  has_many :group_memberships, dependent: :delete_all
+  has_many :groups, dependent: :delete_all
+  has_many :invitations, dependent: :delete_all
+  has_many :sessions, dependent: :delete_all
+  has_many :user_tokens, dependent: :delete_all
+  has_many :users, dependent: :destroy
+
+  normalizes :name, with: ->(value) { value.strip }
+  normalizes :subdomain, with: ->(value) { value.strip.downcase }
+
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :subdomain,
+    presence: true,
+    uniqueness: { case_sensitive: false },
+    format: {
+      with: SUBDOMAIN_FORMAT,
+      message: "must contain only lowercase letters, numbers, and hyphens, and cannot start or end with a hyphen"
+    }
+  validate :owner_belongs_to_account
+
+  before_destroy :clear_owner_reference
+
+  scope :active, -> { where(cancelled_at: nil) }
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+  scope :purgeable, ->(as_of = Time.current) { cancelled.where("cancelled_at <= ?", as_of - CANCELLED_RETENTION_PERIOD) }
+
+  def self.purge_cancelled!(as_of = Time.current)
+    purged_count = 0
+    purgeable(as_of).find_each do |account|
+      account.destroy!
+      purged_count += 1
+    end
+    purged_count
+  end
+
+  def active?
+    cancelled_at.nil?
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def owner?(user)
+    user.present? && owner_id.present? && owner_id == user.id
+  end
+
+  def reactivatable?(as_of = Time.current)
+    cancelled? && cancelled_at > as_of - CANCELLED_RETENTION_PERIOD
+  end
+
+  def support_address
+    HelpdeskConfig.support_address(self)
+  end
+
+  def cancel!
+    transaction do
+      update!(cancelled_at: Time.current)
+      sessions.delete_all
+    end
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+
+  private
+
+  def clear_owner_reference
+    update_column(:owner_id, nil) if persisted? && owner_id.present?
+  end
+
+  def owner_belongs_to_account
+    return if owner.nil? || id.nil?
+
+    if owner.account_id != id
+      errors.add(:owner, "must belong to this account")
+    end
+  end
+end
