+
+    # Cross-tenant isolation: Beta admin cannot see, resend, or revoke Acme invitation
+    get "/api/v1/invitations", headers: account_headers("beta", token: beta_admin_token)
+    assert_response :ok
+    assert_equal [], json_body["invitations"]
+
+    get "/api/v1/invitations/#{inv_id}", headers: account_headers("beta", token: beta_admin_token)
+    assert_response :not_found
+    post "/api/v1/invitations/#{inv_id}/resend", headers: account_headers("beta", token: beta_admin_token), as: :json
+    assert_response :not_found
+    delete "/api/v1/invitations/#{inv_id}", headers: account_headers("beta", token: beta_admin_token)
+    assert_response :not_found
+
+    # Cross-tenant preview and acceptance rejected
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: inv_token } },
+      headers: account_headers("beta"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: inv_token, name: "Wrong Tenant", password: "my-team-password" } },
+      headers: account_headers("beta"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Cancelled account blocks invitation preview, acceptance, and management
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: acme_admin_token), as: :json
+    assert_response :ok
+
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: inv_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: inv_token, name: "Blocked", password: "my-team-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    owner_cancelled_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    get "/api/v1/invitations", headers: account_headers("acme", token: owner_cancelled_token)
+    assert_response :forbidden
+  end
+end
diff --git a/test/integration/api/v1/passwords_and_resets_test.rb b/test/integration/api/v1/passwords_and_resets_test.rb
new file mode 100644
index 0000000..86bb502
--- /dev/null
+++ b/test/integration/api/v1/passwords_and_resets_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class Api::V1::PasswordsAndResetsTest < ActionDispatch::IntegrationTest
+  test "PUT /api/v1/me/password validates current_password, updates password, and signs out all existing sessions" do
+    signup_and_verify!
+    token1 = sign_in!["session"]["token"]
+    token2 = sign_in!["session"]["token"]
+
+    # Wrong current password fails and leaves sessions intact
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: token1)
+    assert_response :ok
+
+    # Blank or too-short new password fails and leaves sessions intact
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :unprocessable_content
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "short" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: token2)
+    assert_response :ok
+
+    # Valid password change succeeds and signs out ALL existing sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("acme", token: token1)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers("acme", token: token2)
+    assert_response :unauthorized
+
+    # Old password no longer signs in
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    # New password works
+    new_login = sign_in!(password: "my-new-password")
+    assert new_login["session"]["token"].present?
+  end
+
+  test "password reset flow replaces old links, enforces tenant/purpose isolation, and revokes existing sessions" do
+    signup_and_verify!
+    signup_and_verify!(name: "Beta", subdomain: "beta", admin_name: "Bea", email: "jo@acme.test", password: "beta-password-1")
+
+    existing_token = sign_in!(subdomain: "acme")["session"]["token"]
+    beta_token = sign_in!(subdomain: "beta", email: "jo@acme.test", password: "beta-password-1")["session"]["token"]
+
+    ActionMailer::Base.deliveries.clear
+
+    # Unknown email returns 200 without sending email
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "nobody@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Request first reset link with custom frontend URL and mail sender
+    with_env("HELPDESK_FRONTEND_URL" => "https://help.example.test", "HELPDESK_MAIL_FROM" => "mailer@help.example.test") do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "jo@acme.test" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+    end
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail1 = ActionMailer::Base.deliveries.last
+    assert_equal [ "mailer@help.example.test" ], mail1.from
+    reset_token1 = extract_token_from_mail(mail1, path: "/reset-password")[:token]
+    assert_includes mail1.body.decoded, "https://help.example.test/reset-password?account=acme&token=#{reset_token1}"
+
+    # Request second reset link; replaces first
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    reset_token2 = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+    assert_not_equal reset_token1, reset_token2
+
+    # First token is rejected
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token1, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Second token rejected under wrong tenant (Beta)
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token2, password: "my-new-password" } },
+      headers: account_headers("beta"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Invalid password does not consume valid reset token
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token2, password: "short" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Confirming with valid token and password succeeds and signs out existing sessions in Acme only
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token2, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    # Replay fails
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token2, password: "another-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Existing Acme session is revoked; Beta session unaffected
+    get "/api/v1/me", headers: account_headers("acme", token: existing_token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+
+    # Can sign into Acme with new password
+    sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+  end
+
+  test "email verification token cannot be used for password reset and vice versa" do
+    signup_account
+    verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: verify_token, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: reset_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Password reset for unverified user changes password but does not bypass email verification
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+  end
+end
diff --git a/test/integration/api/v1/requests_and_tickets_test.rb b/test/integration/api/v1/requests_and_tickets_test.rb
new file mode 100644
index 0000000..f8d5bee
--- /dev/null
+++ b/test/integration/api/v1/requests_and_tickets_test.rb
@@ -0,0 +1,719 @@
+require "test_helper"
+
+class Api::V1::RequestsAndTicketsTest < ActionDispatch::IntegrationTest
+  test "full portal conversation flow between customer and staff without sending email on requests or replies" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    customer_data = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    customer_id = customer_data["user"]["id"]
+
+    owner_login = sign_in!(subdomain: "acme", email: "jo@acme.test")
+    owner_token = owner_login["session"]["token"]
+    owner_id = owner_login["user"]["id"]
+
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    ActionMailer::Base.deliveries.clear
+
+    # Customer opens a request
+    post "/api/v1/requests",
+      params: {
+        request: {
+          subject: "Cannot download my receipt",
+          comment: { body: "The download button does nothing." }
+        }
+      },
+      headers: account_headers("acme", token: customer_token),
+      as: :json
+    assert_response :created
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    req = json_body["request"]
+    ticket_id = req["id"]
+    assert ticket_id.is_a?(Integer)
+    assert_equal "Cannot download my receipt", req["subject"]
+    assert_equal "open", req["status"]
+    assert_equal customer_id, req["requester_id"]
+    assert req["created_at"].present?
+    assert req["updated_at"].present?
+    assert_not req.key?("requester")
+
+    # Customer lists own requests, views one, reads its comments
+    get "/api/v1/requests", headers: account_headers("acme", token: customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["requests"].size
+    assert_equal ticket_id, json_body["requests"].first["id"]
+    assert_equal 1, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    get "/api/v1/requests/#{ticket_id}", headers: account_headers("acme", token: customer_token)
+    assert_response :ok
+    assert_equal ticket_id, json_body["request"]["id"]
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: account_headers("acme", token: customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["comments"].size
+    first_comment = json_body["comments"].first
+    assert_equal "The download button does nothing.", first_comment["body"]
+    assert_equal true, first_comment["public"]
+    assert_equal({ "id" => customer_id, "name" => "Avery" }, first_comment["author"])
+    assert first_comment["created_at"].present?
+    assert_equal 1, json_body["count"]
+
+    # Staff views ticket list and ticket detail with requester info
+    get "/api/v1/tickets", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["tickets"].size
+    staff_ticket = json_body["tickets"].first
+    assert_equal ticket_id, staff_ticket["id"]
+    assert_equal "Cannot download my receipt", staff_ticket["subject"]
+    assert_equal "open", staff_ticket["status"]
+    assert_equal({ "id" => customer_id, "name" => "Avery", "email" => "avery@example.test" }, staff_ticket["requester"])
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal({ "id" => customer_id, "name" => "Avery", "email" => "avery@example.test" }, json_body["ticket"]["requester"])
+
+    # Staff answers and marks ticket pending
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: {
+        ticket: {
+          comment: { body: "Please try again now." },
+          status: "pending"
+        }
+      },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "pending", json_body["ticket"]["status"]
+    assert_equal({ "id" => customer_id, "name" => "Avery", "email" => "avery@example.test" }, json_body["ticket"]["requester"])
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Staff reply by itself does NOT change status (remains pending)
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: { body: "Let us know if you need anything else." } } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "pending", json_body["ticket"]["status"]
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Customer replies to pending request -> reopens to open
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "Still does not work in Firefox." } } },
+      headers: account_headers("acme", token: customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "open", json_body["request"]["status"]
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Staff marks solved
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: {
+        ticket: {
+          comment: { body: "Fixed a Firefox issue, please retry." },
+          status: "solved"
+        }
+      },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body["ticket"]["status"]
+
+    # Staff reply on solved ticket does NOT reopen it
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: { body: "Added a note to your account too." } } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body["ticket"]["status"]
+
+    # Customer replies to solved request -> reopens to open
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "One more question about VAT." } } },
+      headers: account_headers("acme", token: customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "open", json_body["request"]["status"]
+
+    # Staff sets pending without comment
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "pending" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "pending", json_body["ticket"]["status"]
+
+    # Customer replies AND marks solved in the same update -> becomes solved (does not reopen!)
+    patch "/api/v1/requests/#{ticket_id}",
+      params: {
+        request: {
+          comment: { body: "Found it, thanks!" },
+          status: "solved"
+        }
+      },
+      headers: account_headers("acme", token: customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body["request"]["status"]
+
+    # Customer replies to solved request AND marks solved -> stays solved
+    patch "/api/v1/requests/#{ticket_id}",
+      params: {
+        request: {
+          comment: { body: "Appreciate the fast help!" },
+          status: "solved"
+        }
+      },
+      headers: account_headers("acme", token: customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body["request"]["status"]
+
+    # Comments are oldest first and match on both customer and staff endpoints
+    expected_bodies = [
+      "The download button does nothing.",
+      "Please try again now.",
+      "Let us know if you need anything else.",
+      "Still does not work in Firefox.",
+      "Fixed a Firefox issue, please retry.",
+      "Added a note to your account too.",
+      "One more question about VAT.",
+      "Found it, thanks!",
+      "Appreciate the fast help!"
+    ]
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: account_headers("acme", token: customer_token)
+    assert_response :ok
+    assert_equal expected_bodies, json_body["comments"].map { |c| c["body"] }
+    assert_equal expected_bodies.size, json_body["count"]
+    assert_equal({ "id" => owner_id, "name" => "Jo" }, json_body["comments"][1]["author"])
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal expected_bodies, json_body["comments"].map { |c| c["body"] }
+
+    # Still zero emails sent for the entire conversation
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
+
+  test "customer can mark solved without comment and staff can choose any valid status including agents" do
+    signup_and_verify!
+    account = Account.find_by!(subdomain: "acme")
+    agent = account.users.create!(
+      name: "Alex Agent",
+      email: "alex@acme.test",
+      password: "agent-password-1",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+    register_and_verify_customer!
+
+    agent_token = sign_in!(email: agent.email, password: "agent-password-1")["session"]["token"]
+    customer_token = sign_in!(email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Quick question", comment: { body: "Hello" } } },
+      headers: account_headers("acme", token: customer_token),
+      as: :json
+    assert_response :created
+    ticket_id = json_body["request"]["id"]
+
+    # Agent can view, reply, and transition between open, pending, solved
+    get "/api/v1/tickets", headers: account_headers("acme", token: agent_token)
+    assert_response :ok
+    assert_equal [ ticket_id ], json_body["tickets"].map { |t| t["id"] }
+
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "pending", comment: { body: "Agent reply" } } },
+      headers: account_headers("acme", token: agent_token),
+      as: :json
+    assert_response :ok
+    assert_equal "pending", json_body["ticket"]["status"]
+
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "open" } },
+      headers: account_headers("acme", token: agent_token),
+      as: :json
+    assert_response :ok
+    assert_equal "open", json_body["ticket"]["status"]
+
+    # Customer can mark solved without adding a comment
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { status: "solved" } },
+      headers: account_headers("acme", token: customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body["request"]["status"]
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: account_headers("acme", token: agent_token)
+    assert_response :ok
+    assert_equal [ "Hello", "Agent reply" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal({ "id" => agent.id, "name" => "Alex Agent" }, json_body["comments"][1]["author"])
+  end
+
+  test "authorization and multi-tenant isolation are enforced for requests and tickets" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    signup_and_verify!(name: "Beta", subdomain: "beta", email: "jo@beta.test")
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    register_and_verify_customer!(subdomain: "acme", name: "Blake", email: "blake@example.test")
+    register_and_verify_customer!(subdomain: "beta", name: "Casey", email: "casey@example.test")
+
+    acme_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    beta_owner_token = sign_in!(subdomain: "beta", email: "jo@beta.test")["session"]["token"]
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")["session"]["token"]
+    blake_token = sign_in!(subdomain: "acme", email: "blake@example.test", password: "my-customer-password")["session"]["token"]
+    casey_token = sign_in!(subdomain: "beta", email: "casey@example.test", password: "my-customer-password")["session"]["token"]
+
+    # Unauthenticated requests return 401
+    get "/api/v1/requests", headers: account_headers("acme")
+    assert_response :unauthorized
+    get "/api/v1/tickets", headers: account_headers("acme")
+    assert_response :unauthorized
+
+    # Avery creates a request in Acme; Casey creates a request in Beta
+    post "/api/v1/requests",
+      params: { request: { subject: "Avery issue", comment: { body: "Private details" } } },
+      headers: account_headers("acme", token: avery_token),
+      as: :json
+    assert_response :created
+    avery_ticket_id = json_body["request"]["id"]
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Casey issue", comment: { body: "Beta details" } } },
+      headers: account_headers("beta", token: casey_token),
+      as: :json
+    assert_response :created
+    casey_ticket_id = json_body["request"]["id"]
+
+    # Customer cannot access staff /tickets routes (403)
+    get "/api/v1/tickets", headers: account_headers("acme", token: avery_token)
+    assert_response :forbidden
+    get "/api/v1/tickets/#{avery_ticket_id}", headers: account_headers("acme", token: avery_token)
+    assert_response :forbidden
