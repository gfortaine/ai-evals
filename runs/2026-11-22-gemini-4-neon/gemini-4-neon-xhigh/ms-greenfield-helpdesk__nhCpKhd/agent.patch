+class Api::V1::InboundEmailAndRepliesTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  RELAY_PASSWORD = "relay-test-secret-password"
+
+  def relay_headers(password: RELAY_PASSWORD, username: "actionmailbox", content_type: "message/rfc822")
+    headers = {}
+    headers["CONTENT_TYPE"] = content_type unless content_type.nil?
+    if username && password
+      headers["Authorization"] = ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+    end
+    headers
+  end
+
+  def build_raw_email(
+    from: "Avery Chen <avery@example.test>",
+    to: "acme@support.example.test",
+    cc: nil,
+    bcc: nil,
+    subject: "Cannot download receipt",
+    body: "The download button does nothing.",
+    message_id: "<msg-#{SecureRandom.hex(8)}@example.test>",
+    extra_headers: {},
+    content_type: "text/plain; charset=UTF-8"
+  )
+    lines = []
+    lines << "From: #{from}" unless from.nil?
+    lines << "To: #{to}" unless to.nil?
+    lines << "Cc: #{cc}" unless cc.nil?
+    lines << "Bcc: #{bcc}" unless bcc.nil?
+    lines << "Message-ID: #{message_id}" unless message_id.nil?
+    lines << "Subject: #{subject}" unless subject.nil?
+    lines << "MIME-Version: 1.0"
+    lines << "Content-Type: #{content_type}" unless content_type.nil?
+    extra_headers.each do |k, v|
+      lines << "#{k}: #{v}"
+    end
+    lines << ""
+    lines << body.to_s
+    lines.join("\r\n")
+  end
+
+  def post_relay(raw_email, password: RELAY_PASSWORD, env_password: RELAY_PASSWORD, headers: nil, env: {})
+    merged_env = { "RAILS_INBOUND_EMAIL_PASSWORD" => env_password }.merge(env)
+    with_env(merged_env) do
+      post RELAY_PATH, params: raw_email, headers: (headers || relay_headers(password: password))
+    end
+  end
+
+  test "relay ingress enforces HTTP Basic authentication with RAILS_INBOUND_EMAIL_PASSWORD and message/rfc822 media type" do
+    signup_and_verify!
+    raw = build_raw_email(message_id: "<auth-check-1@example.test>")
+
+    # Missing credentials -> 401
+    post_relay(raw, headers: { "CONTENT_TYPE" => "message/rfc822" })
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong password -> 401
+    post_relay(raw, password: "wrong-password")
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong username -> 401
+    post_relay(raw, headers: relay_headers(username: "someoneelse", password: RELAY_PASSWORD))
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Unsupported media type -> 415
+    post_relay(raw, headers: relay_headers(content_type: "text/plain"))
+    assert_response :unsupported_media_type
+    assert_equal 0, Ticket.count
+
+    post_relay(raw, headers: relay_headers(content_type: "application/json"))
+    assert_response :unsupported_media_type
+    assert_equal 0, Ticket.count
+
+    # Unconfigured ingress -> 404
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => RELAY_PASSWORD) do
+      post "/rails/action_mailbox/postmark/inbound_emails", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+      assert_response :not_found
+    end
+
+    # Valid retry with same Message-ID succeeds immediately before request completes
+    ActionMailer::Base.deliveries.clear
+    post_relay(raw)
+    assert_response :no_content
+    assert_equal 1, Ticket.count
+    assert_equal "Cannot download receipt", Ticket.last.subject
+  end
+
+  test "incoming email creates unverified customer, sends verification email, opens ticket, and allows later portal access" do
