+    signup_account(name: "", subdomain: "-bad", admin_name: "", email: "not-email", password: "123")
+    assert_response :unprocessable_content
+    assert json_body["errors"]["name"].present?
+    assert json_body["errors"]["subdomain"].present?
+    assert json_body["errors"]["admin.name"].present?
+    assert json_body["errors"]["admin.email"].present?
+    assert json_body["errors"]["admin.password"].present?
+
+    post "/api/v1/account/create", params: { account: { name: "NoAdmin" } }, as: :json
+    assert_response :bad_request
+    assert json_body["error"].present?
