+        as: :json
+      assert_response :ok
+      assert_equal "normal", json_body["ticket"]["priority"]
+      assert_equal owner_id, json_body["ticket"]["assignee_id"]
+    end
+
+    # Customer cannot see priority or updated timestamp from internal change
+    get "/api/v1/requests/#{t1}", headers: account_headers("acme", token: avery_token)
+    assert_response :ok
+    assert_equal (base_time + 12.minutes).iso8601, json_body["request"]["updated_at"]
+    assert_not json_body["request"].key?("priority")
+
+    # Cross-tenant staff cannot update priority of Acme ticket
+    patch "/api/v1/tickets/#{t1}",
+      params: { ticket: { priority: "high" } },
