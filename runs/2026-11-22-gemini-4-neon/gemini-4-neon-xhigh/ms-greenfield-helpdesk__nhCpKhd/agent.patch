+    assert_equal [], json_body["groups"]
+    assert_equal false, json_body["meta"]["has_more"]
+    assert_nil json_body["meta"]["after_cursor"]
+    assert_nil json_body["meta"]["before_cursor"]
+    assert_nil json_body["links"]["next"]
+    assert_nil json_body["links"]["prev"]
+
+    get "/api/v1/groups", params: { page: { size: 5, before: solo_cursor } }, headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal [], json_body["groups"]
+    assert_equal false, json_body["meta"]["has_more"]
+    assert_nil json_body["meta"]["after_cursor"]
+    assert_nil json_body["meta"]["before_cursor"]
+    assert_nil json_body["links"]["next"]
+    assert_nil json_body["links"]["prev"]
+
+    # Invalid cursor with NullRelation filter (q with NUL byte or huge assignee_id) MUST still return 422
+    get "/api/v1/tickets?q=abc%00def&page[after]=bogus", headers: account_headers("acme", token: owner_token)
+    assert_response :unprocessable_content
+
+    get "/api/v1/tickets?assignee_id=99999999999999999999999&page[after]=bogus", headers: account_headers("acme", token: owner_token)
+    assert_response :unprocessable_content
+
+    # per_page alongside page[size] uses page[size] and omits per_page from links
+    2.times do |i|
+      post "/api/v1/groups",
+        params: { group: { name: "Extra Group #{i + 1}" } },
+        headers: account_headers("acme", token: owner_token),
+        as: :json
+      assert_response :created
+    end
+
+    get "/api/v1/groups?page[size]=1&per_page=10", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["groups"].size
+    next_query = Rack::Utils.parse_nested_query(URI.parse(json_body["links"]["next"]).query)
+    assert_equal "1", next_query.dig("page", "size")
+    assert_nil next_query["per_page"]
+
+    # Conflicting scalar + hash page parameter in query string returns 400 Bad Request JSON
+    get "/api/v1/tickets?page=1&page[size]=10", headers: account_headers("acme", token: owner_token)
+    assert_response :bad_request
+    assert json_body["error"].present?
+
+    # Auth / role / cancelled account guards still apply in cursor mode
+    get "/api/v1/tickets?page[size]=5", headers: account_headers("acme", token: customer_token)
+    assert_response :forbidden
+
+    get "/api/v1/requests?page[size]=5", headers: account_headers("acme", token: owner_token)
+    assert_response :forbidden
+
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: owner_token), as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets?page[size]=5", headers: account_headers("acme", token: owner_token)
+    assert_response :unauthorized
+  end
+
+end
diff --git a/test/integration/api/v1/customer_registration_and_flows_test.rb b/test/integration/api/v1/customer_registration_and_flows_test.rb
new file mode 100644
index 0000000..935a9cc
--- /dev/null
+++ b/test/integration/api/v1/customer_registration_and_flows_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class Api::V1::CustomerRegistrationAndFlowsTest < ActionDispatch::IntegrationTest
+  test "customer registers through portal and uses existing verification, login, profile, password, and recovery flows" do
+    signup_and_verify!
+    ActionMailer::Base.deliveries.clear
+
+    # Register customer (role escalation attempt is ignored)
+    post "/api/v1/registrations",
+      params: {
+        user: {
+          name: "Avery",
+          email: "Avery@Example.Test",
+          password: "my-customer-password",
+          role: "admin"
+        }
+      },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+
+    user = json_body["user"]
+    assert user["id"].is_a?(Integer)
+    assert_equal "Avery", user["name"]
+    assert_equal "avery@example.test", user["email"]
+    assert_equal "customer", user["role"]
+    assert_equal false, user["verified"]
+    assert_nil user["email_verified_at"]
+    assert user["created_at"].present?
+    assert user["updated_at"].present?
+    assert_not user.key?("password_digest")
+
+    # Sends verification email
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], mail.to
+    parsed = extract_token_from_mail(mail, path: "/verify-email")
+    assert_equal "acme", parsed[:account]
+
+    # Unverified customer cannot sign in
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Resend verification replaces old token
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "avery@example.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    new_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: parsed[:token] } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: new_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body["user"]["verified"]
+
+    # Customer signs in
+    login = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+    token = login["session"]["token"]
+    assert_equal "customer", login["user"]["role"]
+
+    # Profile GET & PATCH
+    get "/api/v1/me", headers: account_headers("acme", token: token)
+    assert_response :ok
+    assert_equal "Avery", json_body["user"]["name"]
+
+    patch "/api/v1/me",
+      params: { user: { name: "Avery Chen", role: "admin" } },
+      headers: account_headers("acme", token: token),
+      as: :json
+    assert_response :ok
+    assert_equal "Avery Chen", json_body["user"]["name"]
+    assert_equal "customer", json_body["user"]["role"]
+
+    # Change password
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-customer-password", password: "new-customer-password" } },
+      headers: account_headers("acme", token: token),
+      as: :json
+    assert_response :ok
+
+    # Old session revoked
+    get "/api/v1/me", headers: account_headers("acme", token: token)
+    assert_response :unauthorized
+
+    # Password recovery flow
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "avery@example.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "recovered-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    # Sign in with recovered password and sign out
+    new_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "recovered-password-1")["session"]["token"]
+    delete "/api/v1/session", headers: account_headers("acme", token: new_token)
+    assert_response :no_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: new_token)
+    assert_response :unauthorized
+  end
+
+  test "registration enforces per-account email uniqueness, validation, and active account checks" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    signup_and_verify!(name: "Beta", subdomain: "beta", email: "jo@beta.test")
+    ActionMailer::Base.deliveries.clear
+
+    register_customer(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    assert_response :created
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # Duplicate email on same business fails and sends no email
+    register_customer(subdomain: "acme", name: "Avery 2", email: "AVERY@example.test", password: "my-customer-password")
+    assert_response :unprocessable_content
+    assert json_body["errors"]["email"].present?
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # Cannot reuse staff email on same business
+    register_customer(subdomain: "acme", name: "Fake Jo", email: "jo@acme.test", password: "my-customer-password")
+    assert_response :unprocessable_content
+    assert json_body["errors"]["email"].present?
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # Same email CAN register on a different business
+    register_customer(subdomain: "beta", name: "Avery Beta", email: "avery@example.test", password: "beta-customer-password")
+    assert_response :created
+    assert_equal 2, ActionMailer::Base.deliveries.size
+
+    # Invalid payloads
+    register_customer(subdomain: "acme", name: "", email: "bad", password: "short")
+    assert_response :unprocessable_content
+    assert json_body["errors"]["name"].present?
+    assert json_body["errors"]["email"].present?
+    assert json_body["errors"]["password"].present?
+
+    post "/api/v1/registrations",
+      params: { user: "not-an-object" },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :bad_request
+
+    post "/api/v1/registrations",
+      params: { user: { name: "No Header", email: "no@header.test", password: "my-customer-password" } },
+      as: :json
+    assert_response :bad_request
+
+    register_customer(subdomain: "nonexistent", name: "Nobody", email: "nobody@example.test", password: "my-customer-password")
+    assert_response :not_found
+
+    # Cancelled account blocks registrations
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: owner_token), as: :json
+    assert_response :ok
+
+    register_customer(subdomain: "acme", name: "Blocked", email: "blocked@example.test", password: "my-customer-password")
+    assert_response :forbidden
+  end
+end
diff --git a/test/integration/api/v1/edge_cases_test.rb b/test/integration/api/v1/edge_cases_test.rb
new file mode 100644
index 0000000..2e1f2af
--- /dev/null
+++ b/test/integration/api/v1/edge_cases_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class Api::V1::EdgeCasesTest < ActionDispatch::IntegrationTest
+  test "expired verification and password reset tokens are rejected" do
+    signup_account
+    verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    travel 25.hours do
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: verify_token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Resend and verify normally
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    fresh_verify = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: fresh_verify } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    # Password reset expires after 2 hours
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+
+    travel 3.hours do
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: reset_token, password: "my-new-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "changing password via PUT /me/password invalidates outstanding password reset tokens" do
+    signup_and_verify!
+    token = sign_in!["session"]["token"]
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: token),
+      as: :json
+    assert_response :ok
+
+    # Old password reset token is invalidated too
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "another-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "case-insensitive emails and tenant headers work consistently" do
+    signup_account(name: "Acme", subdomain: "AcMe", admin_name: "Jo", email: "Jo@AcMe.Test", password: "my-first-password")
+    assert_response :created
+    assert_equal "acme", json_body["account"]["subdomain"]
+    assert_equal "jo@acme.test", json_body["user"]["email"]
+
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "  JO@ACME.TEST  " } },
+      headers: account_headers("  ACME  "),
+      as: :json
+    assert_response :ok
+    token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers("ACME"),
+      as: :json
+    assert_response :ok
+
+    login = sign_in!(subdomain: "ACME", email: "JO@ACME.TEST", password: "my-first-password")
+    assert login["session"]["token"].present?
+  end
+
+  test "malformed Authorization headers and invalid parameter envelopes return 401/400/422 JSON" do
+    signup_and_verify!
+    token = sign_in!["session"]["token"]
+
+    [
+      {},
+      { "Authorization" => "" },
+      { "Authorization" => token },
+      { "Authorization" => "Basic #{token}" },
+      { "Authorization" => "Bearer   " },
+      { "Authorization" => "Bearer tok1 tok2" }
+    ].each do |extra_headers|
+      get "/api/v1/me", headers: account_headers("acme", extra: extra_headers)
+      assert_response :unauthorized
+    end
+
+    post "/api/v1/sessions",
+      params: { session: "not-an-object" },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :bad_request
+
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "   " } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "same email across two businesses has isolated profile updates, password changes, and cancellations" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo Acme", email: "jo@shared.test", password: "shared-password-1")
+    signup_and_verify!(name: "Beta", subdomain: "beta", admin_name: "Jo Beta", email: "jo@shared.test", password: "shared-password-1")
+
+    acme_token = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "shared-password-1")["session"]["token"]
+    beta_token = sign_in!(subdomain: "beta", email: "jo@shared.test", password: "shared-password-1")["session"]["token"]
+
+    # Update name in Acme; Beta unchanged
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Acme Updated" } },
+      headers: account_headers("acme", token: acme_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+    assert_equal "Jo Beta", json_body["user"]["name"]
+
+    # Change password in Acme; Beta session and password unaffected
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "shared-password-1", password: "acme-new-password" } },
+      headers: account_headers("acme", token: acme_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+
+    # Cancel Acme; Beta unaffected
+    new_acme_token = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "acme-new-password")["session"]["token"]
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: new_acme_token), as: :json
+    assert_response :ok
+
+    get "/api/v1/portal", headers: account_headers("acme")
+    assert_response :forbidden
+    get "/api/v1/portal", headers: account_headers("beta")
+    assert_response :ok
+    get "/api/v1/account", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+  end
+end
diff --git a/test/integration/api/v1/groups_and_memberships_test.rb b/test/integration/api/v1/groups_and_memberships_test.rb
new file mode 100644
index 0000000..a91ab2c
--- /dev/null
+++ b/test/integration/api/v1/groups_and_memberships_test.rb
@@ -0,0 +1,567 @@
+require "test_helper"
+
+class Api::V1::GroupsAndMembershipsTest < ActionDispatch::IntegrationTest
+  test "admins create, list, inspect, rename, and delete groups; staff can browse them" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+
+    invite_and_accept!(admin_token: owner_token, email: "sam@example.test", role: "agent", name: "Sam")
+    sam_token = sign_in!(subdomain: "acme", email: "sam@example.test", password: "my-team-password")["session"]["token"]
+
+    # Create groups
+    post "/api/v1/groups",
+      params: { group: { name: "  Billing  " } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
+    billing = json_body["group"]
+    assert_equal "Billing", billing["name"]
+    assert billing["id"].is_a?(Integer)
+    assert billing["account_id"].is_a?(Integer)
+    assert billing["created_at"].present?
+    assert billing["updated_at"].present?
+
+    post "/api/v1/groups",
+      params: { group: { name: "Technical Support" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
+    support = json_body["group"]
+
+    post "/api/v1/groups",
+      params: { group: { name: "Account Management" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
+    acct_mgmt = json_body["group"]
+
+    # List by ID ascending for both admin and agent
+    [ owner_token, sam_token ].each do |staff_token|
+      get "/api/v1/groups", headers: account_headers("acme", token: staff_token)
+      assert_response :ok
+      assert_equal [ billing["id"], support["id"], acct_mgmt["id"] ], json_body["groups"].map { |g| g["id"] }
+      assert_equal [ "Billing", "Technical Support", "Account Management" ], json_body["groups"].map { |g| g["name"] }
+      assert_equal 3, json_body["count"]
+      assert_equal 1, json_body["page"]
+      assert_equal 25, json_body["per_page"]
+      assert_nil json_body["next_page"]
+      assert_nil json_body["previous_page"]
+
+      # Detail
+      get "/api/v1/groups/#{billing["id"]}", headers: account_headers("acme", token: staff_token)
+      assert_response :ok
+      assert_equal billing["id"], json_body["group"]["id"]
+      assert_equal "Billing", json_body["group"]["name"]
+    end
+
+    # Pagination
+    get "/api/v1/groups?page=1&per_page=2", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_equal [ billing["id"], support["id"] ], json_body["groups"].map { |g| g["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    get "/api/v1/groups?page=2&per_page=2", headers: account_headers("acme", token: sam_token)
+    assert_response :ok
+    assert_equal [ acct_mgmt["id"] ], json_body["groups"].map { |g| g["id"] }
+    assert_equal 1, json_body["previous_page"]
+    assert_nil json_body["next_page"]
+
+    # Rename with PATCH
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: { name: "  Billing & Invoices  " } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "Billing & Invoices", json_body["group"]["name"]
+
+    # Case-only rename on self succeeds
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: { name: "billing & invoices" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "billing & invoices", json_body["group"]["name"]
+
+    # Patch with unrecognized field is a no-op; empty envelope returns 400
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: { ignored: "value" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "billing & invoices", json_body["group"]["name"]
+
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: {} },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :bad_request
+
+    # PUT also works for rename
+    put "/api/v1/groups/#{billing["id"]}",
+      params: { group: { name: "Billing" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "Billing", json_body["group"]["name"]
+
+    # Delete group -> 204, subsequent GET -> 404, name can be reused
+    delete "/api/v1/groups/#{acct_mgmt["id"]}", headers: account_headers("acme", token: owner_token)
+    assert_response :no_content
+
+    get "/api/v1/groups/#{acct_mgmt["id"]}", headers: account_headers("acme", token: owner_token)
+    assert_response :not_found
+
+    post "/api/v1/groups",
+      params: { group: { name: "Account Management" } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :created
