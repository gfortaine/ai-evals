@@ -0,0 +1,55 @@
+require "test_helper"
+
+class UserTest < ActiveSupport::TestCase
+  test "allows same email across different accounts but not within the same account" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+
+    u1 = acme.users.create!(name: "Jo", email: "Jo@Shared.Test", password: "my-first-password", role: "admin")
+    u2 = beta.users.create!(name: "Jo Beta", email: "jo@shared.test", password: "another-password", role: "admin")
+
+    assert_equal "jo@shared.test", u1.email
+    assert_equal "jo@shared.test", u2.email
+    assert_not_equal u1.id, u2.id
+
+    dup = acme.users.build(name: "Dup", email: "JO@shared.test", password: "my-first-password", role: "admin")
+    assert_not dup.valid?
+    assert_includes dup.errors[:email], "has already been taken"
+  end
+
+  test "validates password minimum length and email format" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+
+    short_pw = acme.users.build(name: "Jo", email: "jo@acme.test", password: "short", role: "admin")
+    assert_not short_pw.valid?
+    assert short_pw.errors[:password].any?
+
+    bad_email = acme.users.build(name: "Jo", email: "not-an-email", password: "my-first-password", role: "admin")
+    assert_not bad_email.valid?
+    assert bad_email.errors[:email].any?
+  end
+
+  test "tracks suspension, syncs suspended_at, and scopes active staff and admins" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    admin = acme.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    agent = acme.users.create!(name: "Sam", email: "sam@acme.test", password: "my-team-password", role: "agent")
+    customer = acme.users.create!(name: "Avery", email: "avery@acme.test", password: "my-customer-password", role: "customer")
+
+    assert_equal false, admin.suspended?
+    assert_nil admin.suspended_at
+    assert_equal [ admin.id, agent.id ], acme.users.active_staff.ordered_by_id.pluck(:id)
+    assert_equal [ admin.id ], acme.users.active_admins.ordered_by_id.pluck(:id)
+
+    agent.update!(suspended: true)
+    assert agent.suspended?
+    assert agent.suspended_at.present?
+    assert_equal [ admin.id ], acme.users.active_staff.ordered_by_id.pluck(:id)
+
+    agent.update!(suspended: false)
+    assert_not agent.suspended?
+    assert_nil agent.suspended_at
+    assert_equal [ admin.id, agent.id ], acme.users.active_staff.ordered_by_id.pluck(:id)
+
+    assert_not_includes acme.users.active_staff.pluck(:id), customer.id
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..381183b
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,163 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    parallelize(workers: :number_of_processors)
+
+    setup do
+      ActionMailer::Base.deliveries.clear
+    end
+
+    def with_env(overrides)
+      previous = {}
+      overrides.each do |key, value|
+        previous[key] = ENV[key]
+        if value.nil?
+          ENV.delete(key)
+        else
+          ENV[key] = value
+        end
+      end
+      yield
+    ensure
+      previous.each do |key, value|
+        if value.nil?
+          ENV.delete(key)
+        else
+          ENV[key] = value
+        end
+      end
+    end
+  end
+end
+
+module ApiTestHelpers
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def account_headers(subdomain, token: nil, extra: {})
+    headers = { "X-Helpdesk-Account" => subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token
+    headers.merge(extra)
+  end
+
+  def signup_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+  end
+
+  def extract_token_from_mail(mail, path:)
+    match = mail.body.decoded.match(%r{#{Regexp.escape(path)}\?account=([^&\s]+)&token=([^\s]+)})
+    assert match, "Expected link with #{path} in mail body:\n#{mail.body.decoded}"
+    { account: CGI.unescape(match[1]), token: CGI.unescape(match[2]) }
+  end
+
+  def signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    signup_account(name: name, subdomain: subdomain, admin_name: admin_name, email: email, password: password)
+    assert_response :created
+    signup_data = json_body
+
+    mail = ActionMailer::Base.deliveries.last
+    parsed = extract_token_from_mail(mail, path: "/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: parsed[:token] } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    signup_data
+  end
+
+  def register_customer(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: {
+        user: {
+          name: name,
+          email: email,
+          password: password
+        }
+      },
+      headers: account_headers(subdomain),
+      as: :json
+  end
+
+  def register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    register_customer(subdomain: subdomain, name: name, email: email, password: password)
+    assert_response :created
+    registration_data = json_body
+
+    mail = ActionMailer::Base.deliveries.last
+    parsed = extract_token_from_mail(mail, path: "/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: parsed[:token] } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    registration_data
+  end
+
+  def sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    json_body
+  end
+
+  def create_invitation(subdomain: "acme", token:, email: "sam@example.test", role: "agent")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: account_headers(subdomain, token: token),
+      as: :json
+  end
+
+  def invite_and_accept!(subdomain: "acme", admin_token:, email: "sam@example.test", role: "agent", name: "Sam", password: "my-team-password")
+    create_invitation(subdomain: subdomain, token: admin_token, email: email, role: role)
+    assert_response :created
+    invitation_data = json_body
+
+    mail = ActionMailer::Base.deliveries.last
+    parsed = extract_token_from_mail(mail, path: "/accept-invitation")
+
+    post "/api/v1/invitation_acceptances",
+      params: {
+        invitation_acceptance: {
+          token: parsed[:token],
+          name: name,
+          password: password
+        }
+      },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+
+    {
+      invitation: invitation_data["invitation"],
+      user: json_body["user"],
+      account: json_body["account"],
+      token: parsed[:token]
+    }
+  end
+end
+
+class ActionDispatch::IntegrationTest
+  include ApiTestHelpers
+end
