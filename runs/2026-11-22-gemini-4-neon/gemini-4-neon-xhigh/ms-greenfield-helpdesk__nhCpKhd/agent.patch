@@ -0,0 +1,83 @@
+require "test_helper"
+
+class AccountTest < ActiveSupport::TestCase
+  test "normalizes name and subdomain" do
+    account = Account.create!(name: "  Acme Corp  ", subdomain: "  ACME-Corp  ")
+    assert_equal "Acme Corp", account.name
+    assert_equal "acme-corp", account.subdomain
+  end
+
+  test "validates subdomain format and case-insensitive uniqueness" do
+    Account.create!(name: "Acme", subdomain: "acme")
+
+    dup = Account.new(name: "Other", subdomain: "ACME")
+    assert_not dup.valid?
+    assert_includes dup.errors[:subdomain], "has already been taken"
+
+    %w[-acme acme- ac_me ac.me ac\ me].each do |bad|
+      invalid = Account.new(name: "Bad", subdomain: bad)
+      assert_not invalid.valid?, "Expected #{bad.inspect} to be invalid"
+    end
+  end
+
+  test "cancel! sets cancelled_at and revokes sessions" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    user = account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin", email_verified_at: Time.current)
+    account.update!(owner: user)
+    Session.issue_for!(user)
+    Session.issue_for!(user)
+
+    assert_equal 2, account.sessions.count
+    account.cancel!
+    assert account.cancelled?
+    assert_equal 0, account.sessions.count
+  end
+
+  test "reactivatable? checks 90-day boundary" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    assert_not account.reactivatable?
+
+    account.update!(cancelled_at: 89.days.ago)
+    assert account.reactivatable?
+
+    account.update!(cancelled_at: 90.days.ago)
+    assert_not account.reactivatable?
+
+    account.update!(cancelled_at: 91.days.ago)
+    assert_not account.reactivatable?
+  end
+
+  test "purge_cancelled! deletes only accounts cancelled 90+ days ago along with all associated data" do
+    old_cancelled = Account.create!(name: "Old", subdomain: "old", cancelled_at: 91.days.ago)
+    old_user = old_cancelled.users.create!(name: "Old Jo", email: "jo@old.test", password: "my-first-password", role: "admin", email_verified_at: 100.days.ago)
+    old_cancelled.update!(owner: old_user)
+    Session.issue_for!(old_user)
+    UserToken.issue_for!(user: old_user, purpose: UserToken::EMAIL_VERIFICATION)
+    UserToken.issue_for!(user: old_user, purpose: UserToken::PASSWORD_RESET)
+
+    recent_cancelled = Account.create!(name: "Recent", subdomain: "recent", cancelled_at: 89.days.ago)
+    recent_user = recent_cancelled.users.create!(name: "Recent Jo", email: "jo@recent.test", password: "my-first-password", role: "admin")
+    recent_cancelled.update!(owner: recent_user)
+
+    active = Account.create!(name: "Active", subdomain: "active")
+    active_user = active.users.create!(name: "Active Jo", email: "jo@active.test", password: "my-first-password", role: "admin")
+    active.update!(owner: active_user)
+
+    purged = Account.purge_cancelled!
+    assert_equal 1, purged
+
+    assert_not Account.exists?(old_cancelled.id)
+    assert_not User.exists?(old_user.id)
+    assert_equal 0, Session.where(account_id: old_cancelled.id).count
+    assert_equal 0, UserToken.where(account_id: old_cancelled.id).count
+
+    assert Account.exists?(recent_cancelled.id)
+    assert User.exists?(recent_user.id)
+    assert Account.exists?(active.id)
+    assert User.exists?(active_user.id)
+
+    # Subdomain is reusable after purge
+    recreated = Account.create!(name: "Old Reborn", subdomain: "old")
+    assert recreated.persisted?
+  end
+end
