+    assert_nil acme.users.find_by(email: "invited@example.test")
+
+    # Malformed / empty payloads -> handled cleanly without 500
+    [ "", "not an rfc822 email at all", "From: invalid\r\nTo: acme@support.example.test\r\n\r\nHi" ].each do |bad|
+      post_relay(bad)
