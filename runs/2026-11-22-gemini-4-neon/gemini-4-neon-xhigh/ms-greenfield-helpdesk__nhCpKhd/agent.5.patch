index 0000000..0bf2252
--- /dev/null
+++ b/test/integration/api/v1/inbound_email_and_replies_test.rb
@@ -0,0 +1,1084 @@
+require "base64"
+require "test_helper"
+
+class Api::V1::InboundEmailAndRepliesTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  RELAY_PASSWORD = "relay-test-secret-password"
+
+  def relay_headers(password: RELAY_PASSWORD, username: "actionmailbox", content_type: "message/rfc822")
+    headers = {}
+    headers["CONTENT_TYPE"] = content_type unless content_type.nil?
+    if username && password
+      headers["Authorization"] = ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+    end
+    headers
+  end
+
+  def build_raw_email(
+    from: "Avery Chen <avery@example.test>",
+    to: "acme@support.example.test",
+    cc: nil,
+    bcc: nil,
+    subject: "Cannot download receipt",
+    body: "The download button does nothing.",
+    message_id: "<msg-#{SecureRandom.hex(8)}@example.test>",
+    extra_headers: {},
+    content_type: "text/plain; charset=UTF-8"
+  )
+    lines = []
+    lines << "From: #{from}" unless from.nil?
+    lines << "To: #{to}" unless to.nil?
+    lines << "Cc: #{cc}" unless cc.nil?
+    lines << "Bcc: #{bcc}" unless bcc.nil?
+    lines << "Message-ID: #{message_id}" unless message_id.nil?
+    lines << "Subject: #{subject}" unless subject.nil?
+    lines << "MIME-Version: 1.0"
+    lines << "Content-Type: #{content_type}" unless content_type.nil?
+    extra_headers.each do |k, v|
+      lines << "#{k}: #{v}"
+    end
+    lines << ""
+    lines << body.to_s
+    lines.join("\r\n")
+  end
+
+  def post_relay(raw_email, password: RELAY_PASSWORD, env_password: RELAY_PASSWORD, headers: nil, env: {})
+    merged_env = { "RAILS_INBOUND_EMAIL_PASSWORD" => env_password }.merge(env)
+    with_env(merged_env) do
+      post RELAY_PATH, params: raw_email, headers: (headers || relay_headers(password: password))
+    end
+  end
+
+  test "relay ingress enforces HTTP Basic authentication with RAILS_INBOUND_EMAIL_PASSWORD and message/rfc822 media type" do
+    signup_and_verify!
+    raw = build_raw_email(message_id: "<auth-check-1@example.test>")
+
+    # Missing credentials -> 401
+    post_relay(raw, headers: { "CONTENT_TYPE" => "message/rfc822" })
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong password -> 401
+    post_relay(raw, password: "wrong-password")
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong username -> 401
+    post_relay(raw, headers: relay_headers(username: "someoneelse", password: RELAY_PASSWORD))
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Unsupported media type -> 415
+    post_relay(raw, headers: relay_headers(content_type: "text/plain"))
+    assert_response :unsupported_media_type
+    assert_equal 0, Ticket.count
+
+    post_relay(raw, headers: relay_headers(content_type: "application/json"))
+    assert_response :unsupported_media_type
+    assert_equal 0, Ticket.count
+
+    # Unconfigured ingress -> 404
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => RELAY_PASSWORD) do
+      post "/rails/action_mailbox/postmark/inbound_emails", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+      assert_response :not_found
+    end
+
+    # Valid retry with same Message-ID succeeds immediately before request completes
+    ActionMailer::Base.deliveries.clear
+    post_relay(raw)
+    assert_response :no_content
+    assert_equal 1, Ticket.count
+    assert_equal "Cannot download receipt", Ticket.last.subject
+  end
+
+  test "incoming email creates unverified customer, sends verification email, opens ticket, and allows later portal access" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    ActionMailer::Base.deliveries.clear
+
+    raw = build_raw_email(
+      from: "Avery Chen <AVERY@Example.Test>",
+      to: "ACME@Support.Example.Test",
+      subject: "  Need help with billing  ",
+      body: "Line 1\r\nLine 2\r\n"
+    )
+
+    post_relay(raw)
+    assert_response :no_content
+
+    # Verification email was sent to the newly created customer
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    verification_mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], verification_mail.to
+    parsed_verification = extract_token_from_mail(verification_mail, path: "/verify-email")
+    assert_equal "acme", parsed_verification[:account]
+
+    # Staff sees ticket and unverified customer
+    get "/api/v1/tickets", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["tickets"].size
+    ticket = json_body["tickets"].first
+    assert_equal "Need help with billing", ticket["subject"]
+    assert_equal "open", ticket["status"]
+    assert_equal "normal", ticket["priority"]
+    assert_equal "Avery Chen", ticket["requester"]["name"]
+    assert_equal "avery@example.test", ticket["requester"]["email"]
+    assert_not ticket.key?("reply_token")
+    assert_not ticket.key?("reply_address")
+
+    get "/api/v1/tickets/#{ticket["id"]}/comments", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["comments"].size
+    assert_equal "Line 1\nLine 2", json_body["comments"].first["body"]
+    assert_equal true, json_body["comments"].first["public"]
+
+    get "/api/v1/users?role=customer", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    customer_json = json_body["users"].find { |u| u["email"] == "avery@example.test" }
+    assert customer_json
+    assert_equal false, customer_json["verified"]
+    assert_nil customer_json["email_verified_at"]
+
+    # Receiving a second email reuses existing customer, keeps them unverified, sends no second verification email
+    ActionMailer::Base.deliveries.clear
+    post_relay(build_raw_email(
+      from: "Different Name <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Second question",
+      body: "Another question here."
+    ))
+    assert_response :no_content
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    account = Account.find_by!(subdomain: "acme")
+    customer = account.users.find_by!(email: "avery@example.test")
+    assert_equal "Avery Chen", customer.name
+    assert_not customer.verified?
+    assert_equal 2, account.tickets.count
+
+    # Customer sets password via reset flow, still cannot sign in until verifying email
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "avery@example.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "portal-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "portal-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Customer verifies email using token from initial verification email and signs in to portal
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: parsed_verification[:token] } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body["user"]["verified"]
+
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "portal-password-1")["session"]["token"]
+    get "/api/v1/requests", headers: account_headers("acme", token: customer_token)
+    assert_response :ok
+    assert_equal 2, json_body["requests"].size
+  end
+
+  test "reuses existing portal customer without sending verification email or altering verified state, and derives fallback name" do
+    signup_and_verify!
+    register_customer(subdomain: "acme", name: "Existing Unverified", email: "unverified@example.test", password: "cust-password-1")
+    assert_response :created
+    register_and_verify_customer!(subdomain: "acme", name: "Existing Verified", email: "verified@example.test", password: "cust-password-2")
+    ActionMailer::Base.deliveries.clear
+
+    # Unverified existing customer emails support -> reused, remains unverified, no new verification email
+    post_relay(build_raw_email(
+      from: "unverified@example.test",
+      to: "acme@support.example.test",
+      subject: "From unverified",
+      body: "Still unverified."
+    ))
+    assert_response :no_content
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    account = Account.find_by!(subdomain: "acme")
+    unverified_user = account.users.find_by!(email: "unverified@example.test")
+    assert_not unverified_user.verified?
+    assert_equal "Existing Unverified", unverified_user.name
+
+    # Verified existing customer emails support -> reused, remains verified, no email sent
+    post_relay(build_raw_email(
+      from: "verified@example.test",
+      to: "acme@support.example.test",
+      subject: "From verified",
+      body: "Already verified."
+    ))
+    assert_response :no_content
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    verified_user = account.users.find_by!(email: "verified@example.test")
+    assert verified_user.verified?
+
+    # New customer with bare email address (no display name) gets local-part fallback name
+    post_relay(build_raw_email(
+      from: "bare.sender@example.test",
+      to: "acme@support.example.test",
+      subject: "Bare sender",
+      body: "Hello from bare email."
+    ))
+    assert_response :no_content
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    bare_user = account.users.find_by!(email: "bare.sender@example.test")
+    assert_equal "bare.sender", bare_user.name
+    assert_not bare_user.verified?
+  end
+
+  test "extracts plain-text message from multipart emails with html and attachments, and strips html-only fallback" do
+    signup_and_verify!
+    owner_token = sign_in!["session"]["token"]
+    ActionMailer::Base.deliveries.clear
+
+    # Multipart/mixed containing multipart/alternative + text/plain attachment
+    multipart_mail = Mail.new do
+      from "Avery <avery@example.test>"
+      to "acme@support.example.test"
+      message_id "<multi-1@example.test>"
+      subject "Multipart ticket"
+      add_file filename: "debug.txt", content: "ATTACHMENT SHOULD NOT BE BODY"
+      text_part do
+        content_type "text/plain; charset=UTF-8"
+        body "This is the plain text version."
+      end
+      html_part do
+        content_type "text/html; charset=UTF-8"
+        body "<p>This is the <b>HTML</b> version.</p>"
+      end
