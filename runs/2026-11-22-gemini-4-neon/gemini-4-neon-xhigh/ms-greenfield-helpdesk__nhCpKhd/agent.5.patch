+    assert_equal "pending", existing_ticket.reload.status
+    assert_equal 1, existing_ticket.comments.count
+
+    # Existing staff emailing plain support address -> ignored
+    post_relay(build_raw_email(from: "jo@acme.test", to: "acme@support.example.test", subject: "Staff email", body: "Nope"))
