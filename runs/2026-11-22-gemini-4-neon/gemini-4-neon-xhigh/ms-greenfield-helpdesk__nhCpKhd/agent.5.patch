+    post_relay(build_raw_email(from: "suspended@example.test", to: "acme@support.example.test", subject: "Blocked", body: "Nope"))
+    assert_response :no_content
+    assert_equal 1, acme.tickets.count
+
+    # Suspended customer replying to own ticket -> ignored
+    post_relay(build_raw_email(from: "suspended@example.test", to: existing_ticket.reply_address, subject: "Re: Old", body: "Nope"))
