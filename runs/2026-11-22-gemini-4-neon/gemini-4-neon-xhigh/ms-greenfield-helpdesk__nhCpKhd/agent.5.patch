+
+  test "handles missing Message-ID, bare Message-ID, base64 body, long subject, plus-addressed customer, cross-tenant staff as customer, and multi-turn threading" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    signup_and_verify!(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    acme = Account.find_by!(subdomain: "acme")
+    beta = Account.find_by!(subdomain: "beta")
+    ActionMailer::Base.deliveries.clear
+
+    # Email without Message-ID header: opens ticket; exact duplicate dedups; different body opens 2nd ticket
+    no_mid_1 = build_raw_email(from: "alice+vip@example.test", to: "acme@support.example.test", message_id: nil, subject: "No MID 1", body: "First no-mid body")
+    no_mid_2 = build_raw_email(from: "alice+vip@example.test", to: "acme@support.example.test", message_id: nil, subject: "No MID 2", body: "Second no-mid body")
+    post_relay(no_mid_1, headers: relay_headers(content_type: "message/rfc822; charset=utf-8"))
+    assert_response :no_content
+    post_relay(no_mid_1)
+    assert_response :no_content
+    post_relay(no_mid_2)
+    assert_response :no_content
+    assert_equal 2, acme.tickets.count
+
+    # Bare Message-ID vs angle-bracketed Message-ID deduplicate
+    post_relay(build_raw_email(from: "alice+vip@example.test", to: "acme@support.example.test", message_id: "bare-id@example.test", subject: "Bare MID", body: "First"))
+    assert_response :no_content
+    post_relay(build_raw_email(from: "alice+vip@example.test", to: "acme@support.example.test", message_id: "<bare-id@example.test>", subject: "Bare MID", body: "Duplicate"))
+    assert_response :no_content
+    assert_equal 3, acme.tickets.count
+
+    # Very long subject (> 255 chars) truncated safely & base64 UTF-8 body decoded
+    long_subject = "S" * 300
+    base64_body = Base64.strict_encode64("Base64 UTF-8 body: café")
+    post_relay(build_raw_email(
+      from: "alice+vip@example.test",
+      to: "acme@support.example.test",
+      subject: long_subject,
+      body: base64_body,
+      extra_headers: { "Content-Transfer-Encoding" => "base64" }
+    ))
+    assert_response :no_content
+    assert_equal 4, acme.tickets.count
+    long_ticket = acme.tickets.order(id: :asc).last
+    assert_equal 255, long_ticket.subject.length
+    assert_equal "Base64 UTF-8 body: café", long_ticket.comments.first.body
+
+    # Admin of Acme emailing Beta is treated as a regular customer in Beta
+    post_relay(build_raw_email(from: "Jo <jo@acme.test>", to: "beta@support.example.test", subject: "Need Beta support", body: "Hello Beta"))
+    assert_response :no_content
+    assert_equal 1, beta.tickets.count
+    beta_cust = beta.users.find_by!(email: "jo@acme.test")
+    assert beta_cust.customer?
+    assert_not beta_cust.verified?
+
+    # VERP bounce address is ignored
+    post_relay(build_raw_email(from: "bounces+12345@example.test", to: "acme@support.example.test", subject: "Bounce", body: "Bounced"))
+    assert_response :no_content
+    assert_equal 4, acme.tickets.count
+
+    # Multi-turn conversation with In-Reply-To & References updating across customer replies
+    ticket = acme.tickets.find_by!(subject: "Bare MID")
+    ActionMailer::Base.deliveries.clear
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { status: "pending", comment: { body: "Staff turn 1" } } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    mail1 = ActionMailer::Base.deliveries.last
+    assert_equal "bare-id@example.test", mail1.in_reply_to
+    reply_address = mail1.reply_to.first
+
+    post_relay(build_raw_email(
+      from: "alice+vip@example.test",
+      to: reply_address,
+      message_id: "<turn-2@example.test>",
+      subject: "Re: Bare MID",
+      body: "Customer turn 2"
+    ))
+    assert_response :no_content
+    assert_equal "open", ticket.reload.status
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { status: "solved", comment: { body: "Staff turn 2" } } },
+      headers: account_headers("acme", token: owner_token),
+      as: :json
+    assert_response :ok
+    mail2 = ActionMailer::Base.deliveries.last
+    assert_equal "turn-2@example.test", mail2.in_reply_to
+    assert_equal [ "bare-id@example.test", "turn-2@example.test" ], Array(mail2.references)
+    assert_equal [ reply_address ], mail2.reply_to
+  end
+end
