+    [ 999_999, t_beta, 99999999999999999999999 ].each do |bad_source|
+      post "/api/v1/tickets/#{bad_source}/merge",
+        params: { merge: { target_id: t2 } },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :not_found, "Expected 404 for source=#{bad_source.inspect}"
+    end
+
+    # Malformed envelopes -> 400
+    [
+      {},
+      { merge: {} },
+      { merge: "not-an-object" },
+      { merge: [ t2 ] },
+      { merge: { target_id: t2, source_comment: "not-an-object" } },
+      { merge: { target_id: t2, target_comment: [ "not-an-object" ] } }
+    ].each do |bad_params|
+      post "/api/v1/tickets/#{t1}/merge",
+        params: bad_params,
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :bad_request, "Expected 400 for #{bad_params.inspect}"
+    end
+
+    # Invalid target_id values -> 422 (atomic)
+    [
+      nil,
+      0,
+      -1,
+      "",
+      "abc",
+      "0#{t2}",
+      true,
+      [],
+      999_999,
+      99999999999999999999999,
+      t_beta,   # cross-tenant (even though same customer email!)
+      t1,       # self-merge
+      t_blake   # different customer in same account
+    ].each do |bad_target|
+      post "/api/v1/tickets/#{t1}/merge",
+        params: {
+          merge: {
+            target_id: bad_target,
+            source_comment: { body: "Should not persist", public: true },
+            target_comment: { body: "Should not persist", public: false }
+          }
+        },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 for target_id=#{bad_target.inspect}"
+      assert json_body["error"].present?
+      assert json_body["errors"]["target_id"].present?
+    end
+
+    # Missing target_id with comment provided -> 422
+    post "/api/v1/tickets/#{t1}/merge",
+      params: { merge: { source_comment: { body: "No target" } } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body["errors"]["target_id"].present?
+
+    # Invalid source_comment / target_comment fields -> 422 (atomic)
+    [
+      [ { target_id: t2, source_comment: { body: "" } }, "source_comment.body" ],
+      [ { target_id: t2, source_comment: { body: "   \n\t " } }, "source_comment.body" ],
+      [ { target_id: t2, source_comment: { body: nil } }, "source_comment.body" ],
+      [ { target_id: t2, source_comment: { body: 123 } }, "source_comment.body" ],
+      [ { target_id: t2, source_comment: { body: "bad\x00body" } }, "source_comment.body" ],
+      [ { target_id: t2, source_comment: { body: "ok", public: "true" } }, "source_comment.public" ],
+      [ { target_id: t2, source_comment: { body: "ok", public: nil } }, "source_comment.public" ],
+      [ { target_id: t2, source_comment: { body: "ok", public: 1 } }, "source_comment.public" ],
+      [ { target_id: t2, target_comment: { body: "" }, source_comment: { body: "Valid source", public: true } }, "target_comment.body" ],
+      [ { target_id: t2, target_comment: { body: "   " } }, "target_comment.body" ],
+      [ { target_id: t2, target_comment: { body: nil } }, "target_comment.body" ],
+      [ { target_id: t2, target_comment: { body: true } }, "target_comment.body" ],
+      [ { target_id: t2, target_comment: { body: "ok", public: "false" } }, "target_comment.public" ],
+      [ { target_id: t2, target_comment: { body: "ok", public: 0 } }, "target_comment.public" ]
+    ].each do |merge_payload, expected_error_key|
+      post "/api/v1/tickets/#{t1}/merge",
+        params: { merge: merge_payload },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 for #{merge_payload.inspect}"
+      assert json_body["error"].present?
+      assert json_body["errors"][expected_error_key].present?,
+        "Expected errors[#{expected_error_key}] in #{json_body.inspect}"
+    end
+
+    # Nothing persisted from any of the failed merges above!
+    assert_equal "open", Ticket.find(t1).status
+    assert_nil Ticket.find(t1).merged_into_id
+    assert_equal 1, Ticket.find(t1).comments.count
+    assert_equal 1, Ticket.find(t2).comments.count
+
+    # Cancelled account blocks merge (403)
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: jo_token), as: :json
+    assert_response :ok
+    reactivate_token = sign_in!(subdomain: "acme", email: "jo@acme.test")["session"]["token"]
+    post "/api/v1/tickets/#{t1}/merge",
+      params: { merge: { target_id: t2 } },
+      headers: account_headers("acme", token: reactivate_token),
+      as: :json
+    assert_response :forbidden
+
+    # Reactivate and confirm merge now succeeds (including null comment envelopes)
+    post "/api/v1/account/reactivate", headers: account_headers("acme", token: reactivate_token), as: :json
+    assert_response :ok
+    post "/api/v1/tickets/#{t1}/merge",
+      params: { merge: { target_id: t2, source_comment: nil, target_comment: nil } },
+      headers: account_headers("acme", token: reactivate_token),
+      as: :json
+    assert_response :ok
+    assert_equal "closed", json_body["source"]["status"]
+    assert_equal t2, json_body["source"]["merged_into_id"]
+
+    # Beta tenant completely unaffected
+    get "/api/v1/tickets/#{t_beta}", headers: account_headers("beta", token: bo_token)
+    assert_response :ok
+    assert_equal "open", json_body["ticket"]["status"]
+    assert_nil json_body["ticket"]["merged_into_id"]
+  end
+
+  test "supports merging solved/pending sources, empty comment objects, unverified email customers, chained email bounces, and rejects clearing closed assignments via PATCH" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    jo_login = sign_in!(subdomain: "acme", email: "jo@acme.test")
+    jo_token = jo_login["session"]["token"]
+    jo_id = jo_login["user"]["id"]
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: account_headers("acme", token: jo_token), as: :json
+    billing_id = json_body["group"]["id"]
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing_id, user_id: jo_id, default: true } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :created
+
+    # Unverified customer opens 3 email-origin tickets
+    %w[A B C].each_with_index do |label, i|
+      post_relay(build_raw_email(
+        from: "Unverified <unverified@example.test>",
+        to: "acme@support.example.test",
+        message_id: "<chain-#{label.downcase}@example.test>",
+        subject: "Chain #{label}",
+        body: "Opening #{label}"
+      ))
+      assert_response :no_content
+    end
+
+    account = Account.find_by!(subdomain: "acme")
+    t_a = account.tickets.find_by!(subject: "Chain A")
+    t_b = account.tickets.find_by!(subject: "Chain B")
+    t_c = account.tickets.find_by!(subject: "Chain C")
+
+    # Set A to solved with group+assignee, B to pending
+    patch "/api/v1/tickets/#{t_a.id}",
+      params: { ticket: { status: "solved", group_id: billing_id, assignee_id: jo_id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+
+    patch "/api/v1/tickets/#{t_b.id}",
+      params: { ticket: { status: "pending" } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+
+    ActionMailer::Base.deliveries.clear
+
+    # Merge solved A into pending B with empty comment objects {} -> default private notes, 0 emails
+    post "/api/v1/tickets/#{t_a.id}/merge",
+      params: { merge: { target_id: t_b.id, source_comment: {}, target_comment: {} } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal "closed", json_body["source"]["status"]
+    assert_equal t_b.id, json_body["source"]["merged_into_id"]
+    assert_equal billing_id, json_body["source"]["group_id"]
+    assert_equal jo_id, json_body["source"]["assignee_id"]
+    assert_equal "pending", json_body["target"]["status"]
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Attempting to clear assignee_id or group_id on closed A via PATCH is rejected (422)
+    [
+      { assignee_id: nil },
+      { group_id: nil },
+      { group_id: nil, assignee_id: nil }
+    ].each do |clear_payload|
+      patch "/api/v1/tickets/#{t_a.id}",
+        params: { ticket: clear_payload },
+        headers: account_headers("acme", token: jo_token),
+        as: :json
+      assert_response :unprocessable_content
+    end
+    t_a.reload
+    assert_equal billing_id, t_a.group_id
+    assert_equal jo_id, t_a.assignee_id
+
+    # Now merge pending B into open C -> chained merge A -> B -> C
+    post "/api/v1/tickets/#{t_b.id}/merge",
+      params: { merge: { target_id: t_c.id } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal "closed", json_body["source"]["status"]
+    assert_equal t_c.id, json_body["source"]["merged_into_id"]
+    assert_equal "open", json_body["target"]["status"]
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # A still points to B (history preserved)
+    assert_equal t_b.id, t_a.reload.merged_into_id
+
+    # Email replies to BOTH A and B are bounced; reply to C succeeds!
+    post_relay(build_raw_email(
+      from: "unverified@example.test",
+      to: t_a.reply_address,
+      message_id: "<bounce-a@example.test>",
+      subject: "Re: Chain A",
+      body: "Replying to A"
+    ))
+    assert_response :no_content
+    assert ActionMailbox::InboundEmail.order(:id).last.bounced?
+
+    post_relay(build_raw_email(
+      from: "unverified@example.test",
+      to: t_b.reply_address,
+      message_id: "<bounce-b@example.test>",
+      subject: "Re: Chain B",
+      body: "Replying to B"
+    ))
+    assert_response :no_content
+    assert ActionMailbox::InboundEmail.order(:id).last.bounced?
+
+    post_relay(build_raw_email(
+      from: "unverified@example.test",
+      to: t_c.reply_address,
+      message_id: "<ok-c@example.test>",
+      subject: "Re: Chain C",
+      body: "Replying to C"
+    ))
+    assert_response :no_content
+    assert ActionMailbox::InboundEmail.order(:id).last.delivered?
+    assert_equal "Replying to C", t_c.comments.chronological.last.body
+
+    # Staff public reply on C sends email referencing ONLY C inbound messages
+    patch "/api/v1/tickets/#{t_c.id}",
+      params: { ticket: { comment: { body: "Reply on C", public: true } } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ t_c.reply_address ], mail.reply_to
+    assert_equal "<ok-c@example.test>", mail.header["In-Reply-To"].value
+    assert_equal "<chain-c@example.test> <ok-c@example.test>", mail.header["References"].value
+  end
+end
