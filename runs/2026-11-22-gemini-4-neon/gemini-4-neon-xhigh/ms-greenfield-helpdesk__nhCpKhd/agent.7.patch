+    invalid_status = acme.tickets.build(requester: customer, subject: "Test", status: "archived")
     assert_not invalid_status.valid?
     assert invalid_status.errors[:status].any?
 
@@ -226,4 +226,90 @@ class TicketTest < ActiveSupport::TestCase
     assert_equal [ t2.id ], acme.tickets.in_group_id(billing.id).pluck(:id)
     assert_equal [ t1.id ], acme.tickets.in_group_id(support.id).pluck(:id)
   end
+
+  test "validates closed status immutability and merged_into invariants" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+    avery = acme.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+    blake = acme.users.create!(name: "Blake", email: "blake@example.test", password: "my-customer-password", role: "customer")
+    beta_customer = beta.users.create!(name: "Bob", email: "bob@example.test", password: "my-customer-password", role: "customer")
+
+    t1 = acme.tickets.create!(requester: avery, subject: "Dup 1")
+    t2 = acme.tickets.create!(requester: avery, subject: "Target")
+    t3 = acme.tickets.create!(requester: avery, subject: "Chain Target")
+    other_customer_ticket = acme.tickets.create!(requester: blake, subject: "Blake ticket")
+    beta_ticket = beta.tickets.create!(requester: beta_customer, subject: "Beta ticket")
+
+    assert_nil t1.merged_into_id
+
+    # Cannot set merged_into without status: closed
+    assert_not t1.update(merged_into: t2)
+    assert t1.errors[:status].any?
+    t1.reload
+
+    # Cannot self-merge
+    assert_not t1.update(status: Ticket::CLOSED, merged_into: t1)
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Cannot merge into different customer
+    assert_not t1.update(status: Ticket::CLOSED, merged_into: other_customer_ticket)
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Cannot merge into another account
+    assert_not t1.update(status: Ticket::CLOSED, merged_into: beta_ticket)
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Cannot merge into nonexistent ticket
+    assert_not t1.update(status: Ticket::CLOSED, merged_into_id: 999_999_999)
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Valid merge closes t1 and updates customer_updated_at
+    base = Time.zone.parse("2026-09-01 10:00:00 UTC")
+    t1.update_columns(updated_at: base, customer_updated_at: base)
+    travel_to base + 10.minutes do
+      assert t1.update(status: Ticket::CLOSED, merged_into: t2)
+    end
+    t1.reload
+    assert t1.closed?
+    assert_equal t2.id, t1.merged_into_id
+    assert_equal base + 10.minutes, t1.updated_at
+    assert_equal base + 10.minutes, t1.customer_updated_at
+
+    # Closed ticket rejects further updates
+    assert_not t1.update(status: Ticket::OPEN)
+    assert t1.errors[:status].any?
+    t1.reload
+    assert_not t1.update(priority: Ticket::HIGH)
+    assert t1.errors[:status].any?
+    t1.reload
+    assert_not t1.update(subject: "Renamed")
+    assert t1.errors[:status].any?
+
+    # Cannot merge another ticket into already-closed t1
+    assert_not t3.update(status: Ticket::CLOSED, merged_into: t1)
+    assert t3.errors[:merged_into_id].any?
+    t3.reload
+
+    # Chained merge: t2 -> t3 leaves t1 -> t2 intact
+    assert t2.update(status: Ticket::CLOSED, merged_into: t3)
+    assert_equal t2.id, t1.reload.merged_into_id
+    assert_equal t3.id, t2.reload.merged_into_id
+    assert_nil t3.reload.merged_into_id
+
+    # DB check constraint blocks self-merge even via raw SQL
+    assert_raises(ActiveRecord::StatementInvalid) do
+      ActiveRecord::Base.transaction(requires_new: true) do
+        Ticket.where(id: t3.id).update_all(merged_into_id: t3.id)
+      end
+    end
+
+    # Cancelled account purge cleanly deletes merged and chained tickets
+    acme.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_cancelled!
+    assert_nil Account.find_by(id: acme.id)
+  end
 end
