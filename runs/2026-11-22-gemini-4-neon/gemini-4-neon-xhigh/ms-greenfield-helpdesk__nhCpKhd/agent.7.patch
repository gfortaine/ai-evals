+class Api::V1::TicketMergingTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  RELAY_PASSWORD = "test-inbound-secret-password"
+
+  def relay_headers(username: "actionmailbox", password: RELAY_PASSWORD, content_type: "message/rfc822")
+    encoded = Base64.strict_encode64("#{username}:#{password}")
+    {
+      "Authorization" => "Basic #{encoded}",
+      "CONTENT_TYPE" => content_type
+    }
+  end
+
+  def build_raw_email(
+    from: "Avery <avery@example.test>",
+    to: "acme@support.example.test",
+    cc: nil,
+    subject: "Cannot download receipt",
+    body: "Please help me download my receipt.",
+    message_id: "<#{SecureRandom.hex(8)}@example.test>"
+  )
+    lines = []
+    lines << "From: #{from}"
+    lines << "To: #{to}"
+    lines << "Cc: #{cc}" if cc
+    lines << "Message-ID: #{message_id}"
+    lines << "Subject: #{subject}"
+    lines << "MIME-Version: 1.0"
+    lines << "Content-Type: text/plain; charset=UTF-8"
+    lines << ""
