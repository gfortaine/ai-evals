+require "test_helper"
+
+class Api::V1::EdgeCasesTest < ActionDispatch::IntegrationTest
+  test "expired verification and password reset tokens are rejected" do
+    signup_account
+    verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    travel 25.hours do
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: verify_token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Resend and verify normally
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    fresh_verify = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: fresh_verify } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    # Password reset expires after 2 hours
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+
+    travel 3.hours do
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: reset_token, password: "my-new-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "changing password via PUT /me/password invalidates outstanding password reset tokens" do
+    signup_and_verify!
+    token = sign_in!["session"]["token"]
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: token),
+      as: :json
+    assert_response :ok
+
+    # Old password reset token is invalidated too
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "another-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "case-insensitive emails and tenant headers work consistently" do
+    signup_account(name: "Acme", subdomain: "AcMe", admin_name: "Jo", email: "Jo@AcMe.Test", password: "my-first-password")
+    assert_response :created
+    assert_equal "acme", json_body["account"]["subdomain"]
+    assert_equal "jo@acme.test", json_body["user"]["email"]
+
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "  JO@ACME.TEST  " } },
+      headers: account_headers("  ACME  "),
+      as: :json
+    assert_response :ok
+    token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers("ACME"),
+      as: :json
+    assert_response :ok
+
+    login = sign_in!(subdomain: "ACME", email: "JO@ACME.TEST", password: "my-first-password")
+    assert login["session"]["token"].present?
+  end
+
+  test "malformed Authorization headers and invalid parameter envelopes return 401/400/422 JSON" do
+    signup_and_verify!
+    token = sign_in!["session"]["token"]
+
+    [
+      {},
+      { "Authorization" => "" },
+      { "Authorization" => token },
+      { "Authorization" => "Basic #{token}" },
+      { "Authorization" => "Bearer   " },
+      { "Authorization" => "Bearer tok1 tok2" }
+    ].each do |extra_headers|
+      get "/api/v1/me", headers: account_headers("acme", extra: extra_headers)
+      assert_response :unauthorized
+    end
+
+    post "/api/v1/sessions",
+      params: { session: "not-an-object" },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :bad_request
+
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "   " } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "same email across two businesses has isolated profile updates, password changes, and cancellations" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo Acme", email: "jo@shared.test", password: "shared-password-1")
+    signup_and_verify!(name: "Beta", subdomain: "beta", admin_name: "Jo Beta", email: "jo@shared.test", password: "shared-password-1")
+
+    acme_token = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "shared-password-1")["session"]["token"]
+    beta_token = sign_in!(subdomain: "beta", email: "jo@shared.test", password: "shared-password-1")["session"]["token"]
+
+    # Update name in Acme; Beta unchanged
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Acme Updated" } },
+      headers: account_headers("acme", token: acme_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+    assert_equal "Jo Beta", json_body["user"]["name"]
+
+    # Change password in Acme; Beta session and password unaffected
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "shared-password-1", password: "acme-new-password" } },
+      headers: account_headers("acme", token: acme_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+
+    # Cancel Acme; Beta unaffected
+    new_acme_token = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "acme-new-password")["session"]["token"]
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: new_acme_token), as: :json
+    assert_response :ok
+
+    get "/api/v1/portal", headers: account_headers("acme")
+    assert_response :forbidden
+    get "/api/v1/portal", headers: account_headers("beta")
+    assert_response :ok
+    get "/api/v1/account", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+  end
+end
diff --git a/test/integration/api/v1/passwords_and_resets_test.rb b/test/integration/api/v1/passwords_and_resets_test.rb
new file mode 100644
index 0000000..86bb502
--- /dev/null
+++ b/test/integration/api/v1/passwords_and_resets_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class Api::V1::PasswordsAndResetsTest < ActionDispatch::IntegrationTest
+  test "PUT /api/v1/me/password validates current_password, updates password, and signs out all existing sessions" do
+    signup_and_verify!
+    token1 = sign_in!["session"]["token"]
+    token2 = sign_in!["session"]["token"]
+
+    # Wrong current password fails and leaves sessions intact
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: token1)
+    assert_response :ok
+
+    # Blank or too-short new password fails and leaves sessions intact
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :unprocessable_content
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "short" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: token2)
+    assert_response :ok
+
+    # Valid password change succeeds and signs out ALL existing sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: token1),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("acme", token: token1)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers("acme", token: token2)
+    assert_response :unauthorized
+
+    # Old password no longer signs in
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    # New password works
+    new_login = sign_in!(password: "my-new-password")
+    assert new_login["session"]["token"].present?
+  end
+
+  test "password reset flow replaces old links, enforces tenant/purpose isolation, and revokes existing sessions" do
+    signup_and_verify!
+    signup_and_verify!(name: "Beta", subdomain: "beta", admin_name: "Bea", email: "jo@acme.test", password: "beta-password-1")
+
+    existing_token = sign_in!(subdomain: "acme")["session"]["token"]
+    beta_token = sign_in!(subdomain: "beta", email: "jo@acme.test", password: "beta-password-1")["session"]["token"]
+
+    ActionMailer::Base.deliveries.clear
+
+    # Unknown email returns 200 without sending email
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "nobody@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Request first reset link with custom frontend URL and mail sender
+    with_env("HELPDESK_FRONTEND_URL" => "https://help.example.test", "HELPDESK_MAIL_FROM" => "mailer@help.example.test") do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "jo@acme.test" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+    end
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail1 = ActionMailer::Base.deliveries.last
+    assert_equal [ "mailer@help.example.test" ], mail1.from
+    reset_token1 = extract_token_from_mail(mail1, path: "/reset-password")[:token]
+    assert_includes mail1.body.decoded, "https://help.example.test/reset-password?account=acme&token=#{reset_token1}"
+
+    # Request second reset link; replaces first
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    reset_token2 = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+    assert_not_equal reset_token1, reset_token2
+
+    # First token is rejected
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token1, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Second token rejected under wrong tenant (Beta)
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token2, password: "my-new-password" } },
+      headers: account_headers("beta"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Invalid password does not consume valid reset token
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token2, password: "short" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Confirming with valid token and password succeeds and signs out existing sessions in Acme only
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token2, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    # Replay fails
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token2, password: "another-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Existing Acme session is revoked; Beta session unaffected
+    get "/api/v1/me", headers: account_headers("acme", token: existing_token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers("beta", token: beta_token)
+    assert_response :ok
+
+    # Can sign into Acme with new password
+    sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+  end
+
+  test "email verification token cannot be used for password reset and vice versa" do
+    signup_account
+    verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")[:token]
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: verify_token, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: reset_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Password reset for unverified user changes password but does not bypass email verification
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+  end
+end
diff --git a/test/integration/api/v1/signup_and_portal_test.rb b/test/integration/api/v1/signup_and_portal_test.rb
new file mode 100644
index 0000000..d434a1e
--- /dev/null
+++ b/test/integration/api/v1/signup_and_portal_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Api::V1::SignupAndPortalTest < ActionDispatch::IntegrationTest
+  test "POST /api/v1/account/create registers account and unverified admin and sends verification email" do
+    with_env("HELPDESK_FRONTEND_URL" => nil, "HELPDESK_MAIL_FROM" => nil) do
+      signup_account
+      assert_response :created
+
+      body = json_body
+      account = body["account"]
+      user = body["user"]
+
+      assert account["id"].is_a?(Integer)
+      assert_equal "Acme", account["name"]
+      assert_equal "acme", account["subdomain"]
+      assert_equal "active", account["status"]
+      assert_nil account["cancelled_at"]
+      assert account["created_at"].present?
+      assert account["updated_at"].present?
+
+      assert user["id"].is_a?(Integer)
+      assert_equal account["id"], user["account_id"]
+      assert_equal "Jo", user["name"]
+      assert_equal "jo@acme.test", user["email"]
+      assert_equal "admin", user["role"]
+      assert_equal false, user["verified"]
+      assert_nil user["email_verified_at"]
+      assert user["created_at"].present?
+      assert user["updated_at"].present?
+      assert_not user.key?("password_digest")
+
+      assert_equal 1, ActionMailer::Base.deliveries.size
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "support@example.test" ], mail.from
+      assert_equal [ "jo@acme.test" ], mail.to
+
+      parsed = extract_token_from_mail(mail, path: "/verify-email")
+      assert_equal "acme", parsed[:account]
+      assert_includes mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token=#{parsed[:token]}"
+    end
+  end
+
+  test "same email can belong to different businesses" do
+    signup_account(name: "Acme", subdomain: "acme", admin_name: "Jo Acme", email: "jo@shared.test")
+    assert_response :created
+    acme_user_id = json_body["user"]["id"]
+
+    signup_account(name: "Beta", subdomain: "beta", admin_name: "Jo Beta", email: "jo@shared.test")
+    assert_response :created
+    beta_user_id = json_body["user"]["id"]
+
+    assert_not_equal acme_user_id, beta_user_id
+    assert_equal 2, ActionMailer::Base.deliveries.size
+  end
+
+  test "duplicate subdomain or invalid signup payloads return 422 or 400 JSON" do
+    signup_account(name: "Acme", subdomain: "acme")
+    assert_response :created
+
+    signup_account(name: "Acme 2", subdomain: "ACME", email: "other@acme.test")
+    assert_response :unprocessable_content
+    assert json_body["error"].present?
+    assert json_body["errors"]["subdomain"].present?
+
+    signup_account(name: "", subdomain: "-bad", admin_name: "", email: "not-email", password: "123")
+    assert_response :unprocessable_content
+    assert json_body["errors"]["name"].present?
+    assert json_body["errors"]["subdomain"].present?
+    assert json_body["errors"]["admin.name"].present?
+    assert json_body["errors"]["admin.email"].present?
+    assert json_body["errors"]["admin.password"].present?
+
+    post "/api/v1/account/create", params: { account: { name: "NoAdmin" } }, as: :json
+    assert_response :bad_request
+    assert json_body["error"].present?
+  end
+
+  test "malformed JSON returns 400 JSON and unknown route returns 404 JSON" do
+    post "/api/v1/account/create",
+      params: "{invalid json",
+      headers: { "CONTENT_TYPE" => "application/json", "ACCEPT" => "*/*" }
+    assert_response :bad_request
+    assert_includes response.content_type, "application/json"
+    assert json_body["error"].present?
+
+    get "/api/v1/nonexistent"
+    assert_response :not_found
+    assert_includes response.content_type, "application/json"
+    assert json_body["error"].present?
+  end
+
+  test "GET /api/v1/portal returns public name and subdomain for tenant header" do
+    signup_account(name: "Acme", subdomain: "acme")
+    assert_response :created
+
+    get "/api/v1/portal", headers: account_headers("acme")
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_body)
+
+    get "/api/v1/portal", headers: account_headers("ACME")
+    assert_response :ok
+    assert_equal "acme", json_body["portal"]["subdomain"]
+
+    get "/api/v1/portal"
+    assert_response :bad_request
+
+    get "/api/v1/portal", headers: account_headers("missing")
+    assert_response :not_found
+  end
+end
