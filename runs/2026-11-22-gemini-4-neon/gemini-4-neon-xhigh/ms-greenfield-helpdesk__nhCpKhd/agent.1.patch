@@ -0,0 +1,68 @@
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      before_action :resolve_account!
+      before_action :require_active_account!
+
+      def create
+        reset_params = require_object_param(:password_reset).permit(:email)
+        email = reset_params[:email].to_s.strip.downcase
+
+        if email.blank?
+          render json: {
+            error: "Email can't be blank",
+            errors: { email: [ "can't be blank" ] }
+          }, status: :unprocessable_content
+          return
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user.present?
+          token = UserToken.issue_for!(user: user, purpose: UserToken::PASSWORD_RESET)
+          AuthMailer.password_reset(user: user, token: token).deliver_now
+        end
+
+        render json: { message: "If an account exists for that email, a password reset link has been sent." }, status: :ok
+      end
+
+      def confirm
+        reset_params = require_object_param(:password_reset).permit(:token, :password, :password_confirmation)
+        raw_token = reset_params[:token].to_s
+
+        token_record = UserToken.find_valid(
+          account: current_account,
+          purpose: UserToken::PASSWORD_RESET,
+          raw_token: raw_token
+        )
+
+        if token_record.nil?
+          render json: { error: "Invalid or expired password reset token" }, status: :unprocessable_content
+          return
+        end
+
+        if reset_params[:password].blank?
+          render json: {
+            error: "Password can't be blank",
+            errors: { password: [ "can't be blank" ] }
+          }, status: :unprocessable_content
+          return
+        end
+
+        user = token_record.user
+        ActiveRecord::Base.transaction do
+          user.password = reset_params[:password]
+          if reset_params.key?(:password_confirmation)
+            user.password_confirmation = reset_params[:password_confirmation]
+          end
+          user.save!
+          user.user_tokens.for_purpose(UserToken::PASSWORD_RESET).delete_all
+          user.revoke_all_sessions!
+        end
+
+        render json: { message: "Password has been reset" }, status: :ok
+      rescue ActiveRecord::RecordInvalid
+        render_validation_errors(user)
+      end
+    end
+  end
+end
