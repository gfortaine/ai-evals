+        "Card" => :cards,
+        "Comment" => :comments,
+        "Board" => :boards
+      }
+      drop_null_account_rows :action_text_rich_texts
+
+      # Level 6: ActiveStorage attachments, blobs, and variant records
+      backfill_active_storage
+    end
+
+    def backfill_from_parent(table, parent:, foreign_key:)
+      execute(<<~SQL)
+        UPDATE #{table}
+        SET account_id = (
+          SELECT #{parent}.account_id
+          FROM #{parent}
+          WHERE #{parent}.id = #{table}.#{foreign_key}
+        )
+        WHERE #{table}.account_id IS NULL
+      SQL
+    end
+
+    def backfill_polymorphic_account_or_board(table, type_column:, id_column:)
+      execute(<<~SQL)
+        UPDATE #{table}
+        SET account_id = (
+          SELECT accounts.id
+          FROM accounts
+          WHERE accounts.id = #{table}.#{id_column}
+        )
+        WHERE #{table}.account_id IS NULL
+          AND #{table}.#{type_column} = 'Account'
+      SQL
+
+      execute(<<~SQL)
+        UPDATE #{table}
+        SET account_id = (
+          SELECT boards.account_id
+          FROM boards
+          WHERE boards.id = #{table}.#{id_column}
+        )
+        WHERE #{table}.account_id IS NULL
+          AND #{table}.#{type_column} = 'Board'
+      SQL
+    end
+
+    def backfill_polymorphic_from_sources(table, type_column:, id_column:, sources:)
+      sources.each do |record_type, source_table|
+        execute(<<~SQL)
+          UPDATE #{table}
+          SET account_id = (
+            SELECT #{source_table}.account_id
+            FROM #{source_table}
+            WHERE #{source_table}.id = #{table}.#{id_column}
+          )
+          WHERE #{table}.account_id IS NULL
+            AND #{table}.#{type_column} = #{quote(record_type)}
+        SQL
+      end
+    end
+
+    def backfill_tags
+      execute(<<~SQL)
+        UPDATE tags
+        SET account_id = COALESCE(
+          (
+            SELECT cards.account_id
+            FROM taggings
+            INNER JOIN cards ON cards.id = taggings.card_id
+            WHERE taggings.tag_id = tags.id
+            LIMIT 1
+          ),
+          (
+            SELECT filters.account_id
+            FROM filters_tags
+            INNER JOIN filters ON filters.id = filters_tags.filter_id
+            WHERE filters_tags.tag_id = tags.id
+            LIMIT 1
+          )
+        )
+        WHERE tags.account_id IS NULL
+      SQL
+    end
+
+    def backfill_active_storage
+      backfill_polymorphic_from_sources :active_storage_attachments, type_column: :record_type, id_column: :record_id, sources: {
+        "Card" => :cards,
+        "User" => :users,
+        "Export" => :exports,
+        "Account::Export" => :exports,
+        "User::DataExport" => :exports,
+        "Account::Import" => :account_imports,
+        "ActionText::RichText" => :action_text_rich_texts,
+        "Comment" => :comments,
+        "Board" => :boards
+      }
+
+      execute(<<~SQL)
+        UPDATE active_storage_attachments
+        SET account_id = (
+          SELECT accounts.id
+          FROM accounts
+          WHERE accounts.id = active_storage_attachments.record_id
+        )
+        WHERE active_storage_attachments.account_id IS NULL
+          AND active_storage_attachments.record_type = 'Account'
+      SQL
+
+      # Propagate account_id through blobs -> variant records / preview attachments -> derivative blobs.
+      # Three passes cover direct blobs, variants, previews, and variants of previews.
+      3.times do
+        execute(<<~SQL)
+          UPDATE active_storage_blobs
+          SET account_id = (
+            SELECT active_storage_attachments.account_id
+            FROM active_storage_attachments
+            WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+              AND active_storage_attachments.account_id IS NOT NULL
+            LIMIT 1
+          )
+          WHERE active_storage_blobs.account_id IS NULL
+        SQL
+
+        execute(<<~SQL)
+          UPDATE active_storage_variant_records
+          SET account_id = (
+            SELECT active_storage_blobs.account_id
+            FROM active_storage_blobs
+            WHERE active_storage_blobs.id = active_storage_variant_records.blob_id
+              AND active_storage_blobs.account_id IS NOT NULL
+          )
+          WHERE active_storage_variant_records.account_id IS NULL
+        SQL
+
+        execute(<<~SQL)
+          UPDATE active_storage_attachments
+          SET account_id = (
+            SELECT active_storage_variant_records.account_id
+            FROM active_storage_variant_records
+            WHERE active_storage_variant_records.id = active_storage_attachments.record_id
+              AND active_storage_variant_records.account_id IS NOT NULL
+          )
+          WHERE active_storage_attachments.account_id IS NULL
+            AND active_storage_attachments.record_type = 'ActiveStorage::VariantRecord'
+        SQL
+
+        execute(<<~SQL)
+          UPDATE active_storage_attachments
+          SET account_id = (
+            SELECT active_storage_blobs.account_id
+            FROM active_storage_blobs
+            WHERE active_storage_blobs.id = active_storage_attachments.record_id
+              AND active_storage_blobs.account_id IS NOT NULL
+          )
+          WHERE active_storage_attachments.account_id IS NULL
+            AND active_storage_attachments.record_type = 'ActiveStorage::Blob'
+        SQL
+      end
+
+      drop_null_account_rows :active_storage_attachments
+      drop_null_account_rows :active_storage_variant_records
+      drop_null_account_rows :active_storage_blobs
+    end
+
+    def drop_null_account_rows(table)
+      execute("DELETE FROM #{table} WHERE account_id IS NULL")
+    end
+
+    def drop_account_orphans(table)
+      execute(<<~SQL)
+        DELETE FROM #{table}
+        WHERE account_id IS NULL
+          OR NOT EXISTS (
+            SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id
+          )
+      SQL
+    end
+
+    def drop_search_record_orphans
+      if connection.adapter_name == "SQLite"
+        if table_exists?(:search_records)
+          if select_value("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'search_records_fts'")
+            execute(<<~SQL)
+              DELETE FROM search_records_fts
+              WHERE rowid IN (
+                SELECT id FROM search_records
+                WHERE NOT EXISTS (
+                  SELECT 1 FROM accounts WHERE accounts.id = search_records.account_id
+                )
+              )
+            SQL
+          end
+          drop_account_orphans :search_records
+        end
+      else
+        16.times do |shard_id|
+          table = :"search_records_#{shard_id}"
+          drop_account_orphans(table) if table_exists?(table)
+        end
+      end
+    end
+end
