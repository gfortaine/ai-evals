+      assert_account_map(conn, :action_text_rich_texts, { rt_card => account_a, rt_comment => account_b, rt_board => account_b })
+
+      assert_account_map(conn, :active_storage_attachments, {
+        att_card => account_a,
+        att_user => account_a,
+        att_export => account_a,
+        att_import => account_a,
+        att_embed => account_b,
+        att_variant => account_b,
+        att_pdf => account_b,
+        att_preview => account_b,
+        att_preview_variant => account_b
+      })
+
+      assert_account_map(conn, :active_storage_variant_records, {
+        vr_embed => account_b,
+        vr_preview => account_b
+      })
+
+      assert_account_map(conn, :active_storage_blobs, {
+        blob_card => account_a,
+        blob_user => account_a,
+        blob_export => account_a,
+        blob_import => account_a,
+        blob_embed => account_b,
+        blob_variant => account_b,
+        blob_pdf => account_b,
+        blob_preview => account_b,
+        blob_preview_variant => account_b
+      })
+
+      # Verify tags unique index is scoped per account
+      insert_row(conn, :tags, id: gen_uuid, account_id: account_b, title: "alpha", created_at: now, updated_at: now)
+      assert_raises(ActiveRecord::RecordNotUnique) do
+        insert_row(conn, :tags, id: gen_uuid, account_id: account_a, title: "alpha", created_at: now, updated_at: now)
+      end
+
+      # Verify NOT NULL constraint enforced on newly tenanted table
+      assert_raises(ActiveRecord::NotNullViolation) do
+        insert_row(conn, :pins, id: gen_uuid, account_id: nil, card_id: card_a, user_id: user_a, created_at: now, updated_at: now)
+      end
+
+      # Verify global identities untouched
+      assert_equal 1, conn.select_value("SELECT COUNT(*) FROM identities")
+
+      # Verify rollback and re-migrate cleanly (drop the cross-account duplicate tag first so old unique index on title can be re-added)
+      conn.execute("DELETE FROM tags WHERE title = 'alpha' AND account_id = #{conn.quote(serialize_uuid(account_b))}")
+      migration.migrate(:down)
+      assert_not conn.column_exists?(:accesses, :account_id)
+      assert conn.columns(:boards).find { |c| c.name == "account_id" }.null
+
+      migration.migrate(:up)
+      assert conn.column_exists?(:accesses, :account_id)
+      assert_not conn.columns(:boards).find { |c| c.name == "account_id" }.null
+    end
+  end
+
+  private
+    def parse_schema_tables(schema_source)
+      schema_source.scan(/create_table "([^"]+)"(.*?)^\s+end$/m).to_h
+    end
+
+    def gen_uuid
+      ActiveRecord::Type::Uuid.generate
+    end
+
+    def serialize_uuid(value)
+      ActiveRecord::Type::Uuid.new.serialize(value)
+    end
+
+    def deserialize_uuid(value)
+      ActiveRecord::Type::Uuid.new.deserialize(value)
+    end
+
+    def insert_row(conn, table, attrs)
+      cols = attrs.keys.map(&:to_s)
+      vals = attrs.map do |k, v|
+        if v.nil?
+          "NULL"
+        elsif k.to_s == "id" || k.to_s.end_with?("_id") && k.to_s != "external_account_id"
+          conn.quote(serialize_uuid(v))
+        else
+          conn.quote(v)
+        end
+      end
+      conn.execute("INSERT INTO #{table} (#{cols.join(', ')}) VALUES (#{vals.join(', ')})")
+    end
+
+    def assert_account_map(conn, table, expected)
+      actual = conn.select_all("SELECT id, account_id FROM #{table}").each_with_object({}) do |row, hash|
+        hash[deserialize_uuid(row["id"])] = deserialize_uuid(row["account_id"])
+      end
+      assert_equal expected, actual, "Unexpected rows in #{table}"
+    end
+
+    def with_isolated_pre_migration_db
+      tempfile = Tempfile.new([ "tenancy_migration_test", ".sqlite3" ])
+      tempfile.close
+
+      IsolatedMigrationRecord.establish_connection(adapter: "sqlite3", database: tempfile.path)
+      conn = IsolatedMigrationRecord.connection_pool.lease_connection
+
+      ActiveRecord::Migration.suppress_messages do
+        schema_class = Class.new(ActiveRecord::Schema[8.2]) do
+          define_method(:connection) { conn }
+        end
+        schema_source = File.read(Rails.root.join("db/schema_sqlite.rb"))
+          .sub(/ActiveRecord::Schema\[8\.2\]\.define\([^)]+\)/, "schema_class.define")
+        binding.eval(schema_source)
+
+        migration = AddAccountIdToRemainingTables.new
+        migration.singleton_class.define_method(:connection) { conn }
+        migration.migrate(:down)
+
+        yield conn, migration
+      end
+    ensure
+      IsolatedMigrationRecord.connection_pool.disconnect!
+      tempfile&.unlink
+    end
+end
