diff --git a/test/models/account_tenancy_rollout_test.rb b/test/models/account_tenancy_rollout_test.rb
new file mode 100644
index 0000000..ccdeb65
--- /dev/null
+++ b/test/models/account_tenancy_rollout_test.rb
@@ -0,0 +1,701 @@
+require "test_helper"
+require Rails.root.join("db/migrate/20261121064500_add_account_id_to_remaining_tables")
+
+class AccountTenancyRolloutTest < ActiveSupport::TestCase
+  class IsolatedMigrationRecord < ActiveRecord::Base
+    self.abstract_class = true
+  end
+
+  GLOBAL_TABLES = %w[
+    accounts
+    account_external_id_sequences
+    action_pack_passkeys
+    ar_internal_metadata
+    identities
+    identity_access_tokens
+    magic_links
+    schema_migrations
+    search_records_fts
+    search_records_fts_config
+    search_records_fts_data
+    search_records_fts_docsize
+    search_records_fts_idx
+    sessions
+  ].freeze
+
+  test "every tenant table has required and indexed uuid account_id" do
+    connection = ActiveRecord::Base.connection
+    tenant_tables = connection.tables - GLOBAL_TABLES
+
+    assert_not_empty tenant_tables
+
+    tenant_tables.each do |table|
+      column = connection.columns(table).find { |c| c.name == "account_id" }
+      assert_not_nil column, "Expected #{table} to have an account_id column"
+      assert_equal :uuid, column.type, "Expected #{table}.account_id to be a uuid column"
+      assert_not column.null, "Expected #{table}.account_id to be NOT NULL"
+      assert connection.index_exists?(table, :account_id), "Expected #{table} to have an index on account_id"
+    end
+
+    %w[ accounts account_external_id_sequences action_pack_passkeys identities identity_access_tokens magic_links sessions ].each do |table|
+      assert_not connection.column_exists?(table, :account_id), "Expected global table #{table} not to have account_id"
+    end
+
+    assert connection.index_exists?(:tags, [ :account_id, :title ], unique: true)
+    assert_not connection.index_exists?(:tags, :title)
+  end
+
+  test "mysql and sqlite schema files agree on account_id rollout" do
+    mysql_schema = File.read(Rails.root.join("db/schema.rb"))
+    sqlite_schema = File.read(Rails.root.join("db/schema_sqlite.rb"))
+
+    assert_equal "2026_11_21_064500", mysql_schema[/version: (\d+(?:_\d+)+)/, 1]
+    assert_equal "2026_11_21_064500", sqlite_schema[/version: (\d+(?:_\d+)+)/, 1]
+
+    mysql_tables = parse_schema_tables(mysql_schema)
+    sqlite_tables = parse_schema_tables(sqlite_schema)
+
+    shared_tables = (mysql_tables.keys & sqlite_tables.keys) - GLOBAL_TABLES
+    assert_not_empty shared_tables
+
+    shared_tables.each do |table|
+      assert_includes mysql_tables[table], 't.uuid "account_id", null: false', "MySQL schema missing NOT NULL account_id on #{table}"
+      assert_includes mysql_tables[table], 't.index ["account_id"]', "MySQL schema missing account_id index on #{table}"
+      assert_includes sqlite_tables[table], 't.uuid "account_id", null: false', "SQLite schema missing NOT NULL account_id on #{table}"
+      assert_includes sqlite_tables[table], 't.index ["account_id"]', "SQLite schema missing account_id index on #{table}"
+    end
+  end
+
+  test "models populate account_id automatically even without Current.account" do
+    account = accounts(:initech)
+    board = boards(:miltons_wish_list)
+    user = users(:mike)
+    card = cards(:radio)
+
+    Current.without_account do
+      other_board = Board.create!(name: "Cross Context Board", creator: user, all_access: true)
+      assert_equal account.id, other_board.account_id
+      assert_equal account.id, other_board.accesses.first.account_id
+
+      new_user = User.create!(name: "Initech Newbie", account: account)
+      assert_equal account.id, new_user.accesses.find_by!(board: other_board).account_id
+
+      other_board.accesses.revoke_from(new_user)
+      other_board.accesses.grant_to(new_user)
+      assert_equal account.id, other_board.accesses.find_by!(user: new_user).account_id
+
+      settings = new_user.create_settings!(bundle_email_frequency: :never)
+      assert_equal account.id, settings.account_id
+
+      search_query = Search::Query.create!(user: user, terms: "stapler")
+      assert_equal account.id, search_query.account_id
+
+      publication = Board::Publication.create!(board: board)
+      assert_equal account.id, publication.account_id
+
+      webhook = Webhook.create!(board: board, name: "Hook", url: "https://example.com/hook")
+      assert_equal account.id, webhook.delinquency_tracker.account_id
+
+      event = Event.create!(board: board, creator: user, eventable: card, action: "card_published")
+      delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+      assert_equal account.id, delivery.account_id
+
+      assignment = Assignment.create!(card: card, assignee: user, assigner: user)
+      assert_equal account.id, assignment.account_id
+
+      tag = account.tags.create!(title: "stapler")
+      tagging = Tagging.create!(card: card, tag: tag)
+      assert_equal account.id, tagging.account_id
+
+      watch = Watch.create!(card: card, user: user)
+      assert_equal account.id, watch.account_id
+
+      pin = Pin.create!(card: card, user: user)
+      assert_equal account.id, pin.account_id
+
+      reaction = Reaction.create!(reactable: card, reacter: user, content: "👍")
+      assert_equal account.id, reaction.account_id
+
+      mention = Mention.create!(source: card, mentioner: user, mentionee: user)
+      assert_equal account.id, mention.account_id
+
+      closure = Closure.create!(card: cards(:paycheck), user: user)
+      assert_equal account.id, closure.account_id
+
+      goldness = Card::Goldness.create!(card: card)
+      assert_equal account.id, goldness.account_id
+
+      not_now = Card::NotNow.create!(card: cards(:unfinished_thoughts), user: user)
+      assert_equal account.id, not_now.account_id
+
+      spike = Card::ActivitySpike.create!(card: card)
+      assert_equal account.id, spike.account_id
+
+      account_total = Storage::Total.create!(owner: account)
+      assert_equal account.id, account_total.account_id
+
+      board_total = Storage::Total.create!(owner: board)
+      assert_equal account.id, board_total.account_id
+
+      board_entropy = other_board.create_entropy!(auto_postpone_period: 30.days)
+      assert_equal account.id, board_entropy.account_id
+
+      # ActionText & ActiveStorage (including immediate variants)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      assert_equal account.id, card.image.attachment.account_id
+      assert_equal account.id, card.image.blob.account_id
+
+      user.avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+      assert_equal account.id, user.avatar.attachment.account_id
+      assert_equal account.id, user.avatar.blob.account_id
+      variant_record = user.avatar.blob.variant_records.first
+      assert_not_nil variant_record
+      assert_equal account.id, variant_record.account_id
+      assert_equal account.id, variant_record.image.attachment.account_id
+      assert_equal account.id, variant_record.image.blob.account_id
+
+# Attaching on an unsaved card with image before board in attribute order
+new_card = Card.create!(
+  image: { io: file_fixture("moon.jpg").open, filename: "unsaved.jpg", content_type: "image/jpeg" },
+  board: board,
+  creator: user,
+  title: "Card with image on create",
+        number: 99
+)
+assert_equal account.id, new_card.image.attachment.account_id
+assert_equal account.id, new_card.image.blob.account_id
+
+# ActionText rich text with embedded blob and immediate variants
+embed_blob = ActiveStorage::Blob.create_and_upload!(
+  io: file_fixture("moon.jpg").open,
+  filename: "embed.jpg",
+  content_type: "image/jpeg",
+  record: card
+)
+embed_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+comment = card.comments.create!(creator: user, body: "<p>Hello #{embed_html}</p>")
+assert_equal account.id, comment.rich_text_body.account_id
+assert_equal account.id, comment.rich_text_body.embeds.first.account_id
+assert embed_blob.variant_records.exists?
+embed_blob.variant_records.each do |vr|
+  assert_equal account.id, vr.account_id
+  assert_equal account.id, vr.image.attachment.account_id
+  assert_equal account.id, vr.image.blob.account_id
+end
+
+      # Filter HABTM join tables (from both Filter and Filterable sides)
+      filter = user.filters.create!(
+        tag_ids: [ tag.id ],
+        board_ids: [ board.id ],
+        assignee_ids: [ user.id ],
+        creator_ids: [ user.id ],
+        closer_ids: [ user.id ]
+      )
+      conn = ActiveRecord::Base.connection
+      %w[ filters_tags boards_filters assignees_filters creators_filters closers_filters ].each do |join_table|
+        rows = conn.select_all("SELECT account_id FROM #{join_table} WHERE filter_id = #{conn.quote(serialize_uuid(filter.id))}")
+        assert_equal 1, rows.length, "Expected 1 row in #{join_table}"
+        assert_equal account.id, deserialize_uuid(rows.first["account_id"]), "Expected account_id on #{join_table}"
+      end
+
+      other_board.filters << filter
+      board_rows = conn.select_all("SELECT account_id FROM boards_filters WHERE board_id = #{conn.quote(serialize_uuid(other_board.id))}")
+      assert_equal 1, board_rows.length
+      assert_equal account.id, deserialize_uuid(board_rows.first["account_id"])
+    end
+  end
+
+  test "migration backfills account_id across all tables, drops orphans, and rolls back cleanly" do
+    with_isolated_pre_migration_db do |conn, migration|
+      account_a = gen_uuid
+      account_b = gen_uuid
