+require "application_system_test_case"
+
+class LocalizationSystemTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "switching to Japanese localizes screens and JS-rendered dates and sticks across navigation" do
+    visit root_url(locale: "ja")
+
+    assert_selector "html[lang='ja']"
+    assert_text "カードを追加"
+    assert_text "ボードを追加"
+
+    # Navigate to a card without ?locale= and verify JS local-time renders Japanese dates
+    visit card_url(cards(:logo))
+    assert_selector "html[lang='ja']"
+    assert_text "完了にする"
+
+    # Local-time <time> elements should render Japanese relative time, never English "days ago"/"today"
+    meta_text = find(".card__meta").text
+    assert_no_match(/\b(days ago|today|yesterday|Added|Updated|By)\b/i, meta_text)
+    assert_match(/(今日|昨日|\d+日前)/, meta_text)
+
+    # Unsupported locale ?locale=xx does not break the page or switch away from Japanese
+    visit board_url(boards(:writebook), locale: "xx")
+    assert_selector "html[lang='ja']"
+    assert_text "検討中？"
+  end
+end
