diff --git a/test/integration/localization_test.rb b/test/integration/localization_test.rb
new file mode 100644
index 0000000..481fd6b
--- /dev/null
+++ b/test/integration/localization_test.rb
@@ -0,0 +1,242 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "people who never chose a locale continue seeing exact English" do
+    sign_in_as :david
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "a.header__skip-navigation", text: "Skip to main content"
+    assert_select "span", text: "Add a card"
+  end
+
+  test "opening any page with ?locale=ja switches to Japanese and sticks for the session" do
+    sign_in_as :david
+
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "a.header__skip-navigation", text: "メインコンテンツへスキップ"
+    assert_select "span", text: "カードを追加"
+
+    # Sticks on subsequent pages without ?locale=
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "h2.cards__expander-title", text: /検討中？/
+    assert_select "h2.cards__expander-title", text: /今はしない/
+    assert_select "h2.cards__expander-title", text: /完了/
+
+    get account_settings_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "h1", text: /アカウント設定/
+  end
+
+  test "Japanese choice persists when signing in again from a clean browser" do
+    sign_in_as :david
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_equal "ja", identities(:david).reload.locale
+
+    # Clean browser session (no cookies, no session)
+    open_session do |clean_browser|
+      clean_browser.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+
+      # Before signing in, clean browser shows default English
+      clean_browser.get "/session/new"
+      assert_equal 200, clean_browser.response.status
+      assert_includes clean_browser.response.body, '<html lang="en">'
+
+      # Sign in as david in the clean browser
+      identities(:david).send_magic_link
+      magic_link = identities(:david).magic_links.order(id: :desc).first
+      clean_browser.post "/session", params: { email_address: identities(:david).email_address }
+      clean_browser.post "/session/magic_link", params: { code: magic_link.code }
+
+      # After signing in, Japanese is restored automatically
+      clean_browser.get "/#{ActiveRecord::FixtureSet.identify("37signals")}/"
+      assert_equal 200, clean_browser.response.status
+      assert_includes clean_browser.response.body, '<html lang="ja">'
+      assert_includes clean_browser.response.body, "メインコンテンツへスキップ"
+    end
+  end
+
+  test "choosing ?locale=ja before signing in sticks through sign-in and persists to identity" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", text: "Fizzyにサインイン"
+
+      assert_enqueued_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+      email = ActionMailer::Base.deliveries.last
+      assert_match(/Fizzy認証コード/, email.subject)
+
+      get session_magic_link_path
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", text: "メールを確認してください"
+
+      magic_link = identities(:kevin).magic_links.order(id: :desc).first
+      post session_magic_link_path, params: { code: magic_link.code }
+    end
+
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "opening redirecting root or signup with ?locale=ja preserves and persists locale" do
+    sign_in_as :david
+
+    untenanted do
+      get root_path(locale: "ja")
+      assert_redirected_to session_menu_path(script_name: nil)
+      follow_redirect!
+      follow_redirect! if response.redirect?
+      assert_response :success
+      assert_select "html[lang='ja']"
+    end
+    assert_equal "ja", identities(:david).reload.locale
+
+    # Also test unauthenticated /signup?locale=ja redirect
+    open_session do |anon|
+      anon.get "/signup?locale=ja"
+      assert_equal 301, anon.response.status
+      anon.follow_redirect!
+      assert_equal 200, anon.response.status
+      assert_includes anon.response.body, '<html lang="ja">'
+      assert_includes anon.response.body, "新規登録"
+    end
+  end
+
+  test "unsupported locale ?locale=xx never breaks a page and does not switch locale" do
+    sign_in_as :david
+
+    # From English, ?locale=xx stays English
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_nil identities(:david).reload.locale
+
+    # Malformed array param never breaks a page
+    get "#{root_path}?locale[]=ja"
+    assert_response :success
+    assert_select "html[lang='en']"
+
+    # Switch to Japanese, then ?locale=xx stays Japanese
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "switching back to English with ?locale=en sticks" do
+    sign_in_as :david
+
+    get root_path(locale: "ja")
+    assert_select "html[lang='ja']"
+
+    get root_path(locale: "en")
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_equal "en", identities(:david).reload.locale
+
+    get account_settings_path
+    assert_select "html[lang='en']"
+    assert_select "h1", text: /Account Settings/
+  end
+
+  test "signing out as Japanese user does not leak Japanese to another user on the same browser" do
+    sign_in_as :david
+    get root_path(locale: "ja")
+    assert_select "html[lang='ja']"
+
+    untenanted { delete session_path }
+
+    sign_in_as :kevin
+    get root_path
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_nil identities(:kevin).reload.locale
+  end
+
+  test "fragment caching isolates English and Japanese views" do
+    with_actionview_partial_caching do
+      sign_in_as :david
+
+      get card_path(cards(:logo))
+      assert_response :success
+      assert_select "html[lang='en']"
+      assert_includes response.body, "Card number"
+      assert_includes response.body, "Full history"
+
+      get card_path(cards(:logo), locale: "ja")
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_includes response.body, "カード番号"
+      assert_includes response.body, "すべての履歴"
+      assert_not_includes response.body, "Full history"
+
+      get card_path(cards(:logo), locale: "en")
+      assert_response :success
+      assert_select "html[lang='en']"
+      assert_includes response.body, "Full history"
+    end
+  end
+
+  test "public boards and cards support ?locale=ja with localized dates and session persistence" do
+    board = boards(:writebook)
+    board.publish
+    card = cards(:logo)
+    card.close(user: users(:david))
+
+    get public_board_path(board.publication.key, locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "h2.cards__expander-title", text: /検討中？/
+
+    # Session sticks on public card without ?locale=
+    get public_board_card_path(board.publication.key, card)
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select ".card__closed-title", text: "完了"
+    assert_select ".card__closed-date", text: I18n.with_locale(:ja) { I18n.l(card.closed_at, format: :stamp) }
+  end
+
+  test "PWA manifest is localized" do
+    sign_in_as :david
+
+    get pwa_manifest_path(format: :json)
+    assert_response :success
+    en_json = JSON.parse(response.body)
+    assert_equal "Card-up the biggest issues in your projects", en_json["description"]
+
+    get pwa_manifest_path(format: :json, locale: "ja")
+    assert_response :success
+    ja_json = JSON.parse(response.body)
+    assert_equal "プロジェクトの重要な課題をカードで管理", ja_json["description"]
+    assert_equal "通知", ja_json["shortcuts"].first["name"]
+  end
+
+  test "static error pages render in both English and Japanese" do
+    %w[ 400.html 404.html 406-unsupported-browser.html 422.html 500.html ].each do |filename|
+      html = File.read(Rails.root.join("public", filename))
+      assert_match(/Back home/, html, "#{filename} should include English text")
+      assert_match(/ホームに戻る/, html, "#{filename} should include Japanese text")
+      assert_match(/lang="ja"/, html, "#{filename} should tag Japanese text with lang='ja'")
+    end
+  end
+end
