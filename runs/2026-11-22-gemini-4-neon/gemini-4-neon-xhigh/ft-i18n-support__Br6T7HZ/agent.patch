diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..b1539e7
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,34 @@
+export function i18nData() {
+  const raw = document.body?.dataset?.i18n
+  if (!raw) return {}
+
+  try {
+    return JSON.parse(raw)
+  } catch {
+    return {}
+  }
+}
+
+export function t(path, replacements = {}) {
+  const keys = path.split(".")
+  let value = i18nData()
+
+  for (const key of keys) {
+    if (value == null || typeof value !== "object") {
+      value = undefined
+      break
+    }
+    value = value[key]
+  }
+
+  if (typeof value !== "string") return undefined
+
+  return value.replace(/%\{(\w+)\}/g, (_, key) =>
+    Object.prototype.hasOwnProperty.call(replacements, key) ? replacements[key] : `%{${key}}`
+  )
+}
+
+export function tPlural(path, count, replacements = {}) {
+  const form = count === 1 ? "one" : "other"
+  return t(`${path}.${form}`, { count, ...replacements }) || t(`${path}.other`, { count, ...replacements })
+}
