+require "test_helper"
+
+class LocalizationMailerTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @identity = @user.identity
+    @identity.update!(locale: "ja")
+  end
+
+  test "MagicLinkMailer renders in Japanese for Japanese identity even when I18n.locale is :en" do
+    magic_link = MagicLink.create!(identity: @identity, purpose: :sign_in)
+
+    email = I18n.with_locale(:en) { MagicLinkMailer.sign_in_instructions(magic_link) }
+
+    assert_equal "Fizzy認証コード: #{magic_link.code}", email.subject
+    assert_match(/<html lang="ja">/, email.html_part.decoded)
+    assert_match(/認証コードを入力してください/, email.html_part.decoded)
+    assert_match(/15分有効/, email.html_part.decoded)
+    assert_match(/15分有効/, email.text_part.decoded)
+  end
+
+  test "MagicLinkMailer for sign up renders in Japanese" do
+    magic_link = MagicLink.create!(identity: @identity, purpose: :sign_up)
+
+    email = I18n.with_locale(:en) { MagicLinkMailer.sign_in_instructions(magic_link) }
+
+    assert_match(/Fizzyへようこそ/, email.html_part.decoded)
+    assert_match(/アカウント作成を完了するため/, email.text_part.decoded)
+  end
+
+  test "AccountMailer cancellation renders in Japanese with localized duration" do
+    @account.cancel(initiated_by: @user)
+
+    email = I18n.with_locale(:en) { AccountMailer.cancellation(@account.cancellation) }
+
+    assert_equal "Fizzyアカウントが解約されました", email.subject
+    assert_match(/解約されました/, email.html_part.decoded)
+    assert_match(/約1か月後に削除されます/, email.html_part.decoded)
+    assert_match(/約1か月後に削除されます/, email.text_part.decoded)
+  end
+
+  test "ExportMailer completed renders in Japanese" do
+    export = Account::Export.create!(account: @account, user: @user)
+
+    email = I18n.with_locale(:en) { ExportMailer.completed(export) }
+
+    assert_equal "Fizzyデータのエクスポートをダウンロードできます", email.subject
+    assert_match(/ダウンロードできるようになりました/, email.html_part.decoded)
+    assert_match(/データをダウンロード/, email.text_part.decoded)
+  end
+
+  test "ImportMailer completed and failed render in Japanese" do
+    completed = I18n.with_locale(:en) { ImportMailer.completed(@identity, @account) }
+    assert_equal "Fizzyアカウントのインポートが完了しました", completed.subject
+    assert_match(/インポートが完了しました/, completed.html_part.decoded)
+    assert_match(/インポートが完了しました/, completed.text_part.decoded)
+
+    %i[ conflict invalid_export nil ].each do |reason|
+      import = Account::Import.create!(account: @account, identity: @identity, status: :failed, failure_reason: reason == :nil ? nil : reason)
+      failed = I18n.with_locale(:en) { ImportMailer.failed(import) }
+      assert_equal "Fizzyアカウントのインポートに失敗しました", failed.subject
+      assert_match(/インポートできませんでした/, failed.html_part.decoded)
+      assert_match(/インポートできませんでした/, failed.text_part.decoded)
+    end
+  end
+
+  test "UserMailer email_change_confirmation renders in Japanese" do
+    email = I18n.with_locale(:en) do
+      UserMailer.email_change_confirmation(email_address: "new@example.jp", token: "abc", user: @user)
+    end
+
+    assert_equal "新しいメールアドレスの確認", email.subject
+    assert_match(/メールアドレスの変更を確認してください/, email.decoded)
+    assert_match(/このメールアドレスを使用する/, email.decoded)
+  end
+
+  test "Notification::BundleMailer renders in Japanese with Japanese dates" do
+    @user.notifications.destroy_all
+    starts_at = Time.zone.local(2026, 3, 5, 14, 0)
+    bundle = Notification::Bundle.create!(user: @user, starts_at: starts_at, ends_at: starts_at + 4.hours)
+    Notification.create!(user: @user, creator: users(:jz), source: events(:logo_published), created_at: starts_at + 1.hour, updated_at: starts_at + 1.hour)
+
+    email = I18n.with_locale(:en) { Notification::BundleMailer.notification(bundle) }
+
+    assert_equal "Fizzy: 新しい通知があります", email.subject
+    assert_match(/3月5日\(木\) 14:00以降の通知/, email.html_part.decoded)
+    assert_match(/1件の新しい通知/, email.html_part.decoded)
+    assert_match(/3月5日\(木\) 14:00以降の通知/, email.text_part.decoded)
+    assert_match(/1件の新しい通知/, email.text_part.decoded)
+  end
+
+  test "English recipients continue receiving English emails even when I18n.locale is :ja" do
+    kevin = identities(:kevin)
+    assert_nil kevin.locale
+    magic_link = MagicLink.create!(identity: kevin, purpose: :sign_in)
+
+    email = I18n.with_locale(:ja) { MagicLinkMailer.sign_in_instructions(magic_link) }
+
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_match(/Please enter this 6-character verification code/, email.html_part.decoded)
+  end
+end
diff --git a/test/models/localization_test.rb b/test/models/localization_test.rb
new file mode 100644
index 0000000..d454918
--- /dev/null
+++ b/test/models/localization_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class LocalizationModelTest < ActiveSupport::TestCase
+  test "en and ja locale files have complete key and interpolation parity" do
+    en_all = load_locale_keys("en")
+    ja_all = load_locale_keys("ja")
+
+    rails_core_prefixes = %w[ date. datetime. errors. activerecord. activemodel. helpers.select helpers.submit number. support. time. ]
+    app_en_keys = en_all.keys.reject { |k| rails_core_prefixes.any? { |p| k.start_with?(p) } }
+    app_ja_keys = ja_all.keys.reject { |k| rails_core_prefixes.any? { |p| k.start_with?(p) } }
+
+    assert_empty app_en_keys - app_ja_keys, "Keys missing in ja"
+    assert_empty app_ja_keys - app_en_keys, "Keys missing in en"
+
+    (app_en_keys & app_ja_keys).each do |key|
+      en_vars = en_all[key].to_s.scan(/%\{(\w+)\}/).flatten.uniq.sort
+      ja_vars = ja_all[key].to_s.scan(/%\{(\w+)\}/).flatten.uniq.sort
+      assert_equal en_vars, ja_vars, "Interpolation mismatch for key #{key}"
+    end
+  end
+
+  test "models render Japanese strings under :ja locale" do
+    I18n.with_locale(:ja) do
+      assert_equal "システム", accounts(:"37s").system_user.name
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+      assert_equal "完了", Filter.indexed_by_human_name("closed")
+      assert_equal "AまたはB", %w[ A B ].to_choice_sentence
+      assert_equal "A、BまたはC", %w[ A B C ].to_choice_sentence
+
+      description = events(:logo_published).description_for(users(:david))
+      assert_includes description.to_plain_text, "追加しました"
+
+      notification = Notification.new(user: users(:david), creator: users(:jz), source: events(:logo_published), card: cards(:logo), account: accounts(:"37s"))
+      assert_includes notification.payload.body, "が追加しました"
+
+      webhook = Webhook.new(board: boards(:writebook), name: "Test", url: "not-a-url")
+      assert_not webhook.valid?
+      assert_includes webhook.errors[:url], "はhttpまたはhttpsを使用してください"
+
+      bad_webhook = Webhook.new(board: boards(:writebook), name: "Test", url: "http://[invalid")
+      assert_not bad_webhook.valid?
+      assert_includes bad_webhook.errors[:url], "は有効なURLではありません"
+    end
+  end
+
+  test "Identity validates locale against available locales" do
+    identity = identities(:david)
+    identity.locale = "ja"
+    assert identity.valid?
+
+    identity.locale = "en"
+    assert identity.valid?
+
+    identity.locale = nil
+    assert identity.valid?
+
+    identity.locale = "xx"
+    assert_not identity.valid?
+  end
+
+  private
+    def load_locale_keys(locale)
+      files = Dir[Rails.root.join("config/locales/#{locale}/*.yml")] + [ Rails.root.join("config/locales/#{locale}.yml").to_s ]
+      files.each_with_object({}) do |file, acc|
+        data = YAML.load_file(file)
+        flatten_hash(data[locale] || {}, "", acc)
+      end
+    end
+
+    def flatten_hash(hash, prefix, out)
+      hash.each do |k, v|
+        key = prefix.empty? ? k.to_s : "#{prefix}.#{k}"
+        if v.is_a?(Hash)
+          flatten_hash(v, key, out)
+        else
+          out[key] = v
+        end
+      end
+      out
+    end
+end
