diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..3ef5b0d
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,60 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :capture_locale_param
+    around_action :switch_locale
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def capture_locale_param
+      if (locale = valid_locale(params[:locale]))
+        session[:locale] = locale
+        session[:pending_locale] = locale
+        persist_pending_locale
+      end
+    end
+
+    def switch_locale(&action)
+      persist_pending_locale
+      I18n.with_locale(resolved_locale, &action)
+    end
+
+    def persist_pending_locale
+      if (identity = current_identity_for_locale) && (pending = valid_locale(session[:pending_locale]))
+        session.delete(:pending_locale)
+        session.delete(:locale)
+        persist_identity_locale(identity, pending)
+      end
+    end
+
+    def persist_identity_locale(identity, locale)
+      return if identity.locale == locale
+
+      ActiveRecord::Base.connected_to(role: :writing) do
+        identity.update(locale: locale)
+      end
+    end
+
+    def resolved_locale
+      if (identity = current_identity_for_locale)
+        valid_locale(identity.locale) || I18n.default_locale
+      else
+        valid_locale(session[:locale]) || I18n.default_locale
+      end
+    end
+
+    def current_identity_for_locale
+      Current.identity || find_session_by_cookie&.identity
+    end
+
+    def valid_locale(value)
+      return unless value.is_a?(String) || value.is_a?(Symbol)
+
+      locale = value.to_s.strip
+      locale if locale.present? && I18n.available_locales.map(&:to_s).include?(locale)
+    end
+end
