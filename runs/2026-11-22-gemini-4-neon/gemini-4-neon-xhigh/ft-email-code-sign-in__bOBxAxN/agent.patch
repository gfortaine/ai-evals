diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..cca6e04
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generates a 6-character code and 15-minute expiration on create" do
+    freeze_time do
+      magic_link = MagicLink.create!(identity: identities(:david))
+
+      assert_equal 6, magic_link.code.length
+      assert_match(/\A[0-9A-HJKMNP-TV-Z]{6}\z/, magic_link.code)
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "supports sign_up purpose" do
+    magic_link = MagicLink.create!(identity: identities(:david), purpose: :sign_up)
+
+    assert magic_link.for_sign_up?
+    assert_not magic_link.for_sign_in?
+  end
+
+  test "validates code uniqueness" do
+    existing = magic_links(:david)
+    duplicate = MagicLink.new(identity: identities(:kevin), code: existing.code)
+
+    assert_not duplicate.valid?
+    assert duplicate.errors[:code].any?
+  end
+
+  test "Code.sanitize normalizes case, removes punctuation, and substitutes ambiguous characters" do
+    assert_equal "A01K9P", MagicLink::Code.sanitize("aOIk9p")
+    assert_equal "A01K9P", MagicLink::Code.sanitize(" a0l-k9p ")
+    assert_equal "123456", MagicLink::Code.sanitize(123456)
+    assert_nil MagicLink::Code.sanitize("")
+    assert_nil MagicLink::Code.sanitize("   ")
+    assert_nil MagicLink::Code.sanitize(nil)
+    assert_nil MagicLink::Code.sanitize({ code: "ABC123" })
+  end
+
+  test "consume finds and destroys active magic link" do
+    magic_link = MagicLink.create!(identity: identities(:david))
+
+    consumed = MagicLink.consume(magic_link.code)
+
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+    assert_nil MagicLink.consume(magic_link.code), "code should only work once"
+  end
+
+  test "consume accepts lowercase, whitespace, and O/I/L substitutions" do
+    magic_link = MagicLink.create!(identity: identities(:david), code: "A01K9P")
+
+    consumed = MagicLink.consume(" aol-k9p ")
+
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume works within 15 minutes and fails after 15 minutes" do
+    magic_link = MagicLink.create!(identity: identities(:david))
+
+    travel 14.minutes + 59.seconds do
+      assert MagicLink.active.exists?(magic_link.id)
+    end
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "consume returns nil for blank or unknown codes" do
+    assert_nil MagicLink.consume(nil)
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume("ZZZZZZ")
+  end
+
+  test "scoped consume through identity only consumes that identity's magic links" do
+    davids_link = MagicLink.create!(identity: identities(:david))
+
+    assert_nil identities(:kevin).magic_links.consume(davids_link.code)
+    assert MagicLink.exists?(davids_link.id), "should not destroy another identity's magic link"
+
+    assert_equal davids_link, identities(:david).magic_links.consume(davids_link.code)
+    assert_not MagicLink.exists?(davids_link.id)
+  end
+
+  test "cleanup removes only expired magic links" do
+    active_link = MagicLink.create!(identity: identities(:david))
+    expired_link = magic_links(:expired)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active_link.id)
+    assert_not MagicLink.exists?(expired_link.id)
+  end
+end
