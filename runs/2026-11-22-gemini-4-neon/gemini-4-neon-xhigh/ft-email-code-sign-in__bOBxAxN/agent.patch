diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..a6cf86a
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,47 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), prefix: :for, default: :sign_in
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :stale, -> { where(expires_at: ...Time.current) }
+
+  before_validation :generate_code, on: :create
+  before_validation :set_expiration, on: :create
+
+  validates :code, uniqueness: true, presence: true
+
+  class << self
+    def consume(code)
+      if sanitized_code = Code.sanitize(code)
+        active.find_by(code: sanitized_code)&.consume
+      end
+    end
+
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def consume
+    if self.class.active.where(id: id).delete_all == 1
+      @destroyed = true
+      self
+    end
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate(CODE_LENGTH)
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..e1b695f
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,16 @@
+module MagicLink::Code
+  ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ" # Crockford Base32 (no I, L, O, U)
+  SUBSTITUTIONS = { "O" => "0", "I" => "1", "L" => "1" }.freeze
+
+  class << self
+    def generate(length)
+      Array.new(length) { ALPHABET[SecureRandom.random_number(ALPHABET.length)] }.join
+    end
+
+    def sanitize(code)
+      if code.is_a?(String) || code.is_a?(Integer) || code.is_a?(Symbol)
+        code.to_s.upcase.gsub(/[^A-Z0-9]/, "").gsub(/[OIL]/, SUBSTITUTIONS).presence
+      end
+    end
+  end
+end
