diff --git a/test/system/magic_link_authentication_test.rb b/test/system/magic_link_authentication_test.rb
new file mode 100644
index 0000000..866466e
--- /dev/null
+++ b/test/system/magic_link_authentication_test.rb
@@ -0,0 +1,92 @@
+require "application_system_test_case"
+
+class MagicLinkAuthenticationTest < ApplicationSystemTestCase
+  test "sign in by email code" do
+    identity = identities(:david)
+
+    visit new_session_url(script_name: nil)
+    fill_in "email_address", with: identity.email_address
+
+    perform_enqueued_jobs do
+      click_on "Let’s go"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+
+    # Wrong code keeps the user on the code screen
+    fill_in "code", with: "WRONG1"
+    click_on "Sign in"
+    assert_selector ".flash", text: "Try another code."
+    assert_selector "h1", text: "Check your email"
+
+    # Valid code (case-insensitive) signs the user in
+    fill_in "code", with: code.downcase
+    click_on "Sign in"
+
+    assert_current_path root_path
+  end
+
+  test "sign up by email code" do
+    visit new_signup_url(script_name: nil)
+    fill_in "signup_email_address", with: "browser-signup@example.com"
+
+    perform_enqueued_jobs do
+      click_on "Let’s go"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+
+    fill_in "code", with: code
+    click_on "Sign in"
+
+    assert_selector "h1", text: "Complete your sign-up"
+    fill_in "signup_full_name", with: "Browser Signer"
+    click_on "Continue"
+
+    assert_selector "h1", text: "Playground"
+
+    identity = Identity.find_by!(email_address: "browser-signup@example.com")
+    assert_equal 1, identity.accounts.count
+    assert_equal "Browser Signer", identity.users.first.name
+  end
+
+  test "join with a join code by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    visit join_url(code: join_code.code, script_name: account.slug)
+    fill_in "email_address", with: "browser-joiner@example.com"
+
+    perform_enqueued_jobs do
+      click_on "Continue"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+
+    fill_in "code", with: code
+    click_on "Sign in"
+
+    assert_selector "h1", text: "Great! Now enter your name"
+    fill_in "user_name", with: "Browser Joiner"
+    click_on "Continue"
+
+    assert_selector "h1", text: boards(:writebook).name
+
+    user = account.users.find_by!(identity: Identity.find_by!(email_address: "browser-joiner@example.com"))
+    assert user.verified?
+    assert user.setup?
+    assert_equal "Browser Joiner", user.name
+  end
+
+  private
+    def extract_code_from_last_email
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email, "Expected an email to have been sent"
+      match = email.subject.match(/\b([0-9A-Z]{6})\b/)
+      assert_not_nil match, "Expected 6-character code in subject #{email.subject.inspect}"
+      match[1]
+    end
+end
