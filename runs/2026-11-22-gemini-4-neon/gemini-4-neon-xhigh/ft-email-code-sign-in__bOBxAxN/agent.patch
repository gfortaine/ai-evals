index 0000000..bf71e7e
--- /dev/null
+++ b/app/views/sessions/magic_links/show.html.erb
@@ -0,0 +1,38 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <header>
+    <h1 class="txt-x-large font-weight-black margin-none">
+      <%= @page_title %>
+    </h1>
+    <p class="margin-block-start-half margin-block-end-half">
+      Then enter the verification code we sent to <strong><%= email_address_pending_authentication %></strong>
+    </p>
+  </header>
+
+  <%= form_with url: session_magic_link_path, method: :post, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.label :code, "Verification code", class: "for-screen-reader" %>
+    <%= form.text_field :code, required: true, class: "input center txt-align-center txt-uppercase txt-large font-weight-black",
+          autofocus: true, autocorrect: "off", autocapitalize: "characters", spellcheck: false,
+          autocomplete: "one-time-code", data: { "1p-ignore": true },
+          placeholder: "••••••", value: params[:code] %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Sign in</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle">The code sent to your email will work for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+</div>
+
+<% if Rails.env.development? && flash[:magic_link_code].present? %>
+  <div class="flex align-center justify-center gap fill-shade border-radius pad margin-block-start center txt-small">
+    <span>Code for development:</span>
+    <strong class="txt-large"><%= flash[:magic_link_code] %></strong>
+  </div>
+<% end %>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
