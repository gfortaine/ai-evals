+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "sign_in_instructions for sign_in" do
+    magic_link = MagicLink.create!(identity: identities(:david), purpose: :sign_in)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_includes email.subject, magic_link.code
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_not_nil email.html_part
+    assert_not_nil email.text_part
+    assert_includes email.html_part.body.decoded, magic_link.code
+    assert_includes email.text_part.body.decoded, magic_link.code
+    assert_includes email.html_part.body.decoded, "15 minutes"
+    assert_includes email.text_part.body.decoded, "15 minutes"
+    assert_includes email.html_part.body.decoded, "Sign in to Fizzy"
+  end
+
+  test "sign_in_instructions for sign_up" do
+    magic_link = MagicLink.create!(identity: identities(:david), purpose: :sign_up)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_includes email.subject, magic_link.code
+    assert_includes email.html_part.body.decoded, magic_link.code
+    assert_includes email.text_part.body.decoded, magic_link.code
+    assert_includes email.html_part.body.decoded, "Welcome to Fizzy!"
+    assert_includes email.text_part.body.decoded, "sign-up"
+  end
+end
