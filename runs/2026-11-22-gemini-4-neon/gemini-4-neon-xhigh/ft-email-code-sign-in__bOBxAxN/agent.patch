+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "show renders code form when pending authentication token is present" do
+    untenanted do
+      post session_path, params: { email_address: identities(:david).email_address }
+      get session_magic_link_path
+
+      assert_response :success
+      assert_select "form[action='#{session_magic_link_path}'][method='post']" do
+        assert_select "input[name='code']"
+      end
+      assert_in_body identities(:david).email_address
+    end
+  end
+
+  test "show redirects to new session when pending authentication token is missing" do
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to new_session_path
+      assert_equal "Enter your email address to sign in.", flash[:alert]
+    end
+  end
+
+  test "show redirects authenticated users" do
+    sign_in_as :kevin
+
+    untenanted do
+      get session_magic_link_path
+      assert_redirected_to root_url
+    end
+  end
+
+  test "create with valid sign-in code signs user in and consumes magic link" do
+    identity = identities(:david)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+      magic_link = MagicLink.find_by!(code: code)
+
+      assert_difference -> { Session.count }, +1 do
+        assert_difference -> { MagicLink.count }, -1 do
+          post session_magic_link_path, params: { code: code }
+        end
+      end
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+      assert_not MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "create accepts lowercase, whitespace, and ambiguous characters in code" do
+    identity = identities(:david)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      magic_link = identity.magic_links.create!(code: "A01K9P")
+
+      post session_magic_link_path, params: { code: " aol-k9p " }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "create redirects back to return_to_after_authenticating after signing in" do
+    target_url = board_url(boards(:writebook))
+
+    get target_url
+    assert_redirected_to new_session_path(script_name: nil)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path(script_name: nil), params: { email_address: identities(:david).email_address }
+      end
+
+      code = extract_code_from_last_email
+      post session_magic_link_path(script_name: nil), params: { code: code }
+
+      assert_redirected_to target_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with sign-up magic link signs user in and redirects to signup completion" do
+    untenanted do
+      perform_enqueued_jobs do
+        post signup_path, params: { signup: { email_address: "brandnew@example.com" } }
+      end
+
+      code = extract_code_from_last_email
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with wrong code redirects back and keeps pending token for retry" do
+    identity = identities(:david)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      code = extract_code_from_last_email
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "WRONG1" }
+      end
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try another code.", flash[:alert]
+      assert_not cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].present?
+
+      # Retrying with the right code still works
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with blank code redirects back with alert" do
+    untenanted do
+      post session_path, params: { email_address: identities(:david).email_address }
+
+      post session_magic_link_path, params: { code: "" }
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try another code.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create cannot use or consume another identity's code" do
+    kevins_link = MagicLink.create!(identity: identities(:kevin))
+
+    untenanted do
+      post session_path, params: { email_address: identities(:david).email_address }
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: kevins_link.code }
+      end
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(kevins_link.id), "should not consume another identity's magic link"
+    end
+  end
+
+  test "create cannot reuse an already consumed code" do
+    identity = identities(:david)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      code = extract_code_from_last_email
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      delete session_path
+      assert_not cookies[:session_token].present?
+
+      post session_path, params: { email_address: identity.email_address }
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create works just before 15 minutes and fails after 15 minutes" do
+    identity = identities(:david)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      code = extract_code_from_last_email
+
+      travel 14.minutes + 59.seconds do
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to landing_url
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects code after 15 minutes" do
+    identity = identities(:david)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      code = extract_code_from_last_email
+
+      travel 15.minutes + 1.second do
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects expired code even when a newer request refreshed the pending cookie" do
+    identity = identities(:david)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      first_code = extract_code_from_last_email
+
+      second_code = nil
+      travel 5.minutes do
+        perform_enqueued_jobs do
+          post session_path, params: { email_address: identity.email_address }
+        end
+        second_code = extract_code_from_last_email
+      end
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: first_code }
+        assert_redirected_to session_magic_link_path
+        assert_not cookies[:session_token].present?
+
+        post session_magic_link_path, params: { code: second_code }
+        assert_redirected_to landing_url
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create via JSON authenticates and returns session_token" do
+    identity = identities(:david)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }, as: :json
+      end
+
+      assert_response :created
+      code = extract_code_from_last_email
+
+      post session_magic_link_path, params: { code: code }, as: :json
+
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create via JSON returns 401 for missing pending authentication token" do
+    untenanted do
+      post session_magic_link_path, params: { code: magic_links(:david).code }, as: :json
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create via JSON returns 401 for invalid code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:david).email_address }, as: :json
+      post session_magic_link_path, params: { code: "WRONG1" }, as: :json
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON returns 401 for expired code" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:david).email_address }, as: :json
+      end
+      code = extract_code_from_last_email
+
+      travel 15.minutes + 1.second do
+        post session_magic_link_path, params: { code: code }, as: :json
+
+        assert_response :unauthorized
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: identities(:david).email_address }
+
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+
+      post session_magic_link_path, params: { code: "WRONG1" }, as: :json
+      assert_response :too_many_requests
+    end
+  end
+
+  private
+    def extract_code_from_last_email
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email, "Expected an email to have been sent"
+      match = email.subject.match(/\b([0-9A-Z]{6})\b/)
+      assert_not_nil match, "Expected 6-character code in subject #{email.subject.inspect}"
+      match[1]
+    end
+end
