+  TABLES_NEEDING_NOT_NULL = (TABLES_NEEDING_COLUMN + %i[
+    account_imports
+    account_join_codes
+    boards
+    cards
+    columns
+    comments
+    events
+    filters
+    notification_bundles
+    notifications
+    push_subscriptions
+    steps
+    tags
+    users
+    webhooks
+  ]).sort.freeze
