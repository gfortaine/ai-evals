diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..75a3301
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,251 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  test "imports valid quiz JSON preserving order, active states, and multiple correct options" do
+    json = <<~JSON
+      {
+        "title": "Frontend Fest 2026",
+        "questions": [
+          {
+            "text": "Which HTTP status code means \\"Too Many Requests\\"?",
+            "active": true,
+            "options": [
+              {"text": "418", "correct": false},
+              {"text": "429", "correct": true}
+            ]
+          },
+          {
+            "text": "Inactive question with multiple answers",
+            "active": false,
+            "options": [
+              {"text": "First", "correct": true},
+              {"text": "Second", "correct": false},
+              {"text": "Third", "correct": true},
+              {"text": "Fourth", "correct": false},
+              {"text": "Fifth", "correct": false}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    importer = QuizImport.new(json: json)
+    assert importer.import, "Expected import to succeed, errors: #{importer.errors.full_messages}"
+
+    quiz = importer.quiz
+    assert quiz.persisted?
+    assert_equal "Frontend Fest 2026", quiz.title
+
+    questions = quiz.questions.ordered.includes(:options).to_a
+    assert_equal 2, questions.size
+
+    assert_equal 'Which HTTP status code means "Too Many Requests"?', questions[0].body
+    assert_equal true, questions[0].active?
+    assert_equal 1, questions[0].position
+    assert_equal [ "418", "429" ], questions[0].options.map(&:title)
+    assert_equal [ false, true ], questions[0].options.map(&:correct?)
+    assert_equal [ 1, 2 ], questions[0].options.map(&:position)
+
+    assert_equal "Inactive question with multiple answers", questions[1].body
+    assert_equal false, questions[1].active?
+    assert_equal 2, questions[1].position
+    assert_equal [ "First", "Second", "Third", "Fourth", "Fifth" ], questions[1].options.map(&:title)
+    assert_equal [ true, false, true, false, false ], questions[1].options.map(&:correct?)
+  end
+
+  test "defaults optional active to true and optional correct to false" do
+    json = {
+      "title" => "Defaults Quiz",
+      "questions" => [
+        {
+          "text" => "Pick the right one",
+          "options" => [
+            { "text" => "Wrong by default" },
+            { "text" => "Explicitly correct", "correct" => true },
+            { "text" => "Also wrong by default" }
+          ]
+        }
+      ]
+    }.to_json
+
+    importer = QuizImport.new(json: json)
+    assert importer.import
+
+    question = importer.quiz.questions.first
+    assert_equal true, question.active?
+    assert_equal [ false, true, false ], question.options.map(&:correct?)
+
+    # Export always writes both active and correct explicitly
+    exported = JSON.parse(importer.quiz.to_export_json)
+    assert_equal [ "title", "questions" ], exported.keys
+    assert_equal [ "text", "active", "options" ], exported["questions"].first.keys
+    assert_equal true, exported["questions"].first["active"]
+    exported["questions"].first["options"].each do |opt|
+      assert_equal [ "text", "correct" ], opt.keys
+      assert_includes [ true, false ], opt["correct"]
+    end
+  end
+
+  test "always creates a new quiz even when same title exists" do
+    existing = Quiz.create!(title: "Same Title")
+    q = existing.questions.build(body: "Original Q", active: true)
+    q.save_with_options([ { title: "A", correct: true }, { title: "B", correct: false } ])
+
+    json = {
+      "title" => "Same Title",
+      "questions" => [
+        {
+          "text" => "Imported Q",
+          "options" => [
+            { "text" => "X", "correct" => false },
+            { "text" => "Y", "correct" => true }
+          ]
+        }
+      ]
+    }.to_json
+
+    importer = QuizImport.new(json: json)
+    assert_difference "Quiz.count", 1 do
+      assert importer.import
+    end
+
+    assert_not_equal existing.id, importer.quiz.id
+    assert_equal "Same Title", importer.quiz.title
+    assert_equal [ "Original Q" ], existing.reload.questions.pluck(:body)
+    assert_equal [ "Imported Q" ], importer.quiz.questions.pluck(:body)
+  end
+
+  test "allows importing an empty quiz with zero questions" do
+    importer = QuizImport.new(json: '{"title": "Empty Quiz", "questions": []}')
+    assert importer.import
+    assert_equal "Empty Quiz", importer.quiz.title
+    assert_equal 0, importer.quiz.questions.count
+  end
+
+  test "round-trip export then import then export produces identical JSON" do
+    quiz = Quiz.create!(title: "Roundtrip & <Special> \"Chars\"")
+    q1 = quiz.questions.build(body: "Line 1\nLine 2 </pre><script>alert(1)</script>", active: false)
+    q1.save_with_options([
+      { title: "Alpha", correct: false },
+      { title: "Beta & Gamma", correct: true },
+      { title: "Delta", correct: true }
+    ])
+    q2 = quiz.questions.build(body: "Second?", active: true)
+    q2.save_with_options([
+      { title: "Yes", correct: true },
+      { title: "No", correct: false }
+    ])
+
+    first_export = quiz.to_export_json
+    importer = QuizImport.new(json: first_export)
+    assert importer.import
+
+    second_export = importer.quiz.to_export_json
+    assert_equal first_export, second_export
+  end
+
+  test "rejects invalid JSON and malformed top-level values without creating anything" do
+    invalid_inputs = [
+      "",
+      "   \n\t  ",
+      "{not json",
+      '{"title": "Trailing comma", "questions": [],}',
+      "[]",
+      '"just a string"',
+      "123",
+      "true",
+      "null",
+      "{}"
+    ]
+
+    invalid_inputs.each do |raw|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Should not import: #{raw.inspect}" do
+        importer = QuizImport.new(json: raw)
+        assert_not importer.import, "Expected failure for #{raw.inspect}"
+        assert importer.errors.any?, "Expected errors for #{raw.inspect}"
+        assert_nil importer.quiz
+      end
+    end
+  end
+
+  test "rejects invalid title and questions structure without creating anything" do
+    invalid_payloads = [
+      { "questions" => [] },
+      { "title" => nil, "questions" => [] },
+      { "title" => "   ", "questions" => [] },
+      { "title" => 123, "questions" => [] },
+      { "title" => [ "a" ], "questions" => [] },
+      { "title" => "Valid" },
+      { "title" => "Valid", "questions" => nil },
+      { "title" => "Valid", "questions" => "not-an-array" },
+      { "title" => "Valid", "questions" => {} },
+      { "title" => "Valid", "questions" => [ "not-an-object" ] },
+      { "title" => "Valid", "questions" => [ nil ] }
+    ]
+
+    invalid_payloads.each do |payload|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Should not import: #{payload.inspect}" do
+        importer = QuizImport.new(json: payload.to_json)
+        assert_not importer.import, "Expected failure for #{payload.inspect}"
+        assert importer.errors.any?
+        assert_nil importer.quiz
+      end
+    end
+  end
+
+  test "rejects question rule violations and imports nothing atomically" do
+    valid_question = {
+      "text" => "Valid question 1",
+      "active" => true,
+      "options" => [
+        { "text" => "Right", "correct" => true },
+        { "text" => "Wrong", "correct" => false }
+      ]
+    }
+
+    bad_questions = [
+      # Missing / blank / non-string question text
+      { "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "   ", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => 42, "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      # Non-boolean active
+      { "text" => "Q", "active" => "true", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "Q", "active" => "false", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "Q", "active" => 1, "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "Q", "active" => nil, "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      # Missing / non-array / too few options
+      { "text" => "Q" },
+      { "text" => "Q", "options" => nil },
+      { "text" => "Q", "options" => {} },
+      { "text" => "Q", "options" => [] },
+      { "text" => "Q", "options" => [ { "text" => "Only one", "correct" => true } ] },
+      # No correct option (explicit false or omitted)
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => false }, { "text" => "B", "correct" => false } ] },
+      { "text" => "Q", "options" => [ { "text" => "A" }, { "text" => "B" } ] },
+      # Invalid option object / text / correct type
+      { "text" => "Q", "options" => [ "A", "B" ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => "" } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => "   " } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "correct" => false } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => 123 } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => "true" }, { "text" => "B" } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B", "correct" => nil } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => 1 }, { "text" => "B" } ] }
+    ]
+
+    bad_questions.each_with_index do |bad_q, idx|
+      payload = {
+        "title" => "Atomic Test Quiz #{idx}",
+        "questions" => [ valid_question, bad_q ]
+      }
+
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Case #{idx} should import nothing: #{bad_q.inspect}" do
+        importer = QuizImport.new(json: payload.to_json)
+        assert_not importer.import, "Case #{idx} should fail: #{bad_q.inspect}"
+        assert importer.errors.any?, "Case #{idx} should have errors"
+        assert_nil importer.quiz
+      end
+    end
+  end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
