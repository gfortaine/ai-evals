+require "test_helper"
+
+class GameTimerTest < ActiveSupport::TestCase
+  include ApplicationHelper
+
+  setup do
+    @quiz = Quiz.create!(title: "Timed Conference Quiz", timer_minutes: 0, timer_seconds: 5)
+    @q1 = @quiz.questions.build(body: "First timed question?", active: true)
+    assert @q1.save_with_options([
+      { title: "Correct 1", correct: true },
+      { title: "Wrong 1", correct: false }
+    ])
+    @q2 = @quiz.questions.build(body: "Second timed question?", active: true)
+    assert @q2.save_with_options([
+      { title: "Correct 2", correct: true },
+      { title: "Wrong 2", correct: false }
+    ])
+  end
+
+  test "0 minutes and 0 seconds creates an untimed game with no closes_at or timer payload" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    game = Game.create_for_quiz!(@quiz)
+
+    assert_equal 0, game.timer_duration_seconds
+    assert_not game.timer_enabled?
+
+    assert game.start!
+    gq1 = game.current_question
+    assert_nil gq1.closes_at
+    assert_not GameTimer.scheduled?(game.id)
+    assert_nil game.moderator_state[:timer]
+
+    travel 2.hours do
+      assert_not game.expire_question_if_due!
+      assert_equal "question", game.reload.status
+    end
+  end
+
+  test "game snapshots timer duration and sets closes_at per question on start and next" do
+    game = Game.create_for_quiz!(@quiz)
+    assert_equal 5, game.timer_duration_seconds
+    assert game.timer_enabled?
+
+    # Later edits to quiz timer do not affect existing game snapshot
+    @quiz.update!(timer_minutes: 2, timer_seconds: 0)
+    assert_equal 5, game.reload.timer_duration_seconds
+
+    # In lobby, no timer payload and no closes_at
+    assert_nil game.moderator_state[:timer]
+    assert_nil game.game_questions.first.closes_at
+
+    travel_to Time.zone.parse("2026-11-20 12:00:00") do
+      assert game.start!
+      gq1 = game.current_question
+      assert_equal Time.zone.parse("2026-11-20 12:00:00"), gq1.opened_at
+      assert_equal Time.zone.parse("2026-11-20 12:00:05"), gq1.closes_at
+      assert GameTimer.scheduled?(game.id)
+
+      mod_state = game.moderator_state
+      assert_equal 5, mod_state[:timer][:duration_seconds]
+      assert_equal 5000, mod_state[:timer][:remaining_ms]
+
+      # Player state NEVER contains timer data
+      player = game.players.create!(name: "Alice")
+      p_broadcast = game.player_broadcast_state
+      p_state = game.player_state(player)
+      assert_not p_broadcast.key?(:timer)
+      assert_not p_state.key?(:timer)
+      assert_not p_state[:question].key?(:closes_at)
+
+      # Early finish cancels timer and hides timer payload
+      travel 2.seconds
+      assert_equal 3000, game.moderator_state[:timer][:remaining_ms]
+      assert game.finish_question!
+      assert_equal "reveal", game.status
+      assert_not GameTimer.scheduled?(game.id)
+      assert_nil game.moderator_state[:timer]
+
+      # Next question starts a fresh 5-second timer from now (12:00:02 -> 12:00:07)
+      assert game.next_question!
+      gq2 = game.current_question
+      assert_equal 2, gq2.position
+      assert_equal Time.zone.parse("2026-11-20 12:00:02"), gq2.opened_at
+      assert_equal Time.zone.parse("2026-11-20 12:00:07"), gq2.closes_at
+      assert GameTimer.scheduled?(game.id)
+      assert_equal 5000, game.moderator_state[:timer][:remaining_ms]
+    end
+  end
+
+  test "expire_question_if_due! finishes question at deadline and record_answer! rejects late picks" do
+    game = Game.create_for_quiz!(@quiz)
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+    gq1 = game.game_questions.first
+    right_opt = gq1.game_options.find_by!(correct: true)
+    wrong_opt = gq1.game_options.find_by!(correct: false)
+
+    travel_to Time.zone.parse("2026-11-20 12:00:00") do
+      assert game.start!
+
+      # Before deadline: Alice's answer is accepted
+      travel 4.seconds
+      assert_not game.expire_question_if_due!
+      res = game.record_answer!(player: alice, game_question_id: gq1.id, game_option_id: right_opt.id)
+      assert res[:ok]
+      assert_equal 1, game.answers.count
+
+      # At deadline (5.0s elapsed): Bob's late answer is rejected AND auto-finishes question
+      travel 1.second
+      late_res = game.record_answer!(player: bob, game_question_id: gq1.id, game_option_id: wrong_opt.id)
+      assert_not late_res[:ok]
+      assert_equal "reveal", late_res[:state][:status]
+      assert_equal "no_answer", late_res[:state][:result]
+      assert_equal "reveal", game.reload.status
+      assert_equal 1, game.answers.count
+
+      # Alice's earlier answer is preserved and marked correct
+      alice_state = game.player_state(alice)
+      assert_equal "reveal", alice_state[:status]
+      assert_equal "correct", alice_state[:result]
+    end
+  end
+
+  test "end_game! cancels scheduled timer" do
+    game = Game.create_for_quiz!(@quiz)
+    assert game.start!
+    assert GameTimer.scheduled?(game.id)
+
+    assert game.end_game!
+    assert_not GameTimer.scheduled?(game.id)
+  end
+
+  test "format_timer formats M:SS using ceiling and clamps to max_seconds" do
+    assert_equal "1:30", format_timer(90_000, max_seconds: 90)
+    assert_equal "1:30", format_timer(89_001, max_seconds: 90)
+    assert_equal "1:30", format_timer(90_200, max_seconds: 90)
+    assert_equal "1:29", format_timer(89_000, max_seconds: 90)
+    assert_equal "1:00", format_timer(60_000, max_seconds: 90)
+    assert_equal "0:59", format_timer(59_000, max_seconds: 90)
+    assert_equal "0:05", format_timer(5_000, max_seconds: 5)
+    assert_equal "0:05", format_timer(4_001, max_seconds: 5)
+    assert_equal "0:01", format_timer(1, max_seconds: 5)
+    assert_equal "0:00", format_timer(0, max_seconds: 5)
+    assert_equal "0:00", format_timer(-500, max_seconds: 5)
+    assert_equal "10:05", format_timer(605_000, max_seconds: 605)
+  end
+end
