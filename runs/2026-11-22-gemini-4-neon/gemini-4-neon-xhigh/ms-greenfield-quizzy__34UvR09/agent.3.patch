@@ -0,0 +1,71 @@
+require "test_helper"
+
+class GameChannelsTest < ActionCable::Channel::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Channel Security Quiz")
+    q = @quiz.questions.build(body: "Is Ruby fun?", active: true)
+    assert q.save_with_options([
+      { title: "Yes", correct: true },
+      { title: "No", correct: false }
+    ])
+    @game = Game.create_for_quiz!(@quiz)
+    @player = @game.players.create!(name: "Alice")
+  end
+
+  test "ModeratorGameChannel rejects missing, forged, or player tokens and accepts valid moderator token" do
+    self.class.tests ModeratorGameChannel
+
+    subscribe
+    assert subscription.rejected?
+
+    subscribe(token: "forged-token")
+    assert subscription.rejected?
+
+    # Player's signed token must NOT grant access to ModeratorGameChannel
+    subscribe(token: @player.stream_token)
+    assert subscription.rejected?
+
+    subscribe(token: @game.moderator_stream_token)
+    assert subscription.confirmed?
+    assert_has_stream Game.moderator_stream_name(@game.id)
+    assert_equal "lobby", transmissions.last["status"]
+  end
+
+  test "PlayerGameChannel rejects invalid or moderator tokens, tracks presence, and never leaks correct before reveal" do
+    self.class.tests PlayerGameChannel
+
+    subscribe
+    assert subscription.rejected?
+
+    subscribe(token: @game.moderator_stream_token)
+    assert subscription.rejected?
+
+    @game.start!
+    subscribe(token: @player.stream_token, tab_id: "tab-a")
+    assert subscription.confirmed?
+    assert_has_stream Game.players_stream_name(@game.id)
+    assert_has_stream Game.player_stream_name(@game.id, @player.id)
+    assert_equal 1, GamePresence.player_count(@game.id)
+
+    payload = transmissions.last
+    assert_equal "question", payload["status"]
+    payload["question"]["options"].each do |opt|
+      assert_not opt.key?("correct")
+    end
+
+    unsubscribe
+    assert_equal 0, GamePresence.player_count(@game.id)
+  end
+
+  test "JoinStatusChannel streams join status without registering presence" do
+    self.class.tests JoinStatusChannel
+
+    subscribe(code: "NOPE1")
+    assert subscription.rejected?
+
+    subscribe(code: @game.code)
+    assert subscription.confirmed?
+    assert_has_stream Game.join_status_stream_name(@game.id)
+    assert_equal 0, GamePresence.player_count(@game.id)
+  end
+end
diff --git a/test/integration/live_game_flow_test.rb b/test/integration/live_game_flow_test.rb
new file mode 100644
index 0000000..4e224e6
--- /dev/null
+++ b/test/integration/live_game_flow_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class LiveGameFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Integration Talk")
+    q1 = @quiz.questions.build(body: "What port does HTTP use?", active: true)
+    assert q1.save_with_options([
+      { title: "80", correct: true },
+      { title: "22", correct: false },
+      { title: "5432", correct: false }
+    ])
+  end
+
+  test "moderator game endpoints require basic auth while player endpoints are public" do
+    game = Game.create_for_quiz!(@quiz)
+
+    post moderate_quiz_games_path(@quiz)
+    assert_response :unauthorized
+
+    get moderate_game_path(game)
+    assert_response :unauthorized
+
+    post start_moderate_game_path(game)
+    assert_response :unauthorized
+
+    get state_moderate_game_path(game)
+    assert_response :unauthorized
+
+    # Player join link works without any auth
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "Your name"
+    assert_includes response.body, "Join"
+
+    # Case-insensitive code works too
+    get play_path(game.code.downcase)
+    assert_response :success
+
+    # Unknown code returns 404
+    get play_path("ZZZZZ")
+    assert_response :not_found
+  end
+
+  test "player page source and state JSON never leak correct answer before Finish" do
+    game = Game.create_for_quiz!(@quiz)
+
+    # Join as Alice
+    post play_join_path(game.code), params: { player: { name: "Alice" } }
+    assert_redirected_to play_path(game.code)
+    follow_redirect!
+    assert_response :success
+    assert_includes response.body, "Hi, Alice!"
+    assert_not_includes response.body, '"correct"'
+
+    # Moderator starts game
+    post start_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+
+    # Player reloads during open question -> page source must not reveal correct option
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "What port does HTTP use?"
+    assert_includes response.body, "80"
+    assert_includes response.body, "22"
+    assert_not_includes response.body, '"correct"'
+    assert_not_includes response.body, "is-correct"
+    assert_not_includes response.body, "data-correct"
+
+    # Player state JSON must not contain correct flag
+    get play_state_path(game.code), as: :json
+    assert_response :success
+    json = JSON.parse(response.body)
+    assert_equal "question", json["status"]
+    json["question"]["options"].each do |opt|
+      assert_not opt.key?("correct"), "Option leaked correct key before reveal!"
+    end
+
+    # Player submits answer
+    gq = game.reload.current_question
+    wrong_opt = gq.game_options.find_by!(title: "22")
+    right_opt = gq.game_options.find_by!(title: "80")
+
+    post play_answer_path(game.code),
+      params: { game_question_id: gq.id, game_option_id: wrong_opt.id },
+      as: :json
+    assert_response :success
+
+    # Moderator closes question
+    post finish_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+
+    # Late answer change is rejected with 409 and returns reveal state
+    post play_answer_path(game.code),
+      params: { game_question_id: gq.id, game_option_id: right_opt.id },
+      as: :json
+    assert_response :conflict
+    conflict_json = JSON.parse(response.body)
+    assert_equal false, conflict_json["ok"]
+    assert_equal "reveal", conflict_json["state"]["status"]
+    assert_equal "wrong", conflict_json["state"]["result"]
+
+    # Moderator ends game
+    post end_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+
+    # Player sees "The quiz is over"
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "The quiz is over"
+  end
+
+  test "join validates blank name, allows duplicate names, remembers browser, and blocks join after end" do
+    game = Game.create_for_quiz!(@quiz)
+
+    # Blank name rejected
+    post play_join_path(game.code), params: { player: { name: "   " } }
+    assert_response :unprocessable_entity
+    assert_equal 0, game.players.count
+
+    # Valid join
+    post play_join_path(game.code), params: { player: { name: "Alice" } }
+    assert_redirected_to play_path(game.code)
+    assert_equal 1, game.players.count
+
+    # Reopening join link in same session remembers Alice without creating duplicate player
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "Hi, Alice!"
+    assert_not_includes response.body, "Your name"
+
+    # Second browser session with same name "Alice" is allowed
+    open_session do |s2|
+      s2.post play_join_path(game.code), params: { player: { name: "Alice" } }
+      s2.assert_redirected_to play_path(game.code)
+    end
+    assert_equal 2, game.players.count
+
+    # End game -> new visitor cannot join
+    game.end_game!
+    open_session do |s3|
+      s3.get play_path(game.code)
+      s3.assert_response :success
+      assert_includes s3.response.body, "The quiz is over"
+      assert_not_includes s3.response.body, "Your name"
+
+      s3.post play_join_path(game.code), params: { player: { name: "Latecomer" } }
+      s3.assert_redirected_to play_path(game.code)
+    end
+    assert_equal 2, game.players.count
+  end
+
+  test "big screen renders plain-text join URL and inline SVG QR code matching it" do
+    post moderate_quiz_games_path(@quiz), headers: basic_auth_headers
+    game = Game.last
+    assert_redirected_to moderate_game_path(game)
+
+    follow_redirect!(headers: basic_auth_headers)
+    assert_response :success
+
+    expected_url = "http://www.example.com/play/#{game.code}"
+    assert_includes response.body, expected_url
+    assert_includes response.body, "<svg"
+    assert_includes response.body, 'fill="#ffffff"'
+    assert_includes response.body, "Players:"
+  end
+end
diff --git a/test/models/game_presence_test.rb b/test/models/game_presence_test.rb
new file mode 100644
index 0000000..62e85ea
--- /dev/null
+++ b/test/models/game_presence_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class GamePresenceTest < ActiveSupport::TestCase
+  test "tracks distinct players across multiple tabs and isolates games" do
+    count, changed = GamePresence.register(10, 100, "tab-1")
+    assert_equal 1, count
+    assert changed
+
+    # Same player in second tab does not double-count
+    count, changed = GamePresence.register(10, 100, "tab-2")
+    assert_equal 1, count
+    assert_not changed
+
+    # Second player increments count
+    count, changed = GamePresence.register(10, 101, "tab-3")
+    assert_equal 2, count
+    assert changed
+
+    # Other game is independent
+    count_other, changed_other = GamePresence.register(20, 200, "tab-4")
+    assert_equal 1, count_other
+    assert changed_other
+    assert_equal 2, GamePresence.player_count(10)
+
+    # Closing one of Alice's two tabs keeps count at 2
+    count, changed = GamePresence.unregister(10, 100, "tab-1")
+    assert_equal 2, count
+    assert_not changed
+
+    # Closing Alice's second tab drops count to 1
+    count, changed = GamePresence.unregister(10, 100, "tab-2")
+    assert_equal 1, count
+    assert changed
+  end
+
+  test "reap_expired! evicts stale connections" do
+    GamePresence.register(10, 100, "tab-short", ttl: 0.01)
+    GamePresence.register(10, 101, "tab-long", ttl: 30.0)
+    assert_equal 2, GamePresence.player_count(10)
+
+    sleep 0.03
+    changes = GamePresence.reap_expired!
+    assert_equal [ [ 10, 1 ] ], changes
+    assert_equal 1, GamePresence.player_count(10)
+  end
+end
