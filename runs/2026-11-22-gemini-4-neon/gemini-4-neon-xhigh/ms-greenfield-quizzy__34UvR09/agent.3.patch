diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..e9fd3f7
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,83 @@
+<% content_for :title, "Quizzy · #{@game.quiz.title}" %>
+<% state = @initial_state %>
+<% q = state[:question] %>
+
+<div
+  class="<%= big_screen_cover_class(state[:status]) %>"
+  data-controller="moderator-game"
+  data-moderator-game-stream-token-value="<%= @stream_token %>"
+  data-moderator-game-state-url-value="<%= state_moderate_game_path(@game) %>"
+  data-moderator-game-start-url-value="<%= start_moderate_game_path(@game) %>"
+  data-moderator-game-finish-url-value="<%= finish_moderate_game_path(@game) %>"
+  data-moderator-game-next-url-value="<%= next_moderate_game_path(@game) %>"
+  data-moderator-game-end-url-value="<%= end_moderate_game_path(@game) %>"
+  data-moderator-game-initial-state-value="<%= state.to_json %>"
+>
+  <div class="screen">
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span><%= @game.quiz.title %></span>
+    </div>
+
+    <div class="screen__body">
+      <div class="lobby" data-moderator-game-target="lobbyView" <%= "hidden" unless state[:status] == "lobby" %>>
+        <div>
+          <h1 class="lobby__title"><%= @game.quiz.title %></h1>
+          <div class="lobby__join">Join at</div>
+          <div class="lobby__url" data-moderator-game-target="joinUrl"><%= @join_url %></div>
+          <div class="counter-pill">
+            <span>Players: <strong data-moderator-game-target="playersCount"><%= state[:players_count] %></strong></span>
+          </div>
+        </div>
+        <div class="qr" role="img" aria-label="QR code to join the game">
+          <%= @qr_svg.html_safe %>
+        </div>
+      </div>
+
+      <div data-moderator-game-target="questionView" <%= "hidden" unless state[:status] == "question" || state[:status] == "reveal" %>>
+        <div class="stage-question__num" data-moderator-game-target="progress">
+          <% if q %>Question <%= q[:position] %> of <%= q[:total] %><% end %>
+        </div>
+        <div class="stage-question__body" data-moderator-game-target="questionBody"><%= q[:body] if q %></div>
+        <ol class="stage-options <%= "stage-options--results" if state[:status] == "reveal" %>" data-moderator-game-target="options">
+          <% if q %>
+            <% q[:options].each_with_index do |opt, idx| %>
+              <li class="stage-option <%= "is-correct" if state[:status] == "reveal" && opt[:correct] %>">
+                <% if state[:status] == "reveal" %>
+                  <span class="stage-option__bar" style="--share: <%= opt[:share] %>%"></span>
+                <% end %>
+                <span class="stage-option__letter" aria-hidden="true"><%= option_letter(idx) %></span>
+                <span class="stage-option__title"><%= opt[:title] %></span>
+                <% if state[:status] == "reveal" %>
+                  <% if opt[:correct] %>
+                    <span class="stage-option__mark">Correct</span>
+                  <% end %>
+                  <span class="stage-option__count"><%= opt[:count] %></span>
+                <% end %>
+              </li>
+            <% end %>
+          <% end %>
+        </ol>
+      </div>
+
+      <div class="screen__ended" data-moderator-game-target="endedView" <%= "hidden" unless state[:status] == "ended" %>>
+        <div class="screen__kicker"><%= @game.quiz.title %></div>
+        <h1 class="lobby__title">The quiz is over</h1>
+      </div>
+    </div>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz) %>
+      <span class="answers-counter" data-moderator-game-target="answersCounter" <%= "hidden" unless state[:status] == "question" %>>Answers: <%= state[:answers_count] %> / <%= state[:players_count] %></span>
+    </div>
+
+    <div class="buttons">
+      <button type="button" class="btn btn--pink btn--lg" data-moderator-game-target="startButton" data-action="moderator-game#start" <%= "hidden" unless state[:status] == "lobby" %>>Start</button>
+      <button type="button" class="btn btn--pink btn--lg" data-moderator-game-target="finishButton" data-action="moderator-game#finish" <%= "hidden" unless state[:status] == "question" %>>Finish</button>
+      <button type="button" class="btn btn--pink btn--lg" data-moderator-game-target="nextButton" data-action="moderator-game#next" <%= "hidden" unless state[:status] == "reveal" && !state[:is_last_question] %>>Next</button>
+      <button type="button" class="btn btn--pink btn--lg" data-moderator-game-target="endButton" data-action="moderator-game#end" <%= "hidden" unless state[:status] == "reveal" && state[:is_last_question] %>>End quiz</button>
+    </div>
+  </div>
+</div>
