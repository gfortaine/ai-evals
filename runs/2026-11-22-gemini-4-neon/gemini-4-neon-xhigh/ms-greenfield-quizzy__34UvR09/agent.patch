+<% form_url = question.persisted? ? moderate_quiz_question_path(quiz, question) : moderate_quiz_questions_path(quiz) %>
+
+<div class="card" data-controller="option-rows">
+  <%= form_with model: [ :moderate, quiz, question ], url: form_url do |f| %>
+    <% if question.errors.any? %>
+      <div class="errors" role="alert">
+        <% if question.errors.full_messages.size == 1 %>
+          <%= question.errors.full_messages.first %>
+        <% else %>
+          <ul>
+            <% question.errors.full_messages.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        <% end %>
+      </div>
+    <% end %>
+
+    <div class="field">
+      <%= f.label :body, "Question" %>
+      <%= f.text_area :body, class: "input", rows: 3, "aria-required": "true" %>
+    </div>
+
+    <div class="field">
+      <span class="field-label">Options</span>
+      <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+    </div>
+
+    <div class="option-rows" data-option-rows-target="list">
+      <% question.form_option_rows.each_with_index do |row, index| %>
+        <%= render "option_row", row: row, index: index %>
+      <% end %>
+    </div>
+
+    <div class="buttons" style="margin-bottom: 28px">
+      <button type="button" class="btn btn--ghost btn--sm btn--add-option" data-action="option-rows#add">Add option</button>
+    </div>
+
+    <div class="field">
+      <label class="checkbox">
+        <%= f.check_box :active %>
+        Active
+      </label>
+      <span class="field-hint">Only active questions are played.</span>
+    </div>
+
+    <div class="buttons">
+      <%= f.submit "Save question", class: "btn btn--pink" %>
+      <%= link_to "Cancel", moderate_quiz_path(quiz), class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+
+  <template data-option-rows-target="template">
+    <%= render "option_row", row: { title: "", correct: false }, index: 0 %>
+  </template>
+</div>
