+class Quiz < ApplicationRecord
+  MAX_TIMER_VALUE = 100_000
+
+  has_many :games, dependent: :destroy
+  has_many :questions, -> { order(:position, :id) }, dependent: :destroy
+
+  normalizes :title, with: ->(title) { title.strip }
+
+  validates :title, presence: true
+  validates :number_of_winners,
+    presence: true,
+    numericality: { only_integer: true, greater_than_or_equal_to: 1, allow_blank: true }
+  validates :timer_minutes,
+    presence: true,
+    numericality: {
+      only_integer: true,
+      greater_than_or_equal_to: 0,
+      less_than_or_equal_to: MAX_TIMER_VALUE,
+      allow_blank: true
+    }
+  validates :timer_seconds,
+    presence: true,
+    numericality: {
+      only_integer: true,
+      greater_than_or_equal_to: 0,
+      less_than_or_equal_to: MAX_TIMER_VALUE,
+      allow_blank: true
+    }
+
+  def timer_duration_seconds
+    timer_minutes.to_i * 60 + timer_seconds.to_i
+  end
+
+  def timer_enabled?
+    timer_duration_seconds.positive?
+  end
+
+  def active_questions
+    questions.active.ordered.includes(:options)
+  end
+
+  def export_data
+    {
+      "title" => title,
+      "questions" => questions.ordered.includes(:options).map do |question|
+        {
+          "text" => question.body,
+          "active" => question.active?,
+          "options" => question.options.map do |option|
+            {
+              "text" => option.title,
+              "correct" => option.correct?
+            }
+          end
+        }
+      end
+    }
+  end
+
+  def to_export_json
+    JSON.pretty_generate(export_data)
+  end
+end
diff --git a/app/models/quiz_import.rb b/app/models/quiz_import.rb
new file mode 100644
index 0000000..7c13bef
--- /dev/null
+++ b/app/models/quiz_import.rb
@@ -0,0 +1,189 @@
+class QuizImport
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  attribute :json, :string
+  attr_reader :quiz
+
+  def import
+    return false unless parse_and_validate
+
+    Quiz.transaction do
+      @quiz = Quiz.create!(title: @parsed_title)
+      @parsed_questions.each_with_index do |question_data, q_index|
+        question = @quiz.questions.create!(
+          body: question_data[:text],
+          active: question_data[:active],
+          position: q_index + 1
+        )
+        question_data[:options].each_with_index do |option_data, o_index|
+          question.options.create!(
+            title: option_data[:text],
+            correct: option_data[:correct],
+            position: o_index + 1
+          )
+        end
+      end
+    end
+
+    true
+  rescue ActiveRecord::RecordInvalid => e
+    @quiz = nil
+    errors.add(:base, e.record.errors.full_messages.to_sentence)
+    false
+  end
+
+  private
+
+  def parse_and_validate
+    errors.clear
+    @parsed_title = nil
+    @parsed_questions = []
+
+    raw = json.to_s
+    if raw.strip.empty?
+      errors.add(:base, "Quiz JSON can't be blank")
+      return false
+    end
+
+    begin
+      data = JSON.parse(raw)
+    rescue JSON::JSONError => e
+      errors.add(:base, "Invalid JSON: #{e.message}")
+      return false
+    end
+
+    unless data.is_a?(Hash)
+      errors.add(:base, "Quiz JSON must be a JSON object")
+      return false
+    end
+
+    validate_title(data)
+    validate_questions(data)
+
+    errors.empty?
+  end
+
+  def validate_title(data)
+    title = data["title"]
+    if !data.key?("title") || title.nil?
+      errors.add(:base, "Title can't be blank")
+    elsif !title.is_a?(String)
+      errors.add(:base, "Title must be a string")
+    elsif title.strip.empty?
+      errors.add(:base, "Title can't be blank")
+    else
+      @parsed_title = title.strip
+    end
+  end
+
+  def validate_questions(data)
+    unless data.key?("questions") && data["questions"].is_a?(Array)
+      errors.add(:base, "Questions must be an array")
+      return
+    end
+
+    data["questions"].each_with_index do |raw_question, index|
+      parsed = parse_question(raw_question, index + 1)
+      @parsed_questions << parsed if parsed
+    end
+  end
+
+  def parse_question(raw_question, number)
+    unless raw_question.is_a?(Hash)
+      errors.add(:base, "Question #{number}: must be an object")
+      return nil
+    end
+
+    error_count_before = errors.size
+
+    text = parse_question_text(raw_question, number)
+    active = parse_boolean_field(raw_question, "active", default: true, label: "Question #{number}: active")
+    options = parse_options(raw_question, number)
+
+    return nil if errors.size > error_count_before
+
+    { text: text, active: active, options: options }
+  end
+
+  def parse_question_text(raw_question, number)
+    text = raw_question["text"]
+    if !raw_question.key?("text") || text.nil?
+      errors.add(:base, "Question #{number}: text can't be blank")
+      nil
+    elsif !text.is_a?(String)
+      errors.add(:base, "Question #{number}: text must be a string")
+      nil
+    elsif text.strip.empty?
+      errors.add(:base, "Question #{number}: text can't be blank")
+      nil
+    else
+      text.strip
+    end
+  end
+
+  def parse_options(raw_question, question_number)
+    unless raw_question.key?("options") && raw_question["options"].is_a?(Array)
+      errors.add(:base, "Question #{question_number}: options must be an array")
+      return []
+    end
+
+    raw_options = raw_question["options"]
+    parsed_options = []
+    option_errors_before = errors.size
+
+    raw_options.each_with_index do |raw_option, opt_index|
+      option_number = opt_index + 1
+      unless raw_option.is_a?(Hash)
+        errors.add(:base, "Question #{question_number}, option #{option_number}: must be an object")
+        next
+      end
+
+      text = parse_option_text(raw_option, question_number, option_number)
+      correct = parse_boolean_field(
+        raw_option,
+        "correct",
+        default: false,
+        label: "Question #{question_number}, option #{option_number}: correct"
+      )
+
+      parsed_options << { text: text, correct: correct } if text && !correct.nil?
+    end
+
+    if raw_options.size < 2
+      errors.add(:base, "Question #{question_number}: add at least two options")
+    end
+
+    if errors.size == option_errors_before && parsed_options.none? { |opt| opt[:correct] }
+      errors.add(:base, "Question #{question_number}: mark at least one option as correct")
+    end
+
+    parsed_options
+  end
+
+  def parse_option_text(raw_option, question_number, option_number)
+    text = raw_option["text"]
+    if !raw_option.key?("text") || text.nil?
+      errors.add(:base, "Question #{question_number}, option #{option_number}: text can't be blank")
+      nil
+    elsif !text.is_a?(String)
+      errors.add(:base, "Question #{question_number}, option #{option_number}: text must be a string")
+      nil
+    elsif text.strip.empty?
+      errors.add(:base, "Question #{question_number}, option #{option_number}: text can't be blank")
+      nil
+    else
+      text.strip
+    end
+  end
+
+  def parse_boolean_field(hash, key, default:, label:)
+    return default unless hash.key?(key)
+
+    value = hash[key]
+    return value if value == true || value == false
+
+    errors.add(:base, "#{label} must be true or false")
+    nil
+  end
+end
