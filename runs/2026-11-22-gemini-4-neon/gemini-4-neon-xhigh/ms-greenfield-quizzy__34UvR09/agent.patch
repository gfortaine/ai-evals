+require "test_helper"
+require "capybara/cuprite"
+
+Capybara.register_driver(:cuprite_chromium) do |app|
+  Capybara::Cuprite::Driver.new(
+    app,
+    browser_path: "/usr/bin/chromium",
+    headless: true,
+    window_size: [ 1280, 900 ],
+    browser_options: {
+      "no-sandbox" => nil,
+      "disable-dev-shm-usage" => nil
+    },
+    timeout: 15,
+    process_timeout: 20
+  )
+end
+
+class ApplicationSystemTestCase < ActionDispatch::SystemTestCase
+  driven_by :cuprite_chromium
+
+  setup do
+    page.driver.browser.headers.set(
+      "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials(
+        ENV["QUIZZY_MODERATOR_USERNAME"],
+        ENV["QUIZZY_MODERATOR_PASSWORD"]
+      )
+    )
+  end
+end
diff --git a/test/channels/game_channels_test.rb b/test/channels/game_channels_test.rb
new file mode 100644
index 0000000..2861813
--- /dev/null
+++ b/test/channels/game_channels_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class GameChannelsTest < ActionCable::Channel::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Channel Security Quiz", number_of_winners: 2)
+    q = @quiz.questions.build(body: "Is Ruby fun?", active: true)
+    assert q.save_with_options([
+      { title: "Yes", correct: true },
+      { title: "No", correct: false }
+    ])
+    @game = Game.create_for_quiz!(@quiz)
+    @player = @game.players.create!(name: "Alice")
+  end
+
+  test "ModeratorGameChannel rejects missing, forged, or player tokens and accepts valid moderator token" do
+    self.class.tests ModeratorGameChannel
+
+    subscribe
+    assert subscription.rejected?
+
+    subscribe(token: "forged-token")
+    assert subscription.rejected?
+
+    # Player's signed token must NOT grant access to ModeratorGameChannel
+    subscribe(token: @player.stream_token)
+    assert subscription.rejected?
+
+    subscribe(token: @game.moderator_stream_token)
+    assert subscription.confirmed?
+    assert_has_stream Game.moderator_stream_name(@game.id)
+    assert_equal "lobby", transmissions.last["status"]
+    assert_equal 2, transmissions.last["number_of_winners"]
+  end
+
+  test "PlayerGameChannel rejects invalid or moderator tokens, tracks presence, and never leaks correct or points before allowed" do
+    self.class.tests PlayerGameChannel
+
+    subscribe
+    assert subscription.rejected?
+
+    subscribe(token: @game.moderator_stream_token)
+    assert subscription.rejected?
+
+    @game.start!
+    subscribe(token: @player.stream_token, tab_id: "tab-a")
+    assert subscription.confirmed?
+    assert_has_stream Game.players_stream_name(@game.id)
+    assert_has_stream Game.player_stream_name(@game.id, @player.id)
+    assert_equal 1, GamePresence.player_count(@game.id)
+
+    payload = transmissions.last
+    assert_equal "question", payload["status"]
+    assert_not payload.key?("points")
+    assert_not payload.key?("place")
+    assert_not payload.key?("winner")
+    payload["question"]["options"].each do |opt|
+      assert_not opt.key?("correct")
+    end
+
+    unsubscribe
+    assert_equal 0, GamePresence.player_count(@game.id)
+  end
+
+  test "PlayerGameChannel streams ended results and resyncs updated winner status without presence" do
+    self.class.tests PlayerGameChannel
+
+    gq = @game.game_questions.includes(:game_options).first
+    @game.start!
+    @game.record_answer!(
+      player: @player,
+      game_question_id: gq.id,
+      game_option_id: gq.game_options.find_by!(correct: true).id
+    )
+    @game.finish_question!
+    @game.end_game!
+
+    subscribe(token: @player.stream_token, tab_id: "tab-ended")
+    assert subscription.confirmed?
+    assert_equal 0, GamePresence.player_count(@game.id)
+
+    payload = transmissions.last
+    assert_equal "ended", payload["status"]
+    assert_equal 1, payload["place"]
+    assert_equal 1, payload["total_players"]
+    assert_equal 1, payload["points"]
+    assert_equal false, payload["winner"]
+
+    @game.pick_top_winners!
+    perform :resync
+    assert_equal true, transmissions.last["winner"]
+
+    @game.reset_winners!
+    perform :resync
+    assert_equal false, transmissions.last["winner"]
+  end
+
+  test "JoinStatusChannel streams join status without registering presence" do
+    self.class.tests JoinStatusChannel
+
+    subscribe(code: "NOPE1")
+    assert subscription.rejected?
+
+    subscribe(code: @game.code)
+    assert subscription.confirmed?
+    assert_has_stream Game.join_status_stream_name(@game.id)
+    assert_equal 0, GamePresence.player_count(@game.id)
+  end
+test "ModeratorGameChannel transmits timer and expires overdue questions; PlayerGameChannel never exposes timer" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    timed_game = Game.create_for_quiz!(@quiz)
+    player = timed_game.players.create!(name: "Bob")
+
+    travel_to Time.zone.parse("2026-11-20 15:00:00") do
+      timed_game.start!
+
+      self.class.tests PlayerGameChannel
+      subscribe(token: player.stream_token, tab_id: "tab-timer")
+      assert subscription.confirmed?
+      player_payload = transmissions.last
+      assert_equal "question", player_payload["status"]
+      assert_not player_payload.key?("timer")
+      assert_not player_payload["question"].key?("closes_at")
+      unsubscribe
+
+      self.class.tests ModeratorGameChannel
+      subscribe(token: timed_game.moderator_stream_token)
+      assert subscription.confirmed?
+      mod_payload = transmissions.last
+      assert_equal "question", mod_payload["status"]
+      assert_equal 5, mod_payload.dig("timer", "duration_seconds")
+      assert_equal 5000, mod_payload.dig("timer", "remaining_ms")
+
+      # Advance past deadline and resync -> transitions to reveal and hides timer
+      travel 6.seconds
+      perform :resync
+      expired_payload = transmissions.last
+      assert_equal "reveal", expired_payload["status"]
+      assert_nil expired_payload["timer"]
+      unsubscribe
+    end
+  end
+end
