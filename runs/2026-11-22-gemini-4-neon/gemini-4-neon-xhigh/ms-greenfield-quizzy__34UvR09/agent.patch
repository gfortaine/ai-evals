+      type="checkbox"
+      id="question_option_rows_<%= index %>_correct"
+      name="question[option_rows][<%= index %>][correct]"
+      value="1"
+      <%= "checked" if row[:correct] %>
+      aria-label="Option <%= number %> is correct"
+      data-role="correct-input"
+    >
+    <span class="visually-hidden" data-role="correct-text">Option <%= number %> is correct</span>
+  </label>
+  <button
+    type="button"
+    class="btn btn--danger btn--icon"
+    data-action="option-rows#remove"
+    data-role="remove-button"
+    aria-label="Remove option <%= number %>"
+    title="Remove option <%= number %>"
+  ><span aria-hidden="true">✕</span></button>
+</div>
