--- /dev/null
+++ b/test/system/timer_system_test.rb
@@ -0,0 +1,362 @@
+require "application_system_test_case"
+
+class TimerSystemTest < ApplicationSystemTestCase
+  test "quiz settings Timer minutes and Timer seconds default to 0, validate, save, and stay out of export" do
+    visit "/moderate"
+    click_on "New quiz"
+
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+
+    fill_in "Title", with: "Conference Timing Quiz"
+    fill_in "Timer minutes", with: "-1"
+    click_button "Save quiz"
+    assert_selector ".errors[role='alert']"
+    assert_equal 0, Quiz.count
+
+    fill_in "Timer minutes", with: "0"
+    fill_in "Timer seconds", with: "-5"
+    click_button "Save quiz"
+    assert_selector ".errors[role='alert']"
+    assert_equal 0, Quiz.count
+
+    fill_in "Timer seconds", with: ""
+    click_button "Save quiz"
+    assert_selector ".errors[role='alert']"
+    assert_equal 0, Quiz.count
+
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "30"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Conference Timing Quiz"
+
+    quiz = Quiz.last
+    assert_equal 1, quiz.timer_minutes
+    assert_equal 30, quiz.timer_seconds
+
+    # Revisit Settings and confirm saved values
+    click_link "Settings"
+    assert_field "Timer minutes", with: "1"
+    assert_field "Timer seconds", with: "30"
+
+    # Update to 0:05
+    fill_in "Timer minutes", with: "0"
+    fill_in "Timer seconds", with: "5"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Conference Timing Quiz"
+    assert_equal 0, quiz.reload.timer_minutes
+    assert_equal 5, quiz.timer_seconds
+
+    # Add a question, export, verify timer not in export, import defaults to 0:00
+    q = quiz.questions.build(body: "Is timer exported?", active: true)
+    assert q.save_with_options([
+      { title: "No", correct: true },
+      { title: "Yes", correct: false }
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_link "Export"
+    exported_json = page.evaluate_script("document.querySelector('pre').textContent")
+    parsed = JSON.parse(exported_json)
+    assert_equal [ "title", "questions" ], parsed.keys
+
+    visit "/moderate"
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: exported_json
+    click_button "Import"
+    click_link "Settings"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+  end
+
+  test "0 minutes and 0 seconds shows no timer and stays open until moderator clicks Finish" do
+    quiz = Quiz.create!(title: "Untimed Talk", timer_minutes: 0, timer_seconds: 0)
+    q = quiz.questions.build(body: "No rush question?", active: true)
+    assert q.save_with_options([
+      { title: "Yes", correct: true },
+      { title: "No", correct: false }
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    assert_no_selector ".stage-timer"
+
+    click_button "Start"
+    assert_text "No rush question?"
+    assert_no_selector ".stage-timer"
+    assert_button "Finish"
+
+    sleep 1.5
+    assert_button "Finish"
+    assert_no_selector ".stage-timer"
+
+    click_button "Finish"
+    assert_button "End quiz"
+    assert_no_selector ".stage-timer"
+  end
+
+  test "countdown displays M:SS on big screen only, allows early Finish, and starts fresh on Next" do
+    quiz = Quiz.create!(title: "Long Timer Talk", timer_minutes: 1, timer_seconds: 30)
+    q1 = quiz.questions.build(body: "First M:SS question?", active: true)
+    assert q1.save_with_options([
+      { title: "Option A", correct: true },
+      { title: "Option B", correct: false }
+    ])
+    q2 = quiz.questions.build(body: "Second M:SS question?", active: true)
+    assert q2.save_with_options([
+      { title: "Option C", correct: true },
+      { title: "Option D", correct: false }
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    join_url = find(".lobby__url").text.strip
+
+    # Lobby must not show timer
+    assert_no_selector ".stage-timer"
+
+    # Player joins
+    Capybara.using_session(:player1) do
+      visit join_url
+      fill_in "Your name", with: "Dana"
+      click_button "Join"
+      assert_text "Hi, Dana!"
+    end
+    assert_text "Players: 1"
+
+    # Open Q1 -> big screen shows 1:30 then counts down to 1:29
+    click_button "Start"
+    assert_text "First M:SS question?"
+    assert_selector ".stage-timer", text: /\A1:(30|29)\z/
+    assert_selector ".stage-timer", text: "1:29", wait: 3
+
+    # Player sees question but NEVER sees any timer
+    Capybara.using_session(:player1) do
+      assert_text "First M:SS question?"
+      assert_no_selector ".stage-timer"
+      assert_no_text /\b1:[0-5]\d\b/
+      assert_no_text /\b0:[0-5]\d\b/
+      click_button "Option A"
+    end
+    assert_text "Answers: 1 / 1"
+
+    # Moderator clicks Finish early -> reveal appears immediately and timer disappears
+    click_button "Finish"
+    assert_button "Next"
+    assert_no_selector ".stage-timer"
+    assert_selector ".stage-option.is-correct", text: "Option A"
+
+    Capybara.using_session(:player1) do
+      assert_text "Correct!"
+    end
+
+    # Next opens Q2 with a fresh 1:30 countdown
+    click_button "Next"
+    assert_text "Second M:SS question?"
+    assert_selector ".stage-timer", text: /\A1:(30|29)\z/
+  end
+
+  test "reloading the moderator big screen does not restart the countdown" do
+    quiz = Quiz.create!(title: "Reload Persistence Talk", timer_minutes: 0, timer_seconds: 12)
+    q = quiz.questions.build(body: "Reload-safe timer question?", active: true)
+    assert q.save_with_options([
+      { title: "Alpha", correct: true },
+      { title: "Beta", correct: false }
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    click_button "Start"
+
+    assert_selector ".stage-timer", text: /\A0:1[21]\z/
+
+    # Wait until countdown has clearly progressed to 0:08 or lower
+    assert_selector ".stage-timer", text: "0:08", wait: 6
+    before_reload_text = find(".stage-timer").text.strip
+    before_reload_secs = parse_mmss(before_reload_text)
+
+    # Reload the page
+    visit current_url
+    assert_text "Reload-safe timer question?"
+    assert_selector ".stage-timer"
+
+    after_reload_text = find(".stage-timer").text.strip
+    after_reload_secs = parse_mmss(after_reload_text)
+
+    assert_operator after_reload_secs, :<=, before_reload_secs,
+      "Expected countdown after reload (#{after_reload_text}) not to restart above #{before_reload_text}"
+    assert_operator after_reload_secs, :>=, 1,
+      "Expected countdown to still be running after reload, got #{after_reload_text}"
+  end
+
+  test "at 0:00 the question automatically finishes for moderator and players, including on last question" do
+    quiz = Quiz.create!(title: "Fast Auto-Finish Talk", timer_minutes: 0, timer_seconds: 3)
+    q1 = quiz.questions.build(body: "Quick question 1?", active: true)
+    assert q1.save_with_options([
+      { title: "Right 1", correct: true },
+      { title: "Wrong 1", correct: false }
+    ])
+    q2 = quiz.questions.build(body: "Quick question 2?", active: true)
+    assert q2.save_with_options([
+      { title: "Right 2", correct: true },
+      { title: "Wrong 2", correct: false }
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    join_url = find(".lobby__url").text.strip
+
+    Capybara.using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    Capybara.using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    assert_text "Players: 2"
+
+    # Open Q1 (3s timer)
+    click_button "Start"
+    assert_text "Quick question 1?"
+    assert_selector ".stage-timer", text: /\A0:0[32]\z/
+
+    # Alice answers before 0:00; Bob does not answer; neither sees timer
+    Capybara.using_session(:alice) do
+      assert_text "Quick question 1?"
+      assert_no_selector ".stage-timer"
+      assert_no_text /\b0:0\d\b/
+      click_button "Right 1"
+    end
+    assert_text "Answers: 1 / 2"
+
+    # Moderator does NOT click Finish — waits for automatic finish at 0:00!
+    assert_button "Next", wait: 6
+    assert_no_button "Finish"
+    assert_no_selector ".stage-timer"
+    assert_selector ".stage-option.is-correct", text: "Right 1"
+
+    # Both players automatically receive reveal state
+    Capybara.using_session(:alice) do
+      assert_text "Correct!", wait: 3
+      assert_selector "button.play-option[disabled]", count: 2
+    end
+    Capybara.using_session(:bob) do
+      assert_text "No answer", wait: 3
+      assert_selector "button.play-option[disabled]", count: 2
+    end
+
+    # Open Q2 (last question, fresh 3s timer) -> auto-finishes into reveal with End quiz button
+    click_button "Next"
+    assert_text "Quick question 2?"
+    assert_selector ".stage-timer", text: /\A0:0[32]\z/
+
+    assert_button "End quiz", wait: 6
+    assert_no_button "Finish"
+    assert_no_selector ".stage-timer"
+    assert_selector ".stage-option.is-correct", text: "Right 2"
+  end
+
+  test "question still auto-finishes server-side even if moderator navigates away before 0:00" do
+    quiz = Quiz.create!(title: "Headless Server Finish Talk", timer_minutes: 0, timer_seconds: 2)
+    q1 = quiz.questions.build(body: "Server-side auto-finish?", active: true)
+    assert q1.save_with_options([
+      { title: "Definitely", correct: true },
+      { title: "Nope", correct: false }
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    game_url = current_url
+    join_url = find(".lobby__url").text.strip
+
+    Capybara.using_session(:solo) do
+      visit join_url
+      fill_in "Your name", with: "Solo"
+      click_button "Join"
+      assert_text "Hi, Solo!"
+    end
+    assert_text "Players: 1"
+
+    click_button "Start"
+    assert_text "Server-side auto-finish?"
+
+    # Moderator navigates completely away from the game screen before timer expires!
+    visit "/moderate"
+    assert_text "Quizzes"
+
+    # Connected player STILL automatically sees reveal at 0:00 via server-side GameTimer!
+    Capybara.using_session(:solo) do
+      assert_text "No answer", wait: 5
+      assert_selector "button.play-option.is-correct", text: "Definitely"
+    end
+
+    # Moderator returns to game screen and sees reveal screen with no timer
+    visit game_url
+    assert_button "End quiz"
+    assert_no_selector ".stage-timer"
+  end
+
+test "0:05 timer format and concurrent games with different timers operate independently" do
+    short_quiz = Quiz.create!(title: "Short 2s Talk", timer_minutes: 0, timer_seconds: 2)
+    q_short = short_quiz.questions.build(body: "Short game question?", active: true)
+    assert q_short.save_with_options([
+      { title: "Fast A", correct: true },
+      { title: "Fast B", correct: false }
+    ])
+
+    five_sec_quiz = Quiz.create!(title: "Five Second Talk", timer_minutes: 0, timer_seconds: 5)
+    q_five = five_sec_quiz.questions.build(body: "Five second question?", active: true)
+    assert q_five.save_with_options([
+      { title: "Five A", correct: true },
+      { title: "Five B", correct: false }
+    ])
+
+    # Open 5-second game in primary session
+    visit moderate_quiz_path(five_sec_quiz)
+    click_button "Start a game"
+
+    # Open 2-second game in a second moderator session
+    Capybara.using_session(:mod_short) do
+      page.driver.browser.headers.set(
+        "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials(
+          ENV["QUIZZY_MODERATOR_USERNAME"],
+          ENV["QUIZZY_MODERATOR_PASSWORD"]
+        )
+      )
+      visit moderate_quiz_path(short_quiz)
+      click_button "Start a game"
+      click_button "Start"
+      assert_text "Short game question?"
+      assert_selector ".stage-timer", text: /\A0:0[21]\z/
+    end
+
+    # Start 5-second game and verify 0:05 format
+    click_button "Start"
+    assert_text "Five second question?"
+    assert_selector ".stage-timer", text: /\A0:0[54]\z/
+
+    # Short 2-second game finishes on its own while 5-second game is still running!
+    Capybara.using_session(:mod_short) do
+      assert_button "End quiz", wait: 5
+      assert_no_selector ".stage-timer"
+    end
+
+    # 5-second game is still counting down, then finishes on its own too
+    assert_button "End quiz", wait: 6
+    assert_no_selector ".stage-timer"
+  end
+
+  private
+
+  def parse_mmss(text)
+    minutes, seconds = text.split(":").map(&:to_i)
+    minutes * 60 + seconds
+  end
+end
