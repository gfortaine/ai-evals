+    <label class="visually-hidden" for="question_option_rows_<%= index %>_title" data-role="title-label">Option <%= number %></label>
+    <input
+      class="input"
+      type="text"
+      id="question_option_rows_<%= index %>_title"
+      name="question[option_rows][<%= index %>][title]"
