+    def state
+      @game.expire_question_if_due!
+      render json: @game.moderator_state
+    end
+
+    def start
+      @game.start!
+      respond_with_game_state
+    end
+
+    def finish
+      @game.finish_question!(expected_position: params[:expected_position])
+      respond_with_game_state
+    end
+
+    def next_question
+      @game.next_question!(expected_position: params[:expected_position])
+      respond_with_game_state
+    end
+
+    def end_game
