+++ b/test/models/game_presence_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class GamePresenceTest < ActiveSupport::TestCase
+  test "tracks distinct players across multiple tabs and isolates games" do
+    count, changed = GamePresence.register(10, 100, "tab-1")
+    assert_equal 1, count
+    assert changed
+
+    # Same player in second tab does not double-count
+    count, changed = GamePresence.register(10, 100, "tab-2")
+    assert_equal 1, count
+    assert_not changed
+
+    # Second player increments count
+    count, changed = GamePresence.register(10, 101, "tab-3")
+    assert_equal 2, count
+    assert changed
+
+    # Other game is independent
+    count_other, changed_other = GamePresence.register(20, 200, "tab-4")
+    assert_equal 1, count_other
+    assert changed_other
+    assert_equal 2, GamePresence.player_count(10)
+
+    # Closing one of Alice's two tabs keeps count at 2
+    count, changed = GamePresence.unregister(10, 100, "tab-1")
+    assert_equal 2, count
+    assert_not changed
+
+    # Closing Alice's second tab drops count to 1
+    count, changed = GamePresence.unregister(10, 100, "tab-2")
+    assert_equal 1, count
+    assert changed
+  end
+
+  test "reap_expired! evicts stale connections" do
+    GamePresence.register(10, 100, "tab-short", ttl: 0.01)
+    GamePresence.register(10, 101, "tab-long", ttl: 30.0)
+    assert_equal 2, GamePresence.player_count(10)
+
+    sleep 0.03
+    changes = GamePresence.reap_expired!
+    assert_equal [ [ 10, 1 ] ], changes
+    assert_equal 1, GamePresence.player_count(10)
+  end
+end
diff --git a/test/models/game_scoring_and_winners_test.rb b/test/models/game_scoring_and_winners_test.rb
new file mode 100644
index 0000000..0adfc63
--- /dev/null
+++ b/test/models/game_scoring_and_winners_test.rb
@@ -0,0 +1,353 @@
+require "test_helper"
+
+class GameScoringAndWinnersTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = Quiz.create!(title: "Prizes Talk Quiz", number_of_winners: 3)
+
+    @q1 = @quiz.questions.build(body: "Q1?", active: true)
+    assert @q1.save_with_options([
+      { title: "Q1 Right", correct: true },
+      { title: "Q1 Wrong", correct: false }
+    ])
+
+    @q2 = @quiz.questions.build(body: "Q2?", active: true)
+    assert @q2.save_with_options([
+      { title: "Q2 Right A", correct: true },
+      { title: "Q2 Right B", correct: true },
+      { title: "Q2 Wrong", correct: false }
+    ])
+
+    @q3 = @quiz.questions.build(body: "Q3?", active: true)
+    assert @q3.save_with_options([
+      { title: "Q3 Right", correct: true },
+      { title: "Q3 Wrong", correct: false }
+    ])
+  end
+
+  test "ranks players by points then lower total time of correct answers, using last pick time and ignoring wrong answer time" do
+    base_time = Time.zone.parse("2026-11-20 10:00:00 UTC")
+    game = Game.create_for_quiz!(@quiz)
+    alice = game.players.create!(name: "Alice")
+    bob   = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+    dave  = game.players.create!(name: "Dave")
+    eve   = game.players.create!(name: "Eve")
+
+    gq1, gq2, gq3 = game.game_questions.includes(:game_options).to_a
+    q1_right = gq1.game_options.find_by!(title: "Q1 Right")
+    q1_wrong = gq1.game_options.find_by!(title: "Q1 Wrong")
+    q2_right_a = gq2.game_options.find_by!(title: "Q2 Right A")
+    q2_right_b = gq2.game_options.find_by!(title: "Q2 Right B")
+    q2_wrong = gq2.game_options.find_by!(title: "Q2 Wrong")
+    q3_right = gq3.game_options.find_by!(title: "Q3 Right")
+    q3_wrong = gq3.game_options.find_by!(title: "Q3 Wrong")
+
+    # Q1 opens at T=0
+    travel_to(base_time, with_usec: true) do
+      assert game.start!
+      assert_in_delta base_time.to_f, gq1.reload.opened_at.to_f, 0.001
+    end
+
+    # T+1.0s: Carol picks RIGHT early, Alice picks RIGHT
+    travel_to(base_time + 1.0, with_usec: true) do
+      game.record_answer!(player: carol, game_question_id: gq1.id, game_option_id: q1_right.id)
+      game.record_answer!(player: alice, game_question_id: gq1.id, game_option_id: q1_right.id)
+    end
+
+    # T+2.0s: Bob picks RIGHT; Alice sends duplicate retry of SAME option (keeps T+1.0s!)
+    travel_to(base_time + 2.0, with_usec: true) do
+      game.record_answer!(player: bob, game_question_id: gq1.id, game_option_id: q1_right.id)
+      game.record_answer!(player: alice, game_question_id: gq1.id, game_option_id: q1_right.id)
+    end
+
+    # T+3.0s: Carol changes to WRONG
+    travel_to(base_time + 3.0, with_usec: true) do
+      game.record_answer!(player: carol, game_question_id: gq1.id, game_option_id: q1_wrong.id)
+    end
+
+    # T+5.0s: Carol changes BACK to RIGHT (her Q1 time MUST be 5.0s, NOT 1.0s!)
+    # Dave picks WRONG slowly at T+5.0s (wrong answer time must NOT count!)
+    travel_to(base_time + 5.0, with_usec: true) do
+      game.record_answer!(player: carol, game_question_id: gq1.id, game_option_id: q1_right.id)
+      game.record_answer!(player: dave, game_question_id: gq1.id, game_option_id: q1_wrong.id)
+
+      # During question & reveal, players must NEVER see points, place, or winner
+      [ alice, bob, carol, dave, eve ].each do |p|
+        st = game.player_state(p)
+        assert_not st.key?(:points)
+        assert_not st.key?(:place)
+        assert_not st.key?(:total_players)
+        assert_not st.key?(:winner)
+      end
+
+      game.finish_question!
+      [ alice, bob, carol, dave, eve ].each do |p|
+        st = game.player_state(p)
+        assert_not st.key?(:points)
+        assert_not st.key?(:place)
+        assert_not st.key?(:total_players)
+        assert_not st.key?(:winner)
+      end
+    end
+
+    # Q2 opens at T+15.0s (proves Q2 timer starts at Q2 open, not Q1 open!)
+    q2_open = base_time + 15.0
+    travel_to(q2_open, with_usec: true) do
+      assert game.next_question!
+      assert_in_delta q2_open.to_f, gq2.reload.opened_at.to_f, 0.001
+    end
+
+    # Q2 + 0.5s: Dave answers RIGHT (total correct time = 0.5s, 1 pt!)
+    travel_to(q2_open + 0.5, with_usec: true) do
+      game.record_answer!(player: dave, game_question_id: gq2.id, game_option_id: q2_right_b.id)
+    end
+
+    # Q2 + 4.0s: Alice answers RIGHT (total correct time = 1.0s + 4.0s = 5.0s, 2 pts)
+    #            Bob answers WRONG (stays at 1 pt, total correct time = 2.0s)
+    #            Carol answers WRONG (stays at 1 pt, total correct time = 5.0s)
+    travel_to(q2_open + 4.0, with_usec: true) do
+      game.record_answer!(player: alice, game_question_id: gq2.id, game_option_id: q2_right_a.id)
+      game.record_answer!(player: bob, game_question_id: gq2.id, game_option_id: q2_wrong.id)
+      game.record_answer!(player: carol, game_question_id: gq2.id, game_option_id: q2_wrong.id)
+      game.finish_question!
+    end
+
+    # Q3 opens at T+25.0s
+    q3_open = base_time + 25.0
+    travel_to(q3_open, with_usec: true) do
+      assert game.next_question!
+    end
+
+    # Q3 + 1.25s: Bob answers RIGHT (total 2 pts, total correct time = 2.0s + 1.25s = 3.25s -> FASTER than Alice's 5.0s!)
+    travel_to(q3_open + 1.25, with_usec: true) do
+      game.record_answer!(player: bob, game_question_id: gq3.id, game_option_id: q3_right.id)
+    end
+
+    # Q3 + 2.0s: Alice answers WRONG (stays at 2 pts, total correct time = 5.0s)
+    #            Eve answers WRONG (0 pts)
+    travel_to(q3_open + 2.0, with_usec: true) do
+      game.record_answer!(player: alice, game_question_id: gq3.id, game_option_id: q3_wrong.id)
+      game.record_answer!(player: eve, game_question_id: gq3.id, game_option_id: q3_wrong.id)
+      game.finish_question!
+      game.end_game!
+    end
+
+    # Expected order:
+    # 1. Bob:   2 pts, 3.25s (2.0s on Q1 + 1.25s on Q3; Q2 wrong excluded)
+    # 2. Alice: 2 pts, 5.00s (1.0s on Q1 + 4.00s on Q2; Q3 wrong excluded; duplicate retry on Q1 ignored)
+    # 3. Dave:  1 pt,  0.50s (0.5s on Q2; 5.0s wrong Q1 excluded)
+    # 4. Carol: 1 pt,  5.00s (5.0s last pick on Q1; Q2 wrong excluded)
+    # 5. Eve:   0 pts, 0.00s
+    board = game.leaderboard
+    assert_equal [ bob.id, alice.id, dave.id, carol.id, eve.id ], board.map { |e| e[:player_id] }
+    assert_equal [ 1, 2, 3, 4, 5 ], board.map { |e| e[:place] }
+    assert_equal [ 2, 2, 1, 1, 0 ], board.map { |e| e[:points] }
+    assert_equal [ false, false, false, false, false ], board.map { |e| e[:winner] }
+
+    assert_in_delta 3_250_000, board[0][:total_time_us], 50_000
+    assert_in_delta 5_000_000, board[1][:total_time_us], 50_000
+    assert_in_delta 500_000, board[2][:total_time_us], 50_000
+    assert_in_delta 5_000_000, board[3][:total_time_us], 50_000
+    assert_equal 0, board[4][:total_time_us]
+
+    # Verify player_state after end
+    bob_state = game.player_state(bob)
+    assert_equal "ended", bob_state[:status]
+    assert_equal 1, bob_state[:place]
+    assert_equal 5, bob_state[:total_players]
+    assert_equal 2, bob_state[:points]
+    assert_equal false, bob_state[:winner]
+
+    carol_state = game.player_state(carol)
+    assert_equal 4, carol_state[:place]
+    assert_equal 5, carol_state[:total_players]
+    assert_equal 1, carol_state[:points]
+    assert_equal false, carol_state[:winner]
+  end
+
+  test "pick_top_winners!, draw_winners!, and reset_winners! respect ties, 0-point exclusion, and fewer-than-N rule" do
+    @quiz.update!(number_of_winners: 3)
+    game = Game.create_for_quiz!(@quiz)
+    gq1, gq2, gq3 = game.game_questions.includes(:game_options).to_a
+
+    alice = game.players.create!(name: "Alice")
+    bob   = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+    dave  = game.players.create!(name: "Dave")
+    eve   = game.players.create!(name: "Eve")
+    frank = game.players.create!(name: "Frank")
+
+    create_correct = lambda do |player, gq, us|
+      Answer.create!(
+        game: game,
+        player: player,
+        game_question: gq,
+        game_option: gq.game_options.find_by!(correct: true),
+        response_time_us: us
+      )
+    end
+
+    # Alice: 3 pts
+    create_correct.call(alice, gq1, 1_000_000)
+    create_correct.call(alice, gq2, 1_000_000)
+    create_correct.call(alice, gq3, 1_000_000)
+
+    # Bob: 2 pts, 1s total
+    create_correct.call(bob, gq1, 500_000)
+    create_correct.call(bob, gq2, 500_000)
+
+    # Carol: 2 pts, 2s total
+    create_correct.call(carol, gq1, 1_000_000)
+    create_correct.call(carol, gq2, 1_000_000)
+
+    # Dave: 2 pts, 4s total
+    create_correct.call(dave, gq1, 2_000_000)
+    create_correct.call(dave, gq2, 2_000_000)
+
+    # Eve: 1 pt
+    create_correct.call(eve, gq1, 100_000)
+
+    # Winner actions rejected before end_game!
+    assert_not game.pick_top_winners!
+    assert_not game.draw_winners!
+    assert_not game.reset_winners!
+
+    game.end_game!
+
+    # Top 3 -> Alice, Bob, Carol (by points then speed)
+    assert game.pick_top_winners!
+    winners = game.players.where(winner: true).pluck(:id).sort
+    assert_equal [ alice.id, bob.id, carol.id ].sort, winners
+
+    # Reset winners -> none
+    assert game.reset_winners!
+    assert_equal [], game.players.where(winner: true).pluck(:id)
+
+    # Draw (N=3):
+    # 3rd place (Carol) has 2 points.
+    # > 2 points: Alice (ALWAYS wins)
+    # == 2 points: Bob, Carol, Dave (2 drawn at random, speed does NOT matter!)
+    # < 2 points: Eve, Frank (NEVER win)
+    tied_win_counts = { bob.id => 0, carol.id => 0, dave.id => 0 }
+    60.times do
+      assert game.draw_winners!
+      ids = game.players.where(winner: true).pluck(:id)
+      assert_equal 3, ids.size
+      assert_includes ids, alice.id, "Alice (> cutoff) must always win"
+      assert_not_includes ids, eve.id, "Eve (< cutoff) must never win"
+      assert_not_includes ids, frank.id, "Frank (0 pts) must never win"
+
+      tied_winners = ids - [ alice.id ]
+      assert_equal 2, tied_winners.size
+      tied_winners.each { |pid| tied_win_counts[pid] += 1 }
+    end
+
+    tied_win_counts.each do |pid, count|
+      assert count > 0, "Expected tied player #{pid} to win at least once across 60 draws"
+      assert count < 60, "Expected tied player #{pid} to lose at least once across 60 draws"
+    end
+  end
+
+  test "0-point players never win and fewer-than-N eligible players all win for both Top N and Draw" do
+    @quiz.update!(number_of_winners: 3)
+    game = Game.create_for_quiz!(@quiz)
+    gq1 = game.game_questions.includes(:game_options).first
+
+    alice = game.players.create!(name: "Alice")
+    bob   = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+    dave  = game.players.create!(name: "Dave")
+
+    Answer.create!(
+      game: game, player: alice, game_question: gq1,
+      game_option: gq1.game_options.find_by!(correct: true), response_time_us: 1_000_000
+    )
+    Answer.create!(
+      game: game, player: bob, game_question: gq1,
+      game_option: gq1.game_options.find_by!(correct: true), response_time_us: 2_000_000
+    )
+    Answer.create!(
+      game: game, player: carol, game_question: gq1,
+      game_option: gq1.game_options.find_by!(correct: false), response_time_us: 100_000
+    )
+
+    game.end_game!
+
+    # Top 3 -> only Alice and Bob (Carol & Dave have 0 points!)
+    assert game.pick_top_winners!
+    assert_equal [ alice.id, bob.id ].sort, game.players.where(winner: true).pluck(:id).sort
+
+    assert game.reset_winners!
+    assert_equal [], game.players.where(winner: true).pluck(:id)
+
+    # Draw -> only Alice and Bob (fewer than 3 have points, so all of them win; 0-point players excluded)
+    assert game.draw_winners!
+    assert_equal [ alice.id, bob.id ].sort, game.players.where(winner: true).pluck(:id).sort
+  end
+
+  test "all 0-point players results in zero winners for Top N and Draw" do
+    @quiz.update!(number_of_winners: 3)
+    game = Game.create_for_quiz!(@quiz)
+    game.players.create!(name: "Alice")
+    game.players.create!(name: "Bob")
+    game.end_game!
+
+    assert game.pick_top_winners!
+    assert_equal [], game.players.where(winner: true).pluck(:id)
+
+    assert game.draw_winners!
+    assert_equal [], game.players.where(winner: true).pluck(:id)
+  end
+
+  test "draw with N=1 and tie at 1st place draws randomly among 1st-place tie only" do
+    @quiz.update!(number_of_winners: 1)
+    game = Game.create_for_quiz!(@quiz)
+    gq1 = game.game_questions.includes(:game_options).first
+
+    alice = game.players.create!(name: "Alice")
+    bob   = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+
+    Answer.create!(game: game, player: alice, game_question: gq1, game_option: gq1.game_options.find_by!(correct: true), response_time_us: 100_000)
+    Answer.create!(game: game, player: bob, game_question: gq1, game_option: gq1.game_options.find_by!(correct: true), response_time_us: 500_000)
+
+    game.end_game!
+
+    # Top 1 -> Alice (faster)
+    assert game.pick_top_winners!
+    assert_equal [ alice.id ], game.players.where(winner: true).pluck(:id)
+
+    # Draw -> randomly Alice or Bob, never Carol (0 pts)
+    seen = Set.new
+    40.times do
+      assert game.draw_winners!
+      ids = game.players.where(winner: true).pluck(:id)
+      assert_equal 1, ids.size
+      assert_not_includes ids, carol.id
+      seen << ids.first
+    end
+    assert_equal [ alice.id, bob.id ].sort, seen.to_a.sort
+  end
+
+  test "duplicate player names are ranked and awarded winners independently by player id" do
+    @quiz.update!(number_of_winners: 1)
+    game = Game.create_for_quiz!(@quiz)
+    gq1 = game.game_questions.includes(:game_options).first
+
+    alex1 = game.players.create!(name: "Alex")
+    alex2 = game.players.create!(name: "Alex")
+
+    Answer.create!(game: game, player: alex1, game_question: gq1, game_option: gq1.game_options.find_by!(correct: true), response_time_us: 2_000_000)
+    Answer.create!(game: game, player: alex2, game_question: gq1, game_option: gq1.game_options.find_by!(correct: true), response_time_us: 500_000)
+
+    game.end_game!
+    assert game.pick_top_winners!
+
+    assert_equal 1, game.player_state(alex2)[:place]
+    assert_equal true, game.player_state(alex2)[:winner]
+    assert_equal 2, game.player_state(alex1)[:place]
+    assert_equal false, game.player_state(alex1)[:winner]
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..9b88010
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Conference Talk Quiz")
+    @q1 = @quiz.questions.build(body: "Active question 1?", active: true)
+    assert @q1.save_with_options([
+      { title: "Right 1", correct: true },
+      { title: "Wrong 1", correct: false }
+    ])
+
+    @q2 = @quiz.questions.build(body: "Inactive question?", active: false)
+    assert @q2.save_with_options([
+      { title: "Hidden A", correct: true },
+      { title: "Hidden B", correct: false }
+    ])
+
+    @q3 = @quiz.questions.build(body: "Active question 2?", active: true)
+    assert @q3.save_with_options([
+      { title: "Right A", correct: true },
+      { title: "Right B", correct: true },
+      { title: "Wrong C", correct: false }
+    ])
+  end
+
+  test "create_for_quiz! snapshots active questions in order and skips inactive questions" do
+    game = Game.create_for_quiz!(@quiz)
+    assert_not_nil game
+    assert_equal "lobby", game.status
+    assert_equal 5, game.code.length
+    assert_equal [ "Active question 1?", "Active question 2?" ], game.game_questions.map(&:body)
+    assert_equal [ 1, 2 ], game.game_questions.map(&:position)
+    assert_equal [ "Right 1", "Wrong 1" ], game.game_questions.first.game_options.map(&:title)
+  end
+
+  test "create_for_quiz! returns nil when there are no active questions" do
+    @quiz.questions.update_all(active: false)
+    assert_nil Game.create_for_quiz!(@quiz)
+  end
+
+  test "multiple games of the same quiz are independent with distinct codes" do
+    g1 = Game.create_for_quiz!(@quiz)
+    g2 = Game.create_for_quiz!(@quiz)
+    assert_not_equal g1.code, g2.code
+    assert_not_equal g1.id, g2.id
+  end
+
+  test "state transitions are guarded against duplicate/out-of-order actions" do
+    game = Game.create_for_quiz!(@quiz)
+
+    assert_not game.finish_question!
+    assert_not game.next_question!
+
+    assert game.start!
+    assert_equal "question", game.status
+    assert_equal 1, game.current_question_position
+    assert_not game.start!
+
+    # Wrong expected_position is ignored
+    assert_not game.finish_question!(expected_position: 2)
+    assert game.finish_question!(expected_position: 1)
+    assert_equal "reveal", game.status
+    assert_not game.finish_question!(expected_position: 1)
+
+    assert_not game.next_question!(expected_position: 2)
+    assert game.next_question!(expected_position: 1)
+    assert_equal "question", game.status
+    assert_equal 2, game.current_question_position
+    assert game.last_question?
+
+    assert game.finish_question!(expected_position: 2)
+    assert_not game.next_question!(expected_position: 2)
+
+    assert game.end_game!
+    assert_equal "ended", game.status
+    assert_not game.end_game!
+  end
+
+  test "record_answer! upserts last pick and rejects answers outside open question" do
+    game = Game.create_for_quiz!(@quiz)
+    player = game.players.create!(name: "Alice")
+    gq1 = game.game_questions.first
+    opt1, opt2 = gq1.game_options.to_a
+
+    # Rejected in lobby
+    res = game.record_answer!(player: player, game_question_id: gq1.id, game_option_id: opt1.id)
+    assert_not res[:ok]
+    assert_equal 0, game.answers.count
+
+    game.start!
+
+    # First pick
+    res1 = game.record_answer!(player: player, game_question_id: gq1.id, game_option_id: opt1.id)
+    assert res1[:ok]
+    assert_equal 1, game.answers.count
+    assert_equal opt1.id, game.answers.first.game_option_id
+
+    # Change pick -> last pick wins, still 1 answer
+    res2 = game.record_answer!(player: player, game_question_id: gq1.id, game_option_id: opt2.id)
+    assert res2[:ok]
+    assert_equal 1, game.answers.count
+    assert_equal opt2.id, game.answers.first.game_option_id
+
+    # Option from another question is rejected
+    other_opt = game.game_questions.second.game_options.first
+    res_other = game.record_answer!(player: player, game_question_id: gq1.id, game_option_id: other_opt.id)
+    assert_not res_other[:ok]
+    assert_equal opt2.id, game.answers.first.game_option_id
+
+    # After Finish, answers are rejected
+    game.finish_question!
+    res_late = game.record_answer!(player: player, game_question_id: gq1.id, game_option_id: opt1.id)
+    assert_not res_late[:ok]
+    assert_equal opt2.id, game.answers.first.game_option_id
+  end
+
+  test "player_state never leaks correct answer before reveal" do
+    game = Game.create_for_quiz!(@quiz)
+    player = game.players.create!(name: "Alice")
+
+    assert_not_includes game.player_state(player).to_json, "correct"
+
+    game.start!
+    open_state = game.player_state(player)
+    assert_not_includes open_state.to_json, "correct"
+    assert_equal 2, open_state[:question][:options].size
+    open_state[:question][:options].each do |opt|
+      assert_not opt.key?(:correct)
+    end
+
+    game.finish_question!
+    reveal_state = game.player_state(player)
+    assert_equal "no_answer", reveal_state[:result]
+    assert_equal [ true, false ], reveal_state[:question][:options].map { |o| o[:correct] }
+  end
+
+  test "editing or deleting quiz questions after a game preserves snapshot and quiz export excludes games" do
+    game = Game.create_for_quiz!(@quiz)
+    game.start!
+    player = game.players.create!(name: "Alice")
+    gq1 = game.game_questions.first
+    game.record_answer!(player: player, game_question_id: gq1.id, game_option_id: gq1.game_options.first.id)
+    game.finish_question!
+    game.end_game!
+
+    # Edit question options (deletes and recreates Option rows)
+    assert @q1.save_with_options([
+      { title: "Updated 1", correct: false },
+      { title: "Updated 2", correct: true }
+    ])
+    # Delete question
+    @q3.destroy!
+
+    # Game snapshot and answer remain intact
+    game.reload
+    assert_equal [ "Active question 1?", "Active question 2?" ], game.game_questions.map(&:body)
+    assert_equal 1, game.answers.count
+
+    # Export data remains strictly scoped to quiz contents
+    export = @quiz.export_data
+    assert_equal %w[title questions], export.keys
+
+    # Deleting quiz cascades cleanly without foreign key errors
+    assert_difference -> { Game.count } => -1, -> { Player.count } => -1, -> { Answer.count } => -1 do
+      @quiz.destroy!
+    end
+  end
+end
diff --git a/test/models/game_timer_test.rb b/test/models/game_timer_test.rb
new file mode 100644
index 0000000..7a7c97d
--- /dev/null
+++ b/test/models/game_timer_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class GameTimerTest < ActiveSupport::TestCase
+  include ApplicationHelper
+
+  setup do
+    @quiz = Quiz.create!(title: "Timed Conference Quiz", timer_minutes: 0, timer_seconds: 5)
+    @q1 = @quiz.questions.build(body: "First timed question?", active: true)
+    assert @q1.save_with_options([
+      { title: "Correct 1", correct: true },
+      { title: "Wrong 1", correct: false }
+    ])
+    @q2 = @quiz.questions.build(body: "Second timed question?", active: true)
+    assert @q2.save_with_options([
+      { title: "Correct 2", correct: true },
+      { title: "Wrong 2", correct: false }
+    ])
+  end
+
+  test "0 minutes and 0 seconds creates an untimed game with no closes_at or timer payload" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    game = Game.create_for_quiz!(@quiz)
+
+    assert_equal 0, game.timer_duration_seconds
+    assert_not game.timer_enabled?
+
+    assert game.start!
+    gq1 = game.current_question
+    assert_nil gq1.closes_at
+    assert_not GameTimer.scheduled?(game.id)
+    assert_nil game.moderator_state[:timer]
+
+    travel 2.hours do
+      assert_not game.expire_question_if_due!
+      assert_equal "question", game.reload.status
+    end
+  end
+
+  test "game snapshots timer duration and sets closes_at per question on start and next" do
+    game = Game.create_for_quiz!(@quiz)
+    assert_equal 5, game.timer_duration_seconds
+    assert game.timer_enabled?
+
+    # Later edits to quiz timer do not affect existing game snapshot
+    @quiz.update!(timer_minutes: 2, timer_seconds: 0)
+    assert_equal 5, game.reload.timer_duration_seconds
+
+    # In lobby, no timer payload and no closes_at
+    assert_nil game.moderator_state[:timer]
+    assert_nil game.game_questions.first.closes_at
+
+    travel_to Time.zone.parse("2026-11-20 12:00:00") do
+      assert game.start!
+      gq1 = game.current_question
+      assert_equal Time.zone.parse("2026-11-20 12:00:00"), gq1.opened_at
+      assert_equal Time.zone.parse("2026-11-20 12:00:05"), gq1.closes_at
+      assert GameTimer.scheduled?(game.id)
+
+      mod_state = game.moderator_state
+      assert_equal 5, mod_state[:timer][:duration_seconds]
+      assert_equal 5000, mod_state[:timer][:remaining_ms]
+
+      # Player state NEVER contains timer data
+      player = game.players.create!(name: "Alice")
+      p_broadcast = game.player_broadcast_state
+      p_state = game.player_state(player)
+      assert_not p_broadcast.key?(:timer)
+      assert_not p_state.key?(:timer)
+      assert_not p_state[:question].key?(:closes_at)
+
+      # Early finish cancels timer and hides timer payload
+      travel 2.seconds
+      assert_equal 3000, game.moderator_state[:timer][:remaining_ms]
+      assert game.finish_question!
+      assert_equal "reveal", game.status
+      assert_not GameTimer.scheduled?(game.id)
+      assert_nil game.moderator_state[:timer]
+
+      # Next question starts a fresh 5-second timer from now (12:00:02 -> 12:00:07)
+      assert game.next_question!
+      gq2 = game.current_question
+      assert_equal 2, gq2.position
+      assert_equal Time.zone.parse("2026-11-20 12:00:02"), gq2.opened_at
+      assert_equal Time.zone.parse("2026-11-20 12:00:07"), gq2.closes_at
+      assert GameTimer.scheduled?(game.id)
+      assert_equal 5000, game.moderator_state[:timer][:remaining_ms]
+    end
+  end
+
+  test "expire_question_if_due! finishes question at deadline and record_answer! rejects late picks" do
+    game = Game.create_for_quiz!(@quiz)
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+    gq1 = game.game_questions.first
+    right_opt = gq1.game_options.find_by!(correct: true)
+    wrong_opt = gq1.game_options.find_by!(correct: false)
+
+    travel_to Time.zone.parse("2026-11-20 12:00:00") do
+      assert game.start!
+
+      # Before deadline: Alice's answer is accepted
+      travel 4.seconds
+      assert_not game.expire_question_if_due!
+      res = game.record_answer!(player: alice, game_question_id: gq1.id, game_option_id: right_opt.id)
+      assert res[:ok]
+      assert_equal 1, game.answers.count
+
+      # At deadline (5.0s elapsed): Bob's late answer is rejected AND auto-finishes question
+      travel 1.second
+      late_res = game.record_answer!(player: bob, game_question_id: gq1.id, game_option_id: wrong_opt.id)
+      assert_not late_res[:ok]
+      assert_equal "reveal", late_res[:state][:status]
+      assert_equal "no_answer", late_res[:state][:result]
+      assert_equal "reveal", game.reload.status
+      assert_equal 1, game.answers.count
+
+      # Alice's earlier answer is preserved and marked correct
+      alice_state = game.player_state(alice)
+      assert_equal "reveal", alice_state[:status]
+      assert_equal "correct", alice_state[:result]
+    end
+  end
+
+  test "end_game! cancels scheduled timer" do
+    game = Game.create_for_quiz!(@quiz)
+    assert game.start!
+    assert GameTimer.scheduled?(game.id)
+
+    assert game.end_game!
+    assert_not GameTimer.scheduled?(game.id)
+  end
+
+  test "format_timer formats M:SS using ceiling and clamps to max_seconds" do
+    assert_equal "1:30", format_timer(90_000, max_seconds: 90)
+    assert_equal "1:30", format_timer(89_001, max_seconds: 90)
+    assert_equal "1:30", format_timer(90_200, max_seconds: 90)
+    assert_equal "1:29", format_timer(89_000, max_seconds: 90)
+    assert_equal "1:00", format_timer(60_000, max_seconds: 90)
+    assert_equal "0:59", format_timer(59_000, max_seconds: 90)
+    assert_equal "0:05", format_timer(5_000, max_seconds: 5)
+    assert_equal "0:05", format_timer(4_001, max_seconds: 5)
+    assert_equal "0:01", format_timer(1, max_seconds: 5)
+    assert_equal "0:00", format_timer(0, max_seconds: 5)
+    assert_equal "0:00", format_timer(-500, max_seconds: 5)
+    assert_equal "10:05", format_timer(605_000, max_seconds: 605)
+  end
+end
diff --git a/test/models/question_test.rb b/test/models/question_test.rb
new file mode 100644
index 0000000..f0dea58
--- /dev/null
+++ b/test/models/question_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Ruby Conf")
+  end
+
+  test "new question starts with four empty option rows" do
+    question = @quiz.questions.build(active: true)
+    assert_equal 4, question.form_option_rows.size
+    assert question.form_option_rows.all? { |r| r[:title] == "" && r[:correct] == false }
+  end
+
+  test "skips empty rows and validates at least two options and one correct" do
+    q1 = @quiz.questions.build(body: "One option?", active: true)
+    assert_not q1.save_with_options([
+      { title: "Only one", correct: true },
+      { title: "   ", correct: true },
+      { title: "", correct: false }
+    ])
+    assert_includes q1.errors.full_messages, "Add at least two options"
+    assert_not_includes q1.errors.full_messages, "Mark at least one option as correct"
+    assert_equal 0, Question.count
+
+    q2 = @quiz.questions.build(body: "No correct?", active: true)
+    assert_not q2.save_with_options([
+      { title: "A", correct: false },
+      { title: "B", correct: false },
+      { title: "", correct: true }
+    ])
+    assert_includes q2.errors.full_messages, "Mark at least one option as correct"
+    assert_not_includes q2.errors.full_messages, "Add at least two options"
+    assert_equal 0, Question.count
+  end
+
+  test "allows multiple correct options and skips blank rows" do
+    q = @quiz.questions.build(body: "Pick languages", active: true)
+    assert q.save_with_options([
+      { title: "", correct: false },
+      { title: "Ruby", correct: true },
+      { title: "   ", correct: true },
+      { title: "Python", correct: true },
+      { title: "Banana", correct: false }
+    ])
+
+    assert_equal [ "Ruby", "Python", "Banana" ], q.options.pluck(:title)
+    assert_equal [ true, true, false ], q.options.pluck(:correct)
+  end
+
+  test "failed update leaves persisted question and options untouched" do
+    q = @quiz.questions.build(body: "Original?", active: true)
+    assert q.save_with_options([
+      { title: "Yes", correct: true },
+      { title: "No", correct: false }
+    ])
+
+    q.assign_attributes(body: "Changed?", active: false)
+    assert_not q.save_with_options([
+      { title: "Only one", correct: false },
+      { title: "", correct: false }
+    ])
+
+    # Form keeps what was typed
+    assert_equal "Changed?", q.body
+    assert_equal false, q.active
+    assert_equal [ { title: "Only one", correct: false }, { title: "", correct: false } ], q.form_option_rows
+
+    # Database untouched
+    reloaded = Question.find(q.id)
+    assert_equal "Original?", reloaded.body
+    assert_equal true, reloaded.active
+    assert_equal [ "Yes", "No" ], reloaded.options.pluck(:title)
+  end
+
+  test "move up and down reorders questions cleanly" do
+    q1 = @quiz.questions.build(body: "First")
+    q1.save_with_options([ { title: "A", correct: true }, { title: "B", correct: false } ])
+    q2 = @quiz.questions.build(body: "Second")
+    q2.save_with_options([ { title: "A", correct: true }, { title: "B", correct: false } ])
+    q3 = @quiz.questions.build(body: "Third")
+    q3.save_with_options([ { title: "A", correct: true }, { title: "B", correct: false } ])
+
+    assert_equal [ q1.id, q2.id, q3.id ], @quiz.questions.ordered.pluck(:id)
+
+    assert_not q1.move!("up")
+    assert_not q3.move!("down")
+
+    assert q3.move!("up")
+    assert_equal [ q1.id, q3.id, q2.id ], @quiz.questions.ordered.pluck(:id)
+
+    assert q1.move!("down")
+    assert_equal [ q3.id, q1.id, q2.id ], @quiz.questions.ordered.pluck(:id)
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..75a3301
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,251 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  test "imports valid quiz JSON preserving order, active states, and multiple correct options" do
+    json = <<~JSON
+      {
+        "title": "Frontend Fest 2026",
+        "questions": [
+          {
+            "text": "Which HTTP status code means \\"Too Many Requests\\"?",
+            "active": true,
+            "options": [
+              {"text": "418", "correct": false},
+              {"text": "429", "correct": true}
+            ]
+          },
+          {
+            "text": "Inactive question with multiple answers",
+            "active": false,
+            "options": [
+              {"text": "First", "correct": true},
+              {"text": "Second", "correct": false},
+              {"text": "Third", "correct": true},
+              {"text": "Fourth", "correct": false},
+              {"text": "Fifth", "correct": false}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    importer = QuizImport.new(json: json)
+    assert importer.import, "Expected import to succeed, errors: #{importer.errors.full_messages}"
+
+    quiz = importer.quiz
+    assert quiz.persisted?
+    assert_equal "Frontend Fest 2026", quiz.title
+
+    questions = quiz.questions.ordered.includes(:options).to_a
+    assert_equal 2, questions.size
+
+    assert_equal 'Which HTTP status code means "Too Many Requests"?', questions[0].body
+    assert_equal true, questions[0].active?
+    assert_equal 1, questions[0].position
+    assert_equal [ "418", "429" ], questions[0].options.map(&:title)
+    assert_equal [ false, true ], questions[0].options.map(&:correct?)
+    assert_equal [ 1, 2 ], questions[0].options.map(&:position)
+
+    assert_equal "Inactive question with multiple answers", questions[1].body
+    assert_equal false, questions[1].active?
+    assert_equal 2, questions[1].position
+    assert_equal [ "First", "Second", "Third", "Fourth", "Fifth" ], questions[1].options.map(&:title)
+    assert_equal [ true, false, true, false, false ], questions[1].options.map(&:correct?)
+  end
+
+  test "defaults optional active to true and optional correct to false" do
+    json = {
+      "title" => "Defaults Quiz",
+      "questions" => [
+        {
+          "text" => "Pick the right one",
+          "options" => [
+            { "text" => "Wrong by default" },
+            { "text" => "Explicitly correct", "correct" => true },
+            { "text" => "Also wrong by default" }
+          ]
+        }
+      ]
+    }.to_json
+
+    importer = QuizImport.new(json: json)
+    assert importer.import
+
+    question = importer.quiz.questions.first
+    assert_equal true, question.active?
+    assert_equal [ false, true, false ], question.options.map(&:correct?)
+
+    # Export always writes both active and correct explicitly
+    exported = JSON.parse(importer.quiz.to_export_json)
+    assert_equal [ "title", "questions" ], exported.keys
+    assert_equal [ "text", "active", "options" ], exported["questions"].first.keys
+    assert_equal true, exported["questions"].first["active"]
+    exported["questions"].first["options"].each do |opt|
+      assert_equal [ "text", "correct" ], opt.keys
+      assert_includes [ true, false ], opt["correct"]
+    end
+  end
+
+  test "always creates a new quiz even when same title exists" do
+    existing = Quiz.create!(title: "Same Title")
+    q = existing.questions.build(body: "Original Q", active: true)
+    q.save_with_options([ { title: "A", correct: true }, { title: "B", correct: false } ])
+
+    json = {
+      "title" => "Same Title",
+      "questions" => [
+        {
+          "text" => "Imported Q",
+          "options" => [
+            { "text" => "X", "correct" => false },
+            { "text" => "Y", "correct" => true }
+          ]
+        }
+      ]
+    }.to_json
+
+    importer = QuizImport.new(json: json)
+    assert_difference "Quiz.count", 1 do
+      assert importer.import
+    end
+
+    assert_not_equal existing.id, importer.quiz.id
+    assert_equal "Same Title", importer.quiz.title
+    assert_equal [ "Original Q" ], existing.reload.questions.pluck(:body)
+    assert_equal [ "Imported Q" ], importer.quiz.questions.pluck(:body)
+  end
+
+  test "allows importing an empty quiz with zero questions" do
+    importer = QuizImport.new(json: '{"title": "Empty Quiz", "questions": []}')
+    assert importer.import
+    assert_equal "Empty Quiz", importer.quiz.title
+    assert_equal 0, importer.quiz.questions.count
+  end
+
+  test "round-trip export then import then export produces identical JSON" do
+    quiz = Quiz.create!(title: "Roundtrip & <Special> \"Chars\"")
+    q1 = quiz.questions.build(body: "Line 1\nLine 2 </pre><script>alert(1)</script>", active: false)
+    q1.save_with_options([
+      { title: "Alpha", correct: false },
+      { title: "Beta & Gamma", correct: true },
+      { title: "Delta", correct: true }
+    ])
+    q2 = quiz.questions.build(body: "Second?", active: true)
+    q2.save_with_options([
+      { title: "Yes", correct: true },
+      { title: "No", correct: false }
+    ])
+
+    first_export = quiz.to_export_json
+    importer = QuizImport.new(json: first_export)
+    assert importer.import
+
+    second_export = importer.quiz.to_export_json
+    assert_equal first_export, second_export
+  end
+
+  test "rejects invalid JSON and malformed top-level values without creating anything" do
+    invalid_inputs = [
+      "",
+      "   \n\t  ",
+      "{not json",
+      '{"title": "Trailing comma", "questions": [],}',
+      "[]",
+      '"just a string"',
+      "123",
+      "true",
+      "null",
+      "{}"
+    ]
+
+    invalid_inputs.each do |raw|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Should not import: #{raw.inspect}" do
+        importer = QuizImport.new(json: raw)
+        assert_not importer.import, "Expected failure for #{raw.inspect}"
+        assert importer.errors.any?, "Expected errors for #{raw.inspect}"
+        assert_nil importer.quiz
+      end
+    end
+  end
+
+  test "rejects invalid title and questions structure without creating anything" do
+    invalid_payloads = [
+      { "questions" => [] },
+      { "title" => nil, "questions" => [] },
+      { "title" => "   ", "questions" => [] },
+      { "title" => 123, "questions" => [] },
+      { "title" => [ "a" ], "questions" => [] },
+      { "title" => "Valid" },
+      { "title" => "Valid", "questions" => nil },
+      { "title" => "Valid", "questions" => "not-an-array" },
+      { "title" => "Valid", "questions" => {} },
+      { "title" => "Valid", "questions" => [ "not-an-object" ] },
+      { "title" => "Valid", "questions" => [ nil ] }
+    ]
+
+    invalid_payloads.each do |payload|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Should not import: #{payload.inspect}" do
+        importer = QuizImport.new(json: payload.to_json)
+        assert_not importer.import, "Expected failure for #{payload.inspect}"
+        assert importer.errors.any?
+        assert_nil importer.quiz
+      end
+    end
+  end
+
+  test "rejects question rule violations and imports nothing atomically" do
+    valid_question = {
+      "text" => "Valid question 1",
+      "active" => true,
+      "options" => [
+        { "text" => "Right", "correct" => true },
+        { "text" => "Wrong", "correct" => false }
+      ]
+    }
+
+    bad_questions = [
+      # Missing / blank / non-string question text
+      { "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "   ", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => 42, "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      # Non-boolean active
+      { "text" => "Q", "active" => "true", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "Q", "active" => "false", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "Q", "active" => 1, "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "Q", "active" => nil, "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      # Missing / non-array / too few options
+      { "text" => "Q" },
+      { "text" => "Q", "options" => nil },
+      { "text" => "Q", "options" => {} },
+      { "text" => "Q", "options" => [] },
+      { "text" => "Q", "options" => [ { "text" => "Only one", "correct" => true } ] },
+      # No correct option (explicit false or omitted)
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => false }, { "text" => "B", "correct" => false } ] },
+      { "text" => "Q", "options" => [ { "text" => "A" }, { "text" => "B" } ] },
+      # Invalid option object / text / correct type
+      { "text" => "Q", "options" => [ "A", "B" ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => "" } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => "   " } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "correct" => false } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => 123 } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => "true" }, { "text" => "B" } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B", "correct" => nil } ] },
+      { "text" => "Q", "options" => [ { "text" => "A", "correct" => 1 }, { "text" => "B" } ] }
+    ]
+
+    bad_questions.each_with_index do |bad_q, idx|
+      payload = {
+        "title" => "Atomic Test Quiz #{idx}",
+        "questions" => [ valid_question, bad_q ]
+      }
+
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Case #{idx} should import nothing: #{bad_q.inspect}" do
+        importer = QuizImport.new(json: payload.to_json)
+        assert_not importer.import, "Case #{idx} should fail: #{bad_q.inspect}"
+        assert importer.errors.any?, "Case #{idx} should have errors"
+        assert_nil importer.quiz
+      end
+    end
+  end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..a6d96b5
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "requires title and trims whitespace" do
+    quiz = Quiz.new(title: "   ")
+    assert_not quiz.valid?
+    assert_includes quiz.errors.full_messages, "Title can't be blank"
+
+    quiz.title = "  Frontend Fest 2026  "
+    assert quiz.save
+    assert_equal "Frontend Fest 2026", quiz.title
+  end
+
+  test "destroying quiz cascades to questions and options" do
+    quiz = Quiz.create!(title: "Cascade test")
+    question = quiz.questions.build(body: "Q1", active: true)
+    assert question.save_with_options([
+      { title: "A", correct: true },
+      { title: "B", correct: false }
+    ])
+
+    assert_difference [ "Quiz.count", "Question.count" ], -1 do
+      assert_difference "Option.count", -2 do
+        quiz.destroy!
+      end
+    end
+  end
+
+  test "export writes only title, questions, text, active, options, and correct in exact order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q1 = quiz.questions.build(body: "First question", active: true)
+    assert q1.save_with_options([
+      { title: "418", correct: false },
+      { title: "429", correct: true }
+    ])
+    q2 = quiz.questions.build(body: "Second question", active: false)
+    assert q2.save_with_options([
+      { title: "Alpha", correct: true },
+      { title: "Beta", correct: true },
+      { title: "Gamma", correct: false }
+    ])
+
+    # Reorder so q2 comes first
+    assert q2.move!("up")
+
+    parsed = JSON.parse(quiz.to_export_json)
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 2, parsed["questions"].size
+
+    first_q = parsed["questions"][0]
+    assert_equal [ "text", "active", "options" ], first_q.keys
+    assert_equal "Second question", first_q["text"]
+    assert_equal false, first_q["active"]
+    assert_equal [
+      { "text" => "Alpha", "correct" => true },
+      { "text" => "Beta", "correct" => true },
+      { "text" => "Gamma", "correct" => false }
+    ], first_q["options"]
+    first_q["options"].each { |o| assert_equal [ "text", "correct" ], o.keys }
+
+    second_q = parsed["questions"][1]
+    assert_equal [ "text", "active", "options" ], second_q.keys
+    assert_equal "First question", second_q["text"]
+    assert_equal true, second_q["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], second_q["options"]
+  end
+
+  test "number_of_winners defaults to 3 and validates integer >= 1" do
+    quiz = Quiz.create!(title: "Prize Quiz")
+    assert_equal 3, quiz.number_of_winners
+
+    [ 1, 2, 5, 25 ].each do |valid_n|
+      quiz.number_of_winners = valid_n
+      assert quiz.valid?, "Expected #{valid_n} to be valid"
+    end
+
+    [ 0, -1, -10, nil, "", "  ", 1.5, "abc" ].each do |invalid_n|
+      quiz.number_of_winners = invalid_n
+      assert_not quiz.valid?, "Expected #{invalid_n.inspect} to be invalid"
+      assert quiz.errors[:number_of_winners].any?, "Expected error on number_of_winners for #{invalid_n.inspect}"
+    end
+  end
+test "timer_minutes and timer_seconds default to 0, validate non-negative integers, and compute duration" do
+    quiz = Quiz.create!(title: "Timed Quiz")
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+    assert_equal 0, quiz.timer_duration_seconds
+    assert_not quiz.timer_enabled?
+
+    quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    assert_equal 90, quiz.timer_duration_seconds
+    assert quiz.timer_enabled?
+
+    quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    assert_equal 5, quiz.timer_duration_seconds
+    assert quiz.timer_enabled?
+
+    quiz.update!(timer_minutes: 0, timer_seconds: 90)
+    assert_equal 90, quiz.timer_duration_seconds
+    assert quiz.timer_enabled?
+
+    [ -1, -10, nil, "", "  ", 1.5, "abc", 100_001 ].each do |bad|
+      quiz.timer_minutes = bad
+      quiz.timer_seconds = 0
+      assert_not quiz.valid?, "Expected timer_minutes=#{bad.inspect} to be invalid"
+      assert quiz.errors[:timer_minutes].any?
+
+      quiz.timer_minutes = 0
+      quiz.timer_seconds = bad
+      assert_not quiz.valid?, "Expected timer_seconds=#{bad.inspect} to be invalid"
+      assert quiz.errors[:timer_seconds].any?
+    end
+  end
+
+  test "export excludes timer settings" do
+    quiz = Quiz.create!(title: "Timed Export Quiz", timer_minutes: 2, timer_seconds: 15)
+    q = quiz.questions.build(body: "Question?", active: true)
+    assert q.save_with_options([
+      { title: "Yes", correct: true },
+      { title: "No", correct: false }
+    ])
+
+    parsed = JSON.parse(quiz.to_export_json)
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_not parsed.key?("timer_minutes")
+    assert_not parsed.key?("timer_seconds")
+    assert_not parsed.key?("timer")
+  end
+end
diff --git a/test/system/live_game_system_test.rb b/test/system/live_game_system_test.rb
new file mode 100644
index 0000000..91a03ef
--- /dev/null
+++ b/test/system/live_game_system_test.rb
@@ -0,0 +1,525 @@
+require "application_system_test_case"
+
+class LiveGameSystemTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Ruby Conf Live")
+
+    @q1 = @quiz.questions.build(body: "Which HTTP status means Too Many Requests?", active: true)
+    assert @q1.save_with_options([
+      { title: "418", correct: false },
+      { title: "429", correct: true },
+      { title: "503", correct: false }
+    ])
+
+    @q_inactive = @quiz.questions.build(body: "This inactive question must be skipped", active: false)
+    assert @q_inactive.save_with_options([
+      { title: "Skip A", correct: true },
+      { title: "Skip B", correct: false }
+    ])
+
+    @q2 = @quiz.questions.build(body: "Which protocols support full-duplex?", active: true)
+    assert @q2.save_with_options([
+      { title: "WebSocket", correct: true },
+      { title: "HTTP/2", correct: true },
+      { title: "SMTP", correct: false }
+    ])
+  end
+
+  test "full live game across moderator and multiple phones without page reloads" do
+    # Moderator opens quiz page and starts a game
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+
+    assert_match %r{\A/moderate/games/\d+\z}, current_path
+    assert_text "Ruby Conf Live"
+    assert_text "Players: 0"
+    assert_button "Start"
+
+    join_url = find(".lobby__url").text.strip
+    assert_match %r{\Ahttp://127\.0\.0\.1:\d+/play/[A-Z0-9]{5}\z}, join_url
+
+    # Verify the join link is plain text (not an <a> tag) and QR SVG exists and matches the join URL
+    assert_no_selector ".lobby__url a"
+    assert_selector ".qr svg path"
+    expected_svg_path = Nokogiri::XML(RQRCode::QRCode.new(join_url).as_svg(
+      color: "000000", fill: "ffffff", shape_rendering: "crispEdges",
+      module_size: 6, offset: 24, standalone: true, use_path: true, viewbox: true
+    )).at_css("path")["d"]
+    actual_svg_path = find(".qr svg path", visible: :all)["d"]
+    assert_equal expected_svg_path, actual_svg_path
+
+    # Alice joins on her phone (separate unauthenticated browser session)
+    Capybara.using_session(:alice) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    # Moderator big screen updates LIVE to Players: 1 (no reload!)
+    assert_text "Players: 1"
+
+    # Bob joins on his phone
+    Capybara.using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    # Moderator big screen updates LIVE to Players: 2
+    assert_text "Players: 2"
+
+    # Moderator clicks Start -> Question 1 of 2 (inactive question is skipped!)
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    assert_text "Which HTTP status means Too Many Requests?"
+    assert_text "418"
+    assert_text "429"
+    assert_text "503"
+    assert_text "Answers: 0 / 2"
+    assert_button "Finish"
+    assert_no_text "Correct"
+
+    # Alice and Bob see Question 1 LIVE without reload; no correct answer leaked in source!
+    Capybara.using_session(:alice) do
+      assert_text "Which HTTP status means Too Many Requests?"
+      assert_button "418"
+      assert_button "429"
+      assert_button "503"
+
+      # Security check: page HTML source must not expose correct answer before Finish
+      html = page.html
+      assert_no_match(/"correct"\s*:\s*true/i, html)
+      assert_no_match(/is-correct/i, html)
+
+      # Alice first picks wrong answer 418 -> marked "Your answer"
+      click_button "418"
+      within("button.play-option", text: "418") do
+        assert_text "Your answer"
+      end
+    end
+
+    # Moderator sees Answers: 1 / 2 LIVE
+    assert_text "Answers: 1 / 2"
+
+    # Alice changes her mind to 429 -> last pick counts, still 1 / 2
+    Capybara.using_session(:alice) do
+      click_button "429"
+      within("button.play-option", text: "429") do
+        assert_text "Your answer"
+      end
+      within("button.play-option", text: "418") do
+        assert_no_text "Your answer"
+      end
+    end
+
+    assert_text "Answers: 1 / 2"
+
+    # Charlie joins mid-question! Immediately sees Q1 and can answer!
+    Capybara.using_session(:charlie) do
+      visit join_url
+      fill_in "Your name", with: "Charlie"
+      click_button "Join"
+      assert_text "Which HTTP status means Too Many Requests?"
+      click_button "418"
+      within("button.play-option", text: "418") do
+        assert_text "Your answer"
+      end
+    end
+
+    # Moderator sees Answers: 2 / 3 LIVE (Alice + Charlie answered, Bob connected)
+    assert_text "Answers: 2 / 3"
+
+    # Moderator clicks Finish -> closes Q1, shows counts & "Correct"
+    click_button "Finish"
+    within("ol.stage-options li", text: "418") do
+      assert_text "1"
+      assert_no_text "Correct"
+    end
+    within("ol.stage-options li", text: "429") do
+      assert_text "1"
+      assert_text "Correct"
+    end
+    within("ol.stage-options li", text: "503") do
+      assert_text "0"
+      assert_no_text "Correct"
+    end
+    assert_button "Next"
+    assert_no_button "End quiz"
+
+    # Phones update LIVE: Alice -> Correct!, Charlie -> Wrong!, Bob -> No answer
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+    end
+    Capybara.using_session(:charlie) do
+      assert_text "Wrong!"
+      assert_no_text "Correct!"
+    end
+    Capybara.using_session(:bob) do
+      assert_text "No answer"
+      assert_no_text "Correct!"
+    end
+
+    # Moderator clicks Next -> skips inactive question -> shows Question 2 of 2
+    click_button "Next"
+    assert_text "Question 2 of 2"
+    assert_text "Which protocols support full-duplex?"
+    assert_no_text "This inactive question must be skipped"
+    assert_text "Answers: 0 / 3"
+    assert_button "Finish"
+
+    # Alice picks WebSocket (correct #1), Bob picks HTTP/2 (correct #2)
+    Capybara.using_session(:alice) do
+      assert_text "Which protocols support full-duplex?"
+      click_button "WebSocket"
+      within("button.play-option", text: "WebSocket") { assert_text "Your answer" }
+    end
+    Capybara.using_session(:bob) do
+      assert_text "Which protocols support full-duplex?"
+      click_button "HTTP/2"
+      within("button.play-option", text: "HTTP/2") { assert_text "Your answer" }
+    end
+
+    assert_text "Answers: 2 / 3"
+
+    # Moderator clicks Finish on last question -> both correct options marked "Correct", button is "End quiz"
+    click_button "Finish"
+    within("ol.stage-options li", text: "WebSocket") do
+      assert_text "1"
+      assert_text "Correct"
+    end
+    within("ol.stage-options li", text: "HTTP/2") do
+      assert_text "1"
+      assert_text "Correct"
+    end
+    within("ol.stage-options li", text: "SMTP") do
+      assert_text "0"
+      assert_no_text "Correct"
+    end
+    assert_button "End quiz"
+    assert_no_button "Next"
+
+    Capybara.using_session(:alice) { assert_text "Correct!" }
+    Capybara.using_session(:bob) { assert_text "Correct!" }
+    Capybara.using_session(:charlie) { assert_text "No answer" }
+
+    # Moderator clicks End quiz -> big screen and all phones show "The quiz is over" LIVE
+    click_button "End quiz"
+    assert_text "The quiz is over"
+
+    Capybara.using_session(:alice) { assert_text "The quiz is over" }
+    Capybara.using_session(:bob) { assert_text "The quiz is over" }
+    Capybara.using_session(:charlie) { assert_text "The quiz is over" }
+
+    # New visitor cannot join after end
+    Capybara.using_session(:dave) do
+      visit join_url
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+  end
+
+  test "live presence updates when players leave or open multiple tabs and browser remembers player" do
+    visit moderate_quiz_path(@quiz)
