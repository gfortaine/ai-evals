+      :show, :state, :start, :finish, :next_question, :end_game,
+      :top_winners, :draw_winners, :reset_winners
+    ]
+
+    def create
+      @quiz = Quiz.find(params[:quiz_id])
+      @game = Game.create_for_quiz!(@quiz)
+
+      if @game
+        redirect_to moderate_game_path(@game), status: :see_other
+      else
+        redirect_to moderate_quiz_path(@quiz), status: :see_other, alert: "Activate at least one question before starting a game."
+      end
+    end
