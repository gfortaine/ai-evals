+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static values = { code: String }
+  static targets = ["joinView", "endedView"]
+
+  connect() {
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "JoinStatusChannel", code: this.codeValue },
+      {
+        received: (data) => {
+          if (data?.status === "ended") {
+            this.showEnded()
+          }
+        }
+      }
+    )
+  }
+
+  disconnect() {
+    this.subscription = null
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  showEnded() {
+    if (this.hasJoinViewTarget) this.joinViewTarget.hidden = true
+    if (this.hasEndedViewTarget) this.endedViewTarget.hidden = false
+    this.disconnect()
+  }
+}
diff --git a/app/javascript/controllers/moderator_game_controller.js b/app/javascript/controllers/moderator_game_controller.js
new file mode 100644
index 0000000..2136336
--- /dev/null
+++ b/app/javascript/controllers/moderator_game_controller.js
@@ -0,0 +1,611 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static values = {
+    streamToken: String,
+    stateUrl: String,
+    startUrl: String,
+    finishUrl: String,
+    nextUrl: String,
+    endUrl: String,
+    topWinnersUrl: String,
+    drawWinnersUrl: String,
+    resetWinnersUrl: String,
+    initialState: Object
+  }
+
+  static targets = [
+    "lobbyView",
+    "questionView",
+    "endedView",
+    "playersCount",
+    "progress",
+    "timer",
+    "questionBody",
+    "options",
+    "leaderboard",
+    "emptyLeaderboard",
+    "answersCounter",
+    "startButton",
+    "finishButton",
+    "nextButton",
+    "endButton",
+    "topWinnersButton",
+    "drawWinnersButton",
+    "resetWinnersButton"
+  ]
+
+  connect() {
+    this.state = this.initialStateValue || { status: "lobby", players_count: 0, answers_count: 0 }
+    this.actionPending = false
+    this.wsConnected = false
+    this.tearingDown = false
+    this.lastRenderedOptionsKey = null
+    this.lastRenderedLeaderboardKey = null
+    this.timerInterval = null
+    this.autoFinishTimeout = null
+    this.timerQuestionId = null
+    this.timerClosesAtMs = null
+    this.timerServerNowMs = null
+    this.timerDeadlinePerfMs = null
+    this.timerDurationSeconds = 0
+
+    this.onOnline = () => {
+      this.ensureConnected()
+      this.fetchState()
+    }
+    this.onVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        this.ensureConnected()
+        if (this.wsConnected && this.subscription) {
+          this.subscription.perform("resync")
+        } else {
+          this.fetchState()
+        }
+      }
+    }
+
+    window.addEventListener("online", this.onOnline)
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+
+    this.renderState(this.state)
+    this.subscribe()
+
+    this.graceTimer = setTimeout(() => {
+      if (!this.wsConnected) {
+        this.startFallbackPolling()
+      }
+    }, 2500)
+  }
+
+  disconnect() {
+    this.tearingDown = true
+    clearTimeout(this.graceTimer)
+    this.stopReconnectTimer()
+    this.stopFallbackPolling()
+    this.stopTimer()
+
+    window.removeEventListener("online", this.onOnline)
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+
+    this.subscription = null
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  subscribe() {
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "ModeratorGameChannel", token: this.streamTokenValue },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.stopReconnectTimer()
+          this.stopFallbackPolling()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+          if (!this.tearingDown) {
+            this.startReconnectTimer()
+            this.startFallbackPolling()
+          }
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  ensureConnected() {
+    if (!this.consumer) return
+    if (!this.consumer.connection.isOpen()) {
+      this.consumer.connection.reopen()
+    } else if (this.subscription) {
+      this.subscription.perform("resync")
+    }
+  }
+
+  startReconnectTimer() {
+    if (this.reconnectTimer) return
+    this.reconnectTimer = setInterval(() => {
+      if (this.wsConnected || !this.consumer) {
+        this.stopReconnectTimer()
+        return
+      }
+      if (!this.consumer.connection.isActive()) {
+        this.consumer.connection.reopen()
+      }
+    }, 1500)
+  }
+
+  stopReconnectTimer() {
+    if (this.reconnectTimer) {
+      clearInterval(this.reconnectTimer)
+      this.reconnectTimer = null
+    }
+  }
+
+  startFallbackPolling() {
+    if (this.fallbackTimer || this.tearingDown) return
+    this.fallbackTimer = setInterval(() => {
+      if (this.wsConnected || this.tearingDown) {
+        this.stopFallbackPolling()
+        return
+      }
+      this.fetchState()
+    }, 2000)
+  }
+
+  stopFallbackPolling() {
+    if (this.fallbackTimer) {
+      clearInterval(this.fallbackTimer)
+      this.fallbackTimer = null
+    }
+  }
+
+  async fetchState() {
+    try {
+      const response = await fetch(this.stateUrlValue, {
+        credentials: "same-origin",
+        headers: { "Accept": "application/json" }
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.handleMessage(data)
+    } catch (_error) {
+      // Transient Wi-Fi error; next reconnect or poll will recover.
+    }
+  }
+
+  handleMessage(data) {
+    if (!data) return
+
+    if (data.type === "state") {
+      if (
+        typeof data.state_version === "number" &&
+        typeof this.state?.state_version === "number" &&
+        data.state_version < this.state.state_version
+      ) {
+        return
+      }
+      this.state = data
+      this.renderState(this.state)
+    } else if (data.type === "presence") {
+      this.state.players_count = data.players_count
+      this.renderCounters()
+    } else if (data.type === "counts") {
+      this.state.answers_count = data.answers_count
+      if (typeof data.players_count === "number") {
+        this.state.players_count = data.players_count
+      }
+      this.renderCounters()
+    }
+  }
+
+  start() {
+    this.performAction(this.startUrlValue)
+  }
+
+  finish() {
+    this.performAction(this.finishUrlValue, {
+      expected_position: this.state.current_question_position
+    })
+  }
+
+  next() {
+    this.performAction(this.nextUrlValue, {
+      expected_position: this.state.current_question_position
+    })
+  }
+
+  end() {
+    this.performAction(this.endUrlValue)
+  }
+
+  topWinners() {
+    this.performAction(this.topWinnersUrlValue)
+  }
+
+  drawWinners() {
+    this.performAction(this.drawWinnersUrlValue)
+  }
+
+  resetWinners() {
+    this.performAction(this.resetWinnersUrlValue)
+  }
+
+  async performAction(url, body = {}) {
+    if (this.actionPending) return
+    this.actionPending = true
+    this.setButtonsDisabled(true)
+
+    const csrfToken = document.querySelector("meta[name='csrf-token']")?.content
+
+    try {
+      const response = await fetch(url, {
+        method: "POST",
+        credentials: "same-origin",
+        headers: {
+          "Content-Type": "application/json",
+          "Accept": "application/json",
+          ...(csrfToken ? { "X-CSRF-Token": csrfToken } : {})
+        },
+        body: JSON.stringify(body)
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.handleMessage(data)
+    } catch (_error) {
+      // If request failed due to brief Wi-Fi blip, resync state.
+      this.fetchState()
+    } finally {
+      this.actionPending = false
+      this.setButtonsDisabled(false)
+    }
+  }
+
+  setButtonsDisabled(disabled) {
+    const buttons = [
+      this.startButtonTarget,
+      this.finishButtonTarget,
+      this.nextButtonTarget,
+      this.endButtonTarget,
+      this.topWinnersButtonTarget,
+      this.drawWinnersButtonTarget,
+      this.resetWinnersButtonTarget
+    ]
+    for (const target of buttons) {
+      target.disabled = disabled
+    }
+  }
+
+  renderState(state) {
+    const status = state.status
+
+    if (status === "question" || status === "reveal") {
+      this.element.className = "cover cover--blue cover--calm"
+    } else if (status === "ended") {
+      this.element.className = "cover cover--night"
+    } else {
+      this.element.className = "cover"
+    }
+
+    this.lobbyViewTarget.hidden = status !== "lobby"
+    this.questionViewTarget.hidden = status !== "question" && status !== "reveal"
+    this.endedViewTarget.hidden = status !== "ended"
+
+    this.startButtonTarget.hidden = status !== "lobby"
+    this.finishButtonTarget.hidden = status !== "question"
+    this.nextButtonTarget.hidden = !(status === "reveal" && !state.is_last_question)
+    this.endButtonTarget.hidden = !(status === "reveal" && state.is_last_question)
+    this.topWinnersButtonTarget.hidden = status !== "ended"
+    this.drawWinnersButtonTarget.hidden = status !== "ended"
+    this.resetWinnersButtonTarget.hidden = status !== "ended"
+    this.answersCounterTarget.hidden = status !== "question"
+
+    if (typeof state.number_of_winners === "number") {
+      this.topWinnersButtonTarget.textContent = `Top ${state.number_of_winners}`
+    }
+
+    this.renderCounters()
+    this.syncTimer(state)
+
+    if ((status === "question" || status === "reveal") && state.question) {
+      this.clearLeaderboard()
+      this.renderQuestion(state.question, status === "reveal")
+    } else if (status === "ended") {
+      this.clearOptions()
+      this.renderLeaderboard(state.leaderboard || [])
+    } else {
+      this.clearOptions()
+      this.clearLeaderboard()
+    }
+  }
+
+  clearOptions() {
+    if (this.lastRenderedOptionsKey !== null || this.optionsTarget.childElementCount > 0) {
+      this.lastRenderedOptionsKey = null
+      this.optionsTarget.replaceChildren()
+    }
+  }
+
+  clearLeaderboard() {
+    if (this.lastRenderedLeaderboardKey !== null || this.leaderboardTarget.childElementCount > 0) {
+      this.lastRenderedLeaderboardKey = null
+      this.leaderboardTarget.replaceChildren()
+    }
+    this.emptyLeaderboardTarget.hidden = true
+  }
+
+  renderCounters() {
+    const playersCount = this.state.players_count ?? 0
+    const answersCount = this.state.answers_count ?? 0
+
+    if (this.hasPlayersCountTarget) {
+      this.playersCountTarget.textContent = String(playersCount)
+    }
+    if (this.hasAnswersCounterTarget) {
+      this.answersCounterTarget.textContent = `Answers: ${answersCount} / ${playersCount}`
+    }
+  }
+
+  renderQuestion(question, isReveal) {
+    this.progressTarget.textContent = `Question ${question.position} of ${question.total}`
+    this.questionBodyTarget.textContent = question.body
+
+    const renderKey = JSON.stringify([question.id, isReveal, question.options])
+    if (renderKey === this.lastRenderedOptionsKey) return
+    this.lastRenderedOptionsKey = renderKey
+
+    this.optionsTarget.className = isReveal ? "stage-options stage-options--results" : "stage-options"
+    this.optionsTarget.replaceChildren()
+
+    question.options.forEach((opt, index) => {
+      const li = document.createElement("li")
+      li.className = isReveal && opt.correct ? "stage-option is-correct" : "stage-option"
+
+      if (isReveal) {
+        const bar = document.createElement("span")
+        bar.className = "stage-option__bar"
+        bar.style.setProperty("--share", `${opt.share ?? 0}%`)
+        li.appendChild(bar)
+      }
+
+      const letter = document.createElement("span")
+      letter.className = "stage-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(index)
+      li.append(letter, " ")
+
+      const title = document.createElement("span")
+      title.className = "stage-option__title"
+      title.textContent = opt.title
+      li.append(title)
+
+      if (isReveal) {
+        if (opt.correct) {
+          const mark = document.createElement("span")
+          mark.className = "stage-option__mark"
+          mark.textContent = "Correct"
+          li.append(" ", mark)
+        }
+
+        const count = document.createElement("span")
+        count.className = "stage-option__count"
+        count.textContent = String(opt.count ?? 0)
+        li.append(" ", count)
+      }
+
+      this.optionsTarget.appendChild(li)
+    })
+  }
+
+  renderLeaderboard(entries) {
+    const renderKey = JSON.stringify(entries)
+    if (renderKey === this.lastRenderedLeaderboardKey) return
+    this.lastRenderedLeaderboardKey = renderKey
+
+    this.leaderboardTarget.replaceChildren()
+    this.emptyLeaderboardTarget.hidden = entries.length > 0
+
+    entries.forEach((entry) => {
+      const li = document.createElement("li")
+      li.className = entry.winner ? "leader is-winner" : "leader"
+      li.dataset.playerId = String(entry.player_id)
+
+      const place = document.createElement("span")
+      place.className = "leader__place"
+      place.textContent = String(entry.place)
+
+      const nameWrap = document.createElement("span")
+      nameWrap.className = "leader__name"
+
+      const nameText = document.createElement("span")
+      nameText.className = "leader__name-text"
+      nameText.textContent = entry.name
+      nameWrap.appendChild(nameText)
+
+      if (entry.winner) {
+        const badge = document.createElement("span")
+        badge.className = "leader__badge"
+        badge.textContent = "Winner"
+        nameWrap.append(" ", badge)
+      }
+
+      const score = document.createElement("span")
+      score.className = "leader__score"
+      score.textContent = this.formatPoints(entry.points)
+
+      li.append(place, " ", nameWrap, " ", score)
+      this.leaderboardTarget.appendChild(li)
+    })
+  }
+
+  syncTimer(state) {
+    const isOpenWithTimer =
+      state.status === "question" &&
+      state.question &&
+      state.timer &&
+      typeof state.timer.remaining_ms === "number" &&
+      state.timer.duration_seconds > 0
+
+    if (!isOpenWithTimer) {
+      this.stopTimer()
+      this.hideTimer()
+      return
+    }
+
+    const questionId = state.question.id
+    const closesAtMs = state.timer.closes_at_ms
+    const serverNowMs = state.timer.server_now_ms
+    const remainingMs = Math.max(0, state.timer.remaining_ms)
+    const durationSeconds = state.timer.duration_seconds
+    const newDeadlinePerfMs = performance.now() + remainingMs
+
+    const sameTimer =
+      this.timerQuestionId === questionId &&
+      this.timerClosesAtMs === closesAtMs
+
+    if (!sameTimer) {
+      this.stopTimer()
+      this.timerQuestionId = questionId
+      this.timerClosesAtMs = closesAtMs
+      this.timerServerNowMs = serverNowMs
+      this.timerDeadlinePerfMs = newDeadlinePerfMs
+      this.timerDurationSeconds = durationSeconds
+    } else if (
+      typeof serverNowMs === "number" &&
+      (this.timerServerNowMs === null || serverNowMs >= this.timerServerNowMs)
+    ) {
+      this.timerServerNowMs = serverNowMs
+      if (
+        this.timerDeadlinePerfMs === null ||
+        Math.abs(newDeadlinePerfMs - this.timerDeadlinePerfMs) > 250
+      ) {
+        this.timerDeadlinePerfMs = newDeadlinePerfMs
+      }
+    }
+
+    this.updateTimerDisplay()
+
+    if (!this.timerInterval && this.getRemainingMs() > 0) {
+      this.timerInterval = setInterval(() => {
+        this.updateTimerDisplay()
+      }, 100)
+    }
+  }
+
+  getRemainingMs() {
+    if (this.timerDeadlinePerfMs === null) return 0
+    return Math.max(0, this.timerDeadlinePerfMs - performance.now())
+  }
+
+  updateTimerDisplay() {
+    if (!this.hasTimerTarget) return
+    if (this.state.status !== "question" || this.timerDeadlinePerfMs === null) {
+      this.stopTimer()
+      this.hideTimer()
+      return
+    }
+
+    const remainingMs = this.getRemainingMs()
+    const remainingSeconds = Math.min(
+      this.timerDurationSeconds,
+      Math.max(0, Math.ceil(remainingMs / 1000))
+    )
+
+    this.timerTarget.textContent = this.formatTimer(remainingSeconds)
+    this.timerTarget.hidden = false
+    this.timerTarget.classList.toggle("stage-timer--urgent", remainingSeconds <= 5)
+
+    if (remainingMs <= 0) {
+      if (this.timerInterval) {
+        clearInterval(this.timerInterval)
+        this.timerInterval = null
+      }
+      this.scheduleAutoFinish(this.timerQuestionId, this.state.current_question_position)
+    }
+  }
+
+  scheduleAutoFinish(questionId, position) {
+    if (this.autoFinishTimeout) return
+
+    this.autoFinishTimeout = setTimeout(() => {
+      this.autoFinishTimeout = null
+      this.triggerAutoFinish(questionId, position)
+    }, 150)
+  }
+
+  async triggerAutoFinish(questionId, position) {
+    if (this.tearingDown) return
+    if (this.state.status !== "question") return
+    if (!this.state.question || this.state.question.id !== questionId) return
+
+    if (this.actionPending) {
+      this.scheduleAutoFinish(questionId, position)
+      return
+    }
+
+    await this.performAction(this.finishUrlValue, {
+      expected_position: position
+    })
+
+    if (!this.tearingDown && this.state.status === "question" && this.state.question?.id === questionId) {
+      this.autoFinishTimeout = setTimeout(() => {
+        this.autoFinishTimeout = null
+        this.triggerAutoFinish(questionId, position)
+      }, 500)
+    }
+  }
+
+  stopTimer() {
+    if (this.timerInterval) {
+      clearInterval(this.timerInterval)
+      this.timerInterval = null
+    }
+    if (this.autoFinishTimeout) {
+      clearTimeout(this.autoFinishTimeout)
+      this.autoFinishTimeout = null
+    }
+    this.timerQuestionId = null
+    this.timerClosesAtMs = null
+    this.timerServerNowMs = null
+    this.timerDeadlinePerfMs = null
+    this.timerDurationSeconds = 0
+  }
+
+  hideTimer() {
+    if (!this.hasTimerTarget) return
+    this.timerTarget.hidden = true
+    this.timerTarget.textContent = ""
+    this.timerTarget.classList.remove("stage-timer--urgent")
+  }
+
+  formatTimer(totalSeconds) {
+    const secs = Math.max(0, Math.floor(totalSeconds))
+    const minutes = Math.floor(secs / 60)
+    const seconds = secs % 60
+    return `${minutes}:${String(seconds).padStart(2, "0")}`
+  }
+
+  formatPoints(points) {
+
+    const n = Number(points ?? 0)
+    return n === 1 ? "1 point" : `${n} points`
+  }
+
+  optionLetter(index) {
+    let n = index + 1
+    let result = ""
+    while (n > 0) {
+      n -= 1
+      result = String.fromCharCode(65 + (n % 26)) + result
+      n = Math.floor(n / 26)
+    }
+    return result
+  }
+}
diff --git a/app/javascript/controllers/option_rows_controller.js b/app/javascript/controllers/option_rows_controller.js
new file mode 100644
index 0000000..c21e8d2
--- /dev/null
+++ b/app/javascript/controllers/option_rows_controller.js
@@ -0,0 +1,80 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["list", "row", "template"]
+
+  add() {
+    const fragment = this.templateTarget.content.cloneNode(true)
+    this.listTarget.appendChild(fragment)
+    this.renumber()
+
+    const lastRow = this.rowTargets[this.rowTargets.length - 1]
+    const input = lastRow?.querySelector("[data-role='title-input']")
+    input?.focus()
+  }
+
+  remove(event) {
+    const row = event.currentTarget.closest("[data-option-rows-target='row']")
+    if (!row) return
+
+    if (this.rowTargets.length > 1) {
+      row.remove()
+      this.renumber()
+    } else {
+      const titleInput = row.querySelector("[data-role='title-input']")
+      const correctInput = row.querySelector("[data-role='correct-input']")
+      if (titleInput) titleInput.value = ""
+      if (correctInput) correctInput.checked = false
+    }
+  }
+
+  renumber() {
+    this.rowTargets.forEach((row, index) => {
+      const number = index + 1
+      const titleId = `question_option_rows_${index}_title`
+      const correctId = `question_option_rows_${index}_correct`
+
+      const titleLabel = row.querySelector("[data-role='title-label']")
+      if (titleLabel) {
+        titleLabel.htmlFor = titleId
+        titleLabel.textContent = `Option ${number}`
+      }
+
+      const titleInput = row.querySelector("[data-role='title-input']")
+      if (titleInput) {
+        titleInput.id = titleId
+        titleInput.name = `question[option_rows][${index}][title]`
+        titleInput.placeholder = `Option ${number}`
+        titleInput.setAttribute("aria-label", `Option ${number}`)
+      }
+
+      const correctLabel = row.querySelector("[data-role='correct-label']")
+      if (correctLabel) {
+        correctLabel.htmlFor = correctId
+      }
+
+      const correctHidden = row.querySelector("[data-role='correct-hidden']")
+      if (correctHidden) {
+        correctHidden.name = `question[option_rows][${index}][correct]`
+      }
+
+      const correctInput = row.querySelector("[data-role='correct-input']")
+      if (correctInput) {
+        correctInput.id = correctId
+        correctInput.name = `question[option_rows][${index}][correct]`
+        correctInput.setAttribute("aria-label", `Option ${number} is correct`)
+      }
+
+      const correctText = row.querySelector("[data-role='correct-text']")
+      if (correctText) {
+        correctText.textContent = `Option ${number} is correct`
+      }
+
+      const removeButton = row.querySelector("[data-role='remove-button']")
+      if (removeButton) {
+        removeButton.setAttribute("aria-label", `Remove option ${number}`)
+        removeButton.title = `Remove option ${number}`
+      }
+    })
+  }
+}
diff --git a/app/javascript/controllers/player_game_controller.js b/app/javascript/controllers/player_game_controller.js
new file mode 100644
index 0000000..4bf8e76
--- /dev/null
+++ b/app/javascript/controllers/player_game_controller.js
@@ -0,0 +1,588 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static values = {
+    streamToken: String,
+    answerUrl: String,
+    stateUrl: String,
+    quizTitle: String,
+    playerName: String,
+    initialState: Object
+  }
+
+  static targets = [
+    "headerMeta",
+    "lobbyView",
+    "questionView",
+    "endedView",
+    "progress",
+    "questionBody",
+    "options",
+    "status",
+    "resultPlaceNum",
+    "resultPlace",
+    "resultPoints",
+    "winnerBanner"
+  ]
+
+  connect() {
+    this.state = this.initialStateValue || { status: "lobby" }
+    this.tabId = this.generateTabId()
+    this.currentQuestionId = this.state?.question?.id ?? null
+    this.confirmedOptionId = this.state?.selected_option_id ?? null
+    this.desiredOptionId = this.confirmedOptionId
+    this.answerInFlight = false
+    this.answerRetryTimer = null
+    this.wsConnected = false
+    this.tearingDown = false
+    this.ended = this.state.status === "ended"
+    this.lastRenderedOptionsKey = null
+
+    this.onOnline = () => {
+      this.ensureConnected()
+      if (!this.ended) {
+        this.flushAnswer()
+      }
+    }
+    this.onVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        this.ensureConnected()
+      }
+    }
+    this.onPageHide = () => {
+      this.teardownConnection()
+    }
+    this.onPageShow = (event) => {
+      if (event.persisted && !this.consumer) {
+        this.subscribe()
+      }
+    }
+
+    window.addEventListener("online", this.onOnline)
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+    window.addEventListener("pagehide", this.onPageHide)
+    window.addEventListener("pageshow", this.onPageShow)
+
+    this.renderState(this.state)
+    this.subscribe()
+
+    this.graceTimer = setTimeout(() => {
+      if (!this.wsConnected) {
+        this.startFallbackPolling()
+      }
+    }, 2500)
+  }
+
+  disconnect() {
+    clearTimeout(this.graceTimer)
+    clearTimeout(this.answerRetryTimer)
+    this.stopHeartbeat()
+    this.stopReconnectTimer()
+    this.stopFallbackPolling()
+
+    window.removeEventListener("online", this.onOnline)
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+    window.removeEventListener("pagehide", this.onPageHide)
+    window.removeEventListener("pageshow", this.onPageShow)
+
+    this.teardownConnection()
+  }
+
+  teardownConnection() {
+    this.tearingDown = true
+    this.wsConnected = false
+    this.stopHeartbeat()
+    this.stopReconnectTimer()
+    this.stopFallbackPolling()
+
+    this.subscription = null
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  subscribe() {
+    this.tearingDown = false
+
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "PlayerGameChannel",
+        token: this.streamTokenValue,
+        tab_id: this.tabId
+      },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.stopReconnectTimer()
+          this.stopFallbackPolling()
+          if (!this.ended) {
+            this.startHeartbeat()
+            this.flushAnswer()
+          }
+        },
+        disconnected: () => {
+          this.wsConnected = false
+          this.stopHeartbeat()
+          if (!this.tearingDown) {
+            this.startReconnectTimer()
+            this.startFallbackPolling()
+          }
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  ensureConnected() {
+    if (!this.consumer) {
+      this.subscribe()
+      return
+    }
+    if (!this.consumer.connection.isOpen()) {
+      this.consumer.connection.reopen()
+    } else if (this.subscription) {
+      if (!this.ended) {
+        this.subscription.perform("heartbeat")
+      }
+      this.subscription.perform("resync")
+    }
+  }
+
+  startHeartbeat() {
+    if (this.heartbeatTimer || this.ended) return
+    this.heartbeatTimer = setInterval(() => {
+      if (this.wsConnected && this.subscription && !this.ended) {
+        this.subscription.perform("heartbeat")
+      }
+    }, 4000)
+  }
+
+  stopHeartbeat() {
+    if (this.heartbeatTimer) {
+      clearInterval(this.heartbeatTimer)
+      this.heartbeatTimer = null
+    }
+  }
+
+  startReconnectTimer() {
+    if (this.reconnectTimer || this.tearingDown) return
+    this.reconnectTimer = setInterval(() => {
+      if (this.wsConnected || this.tearingDown || !this.consumer) {
+        this.stopReconnectTimer()
+        return
+      }
+      if (!this.consumer.connection.isActive()) {
+        this.consumer.connection.reopen()
+      }
+    }, 1500)
+  }
+
+  stopReconnectTimer() {
+    if (this.reconnectTimer) {
+      clearInterval(this.reconnectTimer)
+      this.reconnectTimer = null
+    }
+  }
+
+  startFallbackPolling() {
+    if (this.fallbackTimer || this.tearingDown) return
+    this.fallbackTimer = setInterval(() => {
+      if (this.wsConnected || this.tearingDown) {
+        this.stopFallbackPolling()
+        return
+      }
+      this.fetchState(true)
+    }, 2000)
+  }
+
+  stopFallbackPolling() {
+    if (this.fallbackTimer) {
+      clearInterval(this.fallbackTimer)
+      this.fallbackTimer = null
+    }
+  }
+
+  async fetchState(asFallback = false) {
+    try {
+      const headers = { "Accept": "application/json" }
+      if (asFallback && !this.ended) {
+        headers["X-Quizzy-Fallback-Client"] = this.tabId
+      }
+      const response = await fetch(this.stateUrlValue, {
+        credentials: "same-origin",
+        headers
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.handleMessage(data)
+    } catch (_error) {
+      // Transient Wi-Fi failure; next reconnect or poll will recover.
+    }
+  }
+
+  handleMessage(data) {
+    if (!data) return
+
+    if (data.type === "selection") {
+      if (
+        this.state.status === "question" &&
+        data.game_question_id === this.currentQuestionId &&
+        !this.answerInFlight &&
+        this.desiredOptionId === this.confirmedOptionId
+      ) {
+        this.confirmedOptionId = data.selected_option_id
+        this.desiredOptionId = data.selected_option_id
+        this.updateSelectionUI()
+      }
+      return
+    }
+
+    if (data.type !== "state") return
+
+    if (
+      typeof data.state_version === "number" &&
+      typeof this.state?.state_version === "number" &&
+      data.state_version < this.state.state_version
+    ) {
+      return
+    }
+
+    const status = data.status
+
+    if (status === "lobby") {
+      clearTimeout(this.answerRetryTimer)
+      this.currentQuestionId = null
+      this.confirmedOptionId = null
+      this.desiredOptionId = null
+      this.state = data
+      this.renderState(this.state)
+      return
+    }
+
+    if (status === "question") {
+      const incomingQid = data.question?.id ?? null
+      const hasPersonalizedSelection = Object.prototype.hasOwnProperty.call(data, "selected_option_id")
+
+      if (incomingQid !== this.currentQuestionId) {
+        clearTimeout(this.answerRetryTimer)
+        this.currentQuestionId = incomingQid
+        this.confirmedOptionId = hasPersonalizedSelection ? data.selected_option_id : null
+        this.desiredOptionId = this.confirmedOptionId
+      } else if (hasPersonalizedSelection) {
+        this.confirmedOptionId = data.selected_option_id
+        if (!this.answerInFlight && this.desiredOptionId == null) {
+          this.desiredOptionId = data.selected_option_id
+        }
+      }
+
+      this.state = data
+      this.renderState(this.state)
+      return
+    }
+
+    if (status === "reveal") {
+      clearTimeout(this.answerRetryTimer)
+      const incomingQid = data.question?.id ?? null
+      const hasPersonalizedSelection = Object.prototype.hasOwnProperty.call(data, "selected_option_id")
+      const sameQuestion = incomingQid === this.currentQuestionId
+      const hadUnconfirmedPick =
+        sameQuestion &&
+        (this.answerInFlight || this.desiredOptionId !== this.confirmedOptionId)
+
+      this.currentQuestionId = incomingQid
+
+      if (hasPersonalizedSelection) {
+        this.confirmedOptionId = data.selected_option_id
+        this.desiredOptionId = data.selected_option_id
+        this.state = data
+        this.renderState(this.state)
+      } else {
+        const pickedId = sameQuestion ? this.confirmedOptionId : null
+        if (!sameQuestion) {
+          this.confirmedOptionId = null
+          this.desiredOptionId = null
+        }
+        const options = data.question?.options || []
+        const pickedOpt = options.find((opt) => opt.id === pickedId)
+        const result = !pickedOpt ? "no_answer" : (pickedOpt.correct ? "correct" : "wrong")
+
+        this.state = {
+          ...data,
+          selected_option_id: pickedId,
+          result
+        }
+        this.renderState(this.state)
+
+        if (hadUnconfirmedPick || !sameQuestion) {
+          this.fetchState(false)
+        }
+      }
+      return
+    }
+
+    if (status === "ended") {
+      clearTimeout(this.answerRetryTimer)
+      this.ended = true
+      this.stopHeartbeat()
+      this.state = data
+      this.renderState(this.state)
+
+      if (typeof data.place !== "number") {
+        this.fetchState(false)
+      }
+    }
+  }
+
+  pick(event) {
+    if (this.state.status !== "question" || !this.currentQuestionId) return
+
+    const optionId = Number(event.currentTarget.dataset.optionId)
+    if (!Number.isFinite(optionId)) return
+
+    this.desiredOptionId = optionId
+    this.updateSelectionUI()
+    this.flushAnswer()
+  }
+
+  async flushAnswer() {
+    if (this.answerInFlight) return
+    if (this.state.status !== "question" || !this.currentQuestionId) return
+    if (this.desiredOptionId == null || this.desiredOptionId === this.confirmedOptionId) return
+
+    clearTimeout(this.answerRetryTimer)
+
+    const sendingQuestionId = this.currentQuestionId
+    const sendingOptionId = this.desiredOptionId
+    this.answerInFlight = true
+
+    const csrfToken = document.querySelector("meta[name='csrf-token']")?.content
+
+    try {
+      const response = await fetch(this.answerUrlValue, {
+        method: "POST",
+        credentials: "same-origin",
+        headers: {
+          "Content-Type": "application/json",
+          "Accept": "application/json",
+          ...(csrfToken ? { "X-CSRF-Token": csrfToken } : {})
+        },
+        body: JSON.stringify({
+          game_question_id: sendingQuestionId,
+          game_option_id: sendingOptionId
+        })
+      })
+
+      if (response.ok) {
+        const data = await response.json()
+        if (this.currentQuestionId === sendingQuestionId) {
+          this.confirmedOptionId = data.selected_option_id
+        }
+        this.answerInFlight = false
+
+        if (
+          this.state.status === "question" &&
+          this.currentQuestionId === sendingQuestionId &&
+          this.desiredOptionId !== this.confirmedOptionId
+        ) {
+          this.flushAnswer()
+        }
+      } else if (response.status === 409) {
+        const data = await response.json().catch(() => null)
+        this.answerInFlight = false
+        if (data?.state) {
+          this.handleMessage(data.state)
+        } else {
+          this.fetchState(false)
+        }
+      } else {
+        this.answerInFlight = false
+        this.scheduleAnswerRetry(sendingQuestionId)
+      }
+    } catch (_error) {
+      this.answerInFlight = false
+      this.scheduleAnswerRetry(sendingQuestionId)
+    }
+  }
+
+  scheduleAnswerRetry(questionId) {
+    if (this.ended || this.state.status !== "question" || this.currentQuestionId !== questionId) return
+    clearTimeout(this.answerRetryTimer)
+    this.answerRetryTimer = setTimeout(() => {
+      this.flushAnswer()
+    }, 1000)
+  }
+
+  renderState(state) {
+    const status = state.status
+
+    if (this.hasHeaderMetaTarget) {
+      this.headerMetaTarget.textContent =
+        status === "lobby"
+          ? this.quizTitleValue
+          : `Hi, ${this.playerNameValue}!`
+    }
+
+    this.lobbyViewTarget.hidden = status !== "lobby"
+    this.questionViewTarget.hidden = status !== "question" && status !== "reveal"
+    this.endedViewTarget.hidden = status !== "ended"
+
+    if ((status === "question" || status === "reveal") && state.question) {
+      this.clearEnded()
+      this.renderQuestion(state.question, status === "reveal", state.result)
+    } else if (status === "ended") {
+      this.clearOptions()
+      this.renderEnded(state)
+    } else {
+      this.clearOptions()
+      this.clearEnded()
+    }
+  }
+
+  clearOptions() {
+    if (this.lastRenderedOptionsKey !== null || this.optionsTarget.childElementCount > 0) {
+      this.lastRenderedOptionsKey = null
+      this.optionsTarget.replaceChildren()
+    }
+  }
+
+clearEnded() {
+  if (this.hasResultPlaceNumTarget) this.resultPlaceNumTarget.textContent = ""
+  if (this.hasResultPlaceTarget) this.resultPlaceTarget.textContent = ""
+  if (this.hasResultPointsTarget) this.resultPointsTarget.textContent = ""
+  if (this.hasWinnerBannerTarget) {
+    this.winnerBannerTarget.textContent = ""
+    this.winnerBannerTarget.hidden = true
+  }
+}
+
+renderEnded(state) {
+  if (typeof state.place === "number" && typeof state.total_players === "number") {
+    if (this.hasResultPlaceNumTarget) {
+      this.resultPlaceNumTarget.textContent = `#${state.place}`
+    }
+    if (this.hasResultPlaceTarget) {
+      this.resultPlaceTarget.textContent = `Place ${state.place} of ${state.total_players}`
+    }
+  }
+
+  if (this.hasResultPointsTarget && typeof state.points === "number") {
+    this.resultPointsTarget.textContent = this.formatPoints(state.points)
+  }
+
+  if (this.hasWinnerBannerTarget) {
+    if (state.winner) {
+      this.winnerBannerTarget.textContent = "You won!"
+      this.winnerBannerTarget.hidden = false
+    } else {
+      this.winnerBannerTarget.textContent = ""
+      this.winnerBannerTarget.hidden = true
+    }
+  }
+}
+
+  renderQuestion(question, isReveal, result) {
+    this.progressTarget.textContent = `Question ${question.position} of ${question.total}`
+    this.questionBodyTarget.textContent = question.body
+
+    const activeSelection = isReveal ? this.confirmedOptionId : this.desiredOptionId
+    const renderKey = JSON.stringify([question.id, isReveal, question.options, activeSelection])
+
+    if (renderKey !== this.lastRenderedOptionsKey) {
+      this.lastRenderedOptionsKey = renderKey
+      this.optionsTarget.className = isReveal ? "play-options is-locked is-revealed" : "play-options"
+      this.optionsTarget.replaceChildren()
+
+      question.options.forEach((opt, index) => {
+        const isPicked = activeSelection === opt.id
+        const isCorrect = isReveal && Boolean(opt.correct)
+
+        const btn = document.createElement("button")
+        btn.type = "button"
+        btn.className = "play-option"
+        if (isPicked) btn.classList.add("is-picked")
+        if (isCorrect) btn.classList.add("is-correct")
+        btn.dataset.action = "player-game#pick"
+        btn.dataset.optionId = String(opt.id)
+        btn.setAttribute("aria-pressed", isPicked ? "true" : "false")
+        btn.disabled = isReveal
+
+        const letter = document.createElement("span")
+        letter.className = "play-option__letter"
+        letter.setAttribute("aria-hidden", "true")
+        letter.textContent = this.optionLetter(index)
+
+        const title = document.createElement("span")
+        title.className = "play-option__title"
+        title.textContent = opt.title
+
+        const mark = document.createElement("span")
+        mark.className = "play-option__mark"
+        mark.textContent = isPicked ? "Your answer" : ""
+
+        btn.append(letter, " ", title, " ", mark)
+        this.optionsTarget.appendChild(btn)
+      })
+    }
+
+    if (isReveal) {
+      if (result === "correct") {
+        this.statusTarget.textContent = "Correct!"
+        this.statusTarget.className = "play-status play-status--right"
+      } else if (result === "wrong") {
+        this.statusTarget.textContent = "Wrong!"
+        this.statusTarget.className = "play-status play-status--wrong"
+      } else {
+        this.statusTarget.textContent = "No answer"
+        this.statusTarget.className = "play-status play-status--neutral"
+      }
+      this.statusTarget.hidden = false
+    } else {
+      this.statusTarget.hidden = true
+      this.statusTarget.textContent = ""
+      this.statusTarget.className = "play-status"
+    }
+  }
+
+  updateSelectionUI() {
+    this.lastRenderedOptionsKey = null
+    const buttons = this.optionsTarget.querySelectorAll("button.play-option")
+    buttons.forEach((btn) => {
+      const optId = Number(btn.dataset.optionId)
+      const isPicked = optId === this.desiredOptionId
+      btn.classList.toggle("is-picked", isPicked)
+      btn.setAttribute("aria-pressed", isPicked ? "true" : "false")
+      const mark = btn.querySelector(".play-option__mark")
+      if (mark) {
+        mark.textContent = isPicked ? "Your answer" : ""
+      }
+    })
+  }
+
+  formatPoints(points) {
+    const n = Number(points ?? 0)
+    return n === 1 ? "1 point" : `${n} points`
+  }
+
+  optionLetter(index) {
+    let n = index + 1
+    let result = ""
+    while (n > 0) {
+      n -= 1
+      result = String.fromCharCode(65 + (n % 26)) + result
+      n = Math.floor(n / 26)
+    }
+    return result
+  }
+
+  generateTabId() {
+    if (window.crypto && typeof window.crypto.randomUUID === "function") {
+      return window.crypto.randomUUID()
+    }
+    return `${Date.now()}-${Math.random().toString(36).slice(2)}`
+  }
+}
diff --git a/app/javascript/controllers/preview_controller.js b/app/javascript/controllers/preview_controller.js
new file mode 100644
index 0000000..436bb51
--- /dev/null
+++ b/app/javascript/controllers/preview_controller.js
@@ -0,0 +1,163 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { questions: Array }
+  static targets = [
+    "questionView",
+    "scoreView",
+    "progress",
+    "questionBody",
+    "options",
+    "status",
+    "actions",
+    "nextButton",
+    "scoreButton",
+    "scoreBig",
+    "scoreText",
+    "bannerRestart"
+  ]
+
+  connect() {
+    this.currentIndex = 0
+    this.score = 0
+    this.answered = false
+    this.renderQuestion()
+  }
+
+  pick(event) {
+    if (this.answered) return
+
+    const button = event.currentTarget
+    const optionIndex = Number(button.dataset.optionIndex)
+    const question = this.questionsValue[this.currentIndex]
+    const picked = question?.options?.[optionIndex]
+    if (!picked) return
+
+    this.answered = true
+
+    if (picked.correct) {
+      this.score += 1
+      this.statusTarget.textContent = "Correct!"
+      this.statusTarget.className = "play-status play-status--right"
+    } else {
+      this.statusTarget.textContent = "Wrong!"
+      this.statusTarget.className = "play-status play-status--wrong"
+    }
+    this.statusTarget.hidden = false
+
+    this.optionsTarget.classList.add("is-locked", "is-revealed")
+
+    const buttons = this.optionsTarget.querySelectorAll("button.play-option")
+    buttons.forEach((btn, idx) => {
+      const opt = question.options[idx]
+      const mark = btn.querySelector(".play-option__mark")
+      btn.disabled = true
+
+      if (idx === optionIndex) {
+        btn.classList.add("is-picked")
+      }
+
+      if (opt.correct) {
+        btn.classList.add("is-correct")
+        btn.dataset.correct = "true"
+        if (mark) mark.textContent = "✓ Correct"
+      } else if (idx === optionIndex) {
+        if (mark) mark.textContent = "✕"
+      }
+    })
+
+    const isLast = this.currentIndex >= this.questionsValue.length - 1
+    this.nextButtonTarget.hidden = isLast
+    this.scoreButtonTarget.hidden = !isLast
+    this.actionsTarget.hidden = false
+  }
+
+  next() {
+    if (!this.answered) return
+    if (this.currentIndex >= this.questionsValue.length - 1) return
+
+    this.currentIndex += 1
+    this.answered = false
+    this.renderQuestion()
+  }
+
+  showScore() {
+    if (!this.answered) return
+
+    const total = this.questionsValue.length
+    this.scoreBigTarget.textContent = `${this.score}/${total}`
+    this.scoreTextTarget.textContent = `Score: ${this.score}/${total}`
+
+    this.questionViewTarget.hidden = true
+    this.scoreViewTarget.hidden = false
+    if (this.hasBannerRestartTarget) {
+      this.bannerRestartTarget.hidden = true
+    }
+  }
+
+  restart() {
+    this.currentIndex = 0
+    this.score = 0
+    this.answered = false
+
+    this.scoreViewTarget.hidden = true
+    this.questionViewTarget.hidden = false
+    if (this.hasBannerRestartTarget) {
+      this.bannerRestartTarget.hidden = false
+    }
+
+    this.renderQuestion()
+  }
+
+  renderQuestion() {
+    const total = this.questionsValue.length
+    const question = this.questionsValue[this.currentIndex]
+    if (!question) return
+
+    this.progressTarget.textContent = `Question ${this.currentIndex + 1} of ${total}`
+    this.questionBodyTarget.textContent = question.body
+
+    this.optionsTarget.className = "play-options"
+    this.optionsTarget.replaceChildren()
+
+    question.options.forEach((option, index) => {
+      const btn = document.createElement("button")
+      btn.type = "button"
+      btn.className = "play-option"
+      btn.dataset.action = "preview#pick"
+      btn.dataset.optionIndex = String(index)
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(index)
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = option.title
+
+      const mark = document.createElement("span")
+      mark.className = "play-option__mark"
+
+      btn.append(letter, title, mark)
+      this.optionsTarget.appendChild(btn)
+    })
+
+    this.statusTarget.hidden = true
+    this.statusTarget.textContent = ""
+    this.actionsTarget.hidden = true
+    this.nextButtonTarget.hidden = true
+    this.scoreButtonTarget.hidden = true
+  }
+
+  optionLetter(index) {
+    let n = index + 1
+    let result = ""
+    while (n > 0) {
+      n -= 1
+      result = String.fromCharCode(65 + (n % 26)) + result
+      n = Math.floor(n / 26)
+    }
+    return result
+  }
+}
diff --git a/app/javascript/controllers/question_active_controller.js b/app/javascript/controllers/question_active_controller.js
new file mode 100644
index 0000000..2aeb987
--- /dev/null
+++ b/app/javascript/controllers/question_active_controller.js
@@ -0,0 +1,63 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["summary", "item"]
+
+  async toggle(event) {
+    const checkbox = event.currentTarget
+    const form = checkbox.closest("form")
+    const item = checkbox.closest("[data-question-active-target='item']")
+    const active = checkbox.checked
+
+    checkbox.defaultChecked = active
+    if (item) {
+      item.classList.toggle("question-item--inactive", !active)
+    }
+
+    const csrfToken = document.querySelector("meta[name='csrf-token']")?.content
+
+    try {
+      const response = await fetch(form.action, {
+        method: "PATCH",
+        credentials: "same-origin",
+        headers: {
+          "Content-Type": "application/json",
+          "Accept": "application/json",
+          ...(csrfToken ? { "X-CSRF-Token": csrfToken } : {})
+        },
+        body: JSON.stringify({ question: { active } }),
+        keepalive: true
+      })
+
+      if (!response.ok) {
+        throw new Error(`HTTP ${response.status}`)
+      }
+
+      const data = await response.json()
+      this.applyServerState(data)
+    } catch (_error) {
+      checkbox.checked = !active
+      checkbox.defaultChecked = !active
+      if (item) {
+        item.classList.toggle("question-item--inactive", active)
+      }
+    }
+  }
+
+  applyServerState(data) {
+    if (this.hasSummaryTarget) {
+      const word = data.total_count === 1 ? "question" : "questions"
+      this.summaryTarget.textContent = `${data.active_count} of ${data.total_count} ${word} active`
+    }
+
+    this.itemTargets.forEach((item) => {
+      const id = item.dataset.questionId
+      const number = data.numbers?.[id]
+      const numEl = item.querySelector("[data-role='num']")
+      if (numEl) {
+        numEl.textContent = number ?? "—"
+      }
+      item.classList.toggle("question-item--inactive", number == null)
+    })
+  }
+}
