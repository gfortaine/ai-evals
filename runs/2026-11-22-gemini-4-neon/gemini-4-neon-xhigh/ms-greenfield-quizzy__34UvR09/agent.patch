+require "rqrcode"
+
+module ApplicationHelper
+  def option_letter(index)
+    n = index + 1
+    result = +""
+    while n > 0
+      n -= 1
+      result.prepend(("A".ord + (n % 26)).chr)
+      n /= 26
+    end
+    result
+  end
+
+  def format_points(points)
+    n = points.to_i
+    n == 1 ? "1 point" : "#{n} points"
+  end
+
+  def format_timer(remaining_ms, max_seconds: nil)
+    secs = [ (remaining_ms.to_f / 1000.0).ceil, 0 ].max
+    secs = [ secs, max_seconds.to_i ].min if max_seconds.present?
+    format("%d:%02d", secs / 60, secs % 60)
+  end
+
+  def qr_code_svg(content)
+    qr = RQRCode::QRCode.new(content.to_s)
+    qr.as_svg(
+      color: "000000",
+      fill: "ffffff",
+      shape_rendering: "crispEdges",
+      module_size: 6,
+      offset: 24,
+      standalone: true,
+      use_path: true,
+      viewbox: true
+    ).sub(/\A<\?xml[^?]*\?>\s*/, "")
+  end
+
+  def big_screen_cover_class(status)
+    case status.to_s
+    when "question", "reveal"
+      "cover cover--blue cover--calm"
+    when "ended"
+      "cover cover--night"
+    else
+      "cover"
+    end
+  end
+end
