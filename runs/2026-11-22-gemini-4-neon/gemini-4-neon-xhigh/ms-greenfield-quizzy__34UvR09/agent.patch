@@ -0,0 +1,81 @@
+require "test_helper"
+
+class ModeratorAuthAndRoutesTest < ActionDispatch::IntegrationTest
+  test "GET /up returns 200 without authentication" do
+    get "/up"
+    assert_response :success
+  end
+
+  test "GET / returns 200 without authentication" do
+    get "/"
+    assert_response :success
+  end
+
+  test "all /moderate pages return 401 with missing or wrong credentials" do
+    quiz = Quiz.create!(title: "Auth Test Quiz")
+    question = quiz.questions.build(body: "Q1", active: true)
+    question.save_with_options([ { title: "A", correct: true }, { title: "B", correct: false } ])
+
+    paths = [
+      "/moderate",
+      "/moderate/import",
+      "/moderate/quizzes",
+      "/moderate/quizzes/new",
+      "/moderate/quizzes/#{quiz.id}",
+      "/moderate/quizzes/#{quiz.id}/edit",
+      "/moderate/quizzes/#{quiz.id}/preview",
+      "/moderate/quizzes/#{quiz.id}/export",
+      "/moderate/quizzes/#{quiz.id}/questions/new",
+      "/moderate/quizzes/#{quiz.id}/questions/#{question.id}/edit"
+    ]
+
+    paths.each do |path|
+      get path
+      assert_response :unauthorized, "Expected 401 without creds for #{path}"
+
+      get path, headers: basic_auth_headers("wrong", "creds")
+      assert_response :unauthorized, "Expected 401 with wrong creds for #{path}"
+
+      get path, headers: basic_auth_headers(ENV["QUIZZY_MODERATOR_USERNAME"], "wrong")
+      assert_response :unauthorized, "Expected 401 with wrong password for #{path}"
+
+      get path, headers: basic_auth_headers
+      assert_response :success, "Expected 200 with valid creds for #{path}"
+    end
+  end
+
+  test "POST /moderate/import enforces authentication and handles valid and invalid submissions" do
+    valid_json = {
+      title: "Auth Import Quiz",
+      questions: [
+        {
+          text: "Q1",
+          options: [ { text: "A", correct: true }, { text: "B" } ]
+        }
+      ]
+    }.to_json
+
+    assert_no_difference "Quiz.count" do
+      post "/moderate/import", params: { quiz_import: { json: valid_json } }
+      assert_response :unauthorized
+    end
+
+    assert_no_difference "Quiz.count" do
+      post "/moderate/import", headers: basic_auth_headers
+      assert_response :unprocessable_entity
+    end
+
+    assert_difference "Quiz.count", 1 do
+      post "/moderate/import",
+        params: { quiz_import: { json: valid_json } },
+        headers: basic_auth_headers
+      assert_response :see_other
+      assert_redirected_to moderate_quiz_path(Quiz.last)
+    end
+  end
+
+  test "accepts any Host header over plain HTTP without HTTPS redirect" do
+    get "/moderate", headers: basic_auth_headers.merge("Host" => "arbitrary-conference-host.local:3000")
+    assert_response :success
+  end
+end
diff --git a/test/integration/prizes_flow_test.rb b/test/integration/prizes_flow_test.rb
new file mode 100644
index 0000000..ef90ffb
--- /dev/null
+++ b/test/integration/prizes_flow_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class PrizesFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Conference Prizes Quiz")
+    q = @quiz.questions.build(body: "Best language?", active: true)
+    assert q.save_with_options([
+      { title: "Ruby", correct: true },
+      { title: "Cobol", correct: false }
+    ])
+  end
+
+  test "quiz settings validates and updates number_of_winners" do
+    assert_equal 3, @quiz.number_of_winners
+
+    get edit_moderate_quiz_path(@quiz), headers: basic_auth_headers
+    assert_response :success
+    assert_includes response.body, "Number of winners"
+
+    # Invalid: 0, negative, blank
+    [ 0, -2, "", "1.5" ].each do |bad|
+      patch moderate_quiz_path(@quiz),
+        params: { quiz: { title: @quiz.title, number_of_winners: bad } },
+        headers: basic_auth_headers
+      assert_response :unprocessable_entity
+      assert_equal 3, @quiz.reload.number_of_winners
+    end
+
+    # Valid update
+    patch moderate_quiz_path(@quiz),
+      params: { quiz: { title: @quiz.title, number_of_winners: 2 } },
+      headers: basic_auth_headers
+    assert_redirected_to moderate_quiz_path(@quiz)
+    assert_equal 2, @quiz.reload.number_of_winners
+  end
+
+  test "winner endpoints require moderator auth and return updated leaderboard and player states" do
+    @quiz.update!(number_of_winners: 1)
+    game = Game.create_for_quiz!(@quiz)
+    gq = game.game_questions.includes(:game_options).first
+    ruby_opt = gq.game_options.find_by!(title: "Ruby")
+
+    # Unauthenticated calls rejected
+    [ top_winners_moderate_game_path(game), draw_winners_moderate_game_path(game), reset_winners_moderate_game_path(game) ].each do |url|
+      post url, as: :json
+      assert_response :unauthorized
+    end
+
+    # Alice joins and answers correctly
+    post play_join_path(game.code), params: { player: { name: "Alice" } }
+    assert_redirected_to play_path(game.code)
+
+    # Bob joins in another session and does not answer
+    open_session do |bob_session|
+      bob_session.post play_join_path(game.code), params: { player: { name: "Bob" } }
+      bob_session.assert_redirected_to play_path(game.code)
+    end
+
+    post start_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+
+    post play_answer_path(game.code), params: { game_question_id: gq.id, game_option_id: ruby_opt.id }, as: :json
+    assert_response :success
+
+    # During reveal, Alice's state does NOT expose points or place
+    post finish_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    get play_state_path(game.code), as: :json
+    reveal_json = JSON.parse(response.body)
+    assert_equal "reveal", reveal_json["status"]
+    assert_not reveal_json.key?("points")
+    assert_not reveal_json.key?("place")
+    assert_not reveal_json.key?("winner")
+
+    # End game
+    post end_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    end_json = JSON.parse(response.body)
+    assert_equal "ended", end_json["status"]
+    assert_equal 1, end_json["number_of_winners"]
+    assert_equal 2, end_json["leaderboard"].size
+    assert_equal "Alice", end_json["leaderboard"][0]["name"]
+    assert_equal 1, end_json["leaderboard"][0]["points"]
+    assert_equal false, end_json["leaderboard"][0]["winner"]
+
+    # Alice sees Place 1 of 2 and 1 point, no "You won!" yet
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "Place 1 of 2"
+    assert_includes response.body, "of 2"
+    assert_includes response.body, "1 point"
+    assert_not_includes response.body, "You won!"
+
+    get play_state_path(game.code), as: :json
+    alice_end_json = JSON.parse(response.body)
+    assert_equal 1, alice_end_json["place"]
+    assert_equal 2, alice_end_json["total_players"]
+    assert_equal 1, alice_end_json["points"]
+    assert_equal false, alice_end_json["winner"]
+
+    # Pick Top 1 -> Alice wins
+    post top_winners_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    top_json = JSON.parse(response.body)
+    assert_equal true, top_json["leaderboard"][0]["winner"]
+    assert_equal false, top_json["leaderboard"][1]["winner"]
+
+    get play_path(game.code)
+    assert_includes response.body, "You won!"
+
+    get play_state_path(game.code), as: :json
+    assert_equal true, JSON.parse(response.body)["winner"]
+
+    # Reset winners -> Alice no longer wins
+    post reset_winners_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    reset_json = JSON.parse(response.body)
+    assert_equal [ false, false ], reset_json["leaderboard"].map { |e| e["winner"] }
+
+    get play_path(game.code)
+    assert_not_includes response.body, "You won!"
+
+    # Draw -> Alice wins (only player with points)
+    post draw_winners_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    draw_json = JSON.parse(response.body)
+    assert_equal [ true, false ], draw_json["leaderboard"].map { |e| e["winner"] }
+
+    # Unjoined visitor still sees only "The quiz is over"
+    open_session do |stranger|
+      stranger.get play_path(game.code)
+      stranger.assert_response :success
+      stranger.assert_includes stranger.response.body, "The quiz is over"
+      stranger.assert_not_includes stranger.response.body, "Place "
+      stranger.assert_not_includes stranger.response.body, "You won!"
+    end
+  end
+end
diff --git a/test/integration/timer_flow_test.rb b/test/integration/timer_flow_test.rb
new file mode 100644
index 0000000..d52e1ab
--- /dev/null
+++ b/test/integration/timer_flow_test.rb
@@ -0,0 +1,127 @@
+require "test_helper"
+
+class TimerFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Timer Integration Quiz")
+    q1 = @quiz.questions.build(body: "What is 2 + 2?", active: true)
+    assert q1.save_with_options([
+      { title: "4", correct: true },
+      { title: "5", correct: false }
+    ])
+    q2 = @quiz.questions.build(body: "What is 3 + 3?", active: true)
+    assert q2.save_with_options([
+      { title: "6", correct: true },
+      { title: "7", correct: false }
+    ])
+  end
+
+  test "quiz settings updates timer minutes and seconds, validates invalid input, and export excludes timer" do
+    get edit_moderate_quiz_path(@quiz), headers: basic_auth_headers
+    assert_response :success
+    assert_includes response.body, "Timer minutes"
+    assert_includes response.body, "Timer seconds"
+
+    # Rejects negative and blank values
+    [
+      { timer_minutes: -1, timer_seconds: 0 },
+      { timer_minutes: 0, timer_seconds: -5 },
+      { timer_minutes: "", timer_seconds: 10 },
+      { timer_minutes: 1, timer_seconds: "" },
+      { timer_minutes: "1.5", timer_seconds: 0 }
+    ].each do |bad_params|
+      patch moderate_quiz_path(@quiz),
+        params: { quiz: { title: @quiz.title, number_of_winners: 3 }.merge(bad_params) },
+        headers: basic_auth_headers
+      assert_response :unprocessable_entity
+      assert_equal 0, @quiz.reload.timer_minutes
+      assert_equal 0, @quiz.timer_seconds
+    end
+
+    # Valid update
+    patch moderate_quiz_path(@quiz),
+      params: { quiz: { title: @quiz.title, number_of_winners: 3, timer_minutes: 1, timer_seconds: 30 } },
+      headers: basic_auth_headers
+    assert_redirected_to moderate_quiz_path(@quiz)
+    assert_equal 1, @quiz.reload.timer_minutes
+    assert_equal 30, @quiz.timer_seconds
+
+    # Export omits timer
+    get moderate_quiz_export_path(@quiz), headers: basic_auth_headers
+    assert_response :success
+    doc = Nokogiri::HTML(response.body)
+    exported = JSON.parse(doc.at_css("pre").text)
+    assert_equal [ "title", "questions" ], exported.keys
+
+    # Import defaults timer to 0:00
+    post moderate_quiz_import_path,
+      params: { quiz_import: { json: exported.to_json } },
+      headers: basic_auth_headers
+    assert_response :redirect
+    imported = Quiz.order(:id).last
+    assert_not_equal @quiz.id, imported.id
+    assert_equal 0, imported.timer_minutes
+    assert_equal 0, imported.timer_seconds
+  end
+
+  test "moderator receives remaining time across reloads, players never see timer, and deadline auto-finishes" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 10)
+    game = Game.create_for_quiz!(@quiz)
+    gq1 = game.game_questions.first
+    opt_correct = gq1.game_options.find_by!(correct: true)
+
+    # Player joins
+    post play_join_path(game.code), params: { player: { name: "Alice" } }
+    assert_redirected_to play_path(game.code)
+
+    travel_to Time.zone.parse("2026-11-20 14:00:00") do
+      # Lobby has no timer
+      get state_moderate_game_path(game), headers: basic_auth_headers, as: :json
+      assert_nil JSON.parse(response.body)["timer"]
+
+      # Start opens Q1 with 10s timer
+      post start_moderate_game_path(game), headers: basic_auth_headers, as: :json
+      assert_response :success
+      start_json = JSON.parse(response.body)
+      assert_equal 10, start_json.dig("timer", "duration_seconds")
+      assert_equal 10_000, start_json.dig("timer", "remaining_ms")
+
+      # Player state and HTML never contain timer
+      get play_state_path(game.code), as: :json
+      player_json = JSON.parse(response.body)
+      assert_not player_json.key?("timer")
+      assert_not player_json["question"].key?("closes_at")
+
+      get play_path(game.code)
+      assert_response :success
+      assert_not_includes response.body, "0:10"
+      assert_not_includes response.body, "stage-timer"
+
+      # After 4 seconds, reloading moderator page shows 0:06 (does not restart to 0:10)
+      travel 4.seconds
+      get moderate_game_path(game), headers: basic_auth_headers
+      assert_response :success
+      assert_includes response.body, "0:06"
+
+      get state_moderate_game_path(game), headers: basic_auth_headers, as: :json
+      assert_equal 6000, JSON.parse(response.body).dig("timer", "remaining_ms")
+
+      # After 6 more seconds (total 10s), deadline has elapsed:
+      # late answer is rejected with 409 and transitions game to reveal!
+      travel 6.seconds
+      post play_answer_path(game.code),
+        params: { game_question_id: gq1.id, game_option_id: opt_correct.id },
+        as: :json
+      assert_response :conflict
+      conflict_json = JSON.parse(response.body)
+      assert_equal false, conflict_json["ok"]
+      assert_equal "reveal", conflict_json.dig("state", "status")
+      assert_equal "no_answer", conflict_json.dig("state", "result")
+
+      # Moderator state is now reveal with no timer
+      get state_moderate_game_path(game), headers: basic_auth_headers, as: :json
+      reveal_json = JSON.parse(response.body)
+      assert_equal "reveal", reveal_json["status"]
+      assert_nil reveal_json["timer"]
+    end
+  end
+end
