+      placeholder="Option <%= number %>"
+      aria-label="Option <%= number %>"
+      data-role="title-input"
+    >
+  </div>
+  <label class="checkbox checkbox--correct" for="question_option_rows_<%= index %>_correct" data-role="correct-label">
