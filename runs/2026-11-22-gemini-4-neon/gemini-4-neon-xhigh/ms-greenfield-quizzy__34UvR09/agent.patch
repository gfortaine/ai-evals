@@ -0,0 +1,264 @@
+require "application_system_test_case"
+
+class QuizExportImportTest < ApplicationSystemTestCase
+  test "export quiz as JSON in a single pre element and import as a new quiz even with duplicate title" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q1 = quiz.questions.build(body: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    q1.save_with_options([
+      { title: "418", correct: false },
+      { title: "429", correct: true }
+    ])
+    q2 = quiz.questions.build(body: "Inactive </pre><script>alert(1)</script>\nLine 2 question?", active: false)
+    q2.save_with_options([
+      { title: "Alpha & Beta", correct: true },
+      { title: "Gamma", correct: true },
+      { title: "Delta", correct: false }
+    ])
+    q3 = quiz.questions.build(body: "Third question", active: true)
+    q3.save_with_options([
+      { title: "No", correct: false },
+      { title: "Yes", correct: true }
+    ])
+
+    # Move q3 up above q2 to ensure exported order reflects current position order
+    assert q3.move!("up")
+
+    visit moderate_quiz_path(quiz)
+    assert_link "Export"
+    click_link "Export"
+
+    # Exactly one <pre> on the export page containing exact JSON
+    assert_selector "pre", count: 1
+    exported_json = page.evaluate_script("document.querySelector('pre').textContent")
+    inner_text_json = page.evaluate_script("document.querySelector('pre').innerText")
+    assert_equal JSON.parse(exported_json), JSON.parse(inner_text_json)
+
+    parsed = JSON.parse(exported_json)
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 3, parsed["questions"].size
+
+    assert_equal [
+      'Which HTTP status code means "Too Many Requests"?',
+      "Third question",
+      "Inactive </pre><script>alert(1)</script>\nLine 2 question?"
+    ], parsed["questions"].map { |q| q["text"] }
+    assert_equal [ true, true, false ], parsed["questions"].map { |q| q["active"] }
+
+    parsed["questions"].each do |q|
+      assert_equal [ "text", "active", "options" ], q.keys
+      q["options"].each do |opt|
+        assert_equal [ "text", "correct" ], opt.keys
+      end
+    end
+
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], parsed["questions"][0]["options"]
+    assert_equal [
+      { "text" => "Alpha & Beta", "correct" => true },
+      { "text" => "Gamma", "correct" => true },
+      { "text" => "Delta", "correct" => false }
+    ], parsed["questions"][2]["options"]
+
+    # Import the exported JSON via /moderate -> Import quiz
+    visit "/moderate"
+    click_on "Import quiz"
+
+    assert_field "Quiz JSON"
+    fill_in "Quiz JSON", with: exported_json
+    click_button "Import"
+
+    # Opens the newly created quiz's page (distinct from the original)
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_not_equal moderate_quiz_path(quiz), current_path
+    assert_equal 2, Quiz.count
+
+    # Verify questions, order, active checkboxes, and correct options
+    items = all("ol.question-list > li")
+    assert_equal 3, items.size
+
+    within(items[0]) do
+      assert_text 'Which HTTP status code means "Too Many Requests"?'
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", text: "429"
+    end
+
+    within(items[1]) do
+      assert_text "Third question"
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", text: "Yes"
+    end
+
+    within(items[2]) do
+      assert_text "Inactive </pre><script>alert(1)</script>"
+      assert_text "Line 2 question?"
+      assert_unchecked_field "Active"
+      assert_selector "li.is-correct", text: "Alpha & Beta"
+      assert_selector "li.is-correct", text: "Gamma"
+    end
+
+    # Exporting the imported quiz yields byte-for-byte identical JSON
+    click_link "Export"
+    assert_selector "pre", count: 1
+    assert_equal exported_json, page.evaluate_script("document.querySelector('pre').textContent")
+
+    # Both quizzes appear in their own list items on /moderate
+    visit "/moderate"
+    assert_selector "ul.quiz-list > li", text: "Frontend Fest 2026", count: 2
+  end
+
+  test "import defaults optional active and correct fields and works with preview and export" do
+    minimal_json = <<~JSON
+      {
+        "title": "Minimal Conference Quiz",
+        "questions": [
+          {
+            "text": "What runs in the browser?",
+            "options": [
+              {"text": "JavaScript", "correct": true},
+              {"text": "PostgreSQL"}
+            ]
+          },
+          {
+            "text": "Draft question",
+            "active": false,
+            "options": [
+              {"text": "Nope"},
+              {"text": "Yep", "correct": true}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    visit "/moderate"
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: minimal_json
+    click_button "Import"
+
+    assert_selector "h1", text: "Minimal Conference Quiz"
+    assert_text "1 of 2 questions active"
+
+    items = all("ol.question-list > li")
+    assert_equal 2, items.size
+    within(items[0]) do
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", text: "JavaScript"
+    end
+    within(items[1]) do
+      assert_unchecked_field "Active"
+      assert_selector "li.is-correct", text: "Yep"
+    end
+
+    # Preview only plays active question
+    click_link "Preview"
+    assert_text "Question 1 of 1"
+    assert_text "What runs in the browser?"
+    click_button "JavaScript"
+    assert_text "Correct!"
+    click_button "See score"
+    assert_text "Score: 1/1"
+
+    # Export writes both active and correct explicitly
+    visit moderate_quiz_path(Quiz.last)
+    click_link "Export"
+    assert_selector "pre", count: 1
+    exported = JSON.parse(page.evaluate_script("document.querySelector('pre').textContent"))
+    assert_equal true, exported["questions"][0]["active"]
+    assert_equal false, exported["questions"][0]["options"][1]["correct"]
+    assert_equal false, exported["questions"][1]["active"]
+    assert_equal false, exported["questions"][1]["options"][0]["correct"]
+  end
+
+  test "invalid JSON or rule violation shows error, preserves input, and imports nothing" do
+    visit "/moderate"
+    click_on "Import quiz"
+
+    # 1. Invalid JSON syntax
+    fill_in "Quiz JSON", with: "{broken json"
+    click_button "Import"
+
+    assert_selector ".errors[role='alert']"
+    assert_field "Quiz JSON", with: "{broken json"
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 2. Valid first question + invalid second question (no correct option) -> nothing imported
+    partially_invalid = <<~JSON
+      {
+        "title": "Should Not Be Saved",
+        "questions": [
+          {
+            "text": "Good question",
+            "options": [
+              {"text": "A", "correct": true},
+              {"text": "B"}
+            ]
+          },
+          {
+            "text": "Missing correct answer",
+            "options": [
+              {"text": "C"},
+              {"text": "D"}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: partially_invalid
+    click_button "Import"
+
+    assert_selector ".errors[role='alert']", text: /correct/i
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 3. Valid first question + second question with only 1 option -> nothing imported
+    one_option_invalid = <<~JSON
+      {
+        "title": "Still Should Not Be Saved",
+        "questions": [
+          {
+            "text": "Good question",
+            "options": [
+              {"text": "A", "correct": true},
+              {"text": "B"}
+            ]
+          },
+          {
+            "text": "Only one option",
+            "options": [
+              {"text": "Lonely", "correct": true}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: one_option_invalid
+    click_button "Import"
+
+    assert_selector ".errors[role='alert']", text: /two options/i
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 4. Fixing the JSON and resubmitting succeeds
+    fixed = <<~JSON
+      {
+        "title": "Recovered Quiz",
+        "questions": []
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: fixed
+    click_button "Import"
+
+    assert_selector "h1", text: "Recovered Quiz"
+    assert_equal 1, Quiz.count
+  end
+end
diff --git a/test/system/timer_system_test.rb b/test/system/timer_system_test.rb
new file mode 100644
