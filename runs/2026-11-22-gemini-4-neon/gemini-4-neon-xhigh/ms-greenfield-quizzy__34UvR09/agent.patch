@@ -0,0 +1,24 @@
+class Answer < ApplicationRecord
+  belongs_to :game
+  belongs_to :player
+  belongs_to :game_question
+  belongs_to :game_option
+
+  validates :game_question_id, uniqueness: { scope: :player_id }
+
+  before_create :ensure_response_time_us
+
+  private
+
+  def ensure_response_time_us
+    return unless response_time_us.nil?
+
+    opened_at = game_question&.opened_at
+    if opened_at
+      now = Time.current
+      self.response_time_us = [ ((now.to_r - opened_at.to_r) * 1_000_000).round, 0 ].max
+    else
+      self.response_time_us = 0
+    end
+  end
+end
