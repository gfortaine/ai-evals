+<% content_for :title, "Quizzy · Preview · #{@quiz.title}" %>
+
+<% if @active_questions.any? %>
+  <div data-controller="preview" data-preview-questions-value="<%= @preview_data.to_json %>">
+    <div class="preview-banner">
+      <span>Preview</span>
+      <div class="preview-banner__actions">
+        <button type="button" class="btn btn--light btn--sm" data-preview-target="bannerRestart" data-action="preview#restart">Start over</button>
+        <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+      </div>
+    </div>
+
+    <div class="play">
+      <div class="play__top">
+        <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+
+      <div class="play__body play__body--top" data-preview-target="questionView">
+        <div class="play-question__num" data-preview-target="progress">Question 1 of <%= @active_questions.size %></div>
+        <div class="play-question__body" data-preview-target="questionBody"><%= @active_questions.first.body %></div>
+        <div class="play-options" data-preview-target="options">
+          <% @active_questions.first.options.each_with_index do |option, index| %>
+            <button type="button" class="play-option" data-action="preview#pick" data-option-index="<%= index %>">
+              <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.title %></span>
+              <span class="play-option__mark"></span>
+            </button>
+          <% end %>
+        </div>
+        <div class="play-status" data-preview-target="status" hidden></div>
+        <div class="play-actions" data-preview-target="actions" hidden>
+          <button type="button" class="btn btn--pink" data-preview-target="nextButton" data-action="preview#next">Next question</button>
+          <button type="button" class="btn btn--pink" data-preview-target="scoreButton" data-action="preview#showScore" hidden>See score</button>
+        </div>
+      </div>
+
+      <div class="play__body" data-preview-target="scoreView" hidden>
+        <div class="result-card">
+          <div class="result-card__place" data-preview-target="scoreBig"></div>
+          <div class="result-card__score" data-preview-target="scoreText"></div>
+          <div class="result-card__actions">
+            <button type="button" class="btn btn--pink" data-action="preview#restart">Start over</button>
+            <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+          </div>
+        </div>
+      </div>
+    </div>
+  </div>
+<% else %>
+  <div class="preview-banner">
+    <span>Preview</span>
+    <div class="preview-banner__actions">
+      <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+    </div>
+  </div>
+
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span><%= @quiz.title %></span>
+    </div>
+    <div class="play__body">
+      <div class="empty">
+        No active questions to preview.
+        <div class="buttons" style="justify-content: center; margin-top: 16px">
+          <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn" %>
+        </div>
+      </div>
+    </div>
+  </div>
+<% end %>
