diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
index 0000000..f8deef5
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,100 @@
+<% content_for :title, "Quizzy · #{@quiz.title}" %>
+<% active_count = @questions.count(&:active?) %>
+
+<div data-controller="question-active">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+  <div class="page-head">
+    <div>
+      <h1><%= @quiz.title %></h1>
+      <div class="meta mt-2">
+        <span data-question-active-target="summary"><%= active_count %> of <%= @questions.size %> <%= "question".pluralize(@questions.size) %> active</span>
+        · <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %>
+        · <%= link_to "Export", moderate_quiz_export_path(@quiz) %>
+      </div>
+    </div>
+    <div class="buttons">
+      <%= link_to "Preview", moderate_quiz_preview_path(@quiz), class: "btn btn--ghost" %>
+      <%= button_to "Start a game", moderate_quiz_games_path(@quiz), method: :post, class: "btn btn--pink" %>
+    </div>
+  </div>
+
+  <section class="section mt-0">
+    <div class="section-head">
+      <h2>Questions</h2>
+      <%= link_to "Add question", new_moderate_quiz_question_path(@quiz), class: "btn" %>
+    </div>
+
+    <% if @questions.any? %>
+      <ol class="question-list">
+        <% active_num = 0 %>
+        <% @questions.each_with_index do |question, index| %>
+          <% display_num = question.active? ? (active_num += 1) : "—" %>
+          <li
+            id="<%= dom_id(question) %>"
+            class="card question-item <%= "question-item--inactive" unless question.active? %>"
+            data-question-active-target="item"
+            data-question-id="<%= question.id %>"
+          >
+            <div class="question-item__num" data-role="num"><%= display_num %></div>
+            <div>
+              <div class="question-item__body"><%= question.body %></div>
+              <ul class="question-item__options">
+                <% question.options.each_with_index do |option, opt_index| %>
+                  <li class="<%= "is-correct" if option.correct? %>" <%= 'data-correct="true"'.html_safe if option.correct? %>><%= "#{option_letter(opt_index)}. #{option.title}" %></li>
+                <% end %>
+              </ul>
+            </div>
+            <div class="question-item__actions">
+              <div class="buttons">
+                <%= button_to move_moderate_quiz_question_path(@quiz, question, direction: "up"),
+                  method: :patch,
+                  class: "btn btn--ghost btn--icon",
+                  disabled: index == 0,
+                  aria: { label: "Move up" },
+                  title: "Move up" do %>
+                  <span aria-hidden="true">↑</span>
+                <% end %>
+                <%= button_to move_moderate_quiz_question_path(@quiz, question, direction: "down"),
+                  method: :patch,
+                  class: "btn btn--ghost btn--icon",
+                  disabled: index == @questions.size - 1,
+                  aria: { label: "Move down" },
+                  title: "Move down" do %>
+                  <span aria-hidden="true">↓</span>
+                <% end %>
+              </div>
+
+              <%= form_with model: [ :moderate, @quiz, question ],
+                url: active_moderate_quiz_question_path(@quiz, question),
+                method: :patch,
+                class: "inline-form" do |f| %>
+                <label class="checkbox">
+                  <%= f.check_box :active,
+                    id: dom_id(question, :active),
+                    data: {
+                      action: "change->question-active#toggle",
+                      question_id: question.id
+                    } %>
+                  Active
+                </label>
+              <% end %>
+
+              <div class="buttons">
+                <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+                <%= button_to "Delete",
+                  moderate_quiz_question_path(@quiz, question),
+                  method: :delete,
+                  class: "btn btn--sm btn--danger",
+                  form: { data: { turbo_confirm: "Delete this question?" } } %>
+              </div>
+            </div>
+          </li>
+        <% end %>
+      </ol>
+    <% else %>
+      <div class="empty">
+        No questions yet. Click "Add question" to write your first question.
+      </div>
+    <% end %>
+  </section>
+</div>
diff --git a/app/views/play/show.html.erb b/app/views/play/show.html.erb
new file mode 100644
index 0000000..4dabe99
--- /dev/null
+++ b/app/views/play/show.html.erb
@@ -0,0 +1,131 @@
+<% content_for :title, "Quizzy · #{@game.quiz.title}" %>
+
+<% if @player.nil? && @game.ended? %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span><%= @game.quiz.title %></span>
+    </div>
+    <div class="play__body">
+      <div class="waiting">
+        <h1 class="play-title">The quiz is over</h1>
+      </div>
+    </div>
+  </div>
+<% elsif @player.nil? %>
+  <div class="play" data-controller="join-status" data-join-status-code-value="<%= @game.code %>">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span><%= @game.quiz.title %></span>
+    </div>
+
+    <div class="play__body" data-join-status-target="joinView">
+      <h1 class="play-title"><%= @game.quiz.title %></h1>
+
+      <% if @player_form&.errors&.any? %>
+        <div class="errors" role="alert">
+          <% @player_form.errors.full_messages.each do |msg| %>
+            <div><%= msg %></div>
+          <% end %>
+        </div>
+      <% end %>
+
+      <%= form_with model: @player_form, url: play_join_path(@game.code), method: :post, class: "join-form" do |f| %>
+        <label class="field-label" for="player_name">Your name</label>
+        <%= f.text_field :name,
+          id: "player_name",
+          class: "input",
+          placeholder: "Your name",
+          required: true,
+          autofocus: true,
+          autocomplete: "nickname",
+          maxlength: 80 %>
+        <button type="submit" class="btn btn--pink">Join</button>
+      <% end %>
+    </div>
+
+    <div class="play__body" data-join-status-target="endedView" hidden>
+      <div class="waiting">
+        <h1 class="play-title">The quiz is over</h1>
+      </div>
+    </div>
+  </div>
+<% else %>
+  <% state = @initial_state %>
+  <% q = state[:question] %>
+  <% selected_id = state[:selected_option_id] %>
+
+  <div
+    class="play"
+    data-controller="player-game"
+    data-player-game-stream-token-value="<%= @player_stream_token %>"
+    data-player-game-answer-url-value="<%= play_answer_path(@game.code) %>"
+    data-player-game-state-url-value="<%= play_state_path(@game.code) %>"
+    data-player-game-quiz-title-value="<%= @game.quiz.title %>"
+    data-player-game-player-name-value="<%= @player.name %>"
+    data-player-game-initial-state-value="<%= state.to_json %>"
+  >
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span data-player-game-target="headerMeta"><%= state[:status] == "lobby" ? @game.quiz.title : "Hi, #{@player.name}!" %></span>
+    </div>
+
+    <div class="play__body" data-player-game-target="lobbyView" <%= "hidden" unless state[:status] == "lobby" %>>
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">Waiting for the quiz to start…</p>
+      </div>
+    </div>
+
+    <div class="play__body play__body--top" data-player-game-target="questionView" <%= "hidden" unless state[:status] == "question" || state[:status] == "reveal" %>>
+      <div class="play-question__num" data-player-game-target="progress">
+        <% if q %>Question <%= q[:position] %> of <%= q[:total] %><% end %>
+      </div>
+      <div class="play-question__body" data-player-game-target="questionBody"><%= q[:body] if q %></div>
+      <div class="play-options <%= "is-locked is-revealed" if state[:status] == "reveal" %>" data-player-game-target="options">
+        <% if q %>
+          <% q[:options].each_with_index do |opt, idx| %>
+            <% is_picked = selected_id == opt[:id] %>
+            <% is_correct = state[:status] == "reveal" && opt[:correct] %>
+            <button
+              type="button"
+              class="play-option <%= "is-picked" if is_picked %> <%= "is-correct" if is_correct %>"
+              data-action="player-game#pick"
+              data-option-id="<%= opt[:id] %>"
+              aria-pressed="<%= is_picked ? "true" : "false" %>"
+              <%= "disabled" if state[:status] == "reveal" %>
+            >
+              <span class="play-option__letter" aria-hidden="true"><%= option_letter(idx) %></span>
+              <span class="play-option__title"><%= opt[:title] %></span>
+              <span class="play-option__mark"><%= "Your answer" if is_picked %></span>
+            </button>
+          <% end %>
+        <% end %>
+      </div>
+      <%
+        status_text, status_class =
+          if state[:status] == "reveal"
+            case state[:result]
+            when "correct" then [ "Correct!", "play-status play-status--right" ]
+            when "wrong"   then [ "Wrong!", "play-status play-status--wrong" ]
+            else                [ "No answer", "play-status play-status--neutral" ]
+            end
+          else
+            [ "", "play-status" ]
+          end
+      %>
+      <div class="<%= status_class %>" data-player-game-target="status" <%= "hidden" unless state[:status] == "reveal" %>><%= status_text %></div>
+    </div>
+
+    <div class="play__body" data-player-game-target="endedView" <%= "hidden" unless state[:status] == "ended" %>>
+      <div class="result-card">
+        <div class="play-question__num">The quiz is over</div>
+        <div class="result-card__place" aria-hidden="true" data-player-game-target="resultPlaceNum"><%= "##{state[:place]}" if state[:status] == "ended" && state[:place] %></div>
+        <div class="result-card__label" data-player-game-target="resultPlace"><%= "Place #{state[:place]} of #{state[:total_players]}" if state[:status] == "ended" && state[:place] %></div>
+        <div class="result-card__score" data-player-game-target="resultPoints"><%= format_points(state[:points]) if state[:status] == "ended" && !state[:points].nil? %></div>
+        <div class="winner-banner" data-player-game-target="winnerBanner" <%= "hidden" unless state[:status] == "ended" && state[:winner] %>><%= "You won!" if state[:status] == "ended" && state[:winner] %></div>
+      </div>
+    </div>
+  </div>
+<% end %>
