diff --git a/config/routes.rb b/config/routes.rb
new file mode 100644
index 0000000..2825dc5
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,41 @@
+Rails.application.routes.draw do
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  root "home#index"
+
+  get  "play/:code",        to: "play#show",   as: :play
+  post "play/:code/join",   to: "play#join",   as: :play_join
+  post "play/:code/answer", to: "play#answer", as: :play_answer
+  get  "play/:code/state",  to: "play#state",  as: :play_state
+
+  namespace :moderate do
+    root "quizzes#index"
+
+    resource :quiz_import, only: [ :new, :create ], path: "import", path_names: { new: "" }
+
+    resources :quizzes do
+      resource :preview, only: :show
+      resource :export, only: :show
+      resources :games, only: [ :create ]
+      resources :questions, only: [ :new, :create, :edit, :update, :destroy ] do
+        member do
+          patch :move
+          patch :active
+        end
+      end
+    end
+
+    resources :games, only: [ :show ] do
+      member do
+        get  :state
+        post :start
+        post :finish
+        post :next, action: :next_question
+        post :end,  action: :end_game
+        post :top_winners
+        post :draw_winners
+        post :reset_winners
+      end
+    end
+  end
+end
