diff --git a/app/jobs/being_edited_broadcast_job.rb b/app/jobs/being_edited_broadcast_job.rb
new file mode 100644
index 0000000..28d6c97
--- /dev/null
+++ b/app/jobs/being_edited_broadcast_job.rb
@@ -0,0 +1,20 @@
+class BeingEditedBroadcastJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    return unless leaf.active?
+
+    editors = leaf.book.editors.to_a
+    return if editors.empty?
+
+    content = ApplicationController.render(
+      formats: [ :turbo_stream ],
+      partial: "leaves/being_edited_by",
+      locals: { leaf: leaf, user: user }
+    )
+
+    editors.each do |editor|
+      BeingEditedChannel.broadcast_stream_to leaf, editor, :being_edited, content: content
+    end
+  end
+end
