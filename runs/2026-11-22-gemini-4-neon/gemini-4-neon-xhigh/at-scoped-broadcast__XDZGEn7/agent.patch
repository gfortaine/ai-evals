diff --git a/app/channels/being_edited_channel.rb b/app/channels/being_edited_channel.rb
new file mode 100644
index 0000000..37e329c
--- /dev/null
+++ b/app/channels/being_edited_channel.rb
@@ -0,0 +1,32 @@
+class BeingEditedChannel < ApplicationCable::Channel
+  extend Turbo::Streams::Broadcasts, Turbo::Streams::StreamName
+  include Turbo::Streams::StreamName::ClassMethods
+
+  def subscribed
+    if (stream_name = verified_stream_name_from_params).present? && allowed_stream?(stream_name)
+      stream_from stream_name
+    else
+      reject
+    end
+  end
+
+  private
+    def allowed_stream?(stream_name)
+      return false unless current_user&.active?
+
+      leaf_gid, user_gid, suffix = stream_name.split(":", 3)
+      return false unless suffix == "being_edited"
+
+      leaf = locate_record(leaf_gid, Leaf)
+      user = locate_record(user_gid, User)
+
+      leaf&.active? && user == current_user && leaf.book.editors.exists?(current_user.id)
+    end
+
+    def locate_record(gid_param, model_class)
+      gid = GlobalID.parse(gid_param)
+      return unless gid&.app == GlobalID.app && gid.model_name == model_class.name
+
+      model_class.find_by(id: gid.model_id)
+    end
+end
