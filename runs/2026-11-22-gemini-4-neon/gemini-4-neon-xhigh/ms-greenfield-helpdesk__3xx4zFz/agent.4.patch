@@ -0,0 +1,584 @@
+require "test_helper"
+
+class TicketPriorityFilteringAndSearchTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme_signup = signup_and_verify!(
+      name: "Acme",
+      subdomain: "acme",
+      admin_name: "Jo",
+      email: "jo@acme.test",
+      password: "my-first-password"
+    )
+    @owner_id = @acme_signup.dig("user", "id")
+    @owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    post "/api/v1/invitations",
+         params: { invitation: { email: "sam@acme.test", role: "agent" } },
+         headers: json_headers(account: "acme", token: @owner_token),
+         as: :json
+    assert_response :created
+    _u, _a, sam_inv_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: sam_inv_token, name: "Sam", password: "sam-password-1" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :created
+    @agent_id = json_body.dig("user", "id")
+    @agent_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password-1").dig("session", "token")
+
+    @avery_data = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password-1")
+    @avery_id = @avery_data.dig("user", "id")
+    @avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "avery-password-1").dig("session", "token")
+
+    @blake_data = register_and_verify_customer!(subdomain: "acme", name: "Blake", email: "blake@example.test", password: "blake-password-1")
+    @blake_id = @blake_data.dig("user", "id")
+    @blake_token = sign_in!(subdomain: "acme", email: "blake@example.test", password: "blake-password-1").dig("session", "token")
+
+    @globex_signup = signup_and_verify!(
+      name: "Globex",
+      subdomain: "globex",
+      admin_name: "Pat",
+      email: "pat@globex.test",
+      password: "globex-password-1"
+    )
+    @globex_owner_id = @globex_signup.dig("user", "id")
+    @globex_owner_token = sign_in!(subdomain: "globex", email: "pat@globex.test", password: "globex-password-1").dig("session", "token")
+
+    @casey_data = register_and_verify_customer!(subdomain: "globex", name: "Casey", email: "casey@example.test", password: "casey-password-1")
+    @casey_id = @casey_data.dig("user", "id")
+    @casey_token = sign_in!(subdomain: "globex", email: "casey@example.test", password: "casey-password-1").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def create_request(subdomain:, token:, subject:, body:, extra: {})
+    post "/api/v1/requests",
+         params: { request: { subject: subject, comment: { body: body } }.merge(extra) },
+         headers: json_headers(account: subdomain, token: token),
+         as: :json
+    assert_response :created
+    json_body["request"]
+  end
+
+  test "tickets default to normal priority, staff can update priority atomically, and priority stays internal" do
+    req_a = nil
+    req_b = nil
+
+    # Customer tries to pass priority: high on create -> ignored, ticket defaults to normal, response omits priority
+    travel_to Time.zone.parse("2026-11-22 10:00:00 UTC") do
+      req_a = create_request(
+        subdomain: "acme",
+        token: @avery_token,
+        subject: "First request",
+        body: "Initial details",
+        extra: { priority: "high" }
+      )
+      assert_not req_a.key?("priority")
+    end
+
+    travel_to Time.zone.parse("2026-11-22 10:05:00 UTC") do
+      req_b = create_request(
+        subdomain: "acme",
+        token: @avery_token,
+        subject: "Second request",
+        body: "More details"
+      )
+      assert_not req_b.key?("priority")
+    end
+
+    # Staff sees default normal priority on index and show
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal %w[normal normal], json_body["tickets"].map { |t| t["priority"] }
+
+    get "/api/v1/tickets/#{req_a["id"]}", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal "normal", json_body.dig("ticket", "priority")
+
+    # Customer cannot set priority alone (422) or alongside a comment (ignored)
+    patch "/api/v1/requests/#{req_a["id"]}",
+          params: { request: { priority: "high" } },
+          headers: json_headers(account: "acme", token: @avery_token),
+          as: :json
+    assert_response :unprocessable_content
+    assert_equal "normal", Ticket.find(req_a["id"]).priority
+
+    travel_to Time.zone.parse("2026-11-22 10:06:00 UTC") do
+      patch "/api/v1/requests/#{req_a["id"]}",
+            params: { request: { priority: "high", comment: { body: "Customer follow-up" } } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :ok
+      assert_not json_body["request"].key?("priority")
+      assert_equal "normal", Ticket.find(req_a["id"]).priority
+      req_a = json_body["request"]
+    end
+
+    # Ensure req_b is at top of customer list before staff changes priority on req_a
+    travel_to Time.zone.parse("2026-11-22 10:08:00 UTC") do
+      patch "/api/v1/requests/#{req_b["id"]}",
+            params: { request: { comment: { body: "Bump B" } } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :ok
+      req_b = json_body["request"]
+    end
+
+    # Agent updates req_a priority to high at 10:15 -> staff sees high + updated_at=10:15 + A at top,
+    # customer sees NO priority key, NO updated_at bump, and B still at top!
+    travel_to Time.zone.parse("2026-11-22 10:15:00 UTC") do
+      patch "/api/v1/tickets/#{req_a["id"]}",
+            params: { ticket: { priority: "high" } },
+            headers: json_headers(account: "acme", token: @agent_token),
+            as: :json
+      assert_response :ok
+      assert_equal "high", json_body.dig("ticket", "priority")
+      assert_equal Time.zone.parse("2026-11-22 10:15:00 UTC").iso8601(3), json_body.dig("ticket", "updated_at")
+    end
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ req_a["id"], req_b["id"] ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal %w[high normal], json_body["tickets"].map { |t| t["priority"] }
+
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [ req_b["id"], req_a["id"] ], json_body["requests"].map { |r| r["id"] }
+    json_body["requests"].each { |r| assert_not r.key?("priority") }
+
+    get "/api/v1/requests/#{req_a["id"]}", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal req_a, json_body["request"]
+    assert_not json_body["request"].key?("priority")
+
+    # Admin combines priority, status, assignee_id, and private note in one PATCH
+    travel_to Time.zone.parse("2026-11-22 10:20:00 UTC") do
+      patch "/api/v1/tickets/#{req_a["id"]}",
+            params: {
+              ticket: {
+                priority: "normal",
+                status: "pending",
+                assignee_id: @agent_id,
+                comment: { body: "Downgrading internally", public: false }
+              }
+            },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+      assert_equal "normal", json_body.dig("ticket", "priority")
+      assert_equal "pending", json_body.dig("ticket", "status")
+      assert_equal @agent_id, json_body.dig("ticket", "assignee_id")
+    end
+
+    # Invalid priority values are rejected with 422 and roll back atomically
+    assert_no_difference "TicketComment.count" do
+      [ "urgent", "low", "HIGH", "", "   ", nil, 123, true, false, [ "high" ], { value: "high" } ].each do |bad_priority|
+        patch "/api/v1/tickets/#{req_a["id"]}",
+              params: {
+                ticket: {
+                  priority: bad_priority,
+                  status: "solved",
+                  comment: { body: "Should roll back" }
+                }
+              },
+              headers: json_headers(account: "acme", token: @owner_token),
+              as: :json
+        assert_response :unprocessable_content, "Expected 422 for priority=#{bad_priority.inspect}"
+        assert_equal "normal", Ticket.find(req_a["id"]).priority
+        assert_equal "pending", Ticket.find(req_a["id"]).status
+      end
+
+      # Valid priority paired with invalid status rolls back priority
+      patch "/api/v1/tickets/#{req_a["id"]}",
+            params: { ticket: { priority: "high", status: "bogus" } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "normal", Ticket.find(req_a["id"]).priority
+
+      # Valid priority paired with invalid assignee rolls back priority
+      patch "/api/v1/tickets/#{req_a["id"]}",
+            params: { ticket: { priority: "high", assignee_id: @avery_id } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "normal", Ticket.find(req_a["id"]).priority
+    end
+
+    # Customer cannot access staff ticket endpoints
+    patch "/api/v1/tickets/#{req_a["id"]}",
+          params: { ticket: { priority: "high" } },
+          headers: json_headers(account: "acme", token: @avery_token),
+          as: :json
+    assert_response :forbidden
+  end
+
+  test "staff can combine status, assignee_id, requester_id, priority, and q filters with pagination" do
+    t1 = t2 = t3 = t4 = t5 = globex_t = nil
+
+    travel_to Time.zone.parse("2026-11-22 10:00:00 UTC") do
+      t1 = create_request(subdomain: "acme", token: @avery_token, subject: "Cannot download my RECEIPT", body: "Button broken")
