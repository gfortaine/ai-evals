+++ b/test/mailboxes/support_mailbox_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class SupportMailboxTest < ActionMailbox::TestCase
+  setup do
+    @acme = Account.create!(name: "Acme", subdomain: "acme")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "processes inbound email via ActionMailbox::TestCase and marks delivered" do
+    inbound = receive_inbound_email_from_mail(
+      to: "acme@support.example.test",
+      from: "Casey <casey@example.test>",
+      subject: "Mailbox unit test",
+      body: "Hello from mailbox test",
+      message_id: "<mailbox-unit-1@example.test>"
+    )
+
+    assert inbound.delivered?
+    ticket = @acme.tickets.sole
+    assert_equal "Mailbox unit test", ticket.subject
+    assert_equal "email", ticket.origin
+    assert_equal "Hello from mailbox test", ticket.comments.sole.body
+  end
+
+  test "marks invalid inbound emails as bounced without blocking a retry" do
+    inbound = receive_inbound_email_from_mail(
+      to: "unknown@support.example.test",
+      from: "casey@example.test",
+      subject: "Unknown business",
+      body: "Ignored",
+      message_id: "<mailbox-unit-retry@example.test>"
+    )
+
+    assert inbound.bounced?
+    assert_equal 0, Ticket.count
+
+    valid_retry = receive_inbound_email_from_mail(
+      to: "acme@support.example.test",
+      from: "casey@example.test",
+      subject: "Valid retry",
+      body: "Now valid",
+      message_id: "<mailbox-unit-retry@example.test>"
+    )
+
+    assert valid_retry.delivered?
+    assert_equal 1, @acme.tickets.count
+  end
+end
