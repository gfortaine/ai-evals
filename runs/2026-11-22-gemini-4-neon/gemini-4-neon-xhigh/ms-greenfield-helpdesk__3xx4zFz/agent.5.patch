+
+  test "ignores mail from suspended customers and emails with pending staff invitations" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      # Suspended customer cannot open tickets or reply via email
+      reg = register_and_verify_customer!(subdomain: "acme", name: "Suspended User", email: "suspended@example.test", password: "suspended-password")
+      suspended_user = User.find(reg.dig("user", "id"))
