+      assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(raw_first)
+      end
+      assert_response :no_content
+
+      # Different raw bytes (added Received header / different body) but SAME Message-ID -> deduplicated
+      raw_relay_dup = build_raw_email(
+        from: "dedup@example.test",
+        subject: "Dedup subject",
+        body: "Modified relay retry",
+        message_id: dup_id,
+        extra_headers: { "Received" => "from relay2.example.test by mx.example.test" }
+      )
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(raw_relay_dup)
+      end
+      assert_response :no_content
+
+      # 2. Invalid delivery #1 (blank body) MUST NOT block later valid retry with SAME Message-ID
+      retry_blank_id = "<retry-blank-body@example.test>"
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(build_raw_email(
+          from: "retry1@example.test",
+          subject: "Retry blank",
+          body: "   \r\n  ",
+          message_id: retry_blank_id
+        ))
+      end
+      assert_response :no_content
+
+      assert_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ], 1 do
+        post_raw_email(build_raw_email(
+          from: "retry1@example.test",
+          subject: "Retry blank",
+          body: "Now with a real message!",
+          message_id: retry_blank_id
+        ))
+      end
+      assert_response :no_content
+
+      # 3. Invalid delivery #1 (non-requester reply) MUST NOT block valid retry by requester with SAME Message-ID
+      ticket = @acme.tickets.order(:id).last
+      retry_reply_id = "<retry-reply-auth@example.test>"
+      assert_no_difference "TicketComment.count" do
+        post_raw_email(build_raw_email(
+          from: "impostor@example.test",
+          to: ticket.reply_address,
+          subject: "Re: Retry blank",
+          body: "Wrong sender",
+          message_id: retry_reply_id
+        ))
+      end
+      assert_response :no_content
+
+      assert_difference "ticket.comments.count", 1 do
+        post_raw_email(build_raw_email(
+          from: "retry1@example.test",
+          to: ticket.reply_address,
+          subject: "Re: Retry blank",
+          body: "Real requester retry",
+          message_id: retry_reply_id
+        ))
+      end
+      assert_response :no_content
+
+      # Subsequent duplicate of that now-valid reply IS deduplicated
+      assert_no_difference "ticket.comments.count" do
+        post_raw_email(build_raw_email(
+          from: "retry1@example.test",
+          to: ticket.reply_address,
+          subject: "Re: Retry blank",
+          body: "Real requester retry duplicate",
+          message_id: retry_reply_id
+        ))
+      end
+      assert_response :no_content
+
+      # 4. Invalid delivery #1 (cancelled account, IDENTICAL raw bytes) MUST NOT block valid retry after reactivation
+      @beta.cancel!
+      same_bytes_id = "<retry-identical-bytes@example.test>"
+      identical_raw = build_raw_email(
+        from: "samebytes@example.test",
+        to: "beta@support.example.test",
+        subject: "During cancellation",
+        body: "Retry me with identical bytes after reactivation.",
+        message_id: same_bytes_id
+      )
+
+      assert_no_difference [ "Ticket.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(identical_raw)
+      end
+      assert_response :no_content
+
+      @beta.reactivate!
+
+      assert_difference [ "@beta.tickets.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ], 1 do
+        post_raw_email(identical_raw)
+      end
+      assert_response :no_content
+
+      # And a 3rd identical delivery is now deduplicated!
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(identical_raw)
+      end
+      assert_response :no_content
+    end
+  end
+
+  test "ignores automated and mailing-list mail while accepting human mail with Auto-Submitted: no" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      # Create a pending ticket to verify automated replies to reply address are also ignored
+      post_raw_email(build_raw_email(
+        from: "realcustomer@example.test",
+        subject: "Need help",
+        body: "Initial question"
+      ))
+      ticket = @acme.tickets.order(:id).last
+      ticket.update!(status: "pending")
+      ActionMailer::Base.deliveries.clear
+
+      ignored_cases = [
+        { extra_headers: { "Auto-Submitted" => "auto-replied" } },
+        { extra_headers: { "Auto-Submitted" => "auto-generated" } },
+        { extra_headers: { "Auto-Submitted" => "auto-notified; owner-email=ops@example.test" } },
+        { extra_headers: { "List-Id" => "<newsletter.example.test>" } },
+        { extra_headers: { "List-Unsubscribe" => "<mailto:unsub@example.test>" } },
+        { extra_headers: { "List-Post" => "<mailto:list@example.test>" } },
+        { extra_headers: { "Precedence" => "bulk" } },
+        { extra_headers: { "Precedence" => "list" } },
+        { extra_headers: { "Precedence" => "junk" } },
+        { extra_headers: { "Precedence" => "auto_reply" } },
+        { extra_headers: { "X-Autoreply" => "yes" } },
+        { extra_headers: { "X-Autorespond" => "yes" } },
+        { extra_headers: { "X-Auto-Response-Suppress" => "All" } },
+        { extra_headers: { "X-Failed-Recipients" => "bob@example.test" } },
+        { extra_headers: { "Return-Path" => "<>" } },
+        { from: "MAILER-DAEMON@example.test" },
+        { from: "postmaster@example.test" },
+        { from: "noreply@example.test" },
+        { from: "no-reply@example.test" },
+        { from: "bounces+123@example.test" },
+        { from: "acme@support.example.test" },
+        { from: "realcustomer@example.test", to: ticket.reply_address, extra_headers: { "Auto-Submitted" => "auto-replied" } }
+      ]
+
+      ignored_cases.each_with_index do |opts, idx|
+        assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ],
+                             "Expected automated/list case ##{idx} (#{opts.inspect}) to be ignored" do
+          post_raw_email(build_raw_email(
+            from: opts.fetch(:from, "bot#{idx}@example.test"),
+            to: opts.fetch(:to, "acme@support.example.test"),
+            subject: "Automated #{idx}",
+            body: "Automated body #{idx}",
+            extra_headers: opts.fetch(:extra_headers, {})
+          ))
+        end
+        assert_response :no_content
+      end
+
+      assert_equal "pending", ticket.reload.status
+
+      # DSN multipart/report bounce is ignored
+      dsn_raw = <<~EML
+        Message-ID: <dsn-bounce-1@example.test>
+        From: postoffice@example.test
+        To: acme@support.example.test
+        Subject: Delivery Status Notification (Failure)
+        MIME-Version: 1.0
+        Content-Type: multipart/report; report-type=delivery-status; boundary="dsn"
+
+        --dsn
+        Content-Type: text/plain; charset=UTF-8
+
+        Your message could not be delivered.
+        --dsn
+        Content-Type: message/delivery-status
+
+        Action: failed
+        --dsn--
+      EML
+
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count" ] do
+        post_raw_email(dsn_raw)
+      end
+      assert_response :no_content
+
+      # Human mail with Auto-Submitted: no and normal Return-Path IS accepted
+      assert_difference [ "@acme.tickets.count", "TicketComment.count" ], 1 do
+        post_raw_email(build_raw_email(
+          from: "human@example.test",
+          to: "acme@support.example.test",
+          subject: "Real human message",
+          body: "Explicitly not auto-submitted.",
+          extra_headers: {
+            "Auto-Submitted" => "no",
+            "Return-Path" => "<human@example.test>"
