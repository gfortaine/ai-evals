+  test "handles emails without Message-ID, missing/invalid From, customer portal replies on email-origin tickets, and account purge" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      # Missing From and invalid From do not block a later valid retry with the same Message-ID
+      retry_from_id = "<retry-bad-from@example.test>"
+      assert_no_difference [ "Ticket.count", "User.count" ] do
+        post_raw_email(build_raw_email(from: nil, message_id: retry_from_id))
+        post_raw_email(build_raw_email(from: "not-an-email", message_id: retry_from_id))
+      end
+      assert_response :no_content
+
+      assert_difference [ "Ticket.count", "User.count" ], 1 do
+        post_raw_email(build_raw_email(from: "validfrom@example.test", message_id: retry_from_id))
+      end
+      assert_response :no_content
+
+      # Email without Message-ID opens a ticket, exact duplicate is deduplicated, different email opens second ticket
+      no_id_raw_1 = build_raw_email(from: "validfrom@example.test", subject: "No ID 1", body: "First no-id", message_id: nil)
+      no_id_raw_2 = build_raw_email(from: "validfrom@example.test", subject: "No ID 2", body: "Second no-id", message_id: nil)
+
+      assert_difference "Ticket.count", 1 do
+        post_raw_email(no_id_raw_1)
