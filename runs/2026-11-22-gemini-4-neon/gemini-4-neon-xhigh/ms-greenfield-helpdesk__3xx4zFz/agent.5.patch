+
+      post_raw_email(build_raw_email(
+        from: "shared@example.test",
+        to: "beta@support.example.test",
+        subject: "Beta question",
+        body: "For Beta"
+      ))
+      assert_response :no_content
+
+      acme_user = @acme.users.find_by!(email: "shared@example.test")
