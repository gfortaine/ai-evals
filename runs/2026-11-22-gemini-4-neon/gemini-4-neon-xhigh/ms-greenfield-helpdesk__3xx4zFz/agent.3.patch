+class InvitationCreation
+  Result = Struct.new(:success?, :invitation, :errors, keyword_init: true)
+
+  def initialize(account:, invited_by:, email:, role:)
+    @account = account
+    @invited_by = invited_by
+    @email = email
+    @role = role
+  end
+
+  def call
+    now = Time.current
+    raw_token, token_digest = Invitation.generate_token
+    invitation = @account.invitations.build(
+      invited_by: @invited_by,
+      email: @email,
+      role: @role,
+      token_digest: token_digest,
+      expires_at: now + Invitation::TTL
+    )
+
+    errors = {}
+    ActiveRecord::Base.transaction do
+      @account.lock!
+      now = Time.current
+      invitation.expires_at = now + Invitation::TTL
+
+      unless invitation.valid?
+        invitation.errors.each do |error|
+          (errors[error.attribute.to_s] ||= []) << error.full_message
+        end
+      end
+
+      if invitation.email.present? && errors["email"].blank?
+        if @account.users.exists?(email: invitation.email)
+          (errors["email"] ||= []) << "Email already belongs to a user in this account"
+        elsif @account.invitations.pending(now).exists?(email: invitation.email)
+          (errors["email"] ||= []) << "A pending invitation already exists for this email"
+        end
+      end
+
+      if errors.any?
+        raise ActiveRecord::Rollback
+      end
+
+      invitation.save!
+    end
+
+    if errors.any?
+      return Result.new(success?: false, invitation: invitation, errors: errors)
+    end
+
+    UserMailer.invitation(invitation: invitation, token: raw_token).deliver_now
+
+    Result.new(success?: true, invitation: invitation.reload, errors: {})
+  rescue ActiveRecord::RecordInvalid => e
+    Result.new(success?: false, invitation: invitation, errors: e.record.errors.to_hash(true))
+  end
+end
