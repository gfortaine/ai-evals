+module Api
+  module V1
+    class InvitationsController < BaseController
+      before_action :require_authentication!
+      before_action :require_active_account!
+      before_action :require_admin!
+
+      def index
+        now = Time.current
+        scope = current_account.invitations.includes(:invited_by).by_id_asc
+
+        if params[:status].present?
+          status = params[:status].is_a?(String) ? params[:status].strip.downcase : nil
+          unless Invitation::STATUSES.include?(status)
+            return render_error(
+              "Invalid status filter",
+              status: :unprocessable_content,
+              errors: { status: [ "Status must be one of: #{Invitation::STATUSES.join(', ')}" ] }
+            )
+          end
+
+          scope = scope.with_status(status, now)
+        end
+
+        payload = paginate_collection(scope, key: :invitations) { |invitation| serialize_invitation(invitation, now: now) }
+        render json: payload, status: :ok
+      end
+
+      def show
+        invitation = find_invitation!
+        render json: { invitation: serialize_invitation(invitation) }, status: :ok
+      end
+
+      def create
+        invitation_params = require_hash_param(:invitation).permit(:email, :role)
+
+        result = InvitationCreation.new(
+          account: current_account,
+          invited_by: current_user,
+          email: invitation_params[:email],
+          role: invitation_params[:role]
+        ).call
+
+        if result.success?
+          render json: { invitation: serialize_invitation(result.invitation) }, status: :created
+        else
+          render_validation_errors(result.errors)
+        end
+      end
+
+      def resend
+        invitation = find_invitation!
+        result = InvitationResend.new(invitation: invitation).call
+
+        if result.success?
+          render json: { invitation: serialize_invitation(result.invitation) }, status: :ok
+        else
+          render_validation_errors(result.errors)
+        end
+      end
+
+      def destroy
+        invitation = find_invitation!
+        result = InvitationRevocation.new(invitation: invitation).call
+
+        if result.success?
+          render json: { invitation: serialize_invitation(result.invitation) }, status: :ok
+        else
+          render_validation_errors(result.errors)
+        end
+      end
+
+      private
+
+      def find_invitation!
+        current_account.invitations.includes(:invited_by).find(parse_id_param(:id))
+      end
+    end
+  end
+end
