+require "test_helper"
+
+class InvitationsAndTeamOnboardingTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme_signup = signup_and_verify!(
+      name: "Acme",
+      subdomain: "acme",
+      admin_name: "Jo",
+      email: "jo@acme.test",
+      password: "my-first-password"
+    )
+    @owner_id = @acme_signup.dig("user", "id")
+    @owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    signup_and_verify!(
+      name: "Globex",
+      subdomain: "globex",
+      admin_name: "Pat",
+      email: "pat@globex.test",
+      password: "globex-password-1"
+    )
+    @globex_owner_token = sign_in!(subdomain: "globex", email: "pat@globex.test", password: "globex-password-1").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "full invitation lifecycle: invite agent and admin, preview, accept without verification email, sign in" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://portal.example.test", "HELPDESK_MAIL_FROM" => "team@example.test") do
+      # 1. Admin invites Sam as an agent
+      post "/api/v1/invitations",
+           params: { invitation: { email: "  SAM@Example.TEST ", role: "agent" } },
+           headers: json_headers(account: "acme", token: @owner_token),
+           as: :json
+      assert_response :created
+
+      inv = json_body["invitation"]
+      assert_kind_of Integer, inv["id"]
+      assert_equal "sam@example.test", inv["email"]
+      assert_equal "agent", inv["role"]
+      assert_equal "pending", inv["status"]
+      assert_equal @owner_id, inv["invited_by_id"]
+      assert_equal({ "id" => @owner_id, "name" => "Jo" }, inv["invited_by"])
+      assert inv["expires_at"].present?
+      assert_nil inv["accepted_at"]
+      assert_nil inv["revoked_at"]
+      assert_not inv.key?("token")
+      assert_not inv.key?("token_digest")
+
+      # Email sent with /accept-invitation?account=acme&token=TOKEN
+      assert_equal 1, ActionMailer::Base.deliveries.size
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "team@example.test" ], mail.from
+      assert_equal [ "sam@example.test" ], mail.to
+      url, acct_param, sam_token = extract_token_from_mail(mail, path: "/accept-invitation")
+      assert url.start_with?("https://portal.example.test/accept-invitation?account=acme&token=")
+      assert_equal "acme", acct_param
+      assert sam_token.present?
+
+      # 2. Preview invitation (unauthenticated, non-destructive)
+      2.times do
+        post "/api/v1/invitation_previews",
+             params: { invitation_preview: { token: sam_token } },
+             headers: json_headers(account: "acme"),
+             as: :json
+        assert_response :ok
+        preview = json_body["invitation_preview"]
+        assert_equal "sam@example.test", preview["email"]
+        assert_equal "agent", preview["role"]
+        assert_equal "Acme", preview["account_name"]
+        assert_equal "acme", preview["subdomain"]
+        assert_equal inv["expires_at"], preview["expires_at"]
+        assert_equal({ "name" => "Acme", "subdomain" => "acme" }, preview["account"])
+      end
+
+      # 3. Validation failures on acceptance do NOT consume the token
+      assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post "/api/v1/invitation_acceptances",
+             params: { invitation_acceptance: { token: sam_token, name: "  ", password: "short" } },
+             headers: json_headers(account: "acme"),
+             as: :json
+        assert_response :unprocessable_content
+
+        post "/api/v1/invitation_acceptances",
+             params: { invitation_acceptance: { token: sam_token, name: "Sam", password: "a" * 73 } },
+             headers: json_headers(account: "acme"),
+             as: :json
+        assert_response :unprocessable_content
+
+        post "/api/v1/invitation_acceptances",
+             params: { invitation_acceptance: { token: sam_token, name: "Sam", password: "        " } },
+             headers: json_headers(account: "acme"),
+             as: :json
+        assert_response :unprocessable_content
+      end
+
+      # Token is still valid after failed attempts
+      post "/api/v1/invitation_previews",
+           params: { invitation_preview: { token: sam_token } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+
+      # 4. Accept invitation (mass-assigned role/email/owner ignored; NO verification email sent)
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        post "/api/v1/invitation_acceptances",
+             params: {
+               invitation_acceptance: {
+                 token: sam_token,
+                 name: "Sam",
+                 password: "my-team-password",
+                 role: "admin",
+                 email: "evil@example.test",
+                 owner: true
+               }
+             },
+             headers: json_headers(account: "acme"),
+             as: :json
+      end
+      assert_response :created
+      assert_equal "Sam", json_body.dig("user", "name")
+      assert_equal "sam@example.test", json_body.dig("user", "email")
+      assert_equal "agent", json_body.dig("user", "role")
+      assert_equal false, json_body.dig("user", "owner")
+      assert_equal true, json_body.dig("user", "verified")
+      assert json_body.dig("user", "verified_at").present?
+      assert_equal false, json_body.dig("user", "suspended")
+      assert_equal "Acme", json_body.dig("account", "name")
+      assert_equal "acme", json_body.dig("account", "subdomain")
+
+      # 5. Sam signs in immediately without another verification email
+      sam_login = sign_in!(subdomain: "acme", email: "sam@example.test", password: "my-team-password")
+      assert sam_login.dig("session", "token").present?
+      assert_equal "agent", sam_login.dig("user", "role")
+
+      # 6. Accepted invitation cannot be previewed, accepted again, resent, or revoked
+      post "/api/v1/invitation_previews",
+           params: { invitation_preview: { token: sam_token } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/invitation_acceptances",
+           params: { invitation_acceptance: { token: sam_token, name: "Sam 2", password: "my-team-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/invitations/#{inv['id']}/resend", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :unprocessable_content
+
+      delete "/api/v1/invitations/#{inv['id']}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :unprocessable_content
+
+      # Inspect shows accepted with accepted_at; stays accepted even after expiry passes
+      get "/api/v1/invitations/#{inv['id']}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal "accepted", json_body.dig("invitation", "status")
+      assert json_body.dig("invitation", "accepted_at").present?
+
+      travel 30.days do
+        get "/api/v1/invitations/#{inv['id']}", headers: json_headers(account: "acme", token: @owner_token)
+        assert_response :ok
+        assert_equal "accepted", json_body.dig("invitation", "status")
+      end
+
+      # 7. Invite an admin too; new admin can manage invitations but not cancel account
+      post "/api/v1/invitations",
+           params: { invitation: { email: "alex@example.test", role: "admin" } },
+           headers: json_headers(account: "acme", token: @owner_token),
+           as: :json
+      assert_response :created
+      _u, _a, alex_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+
+      post "/api/v1/invitation_acceptances",
+           params: { invitation_acceptance: { token: alex_token, name: "Alex", password: "alex-admin-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :created
+      assert_equal "admin", json_body.dig("user", "role")
+      assert_equal false, json_body.dig("user", "owner")
+
+      alex_session_token = sign_in!(subdomain: "acme", email: "alex@example.test", password: "alex-admin-password").dig("session", "token")
+
+      # Alex (non-owner admin) can invite another agent
+      post "/api/v1/invitations",
+           params: { invitation: { email: "taylor@example.test", role: "agent" } },
+           headers: json_headers(account: "acme", token: alex_session_token),
+           as: :json
+      assert_response :created
+
+      # Alex (non-owner admin) still cannot cancel account
+      post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: alex_session_token)
+      assert_response :forbidden
+    end
+  end
+
+  test "resend rotates token and extends expiry; revoke invalidates token and allows re-inviting" do
+    inv_id = nil
+    first_token = nil
+    first_expires_at = nil
+
+    travel_to Time.zone.parse("2026-11-22 10:00:00 UTC") do
+      post "/api/v1/invitations",
+           params: { invitation: { email: "sam@example.test", role: "agent" } },
+           headers: json_headers(account: "acme", token: @owner_token),
+           as: :json
+      assert_response :created
+      inv_id = json_body.dig("invitation", "id")
+      first_expires_at = Time.iso8601(json_body.dig("invitation", "expires_at"))
+      _u, _a, first_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+    end
+
+    second_token = nil
+    travel_to Time.zone.parse("2026-11-24 10:00:00 UTC") do
+      assert_no_difference "Invitation.count" do
+        post "/api/v1/invitations/#{inv_id}/resend", headers: json_headers(account: "acme", token: @owner_token)
+      end
+      assert_response :ok
+      assert_equal inv_id, json_body.dig("invitation", "id")
+      assert_equal "pending", json_body.dig("invitation", "status")
+      second_expires_at = Time.iso8601(json_body.dig("invitation", "expires_at"))
+      assert second_expires_at > first_expires_at
+
+      _u, _a, second_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+      assert_not_equal first_token, second_token
+
+      # First token immediately stops working on preview and acceptance
+      post "/api/v1/invitation_previews",
+           params: { invitation_preview: { token: first_token } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/invitation_acceptances",
+           params: { invitation_acceptance: { token: first_token, name: "Sam", password: "my-team-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      # Second token works on preview
+      post "/api/v1/invitation_previews",
+           params: { invitation_preview: { token: second_token } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+
+      # Revoke invitation
+      delete "/api/v1/invitations/#{inv_id}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal "revoked", json_body.dig("invitation", "status")
+      assert json_body.dig("invitation", "revoked_at").present?
+
+      # Revoked token stops working immediately
+      post "/api/v1/invitation_previews",
+           params: { invitation_preview: { token: second_token } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/invitation_acceptances",
+           params: { invitation_acceptance: { token: second_token, name: "Sam", password: "my-team-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      # Cannot revoke or resend an already-revoked invitation
+      delete "/api/v1/invitations/#{inv_id}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :unprocessable_content
+
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        post "/api/v1/invitations/#{inv_id}/resend", headers: json_headers(account: "acme", token: @owner_token)
+        assert_response :unprocessable_content
+      end
+
+      # Can re-invite the same email now that the prior invitation is revoked
+      post "/api/v1/invitations",
+           params: { invitation: { email: "sam@example.test", role: "agent" } },
+           headers: json_headers(account: "acme", token: @owner_token),
+           as: :json
+      assert_response :created
+      assert_not_equal inv_id, json_body.dig("invitation", "id")
+    end
+
+    # Revoked invitation remains revoked even after expiry passes
+    travel_to Time.zone.parse("2026-12-30 10:00:00 UTC") do
+      get "/api/v1/invitations/#{inv_id}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal "revoked", json_body.dig("invitation", "status")
+    end
+  end
+
+  test "tracks pending, accepted, revoked, and expired invitations with ID-asc listing and status filter" do
