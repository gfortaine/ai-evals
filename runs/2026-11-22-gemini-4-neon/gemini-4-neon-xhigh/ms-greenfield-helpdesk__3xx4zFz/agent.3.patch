+    assert_equal 1, json_body["count"]
+
+    # 5. Staff posts a private note on a pending/solved ticket -> status does NOT reopen, request unchanged!
+    req_a_after_pending = nil
+    get "/api/v1/requests/#{req_a_id}", headers: json_headers(account: "acme", token: @customer_token)
+    req_a_after_pending = json_body["request"]
+
+    travel_to Time.zone.parse("2026-11-22 10:12:00 UTC") do
+      patch "/api/v1/tickets/#{req_a_id}",
+            params: { ticket: { comment: { body: "Follow-up private note", public: false } } },
+            headers: json_headers(account: "acme", token: @agent_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests/#{req_a_id}", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal req_a_after_pending, json_body["request"]
+
+    # 6. Staff posts a PUBLIC reply on Request B at 10:15 -> customer sees reply and B jumps to top
+    travel_to Time.zone.parse("2026-11-22 10:15:00 UTC") do
+      patch "/api/v1/tickets/#{req_b_id}",
+            params: { ticket: { comment: { body: "We are looking into Request B!", public: true } } },
+            headers: json_headers(account: "acme", token: @agent_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal [ req_b_id, req_a_id ], json_body["requests"].map { |r| r["id"] }
+    assert_equal Time.zone.parse("2026-11-22 10:15:00 UTC").iso8601(3), json_body["requests"].first["updated_at"]
+
+    get "/api/v1/requests/#{req_b_id}/comments", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal 2, json_body["count"]
+    assert_equal "We are looking into Request B!", json_body["comments"].last["body"]
+  end
+end
