diff --git a/test/integration/account_cancellation_and_purge_test.rb b/test/integration/account_cancellation_and_purge_test.rb
new file mode 100644
index 0000000..ce3b3e2
--- /dev/null
+++ b/test/integration/account_cancellation_and_purge_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+require "rake"
+
+class AccountCancellationAndPurgeTest < ActionDispatch::IntegrationTest
+  test "owner can cancel and reactivate within 90 days; cancellation revokes sessions and stops ordinary access" do
+    signup_and_verify!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    account = Account.find_by!(subdomain: "acme")
+
+    # Add a non-owner admin user to verify owner-only restrictions
+    other_admin = account.users.create!(
+      name: "Sam",
+      email: "sam@acme.test",
+      password: "sam-password-1",
+      role: "admin",
+      verified_at: Time.current
+    )
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    other_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password-1").dig("session", "token")
+
+    # Non-owner cannot cancel
+    post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: other_token)
+    assert_response :forbidden
+
+    # Reactivating an active account returns 422
+    post "/api/v1/account/reactivate", headers: json_headers(account: "acme", token: owner_token)
+    assert_response :unprocessable_content
+
+    # Owner cancels account
+    post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: owner_token)
+    assert_response :ok
+    assert_equal "cancelled", json_body.dig("account", "status")
+    assert json_body.dig("account", "cancelled_at").present?
+    assert json_body.dig("account", "purge_at").present?
+
+    # All existing sessions are revoked (401)
+    get "/api/v1/me", headers: json_headers(account: "acme", token: owner_token)
+    assert_response :unauthorized
+    get "/api/v1/account", headers: json_headers(account: "acme", token: other_token)
+    assert_response :unauthorized
+
+    # Ordinary public & unauthenticated access is stopped (403)
+    get "/api/v1/portal", headers: json_headers(account: "acme")
+    assert_response :forbidden
+
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    # Non-owner cannot sign in while cancelled
+    post "/api/v1/sessions",
+         params: { session: { email: "sam@acme.test", password: "sam-password-1" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    # 89 days later (still within 90 days): owner can sign in to reactivate, but ordinary endpoints remain blocked
+    travel 89.days do
+      owner_login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+      assert_equal "cancelled", owner_login.dig("account", "status")
+      reactivate_token = owner_login.dig("session", "token")
+
+      # Ordinary business endpoints are still blocked while cancelled
+      get "/api/v1/account", headers: json_headers(account: "acme", token: reactivate_token)
+      assert_response :forbidden
+      get "/api/v1/me", headers: json_headers(account: "acme", token: reactivate_token)
+      assert_response :forbidden
+      patch "/api/v1/me",
+            params: { user: { name: "Blocked Name" } },
+            headers: json_headers(account: "acme", token: reactivate_token),
+            as: :json
+      assert_response :forbidden
+      put "/api/v1/me/password",
+          params: { password_change: { current_password: "my-first-password", password: "new-password-1" } },
+          headers: json_headers(account: "acme", token: reactivate_token),
+          as: :json
+      assert_response :forbidden
+
+      # Owner can sign out while cancelled, then sign back in
+      delete "/api/v1/session", headers: json_headers(account: "acme", token: reactivate_token)
+      assert_response :no_content
+
+      reactivate_token2 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+      # Reactivate account
+      post "/api/v1/account/reactivate", headers: json_headers(account: "acme", token: reactivate_token2)
+      assert_response :ok
+      assert_equal "active", json_body.dig("account", "status")
+      assert_nil json_body.dig("account", "cancelled_at")
+
+      # Ordinary access works again!
+      get "/api/v1/portal", headers: json_headers(account: "acme")
+      assert_response :ok
+      get "/api/v1/account", headers: json_headers(account: "acme", token: reactivate_token2)
+      assert_response :ok
+      get "/api/v1/me", headers: json_headers(account: "acme", token: reactivate_token2)
+      assert_response :ok
+      sign_in!(subdomain: "acme", email: other_admin.email, password: "sam-password-1")
+    end
+  end
+
+  test "cannot sign in or reactivate after 90 days and purge rake task deletes only expired cancelled accounts" do
+    # 1. Active account (must NOT be purged)
+    signup_and_verify!(name: "Active Co", subdomain: "activeco", email: "a@active.test", password: "my-first-password")
+
+    # 2. Recently cancelled account (89 days ago, must NOT be purged)
+    signup_and_verify!(name: "Recent Co", subdomain: "recentco", email: "r@recent.test", password: "my-first-password")
+    recent_token = sign_in!(subdomain: "recentco", email: "r@recent.test", password: "my-first-password").dig("session", "token")
+    post "/api/v1/account/cancel", headers: json_headers(account: "recentco", token: recent_token)
+    assert_response :ok
+
+    # 3. Old cancelled account (91 days ago, MUST be purged with all its data)
+    signup_and_verify!(name: "Expired Co", subdomain: "expiredco", email: "e@expired.test", password: "my-first-password")
+    expired_token = sign_in!(subdomain: "expiredco", email: "e@expired.test", password: "my-first-password").dig("session", "token")
+    post "/api/v1/account/cancel", headers: json_headers(account: "expiredco", token: expired_token)
+    assert_response :ok
+
+    # Also create a token & session while within window so we verify reactivation after 90d is blocked too
+    expired_reactivate_token = sign_in!(subdomain: "expiredco", email: "e@expired.test", password: "my-first-password").dig("session", "token")
+
+    expired_account = Account.find_by!(subdomain: "expiredco")
+    recent_account = Account.find_by!(subdomain: "recentco")
+    active_account = Account.find_by!(subdomain: "activeco")
+
+    expired_account.update_column(:cancelled_at, 91.days.ago)
+    recent_account.update_column(:cancelled_at, 89.days.ago)
+
+    # After 90 days: owner cannot sign in or reactivate
+    post "/api/v1/sessions",
+         params: { session: { email: "e@expired.test", password: "my-first-password" } },
+         headers: json_headers(account: "expiredco"),
+         as: :json
+    assert_response :forbidden
+
+    post "/api/v1/account/reactivate", headers: json_headers(account: "expiredco", token: expired_reactivate_token)
+    assert_response :forbidden
+
+    # Ensure expired account currently has users, sessions, and tokens
+    assert expired_account.users.exists?
+    assert expired_account.sessions.exists?
+    assert expired_account.user_tokens.exists?
+
+    # Run rake task helpdesk:purge_cancelled_accounts
+    Rails.application.load_tasks if Rake::Task.tasks.empty?
+    Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+    Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+    # Expired account and ALL of its data are permanently deleted
+    assert_nil Account.find_by(id: expired_account.id)
+    assert_equal 0, User.where(account_id: expired_account.id).count
+    assert_equal 0, Session.where(account_id: expired_account.id).count
+    assert_equal 0, UserToken.where(account_id: expired_account.id).count
+
+    # Active and recently-cancelled accounts remain intact
+    assert Account.exists?(active_account.id)
+    assert Account.exists?(recent_account.id)
+
+    # Purged subdomain can now be registered again
+    signup_and_verify!(name: "Reborn Co", subdomain: "expiredco", email: "e@expired.test", password: "my-first-password")
+  end
+end
diff --git a/test/integration/business_signup_and_auth_test.rb b/test/integration/business_signup_and_auth_test.rb
new file mode 100644
index 0000000..505e8a0
--- /dev/null
+++ b/test/integration/business_signup_and_auth_test.rb
@@ -0,0 +1,318 @@
+require "test_helper"
+
+class BusinessSignupAndAuthTest < ActionDispatch::IntegrationTest
+  test "full business signup, email verification, sign in, profile update, password change, and sign out" do
+    # 1. Business signup
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: {
+               name: "Jo",
+               email: "jo@acme.test",
+               password: "my-first-password"
+             }
+           }
+         },
+         as: :json
+
+    assert_response :created
+    body = json_body
+
+    assert_kind_of Integer, body.dig("account", "id")
+    assert_equal "Acme", body.dig("account", "name")
+    assert_equal "acme", body.dig("account", "subdomain")
+    assert_equal "active", body.dig("account", "status")
+    assert body.dig("account", "created_at").present?
+    assert body.dig("account", "updated_at").present?
+
+    assert_kind_of Integer, body.dig("user", "id")
+    assert_equal body.dig("account", "id"), body.dig("user", "account_id")
+    assert_equal "Jo", body.dig("user", "name")
+    assert_equal "jo@acme.test", body.dig("user", "email")
+    assert_equal "admin", body.dig("user", "role")
+    assert_equal true, body.dig("user", "owner")
+    assert_equal false, body.dig("user", "verified")
+    assert_nil body.dig("user", "verified_at")
+    assert body.dig("user", "created_at").present?
+    assert body.dig("user", "updated_at").present?
+    assert_not body["user"].key?("password_digest")
+
+    # 2. Verification email sent with defaults
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], mail.from
+    assert_equal [ "jo@acme.test" ], mail.to
+
+    url, acct_param, first_token = extract_token_from_mail(mail, path: "/verify-email")
+    assert url.start_with?("http://localhost:3001/verify-email?account=acme&token=")
+    assert_equal "acme", acct_param
+    assert first_token.present?
+
+    # 3. Public portal works without auth
+    get "/api/v1/portal", headers: json_headers(account: "acme")
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_body)
+
+    # Case-insensitive account header
+    get "/api/v1/portal", headers: json_headers(account: "ACME")
+    assert_response :ok
+
+    # Missing or unknown account header
+    get "/api/v1/portal"
+    assert_response :bad_request
+    get "/api/v1/portal", headers: json_headers(account: "nonexistent")
+    assert_response :not_found
+
+    # 4. Cannot sign in before verifying email
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    # 5. Request a replacement verification link; old link must stop working
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "jo@acme.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    _url2, _acct2, second_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+    assert_not_equal first_token, second_token
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: first_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: second_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+    assert json_body.dig("user", "verified_at").present?
+
+    # Cannot reuse verification token
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: second_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Requesting verification link for already verified user sends no email
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/email_verifications",
+           params: { email_verification: { email: "jo@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+    end
+
+    # 6. Sign in with wrong password fails
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "wrong-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unauthorized
+
+    # 7. Sign in twice (two sessions)
+    login1 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token1 = login1.dig("session", "token")
+    assert token1.present?
+    assert_equal "Jo", login1.dig("user", "name")
+    assert_equal "acme", login1.dig("account", "subdomain")
+
+    login2 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token2 = login2.dig("session", "token")
+    assert_not_equal token1, token2
+
+    # 8. Authenticated GET /account and GET /me
+    get "/api/v1/account", headers: json_headers(account: "acme", token: token1)
+    assert_response :ok
+    assert_equal body.dig("account", "id"), json_body.dig("account", "id")
+    assert_equal "Acme", json_body.dig("account", "name")
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token1)
+    assert_response :ok
+    assert_equal "Jo", json_body.dig("user", "name")
+
+    # Unauthenticated GET /account and GET /me
+    get "/api/v1/account", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+    get "/api/v1/me", headers: json_headers(account: "acme", token: "bogus-token")
+    assert_response :unauthorized
+
+    # 9. Update profile via PATCH /me (and ignore unauthorized fields)
+    patch "/api/v1/me",
+          params: { user: { name: "Jo Smith", role: "customer", email: "hacked@acme.test" } },
+          headers: json_headers(account: "acme", token: token1),
+          as: :json
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+    assert_equal "admin", json_body.dig("user", "role")
+    assert_equal "jo@acme.test", json_body.dig("user", "email")
+
+    # Blank name rejected
+    patch "/api/v1/me",
+          params: { user: { name: "   " } },
+          headers: json_headers(account: "acme", token: token1),
+          as: :json
+    assert_response :unprocessable_content
+
+    # 10. Sign out session 1; session 2 stays valid
+    delete "/api/v1/session", headers: json_headers(account: "acme", token: token1)
+    assert_response :no_content
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token1)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token2)
+    assert_response :ok
+
+    # 11. Change password via PUT /me/password
+    # Create another session so we verify ALL existing sessions are signed out
+    token3 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Wrong current password fails and keeps sessions active
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+        headers: json_headers(account: "acme", token: token2),
+        as: :json
+    assert_response :unprocessable_content
+
+    # Short new password fails and keeps sessions active
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "short" } },
+        headers: json_headers(account: "acme", token: token2),
+        as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token2)
+    assert_response :ok
+
+    # Valid password change succeeds and signs out ALL existing sessions
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+        headers: json_headers(account: "acme", token: token2),
+        as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token2)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token3)
+    assert_response :unauthorized
+
+    # Old password fails, new password succeeds
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unauthorized
+
+    new_login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+    assert new_login.dig("session", "token").present?
+  end
+
+  test "signup respects HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://app.helpdesk.test/", "HELPDESK_MAIL_FROM" => "noreply@helpdesk.test") do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Café Support",
+               subdomain: "cafe",
+               admin: {
+                 name: "Ana",
+                 email: "ana@cafe.test",
+                 password: "my-first-password"
+               }
+             }
+           },
+           as: :json
+
+      assert_response :created
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "noreply@helpdesk.test" ], mail.from
+      url, acct, token = extract_token_from_mail(mail, path: "/verify-email")
+      assert url.start_with?("https://app.helpdesk.test/verify-email?account=cafe&token=")
+      assert_equal "cafe", acct
+      assert mail.encoded.include?(url), "Expected raw encoded email to contain unwrapped URL"
+      assert token.present?
+    end
+  end
+
+  test "signup validations are atomic and reject duplicate subdomains and malformed payloads" do
+    signup_and_verify!(subdomain: "acme")
+
+    # Duplicate subdomain (case-insensitive)
+    assert_no_difference [ "Account.count", "User.count" ] do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Acme Two",
+               subdomain: "ACME",
+               admin: { name: "Bob", email: "bob@acme2.test", password: "my-first-password" }
+             }
+           },
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Valid account but invalid admin rolls back account creation
+    assert_no_difference [ "Account.count", "User.count" ] do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Beta",
+               subdomain: "beta",
+               admin: { name: "Bob", email: "not-an-email", password: "123" }
+             }
+           },
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Invalid subdomain format
+    assert_no_difference [ "Account.count", "User.count" ] do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Bad Sub",
+               subdomain: "-bad_sub-",
+               admin: { name: "Bob", email: "bob@bad.test", password: "my-first-password" }
+             }
+           },
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Non-hash envelope returns 400
+    post "/api/v1/account/create", params: { account: "invalid" }, as: :json
+    assert_response :bad_request
+  end
+
+  test "expired verification token is rejected" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+    _url, _acct, token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    travel 25.hours do
+      post "/api/v1/email_verifications/confirm",
+           params: { email_verification: { token: token } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+    end
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
index 0000000..d1c2c44
--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  test "allows configured default frontend origin and rejects unknown origins" do
+    signup_and_verify!(subdomain: "acme")
+
+    # Preflight from default origin
+    options "/api/v1/sessions",
+            headers: {
+              "Origin" => "http://localhost:3001",
+              "Access-Control-Request-Method" => "POST",
+              "Access-Control-Request-Headers" => "Content-Type, Authorization, X-Helpdesk-Account"
+            }
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Methods"], "POST"
+    assert_includes response.headers["Access-Control-Allow-Headers"], "X-Helpdesk-Account"
+
+    # Regular GET request from allowed origin
+    get "/api/v1/portal",
+        headers: json_headers(account: "acme", extra: { "Origin" => "http://localhost:3001" })
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    # Error response from allowed origin still includes CORS header
+    get "/api/v1/me",
+        headers: json_headers(account: "acme", extra: { "Origin" => "http://localhost:3001" })
+    assert_response :unauthorized
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    # Disallowed origin does NOT receive Access-Control-Allow-Origin
+    get "/api/v1/portal",
+        headers: json_headers(account: "acme", extra: { "Origin" => "https://evil.example.test" })
+    assert_response :ok
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+  end
+
+  test "respects custom HELPDESK_FRONTEND_URL origin including paths or trailing slashes" do
+    signup_and_verify!(subdomain: "acme")
+
+    with_env("HELPDESK_FRONTEND_URL" => "https://frontend.example.test/app/") do
+      get "/api/v1/portal",
+          headers: json_headers(account: "acme", extra: { "Origin" => "https://frontend.example.test" })
+      assert_response :ok
+      assert_equal "https://frontend.example.test", response.headers["Access-Control-Allow-Origin"]
+
+      get "/api/v1/portal",
+          headers: json_headers(account: "acme", extra: { "Origin" => "http://localhost:3001" })
+      assert_response :ok
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+end
diff --git a/test/integration/multi_tenancy_test.rb b/test/integration/multi_tenancy_test.rb
new file mode 100644
index 0000000..2bca33b
--- /dev/null
+++ b/test/integration/multi_tenancy_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class MultiTenancyTest < ActionDispatch::IntegrationTest
+  test "same email can belong to multiple businesses with strict isolation" do
+    # Register same email under two accounts with different passwords
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo Acme", email: "jo@shared.test", password: "acme-password-1" }
+           }
+         },
+         as: :json
+    assert_response :created
+    _u1, _a1, acme_verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Globex",
+             subdomain: "globex",
+             admin: { name: "Jo Globex", email: "jo@shared.test", password: "globex-password-1" }
+           }
+         },
+         as: :json
+    assert_response :created
+    _u2, _a2, globex_verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    # Cross-account verification token is rejected
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: acme_verify_token } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Verify both in their respective accounts
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: acme_verify_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    # Globex user is still unverified
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@shared.test", password: "globex-password-1" } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :forbidden
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: globex_verify_token } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :ok
+
+    # Sign in to both accounts
+    acme_token = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "acme-password-1").dig("session", "token")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@shared.test", password: "globex-password-1").dig("session", "token")
+
+    # Cross-account bearer tokens are rejected
+    get "/api/v1/me", headers: json_headers(account: "globex", token: acme_token)
+    assert_response :unauthorized
+    get "/api/v1/account", headers: json_headers(account: "acme", token: globex_token)
+    assert_response :unauthorized
+    delete "/api/v1/session", headers: json_headers(account: "globex", token: acme_token)
+    assert_response :unauthorized
+
+    # Cross-account password reset token is rejected
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@shared.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    _ru, _ra, acme_reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: acme_reset_token, password: "new-acme-password" } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Resetting acme password revokes acme session but NOT globex session
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: acme_reset_token, password: "new-acme-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: acme_token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: json_headers(account: "globex", token: globex_token)
+    assert_response :ok
+    assert_equal "Jo Globex", json_body.dig("user", "name")
+  end
+end
