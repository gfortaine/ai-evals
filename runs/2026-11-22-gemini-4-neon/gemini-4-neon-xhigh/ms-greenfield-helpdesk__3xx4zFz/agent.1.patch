@@ -0,0 +1,141 @@
+require "test_helper"
+
+class PasswordResetsTest < ActionDispatch::IntegrationTest
+  test "password reset flow replaces old links, revokes existing sessions, and respects env config" do
+    signup_and_verify!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    existing_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+
+    with_env("HELPDESK_FRONTEND_URL" => "https://portal.example.test", "HELPDESK_MAIL_FROM" => "help@example.test") do
+      # Unknown email returns 200 without sending mail
+      post "/api/v1/password_resets",
+           params: { password_reset: { email: "nobody@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+      assert_equal 0, ActionMailer::Base.deliveries.size
+
+      # Request first reset link
+      post "/api/v1/password_resets",
+           params: { password_reset: { email: "jo@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+      assert_equal 1, ActionMailer::Base.deliveries.size
+
+      mail1 = ActionMailer::Base.deliveries.last
+      assert_equal [ "help@example.test" ], mail1.from
+      url1, acct1, token1 = extract_token_from_mail(mail1, path: "/reset-password")
+      assert url1.start_with?("https://portal.example.test/reset-password?account=acme&token=")
+      assert_equal "acme", acct1
+
+      # Request second reset link; replaces first link
+      post "/api/v1/password_resets",
+           params: { password_reset: { email: "jo@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+      assert_equal 2, ActionMailer::Base.deliveries.size
+      _url2, _acct2, token2 = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+      assert_not_equal token1, token2
+
+      # First token must fail
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token1, password: "my-new-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      # Invalid new password must fail WITHOUT consuming token2
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token2, password: "short" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      # Existing session is still alive until password actually changes
+      get "/api/v1/me", headers: json_headers(account: "acme", token: existing_token)
+      assert_response :ok
+
+      # Valid confirmation updates password and revokes existing sessions
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token2, password: "my-new-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+
+      # Token2 cannot be reused
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token2, password: "another-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      # Existing session was revoked
+      get "/api/v1/me", headers: json_headers(account: "acme", token: existing_token)
+      assert_response :unauthorized
+
+      # Old password fails, new password works
+      post "/api/v1/sessions",
+           params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unauthorized
+
+      sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+    end
+  end
+
+  test "tokens cannot be used across purposes and expire after TTL" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+    _vurl, _vacct, verification_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    # Verification token rejected on password reset confirm
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: verification_token, password: "my-new-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Requesting password reset does NOT invalidate verification token
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    _rurl, _racct, reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+
+    # Reset token rejected on email verification confirm
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: reset_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Verification token still works
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: verification_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    # Reset token expires after 2 hours
+    travel 3.hours do
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: reset_token, password: "my-new-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+    end
+  end
+end
diff --git a/test/integration/security_and_edge_cases_test.rb b/test/integration/security_and_edge_cases_test.rb
new file mode 100644
index 0000000..4b39d21
--- /dev/null
+++ b/test/integration/security_and_edge_cases_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class SecurityAndEdgeCasesTest < ActionDispatch::IntegrationTest
+  test "tokens are stored only as digests, never in plaintext" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+
+    _url, _acct, verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+    assert_nil UserToken.find_by(token_digest: verify_token)
+    assert UserToken.find_by(token_digest: UserToken.digest(verify_token)).present?
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: verify_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    session_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    assert_nil Session.find_by(token_digest: session_token)
+    assert Session.find_by(token_digest: Session.digest(session_token)).present?
+  end
+
+  test "email and subdomain normalization works across all endpoints" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "  Acme Corp  ",
+             subdomain: "  AcMe-1  ",
+             admin: { name: "  Jo  ", email: "  JO@AcMe.TEST  ", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+    assert_equal "Acme Corp", json_body.dig("account", "name")
+    assert_equal "acme-1", json_body.dig("account", "subdomain")
+    assert_equal "Jo", json_body.dig("user", "name")
+    assert_equal "jo@acme.test", json_body.dig("user", "email")
+
+    # Resend verification with uppercase email and header
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "JO@ACME.TEST" } },
+         headers: json_headers(account: "ACME-1"),
+         as: :json
+    assert_response :ok
+    _u, _a, token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token } },
+         headers: json_headers(account: "ACME-1"),
+         as: :json
+    assert_response :ok
+
+    # Login with uppercase email
+    login = sign_in!(subdomain: "ACME-1", email: "JO@ACME.TEST", password: "my-first-password")
+    assert login.dig("session", "token").present?
+  end
+
+  test "authorization header edge cases" do
+    signup_and_verify!(subdomain: "acme")
+    token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Case-insensitive Bearer scheme works
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "bearer #{token}" }
+    assert_response :ok
+
+    # Invalid schemes and blank tokens fail
+    [ "Basic #{token}", "Token #{token}", "Bearer", "Bearer   ", token ].each do |auth_header|
+      get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => auth_header }
+      assert_response :unauthorized, "Expected 401 for Authorization: #{auth_header.inspect}"
+    end
+  end
+
+  test "password blank and max length edge cases" do
+    # > 72 bytes rejected on signup
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "a" * 73 }
+           }
+         },
+         as: :json
+    assert_response :unprocessable_content
+
+    signup_and_verify!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Blank password on PUT /me/password fails with 422
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "" } },
+        headers: json_headers(account: "acme", token: token),
+        as: :json
+    assert_response :unprocessable_content
+
+    # Missing password key on PUT /me/password fails with 422
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password" } },
+        headers: json_headers(account: "acme", token: token),
+        as: :json
+    assert_response :unprocessable_content
+
+    # > 72 bytes on PUT /me/password fails with 422
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "b" * 73 } },
+        headers: json_headers(account: "acme", token: token),
+        as: :json
+    assert_response :unprocessable_content
+
+    # > 72 bytes on login returns 401 cleanly
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "a" * 80 } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unauthorized
+  end
+
+  test "previously issued tokens are blocked while account is cancelled and exact 90-day boundary is enforced" do
+    signup_and_verify!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Request a password reset token before cancellation
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    _u, _a, reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+
+    # Cancel account
+    post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: token)
+    assert_response :ok
+
+    # Confirming previously issued reset token fails with 403 while cancelled
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: reset_token, password: "my-new-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    # At exactly 90 days ago with frozen time, account is expired & purgeable
+    freeze_time do
+      account = Account.find_by!(subdomain: "acme")
+      account.update_column(:cancelled_at, 90.days.ago)
+
+      assert account.reactivation_expired?
+      assert_not account.reactivatable?
+      assert_equal 1, Account.purge_cancelled!
+      assert_not Account.exists?(account.id)
+    end
+  end
+end
