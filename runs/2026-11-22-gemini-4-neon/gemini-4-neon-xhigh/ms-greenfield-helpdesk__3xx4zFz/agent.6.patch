+    end
+
+    get "/api/v1/tickets/#{t_billing_sam['id']}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "group")
+    assert_nil json_body.dig("ticket", "assignee_id")
+
+    get "/api/v1/tickets/#{t_billing_alex['id']}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "group")
+    assert_nil json_body.dig("ticket", "assignee_id")
+
+    get "/api/v1/tickets/#{t_support_sam['id']}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal support["id"], json_body.dig("ticket", "group_id")
+    assert_equal @sam_id, json_body.dig("ticket", "assignee_id")
+
+    # Customer-facing public_updated_at stayed at t0 across all internal group/membership deletions!
+    [ t_billing_sam, t_billing_alex, t_support_sam ].each do |req|
+      get "/api/v1/requests/#{req['id']}", headers: json_headers(account: "acme", token: @customer_token)
+      assert_equal t0.iso8601(3), json_body.dig("request", "updated_at")
+    end
+  end
+
+  test "suspension keeps group memberships for later while clearing ticket assignments; demotion to customer removes memberships" do
+    billing = create_group!(name: "Billing")
+    support = create_group!(name: "Technical Support")
+
+    sam_billing = create_membership!(group_id: billing["id"], user_id: @sam_id)
+    sam_support = create_membership!(group_id: support["id"], user_id: @sam_id, default: true)
+
+    req1 = create_request!(subject: "Assigned to Sam")
+    patch "/api/v1/tickets/#{req1['id']}",
+          params: { ticket: { assignee_id: @sam_id } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal support["id"], json_body.dig("ticket", "group_id")
+    assert_equal @sam_id, json_body.dig("ticket", "assignee_id")
+
+    # Suspend Sam -> ticket assignment cleared (group remains!), memberships KEPT!
+    patch "/api/v1/users/#{@sam_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "suspended")
+
+    get "/api/v1/tickets/#{req1['id']}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal support["id"], json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "assignee_id")
+
+    get "/api/v1/group_memberships?user_id=#{@sam_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ sam_billing["id"], sam_support["id"] ], json_body["group_memberships"].map { |m| m["id"] }
+    assert_equal [ false, true ], json_body["group_memberships"].map { |m| m["default"] }
+    assert_equal true, json_body["group_memberships"].first.dig("user", "suspended")
+
+    # While suspended, Sam cannot be assigned to a ticket
+    patch "/api/v1/tickets/#{req1['id']}",
+          params: { ticket: { assignee_id: @sam_id } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+
+    # Unsuspend Sam -> memberships and default group are still intact and immediately usable!
+    patch "/api/v1/users/#{@sam_id}",
+          params: { user: { suspended: false } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    req2 = create_request!(subject: "Post-unsuspension ticket")
+    patch "/api/v1/tickets/#{req2['id']}",
+          params: { ticket: { assignee_id: @sam_id } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal support["id"], json_body.dig("ticket", "group_id")
+    assert_equal @sam_id, json_body.dig("ticket", "assignee_id")
+
+    # Promoting Sam from agent -> admin keeps memberships and assignments
+    patch "/api/v1/users/#{@sam_id}",
+          params: { user: { role: "admin" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    get "/api/v1/group_memberships?user_id=#{@sam_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal 2, json_body["count"]
+    assert_equal @sam_id, Ticket.find(req2["id"]).assignee_id
+
+    # Demoting Sam to customer clears assignments (leaving group intact) AND removes all group memberships!
+    patch "/api/v1/users/#{@sam_id}",
+          params: { user: { role: "customer" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    get "/api/v1/group_memberships?user_id=#{@sam_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal 0, json_body["count"]
+
+    get "/api/v1/tickets/#{req2['id']}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal support["id"], json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "assignee_id")
+  end
+
+  test "edge cases: groupless assignee later joining a group, explicit clear on ungrouped ticket, no-op group update, and simultaneous suspend+demote" do
+    billing = create_group!(name: "Billing")
+    support = create_group!(name: "Technical Support")
+
+    # 1. Assign groupless Dana to ungrouped ticket -> stays ungrouped
+    req1 = create_request!(subject: "Groupless lifecycle")
+    patch "/api/v1/tickets/#{req1["id"]}",
+          params: { ticket: { assignee_id: @dana_id } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_equal @dana_id, json_body.dig("ticket", "assignee_id")
+
+    # Explicitly clearing group_id: nil on an ungrouped ticket ALSO clears assignee!
+    patch "/api/v1/tickets/#{req1["id"]}",
+          params: { ticket: { group_id: nil } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "assignee_id")
+
+    # Re-assign groupless Dana, then add Dana to Billing -> existing ungrouped ticket can still update status
+    patch "/api/v1/tickets/#{req1["id"]}",
+          params: { ticket: { assignee_id: @dana_id } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    create_membership!(group_id: billing["id"], user_id: @dana_id)
+
+    patch "/api/v1/tickets/#{req1["id"]}",
+          params: { ticket: { status: "pending" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_equal @dana_id, json_body.dig("ticket", "assignee_id")
+
+    # Moving that ticket into Billing keeps Dana (since Dana is now in Billing)
+    patch "/api/v1/tickets/#{req1["id"]}",
+          params: { ticket: { group_id: billing["id"] } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal billing["id"], json_body.dig("ticket", "group_id")
+    assert_equal @dana_id, json_body.dig("ticket", "assignee_id")
+
+    # Re-sending same group_id keeps assignee; sending group_id + assignee_id: nil clears assignee
+    patch "/api/v1/tickets/#{req1["id"]}",
+          params: { ticket: { group_id: billing["id"] } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal @dana_id, json_body.dig("ticket", "assignee_id")
+
+    patch "/api/v1/tickets/#{req1["id"]}",
+          params: { ticket: { group_id: billing["id"], assignee_id: nil } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal billing["id"], json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "assignee_id")
+
+    # 2. Failed atomic demotion (blank name + role: customer) preserves memberships and assignments
+    create_membership!(group_id: support["id"], user_id: @alex_id)
+    req2 = create_request!(subject: "Alex ticket")
+    patch "/api/v1/tickets/#{req2["id"]}",
+          params: { ticket: { assignee_id: @alex_id } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    patch "/api/v1/users/#{@alex_id}",
+          params: { user: { name: "   ", role: "customer" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+    assert_equal 1, User.find(@alex_id).group_memberships.count
+    assert_equal @alex_id, Ticket.find(req2["id"]).assignee_id
+
+    # 3. Simultaneous suspend + demote to customer clears sessions, assignments, AND memberships!
+    patch "/api/v1/users/#{@alex_id}",
+          params: { user: { suspended: true, role: "customer" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "suspended")
+    assert_equal "customer", json_body.dig("user", "role")
+    assert_equal 0, User.find(@alex_id).group_memberships.count
+    assert_nil Ticket.find(req2["id"]).assignee_id
+    assert_equal support["id"], Ticket.find(req2["id"]).group_id
+  end
+end
diff --git a/test/models/group_and_membership_integrity_test.rb b/test/models/group_and_membership_integrity_test.rb
new file mode 100644
index 0000000..3681f6b
--- /dev/null
+++ b/test/models/group_and_membership_integrity_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class GroupAndMembershipIntegrityTest < ActiveSupport::TestCase
+  setup do
+    @acme = Account.create!(name: "Acme", subdomain: "acme")
+    @globex = Account.create!(name: "Globex", subdomain: "globex")
+
+    @acme_admin = @acme.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "jo-password-1",
+      role: "admin",
+      verified_at: Time.current
+    )
+    @acme_agent = @acme.users.create!(
+      name: "Sam",
+      email: "sam@acme.test",
+      password: "sam-password-1",
+      role: "agent",
+      verified_at: Time.current
+    )
+    @acme_customer = @acme.users.create!(
+      name: "Avery",
+      email: "avery@example.test",
+      password: "avery-password-1",
+      role: "customer",
+      verified_at: Time.current
+    )
+    @globex_admin = @globex.users.create!(
+      name: "Pat",
+      email: "pat@globex.test",
+      password: "pat-password-1",
+      role: "admin",
+      verified_at: Time.current
+    )
+  end
+
+  test "group validates name normalization, length, and per-account case-insensitive uniqueness" do
+    billing = @acme.groups.create!(name: "  Billing  ")
+    assert_equal "Billing", billing.name
+
+    duplicate = @acme.groups.build(name: "billing")
+    assert_not duplicate.valid?
+    assert duplicate.errors[:name].any?
+
+    # Same name in another account is valid
+    globex_billing = @globex.groups.create!(name: "Billing")
+    assert_equal "Billing", globex_billing.name
+
+    # Blank and over-length names are invalid
+    [ nil, "", "   ", "a" * 256 ].each do |bad_name|
+      g = @acme.groups.build(name: bad_name)
+      assert_not g.valid?, "Expected name=#{bad_name.inspect} to be invalid"
+      assert g.errors[:name].any?
+    end
+  end
+
+  test "group membership enforces account integrity, staff-only users, uniqueness, and single default per user" do
+    acme_billing = @acme.groups.create!(name: "Billing")
+    acme_support = @acme.groups.create!(name: "Technical Support")
+    globex_billing = @globex.groups.create!(name: "Billing")
+
+    # Rejects customer
+    customer_membership = GroupMembership.new(account: @acme, group: acme_billing, user: @acme_customer, default: true)
+    assert_not customer_membership.valid?
+    assert_includes customer_membership.errors[:user], "must be a staff member"
+
+    # Rejects cross-account user
+    cross_user = GroupMembership.new(account: @acme, group: acme_billing, user: @globex_admin, default: true)
+    assert_not cross_user.valid?
+    assert_includes cross_user.errors[:user], "must belong to the same account"
+
+    # Rejects cross-account group
+    cross_group = GroupMembership.new(account: @acme, group: globex_billing, user: @acme_agent, default: true)
+    assert_not cross_group.valid?
+    assert_includes cross_group.errors[:group], "must belong to the same account"
+
+    # Valid membership for staff (including suspended staff)
+    @acme_agent.reload.update!(suspended_at: Time.current)
+    m1 = @acme.group_memberships.create!(group: acme_billing, user: @acme_agent, default: true)
+    assert m1.persisted?
+
+    # Rejects duplicate (group, user)
+    dup = GroupMembership.new(account: @acme, group: acme_billing, user: @acme_agent, default: false)
+    assert_not dup.valid?
+    assert dup.errors[:user_id].any?
+
+    # Partial unique index prevents two default memberships for the same user at DB level
+    assert_raises ActiveRecord::RecordNotUnique do
+      @acme.group_memberships.create!(group: acme_support, user: @acme_agent, default: true)
+    end
+  end
+
+  test "ticket validates same-account group and assignee belongs to ticket group" do
+    acme_billing = @acme.groups.create!(name: "Billing")
+    globex_billing = @globex.groups.create!(name: "Billing")
+    ticket = @acme.tickets.create!(requester: @acme_customer, subject: "Help")
+
+    # Cross-account group rejected
+    ticket.group = globex_billing
+    assert_not ticket.valid?
+    assert_includes ticket.errors[:group_id], "must belong to the same account"
+
+    # Assignee not in ticket's group rejected
+    ticket.group = acme_billing
+    ticket.assignee = @acme_agent
+    assert_not ticket.valid?
+    assert_includes ticket.errors[:assignee_id], "must belong to the ticket's group"
+
+    # Once agent joins group, valid!
+    @acme.group_memberships.create!(group: acme_billing, user: @acme_agent, default: true)
+    assert ticket.valid?
+    ticket.save!
+
+    # Ungrouped ticket with assignee still valid
+    ungrouped = @acme.tickets.build(requester: @acme_customer, subject: "No group", group: nil, assignee: @acme_admin)
+    assert ungrouped.valid?
+  end
+
+  test "purging a cancelled account removes its groups and group memberships" do
+    billing = @acme.groups.create!(name: "Billing")
+    membership = @acme.group_memberships.create!(group: billing, user: @acme_agent, default: true)
+    @acme.tickets.create!(requester: @acme_customer, subject: "Help", group: billing, assignee: @acme_agent)
+
+    globex_group = @globex.groups.create!(name: "Billing")
+    globex_membership = @globex.group_memberships.create!(group: globex_group, user: @globex_admin, default: true)
+
+    @acme.update_column(:cancelled_at, 91.days.ago)
+    assert_equal 1, Account.purge_cancelled!
+
+    assert_not Group.exists?(billing.id)
+    assert_not GroupMembership.exists?(membership.id)
+    assert Group.exists?(globex_group.id)
+    assert GroupMembership.exists?(globex_membership.id)
+  end
+end
