--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,34 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :account
+  belongs_to :group, inverse_of: :group_memberships
+  belongs_to :user, inverse_of: :group_memberships
+
+  validates :default, inclusion: { in: [ true, false ] }
+  validates :user_id, uniqueness: { scope: :group_id, message: "is already a member of this group" }
+  validate :group_belongs_to_account
+  validate :user_must_be_staff_in_account
+
+  scope :by_id_asc, -> { order(id: :asc) }
+  scope :default_only, -> { where(default: true) }
+  scope :for_group, ->(group_id) { where(group_id: group_id) }
+  scope :for_user, ->(user_id) { where(user_id: user_id) }
+
+  private
+
+  def group_belongs_to_account
+    return unless account_id.present? && group.present?
+    return if group.account_id == account_id
+
+    errors.add(:group, "must belong to the same account")
+  end
+
+  def user_must_be_staff_in_account
+    return unless account_id.present? && user.present?
+
+    if user.account_id != account_id
+      errors.add(:user, "must belong to the same account")
+    elsif !user.staff?
+      errors.add(:user, "must be a staff member")
+    end
+  end
+end
