+
+    [ nil, "", "   ", "a" * 256, 123, true, false, [ "Billing" ], { a: 1 } ].each do |bad_name|
+      post "/api/v1/groups", params: { group: { name: bad_name } }, headers: json_headers(account: "acme", token: @owner_token), as: :json
+      assert_response :unprocessable_content, "Expected 422 for create name=#{bad_name.inspect}"
+      patch "/api/v1/groups/#{acme_group['id']}", params: { group: { name: bad_name } }, headers: json_headers(account: "acme", token: @owner_token), as: :json
