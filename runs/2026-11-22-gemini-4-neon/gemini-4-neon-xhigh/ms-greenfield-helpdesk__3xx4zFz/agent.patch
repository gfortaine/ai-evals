+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+
+    # Delete group -> 204, subsequent GET -> 404, name can be reused
+    delete "/api/v1/groups/#{sales['id']}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :no_content
