+
+  def ticket_must_not_be_closed
+    return unless ticket.present? && ticket.closed?
+
+    errors.add(:ticket, "is closed and cannot receive new comments")
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..2b119ee
