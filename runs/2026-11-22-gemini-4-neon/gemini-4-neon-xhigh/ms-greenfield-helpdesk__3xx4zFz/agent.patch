+      assert_no_difference [ "Ticket.count", "User.count" ] do
+        post_raw_email(build_raw_email(from: nil, message_id: retry_from_id))
+        post_raw_email(build_raw_email(from: "not-an-email", message_id: retry_from_id))
+      end
+      assert_response :no_content
+
+      assert_difference [ "Ticket.count", "User.count" ], 1 do
+        post_raw_email(build_raw_email(from: "validfrom@example.test", message_id: retry_from_id))
+      end
+      assert_response :no_content
+
+      # Email without Message-ID opens a ticket, exact duplicate is deduplicated, different email opens second ticket
+      no_id_raw_1 = build_raw_email(from: "validfrom@example.test", subject: "No ID 1", body: "First no-id", message_id: nil)
+      no_id_raw_2 = build_raw_email(from: "validfrom@example.test", subject: "No ID 2", body: "Second no-id", message_id: nil)
+
+      assert_difference "Ticket.count", 1 do
+        post_raw_email(no_id_raw_1)
+      end
+      assert_response :no_content
+
+      assert_no_difference "Ticket.count" do
+        post_raw_email(no_id_raw_1)
+      end
+      assert_response :no_content
+
+      assert_difference "Ticket.count", 1 do
+        post_raw_email(no_id_raw_2)
+      end
+      assert_response :no_content
+
+      # Customer portal reply on an email-origin ticket does NOT send a staff-reply email
+      ticket = @acme.tickets.order(:id).last
+      customer = ticket.requester
+      customer.update!(verified_at: Time.current, password: "portal-password-1")
+      customer_token = sign_in!(subdomain: "acme", email: customer.email, password: "portal-password-1").dig("session", "token")
+      ActionMailer::Base.deliveries.clear
+
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        patch "/api/v1/requests/#{ticket.id}",
+              params: { request: { comment: { body: "Following up via web portal" } } },
+              headers: json_headers(account: "acme", token: customer_token),
+              as: :json
+      end
+      assert_response :ok
+
+      # Purging a cancelled account cleanly destroys email-origin tickets and comments
+      post_raw_email(build_raw_email(from: "betauser@example.test", to: "beta@support.example.test", subject: "Beta email", body: "To be purged"))
+      assert_response :no_content
+      @beta.cancel!
+      @beta.update_columns(cancelled_at: 91.days.ago)
+      assert_equal 1, Account.purge_cancelled!
+    end
+  end
+end
