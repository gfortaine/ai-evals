diff --git a/app/controllers/concerns/api_v1_pagination.rb b/app/controllers/concerns/api_v1_pagination.rb
new file mode 100644
index 0000000..2a8633e
--- /dev/null
+++ b/app/controllers/concerns/api_v1_pagination.rb
@@ -0,0 +1,187 @@
+module ApiV1Pagination
+  extend ActiveSupport::Concern
+
+  DEFAULT_PAGE = 1
+  DEFAULT_PER_PAGE = 25
+  MAX_PER_PAGE = 100
+  ALLOWED_CURSOR_KEYS = %w[size after before].freeze
+  POSITIVE_INTEGER_FORMAT = /\A[1-9]\d*\z/
+
+  class InvalidPaginationError < StandardError
+    attr_reader :errors
+
+    def initialize(errors)
+      @errors = errors
+      super(errors.values.flatten.first || "Invalid pagination parameters")
+    end
+  end
+
+  private
+
+  def paginate_collection(scope, key:, cursor_context: nil, cursor_order: nil, &serializer)
+    if cursor_pagination_requested?
+      unless cursor_context.present? && cursor_order.present?
+        raise ArgumentError, "cursor_context and cursor_order are required for cursor pagination"
+      end
+
+      paginate_with_cursor(
+        scope,
+        key: key,
+        cursor_context: cursor_context,
+        cursor_order: cursor_order,
+        &serializer
+      )
+    else
+      paginate_with_page_number(scope, key: key, &serializer)
+    end
+  end
+
+  def cursor_pagination_requested?
+    params[:page].is_a?(ActionController::Parameters)
+  end
+
+  def paginate_with_cursor(scope, key:, cursor_context:, cursor_order:, &serializer)
+    size, after_token, before_token = parse_cursor_pagination_params
+
+    result = CursorPaginator.new(
+      scope: scope,
+      order: cursor_order,
+      context: cursor_context,
+      size: size,
+      after: after_token,
+      before: before_token
+    ).call
+
+    raise InvalidPaginationError.new(result.errors) unless result.success?
+
+    next_link = result.has_next ? cursor_page_url(size: result.size, after: result.after_cursor) : nil
+    prev_link = result.has_prev ? cursor_page_url(size: result.size, before: result.before_cursor) : nil
+
+    {
+      key => result.records.map(&serializer),
+      meta: {
+        has_more: result.has_more,
+        after_cursor: result.after_cursor,
+        before_cursor: result.before_cursor
+      },
+      links: {
+        next: next_link,
+        prev: prev_link
+      }
+    }
+  end
+
+  def parse_cursor_pagination_params
+    raw_hash = params[:page].to_unsafe_h
+    errors = {}
+
+    unknown_keys = raw_hash.keys - ALLOWED_CURSOR_KEYS
+    if unknown_keys.any?
+      errors["page"] = [ "Unknown pagination parameter(s): #{unknown_keys.sort.join(', ')}" ]
+    end
+
+    size = parse_cursor_size(raw_hash, errors)
+    after_token = parse_cursor_token(raw_hash, "after", errors)
+    before_token = parse_cursor_token(raw_hash, "before", errors)
+
+    if after_token.present? && before_token.present?
+      errors["page"] = (errors["page"] || []) + [ "Cannot specify both page[after] and page[before]" ]
+    end
+
+    raise InvalidPaginationError.new(errors) if errors.any?
+
+    [ size, after_token, before_token ]
+  end
+
+  def parse_cursor_size(raw_hash, errors)
+    return DEFAULT_PER_PAGE unless raw_hash.key?("size")
+
+    raw_size = raw_hash["size"]
+    return DEFAULT_PER_PAGE if raw_size.is_a?(String) && raw_size.blank?
+
+    unless raw_size.is_a?(String)
+      errors["page[size]"] = [ "Page size must be a positive integer" ]
+      return DEFAULT_PER_PAGE
+    end
+
+    trimmed = raw_size.strip
+    unless POSITIVE_INTEGER_FORMAT.match?(trimmed)
+      errors["page[size]"] = [ "Page size must be a positive integer" ]
+      return DEFAULT_PER_PAGE
+    end
+
+    return MAX_PER_PAGE if trimmed.length > 10
+
+    parsed = Integer(trimmed, 10)
+    [ parsed, MAX_PER_PAGE ].min
+  end
+
+  def parse_cursor_token(raw_hash, key, errors)
+    return nil unless raw_hash.key?(key)
+
+    raw_val = raw_hash[key]
+    return nil if raw_val.is_a?(String) && raw_val.blank?
+
+    unless raw_val.is_a?(String)
+      errors["page[#{key}]"] = [ "Cursor must be a string" ]
+      return nil
+    end
+
+    raw_val.strip
+  end
+
+  def cursor_page_url(size:, after: nil, before: nil)
+    query_params = request.query_parameters.deep_dup
+    query_params.delete("per_page")
+
+    page_hash = { "size" => size.to_s }
+    page_hash["after"] = after if after.present?
+    page_hash["before"] = before if before.present?
+    query_params["page"] = page_hash
+
+    "#{request.base_url}#{request.path}?#{query_params.to_query}"
+  end
+
+  def paginate_with_page_number(scope, key:, &serializer)
+    page, per_page = pagination_params
+    count = scope.except(:includes, :preload, :eager_load, :order).count
+    total_pages = count.zero? ? 0 : (count.to_f / per_page).ceil
+    offset = (page - 1) * per_page
+
+    records = if offset >= count
+                []
+              else
+                scope.offset(offset).limit(per_page).to_a
+              end
+
+    next_page = page < total_pages ? page + 1 : nil
+    previous_page = if page > 1 && total_pages.positive?
+                      [ page - 1, total_pages ].min
+                    end
+
+    {
+      key => records.map(&serializer),
+      count: count,
+      page: page,
+      per_page: per_page,
+      next_page: next_page,
+      previous_page: previous_page
+    }
+  end
+
+  def pagination_params
+    page = parse_positive_integer(params[:page], default: DEFAULT_PAGE)
+    per_page = parse_positive_integer(params[:per_page], default: DEFAULT_PER_PAGE)
+    per_page = MAX_PER_PAGE if per_page > MAX_PER_PAGE
+    [ page, per_page ]
+  end
+
+  def parse_positive_integer(raw, default:)
+    return default if raw.blank?
+
+    value = Integer(raw.to_s.strip, 10)
+    value.positive? ? value : default
+  rescue ArgumentError, TypeError
+    default
+  end
+end
diff --git a/app/controllers/concerns/api_v1_serializers.rb b/app/controllers/concerns/api_v1_serializers.rb
new file mode 100644
index 0000000..d2f5096
--- /dev/null
+++ b/app/controllers/concerns/api_v1_serializers.rb
@@ -0,0 +1,187 @@
+module ApiV1Serializers
+  extend ActiveSupport::Concern
+
+  private
+
+  def serialize_account(account)
+    {
+      id: account.id,
+      name: account.name,
+      subdomain: account.subdomain,
+      owner_id: account.owner_id,
+      status: account.status,
+      cancelled_at: account.cancelled_at&.iso8601(3),
+      purge_at: account.purge_at&.iso8601(3),
+      created_at: account.created_at.iso8601(3),
+      updated_at: account.updated_at.iso8601(3)
+    }
+  end
+
+  def serialize_portal(account)
+    {
+      name: account.name,
+      subdomain: account.subdomain
+    }
+  end
+
+  def serialize_user(user)
+    {
+      id: user.id,
+      account_id: user.account_id,
+      name: user.name,
+      email: user.email,
+      role: user.role,
+      owner: user.owner?,
+      verified: user.verified?,
+      verified_at: user.verified_at&.iso8601(3),
+      suspended: user.suspended?,
+      suspended_at: user.suspended_at&.iso8601(3),
+      created_at: user.created_at.iso8601(3),
+      updated_at: user.updated_at.iso8601(3)
+    }
+  end
+
+  def serialize_staff_member(user)
+    {
+      id: user.id,
+      name: user.name,
+      email: user.email,
+      role: user.role,
+      suspended: user.suspended?
+    }
+  end
+
+  def serialize_group(group)
+    {
+      id: group.id,
+      account_id: group.account_id,
+      name: group.name,
+      created_at: group.created_at.iso8601(3),
+      updated_at: group.updated_at.iso8601(3)
+    }
+  end
+
+  def serialize_group_membership(membership)
+    group = membership.group
+    user = membership.user
+    {
+      id: membership.id,
+      account_id: membership.account_id,
+      group_id: membership.group_id,
+      group: group ? {
+        id: group.id,
+        name: group.name
+      } : nil,
+      user_id: membership.user_id,
+      user: user ? {
+        id: user.id,
+        name: user.name,
+        email: user.email,
+        role: user.role,
+        suspended: user.suspended?
+      } : nil,
+      default: membership.default?,
+      created_at: membership.created_at.iso8601(3),
+      updated_at: membership.updated_at.iso8601(3)
+    }
+  end
+
+  def serialize_invitation(invitation, now: Time.current)
+    inviter = invitation.invited_by
+    {
+      id: invitation.id,
+      account_id: invitation.account_id,
+      email: invitation.email,
+      role: invitation.role,
+      status: invitation.status(now),
+      invited_by_id: invitation.invited_by_id,
+      invited_by: inviter ? {
+        id: inviter.id,
+        name: inviter.name
+      } : nil,
+      expires_at: invitation.expires_at.iso8601(3),
+      accepted_at: invitation.accepted_at&.iso8601(3),
+      revoked_at: invitation.revoked_at&.iso8601(3),
+      created_at: invitation.created_at.iso8601(3),
+      updated_at: invitation.updated_at.iso8601(3)
+    }
+  end
+
+  def serialize_invitation_preview(invitation)
+    account = invitation.account
+    {
+      email: invitation.email,
+      role: invitation.role,
+      account_name: account.name,
+      subdomain: account.subdomain,
+      expires_at: invitation.expires_at.iso8601(3),
+      account: serialize_portal(account)
+    }
+  end
+
+  def serialize_session(session, raw_token)
+    {
+      id: session.id,
+      token: raw_token,
+      created_at: session.created_at.iso8601(3)
+    }
+  end
+
+  def serialize_request(ticket)
+    {
+      id: ticket.id,
+      subject: ticket.subject,
+      status: ticket.status,
+      merged_into_id: ticket.merged_into_id,
+      requester_id: ticket.requester_id,
+      created_at: ticket.created_at.iso8601(3),
+      updated_at: ticket.public_updated_at.iso8601(3)
+    }
+  end
+
+  def serialize_ticket(ticket)
+    requester = ticket.requester
+    group = ticket.group
+    assignee = ticket.assignee
+    {
+      id: ticket.id,
+      subject: ticket.subject,
+      status: ticket.status,
+      priority: ticket.priority,
+      merged_into_id: ticket.merged_into_id,
+      requester_id: ticket.requester_id,
+      requester: {
+        id: requester.id,
+        name: requester.name,
+        email: requester.email
+      },
+      group_id: ticket.group_id,
+      group: group ? {
+        id: group.id,
+        name: group.name
+      } : nil,
+      assignee_id: ticket.assignee_id,
+      assignee: assignee ? {
+        id: assignee.id,
+        name: assignee.name
+      } : nil,
+      created_at: ticket.created_at.iso8601(3),
+      updated_at: ticket.updated_at.iso8601(3)
+    }
+  end
+
+  def serialize_comment(comment)
+    author = comment.author
+    {
+      id: comment.id,
+      body: comment.body,
+      public: comment.public,
+      author_id: comment.author_id,
+      author: {
+        id: author.id,
+        name: author.name
+      },
+      created_at: comment.created_at.iso8601(3)
+    }
+  end
+end
