+  validates :public, inclusion: { in: [ true, false ] }
+  validates :email_message_id, uniqueness: true, allow_nil: true
+  validate :ticket_belongs_to_account
+  validate :author_belongs_to_account
+  validate :ticket_must_not_be_closed, on: :create
+
+  after_create :touch_ticket_timestamps
+
+  scope :public_only, -> { where(public: true) }
+  scope :oldest_first, -> { order(created_at: :asc, id: :asc) }
