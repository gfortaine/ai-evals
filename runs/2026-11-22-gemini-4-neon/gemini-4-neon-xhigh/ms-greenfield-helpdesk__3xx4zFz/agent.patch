+++ b/app/models/group_membership.rb
@@ -0,0 +1,34 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :account
+  belongs_to :group, inverse_of: :group_memberships
+  belongs_to :user, inverse_of: :group_memberships
+
+  validates :default, inclusion: { in: [ true, false ] }
+  validates :user_id, uniqueness: { scope: :group_id, message: "is already a member of this group" }
+  validate :group_belongs_to_account
+  validate :user_must_be_staff_in_account
+
+  scope :by_id_asc, -> { order(id: :asc) }
+  scope :default_only, -> { where(default: true) }
+  scope :for_group, ->(group_id) { where(group_id: group_id) }
+  scope :for_user, ->(user_id) { where(user_id: user_id) }
+
+  private
+
+  def group_belongs_to_account
+    return unless account_id.present? && group.present?
+    return if group.account_id == account_id
+
+    errors.add(:group, "must belong to the same account")
+  end
+
+  def user_must_be_staff_in_account
+    return unless account_id.present? && user.present?
+
+    if user.account_id != account_id
+      errors.add(:user, "must belong to the same account")
+    elsif !user.staff?
+      errors.add(:user, "must be a staff member")
+    end
+  end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..958e5a5
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,98 @@
+require "digest"
+require "securerandom"
+
+class Invitation < ApplicationRecord
+  INVITABLE_ROLES = User::STAFF_ROLES
+  STATUSES = %w[pending accepted revoked expired].freeze
+  TTL = 7.days
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true, inverse_of: :sent_invitations
+  belongs_to :accepted_user, class_name: "User", optional: true
+
+  normalizes :email, with: ->(email) { email.to_s.strip.downcase }
+
+  validates :email,
+            presence: true,
+            length: { maximum: 255 },
+            format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, presence: true, inclusion: { in: INVITABLE_ROLES }
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+  validate :invited_by_belongs_to_account
+  validate :accepted_user_belongs_to_account
+
+  scope :by_id_asc, -> { order(id: :asc) }
+  scope :pending, ->(now = Time.current) { where(accepted_at: nil, revoked_at: nil).where("expires_at > ?", now) }
+  scope :accepted, -> { where.not(accepted_at: nil) }
+  scope :revoked, -> { where(accepted_at: nil).where.not(revoked_at: nil) }
+  scope :expired, ->(now = Time.current) { where(accepted_at: nil, revoked_at: nil).where("expires_at <= ?", now) }
+
+  def self.with_status(status, now = Time.current)
+    case status
+    when "pending" then pending(now)
+    when "accepted" then accepted
+    when "revoked" then revoked
+    when "expired" then expired(now)
+    else none
+    end
+  end
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token)
+  end
+
+  def self.generate_token
+    raw_token = SecureRandom.urlsafe_base64(32)
+    [ raw_token, digest(raw_token) ]
+  end
+
+  def self.find_pending_by_token(account:, raw_token:, now: Time.current)
+    return nil unless account.present? && raw_token.is_a?(String) && raw_token.present?
+
+    pending(now).includes(:account).find_by(
+      account_id: account.id,
+      token_digest: digest(raw_token)
+    )
+  end
+
+  def accepted?
+    accepted_at.present?
+  end
+
+  def revoked?
+    !accepted? && revoked_at.present?
+  end
+
+  def expired?(now = Time.current)
+    !accepted? && !revoked? && expires_at <= now
+  end
+
+  def pending?(now = Time.current)
+    !accepted? && !revoked? && expires_at > now
+  end
+
+  def status(now = Time.current)
+    return "accepted" if accepted?
+    return "revoked" if revoked?
+    return "expired" if expired?(now)
+
+    "pending"
+  end
+
+  private
+
+  def invited_by_belongs_to_account
+    return unless account_id.present? && invited_by.present?
+    return if invited_by.account_id == account_id
+
+    errors.add(:invited_by, "must belong to the same account")
+  end
+
+  def accepted_user_belongs_to_account
+    return unless account_id.present? && accepted_user.present?
+    return if accepted_user.account_id == account_id
+
+    errors.add(:accepted_user, "must belong to the same account")
+  end
+end
diff --git a/app/models/session.rb b/app/models/session.rb
new file mode 100644
index 0000000..23d4701
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,43 @@
+require "digest"
+require "securerandom"
+
+class Session < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  validates :token_digest, presence: true, uniqueness: true
+
+  scope :active, -> { where(revoked_at: nil) }
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token)
+  end
+
+  def self.issue_for(user)
+    raw_token = SecureRandom.urlsafe_base64(32)
+    session = create!(
+      account: user.account,
+      user: user,
+      token_digest: digest(raw_token),
+      last_used_at: Time.current
+    )
+    [ session, raw_token ]
+  end
+
+  def self.authenticate(account:, raw_token:)
+    return nil unless account.present? && raw_token.is_a?(String) && raw_token.present?
+
+    session = active.includes(:user).find_by(account_id: account.id, token_digest: digest(raw_token))
+    return nil if session.nil? || session.user.suspended?
+
+    session
+  end
+
+  def active?
+    revoked_at.nil?
+  end
+
+  def revoke!
+    update!(revoked_at: Time.current) if active?
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..afddf73
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,185 @@
+require "securerandom"
+
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved closed].freeze
+  STAFF_EDITABLE_STATUSES = %w[open pending solved].freeze
+  PRIORITIES = %w[normal high].freeze
+  ORIGINS = %w[portal email].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User", inverse_of: :requested_tickets
+  belongs_to :group, optional: true, inverse_of: :tickets
+  belongs_to :assignee, class_name: "User", optional: true, inverse_of: :assigned_tickets
+  belongs_to :merged_into, class_name: "Ticket", optional: true, inverse_of: :merged_tickets
+  has_many :merged_tickets, class_name: "Ticket", foreign_key: :merged_into_id, dependent: :nullify, inverse_of: :merged_into
+  has_many :comments, class_name: "TicketComment", dependent: :destroy, inverse_of: :ticket
+
+  normalizes :subject, with: ->(subject) { subject.to_s.strip }
+
+  before_validation :ensure_reply_token, on: :create
+
+  validates :subject, presence: true, length: { maximum: 255 }
+  validates :status, presence: true, inclusion: { in: STATUSES }
+  validates :priority, presence: true, inclusion: { in: PRIORITIES }
+  validates :origin, presence: true, inclusion: { in: ORIGINS }
+  validates :reply_token, presence: true, uniqueness: true
+  validate :requester_belongs_to_account
+  validate :group_belongs_to_account, if: -> { group_id.present? || group.present? }
+  validate :assignee_must_be_active_staff_in_account, if: -> { assignee_id.present? && (new_record? || will_save_change_to_assignee_id?) }
+  validate :assignee_must_belong_to_group, if: -> { group_id.present? && assignee_id.present? }
+  validate :merged_into_integrity, if: -> { merged_into_id.present? || merged_into.present? }
+
+  before_create :set_initial_public_updated_at
+  before_update :update_public_updated_at_if_customer_visible
+
+  scope :recently_active, -> { order(updated_at: :desc, id: :desc) }
+  scope :public_recently_active, -> { order(public_updated_at: :desc, id: :desc) }
+  scope :for_requester, ->(user) { where(requester_id: user.id) }
+  scope :with_status, ->(status) { where(status: status) }
+  scope :with_priority, ->(priority) { where(priority: priority) }
+  scope :ungrouped, -> { where(group_id: nil) }
+  scope :in_group, ->(group_id) { where(group_id: group_id) }
+  scope :unassigned, -> { where(assignee_id: nil) }
+  scope :assigned_to, ->(user_id) { where(assignee_id: user_id) }
+  scope :requested_by, ->(user_id) { where(requester_id: user_id) }
+  scope :search_text, ->(query) {
+    return none if !query.is_a?(String) || query.include?("\x00") || !query.valid_encoding?
+
+    pattern = "%#{sanitize_sql_like(query)}%"
+    where(
+      <<~SQL.squish,
+        tickets.subject ILIKE :pattern ESCAPE '\\'
+        OR EXISTS (
+          SELECT 1
+          FROM ticket_comments
+          WHERE ticket_comments.ticket_id = tickets.id
+            AND ticket_comments.account_id = tickets.account_id
+            AND ticket_comments.public = TRUE
+            AND ticket_comments.body ILIKE :pattern ESCAPE '\\'
+        )
+      SQL
+      pattern: pattern
+    )
+  }
+
+  def open?
+    status == "open"
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def solved?
+    status == "solved"
+  end
+
+  def closed?
+    status == "closed"
+  end
+
+  def merged?
+    merged_into_id.present?
+  end
+
+  def normal_priority?
+    priority == "normal"
+  end
+
+  def high_priority?
+    priority == "high"
+  end
+
+  def email_origin?
+    origin == "email"
+  end
+
+  def reply_address
+    HelpdeskConfig.ticket_reply_address(self)
+  end
+
+  private
+
+  def ensure_reply_token
+    self.reply_token ||= SecureRandom.hex(16)
+  end
+
+  def set_initial_public_updated_at
+    now = updated_at || created_at || Time.current
+    self.created_at ||= now
+    self.updated_at ||= now
+    self.public_updated_at ||= now
+  end
+
+  def update_public_updated_at_if_customer_visible
+    if will_save_change_to_status? || will_save_change_to_subject? || will_save_change_to_merged_into_id?
+      now = Time.current
+      self.updated_at = now
+      self.public_updated_at = now
+    end
+  end
+
+  def requester_belongs_to_account
+    return unless account_id.present? && requester.present?
+    return if requester.account_id == account_id
+
+    errors.add(:requester, "must belong to the same account")
+  end
+
+  def group_belongs_to_account
+    return unless account_id.present?
+
+    if group.nil? || group.account_id != account_id
+      errors.add(:group_id, "must belong to the same account")
+    end
+  end
+
+  def assignee_must_be_active_staff_in_account
+    return unless account_id.present?
+
+    if assignee.nil?
+      errors.add(:assignee_id, "must be an active staff member in this account")
+    elsif assignee.account_id != account_id
+      errors.add(:assignee_id, "must belong to the same account")
+    elsif !assignee.staff?
+      errors.add(:assignee_id, "must be a staff member")
+    elsif assignee.suspended?
+      errors.add(:assignee_id, "must be an active staff member")
+    end
+  end
+
+  def assignee_must_belong_to_group
+    return unless account_id.present? && group.present? && assignee.present?
+    return unless group.account_id == account_id && assignee.account_id == account_id
+    return if GroupMembership.exists?(account_id: account_id, group_id: group_id, user_id: assignee_id)
+
+    errors.add(:assignee_id, "must belong to the ticket's group")
+  end
+
+  def merged_into_integrity
+    if merged_into.nil?
+      errors.add(:merged_into_id, "must be a valid ticket in this account")
+      return
+    end
+
+    if (id.present? && merged_into.id == id) || merged_into.equal?(self)
+      errors.add(:merged_into_id, "cannot reference the ticket itself")
+    end
+
+    if account_id.present? && merged_into.account_id != account_id
+      errors.add(:merged_into_id, "must belong to the same account")
+    end
+
+    if requester_id.present? && merged_into.requester_id != requester_id
+      errors.add(:merged_into_id, "must belong to the same customer")
+    end
+
+    if (new_record? || will_save_change_to_merged_into_id?) && merged_into.closed?
+      errors.add(:merged_into_id, "cannot reference a closed ticket")
+    end
+
+    unless closed?
+      errors.add(:status, "must be closed when merged into another ticket")
+    end
+  end
+end
