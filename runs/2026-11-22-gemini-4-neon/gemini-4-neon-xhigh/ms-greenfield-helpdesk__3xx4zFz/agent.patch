+++ b/test/integration/users_suspension_and_staff_test.rb
@@ -0,0 +1,366 @@
+require "test_helper"
+
+class UsersSuspensionAndStaffTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme_signup = signup_and_verify!(
+      name: "Acme",
+      subdomain: "acme",
+      admin_name: "Jo",
+      email: "jo@acme.test",
+      password: "my-first-password"
+    )
+    @owner_id = @acme_signup.dig("user", "id")
+    @owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    @agent_id = invite_and_accept!(subdomain: "acme", admin_token: @owner_token, email: "sam@acme.test", role: "agent", name: "Sam", password: "sam-password-1")
+    @agent_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password-1").dig("session", "token")
+
+    @admin2_id = invite_and_accept!(subdomain: "acme", admin_token: @owner_token, email: "alex@acme.test", role: "admin", name: "Alex", password: "alex-password-1")
+    @admin2_token = sign_in!(subdomain: "acme", email: "alex@acme.test", password: "alex-password-1").dig("session", "token")
+
+    @customer_data = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password-1")
+    @customer_id = @customer_data.dig("user", "id")
+    @customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "avery-password-1").dig("session", "token")
+
+    @globex_signup = signup_and_verify!(
+      name: "Globex",
+      subdomain: "globex",
+      admin_name: "Pat",
+      email: "pat@globex.test",
+      password: "globex-password-1"
+    )
+    @globex_owner_id = @globex_signup.dig("user", "id")
+    @globex_owner_token = sign_in!(subdomain: "globex", email: "pat@globex.test", password: "globex-password-1").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def invite_and_accept!(subdomain:, admin_token:, email:, role:, name:, password:)
+    post "/api/v1/invitations",
+         params: { invitation: { email: email, role: role } },
+         headers: json_headers(account: subdomain, token: admin_token),
+         as: :json
+    assert_response :created
+    _u, _a, token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: token, name: name, password: password } },
+         headers: json_headers(account: subdomain),
+         as: :json
+    assert_response :created
+    json_body.dig("user", "id")
+  end
+
+  test "admins can list, inspect, filter users by role and suspension, and staff lists active staff by ID ascending" do
+    # /me includes suspended: false
+    get "/api/v1/me", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal false, json_body.dig("user", "suspended")
+    assert_nil json_body.dig("user", "suspended_at")
+
+    # GET /users lists all account users ordered by ID ascending
+    get "/api/v1/users", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 4, json_body["count"]
+    assert_equal [ @owner_id, @agent_id, @admin2_id, @customer_id ], json_body["users"].map { |u| u["id"] }
+    assert json_body["users"].all? { |u| u["suspended"] == false }
+
+    # GET /users/:id inspects a single user
+    get "/api/v1/users/#{@agent_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal "Sam", json_body.dig("user", "name")
+    assert_equal "agent", json_body.dig("user", "role")
+    assert_equal false, json_body.dig("user", "suspended")
+
+    # Suspend agent Sam
+    patch "/api/v1/users/#{@agent_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "suspended")
+    assert json_body.dig("user", "suspended_at").present?
+
+    # Filter by role
+    get "/api/v1/users?role=admin", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ @owner_id, @admin2_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?role=agent", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ @agent_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?role=customer", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ @customer_id ], json_body["users"].map { |u| u["id"] }
+
+    # Filter by suspension
+    get "/api/v1/users?suspended=true", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ @agent_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?suspended=false", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ @owner_id, @admin2_id, @customer_id ], json_body["users"].map { |u| u["id"] }
+
+    # Combined filters
+    get "/api/v1/users?role=agent&suspended=false", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [], json_body["users"]
+
+    get "/api/v1/users?role=agent&suspended=true", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ @agent_id ], json_body["users"].map { |u| u["id"] }
+
+    # Invalid filter values -> 422; blank filter values ignored
+    get "/api/v1/users?role=bogus", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :unprocessable_content
+    get "/api/v1/users?suspended=maybe", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :unprocessable_content
+    get "/api/v1/users?role=&suspended=", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 4, json_body["count"]
+
+    # GET /staff lists ONLY active staff by ID ascending (excludes suspended Sam and customer Avery)
+    get "/api/v1/staff", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal [ @owner_id, @admin2_id ], json_body["staff"].map { |s| s["id"] }
+
+    # Unsuspend Sam -> Sam reappears in /staff in ID ascending order, and agent can access /staff
+    patch "/api/v1/users/#{@agent_id}",
+          params: { user: { suspended: false } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal false, json_body.dig("user", "suspended")
+    assert_nil json_body.dig("user", "suspended_at")
+
+    sam_new_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password-1").dig("session", "token")
+    get "/api/v1/staff", headers: json_headers(account: "acme", token: sam_new_token)
+    assert_response :ok
+    assert_equal 3, json_body["count"]
+    assert_equal [ @owner_id, @agent_id, @admin2_id ], json_body["staff"].map { |s| s["id"] }
+  end
+
+  test "suspension revokes sessions, blocks login and password reset, and clears ticket assignments without changing customer request" do
+    # Customer creates a request at T1
+    ticket_id = nil
+    request_before = nil
+
+    travel_to Time.zone.parse("2026-11-22 10:00:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Need help", comment: { body: "Details" } } },
+           headers: json_headers(account: "acme", token: @customer_token),
+           as: :json
+      assert_response :created
+      ticket_id = json_body.dig("request", "id")
+      request_before = json_body["request"]
+    end
+
+    # Assign ticket to Sam at T2
+    travel_to Time.zone.parse("2026-11-22 10:05:00 UTC") do
+      patch "/api/v1/tickets/#{ticket_id}",
+            params: { ticket: { assignee_id: @agent_id } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+      assert_equal @agent_id, json_body.dig("ticket", "assignee_id")
+      assert_equal({ "id" => @agent_id, "name" => "Sam" }, json_body.dig("ticket", "assignee"))
+    end
+
+    # Sam also has a second active session
+    agent_token_2 = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password-1").dig("session", "token")
+
+    # Suspend Sam at T3
+    travel_to Time.zone.parse("2026-11-22 10:10:00 UTC") do
+      patch "/api/v1/users/#{@agent_id}",
+            params: { user: { suspended: true } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+    end
+
+    # Both of Sam's sessions are revoked -> 401
+    get "/api/v1/me", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :unauthorized
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: agent_token_2)
+    assert_response :unauthorized
+
+    # Sam cannot sign in -> 403
+    post "/api/v1/sessions",
+         params: { session: { email: "sam@acme.test", password: "sam-password-1" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    # Password reset sends no email to suspended user
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/password_resets",
+           params: { password_reset: { email: "sam@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+    end
+
+    # Ticket assignment was cleared
+    get "/api/v1/tickets/#{ticket_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+
+    # Customer-facing request was NOT changed at all
+    get "/api/v1/requests/#{ticket_id}", headers: json_headers(account: "acme", token: @customer_token)
+    assert_response :ok
+    assert_equal request_before, json_body["request"]
+
+    # Cannot assign ticket to suspended Sam
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { assignee_id: @agent_id } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+
+    # Suspending a customer revokes their sessions and blocks login, but preserves their ticket
+    patch "/api/v1/users/#{@customer_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @customer_token)
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+         params: { session: { email: "avery@example.test", password: "avery-password-1" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{ticket_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal @customer_id, json_body.dig("ticket", "requester_id")
+  end
+
+  test "prevents suspending or demoting the last active admin" do
+    # Currently 2 active admins: owner (Jo) and admin2 (Alex).
+    # Owner suspends Alex -> succeeds!
+    patch "/api/v1/users/#{@admin2_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "suspended")
+
+    # Now Jo is the LAST active admin (Sam is an active agent, Alex is a suspended admin).
+    # Suspending Jo MUST fail with 422!
+    patch "/api/v1/users/#{@owner_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+
+    # Jo's session is still alive and Jo is not suspended
+    get "/api/v1/users/#{@owner_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal false, json_body.dig("user", "suspended")
+
+    # Demoting the last active admin to agent also fails with 422!
+    patch "/api/v1/users/#{@owner_id}",
+          params: { user: { role: "agent" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+
+    # Unsuspend Alex -> now 2 active admins again
+    patch "/api/v1/users/#{@admin2_id}",
+          params: { user: { suspended: false } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    alex_new_token = sign_in!(subdomain: "acme", email: "alex@acme.test", password: "alex-password-1").dig("session", "token")
+
+    # Alex suspends Jo -> succeeds because Alex is an active admin!
+    patch "/api/v1/users/#{@owner_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: alex_new_token),
+          as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "suspended")
+
+    # Now Alex is the LAST active admin -> Alex cannot suspend Alex!
+    patch "/api/v1/users/#{@admin2_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: alex_new_token),
+          as: :json
+    assert_response :unprocessable_content
+
+    # Globex has only 1 active admin (Pat) -> cannot suspend Pat!
+    patch "/api/v1/users/#{@globex_owner_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "globex", token: @globex_owner_token),
+          as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "enforces authorization, validation atomicity, mass assignment, and cross-tenant isolation on users and staff" do
+    # Agents cannot manage users (403); customers cannot access users or staff (403)
+    get "/api/v1/users", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :forbidden
+    get "/api/v1/users/#{@customer_id}", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :forbidden
+    patch "/api/v1/users/#{@customer_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: @agent_token),
+          as: :json
+    assert_response :forbidden
+
+    get "/api/v1/users", headers: json_headers(account: "acme", token: @customer_token)
+    assert_response :forbidden
+    get "/api/v1/staff", headers: json_headers(account: "acme", token: @customer_token)
+    assert_response :forbidden
+
+    # Cross-account access -> 404
+    get "/api/v1/users/#{@globex_owner_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :not_found
+    patch "/api/v1/users/#{@globex_owner_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :not_found
+
+    # Validation edge cases on PATCH /users/:id
+    [ "true", "false", 1, 0, nil, "yes", [] ].each do |bad_suspended|
+      patch "/api/v1/users/#{@agent_id}",
+            params: { user: { suspended: bad_suspended } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content, "Expected 422 for suspended=#{bad_suspended.inspect}"
+    end
+
+    # Empty envelope -> 400; only unpermitted fields -> 422 and no mutation
+    patch "/api/v1/users/#{@agent_id}",
+          params: { user: {} },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :bad_request
+
+    patch "/api/v1/users/#{@agent_id}",
+          params: { user: { email: "hacked@acme.test", owner: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+    assert_equal "sam@acme.test", User.find(@agent_id).email
+
+    # Atomicity: blank name + suspended: true -> rolls back without suspending or revoking sessions!
+    patch "/api/v1/users/#{@agent_id}",
+          params: { user: { name: "   ", suspended: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+    assert_not User.find(@agent_id).suspended?
+    get "/api/v1/me", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+  end
+end
