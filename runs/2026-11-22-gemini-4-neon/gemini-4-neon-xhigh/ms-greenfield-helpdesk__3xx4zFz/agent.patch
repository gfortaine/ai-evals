+             subdomain: "acme",
+             admin: {
+               name: "Jo",
+               email: "jo@acme.test",
+               password: "my-first-password"
+             }
+           }
+         },
+         as: :json
+
+    assert_response :created
+    body = json_body
+
+    assert_kind_of Integer, body.dig("account", "id")
+    assert_equal "Acme", body.dig("account", "name")
+    assert_equal "acme", body.dig("account", "subdomain")
+    assert_equal "active", body.dig("account", "status")
+    assert body.dig("account", "created_at").present?
+    assert body.dig("account", "updated_at").present?
+
+    assert_kind_of Integer, body.dig("user", "id")
+    assert_equal body.dig("account", "id"), body.dig("user", "account_id")
+    assert_equal "Jo", body.dig("user", "name")
+    assert_equal "jo@acme.test", body.dig("user", "email")
+    assert_equal "admin", body.dig("user", "role")
+    assert_equal true, body.dig("user", "owner")
+    assert_equal false, body.dig("user", "verified")
+    assert_nil body.dig("user", "verified_at")
+    assert body.dig("user", "created_at").present?
+    assert body.dig("user", "updated_at").present?
+    assert_not body["user"].key?("password_digest")
+
+    # 2. Verification email sent with defaults
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], mail.from
+    assert_equal [ "jo@acme.test" ], mail.to
+
+    url, acct_param, first_token = extract_token_from_mail(mail, path: "/verify-email")
+    assert url.start_with?("http://localhost:3001/verify-email?account=acme&token=")
+    assert_equal "acme", acct_param
+    assert first_token.present?
+
+    # 3. Public portal works without auth
+    get "/api/v1/portal", headers: json_headers(account: "acme")
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_body)
+
+    # Case-insensitive account header
+    get "/api/v1/portal", headers: json_headers(account: "ACME")
+    assert_response :ok
+
+    # Missing or unknown account header
+    get "/api/v1/portal"
+    assert_response :bad_request
+    get "/api/v1/portal", headers: json_headers(account: "nonexistent")
+    assert_response :not_found
+
+    # 4. Cannot sign in before verifying email
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    # 5. Request a replacement verification link; old link must stop working
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "jo@acme.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    _url2, _acct2, second_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+    assert_not_equal first_token, second_token
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: first_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: second_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+    assert json_body.dig("user", "verified_at").present?
+
+    # Cannot reuse verification token
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: second_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Requesting verification link for already verified user sends no email
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/email_verifications",
+           params: { email_verification: { email: "jo@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+    end
+
+    # 6. Sign in with wrong password fails
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "wrong-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unauthorized
+
+    # 7. Sign in twice (two sessions)
+    login1 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token1 = login1.dig("session", "token")
+    assert token1.present?
+    assert_equal "Jo", login1.dig("user", "name")
+    assert_equal "acme", login1.dig("account", "subdomain")
+
+    login2 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token2 = login2.dig("session", "token")
+    assert_not_equal token1, token2
+
+    # 8. Authenticated GET /account and GET /me
+    get "/api/v1/account", headers: json_headers(account: "acme", token: token1)
+    assert_response :ok
+    assert_equal body.dig("account", "id"), json_body.dig("account", "id")
+    assert_equal "Acme", json_body.dig("account", "name")
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token1)
+    assert_response :ok
+    assert_equal "Jo", json_body.dig("user", "name")
+
+    # Unauthenticated GET /account and GET /me
+    get "/api/v1/account", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+    get "/api/v1/me", headers: json_headers(account: "acme", token: "bogus-token")
+    assert_response :unauthorized
+
+    # 9. Update profile via PATCH /me (and ignore unauthorized fields)
+    patch "/api/v1/me",
+          params: { user: { name: "Jo Smith", role: "customer", email: "hacked@acme.test" } },
+          headers: json_headers(account: "acme", token: token1),
+          as: :json
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+    assert_equal "admin", json_body.dig("user", "role")
+    assert_equal "jo@acme.test", json_body.dig("user", "email")
+
+    # Blank name rejected
+    patch "/api/v1/me",
+          params: { user: { name: "   " } },
+          headers: json_headers(account: "acme", token: token1),
+          as: :json
+    assert_response :unprocessable_content
+
+    # 10. Sign out session 1; session 2 stays valid
+    delete "/api/v1/session", headers: json_headers(account: "acme", token: token1)
+    assert_response :no_content
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token1)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token2)
+    assert_response :ok
+
+    # 11. Change password via PUT /me/password
+    # Create another session so we verify ALL existing sessions are signed out
+    token3 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Wrong current password fails and keeps sessions active
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+        headers: json_headers(account: "acme", token: token2),
+        as: :json
+    assert_response :unprocessable_content
+
+    # Short new password fails and keeps sessions active
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "short" } },
+        headers: json_headers(account: "acme", token: token2),
+        as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token2)
+    assert_response :ok
+
+    # Valid password change succeeds and signs out ALL existing sessions
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+        headers: json_headers(account: "acme", token: token2),
+        as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token2)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token3)
+    assert_response :unauthorized
+
+    # Old password fails, new password succeeds
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unauthorized
+
+    new_login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+    assert new_login.dig("session", "token").present?
+  end
+
+  test "signup respects HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://app.helpdesk.test/", "HELPDESK_MAIL_FROM" => "noreply@helpdesk.test") do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Café Support",
+               subdomain: "cafe",
+               admin: {
+                 name: "Ana",
+                 email: "ana@cafe.test",
+                 password: "my-first-password"
+               }
+             }
+           },
+           as: :json
+
+      assert_response :created
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "noreply@helpdesk.test" ], mail.from
+      url, acct, token = extract_token_from_mail(mail, path: "/verify-email")
+      assert url.start_with?("https://app.helpdesk.test/verify-email?account=cafe&token=")
+      assert_equal "cafe", acct
+      assert mail.encoded.include?(url), "Expected raw encoded email to contain unwrapped URL"
+      assert token.present?
+    end
+  end
+
+  test "signup validations are atomic and reject duplicate subdomains and malformed payloads" do
+    signup_and_verify!(subdomain: "acme")
+
+    # Duplicate subdomain (case-insensitive)
+    assert_no_difference [ "Account.count", "User.count" ] do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Acme Two",
+               subdomain: "ACME",
+               admin: { name: "Bob", email: "bob@acme2.test", password: "my-first-password" }
+             }
+           },
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Valid account but invalid admin rolls back account creation
+    assert_no_difference [ "Account.count", "User.count" ] do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Beta",
+               subdomain: "beta",
+               admin: { name: "Bob", email: "not-an-email", password: "123" }
+             }
+           },
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Invalid subdomain format
+    assert_no_difference [ "Account.count", "User.count" ] do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Bad Sub",
+               subdomain: "-bad_sub-",
+               admin: { name: "Bob", email: "bob@bad.test", password: "my-first-password" }
+             }
+           },
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Non-hash envelope returns 400
+    post "/api/v1/account/create", params: { account: "invalid" }, as: :json
+    assert_response :bad_request
+  end
+
+  test "expired verification token is rejected" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+    _url, _acct, token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    travel 25.hours do
+      post "/api/v1/email_verifications/confirm",
+           params: { email_verification: { token: token } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+    end
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
index 0000000..d1c2c44
--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  test "allows configured default frontend origin and rejects unknown origins" do
+    signup_and_verify!(subdomain: "acme")
+
+    # Preflight from default origin
+    options "/api/v1/sessions",
+            headers: {
+              "Origin" => "http://localhost:3001",
+              "Access-Control-Request-Method" => "POST",
+              "Access-Control-Request-Headers" => "Content-Type, Authorization, X-Helpdesk-Account"
+            }
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Methods"], "POST"
+    assert_includes response.headers["Access-Control-Allow-Headers"], "X-Helpdesk-Account"
+
+    # Regular GET request from allowed origin
+    get "/api/v1/portal",
+        headers: json_headers(account: "acme", extra: { "Origin" => "http://localhost:3001" })
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    # Error response from allowed origin still includes CORS header
+    get "/api/v1/me",
+        headers: json_headers(account: "acme", extra: { "Origin" => "http://localhost:3001" })
+    assert_response :unauthorized
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    # Disallowed origin does NOT receive Access-Control-Allow-Origin
+    get "/api/v1/portal",
+        headers: json_headers(account: "acme", extra: { "Origin" => "https://evil.example.test" })
+    assert_response :ok
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+  end
+
+  test "respects custom HELPDESK_FRONTEND_URL origin including paths or trailing slashes" do
+    signup_and_verify!(subdomain: "acme")
+
+    with_env("HELPDESK_FRONTEND_URL" => "https://frontend.example.test/app/") do
+      get "/api/v1/portal",
+          headers: json_headers(account: "acme", extra: { "Origin" => "https://frontend.example.test" })
+      assert_response :ok
+      assert_equal "https://frontend.example.test", response.headers["Access-Control-Allow-Origin"]
+
+      get "/api/v1/portal",
+          headers: json_headers(account: "acme", extra: { "Origin" => "http://localhost:3001" })
+      assert_response :ok
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+end
diff --git a/test/integration/cursor_pagination_test.rb b/test/integration/cursor_pagination_test.rb
new file mode 100644
index 0000000..9ca6542
--- /dev/null
+++ b/test/integration/cursor_pagination_test.rb
@@ -0,0 +1,950 @@
+require "test_helper"
+require "uri"
+require "cgi"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    signup_and_verify!(
+      name: "Acme",
+      subdomain: "acme",
+      admin_name: "Jo",
+      email: "jo@acme.test",
+      password: "my-first-password"
+    )
+    @owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    register_and_verify_customer!(
+      subdomain: "acme",
+      name: "Avery",
+      email: "avery@example.test",
+      password: "avery-password-1"
+    )
+    @avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "avery-password-1").dig("session", "token")
+
+    register_and_verify_customer!(
+      subdomain: "acme",
+      name: "Blake",
+      email: "blake@example.test",
+      password: "blake-password-1"
+    )
+    @blake_token = sign_in!(subdomain: "acme", email: "blake@example.test", password: "blake-password-1").dig("session", "token")
+
+    @account = Account.find_by!(subdomain: "acme")
+    @owner = @account.users.find_by!(email: "jo@acme.test")
+    @avery = @account.users.find_by!(email: "avery@example.test")
+    @blake = @account.users.find_by!(email: "blake@example.test")
+  end
+
+  test "empty collections return exact cursor pagination contract while offset API remains unchanged" do
+    # Exact prompt example: GET /api/v1/tickets?page[size]=25&status=open
+    get "/api/v1/tickets?page[size]=25&status=open", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal(
+      {
+        "tickets" => [],
+        "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+        "links" => { "next" => nil, "prev" => nil }
+      },
+      json_body
+    )
+
+    # Empty requests
+    get "/api/v1/requests?page[size]=25", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal(
+      {
+        "requests" => [],
+        "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+        "links" => { "next" => nil, "prev" => nil }
+      },
+      json_body
+    )
+
+    # Empty invitations, groups, group_memberships
+    [
+      [ "/api/v1/invitations?page[size]=10", "invitations" ],
+      [ "/api/v1/groups?page[size]=10", "groups" ],
+      [ "/api/v1/group_memberships?page[size]=10", "group_memberships" ]
+    ].each do |path, key|
+      get path, headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal(
+        {
+          key => [],
+          "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+          "links" => { "next" => nil, "prev" => nil }
+        },
+        json_body
+      )
+    end
+
+    # Existing page-number API stays 100% identical (no meta/links)
+    get "/api/v1/tickets?status=open", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal(
+      { "tickets" => [], "count" => 0, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+      json_body
+    )
+  end
+
+  test "tickets forward and backward navigation via links and manual cursors, exact multiples, partial pages, and page size changes" do
+    base = Time.utc(2026, 11, 22, 10, 0, 0)
+    tickets = (1..7).map { |i| create_ticket(requester: @avery, subject: "Ticket #{i}", at: base + i.minutes) }
+    expected_ids = tickets.reverse.map(&:id) # newest first: [t7, t6, t5, t4, t3, t2, t1]
+
+    # Page 1: page[size]=3
+    get "/api/v1/tickets?page[size]=3", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    p1 = json_body
+    assert_equal %w[links meta tickets], p1.keys.sort
+    assert_equal expected_ids[0, 3], p1["tickets"].map { |t| t["id"] }
+    assert_equal true, p1.dig("meta", "has_more")
+    assert p1.dig("meta", "before_cursor").present?
+    assert p1.dig("meta", "after_cursor").present?
+    assert p1.dig("links", "next").present?
+    assert_nil p1.dig("links", "prev")
+
+    # Follow links.next -> Page 2
+    get p1.dig("links", "next"), headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    p2 = json_body
+    assert_equal expected_ids[3, 3], p2["tickets"].map { |t| t["id"] }
+    assert_equal true, p2.dig("meta", "has_more")
+    assert p2.dig("links", "next").present?
+    assert p2.dig("links", "prev").present?
+
+    # Follow links.next -> Page 3 (single record!)
+    get p2.dig("links", "next"), headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    p3 = json_body
+    assert_equal expected_ids[6, 1], p3["tickets"].map { |t| t["id"] }
+    assert_equal false, p3.dig("meta", "has_more")
+    assert p3.dig("meta", "before_cursor").present?
+    assert p3.dig("meta", "after_cursor").present?
+    assert_equal p3.dig("meta", "before_cursor"), p3.dig("meta", "after_cursor")
+    assert_nil p3.dig("links", "next")
+    assert p3.dig("links", "prev").present?
+
+    # Manually polling after the last record returns empty page
+    get "/api/v1/tickets?page[size]=3&page[after]=#{CGI.escape(p3.dig('meta', 'after_cursor'))}",
+        headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal(
+      {
+        "tickets" => [],
+        "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+        "links" => { "next" => nil, "prev" => nil }
+      },
+      json_body
+    )
+
+    # Walk BACKWARD from Page 3 -> Page 2 via links.prev
+    get p3.dig("links", "prev"), headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    back_p2 = json_body
+    assert_equal expected_ids[3, 3], back_p2["tickets"].map { |t| t["id"] }
+    assert_equal true, back_p2.dig("meta", "has_more") # more records exist in backward direction (p1)
+    assert back_p2.dig("links", "prev").present?
+    assert back_p2.dig("links", "next").present?
+
+    # Walk BACKWARD from Page 2 -> Page 1 via links.prev
+    get back_p2.dig("links", "prev"), headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    back_p1 = json_body
+    assert_equal expected_ids[0, 3], back_p1["tickets"].map { |t| t["id"] }
+    assert_equal false, back_p1.dig("meta", "has_more") # reached the beginning!
+    assert_nil back_p1.dig("links", "prev")
+    assert back_p1.dig("links", "next").present?
+
+    # Manually polling before the first record returns empty page
+    get "/api/v1/tickets?page[size]=3&page[before]=#{CGI.escape(back_p1.dig('meta', 'before_cursor'))}",
+        headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_nil json_body.dig("meta", "before_cursor")
+    assert_nil json_body.dig("meta", "after_cursor")
+    assert_nil json_body.dig("links", "next")
+    assert_nil json_body.dig("links", "prev")
+
+    # Manual cursor + changing page[size] mid-traversal
+    get "/api/v1/tickets?page[size]=2&page[after]=#{CGI.escape(p1.dig('meta', 'after_cursor'))}",
+        headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
