+
+      assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+        assert_difference "Ticket.count", 1 do
+          post_raw_email(build_raw_email(from: "existing@example.test", subject: "Portal user emails", body: "Hello from mail"))
+        end
