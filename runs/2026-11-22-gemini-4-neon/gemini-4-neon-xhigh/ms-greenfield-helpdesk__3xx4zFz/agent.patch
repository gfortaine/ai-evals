+
+  test "group memberships lifecycle, defaults, make_default, filtering, and promotion on deletion" do
+    billing = create_group!(name: "Billing")
+    support = create_group!(name: "Technical Support")
+    escalations = create_group!(name: "Escalations")
+
+    # Empty list metadata
+    get "/api/v1/group_memberships", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal(
+      { "group_memberships" => [], "count" => 0, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+      json_body
+    )
+
+    # First membership for Sam: even with default: false, must become default: true
