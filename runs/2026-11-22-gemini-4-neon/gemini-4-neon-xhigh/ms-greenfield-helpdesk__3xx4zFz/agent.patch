+
+  def invite_and_accept!(subdomain:, admin_token:, email:, role:, name:, password:)
+    post "/api/v1/invitations",
+         params: { invitation: { email: email, role: role } },
+         headers: json_headers(account: subdomain, token: admin_token),
+         as: :json
+    assert_response :created
+    _u, _a, token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: token, name: name, password: password } },
+         headers: json_headers(account: subdomain),
+         as: :json
+    assert_response :created
+    json_body.dig("user", "id")
+  end
+
+  def create_group!(name:, account: "acme", token: @owner_token)
+    post "/api/v1/groups",
+         params: { group: { name: name } },
+         headers: json_headers(account: account, token: token),
+         as: :json
+    assert_response :created
+    json_body["group"]
+  end
+
+  def create_membership!(group_id:, user_id:, default: :omitted, account: "acme", token: @owner_token)
+    attrs = { group_id: group_id, user_id: user_id }
+    attrs[:default] = default unless default == :omitted
+    post "/api/v1/group_memberships",
+         params: { group_membership: attrs },
+         headers: json_headers(account: account, token: token),
+         as: :json
+    assert_response :created
+    json_body["group_membership"]
+  end
+
+  test "admins can create, list, show, rename, and delete groups; staff can browse; ordered by ID ascending" do
+    # Empty list metadata
+    get "/api/v1/groups", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal(
+      { "groups" => [], "count" => 0, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+      json_body
+    )
+
+    billing = create_group!(name: "  Billing  ")
+    assert_equal "Billing", billing["name"]
+    assert billing["id"].positive?
+    assert billing["created_at"].present?
+    assert billing["updated_at"].present?
+
+    support = create_group!(name: "Technical Support")
+    sales = create_group!(name: "Sales")
+
+    # Duplicate name (case-insensitive) in same account fails 422
+    post "/api/v1/groups",
+         params: { group: { name: "  billing  " } },
+         headers: json_headers(account: "acme", token: @owner_token),
+         as: :json
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "name").present?
+
+    # Same name in another account succeeds
+    globex_billing = create_group!(name: "Billing", account: "globex", token: @globex_owner_token)
+    assert_equal "Billing", globex_billing["name"]
+
+    # Staff (agent) can list groups ordered by ID ascending and inspect detail
+    get "/api/v1/groups", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal 3, json_body["count"]
+    assert_equal [ billing["id"], support["id"], sales["id"] ], json_body["groups"].map { |g| g["id"] }
+    assert_equal [ "Billing", "Technical Support", "Sales" ], json_body["groups"].map { |g| g["name"] }
+
+    # Pagination
+    get "/api/v1/groups?page=1&per_page=2", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal 3, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal [ billing["id"], support["id"] ], json_body["groups"].map { |g| g["id"] }
+
+    get "/api/v1/groups?page=2&per_page=2", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ sales["id"] ], json_body["groups"].map { |g| g["id"] }
+    assert_nil json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+
+    # Show detail
+    get "/api/v1/groups/#{billing['id']}", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal "Billing", json_body.dig("group", "name")
+
+    # Admin renames group
+    patch "/api/v1/groups/#{billing['id']}",
+          params: { group: { name: "  Billing & Invoices  " } },
+          headers: json_headers(account: "acme", token: @admin2_token),
+          as: :json
+    assert_response :ok
