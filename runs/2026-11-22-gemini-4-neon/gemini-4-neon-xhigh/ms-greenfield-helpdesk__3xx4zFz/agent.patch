+
+  test "extracts plain-text body from multipart/alternative, handles charsets, attachments, HTML-only, and missing subject" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      # Multipart/alternative with text/plain + text/html + text/plain attachment
+      multipart_raw = <<~EML
+        Message-ID: <multipart-1@example.test>
+        From: =?UTF-8?B?SsO2cmcgTcO8bGxlcg==?= <jorg@example.test>
+        To: acme@support.example.test
+        Subject: =?UTF-8?B?Q2Fmw6kgaXNzdWU=?=
+        MIME-Version: 1.0
+        Content-Type: multipart/mixed; boundary="outer"
+
+        --outer
+        Content-Type: multipart/alternative; boundary="inner"
+
+        --inner
+        Content-Type: text/plain; charset=UTF-8
+        Content-Transfer-Encoding: quoted-printable
+
+        Caf=C3=A9 receipt is missing.
+        --inner
+        Content-Type: text/html; charset=UTF-8
+
+        <p><b>HTML version should not be preferred</b></p>
+        --inner--
+        --outer
+        Content-Type: text/plain; charset=UTF-8; name="log.txt"
+        Content-Disposition: attachment; filename="log.txt"
+
+        ATTACHMENT CONTENT
+        --outer--
+      EML
+
+      post_raw_email(multipart_raw)
