diff --git a/lib/helpdesk_config.rb b/lib/helpdesk_config.rb
new file mode 100644
index 0000000..91a3a4a
--- /dev/null
+++ b/lib/helpdesk_config.rb
@@ -0,0 +1,57 @@
+require "uri"
+
+module HelpdeskConfig
+  DEFAULT_FRONTEND_URL = "http://localhost:3001"
+  DEFAULT_MAIL_FROM = "support@example.test"
+  DEFAULT_SUPPORT_DOMAIN = "support.example.test"
+
+  module_function
+
+  def frontend_url
+    raw = ENV["HELPDESK_FRONTEND_URL"].to_s.strip
+    url = raw.empty? ? DEFAULT_FRONTEND_URL : raw
+    url.chomp("/")
+  end
+
+  def frontend_origin
+    uri = URI.parse(frontend_url)
+    return frontend_url unless uri.scheme && uri.host
+
+    default_port = uri.scheme == "https" ? 443 : 80
+    origin = "#{uri.scheme}://#{uri.host}"
+    origin += ":#{uri.port}" if uri.port && uri.port != default_port
+    origin
+  rescue URI::InvalidURIError
+    frontend_url
+  end
+
+  def mail_from
+    raw = ENV["HELPDESK_MAIL_FROM"].to_s.strip
+    raw.empty? ? DEFAULT_MAIL_FROM : raw
+  end
+
+  def support_domain
+    raw = ENV["HELPDESK_SUPPORT_DOMAIN"].to_s.strip.downcase
+    raw.empty? ? DEFAULT_SUPPORT_DOMAIN : raw
+  end
+
+  def support_address(account)
+    "#{account.subdomain}@#{support_domain}"
+  end
+
+  def ticket_reply_address(ticket)
+    "#{ticket.account.subdomain}+#{ticket.reply_token}@#{support_domain}"
+  end
+
+  def verify_email_url(account:, token:)
+    "#{frontend_url}/verify-email?account=#{URI.encode_www_form_component(account.subdomain)}&token=#{URI.encode_www_form_component(token)}"
+  end
+
+  def reset_password_url(account:, token:)
+    "#{frontend_url}/reset-password?account=#{URI.encode_www_form_component(account.subdomain)}&token=#{URI.encode_www_form_component(token)}"
+  end
+
+  def accept_invitation_url(account:, token:)
+    "#{frontend_url}/accept-invitation?account=#{URI.encode_www_form_component(account.subdomain)}&token=#{URI.encode_www_form_component(token)}"
+  end
+end
