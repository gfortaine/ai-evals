@@ -0,0 +1,77 @@
+module Api
+  module V1
+    class GroupsController < BaseController
+      before_action :require_authentication!
+      before_action :require_active_account!
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, only: %i[create update destroy]
+
+      def index
+        scope = current_account.groups.by_id_asc
+        payload = paginate_collection(
+          scope,
+          key: :groups,
+          cursor_context: "groups:#{current_account.id}",
+          cursor_order: [ [ :id, :asc ] ]
+        ) { |group| serialize_group(group) }
+        render json: payload, status: :ok
+      end
+
+      def show
+        group = find_group!
+        render json: { group: serialize_group(group) }, status: :ok
+      end
+
+      def create
+        group_envelope = require_hash_param(:group)
+        raw_name = group_envelope[:name]
+        if !raw_name.nil? && !raw_name.is_a?(String)
+          return render_validation_errors({ name: [ "Name must be a string" ] })
+        end
+
+        group = Group.new(account: current_account, name: raw_name)
+        if group.save
+          render json: { group: serialize_group(group) }, status: :created
+        else
+          render_model_errors(group)
+        end
+      rescue ActiveRecord::RecordNotUnique
+        render_validation_errors({ name: [ "Name has already been taken" ] })
+      end
+
+      def update
+        group = find_group!
+        group_envelope = require_hash_param(:group)
+
+        unless group_envelope.key?(:name)
+          return render_validation_errors({ base: [ "Provide name to update" ] })
+        end
+
+        raw_name = group_envelope[:name]
+        if !raw_name.nil? && !raw_name.is_a?(String)
+          return render_validation_errors({ name: [ "Name must be a string" ] })
+        end
+
+        if group.update(name: raw_name)
+          render json: { group: serialize_group(group) }, status: :ok
+        else
+          render_model_errors(group)
+        end
+      rescue ActiveRecord::RecordNotUnique
+        render_validation_errors({ name: [ "Name has already been taken" ] })
+      end
+
+      def destroy
+        group = find_group!
+        GroupDeletion.new(account: current_account, group: group).call
+        head :no_content
+      end
+
+      private
+
+      def find_group!
+        current_account.groups.find(parse_id_param(:id))
+      end
+    end
+  end
+end
