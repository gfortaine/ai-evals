+        headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal true, json_body.dig("group_membership", "default")
+
+    # Deleting default membership of suspended staff promotes another remaining membership!
+    delete "/api/v1/group_memberships/#{m2["id"]}",
+           headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :no_content
+
+    get "/api/v1/group_memberships?user_id=#{@agent_id}",
+        headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ m1["id"], m3["id"] ], json_body["group_memberships"].map { |m| m["id"] }
+    assert_equal [ true, false ], json_body["group_memberships"].map { |m| m["default"] }
+
+    # Deleting the group of suspended staff's default membership promotes remaining membership!
