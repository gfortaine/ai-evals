+    end
+
+    # Filter by status=open -> only Avery's open requests, ordered by public_updated_at DESC (open_normal before open_high!)
+    get "/api/v1/requests?status=open", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal [ open_normal["id"], open_high["id"] ], json_body["requests"].map { |r| r["id"] }
+    json_body["requests"].each { |r| assert_not r.key?("priority") }
+
+    # Pagination with status filter
+    get "/api/v1/requests?status=open&page=1&per_page=1", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+    assert_equal [ open_normal["id"] ], json_body["requests"].map { |r| r["id"] }
+
+    # Case-insensitive status filters
+    get "/api/v1/requests?status=PENDING", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [ pending_req["id"] ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests?status=solved", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [ solved_req["id"] ], json_body["requests"].map { |r| r["id"] }
+
+    # Blank status returns all of Avery's requests (never Blake's)
+    get "/api/v1/requests?status=", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 4, json_body["count"]
+    assert_not_includes json_body["requests"].map { |r| r["id"] }, blake_open["id"]
+
+    # Invalid status returns 422
+    [ "/api/v1/requests?status=archived", "/api/v1/requests?status=bogus", "/api/v1/requests?status[]=open" ].each do |path|
+      get path, headers: json_headers(account: "acme", token: @avery_token)
+      assert_response :unprocessable_content, "Expected 422 for #{path}"
+    end
+
+    # Internal/staff-only params are ignored on /requests (never leak priority, assignee, or other requesters)
+    get "/api/v1/requests?priority=high", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 4, json_body["count"]
+
+    get "/api/v1/requests?status=open&priority=high", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal [ open_normal["id"], open_high["id"] ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests?priority=bogus&assignee_id=unassigned&requester_id=#{@blake_id}&q=Blake",
+        headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 4, json_body["count"]
+    assert_not_includes json_body["requests"].map { |r| r["id"] }, blake_open["id"]
+  end
+end
diff --git a/test/integration/tickets_authorization_and_isolation_test.rb b/test/integration/tickets_authorization_and_isolation_test.rb
new file mode 100644
index 0000000..4a48a20
--- /dev/null
+++ b/test/integration/tickets_authorization_and_isolation_test.rb
@@ -0,0 +1,220 @@
+require "test_helper"
+
+class TicketsAuthorizationAndIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    signup_and_verify!(name: "Globex", subdomain: "globex", admin_name: "Pat", email: "pat@globex.test", password: "globex-password-1")
+
+    @acme_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    @globex_owner_token = sign_in!(subdomain: "globex", email: "pat@globex.test", password: "globex-password-1").dig("session", "token")
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password-1")
+    register_and_verify_customer!(subdomain: "acme", name: "Blake", email: "blake@example.test", password: "blake-password-1")
+    register_and_verify_customer!(subdomain: "globex", name: "Casey", email: "casey@example.test", password: "casey-password-1")
+
+    @avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "avery-password-1").dig("session", "token")
+    @blake_token = sign_in!(subdomain: "acme", email: "blake@example.test", password: "blake-password-1").dig("session", "token")
+    @casey_token = sign_in!(subdomain: "globex", email: "casey@example.test", password: "casey-password-1").dig("session", "token")
+
+    post "/api/v1/requests",
+         params: { request: { subject: "Avery issue", comment: { body: "Avery details" } } },
+         headers: json_headers(account: "acme", token: @avery_token),
+         as: :json
+    assert_response :created
+    @avery_ticket_id = json_body.dig("request", "id")
+
+    post "/api/v1/requests",
+         params: { request: { subject: "Blake issue", comment: { body: "Blake details" } } },
+         headers: json_headers(account: "acme", token: @blake_token),
+         as: :json
+    assert_response :created
+    @blake_ticket_id = json_body.dig("request", "id")
+
+    post "/api/v1/requests",
+         params: { request: { subject: "Casey issue", comment: { body: "Casey details" } } },
+         headers: json_headers(account: "globex", token: @casey_token),
+         as: :json
+    assert_response :created
+    @casey_ticket_id = json_body.dig("request", "id")
+  end
+
+  test "unauthenticated requests are rejected with 401" do
+    get "/api/v1/requests", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+    post "/api/v1/requests", params: { request: { subject: "X", comment: { body: "Y" } } }, headers: json_headers(account: "acme"), as: :json
+    assert_response :unauthorized
+    get "/api/v1/requests/#{@avery_ticket_id}", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+    patch "/api/v1/requests/#{@avery_ticket_id}", params: { request: { comment: { body: "Hi" } } }, headers: json_headers(account: "acme"), as: :json
+    assert_response :unauthorized
+    get "/api/v1/requests/#{@avery_ticket_id}/comments", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+    get "/api/v1/tickets/#{@avery_ticket_id}", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+    patch "/api/v1/tickets/#{@avery_ticket_id}", params: { ticket: { status: "pending" } }, headers: json_headers(account: "acme"), as: :json
+    assert_response :unauthorized
+    get "/api/v1/tickets/#{@avery_ticket_id}/comments", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "customers cannot access staff /tickets routes" do
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{@avery_ticket_id}", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :forbidden
+
+    patch "/api/v1/tickets/#{@avery_ticket_id}",
+          params: { ticket: { status: "pending" } },
+          headers: json_headers(account: "acme", token: @avery_token),
+          as: :json
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{@avery_ticket_id}/comments", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :forbidden
+  end
+
+  test "customers can only see and interact with their own requests" do
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [ @avery_ticket_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{@blake_ticket_id}", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :not_found
+
+    patch "/api/v1/requests/#{@blake_ticket_id}",
+          params: { request: { comment: { body: "Sneaky reply" } } },
+          headers: json_headers(account: "acme", token: @avery_token),
+          as: :json
+    assert_response :not_found
+
+    get "/api/v1/requests/#{@blake_ticket_id}/comments", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :not_found
+
+    # Staff sees both customers' tickets in Acme
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :ok
+    assert_equal [ @blake_ticket_id, @avery_ticket_id ], json_body["tickets"].map { |t| t["id"] }
+  end
+
+  test "strict multi-tenant isolation between accounts" do
+    # Globex staff only sees Globex tickets
+    get "/api/v1/tickets", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :ok
+    assert_equal [ @casey_ticket_id ], json_body["tickets"].map { |t| t["id"] }
+
+    # Globex staff cannot access Acme tickets
+    get "/api/v1/tickets/#{@avery_ticket_id}", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :not_found
+    patch "/api/v1/tickets/#{@avery_ticket_id}",
+          params: { ticket: { status: "solved" } },
+          headers: json_headers(account: "globex", token: @globex_owner_token),
+          as: :json
+    assert_response :not_found
+    get "/api/v1/tickets/#{@avery_ticket_id}/comments", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :not_found
+
+    # Globex customer cannot access Acme requests
+    get "/api/v1/requests/#{@avery_ticket_id}", headers: json_headers(account: "globex", token: @casey_token)
+    assert_response :not_found
+
+    # Cross-account token fails with 401
+    get "/api/v1/tickets", headers: json_headers(account: "globex", token: @acme_owner_token)
+    assert_response :unauthorized
+  end
+
+  test "private staff comments are hidden from customer comments endpoint and customers cannot create private comments" do
+    # Customer tries to send public: false -> forced to public: true
+    patch "/api/v1/requests/#{@avery_ticket_id}",
+          params: { request: { comment: { body: "Customer reply", public: false } } },
+          headers: json_headers(account: "acme", token: @avery_token),
+          as: :json
+    assert_response :ok
+
+    # Staff posts an internal note with public: false
+    patch "/api/v1/tickets/#{@avery_ticket_id}",
+          params: { ticket: { comment: { body: "Internal staff note", public: false } } },
+          headers: json_headers(account: "acme", token: @acme_owner_token),
+          as: :json
+    assert_response :ok
+
+    # Staff sees all 3 comments including the non-public one
+    get "/api/v1/tickets/#{@avery_ticket_id}/comments", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :ok
+    assert_equal 3, json_body["count"]
+    assert_equal [ true, true, false ], json_body["comments"].map { |c| c["public"] }
+    assert_equal [ "Avery details", "Customer reply", "Internal staff note" ], json_body["comments"].map { |c| c["body"] }
+
+    # Customer only sees the 2 public comments
+    get "/api/v1/requests/#{@avery_ticket_id}/comments", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal [ "Avery details", "Customer reply" ], json_body["comments"].map { |c| c["body"] }
+  end
+
+  test "cancelling an account blocks ticket/request access and purging deletes all tickets and comments cleanly" do
+    post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :ok
+
+    # Customer session revoked -> 401
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :unauthorized
+
+    # Owner signs in while cancelled -> ordinary ticket/request endpoints return 403
+    reactivate_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: reactivate_token)
+    assert_response :forbidden
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: reactivate_token)
+    assert_response :forbidden
+
+    # Purge after 90 days cleanly removes Acme tickets & comments while preserving Globex
+    travel 91.days do
+      purged = Account.purge_cancelled!
+      assert_equal 1, purged
+      assert_not Account.exists?(subdomain: "acme")
+      assert_not Ticket.exists?(@avery_ticket_id)
+      assert_not Ticket.exists?(@blake_ticket_id)
+      assert Ticket.exists?(@casey_ticket_id)
+    end
+  end
+end
+
+# Additional edge-case checks appended cleanly via class reopening
+class TicketsAuthorizationAndIsolationTest
+  test "staff cannot access another user's request via /requests and profile updates reflect dynamically" do
+    # Owner does not see Avery's request on /requests
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :ok
+    assert_equal [], json_body["requests"]
+
+    get "/api/v1/requests/#{@avery_ticket_id}", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :not_found
+
+    patch "/api/v1/requests/#{@avery_ticket_id}",
+          params: { request: { comment: { body: "Wrong endpoint" } } },
+          headers: json_headers(account: "acme", token: @acme_owner_token),
+          as: :json
+    assert_response :not_found
+
+    get "/api/v1/requests/#{@avery_ticket_id}/comments", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :not_found
+
+    # Customer updates profile name -> reflects in ticket requester and comment author
+    patch "/api/v1/me",
+          params: { user: { name: "Avery Updated" } },
+          headers: json_headers(account: "acme", token: @avery_token),
+          as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets/#{@avery_ticket_id}", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :ok
+    assert_equal "Avery Updated", json_body.dig("ticket", "requester", "name")
+
+    get "/api/v1/tickets/#{@avery_ticket_id}/comments", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :ok
+    assert_equal "Avery Updated", json_body["comments"].first.dig("author", "name")
+  end
+end
diff --git a/test/integration/users_suspension_and_staff_test.rb b/test/integration/users_suspension_and_staff_test.rb
