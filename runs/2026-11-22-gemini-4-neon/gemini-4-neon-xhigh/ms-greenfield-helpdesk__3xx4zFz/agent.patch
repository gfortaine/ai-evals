+require "test_helper"
+
+class InboundEmailSupportTest < ActionDispatch::IntegrationTest
+  INGRESS_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "test-inbound-secret-password"
+
+  setup do
+    @acme_data = signup_and_verify!(
+      name: "Acme",
+      subdomain: "acme",
+      admin_name: "Jo",
+      email: "jo@acme.test",
+      password: "acme-owner-password"
+    )
+    @acme = Account.find_by!(subdomain: "acme")
+    @acme_owner_token = sign_in!(
+      subdomain: "acme",
+      email: "jo@acme.test",
+      password: "acme-owner-password"
+    ).dig("session", "token")
+
+    @beta_data = signup_and_verify!(
+      name: "Beta Corp",
+      subdomain: "beta",
+      admin_name: "Pat",
+      email: "pat@beta.test",
+      password: "beta-owner-password"
+    )
+    @beta = Account.find_by!(subdomain: "beta")
+    @beta_owner_token = sign_in!(
+      subdomain: "beta",
+      email: "pat@beta.test",
+      password: "beta-owner-password"
+    ).dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def relay_auth_header(username: "actionmailbox", password: INGRESS_PASSWORD)
+    ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+  end
+
+  def post_raw_email(raw_email, password: INGRESS_PASSWORD, username: "actionmailbox", content_type: "message/rfc822", include_auth: true)
+    headers = { "CONTENT_TYPE" => content_type }
+    headers["HTTP_AUTHORIZATION"] = relay_auth_header(username: username, password: password) if include_auth
+    post INGRESS_PATH, params: raw_email, headers: headers
+  end
+
+  def build_raw_email(
+    from: "Alice Example <alice@example.test>",
+    to: "acme@support.example.test",
+    cc: nil,
+    subject: "Help with my order",
+    body: "My order has not arrived yet.",
+    message_id: "<msg-#{SecureRandom.hex(8)}@mail.example.test>",
+    extra_headers: {}
+  )
+    lines = []
+    lines << "Message-ID: #{message_id}" if message_id
+    lines << "From: #{from}" if from
+    lines << "To: #{to}" if to
+    lines << "Cc: #{cc}" if cc
+    lines << "Subject: #{subject}" unless subject.nil?
+    lines << "Date: Sun, 22 Nov 2026 10:00:00 +0000"
+    lines << "MIME-Version: 1.0"
+    lines << "Content-Type: text/plain; charset=UTF-8" unless extra_headers.keys.any? { |k| k.to_s.casecmp?("Content-Type") }
+    extra_headers.each do |k, v|
+      lines << "#{k}: #{v}"
+    end
+    lines << ""
+    lines << body.to_s
+    lines.join("\r\n")
+  end
+
+  test "relay ingress enforces Basic auth with RAILS_INBOUND_EMAIL_PASSWORD and message/rfc822 media type" do
+    raw = build_raw_email(message_id: "<auth-retry-1@example.test>")
+
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      # Missing auth -> 401
+      assert_no_difference [ "Ticket.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(raw, include_auth: false)
+      end
+      assert_response :unauthorized
+
+      # Wrong password -> 401
+      assert_no_difference [ "Ticket.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(raw, password: "wrong-password")
+      end
+      assert_response :unauthorized
+
+      # Wrong username -> 401
+      assert_no_difference [ "Ticket.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(raw, username: "wronguser")
+      end
+      assert_response :unauthorized
+
+      # Wrong Content-Type -> 415
+      assert_no_difference [ "Ticket.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(raw, content_type: "text/plain")
+      end
+      assert_response :unsupported_media_type
+
+      # Valid retry with same Message-ID succeeds synchronously before request completes
+      assert_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ], 1 do
+        post_raw_email(raw)
+      end
+      assert_response :no_content
+    end
+  end
+
+  test "incoming email opens ticket with subject and plain text, creates unverified customer, sends verification email, and customer can later use portal" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      raw = build_raw_email(
+        from: "Alice Cooper <alice@example.test>",
+        to: "acme@support.example.test",
+        subject: "Cannot access invoice",
+        body: "Hello support,\r\nPlease help me find invoice #42."
+      )
+
+      assert_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ], 1 do
+        post_raw_email(raw)
+      end
+      assert_response :no_content
+
+      # Processed before request completed
+      customer = @acme.users.find_by!(email: "alice@example.test")
+      assert_equal "Alice Cooper", customer.name
+      assert_equal "customer", customer.role
+      assert_not customer.verified?, "Receiving email must not verify the customer account"
+      assert_nil customer.verified_at
+
+      ticket = @acme.tickets.last
+      assert_equal customer.id, ticket.requester_id
+      assert_equal "Cannot access invoice", ticket.subject
+      assert_equal "open", ticket.status
+      assert_equal "email", ticket.origin
+      assert ticket.reply_token.present?
+
+      comment = ticket.comments.sole
+      assert_equal customer.id, comment.author_id
+      assert_equal "Hello support,\nPlease help me find invoice #42.", comment.body
+      assert_equal true, comment.public
+
+      # Verification email was sent so customer can later verify and use the portal
+      verification_mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "alice@example.test" ], verification_mail.to
+      _url, acct_param, verify_token = extract_token_from_mail(verification_mail, path: "/verify-email")
+      assert_equal "acme", acct_param
+
+      # Customer verifies email, sets password via password reset, and uses portal to see their ticket
+      post "/api/v1/email_verifications/confirm",
+           params: { email_verification: { token: verify_token } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+      assert_equal true, json_body.dig("user", "verified")
+
+      ActionMailer::Base.deliveries.clear
+      post "/api/v1/password_resets",
+           params: { password_reset: { email: "alice@example.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+      _rurl, _racct, reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: reset_token, password: "alice-new-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+
+      customer_token = sign_in!(subdomain: "acme", email: "alice@example.test", password: "alice-new-password").dig("session", "token")
+      get "/api/v1/requests", headers: json_headers(account: "acme", token: customer_token)
+      assert_response :ok
+      assert_equal [ ticket.id ], json_body["requests"].map { |r| r["id"] }
+    end
+  end
+
+  test "reuses existing unverified and verified customers without verifying or sending duplicate verification emails" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      # 1. First email creates unverified customer + sends verification email
+      post_raw_email(build_raw_email(from: "unverified@example.test", subject: "First issue", body: "Issue one"))
+      assert_response :no_content
+      assert_equal 1, ActionMailer::Base.deliveries.size
+      customer = @acme.users.find_by!(email: "unverified@example.test")
+      assert_equal "unverified", customer.name
+      assert_not customer.verified?
+
+      # 2. Second email from same unverified customer reuses them, keeps them unverified, sends NO verification email
+      assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+        assert_difference "Ticket.count", 1 do
+          post_raw_email(build_raw_email(from: "unverified@example.test", subject: "Second issue", body: "Issue two"))
+        end
+      end
