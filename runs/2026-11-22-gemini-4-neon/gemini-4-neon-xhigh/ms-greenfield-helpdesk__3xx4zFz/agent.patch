+  test "deduplicates deliveries by Message-ID across identical and modified relays, and invalid deliveries never block valid retries" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      # 1. Deduplicate identical raw bytes AND modified raw bytes with same Message-ID
+      dup_id = "<dedup-new-ticket@example.test>"
+      raw_first = build_raw_email(
+        from: "dedup@example.test",
+        subject: "Dedup subject",
+        body: "First delivery",
+        message_id: dup_id
+      )
+
+      assert_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ], 1 do
+        post_raw_email(raw_first)
+      end
+      assert_response :no_content
+
+      # Exact same raw bytes -> deduplicated
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(raw_first)
+      end
+      assert_response :no_content
+
+      # Different raw bytes (added Received header / different body) but SAME Message-ID -> deduplicated
+      raw_relay_dup = build_raw_email(
+        from: "dedup@example.test",
+        subject: "Dedup subject",
+        body: "Modified relay retry",
+        message_id: dup_id,
+        extra_headers: { "Received" => "from relay2.example.test by mx.example.test" }
+      )
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(raw_relay_dup)
+      end
+      assert_response :no_content
+
+      # 2. Invalid delivery #1 (blank body) MUST NOT block later valid retry with SAME Message-ID
+      retry_blank_id = "<retry-blank-body@example.test>"
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_raw_email(build_raw_email(
+          from: "retry1@example.test",
+          subject: "Retry blank",
+          body: "   \r\n  ",
+          message_id: retry_blank_id
+        ))
+      end
+      assert_response :no_content
+
+      assert_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ], 1 do
+        post_raw_email(build_raw_email(
+          from: "retry1@example.test",
+          subject: "Retry blank",
+          body: "Now with a real message!",
+          message_id: retry_blank_id
+        ))
+      end
+      assert_response :no_content
+
+      # 3. Invalid delivery #1 (non-requester reply) MUST NOT block valid retry by requester with SAME Message-ID
+      ticket = @acme.tickets.order(:id).last
+      retry_reply_id = "<retry-reply-auth@example.test>"
+      assert_no_difference "TicketComment.count" do
+        post_raw_email(build_raw_email(
+          from: "impostor@example.test",
+          to: ticket.reply_address,
+          subject: "Re: Retry blank",
+          body: "Wrong sender",
+          message_id: retry_reply_id
+        ))
+      end
+      assert_response :no_content
+
+      assert_difference "ticket.comments.count", 1 do
+        post_raw_email(build_raw_email(
+          from: "retry1@example.test",
+          to: ticket.reply_address,
+          subject: "Re: Retry blank",
+          body: "Real requester retry",
+          message_id: retry_reply_id
+        ))
+      end
+      assert_response :no_content
+
+      # Subsequent duplicate of that now-valid reply IS deduplicated
+      assert_no_difference "ticket.comments.count" do
+        post_raw_email(build_raw_email(
+          from: "retry1@example.test",
+          to: ticket.reply_address,
+          subject: "Re: Retry blank",
+          body: "Real requester retry duplicate",
+          message_id: retry_reply_id
+        ))
+      end
+      assert_response :no_content
+
+      # 4. Invalid delivery #1 (cancelled account, IDENTICAL raw bytes) MUST NOT block valid retry after reactivation
+      @beta.cancel!
+      same_bytes_id = "<retry-identical-bytes@example.test>"
+      identical_raw = build_raw_email(
+        from: "samebytes@example.test",
+        to: "beta@support.example.test",
+        subject: "During cancellation",
