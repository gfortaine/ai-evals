+    # Same email CAN be invited OR registered on Globex (multi-tenancy isolation)
+    post "/api/v1/registrations",
+         params: { user: { name: "Sam Globex", email: "sam@example.test", password: "customer-password-1" } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :created
+
+    # Revoke Sam's invite on Acme -> now customer registration on Acme succeeds!
+    delete "/api/v1/invitations/#{sam_inv_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+
+    post "/api/v1/registrations",
+         params: { user: { name: "Sam Customer", email: "sam@example.test", password: "customer-password-1" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :created
+
+    # Also test that customer registration succeeds after an invitation EXPIRES
+    post "/api/v1/invitations",
+         params: { invitation: { email: "later@example.test", role: "agent" } },
+         headers: json_headers(account: "acme", token: @owner_token),
+         as: :json
+    assert_response :created
+
+    travel 8.days do
+      post "/api/v1/registrations",
+           params: { user: { name: "Later Customer", email: "later@example.test", password: "customer-password-1" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :created
+    end
+  end
+
+  test "enforces authorization, validation, cross-tenant isolation, and account cancellation on invitations" do
+    # Create agent and customer on Acme
+    post "/api/v1/invitations",
+         params: { invitation: { email: "morgan@acme.test", role: "agent" } },
+         headers: json_headers(account: "acme", token: @owner_token),
+         as: :json
+    assert_response :created
+    _u, _a, morgan_inv_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: morgan_inv_token, name: "Morgan", password: "morgan-password-1" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :created
+    agent_token = sign_in!(subdomain: "acme", email: "morgan@acme.test", password: "morgan-password-1").dig("session", "token")
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password-1")
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "avery-password-1").dig("session", "token")
+
+    # Create a pending invite on Acme
+    post "/api/v1/invitations",
+         params: { invitation: { email: "riley@acme.test", role: "agent" } },
+         headers: json_headers(account: "acme", token: @owner_token),
+         as: :json
+    assert_response :created
+    acme_inv_id = json_body.dig("invitation", "id")
+    _u, _a, riley_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+
+    # Unauthenticated -> 401
+    get "/api/v1/invitations", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+    post "/api/v1/invitations",
+         params: { invitation: { email: "x@acme.test", role: "agent" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unauthorized
+
+    # Agent and customer -> 403 on all invitation management endpoints
+    [ agent_token, customer_token ].each do |tok|
+      get "/api/v1/invitations", headers: json_headers(account: "acme", token: tok)
+      assert_response :forbidden
+      get "/api/v1/invitations/#{acme_inv_id}", headers: json_headers(account: "acme", token: tok)
+      assert_response :forbidden
+      post "/api/v1/invitations",
+           params: { invitation: { email: "nope@acme.test", role: "agent" } },
+           headers: json_headers(account: "acme", token: tok),
+           as: :json
+      assert_response :forbidden
+      post "/api/v1/invitations/#{acme_inv_id}/resend", headers: json_headers(account: "acme", token: tok)
+      assert_response :forbidden
+      delete "/api/v1/invitations/#{acme_inv_id}", headers: json_headers(account: "acme", token: tok)
+      assert_response :forbidden
+    end
+
+    # Invalid roles and emails rejected with 422; malformed payloads with 400
+    [ "customer", "owner", "superadmin", "", nil ].each do |bad_role|
+      post "/api/v1/invitations",
+           params: { invitation: { email: "new@acme.test", role: bad_role } },
+           headers: json_headers(account: "acme", token: @owner_token),
+           as: :json
+      assert_response :unprocessable_content, "Expected 422 for role=#{bad_role.inspect}"
+    end
+
+    post "/api/v1/invitations",
+         params: { invitation: { email: "not-an-email", role: "agent" } },
+         headers: json_headers(account: "acme", token: @owner_token),
+         as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/invitations", params: { invitation: "bad" }, headers: json_headers(account: "acme", token: @owner_token), as: :json
+    assert_response :bad_request
+
+    post "/api/v1/invitation_previews", params: { invitation_preview: "bad" }, headers: json_headers(account: "acme"), as: :json
+    assert_response :bad_request
+
+    post "/api/v1/invitation_acceptances", params: { invitation_acceptance: "bad" }, headers: json_headers(account: "acme"), as: :json
+    assert_response :bad_request
+
+    # Cross-tenant isolation: Globex cannot inspect, resend, revoke, preview, or accept Acme's invitation
+    get "/api/v1/invitations/#{acme_inv_id}", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :not_found
+    post "/api/v1/invitations/#{acme_inv_id}/resend", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :not_found
+    delete "/api/v1/invitations/#{acme_inv_id}", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :not_found
+
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: riley_token } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: riley_token, name: "Riley", password: "riley-password-1" } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Token is still valid on Acme
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: riley_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    # Cancelled account blocks preview, acceptance, and admin invitation endpoints; purge deletes invitations cleanly
+    post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: riley_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: riley_token, name: "Riley", password: "riley-password-1" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    owner_cancelled_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    get "/api/v1/invitations", headers: json_headers(account: "acme", token: owner_cancelled_token)
+    assert_response :forbidden
+
+    travel 91.days do
+      assert_equal 1, Account.purge_cancelled!
+      assert_not Invitation.exists?(acme_inv_id)
+    end
+  end
+end
diff --git a/test/integration/multi_tenancy_test.rb b/test/integration/multi_tenancy_test.rb
new file mode 100644
index 0000000..2bca33b
--- /dev/null
+++ b/test/integration/multi_tenancy_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class MultiTenancyTest < ActionDispatch::IntegrationTest
+  test "same email can belong to multiple businesses with strict isolation" do
+    # Register same email under two accounts with different passwords
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo Acme", email: "jo@shared.test", password: "acme-password-1" }
+           }
+         },
+         as: :json
+    assert_response :created
+    _u1, _a1, acme_verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Globex",
+             subdomain: "globex",
+             admin: { name: "Jo Globex", email: "jo@shared.test", password: "globex-password-1" }
+           }
+         },
+         as: :json
+    assert_response :created
+    _u2, _a2, globex_verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    # Cross-account verification token is rejected
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: acme_verify_token } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Verify both in their respective accounts
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: acme_verify_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    # Globex user is still unverified
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@shared.test", password: "globex-password-1" } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :forbidden
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: globex_verify_token } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :ok
+
+    # Sign in to both accounts
+    acme_token = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "acme-password-1").dig("session", "token")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@shared.test", password: "globex-password-1").dig("session", "token")
+
+    # Cross-account bearer tokens are rejected
+    get "/api/v1/me", headers: json_headers(account: "globex", token: acme_token)
+    assert_response :unauthorized
+    get "/api/v1/account", headers: json_headers(account: "acme", token: globex_token)
+    assert_response :unauthorized
+    delete "/api/v1/session", headers: json_headers(account: "globex", token: acme_token)
+    assert_response :unauthorized
+
+    # Cross-account password reset token is rejected
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@shared.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    _ru, _ra, acme_reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: acme_reset_token, password: "new-acme-password" } },
+         headers: json_headers(account: "globex"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Resetting acme password revokes acme session but NOT globex session
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: acme_reset_token, password: "new-acme-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: acme_token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: json_headers(account: "globex", token: globex_token)
+    assert_response :ok
+    assert_equal "Jo Globex", json_body.dig("user", "name")
+  end
+end
diff --git a/test/integration/pagination_ordering_and_validation_test.rb b/test/integration/pagination_ordering_and_validation_test.rb
new file mode 100644
index 0000000..6117785
--- /dev/null
+++ b/test/integration/pagination_ordering_and_validation_test.rb
@@ -0,0 +1,398 @@
+require "test_helper"
+
+class PaginationOrderingAndValidationTest < ActionDispatch::IntegrationTest
+  setup do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    @owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password-1")
+    @avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "avery-password-1").dig("session", "token")
+  end
+
+  test "empty lists return expected pagination metadata" do
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal(
+      { "requests" => [], "count" => 0, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+      json_body
+    )
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal(
+      { "tickets" => [], "count" => 0, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+      json_body
+    )
+  end
+
+  test "default and custom pagination across requests, tickets, and comments plus invalid pagination params" do
+    account = Account.find_by!(subdomain: "acme")
+    customer = account.users.find_by!(email: "avery@example.test")
+
+    base_time = Time.zone.parse("2026-11-22 10:00:00 UTC")
+    created_ids = (1..30).map do |i|
+      t = account.tickets.create!(
+        requester: customer,
+        subject: "Issue #{i}",
+        status: "open",
+        created_at: base_time + i.minutes,
+        updated_at: base_time + i.minutes
+      )
+      t.comments.create!(
+        account: account,
+        author: customer,
+        body: "Initial comment #{i}",
+        public: true,
+        created_at: base_time + i.minutes,
+        updated_at: base_time + i.minutes
+      )
+      t.update_columns(updated_at: base_time + i.minutes)
+      t.id
+    end
+
+    # Default pagination (page 1, per_page 25) - newest / most recently active first
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal 25, json_body["requests"].size
+    assert_equal created_ids.reverse.first(25), json_body["requests"].map { |r| r["id"] }
+
+    # Page 2
+    get "/api/v1/requests?page=2", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal created_ids.reverse.last(5), json_body["requests"].map { |r| r["id"] }
+
+    # Out-of-range page 3
+    get "/api/v1/requests?page=3", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [], json_body["requests"]
+    assert_equal 30, json_body["count"]
+    assert_nil json_body["next_page"]
+    assert_equal 2, json_body["previous_page"]
+
+    # Custom per_page on /tickets
+    get "/api/v1/tickets?page=2&per_page=10", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 10, json_body["per_page"]
+    assert_equal 3, json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal created_ids.reverse[10, 10], json_body["tickets"].map { |t| t["id"] }
+
+    # Invalid / extreme pagination parameters are safely normalized without error
+    get "/api/v1/tickets?page=0&per_page=-5", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+
+    get "/api/v1/tickets?page=abc&per_page=9999", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["page"]
+    assert_equal 100, json_body["per_page"]
+    assert_equal 30, json_body["tickets"].size
+
+    get "/api/v1/tickets?page=999999999999999999999999999", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+    assert_nil json_body["next_page"]
+
+    # Comments pagination (oldest first) on both /requests/:id/comments and /tickets/:id/comments
+    target_ticket = Ticket.find(created_ids.first)
+    owner = account.users.find_by!(email: "jo@acme.test")
+    (2..6).each do |n|
+      target_ticket.comments.create!(
+        account: account,
+        author: n.even? ? owner : customer,
+        body: "Comment #{n}",
+        public: true,
+        created_at: base_time + n.hours,
+        updated_at: base_time + n.hours
+      )
+    end
+
+    get "/api/v1/requests/#{target_ticket.id}/comments?page=1&per_page=2", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 6, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal [ "Initial comment 1", "Comment 2" ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/tickets/#{target_ticket.id}/comments?page=2&per_page=2", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 6, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 3, json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal [ "Comment 3", "Comment 4" ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/tickets/#{target_ticket.id}/comments?page=3&per_page=2", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_nil json_body["next_page"]
+    assert_equal 2, json_body["previous_page"]
+    assert_equal [ "Comment 5", "Comment 6" ], json_body["comments"].map { |c| c["body"] }
+  end
+
+  test "recently active tickets and requests float to the top on reply or status change" do
+    id1 = nil
+    id2 = nil
+    id3 = nil
+
+    travel_to Time.zone.parse("2026-11-22 12:00:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "First", comment: { body: "One" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :created
+      id1 = json_body.dig("request", "id")
+    end
+
+    travel_to Time.zone.parse("2026-11-22 12:01:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Second", comment: { body: "Two" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :created
+      id2 = json_body.dig("request", "id")
+    end
+
+    travel_to Time.zone.parse("2026-11-22 12:02:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Third", comment: { body: "Three" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :created
+      id3 = json_body.dig("request", "id")
+    end
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ id3, id2, id1 ], json_body["tickets"].map { |t| t["id"] }
+
+    # Staff posts reply on First WITHOUT changing status -> First jumps to top!
+    travel_to Time.zone.parse("2026-11-22 12:05:00 UTC") do
+      patch "/api/v1/tickets/#{id1}",
+            params: { ticket: { comment: { body: "Working on First" } } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ id1, id3, id2 ], json_body["tickets"].map { |t| t["id"] }
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_equal [ id1, id3, id2 ], json_body["requests"].map { |r| r["id"] }
+
+    # Staff changes status on Second without comment -> Second jumps to top!
+    travel_to Time.zone.parse("2026-11-22 12:06:00 UTC") do
+      patch "/api/v1/tickets/#{id2}",
+            params: { ticket: { status: "pending" } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ id2, id1, id3 ], json_body["tickets"].map { |t| t["id"] }
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_equal [ id2, id1, id3 ], json_body["requests"].map { |r| r["id"] }
+
+    # Customer replies on Third -> Third jumps to top!
+    travel_to Time.zone.parse("2026-11-22 12:07:00 UTC") do
+      patch "/api/v1/requests/#{id3}",
+            params: { request: { comment: { body: "Bump on Third" } } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_equal [ id3, id2, id1 ], json_body["requests"].map { |r| r["id"] }
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ id3, id2, id1 ], json_body["tickets"].map { |t| t["id"] }
+  end
+
+  test "request and ticket validation, atomicity, mass assignment, and bad ID edge cases" do
+    # Malformed create payloads
+    post "/api/v1/requests", params: {}, headers: json_headers(account: "acme", token: @avery_token), as: :json
+    assert_response :bad_request
+
+    post "/api/v1/requests", params: { request: "invalid" }, headers: json_headers(account: "acme", token: @avery_token), as: :json
+    assert_response :bad_request
+
+    post "/api/v1/requests",
+         params: { request: { subject: "Valid", comment: "not-a-hash" } },
+         headers: json_headers(account: "acme", token: @avery_token),
+         as: :json
+    assert_response :bad_request
+
+    assert_no_difference [ "Ticket.count", "TicketComment.count" ] do
+      post "/api/v1/requests",
+           params: { request: { subject: "   ", comment: { body: "Details" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/requests",
+           params: { request: { subject: "Valid", comment: { body: "   " } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/requests",
+           params: { request: { subject: "Valid" } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/requests",
+           params: { request: { subject: "x" * 256, comment: { body: "Details" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Create valid request with long multi-paragraph body & disallowed mass assignment fields
+    long_body = ("Paragraph of detailed context. " * 200).strip
+    post "/api/v1/requests",
+         params: {
+           request: {
+             subject: "  Receipt issue  ",
+             status: "solved",
+             requester_id: 999_999,
+             comment: { body: long_body }
+           }
+         },
+         headers: json_headers(account: "acme", token: @avery_token),
+         as: :json
+    assert_response :created
+    id = json_body.dig("request", "id")
+    assert_equal "Receipt issue", json_body.dig("request", "subject")
+    assert_equal "open", json_body.dig("request", "status")
+    assert_not_equal 999_999, json_body.dig("request", "requester_id")
+
+    # Bad ID formats return 404 cleanly (and "1abc" doesn't match ticket 1)
+    [ "abc", "#{id}abc", "0", "-1", "99999999999999999999999999" ].each do |bad_id|
+      get "/api/v1/requests/#{bad_id}", headers: json_headers(account: "acme", token: @avery_token)
+      assert_response :not_found, "Expected 404 for /requests/#{bad_id}"
+      get "/api/v1/requests/#{bad_id}/comments", headers: json_headers(account: "acme", token: @avery_token)
+      assert_response :not_found, "Expected 404 for /requests/#{bad_id}/comments"
+      get "/api/v1/tickets/#{bad_id}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :not_found, "Expected 404 for /tickets/#{bad_id}"
+      get "/api/v1/tickets/#{bad_id}/comments", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :not_found, "Expected 404 for /tickets/#{bad_id}/comments"
+    end
+
+    # Customer invalid PATCH updates are atomic and rejected
+    assert_no_difference "TicketComment.count" do
+      # Cannot set pending, open, closed, blank, or null
+      [ "pending", "open", "closed", "", nil ].each do |bad_status|
+        patch "/api/v1/requests/#{id}",
+              params: { request: { comment: { body: "Should rollback" }, status: bad_status } },
+              headers: json_headers(account: "acme", token: @avery_token),
+              as: :json
+        assert_response :unprocessable_content, "Expected 422 for customer status=#{bad_status.inspect}"
+      end
+
+      # Blank comment body rolls back status: solved
+      patch "/api/v1/requests/#{id}",
+            params: { request: { comment: { body: "   " }, status: "solved" } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "open", Ticket.find(id).status
+
+      # Empty envelope returns 400; envelope with no valid update fields returns 422
+      patch "/api/v1/requests/#{id}",
+            params: { request: {} },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :bad_request
+
+      patch "/api/v1/requests/#{id}",
+            params: { request: { subject: "Cannot edit subject" } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "Receipt issue", Ticket.find(id).subject
+
+      # Invalid solved value
+      patch "/api/v1/requests/#{id}",
+            params: { request: { solved: "yes" } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :unprocessable_content
+
+      # Non-hash comment returns 400
+      patch "/api/v1/requests/#{id}",
+            params: { request: { comment: "oops" } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :bad_request
+    end
+
+    # Staff invalid PATCH updates are atomic and rejected
+    assert_no_difference "TicketComment.count" do
+      [ "closed", "new", "", nil, [ "open" ] ].each do |bad_status|
+        patch "/api/v1/tickets/#{id}",
+              params: { ticket: { comment: { body: "Should rollback" }, status: bad_status } },
+              headers: json_headers(account: "acme", token: @owner_token),
+              as: :json
+        assert_response :unprocessable_content, "Expected 422 for staff status=#{bad_status.inspect}"
+      end
+
+      # Blank comment body rolls back status: pending
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: { comment: { body: "" }, status: "pending" } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "open", Ticket.find(id).status
+
+      # Invalid public value
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: { comment: { body: "Hi", public: "maybe" } } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+
+      # Empty envelope returns 400; envelope with no valid update fields returns 422
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: {} },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :bad_request
+
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: { subject: "Cannot edit subject" } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "Receipt issue", Ticket.find(id).subject
+
+      # Non-hash envelope and comment return 400
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: "bad" },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :bad_request
+
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: { comment: [ "bad" ] } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :bad_request
+    end
+  end
+end
diff --git a/test/integration/password_resets_test.rb b/test/integration/password_resets_test.rb
new file mode 100644
index 0000000..60fb844
--- /dev/null
+++ b/test/integration/password_resets_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class PasswordResetsTest < ActionDispatch::IntegrationTest
+  test "password reset flow replaces old links, revokes existing sessions, and respects env config" do
+    signup_and_verify!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    existing_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+
+    with_env("HELPDESK_FRONTEND_URL" => "https://portal.example.test", "HELPDESK_MAIL_FROM" => "help@example.test") do
+      # Unknown email returns 200 without sending mail
+      post "/api/v1/password_resets",
+           params: { password_reset: { email: "nobody@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+      assert_equal 0, ActionMailer::Base.deliveries.size
+
+      # Request first reset link
+      post "/api/v1/password_resets",
+           params: { password_reset: { email: "jo@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+      assert_equal 1, ActionMailer::Base.deliveries.size
+
+      mail1 = ActionMailer::Base.deliveries.last
+      assert_equal [ "help@example.test" ], mail1.from
+      url1, acct1, token1 = extract_token_from_mail(mail1, path: "/reset-password")
+      assert url1.start_with?("https://portal.example.test/reset-password?account=acme&token=")
+      assert_equal "acme", acct1
+
+      # Request second reset link; replaces first link
+      post "/api/v1/password_resets",
+           params: { password_reset: { email: "jo@acme.test" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+      assert_equal 2, ActionMailer::Base.deliveries.size
+      _url2, _acct2, token2 = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+      assert_not_equal token1, token2
+
+      # First token must fail
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token1, password: "my-new-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      # Invalid new password must fail WITHOUT consuming token2
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token2, password: "short" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      # Existing session is still alive until password actually changes
+      get "/api/v1/me", headers: json_headers(account: "acme", token: existing_token)
+      assert_response :ok
+
+      # Valid confirmation updates password and revokes existing sessions
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token2, password: "my-new-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :ok
+
+      # Token2 cannot be reused
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token2, password: "another-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      # Existing session was revoked
+      get "/api/v1/me", headers: json_headers(account: "acme", token: existing_token)
+      assert_response :unauthorized
+
+      # Old password fails, new password works
+      post "/api/v1/sessions",
+           params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unauthorized
+
+      sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+    end
+  end
+
+  test "tokens cannot be used across purposes and expire after TTL" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+    _vurl, _vacct, verification_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    # Verification token rejected on password reset confirm
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: verification_token, password: "my-new-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Requesting password reset does NOT invalidate verification token
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    _rurl, _racct, reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+
+    # Reset token rejected on email verification confirm
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: reset_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    # Verification token still works
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: verification_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    # Reset token expires after 2 hours
+    travel 3.hours do
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: reset_token, password: "my-new-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+    end
+  end
+end
diff --git a/test/integration/requests_and_tickets_conversation_test.rb b/test/integration/requests_and_tickets_conversation_test.rb
new file mode 100644
index 0000000..f9bd609
--- /dev/null
+++ b/test/integration/requests_and_tickets_conversation_test.rb
@@ -0,0 +1,283 @@
+require "test_helper"
+
+class RequestsAndTicketsConversationTest < ActionDispatch::IntegrationTest
+  setup do
+    @account_data = signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    @account = Account.find_by!(subdomain: "acme")
+    @owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    @agent = @account.users.create!(
+      name: "Morgan",
+      email: "morgan@acme.test",
+      password: "agent-password-1",
+      role: "agent",
+      verified_at: Time.current
+    )
+    @agent_token = sign_in!(subdomain: "acme", email: "morgan@acme.test", password: "agent-password-1").dig("session", "token")
+
+    @customer_data = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    @customer_id = @customer_data.dig("user", "id")
+    @customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "full portal conversation lifecycle between customer and staff with status transitions and no emails" do
+    # 1. Customer opens a request
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/requests",
+           params: {
+             request: {
+               subject: "Cannot download my receipt",
+               comment: { body: "The download button does nothing." }
+             }
+           },
+           headers: json_headers(account: "acme", token: @customer_token),
+           as: :json
+    end
+    assert_response :created
+    req = json_body["request"]
+    assert_kind_of Integer, req["id"]
+    assert_equal "Cannot download my receipt", req["subject"]
+    assert_equal "open", req["status"]
+    assert_equal @customer_id, req["requester_id"]
+    assert req["created_at"].present?
+    assert req["updated_at"].present?
+    assert_not req.key?("requester")
+
+    ticket_id = req["id"]
+
+    # 2. Customer lists own requests, opens it, and reads its initial comment
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal [ ticket_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{ticket_id}", headers: json_headers(account: "acme", token: @customer_token)
+    assert_response :ok
+    assert_equal ticket_id, json_body.dig("request", "id")
+    assert_equal "open", json_body.dig("request", "status")
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: json_headers(account: "acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    first_comment = json_body["comments"].first
+    assert_equal "The download button does nothing.", first_comment["body"]
+    assert_equal true, first_comment["public"]
+    assert_equal({ "id" => @customer_id, "name" => "Avery" }, first_comment["author"])
+    assert first_comment["created_at"].present?
+
+    # 3. Staff (owner and agent) list tickets, open one with requester info, and read comments
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    listed_ticket = json_body["tickets"].first
+    assert_equal ticket_id, listed_ticket["id"]
+    assert_equal "Cannot download my receipt", listed_ticket["subject"]
+    assert_equal "open", listed_ticket["status"]
+    assert_equal(
+      { "id" => @customer_id, "name" => "Avery", "email" => "avery@example.test" },
+      listed_ticket["requester"]
+    )
+
+    get "/api/v1/tickets/#{ticket_id}", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal(
+      { "id" => @customer_id, "name" => "Avery", "email" => "avery@example.test" },
+      json_body.dig("ticket", "requester")
+    )
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal "The download button does nothing.", json_body["comments"].first["body"]
+
+    # 4. Owner answers and marks ticket pending
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      patch "/api/v1/tickets/#{ticket_id}",
+            params: {
+              ticket: {
+                comment: { body: "Please try again now." },
+                status: "pending"
+              }
+            },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+    end
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+    assert_equal "avery@example.test", json_body.dig("ticket", "requester", "email")
+
+    # 5. Agent posts a reply WITHOUT status -> status stays pending!
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      patch "/api/v1/tickets/#{ticket_id}",
+            params: {
+              ticket: {
+                comment: { body: "Let us know which browser you use too." }
+              }
+            },
+            headers: json_headers(account: "acme", token: @agent_token),
+            as: :json
+    end
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+
+    # 6. Customer replies to pending request without status -> reopens to open!
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      patch "/api/v1/requests/#{ticket_id}",
+            params: {
+              request: {
+                comment: { body: "Still nothing on Firefox." }
+              }
+            },
+            headers: json_headers(account: "acme", token: @customer_token),
+            as: :json
+    end
+    assert_response :ok
+    assert_equal "open", json_body.dig("request", "status")
+
+    # 7. Staff replies without status on open ticket -> stays open
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Investigating Firefox now." } } },
+          headers: json_headers(account: "acme", token: @agent_token),
+          as: :json
+    assert_response :ok
+    assert_equal "open", json_body.dig("ticket", "status")
+
+    # 8. Staff marks ticket solved with reply
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Fixed the Firefox download header." }, status: "solved" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("ticket", "status")
+
+    # 9. Staff posts reply on solved ticket without status -> stays solved!
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Closing notes added." } } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("ticket", "status")
+
+    # 10. Customer replies to solved request without marking solved -> reopens to open!
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { comment: { body: "Wait, the PDF is blank." } } },
+          headers: json_headers(account: "acme", token: @customer_token),
+          as: :json
+    assert_response :ok
+    assert_equal "open", json_body.dig("request", "status")
+
+    # 11. Staff changes status to pending without adding a comment
+    assert_no_difference "TicketComment.count" do
+      patch "/api/v1/tickets/#{ticket_id}",
+            params: { ticket: { status: "pending" } },
+            headers: json_headers(account: "acme", token: @agent_token),
+            as: :json
+    end
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+
+    # 12. Customer replies to pending request AND marks solved in the same update -> becomes solved!
+    patch "/api/v1/requests/#{ticket_id}",
+          params: {
+            request: {
+              comment: { body: "Never mind, cleared cache and it works!" },
+              status: "solved"
+            }
+          },
+          headers: json_headers(account: "acme", token: @customer_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("request", "status")
+
+    # 13. Customer replies to ALREADY solved request AND marks solved in same update -> stays solved!
+    patch "/api/v1/requests/#{ticket_id}",
+          params: {
+            request: {
+              comment: { body: "Thanks so much!" },
+              status: "solved"
+            }
+          },
+          headers: json_headers(account: "acme", token: @customer_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("request", "status")
+
+    # 14. Staff reopens solved ticket to open without comment, then customer marks solved without comment
+    assert_no_difference "TicketComment.count" do
+      patch "/api/v1/tickets/#{ticket_id}",
+            params: { ticket: { status: "open" } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+      assert_equal "open", json_body.dig("ticket", "status")
+
+      patch "/api/v1/requests/#{ticket_id}",
+            params: { request: { status: "solved" } },
+            headers: json_headers(account: "acme", token: @customer_token),
+            as: :json
+      assert_response :ok
+      assert_equal "solved", json_body.dig("request", "status")
+    end
+
+    # 15. Verify all 10 comments appear oldest first on both /requests/:id/comments and /tickets/:id/comments
+    expected_bodies = [
+      "The download button does nothing.",
+      "Please try again now.",
+      "Let us know which browser you use too.",
+      "Still nothing on Firefox.",
+      "Investigating Firefox now.",
+      "Fixed the Firefox download header.",
+      "Closing notes added.",
+      "Wait, the PDF is blank.",
+      "Never mind, cleared cache and it works!",
+      "Thanks so much!"
+    ]
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: json_headers(account: "acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 10, json_body["count"]
+    assert_equal expected_bodies, json_body["comments"].map { |c| c["body"] }
+    json_body["comments"].each do |comment|
+      assert_equal true, comment["public"]
+      assert_equal %w[id name], comment["author"].keys.sort
+      assert comment["created_at"].present?
+    end
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 10, json_body["count"]
+    assert_equal expected_bodies, json_body["comments"].map { |c| c["body"] }
+    assert_equal [ "Avery", "Jo", "Morgan" ], json_body["comments"].first(3).map { |c| c.dig("author", "name") }
+
+    # Zero emails sent throughout the entire conversation
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
+
+  test "customer can also mark request solved via solved: true boolean flag" do
+    post "/api/v1/requests",
+         params: { request: { subject: "Quick question", comment: { body: "How do I export?" } } },
+         headers: json_headers(account: "acme", token: @customer_token),
+         as: :json
+    assert_response :created
+    id = json_body.dig("request", "id")
+
+    patch "/api/v1/tickets/#{id}",
+          params: { ticket: { status: "pending" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    patch "/api/v1/requests/#{id}",
+          params: { request: { comment: { body: "Found it, thanks!" }, solved: true } },
+          headers: json_headers(account: "acme", token: @customer_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("request", "status")
+  end
+end
diff --git a/test/integration/security_and_edge_cases_test.rb b/test/integration/security_and_edge_cases_test.rb
new file mode 100644
index 0000000..4b39d21
--- /dev/null
+++ b/test/integration/security_and_edge_cases_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class SecurityAndEdgeCasesTest < ActionDispatch::IntegrationTest
+  test "tokens are stored only as digests, never in plaintext" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+
+    _url, _acct, verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+    assert_nil UserToken.find_by(token_digest: verify_token)
+    assert UserToken.find_by(token_digest: UserToken.digest(verify_token)).present?
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: verify_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    session_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    assert_nil Session.find_by(token_digest: session_token)
+    assert Session.find_by(token_digest: Session.digest(session_token)).present?
+  end
+
+  test "email and subdomain normalization works across all endpoints" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "  Acme Corp  ",
+             subdomain: "  AcMe-1  ",
+             admin: { name: "  Jo  ", email: "  JO@AcMe.TEST  ", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+    assert_equal "Acme Corp", json_body.dig("account", "name")
+    assert_equal "acme-1", json_body.dig("account", "subdomain")
+    assert_equal "Jo", json_body.dig("user", "name")
+    assert_equal "jo@acme.test", json_body.dig("user", "email")
+
+    # Resend verification with uppercase email and header
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "JO@ACME.TEST" } },
+         headers: json_headers(account: "ACME-1"),
+         as: :json
+    assert_response :ok
+    _u, _a, token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token } },
+         headers: json_headers(account: "ACME-1"),
+         as: :json
+    assert_response :ok
+
+    # Login with uppercase email
+    login = sign_in!(subdomain: "ACME-1", email: "JO@ACME.TEST", password: "my-first-password")
+    assert login.dig("session", "token").present?
+  end
+
+  test "authorization header edge cases" do
+    signup_and_verify!(subdomain: "acme")
+    token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Case-insensitive Bearer scheme works
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "bearer #{token}" }
+    assert_response :ok
+
+    # Invalid schemes and blank tokens fail
+    [ "Basic #{token}", "Token #{token}", "Bearer", "Bearer   ", token ].each do |auth_header|
+      get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => auth_header }
+      assert_response :unauthorized, "Expected 401 for Authorization: #{auth_header.inspect}"
+    end
+  end
+
+  test "password blank and max length edge cases" do
+    # > 72 bytes rejected on signup
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "a" * 73 }
+           }
+         },
+         as: :json
+    assert_response :unprocessable_content
+
+    signup_and_verify!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Blank password on PUT /me/password fails with 422
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "" } },
+        headers: json_headers(account: "acme", token: token),
+        as: :json
+    assert_response :unprocessable_content
+
+    # Missing password key on PUT /me/password fails with 422
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password" } },
+        headers: json_headers(account: "acme", token: token),
+        as: :json
+    assert_response :unprocessable_content
+
+    # > 72 bytes on PUT /me/password fails with 422
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "b" * 73 } },
+        headers: json_headers(account: "acme", token: token),
+        as: :json
+    assert_response :unprocessable_content
+
+    # > 72 bytes on login returns 401 cleanly
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "a" * 80 } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unauthorized
+  end
+
+  test "previously issued tokens are blocked while account is cancelled and exact 90-day boundary is enforced" do
+    signup_and_verify!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Request a password reset token before cancellation
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    _u, _a, reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+
+    # Cancel account
+    post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: token)
+    assert_response :ok
+
+    # Confirming previously issued reset token fails with 403 while cancelled
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: reset_token, password: "my-new-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    # At exactly 90 days ago with frozen time, account is expired & purgeable
+    freeze_time do
+      account = Account.find_by!(subdomain: "acme")
+      account.update_column(:cancelled_at, 90.days.ago)
+
+      assert account.reactivation_expired?
+      assert_not account.reactivatable?
+      assert_equal 1, Account.purge_cancelled!
+      assert_not Account.exists?(account.id)
+    end
+  end
+end
diff --git a/test/integration/ticket_assignments_and_private_notes_test.rb b/test/integration/ticket_assignments_and_private_notes_test.rb
new file mode 100644
index 0000000..b6edbf9
--- /dev/null
+++ b/test/integration/ticket_assignments_and_private_notes_test.rb
@@ -0,0 +1,298 @@
+require "test_helper"
+
+class TicketAssignmentsAndPrivateNotesTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme_signup = signup_and_verify!(
+      name: "Acme",
+      subdomain: "acme",
+      admin_name: "Jo",
+      email: "jo@acme.test",
+      password: "my-first-password"
+    )
+    @owner_id = @acme_signup.dig("user", "id")
+    @owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    post "/api/v1/invitations",
+         params: { invitation: { email: "sam@acme.test", role: "agent" } },
+         headers: json_headers(account: "acme", token: @owner_token),
+         as: :json
+    assert_response :created
+    _u, _a, sam_inv_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/accept-invitation")
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: sam_inv_token, name: "Sam", password: "sam-password-1" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :created
+    @agent_id = json_body.dig("user", "id")
+    @agent_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password-1").dig("session", "token")
+
+    @customer_data = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password-1")
+    @customer_id = @customer_data.dig("user", "id")
+    @customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "avery-password-1").dig("session", "token")
+
+    @globex_signup = signup_and_verify!(
+      name: "Globex",
+      subdomain: "globex",
+      admin_name: "Pat",
+      email: "pat@globex.test",
+      password: "globex-password-1"
+    )
+    @globex_owner_id = @globex_signup.dig("user", "id")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "staff (admins and agents) can assign, reassign, and clear tickets; assignee info appears on tickets only" do
+    post "/api/v1/requests",
+         params: { request: { subject: "Billing bug", comment: { body: "Charged twice" } } },
+         headers: json_headers(account: "acme", token: @customer_token),
+         as: :json
+    assert_response :created
+    ticket_id = json_body.dig("request", "id")
+    assert_not json_body["request"].key?("assignee_id")
+    assert_not json_body["request"].key?("assignee")
+
+    # Initially unassigned on /tickets and /tickets/:id
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_nil json_body["tickets"].first["assignee_id"]
+    assert_nil json_body["tickets"].first["assignee"]
+
+    get "/api/v1/tickets/#{ticket_id}", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+
+    # Admin assigns to agent Sam
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { assignee_id: @agent_id } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal @agent_id, json_body.dig("ticket", "assignee_id")
+    assert_equal({ "id" => @agent_id, "name" => "Sam" }, json_body.dig("ticket", "assignee"))
+
+    # Agent reassigns to admin Jo
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { assignee_id: @owner_id } },
+          headers: json_headers(account: "acme", token: @agent_token),
+          as: :json
+    assert_response :ok
+    assert_equal @owner_id, json_body.dig("ticket", "assignee_id")
+    assert_equal({ "id" => @owner_id, "name" => "Jo" }, json_body.dig("ticket", "assignee"))
+
+    # Profile name change reflects dynamically in ticket.assignee.name
+    patch "/api/v1/me",
+          params: { user: { name: "Jo Owner" } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets/#{ticket_id}", headers: json_headers(account: "acme", token: @agent_token)
+    assert_response :ok
+    assert_equal({ "id" => @owner_id, "name" => "Jo Owner" }, json_body.dig("ticket", "assignee"))
+
+    # Agent clears assignment with null
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { assignee_id: nil } },
+          headers: json_headers(account: "acme", token: @agent_token),
+          as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+
+    # Rejects customer, cross-account staff, non-existent ID, and malformed values
+    [ @customer_id, @globex_owner_id, 999_999, 0, -1, "", "abc", true, false, [ @agent_id ], { id: @agent_id } ].each do |bad_assignee|
+      patch "/api/v1/tickets/#{ticket_id}",
+            params: { ticket: { assignee_id: bad_assignee } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content, "Expected 422 for assignee_id=#{bad_assignee.inspect}"
+    end
+
+    # Atomicity: invalid assignee_id with valid comment/status rolls back everything
+    assert_no_difference "TicketComment.count" do
+      patch "/api/v1/tickets/#{ticket_id}",
+            params: { ticket: { assignee_id: @customer_id, status: "pending", comment: { body: "Should rollback" } } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "open", Ticket.find(ticket_id).status
+      assert_nil Ticket.find(ticket_id).assignee_id
+    end
+
+    # Atomicity: valid assignee_id with blank comment rolls back assignment too
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { assignee_id: @agent_id, comment: { body: "   " } } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
+    assert_response :unprocessable_content
+    assert_nil Ticket.find(ticket_id).assignee_id
+
+    # Customer cannot set assignee_id via /requests/:id and never sees it on /requests
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { assignee_id: @agent_id } },
+          headers: json_headers(account: "acme", token: @customer_token),
+          as: :json
+    assert_response :unprocessable_content
+    assert_nil Ticket.find(ticket_id).assignee_id
+  end
+
+  test "private notes and assignments do not change the customer-facing request timestamp, ordering, status, or comments" do
+    req_a_id = nil
+    req_b_id = nil
+    req_a_initial = nil
+    req_b_initial = nil
+
+    travel_to Time.zone.parse("2026-11-22 10:00:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Request A", comment: { body: "First issue" } } },
+           headers: json_headers(account: "acme", token: @customer_token),
+           as: :json
+      assert_response :created
+      req_a_initial = json_body["request"]
+      req_a_id = req_a_initial["id"]
+    end
+
+    travel_to Time.zone.parse("2026-11-22 10:01:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Request B", comment: { body: "Second issue" } } },
+           headers: json_headers(account: "acme", token: @customer_token),
+           as: :json
+      assert_response :created
+      req_b_initial = json_body["request"]
+      req_b_id = req_b_initial["id"]
+    end
+
+    # Baseline order for both staff and customer: [B, A]
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal [ req_b_id, req_a_id ], json_body["requests"].map { |r| r["id"] }
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @agent_token)
+    assert_equal [ req_b_id, req_a_id ], json_body["tickets"].map { |t| t["id"] }
+
+    # 1. Agent adds a private note on Request A at 10:05
+    travel_to Time.zone.parse("2026-11-22 10:05:00 UTC") do
+      patch "/api/v1/tickets/#{req_a_id}",
+            params: { ticket: { comment: { body: "Checking this with billing.", public: false } } },
+            headers: json_headers(account: "acme", token: @agent_token),
+            as: :json
+      assert_response :ok
+    end
+
+    # Staff sees A floated to top with updated_at = 10:05 and sees the private note
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @agent_token)
+    assert_equal [ req_a_id, req_b_id ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal Time.zone.parse("2026-11-22 10:05:00 UTC").iso8601(3), json_body["tickets"].first["updated_at"]
+
+    get "/api/v1/tickets/#{req_a_id}/comments", headers: json_headers(account: "acme", token: @agent_token)
+    assert_equal 2, json_body["count"]
+    assert_equal [ true, false ], json_body["comments"].map { |c| c["public"] }
+    assert_equal "Checking this with billing.", json_body["comments"].last["body"]
+
+    # Customer-facing request A and list order are COMPLETELY UNCHANGED!
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal [ req_b_id, req_a_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{req_a_id}", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal req_a_initial, json_body["request"]
+
+    get "/api/v1/requests/#{req_a_id}/comments", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal 1, json_body["count"]
+    assert_equal [ "First issue" ], json_body["comments"].map { |c| c["body"] }
+
+    # 2. Staff assigns Request A and adds another private note (plus unchanged status: open) at 10:06
+    travel_to Time.zone.parse("2026-11-22 10:06:00 UTC") do
+      patch "/api/v1/tickets/#{req_a_id}",
+            params: {
+              ticket: {
+                assignee_id: @agent_id,
+                status: "open",
+                comment: { body: "Assigning to Sam internally.", public: false }
+              }
+            },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+    end
+
+    # Customer-facing request A is STILL completely unchanged!
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal [ req_b_id, req_a_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{req_a_id}", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal req_a_initial, json_body["request"]
+
+    get "/api/v1/requests/#{req_a_id}/comments", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal 1, json_body["count"]
+
+    # 3. Staff clears assignment at 10:07 -> customer-facing request STILL unchanged!
+    travel_to Time.zone.parse("2026-11-22 10:07:00 UTC") do
+      patch "/api/v1/tickets/#{req_a_id}",
+            params: { ticket: { assignee_id: nil } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests/#{req_a_id}", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal req_a_initial, json_body["request"]
+
+    # 4. Staff changes status to pending + adds private note at 10:10 ->
+    # customer sees status change & updated_at=10:10, A floats to top, private note stays hidden!
+    travel_to Time.zone.parse("2026-11-22 10:10:00 UTC") do
+      patch "/api/v1/tickets/#{req_a_id}",
+            params: {
+              ticket: {
+                status: "pending",
+                comment: { body: "Waiting on internal audit.", public: false }
+              }
+            },
+            headers: json_headers(account: "acme", token: @agent_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal [ req_a_id, req_b_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{req_a_id}", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal "pending", json_body.dig("request", "status")
+    assert_equal Time.zone.parse("2026-11-22 10:10:00 UTC").iso8601(3), json_body.dig("request", "updated_at")
+
+    get "/api/v1/requests/#{req_a_id}/comments", headers: json_headers(account: "acme", token: @customer_token)
+    assert_equal 1, json_body["count"]
+
+    # 5. Staff posts a private note on a pending/solved ticket -> status does NOT reopen, request unchanged!
+    req_a_after_pending = nil
+    get "/api/v1/requests/#{req_a_id}", headers: json_headers(account: "acme", token: @customer_token)
+    req_a_after_pending = json_body["request"]
+
+    travel_to Time.zone.parse("2026-11-22 10:12:00 UTC") do
+      patch "/api/v1/tickets/#{req_a_id}",
+            params: { ticket: { comment: { body: "Follow-up private note", public: false } } },
+            headers: json_headers(account: "acme", token: @agent_token),
