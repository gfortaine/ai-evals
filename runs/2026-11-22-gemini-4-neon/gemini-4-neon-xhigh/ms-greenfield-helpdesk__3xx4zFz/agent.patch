+      assert_response :not_found
+      get "/api/v1/group_memberships/#{bad_id}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :not_found
+      put "/api/v1/group_memberships/#{bad_id}/make_default", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :not_found
+      delete "/api/v1/group_memberships/#{bad_id}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :not_found
+    end
+
+    # Suspend Sam -> admins can still manage Sam's memberships (add, make_default, delete with default promotion)
+    patch "/api/v1/users/#{@agent_id}",
+          params: { user: { suspended: true } },
+          headers: json_headers(account: "acme", token: @owner_token),
+          as: :json
