+
+  test "edge cases: string IDs, malformed path IDs, non-hash envelopes, suspended staff membership management, and filtered pagination" do
+    billing = create_group!(name: "Billing")
+    support = create_group!(name: "Technical Support")
+    sales = create_group!(name: "Sales")
+
