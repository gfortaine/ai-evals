+  test "merge notes never send email, closed tickets reject incoming email replies, and surviving ticket keeps its email identity" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      # Create two email-origin tickets for Avery
+      post_raw_email(build_raw_email(
