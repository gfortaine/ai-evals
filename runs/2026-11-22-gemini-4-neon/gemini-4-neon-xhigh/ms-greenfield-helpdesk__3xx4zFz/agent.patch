+++ b/app/models/user.rb
@@ -0,0 +1,116 @@
+class User < ApplicationRecord
+  ROLES = %w[admin agent customer].freeze
+  STAFF_ROLES = %w[admin agent].freeze
+  MIN_PASSWORD_LENGTH = 8
+
+  has_secure_password
+
+  belongs_to :account
+  has_many :sessions, dependent: :destroy
+  has_many :user_tokens, dependent: :destroy
+  has_many :group_memberships, dependent: :destroy, inverse_of: :user
+  has_many :groups, through: :group_memberships
+  has_many :requested_tickets, class_name: "Ticket", foreign_key: :requester_id, dependent: :destroy, inverse_of: :requester
+  has_many :assigned_tickets, class_name: "Ticket", foreign_key: :assignee_id, dependent: :nullify, inverse_of: :assignee
+  has_many :ticket_comments, foreign_key: :author_id, dependent: :destroy, inverse_of: :author
+  has_many :sent_invitations, class_name: "Invitation", foreign_key: :invited_by_id, dependent: :nullify, inverse_of: :invited_by
+
+  normalizes :name, with: ->(name) { name.to_s.strip }
+  normalizes :email, with: ->(email) { email.to_s.strip.downcase }
+
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :email,
+            presence: true,
+            length: { maximum: 255 },
+            format: { with: URI::MailTo::EMAIL_REGEXP },
+            uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, presence: true, inclusion: { in: ROLES }
+  validates :password, length: { minimum: MIN_PASSWORD_LENGTH }, if: -> { password.present? }
+  validate :password_must_not_be_blank
+
+  scope :by_id_asc, -> { order(id: :asc) }
+  scope :active, -> { where(suspended_at: nil) }
+  scope :suspended, -> { where.not(suspended_at: nil) }
+  scope :staff, -> { where(role: STAFF_ROLES) }
+  scope :admins, -> { where(role: "admin") }
+
+  def verified?
+    verified_at.present?
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def active?
+    !suspended?
+  end
+
+  def owner?
+    id.present? && account.present? && account.owner_id == id
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def agent?
+    role == "agent"
+  end
+
+  def staff?
+    STAFF_ROLES.include?(role)
+  end
+
+  def customer?
+    role == "customer"
+  end
+
+  def default_group_membership
+    group_memberships.find_by(default: true)
+  end
+
+  def default_group
+    default_group_membership&.group
+  end
+
+  def verify!
+    update!(verified_at: Time.current) unless verified?
+  end
+
+  def revoke_all_sessions!
+    now = Time.current
+    sessions.active.update_all(revoked_at: now, updated_at: now)
+  end
+
+  def clear_ticket_assignments!(now: Time.current)
+    assigned_tickets.update_all(assignee_id: nil, updated_at: now)
+  end
+
+  def revoke_tokens!(purpose:)
+    now = Time.current
+    user_tokens.where(purpose: purpose, used_at: nil, revoked_at: nil).update_all(revoked_at: now, updated_at: now)
+  end
+
+  def update_password_and_revoke_sessions!(new_password)
+    transaction do
+      if !new_password.is_a?(String) || new_password.blank?
+        errors.add(:password, :blank)
+        raise ActiveRecord::RecordInvalid, self
+      end
+
+      self.password = new_password
+      save!
+      revoke_all_sessions!
+      revoke_tokens!(purpose: UserToken::PASSWORD_RESET)
+    end
+  end
+
+  private
+
+  def password_must_not_be_blank
+    return unless password.is_a?(String) && password.blank?
+
+    errors.add(:password, :blank) unless errors.added?(:password, :blank)
+  end
+end
diff --git a/app/models/user_token.rb b/app/models/user_token.rb
new file mode 100644
index 0000000..e0f944c
--- /dev/null
+++ b/app/models/user_token.rb
@@ -0,0 +1,65 @@
+require "digest"
+require "securerandom"
+
+class UserToken < ApplicationRecord
+  EMAIL_VERIFICATION = "email_verification"
+  PASSWORD_RESET = "password_reset"
+  PURPOSES = [ EMAIL_VERIFICATION, PASSWORD_RESET ].freeze
+  TTL = {
+    EMAIL_VERIFICATION => 24.hours,
+    PASSWORD_RESET => 2.hours
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+
+  validates :purpose, presence: true, inclusion: { in: PURPOSES }
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  scope :for_purpose, ->(purpose) { where(purpose: purpose) }
+  scope :usable, -> { where(used_at: nil, revoked_at: nil).where("expires_at > ?", Time.current) }
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token)
+  end
+
+  def self.issue_for(user:, purpose:)
+    ttl = TTL.fetch(purpose)
+    raw_token = SecureRandom.urlsafe_base64(32)
+
+    token_record = transaction do
+      now = Time.current
+      user.user_tokens.where(purpose: purpose, used_at: nil, revoked_at: nil)
+          .update_all(revoked_at: now, updated_at: now)
+
+      create!(
+        account: user.account,
+        user: user,
+        purpose: purpose,
+        token_digest: digest(raw_token),
+        expires_at: now + ttl
+      )
+    end
+
+    [ token_record, raw_token ]
+  end
+
+  def self.find_usable(account:, purpose:, raw_token:)
+    return nil unless account.present? && raw_token.is_a?(String) && raw_token.present?
+
+    usable.includes(:user).find_by(
+      account_id: account.id,
+      purpose: purpose,
+      token_digest: digest(raw_token)
+    )
+  end
+
+  def usable?
+    used_at.nil? && revoked_at.nil? && expires_at > Time.current
+  end
+
+  def consume!
+    update!(used_at: Time.current)
+  end
+end
diff --git a/app/services/account_signup.rb b/app/services/account_signup.rb
new file mode 100644
index 0000000..2c9ef8f
--- /dev/null
+++ b/app/services/account_signup.rb
@@ -0,0 +1,63 @@
+class AccountSignup
+  Result = Struct.new(:success?, :account, :user, :errors, keyword_init: true)
+
+  def initialize(account_params:, admin_params:)
+    @account_params = account_params
+    @admin_params = admin_params
+  end
+
+  def call
+    account = Account.new(
+      name: @account_params[:name],
+      subdomain: @account_params[:subdomain]
+    )
+    user = User.new(
+      account: account,
+      name: @admin_params[:name],
+      email: @admin_params[:email],
+      password: @admin_params[:password],
+      role: "admin"
+    )
+
+    errors = collect_errors(account, user)
+    return Result.new(success?: false, account: account, user: user, errors: errors) if errors.any?
+
+    raw_token = nil
+    ActiveRecord::Base.transaction do
+      account.save!
+      user.account = account
+      user.save!
+      account.update!(owner: user)
+      _record, raw_token = UserToken.issue_for(user: user, purpose: UserToken::EMAIL_VERIFICATION)
+    end
+
+    UserMailer.email_verification(user: user, token: raw_token).deliver_now
+
+    Result.new(success?: true, account: account.reload, user: user.reload, errors: {})
+  rescue ActiveRecord::RecordInvalid => e
+    Result.new(success?: false, account: account, user: user, errors: e.record.errors.to_hash(true))
+  rescue ActiveRecord::RecordNotUnique
+    Result.new(success?: false, account: account, user: user, errors: { subdomain: [ "Subdomain has already been taken" ] })
+  end
+
+  private
+
+  def collect_errors(account, user)
+    errors = {}
+    unless account.valid?
+      account.errors.each do |error|
+        (errors[error.attribute.to_s] ||= []) << error.full_message
+      end
+    end
+
+    unless user.valid?
+      user.errors.each do |error|
+        next if error.attribute == :account
+
+        (errors["admin.#{error.attribute}"] ||= []) << error.full_message
+      end
+    end
+
+    errors
+  end
+end
diff --git a/app/services/cursor_codec.rb b/app/services/cursor_codec.rb
new file mode 100644
index 0000000..638f9c5
--- /dev/null
+++ b/app/services/cursor_codec.rb
@@ -0,0 +1,93 @@
+class CursorCodec
+  VERSION = 1
+  MAX_TOKEN_BYTES = 2048
+  MIN_BIGINT = -(1 << 63)
+  MAX_BIGINT = (1 << 63) - 1
+  MIN_USEC = Time.utc(1, 1, 1).to_i * 1_000_000
+  MAX_USEC = (Time.utc(9999, 12, 31, 23, 59, 59).to_i * 1_000_000) + 999_999
+
+  class << self
+    def encode(context:, columns:, record:)
+      encoded_values = columns.map do |col|
+        encode_value(record.public_send(col), col)
+      end
+
+      payload = {
+        "v" => VERSION,
+        "c" => context.to_s,
+        "k" => encoded_values
+      }
+
+      verifier.generate(payload)
+    end
+
+    def decode(token, expected_context:, columns:, model_class:)
+      return nil unless valid_token_string?(token)
+
+      payload = verifier.verified(token)
+      return nil unless payload.is_a?(Hash)
+      return nil unless payload["v"] == VERSION
+      return nil unless payload["c"] == expected_context.to_s
+
+      raw_values = payload["k"]
+      return nil unless raw_values.is_a?(Array) && raw_values.size == columns.size
+
+      decoded = []
+      columns.each_with_index do |col, idx|
+        col_type = model_class.columns_hash[col.to_s]&.type
+        value = decode_value(raw_values[idx], col_type)
+        return nil if value.nil?
+
+        decoded << value
+      end
+
+      decoded
+    rescue ActiveSupport::MessageVerifier::InvalidSignature, JSON::ParserError, ArgumentError
+      nil
+    end
+
+    private
+
+    def verifier
+      @verifier ||= begin
+        secret = Rails.application.key_generator.generate_key("api_v1_cursor_v1", 32)
+        ActiveSupport::MessageVerifier.new(secret, digest: "SHA256", serializer: JSON, url_safe: true)
+      end
+    end
+
+    def valid_token_string?(token)
+      token.is_a?(String) &&
+        token.valid_encoding? &&
+        !token.include?("\x00") &&
+        token.bytesize.between?(1, MAX_TOKEN_BYTES)
+    end
+
+    def encode_value(value, column)
+      case value
+      when Time, ActiveSupport::TimeWithZone
+        utc = value.utc
+        (utc.to_i * 1_000_000) + utc.usec
+      when Integer
+        value
+      else
+        raise ArgumentError, "Unsupported cursor value type #{value.class} for column #{column}"
+      end
+    end
+
+    def decode_value(raw, col_type)
+      case col_type
+      when :datetime, :timestamp
+        return nil unless raw.is_a?(Integer) && raw.between?(MIN_USEC, MAX_USEC)
+
+        sec, usec = raw.divmod(1_000_000)
+        Time.at(sec, usec, :usec).utc
+      when :integer
+        return nil unless raw.is_a?(Integer) && raw.between?(MIN_BIGINT, MAX_BIGINT)
+
+        raw
+      else
+        nil
+      end
+    end
+  end
+end
diff --git a/app/services/cursor_paginator.rb b/app/services/cursor_paginator.rb
new file mode 100644
index 0000000..aec3bcb
--- /dev/null
+++ b/app/services/cursor_paginator.rb
@@ -0,0 +1,228 @@
+class CursorPaginator
+  Result = Struct.new(
+    :success?,
+    :records,
+    :has_more,
+    :has_next,
+    :has_prev,
+    :after_cursor,
+    :before_cursor,
+    :size,
+    :errors,
+    keyword_init: true
+  )
+
+  def initialize(scope:, order:, context:, size:, after: nil, before: nil)
+    @scope = scope
+    @order = normalize_order(order)
+    @columns = @order.map(&:first)
+    @context = context.to_s
+    @size = size
+    @after = after
+    @before = before
+  end
+
+  def call
+    if @after.present?
+      paginate_after
+    elsif @before.present?
+      paginate_before
+    else
+      paginate_initial
+    end
+  end
+
+  private
+
+  def paginate_initial
+    fetched = @scope.reorder(forward_order_sql).limit(@size + 1).to_a
+    has_more = fetched.size > @size
+    records = has_more ? fetched.first(@size) : fetched
+
+    build_success(
+      records: records,
+      has_more: has_more,
+      has_next: has_more,
+      has_prev: false
+    )
+  end
+
+  def paginate_after
+    cursor_values = decode_cursor(@after)
+    return invalid_cursor_result("page[after]") unless cursor_values
+
+    fetched = apply_keyset(@scope, cursor_values, direction: :after)
+                .reorder(forward_order_sql)
+                .limit(@size + 1)
+                .to_a
+    has_more = fetched.size > @size
+    records = has_more ? fetched.first(@size) : fetched
+    has_prev = records.any? && exists_in_direction?(records.first, direction: :before)
+
+    build_success(
+      records: records,
+      has_more: has_more,
+      has_next: has_more,
+      has_prev: has_prev
+    )
+  end
+
+  def paginate_before
+    cursor_values = decode_cursor(@before)
+    return invalid_cursor_result("page[before]") unless cursor_values
+
+    fetched = apply_keyset(@scope, cursor_values, direction: :before)
+                .reorder(reversed_order_sql)
+                .limit(@size + 1)
+                .to_a
+    has_more = fetched.size > @size
+    records = (has_more ? fetched.first(@size) : fetched).reverse
+    has_next = records.any? && exists_in_direction?(records.last, direction: :after)
+
+    build_success(
+      records: records,
+      has_more: has_more,
+      has_next: has_next,
+      has_prev: has_more
+    )
+  end
+
+  def build_success(records:, has_more:, has_next:, has_prev:)
+    if records.any?
+      before_cursor = encode_cursor(records.first)
+      after_cursor = encode_cursor(records.last)
+    else
+      before_cursor = nil
+      after_cursor = nil
+      has_next = false
+      has_prev = false
+    end
+
+    Result.new(
+      success?: true,
+      records: records,
+      has_more: has_more,
+      has_next: has_next,
+      has_prev: has_prev,
+      after_cursor: after_cursor,
+      before_cursor: before_cursor,
+      size: @size,
+      errors: {}
+    )
+  end
+
+  def invalid_cursor_result(param_key)
+    Result.new(
+      success?: false,
+      records: [],
+      has_more: false,
+      has_next: false,
+      has_prev: false,
+      after_cursor: nil,
+      before_cursor: nil,
+      size: @size,
+      errors: { param_key => [ "Cursor is invalid" ] }
+    )
+  end
+
+  def encode_cursor(record)
+    CursorCodec.encode(context: @context, columns: @columns, record: record)
+  end
+
+  def decode_cursor(token)
+    CursorCodec.decode(
+      token,
+      expected_context: @context,
+      columns: @columns,
+      model_class: @scope.klass
+    )
+  end
+
+  def exists_in_direction?(record, direction:)
+    values = extract_record_values(record)
+    dir_order = direction == :after ? forward_order_sql : reversed_order_sql
+    base = @scope.except(:includes, :preload, :eager_load, :order, :limit, :offset)
+
+    apply_keyset(base, values, direction: direction)
+      .reorder(dir_order)
+      .limit(1)
+      .pluck(Arel.sql("1"))
+      .any?
+  end
+
+  def extract_record_values(record)
+    @columns.map do |col|
+      value = record.public_send(col)
+      if value.is_a?(Time) || value.is_a?(ActiveSupport::TimeWithZone)
+        utc = value.utc
+        Time.at(utc.to_i, utc.usec, :usec).utc
+      else
+        value
+      end
+    end
+  end
+
+  def apply_keyset(relation, values, direction:)
+    quoted_cols = @columns.map { |col| qualified_column(col) }
+    operators = @order.map { |_col, dir| comparison_operator(dir, direction) }
+
+    if quoted_cols.size == 1
+      relation.where("#{quoted_cols[0]} #{operators[0]} ?", values[0])
+    elsif operators.uniq.size == 1
+      placeholders = Array.new(quoted_cols.size, "?").join(", ")
+      relation.where("(#{quoted_cols.join(', ')}) #{operators[0]} (#{placeholders})", *values)
+    else
+      clauses = []
+      binds = []
+      quoted_cols.each_index do |idx|
+        parts = []
+        idx.times do |prev_idx|
+          parts << "#{quoted_cols[prev_idx]} = ?"
+          binds << values[prev_idx]
+        end
+        parts << "#{quoted_cols[idx]} #{operators[idx]} ?"
+        binds << values[idx]
+        clauses << "(#{parts.join(' AND ')})"
+      end
+      relation.where("(#{clauses.join(' OR ')})", *binds)
+    end
+  end
+
+  def comparison_operator(column_direction, browse_direction)
+    if browse_direction == :after
+      column_direction == :asc ? ">" : "<"
+    else
+      column_direction == :asc ? "<" : ">"
+    end
+  end
+
+  def forward_order_sql
+    @forward_order_sql ||= Arel.sql(
+      @order.map { |col, dir| "#{qualified_column(col)} #{dir.to_s.upcase}" }.join(", ")
+    )
+  end
+
+  def reversed_order_sql
+    @reversed_order_sql ||= Arel.sql(
+      @order.map { |col, dir| "#{qualified_column(col)} #{dir == :asc ? 'DESC' : 'ASC'}" }.join(", ")
+    )
+  end
+
+  def qualified_column(col)
+    conn = @scope.klass.connection
+    "#{conn.quote_table_name(@scope.table_name)}.#{conn.quote_column_name(col)}"
+  end
+
+  def normalize_order(order)
+    raise ArgumentError, "cursor_order must be a non-empty array" unless order.is_a?(Array) && order.any?
+
+    order.map do |col, dir|
+      dir_sym = dir.to_sym
+      unless dir_sym == :asc || dir_sym == :desc
+        raise ArgumentError, "Invalid order direction: #{dir.inspect}"
+      end
+
+      [ col.to_sym, dir_sym ]
+    end
+  end
+end
diff --git a/app/services/customer_registration.rb b/app/services/customer_registration.rb
new file mode 100644
index 0000000..bcbd14f
--- /dev/null
+++ b/app/services/customer_registration.rb
@@ -0,0 +1,54 @@
+class CustomerRegistration
+  Result = Struct.new(:success?, :user, :errors, keyword_init: true)
+
+  def initialize(account:, user_params:)
+    @account = account
+    @user_params = user_params
+  end
+
+  def call
+    user = @account.users.build(
+      name: @user_params[:name],
+      email: @user_params[:email],
+      password: @user_params[:password],
+      role: "customer"
+    )
+
+    errors = {}
+    raw_token = nil
+
+    ActiveRecord::Base.transaction do
+      @account.lock!
+      now = Time.current
+
+      unless user.valid?
+        user.errors.each do |error|
+          (errors[error.attribute.to_s] ||= []) << error.full_message
+        end
+      end
+
+      if user.email.present? && errors["email"].blank? && @account.invitations.pending(now).exists?(email: user.email)
+        (errors["email"] ||= []) << "Email has a pending invitation"
+      end
+
+      if errors.any?
+        raise ActiveRecord::Rollback
+      end
+
+      user.save!
+      _record, raw_token = UserToken.issue_for(user: user, purpose: UserToken::EMAIL_VERIFICATION)
+    end
+
+    if errors.any?
+      return Result.new(success?: false, user: user, errors: errors)
+    end
+
+    UserMailer.email_verification(user: user, token: raw_token).deliver_now
+
+    Result.new(success?: true, user: user.reload, errors: {})
+  rescue ActiveRecord::RecordInvalid => e
+    Result.new(success?: false, user: user, errors: e.record.errors.to_hash(true))
+  rescue ActiveRecord::RecordNotUnique
+    Result.new(success?: false, user: user, errors: { email: [ "Email has already been taken" ] })
+  end
+end
diff --git a/app/services/group_deletion.rb b/app/services/group_deletion.rb
new file mode 100644
index 0000000..c21f525
--- /dev/null
+++ b/app/services/group_deletion.rb
@@ -0,0 +1,27 @@
+class GroupDeletion
+  def initialize(account:, group:)
+    @account = account
+    @group = group
+  end
+
+  def call
+    ActiveRecord::Base.transaction do
+      @account.lock!
+      group = @account.groups.lock.find(@group.id)
+      now = Time.current
+
+      affected_default_user_ids = group.group_memberships.where(default: true).pluck(:user_id)
+
+      @account.tickets
+              .where(group_id: group.id)
+              .update_all(group_id: nil, assignee_id: nil, updated_at: now)
+
+      group.destroy!
+
+      affected_default_user_ids.each do |user_id|
+        replacement = @account.group_memberships.where(user_id: user_id).by_id_asc.first
+        replacement&.update!(default: true)
+      end
+    end
+  end
+end
diff --git a/app/services/group_membership_creation.rb b/app/services/group_membership_creation.rb
new file mode 100644
index 0000000..4afbfba
--- /dev/null
+++ b/app/services/group_membership_creation.rb
@@ -0,0 +1,130 @@
+class GroupMembershipCreation
+  MAX_BIGINT = (1 << 63) - 1
+  Result = Struct.new(:success?, :group_membership, :errors, keyword_init: true)
+
+  def initialize(account:, group_id:, user_id:, default_provided: false, default: nil)
+    @account = account
+    @group_id = group_id
+    @user_id = user_id
+    @default_provided = default_provided
+    @default = default
+  end
+
+  def call
+    errors = {}
+    membership = nil
+
+    ActiveRecord::Base.transaction do
+      @account.lock!
+      now = Time.current
+
+      group = resolve_group(errors)
+      user = resolve_user(errors)
+
+      if @default_provided && @default != true && @default != false
+        (errors["default"] ||= []) << "Default must be true or false"
+      end
+
+      if errors.any?
+        raise ActiveRecord::Rollback
+      end
+
+      user.lock!
+
+      if @account.group_memberships.exists?(group_id: group.id, user_id: user.id)
+        errors["user_id"] = [ "User is already a member of this group" ]
+        raise ActiveRecord::Rollback
+      end
+
+      has_existing_memberships = user.group_memberships.exists?
+      make_default = !has_existing_memberships || (@default_provided && @default == true)
+
+      if make_default && has_existing_memberships
+        user.group_memberships.where(default: true).update_all(default: false, updated_at: now)
+      end
+
+      membership = GroupMembership.new(
+        account: @account,
+        group: group,
+        user: user,
+        default: make_default
+      )
+
+      unless membership.valid?
+        membership.errors.each do |error|
+          (errors[error.attribute.to_s] ||= []) << error.full_message
+        end
+        raise ActiveRecord::Rollback
+      end
+
+      membership.save!
+    end
+
+    if errors.any?
+      Result.new(success?: false, group_membership: nil, errors: errors)
+    else
+      reloaded = @account.group_memberships.includes(:group, :user).find(membership.id)
+      Result.new(success?: true, group_membership: reloaded, errors: {})
+    end
+  rescue ActiveRecord::RecordNotUnique
+    Result.new(
+      success?: false,
+      group_membership: nil,
+      errors: { "user_id" => [ "User is already a member of this group" ] }
+    )
+  rescue ActiveRecord::RecordInvalid => e
+    Result.new(success?: false, group_membership: nil, errors: e.record.errors.to_hash(true))
+  end
+
+  private
+
+  def resolve_group(errors)
+    parsed_id = parse_positive_bigint(@group_id)
+    if parsed_id.nil?
+      (errors["group_id"] ||= []) << "Group must be a valid group in this account"
+      return nil
+    end
+
+    group = @account.groups.find_by(id: parsed_id)
+    unless group
+      (errors["group_id"] ||= []) << "Group must be a valid group in this account"
+      return nil
+    end
+
+    group
+  end
+
+  def resolve_user(errors)
+    parsed_id = parse_positive_bigint(@user_id)
+    if parsed_id.nil?
+      (errors["user_id"] ||= []) << "User must be a staff member in this account"
+      return nil
+    end
+
+    user = @account.users.find_by(id: parsed_id)
+    if user.nil?
+      (errors["user_id"] ||= []) << "User must be a staff member in this account"
+      return nil
+    elsif !user.staff?
+      (errors["user_id"] ||= []) << "User must be a staff member"
+      return nil
+    end
+
+    user
+  end
+
+  def parse_positive_bigint(raw)
+    value = case raw
+            when Integer
+              raw
+            when String
+              return nil unless /\A[1-9]\d*\z/.match?(raw)
+              Integer(raw, 10)
+            else
+              return nil
+            end
+    return nil unless value.positive? && value <= MAX_BIGINT
+
+    value
+  end
+end
diff --git a/app/services/group_membership_deletion.rb b/app/services/group_membership_deletion.rb
