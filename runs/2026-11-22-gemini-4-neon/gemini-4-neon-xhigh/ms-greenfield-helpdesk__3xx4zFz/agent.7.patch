+
+  get "/api/v1/requests?status=closed&page=1&per_page=1", headers: json_headers(account: "acme", token: @avery_token)
+  assert_response :ok
+  assert_equal 2, json_body["count"]
+  assert_equal 2, json_body["next_page"]
+  assert_equal [ t_closed_2["id"] ], json_body["requests"].map { |r| r["id"] }
+
+  get "/api/v1/requests?status=closed&page=2&per_page=1", headers: json_headers(account: "acme", token: @avery_token)
+  assert_response :ok
+  assert_equal 1, json_body["previous_page"]
+  assert_nil json_body["next_page"]
+  assert_equal [ t_closed_1["id"] ], json_body["requests"].map { |r| r["id"] }
+
+  # Closed portal-origin ticket also rejects incoming email replies to its reply_address
+  closed_portal = Ticket.find(t_closed_1["id"])
+  with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+    assert_no_difference [ "Ticket.count", "TicketComment.count" ] do
