+        to: closed_portal.reply_address,
+        subject: "Re: Portal dup 1",
+        body: "Replying by email to closed portal ticket",
+        message_id: "<portal-closed-reply@example.test>"
+      ))
+      assert_response :no_content
+    end
+    assert ActionMailbox::InboundEmail.order(:id).last.bounced?
+  end
+end
+end
