diff --git a/test/integration/customer_registration_and_flows_test.rb b/test/integration/customer_registration_and_flows_test.rb
new file mode 100644
index 0000000..2b4af10
--- /dev/null
+++ b/test/integration/customer_registration_and_flows_test.rb
@@ -0,0 +1,223 @@
+require "test_helper"
+
+class CustomerRegistrationAndFlowsTest < ActionDispatch::IntegrationTest
+  test "customer registration, verification, sign in, profile update, password change, recovery, and sign out" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    ActionMailer::Base.deliveries.clear
+
+    # 1. Register customer through portal
+    post "/api/v1/registrations",
+         params: {
+           user: {
+             name: "  Avery  ",
+             email: "  AVERY@Example.Test  ",
+             password: "my-customer-password",
+             role: "admin",
+             verified_at: Time.current.iso8601
+           }
+         },
+         headers: json_headers(account: "ACME"),
+         as: :json
+
+    assert_response :created
+    body = json_body
+    assert_kind_of Integer, body.dig("user", "id")
+    assert_equal "Avery", body.dig("user", "name")
+    assert_equal "avery@example.test", body.dig("user", "email")
+    assert_equal "customer", body.dig("user", "role")
+    assert_equal false, body.dig("user", "owner")
+    assert_equal false, body.dig("user", "verified")
+    assert_nil body.dig("user", "verified_at")
+    assert_not body["user"].key?("password_digest")
+
+    # 2. Verification email sent
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], mail.to
+    url, acct_param, first_token = extract_token_from_mail(mail, path: "/verify-email")
+    assert url.start_with?("http://localhost:3001/verify-email?account=acme&token=")
+    assert_equal "acme", acct_param
+
+    # 3. Cannot sign in before verifying
+    post "/api/v1/sessions",
+         params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :forbidden
+
+    # 4. Resend verification and confirm with new token
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "avery@example.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    _u2, _a2, second_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email")
+    assert_not_equal first_token, second_token
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: first_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: second_token } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+
+    # 5. Sign in as customer
+    login = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+    token = login.dig("session", "token")
+    assert token.present?
+    assert_equal "customer", login.dig("user", "role")
+
+    # 6. Profile read and update (cannot escalate role)
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token)
+    assert_response :ok
+    assert_equal "Avery", json_body.dig("user", "name")
+
+    patch "/api/v1/me",
+          params: { user: { name: "Avery Quinn", role: "admin", email: "other@example.test" } },
+          headers: json_headers(account: "acme", token: token),
+          as: :json
+    assert_response :ok
+    assert_equal "Avery Quinn", json_body.dig("user", "name")
+    assert_equal "customer", json_body.dig("user", "role")
+    assert_equal "avery@example.test", json_body.dig("user", "email")
+
+    # 7. Customer cannot cancel or reactivate account
+    post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: token)
+    assert_response :forbidden
+    post "/api/v1/account/reactivate", headers: json_headers(account: "acme", token: token)
+    assert_response :forbidden
+
+    # 8. Password change revokes sessions
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-customer-password", password: "updated-customer-pw" } },
+        headers: json_headers(account: "acme", token: token),
+        as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token)
+    assert_response :unauthorized
+
+    token2 = sign_in!(subdomain: "acme", email: "avery@example.test", password: "updated-customer-pw").dig("session", "token")
+
+    # 9. Password recovery flow
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "avery@example.test" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+    _ru, _ra, reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: reset_token, password: "recovered-customer-pw" } },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token2)
+    assert_response :unauthorized
+
+    token3 = sign_in!(subdomain: "acme", email: "avery@example.test", password: "recovered-customer-pw").dig("session", "token")
+
+    # 10. Sign out
+    delete "/api/v1/session", headers: json_headers(account: "acme", token: token3)
+    assert_response :no_content
+
+    get "/api/v1/me", headers: json_headers(account: "acme", token: token3)
+    assert_response :unauthorized
+  end
+
+  test "customer registration validations, multi-tenancy, and cancelled account checks" do
+    signup_and_verify!(name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    signup_and_verify!(name: "Globex", subdomain: "globex", email: "jo@globex.test")
+    ActionMailer::Base.deliveries.clear
+
+    # Missing/unknown account header
+    post "/api/v1/registrations",
+         params: { user: { name: "Avery", email: "avery@example.test", password: "my-customer-password" } },
+         as: :json
+    assert_response :bad_request
+
+    post "/api/v1/registrations",
+         params: { user: { name: "Avery", email: "avery@example.test", password: "my-customer-password" } },
+         headers: json_headers(account: "unknown"),
+         as: :json
+    assert_response :not_found
+
+    # Non-hash envelope
+    post "/api/v1/registrations",
+         params: { user: "invalid" },
+         headers: json_headers(account: "acme"),
+         as: :json
+    assert_response :bad_request
+
+    # Invalid inputs send no email
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      post "/api/v1/registrations",
+           params: { user: { name: "  ", email: "not-an-email", password: "short" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/registrations",
+           params: { user: { name: "Avery", email: "avery@example.test", password: "        " } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/registrations",
+           params: { user: { name: "Avery", email: "avery@example.test", password: "a" * 73 } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Cannot register with existing admin email in same account
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      post "/api/v1/registrations",
+           params: { user: { name: "Avery", email: "JO@ACME.TEST", password: "my-customer-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Register on Acme, then duplicate fails on Acme, but succeeds on Globex!
+    register_and_verify_customer!(subdomain: "acme", name: "Avery Acme", email: "avery@example.test", password: "acme-customer-pw")
+
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      post "/api/v1/registrations",
+           params: { user: { name: "Avery Dup", email: "AVERY@EXAMPLE.TEST", password: "another-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    register_and_verify_customer!(subdomain: "globex", name: "Avery Globex", email: "avery@example.test", password: "globex-customer-pw")
+
+    acme_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "acme-customer-pw").dig("session", "token")
+    globex_token = sign_in!(subdomain: "globex", email: "avery@example.test", password: "globex-customer-pw").dig("session", "token")
+
+    get "/api/v1/me", headers: json_headers(account: "globex", token: acme_token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: json_headers(account: "acme", token: globex_token)
+    assert_response :unauthorized
+
+    # Cancelled account rejects new customer registrations
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    post "/api/v1/account/cancel", headers: json_headers(account: "acme", token: owner_token)
+    assert_response :ok
+
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      post "/api/v1/registrations",
+           params: { user: { name: "Blocked", email: "blocked@example.test", password: "my-customer-password" } },
+           headers: json_headers(account: "acme"),
+           as: :json
+      assert_response :forbidden
+    end
+  end
+end
diff --git a/test/integration/pagination_ordering_and_validation_test.rb b/test/integration/pagination_ordering_and_validation_test.rb
new file mode 100644
index 0000000..6117785
--- /dev/null
+++ b/test/integration/pagination_ordering_and_validation_test.rb
@@ -0,0 +1,398 @@
+require "test_helper"
+
+class PaginationOrderingAndValidationTest < ActionDispatch::IntegrationTest
+  setup do
+    signup_and_verify!(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    @owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password-1")
+    @avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "avery-password-1").dig("session", "token")
+  end
+
+  test "empty lists return expected pagination metadata" do
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal(
+      { "requests" => [], "count" => 0, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+      json_body
+    )
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal(
+      { "tickets" => [], "count" => 0, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+      json_body
+    )
+  end
+
+  test "default and custom pagination across requests, tickets, and comments plus invalid pagination params" do
+    account = Account.find_by!(subdomain: "acme")
+    customer = account.users.find_by!(email: "avery@example.test")
+
+    base_time = Time.zone.parse("2026-11-22 10:00:00 UTC")
+    created_ids = (1..30).map do |i|
+      t = account.tickets.create!(
+        requester: customer,
+        subject: "Issue #{i}",
+        status: "open",
+        created_at: base_time + i.minutes,
+        updated_at: base_time + i.minutes
+      )
+      t.comments.create!(
+        account: account,
+        author: customer,
+        body: "Initial comment #{i}",
+        public: true,
+        created_at: base_time + i.minutes,
+        updated_at: base_time + i.minutes
+      )
+      t.update_columns(updated_at: base_time + i.minutes)
+      t.id
+    end
+
+    # Default pagination (page 1, per_page 25) - newest / most recently active first
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal 25, json_body["requests"].size
+    assert_equal created_ids.reverse.first(25), json_body["requests"].map { |r| r["id"] }
+
+    # Page 2
+    get "/api/v1/requests?page=2", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal created_ids.reverse.last(5), json_body["requests"].map { |r| r["id"] }
+
+    # Out-of-range page 3
+    get "/api/v1/requests?page=3", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [], json_body["requests"]
+    assert_equal 30, json_body["count"]
+    assert_nil json_body["next_page"]
+    assert_equal 2, json_body["previous_page"]
+
+    # Custom per_page on /tickets
+    get "/api/v1/tickets?page=2&per_page=10", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 10, json_body["per_page"]
+    assert_equal 3, json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal created_ids.reverse[10, 10], json_body["tickets"].map { |t| t["id"] }
+
+    # Invalid / extreme pagination parameters are safely normalized without error
+    get "/api/v1/tickets?page=0&per_page=-5", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+
+    get "/api/v1/tickets?page=abc&per_page=9999", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["page"]
+    assert_equal 100, json_body["per_page"]
+    assert_equal 30, json_body["tickets"].size
+
+    get "/api/v1/tickets?page=999999999999999999999999999", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+    assert_nil json_body["next_page"]
+
+    # Comments pagination (oldest first) on both /requests/:id/comments and /tickets/:id/comments
+    target_ticket = Ticket.find(created_ids.first)
+    owner = account.users.find_by!(email: "jo@acme.test")
+    (2..6).each do |n|
+      target_ticket.comments.create!(
+        account: account,
+        author: n.even? ? owner : customer,
+        body: "Comment #{n}",
+        public: true,
+        created_at: base_time + n.hours,
+        updated_at: base_time + n.hours
+      )
+    end
+
+    get "/api/v1/requests/#{target_ticket.id}/comments?page=1&per_page=2", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 6, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal [ "Initial comment 1", "Comment 2" ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/tickets/#{target_ticket.id}/comments?page=2&per_page=2", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 6, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 3, json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal [ "Comment 3", "Comment 4" ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/tickets/#{target_ticket.id}/comments?page=3&per_page=2", headers: json_headers(account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_nil json_body["next_page"]
+    assert_equal 2, json_body["previous_page"]
+    assert_equal [ "Comment 5", "Comment 6" ], json_body["comments"].map { |c| c["body"] }
+  end
+
+  test "recently active tickets and requests float to the top on reply or status change" do
+    id1 = nil
+    id2 = nil
+    id3 = nil
+
+    travel_to Time.zone.parse("2026-11-22 12:00:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "First", comment: { body: "One" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :created
+      id1 = json_body.dig("request", "id")
+    end
+
+    travel_to Time.zone.parse("2026-11-22 12:01:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Second", comment: { body: "Two" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :created
+      id2 = json_body.dig("request", "id")
+    end
+
+    travel_to Time.zone.parse("2026-11-22 12:02:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Third", comment: { body: "Three" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :created
+      id3 = json_body.dig("request", "id")
+    end
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ id3, id2, id1 ], json_body["tickets"].map { |t| t["id"] }
+
+    # Staff posts reply on First WITHOUT changing status -> First jumps to top!
+    travel_to Time.zone.parse("2026-11-22 12:05:00 UTC") do
+      patch "/api/v1/tickets/#{id1}",
+            params: { ticket: { comment: { body: "Working on First" } } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ id1, id3, id2 ], json_body["tickets"].map { |t| t["id"] }
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_equal [ id1, id3, id2 ], json_body["requests"].map { |r| r["id"] }
+
+    # Staff changes status on Second without comment -> Second jumps to top!
+    travel_to Time.zone.parse("2026-11-22 12:06:00 UTC") do
+      patch "/api/v1/tickets/#{id2}",
+            params: { ticket: { status: "pending" } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ id2, id1, id3 ], json_body["tickets"].map { |t| t["id"] }
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_equal [ id2, id1, id3 ], json_body["requests"].map { |r| r["id"] }
+
+    # Customer replies on Third -> Third jumps to top!
+    travel_to Time.zone.parse("2026-11-22 12:07:00 UTC") do
+      patch "/api/v1/requests/#{id3}",
+            params: { request: { comment: { body: "Bump on Third" } } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests", headers: json_headers(account: "acme", token: @avery_token)
+    assert_equal [ id3, id2, id1 ], json_body["requests"].map { |r| r["id"] }
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @owner_token)
+    assert_equal [ id3, id2, id1 ], json_body["tickets"].map { |t| t["id"] }
+  end
+
+  test "request and ticket validation, atomicity, mass assignment, and bad ID edge cases" do
+    # Malformed create payloads
+    post "/api/v1/requests", params: {}, headers: json_headers(account: "acme", token: @avery_token), as: :json
+    assert_response :bad_request
+
+    post "/api/v1/requests", params: { request: "invalid" }, headers: json_headers(account: "acme", token: @avery_token), as: :json
+    assert_response :bad_request
+
+    post "/api/v1/requests",
+         params: { request: { subject: "Valid", comment: "not-a-hash" } },
+         headers: json_headers(account: "acme", token: @avery_token),
+         as: :json
+    assert_response :bad_request
+
+    assert_no_difference [ "Ticket.count", "TicketComment.count" ] do
+      post "/api/v1/requests",
+           params: { request: { subject: "   ", comment: { body: "Details" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/requests",
+           params: { request: { subject: "Valid", comment: { body: "   " } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/requests",
+           params: { request: { subject: "Valid" } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/requests",
+           params: { request: { subject: "x" * 256, comment: { body: "Details" } } },
+           headers: json_headers(account: "acme", token: @avery_token),
+           as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Create valid request with long multi-paragraph body & disallowed mass assignment fields
+    long_body = ("Paragraph of detailed context. " * 200).strip
+    post "/api/v1/requests",
+         params: {
+           request: {
+             subject: "  Receipt issue  ",
+             status: "solved",
+             requester_id: 999_999,
+             comment: { body: long_body }
+           }
+         },
+         headers: json_headers(account: "acme", token: @avery_token),
+         as: :json
+    assert_response :created
+    id = json_body.dig("request", "id")
+    assert_equal "Receipt issue", json_body.dig("request", "subject")
+    assert_equal "open", json_body.dig("request", "status")
+    assert_not_equal 999_999, json_body.dig("request", "requester_id")
+
+    # Bad ID formats return 404 cleanly (and "1abc" doesn't match ticket 1)
+    [ "abc", "#{id}abc", "0", "-1", "99999999999999999999999999" ].each do |bad_id|
+      get "/api/v1/requests/#{bad_id}", headers: json_headers(account: "acme", token: @avery_token)
+      assert_response :not_found, "Expected 404 for /requests/#{bad_id}"
+      get "/api/v1/requests/#{bad_id}/comments", headers: json_headers(account: "acme", token: @avery_token)
+      assert_response :not_found, "Expected 404 for /requests/#{bad_id}/comments"
+      get "/api/v1/tickets/#{bad_id}", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :not_found, "Expected 404 for /tickets/#{bad_id}"
+      get "/api/v1/tickets/#{bad_id}/comments", headers: json_headers(account: "acme", token: @owner_token)
+      assert_response :not_found, "Expected 404 for /tickets/#{bad_id}/comments"
+    end
+
+    # Customer invalid PATCH updates are atomic and rejected
+    assert_no_difference "TicketComment.count" do
+      # Cannot set pending, open, closed, blank, or null
+      [ "pending", "open", "closed", "", nil ].each do |bad_status|
+        patch "/api/v1/requests/#{id}",
+              params: { request: { comment: { body: "Should rollback" }, status: bad_status } },
+              headers: json_headers(account: "acme", token: @avery_token),
+              as: :json
+        assert_response :unprocessable_content, "Expected 422 for customer status=#{bad_status.inspect}"
+      end
+
+      # Blank comment body rolls back status: solved
+      patch "/api/v1/requests/#{id}",
+            params: { request: { comment: { body: "   " }, status: "solved" } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "open", Ticket.find(id).status
+
+      # Empty envelope returns 400; envelope with no valid update fields returns 422
+      patch "/api/v1/requests/#{id}",
+            params: { request: {} },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :bad_request
+
+      patch "/api/v1/requests/#{id}",
+            params: { request: { subject: "Cannot edit subject" } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "Receipt issue", Ticket.find(id).subject
+
+      # Invalid solved value
+      patch "/api/v1/requests/#{id}",
+            params: { request: { solved: "yes" } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :unprocessable_content
+
+      # Non-hash comment returns 400
+      patch "/api/v1/requests/#{id}",
+            params: { request: { comment: "oops" } },
+            headers: json_headers(account: "acme", token: @avery_token),
+            as: :json
+      assert_response :bad_request
+    end
+
+    # Staff invalid PATCH updates are atomic and rejected
+    assert_no_difference "TicketComment.count" do
+      [ "closed", "new", "", nil, [ "open" ] ].each do |bad_status|
+        patch "/api/v1/tickets/#{id}",
+              params: { ticket: { comment: { body: "Should rollback" }, status: bad_status } },
+              headers: json_headers(account: "acme", token: @owner_token),
+              as: :json
+        assert_response :unprocessable_content, "Expected 422 for staff status=#{bad_status.inspect}"
+      end
+
+      # Blank comment body rolls back status: pending
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: { comment: { body: "" }, status: "pending" } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "open", Ticket.find(id).status
+
+      # Invalid public value
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: { comment: { body: "Hi", public: "maybe" } } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+
+      # Empty envelope returns 400; envelope with no valid update fields returns 422
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: {} },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :bad_request
+
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: { subject: "Cannot edit subject" } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :unprocessable_content
+      assert_equal "Receipt issue", Ticket.find(id).subject
+
+      # Non-hash envelope and comment return 400
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: "bad" },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :bad_request
+
+      patch "/api/v1/tickets/#{id}",
+            params: { ticket: { comment: [ "bad" ] } },
+            headers: json_headers(account: "acme", token: @owner_token),
+            as: :json
+      assert_response :bad_request
+    end
+  end
+end
