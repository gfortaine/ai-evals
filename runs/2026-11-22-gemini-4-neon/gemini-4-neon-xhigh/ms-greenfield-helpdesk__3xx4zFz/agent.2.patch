diff --git a/app/services/customer_registration.rb b/app/services/customer_registration.rb
new file mode 100644
index 0000000..a2abce5
--- /dev/null
+++ b/app/services/customer_registration.rb
@@ -0,0 +1,35 @@
+class CustomerRegistration
+  Result = Struct.new(:success?, :user, :errors, keyword_init: true)
+
+  def initialize(account:, user_params:)
+    @account = account
+    @user_params = user_params
+  end
+
+  def call
+    user = @account.users.build(
+      name: @user_params[:name],
+      email: @user_params[:email],
+      password: @user_params[:password],
+      role: "customer"
+    )
+
+    unless user.valid?
+      return Result.new(success?: false, user: user, errors: user.errors.to_hash(true))
+    end
+
+    raw_token = nil
+    ActiveRecord::Base.transaction do
+      user.save!
+      _record, raw_token = UserToken.issue_for(user: user, purpose: UserToken::EMAIL_VERIFICATION)
+    end
+
+    UserMailer.email_verification(user: user, token: raw_token).deliver_now
+
+    Result.new(success?: true, user: user.reload, errors: {})
+  rescue ActiveRecord::RecordInvalid => e
+    Result.new(success?: false, user: user, errors: e.record.errors.to_hash(true))
+  rescue ActiveRecord::RecordNotUnique
+    Result.new(success?: false, user: user, errors: { email: [ "Email has already been taken" ] })
+  end
+end
diff --git a/app/services/request_creation.rb b/app/services/request_creation.rb
new file mode 100644
index 0000000..8e4b896
--- /dev/null
+++ b/app/services/request_creation.rb
@@ -0,0 +1,59 @@
+class RequestCreation
+  Result = Struct.new(:success?, :ticket, :comment, :errors, keyword_init: true)
+
+  def initialize(account:, requester:, subject:, comment_body:)
+    @account = account
+    @requester = requester
+    @subject = subject
+    @comment_body = comment_body
+  end
+
+  def call
+    ticket = @account.tickets.build(
+      requester: @requester,
+      subject: @subject,
+      status: "open"
+    )
+    comment = TicketComment.new(
+      account: @account,
+      ticket: ticket,
+      author: @requester,
+      body: @comment_body,
+      public: true
+    )
+
+    errors = collect_errors(ticket, comment)
+    return Result.new(success?: false, ticket: ticket, comment: comment, errors: errors) if errors.any?
+
+    ActiveRecord::Base.transaction do
+      ticket.save!
+      comment.ticket = ticket
+      comment.save!
+    end
+
+    Result.new(success?: true, ticket: ticket.reload, comment: comment.reload, errors: {})
+  rescue ActiveRecord::RecordInvalid => e
+    Result.new(success?: false, ticket: ticket, comment: comment, errors: e.record.errors.to_hash(true))
+  end
+
+  private
+
+  def collect_errors(ticket, comment)
+    errors = {}
+    unless ticket.valid?
+      ticket.errors.each do |error|
+        (errors[error.attribute.to_s] ||= []) << error.full_message
+      end
+    end
+
+    unless comment.valid?
+      comment.errors.each do |error|
+        next if error.attribute == :ticket
+
+        (errors["comment.#{error.attribute}"] ||= []) << error.full_message
+      end
+    end
+
+    errors
+  end
+end
