+    assert_response :unauthorized
+    get "/api/v1/tickets/#{@avery_ticket_id}/comments", headers: json_headers(account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "customers cannot access staff /tickets routes" do
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{@avery_ticket_id}", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :forbidden
+
+    patch "/api/v1/tickets/#{@avery_ticket_id}",
