+          headers: json_headers(account: "acme", token: @avery_token),
+          as: :json
+    assert_response :not_found
+
+    get "/api/v1/requests/#{@blake_ticket_id}/comments", headers: json_headers(account: "acme", token: @avery_token)
+    assert_response :not_found
+
+    # Staff sees both customers' tickets in Acme
+    get "/api/v1/tickets", headers: json_headers(account: "acme", token: @acme_owner_token)
+    assert_response :ok
+    assert_equal [ @blake_ticket_id, @avery_ticket_id ], json_body["tickets"].map { |t| t["id"] }
+  end
+
+  test "strict multi-tenant isolation between accounts" do
+    # Globex staff only sees Globex tickets
+    get "/api/v1/tickets", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :ok
+    assert_equal [ @casey_ticket_id ], json_body["tickets"].map { |t| t["id"] }
+
+    # Globex staff cannot access Acme tickets
+    get "/api/v1/tickets/#{@avery_ticket_id}", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :not_found
+    patch "/api/v1/tickets/#{@avery_ticket_id}",
+          params: { ticket: { status: "solved" } },
+          headers: json_headers(account: "globex", token: @globex_owner_token),
+          as: :json
+    assert_response :not_found
+    get "/api/v1/tickets/#{@avery_ticket_id}/comments", headers: json_headers(account: "globex", token: @globex_owner_token)
+    assert_response :not_found
+
+    # Globex customer cannot access Acme requests
+    get "/api/v1/requests/#{@avery_ticket_id}", headers: json_headers(account: "globex", token: @casey_token)
+    assert_response :not_found
+
+    # Cross-account token fails with 401
+    get "/api/v1/tickets", headers: json_headers(account: "globex", token: @acme_owner_token)
+    assert_response :unauthorized
+  end
+
+  test "private staff comments are hidden from customer comments endpoint and customers cannot create private comments" do
+    # Customer tries to send public: false -> forced to public: true
+    patch "/api/v1/requests/#{@avery_ticket_id}",
