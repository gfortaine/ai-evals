+      before_action :require_active_account!
+      before_action :require_staff!
+
+      def index
+        scope = current_account.tickets.recently_active.includes(:requester)
+        payload = paginate_collection(scope, key: :tickets) { |ticket| serialize_ticket(ticket) }
+        render json: payload, status: :ok
+      end
