@@ -0,0 +1,31 @@
+class Admin::AccountsController < AdminController
+  include Admin::AccountScoped
+
+  skip_before_action :set_account, only: :index
+
+  layout "public"
+
+  def index
+    accounts = Account.preload(:subscription, :billing_waiver, :overridden_limits, :storage_total)
+      .order(created_at: :desc)
+
+    if params[:q].present?
+      query = params[:q].strip
+      if query.match?(/\A\d+\z/)
+        accounts = accounts.where(
+          "name LIKE ? OR external_account_id = ?",
+          "%#{ActiveRecord::Base.sanitize_sql_like(query)}%",
+          query.to_i
+        )
+      else
+        accounts = accounts.where("name LIKE ?", "%#{ActiveRecord::Base.sanitize_sql_like(query)}%")
+      end
+    end
+
+    set_page_and_extract_portion_from accounts
+  end
+
+  def show
+    @overridden_limits = @account.overridden_limits || @account.build_overridden_limits
+  end
+end
