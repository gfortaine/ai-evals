diff --git a/saas/test/controllers/account/billing_portals_controller_test.rb b/saas/test/controllers/account/billing_portals_controller_test.rb
new file mode 100644
index 0000000..46728d9
--- /dev/null
+++ b/saas/test/controllers/account/billing_portals_controller_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::BillingPortalsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admin opens Stripe Customer Portal" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_portal_123",
+      stripe_subscription_id: "sub_portal_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::BillingPortal::Session.expects(:create).with(
+      has_entries(customer: "cus_portal_123")
+    ).returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/p/session/bps_123"))
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/bps_123"
+  end
+
+  test "non-admin cannot open Stripe Customer Portal" do
+    sign_in_as :jz
+    accounts(:"37s").create_subscription!(stripe_customer_id: "cus_portal_37s")
+
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.account_billing_portal_path(script_name: accounts(:"37s").slug)
+
+    assert_response :forbidden
+  end
+
+  test "redirects with alert when account has no Stripe customer" do
+    sign_in_as :mike
+
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    assert_equal "No billing account found.", flash[:alert]
+  end
+
+  test "handles Stripe errors gracefully" do
+    sign_in_as :mike
+    @account.create_subscription!(stripe_customer_id: "cus_portal_err")
+
+    Stripe::BillingPortal::Session.expects(:create).raises(Stripe::APIConnectionError.new("Offline"))
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    assert_equal "Unable to open billing portal. Please try again.", flash[:alert]
+  end
+end
diff --git a/saas/test/controllers/account/settings_subscription_test.rb b/saas/test/controllers/account/settings_subscription_test.rb
new file mode 100644
index 0000000..5516988
--- /dev/null
+++ b/saas/test/controllers/account/settings_subscription_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Account::SettingsSubscriptionTest < ActionDispatch::IntegrationTest
+  test "admin on Free plan sees their plan and Upgrade in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "h2", text: "Subscription"
+    assert_select "strong", text: "Free"
+    assert_select "button", text: "Upgrade"
+    assert_select "button", text: "Upgrade to Unlimited+"
+    assert_match "$20/month", response.body
+    assert_match "$25/month", response.body
+    assert_match "5 GB", response.body
+    assert_match "500 GB", response.body
+  end
+
+  test "owner sees their plan and Upgrade in settings" do
+    sign_in_as :jason
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "h2", text: "Subscription"
+    assert_select "strong", text: "Free"
+    assert_select "button", text: "Upgrade"
+  end
+
+  test "non-admin member does not see subscription or Upgrade in settings" do
+    sign_in_as :jz
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "h2", text: "Subscription", count: 0
+    assert_select "button", text: "Upgrade", count: 0
+  end
+
+  test "admin on Unlimited plan sees plan details and Manage subscription" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(
+      stripe_customer_id: "cus_settings_unlimited",
+      stripe_subscription_id: "sub_settings_unlimited",
+      plan_key: "monthly_v1",
+      status: "active",
+      current_period_end: Time.utc(2026, 5, 1)
+    )
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited"
+    assert_match "$20/month", response.body
+    assert_match "5 GB", response.body
+    assert_select "button", text: "Manage subscription"
+    assert_select "button", text: "Upgrade", count: 0
+  end
+
+  test "admin on Unlimited+ plan sees 500 GB allowance and Manage subscription" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(
+      stripe_customer_id: "cus_settings_plus",
+      stripe_subscription_id: "sub_settings_plus",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active",
+      cancel_at: Time.utc(2026, 6, 1)
+    )
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited+"
+    assert_match "$25/month", response.body
+    assert_match "500 GB", response.body
+    assert_match "June 01, 2026", response.body
+    assert_select "button", text: "Manage subscription"
+  end
+
+  test "admin on comped account sees comped Unlimited plan" do
+    sign_in_as :mike
+    accounts(:initech).comp
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited"
+    assert_match "Comped", response.body
+    assert_select "button", text: "Upgrade", count: 0
+  end
+
