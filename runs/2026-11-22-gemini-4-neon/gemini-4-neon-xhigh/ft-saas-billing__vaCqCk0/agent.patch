+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "Accounts", saas.admin_accounts_path, class: "btn txt-small" %>
+  </div>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account details</h2>
+      </header>
+
+      <div class="flex flex-column gap-half txt-align-start">
+        <div><strong>ID:</strong> #<%= @account.external_account_id %> (<%= @account.id %>)</div>
+        <div><strong>Owner:</strong> <%= @account.owner_email || "None" %></div>
+        <div>
+          <strong>Plan:</strong> <%= @account.plan.name %>
+          <% if @account.comped? %>
+            <span class="txt-small txt-ink-medium">(Comped)</span>
+          <% end %>
+        </div>
+        <div>
+          <strong>Cards:</strong>
+          <%= number_with_delimiter(@account.cards_used) %>
+          <% if @account.overridden_limits&.card_count.present? %>
+            <span class="txt-small txt-ink-medium">(overridden; actual: <%= number_with_delimiter(@account.cards_count) %>)</span>
+          <% end %>
+          / <%= @account.plan.limit_cards? ? number_with_delimiter(@account.card_limit) : "Unlimited" %>
+        </div>
+        <div>
+          <strong>Storage:</strong>
+          <%= number_to_human_size(@account.bytes_used) %>
+          <% if @account.overridden_limits&.bytes_used.present? %>
+            <span class="txt-small txt-ink-medium">(overridden; actual: <%= number_to_human_size(@account.storage_total&.bytes_stored || 0) %>)</span>
+          <% end %>
+          / <%= number_to_human_size(@account.storage_limit) %>
+        </div>
+        <% if @account.subscription.present? %>
+          <div><strong>Subscription status:</strong> <%= @account.subscription.status || "none" %></div>
+          <div><strong>Stripe customer:</strong> <%= @account.subscription.stripe_customer_id %></div>
+          <% if @account.subscription.stripe_subscription_id.present? %>
+            <div><strong>Stripe subscription:</strong> <%= @account.subscription.stripe_subscription_id %></div>
+          <% end %>
+          <% if @account.subscription.current_period_end.present? %>
+            <div><strong>Current period end:</strong> <%= l(@account.subscription.current_period_end.to_date, format: :long) %></div>
+          <% end %>
+          <% if @account.subscription.cancel_at.present? %>
+            <div><strong>Cancels at:</strong> <%= l(@account.subscription.cancel_at.to_date, format: :long) %></div>
+          <% end %>
+        <% end %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing waiver</h2>
+      </header>
+
+      <div class="flex align-center justify-space-between gap">
+        <% if @account.comped? %>
+          <span>This account is comped.</span>
+          <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn btn--negative" %>
+        <% else %>
+          <span>This account is not comped.</span>
+          <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+        <% end %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override limits</h2>
+        <div class="txt-small txt-ink-medium">Override effective usage counts for support and testing.</div>
+      </header>
+
+      <%= form_with model: @overridden_limits, url: saas.admin_account_overridden_limits_path(@account), class: "flex flex-column gap txt-align-start" do |form| %>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count, min: 0, class: "input", placeholder: @account.cards_count %>
+        </div>
+
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, min: 0, class: "input", placeholder: @account.storage_total&.bytes_stored || 0 %>
+        </div>
+
+        <div class="flex gap-half">
+          <%= form.submit "Override", class: "btn btn--link" %>
+        </div>
+      <% end %>
+
+      <div class="flex gap-half margin-block-start">
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+  </div>
+</section>
