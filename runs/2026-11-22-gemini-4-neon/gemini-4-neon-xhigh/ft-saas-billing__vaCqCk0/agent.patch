diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..1f70147
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admin starts Stripe Checkout for Unlimited plan and creates customer" do
+    sign_in_as :mike
+
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited_123") do
+      Stripe::Customer.expects(:create).with(
+        has_entries(name: @account.name, email: "mike@37signals.com")
+      ).returns(Stripe::Customer.construct_from(id: "cus_new_123"))
+
+      Stripe::Checkout::Session.expects(:create).with(
+        has_entries(
+          customer: "cus_new_123",
+          mode: "subscription",
+          line_items: [ { price: "price_unlimited_123", quantity: 1 } ],
+          client_reference_id: @account.id
+        )
+      ).returns(Stripe::Checkout::Session.construct_from(id: "cs_test_123", url: "https://checkout.stripe.com/c/pay/cs_test_123"))
+
+      post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_v1" }
+    end
+
+    assert_response :see_other
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+    assert_equal "cus_new_123", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "admin starts Stripe Checkout for Unlimited+ plan reusing existing customer" do
+    sign_in_as :mike
+    @account.create_subscription!(stripe_customer_id: "cus_existing_456")
+
+    with_env("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus_456") do
+      Stripe::Customer.expects(:create).never
+
+      Stripe::Checkout::Session.expects(:create).with(
+        has_entries(
+          customer: "cus_existing_456",
+          mode: "subscription",
+          line_items: [ { price: "price_plus_456", quantity: 1 } ]
+        )
+      ).returns(Stripe::Checkout::Session.construct_from(id: "cs_test_456", url: "https://checkout.stripe.com/c/pay/cs_test_456"))
+
+      post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_extra_storage_v1" }
+    end
+
+    assert_response :see_other
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_456"
+  end
+
+  test "non-admin cannot start checkout" do
+    sign_in_as :jz
+
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: accounts(:"37s").slug), params: { plan_key: "monthly_v1" }
+
+    assert_response :forbidden
+  end
+
+  test "rejects free or invalid plan_key" do
+    sign_in_as :mike
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "free_v1" }
+    assert_response :unprocessable_entity
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "bogus" }
+    assert_response :unprocessable_entity
+  end
+
+  test "already subscribed account redirects to settings without starting new checkout" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_already",
+      stripe_subscription_id: "sub_already",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+  end
+
+  test "handles Stripe errors gracefully during checkout" do
+    sign_in_as :mike
+    @account.create_subscription!(stripe_customer_id: "cus_err")
+
+    Stripe::Checkout::Session.expects(:create).raises(Stripe::APIConnectionError.new("Cannot reach Stripe"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    assert_equal "Unable to start checkout. Please try again.", flash[:alert]
+  end
+
+  test "show syncs checkout session on return and redirects to settings" do
+    sign_in_as :mike
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_return")
+
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_return_unlimited") do
+      Stripe::Checkout::Session.expects(:retrieve).with(
+        id: "cs_return_123",
+        expand: [ "subscription" ]
+      ).returns(
+        Stripe::Checkout::Session.construct_from(
+          id: "cs_return_123",
+          customer: "cus_return",
+          subscription: {
+            id: "sub_return_123",
+            customer: "cus_return",
+            status: "active",
+            items: {
+              data: [
+                {
+                  price: { id: "price_return_unlimited", unit_amount: 2000 },
+                  current_period_end: Time.utc(2026, 6, 1).to_i
+                }
+              ]
+            }
+          }
+        )
+      )
+
+      get saas.account_subscription_path(script_name: @account.slug, session_id: "cs_return_123")
+    end
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    subscription.reload
+    assert_equal "sub_return_123", subscription.stripe_subscription_id
+    assert_equal "monthly_v1", subscription.plan_key
+    assert subscription.active?
+  end
+
+  private
+    def with_env(overrides)
+      originals = overrides.keys.index_with { |key| ENV[key] }
+      overrides.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+    end
+end
