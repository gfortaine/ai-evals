diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..e9c8c88
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,343 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  WEBHOOK_SECRET = "whsec_test_fizzy_secret"
+  UNLIMITED_PRICE_ID = "price_unlimited_v1"
+  UNLIMITED_PLUS_PRICE_ID = "price_unlimited_plus_v1"
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "rejects requests with missing or invalid signature" do
+    with_stripe_env do
+      untenanted do
+        post "/stripe/webhooks",
+          params: { type: "customer.subscription.updated" }.to_json,
+          headers: { "CONTENT_TYPE" => "application/json" }
+      end
+      assert_response :bad_request
+
+      untenanted do
+        post "/stripe/webhooks",
+          params: { type: "customer.subscription.updated" }.to_json,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=123,v1=bad" }
+      end
+      assert_response :bad_request
+    end
+  end
+
+  test "rejects requests when webhook secret is not configured" do
+    with_env("STRIPE_WEBHOOK_SECRET" => nil) do
+      payload = { id: "evt_no_secret", type: "customer.subscription.created", data: { object: {} } }.to_json
+      sig = sign_payload(payload, WEBHOOK_SECRET)
+
+      untenanted do
+        post "/stripe/webhooks",
+          params: payload,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => sig }
+      end
+
+      assert_response :bad_request
+    end
+  end
+
+  test "checkout.session.completed links and activates subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_chk_1")
+
+    post_stripe_event(
+      type: "checkout.session.completed",
+      object: {
+        id: "cs_1",
+        object: "checkout.session",
+        mode: "subscription",
+        customer: "cus_chk_1",
+        subscription: "sub_chk_1",
+        payment_status: "paid",
+        client_reference_id: @account.id,
+        metadata: { account_id: @account.id, plan_key: "monthly_v1" }
+      }
+    )
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert_equal "sub_chk_1", subscription.stripe_subscription_id
+    assert_equal "monthly_v1", subscription.plan_key
+    assert subscription.active?
+    assert_equal Plan.unlimited, @account.plan
+  end
+
+  test "customer.subscription.created activates Unlimited plan and grants 5 GB storage" do
+    @account.create_subscription!(stripe_customer_id: "cus_sub_1")
+    period_end = Time.utc(2026, 6, 15).to_i
+
+    post_stripe_event(
+      type: "customer.subscription.created",
+      object: stripe_subscription_payload(
+        id: "sub_1",
+        customer: "cus_sub_1",
+        status: "active",
+        price_id: UNLIMITED_PRICE_ID,
+        unit_amount: 2000,
+        current_period_end: period_end
+      )
+    )
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert_equal "sub_1", subscription.stripe_subscription_id
+    assert_equal "monthly_v1", subscription.plan_key
+    assert subscription.active?
+    assert_equal Time.at(period_end).utc, subscription.current_period_end
+    assert_equal 2000, subscription.next_amount_due_in_cents
+    assert_equal Plan.unlimited, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "customer.subscription.created can create subscription row via account_id metadata" do
+    post_stripe_event(
+      type: "customer.subscription.created",
+      object: stripe_subscription_payload(
+        id: "sub_meta_1",
+        customer: "cus_meta_1",
+        status: "active",
+        price_id: UNLIMITED_PLUS_PRICE_ID,
+        unit_amount: 2500,
+        metadata: { account_id: @account.id }
+      )
+    )
+
+    assert_response :ok
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_equal "cus_meta_1", @account.subscription.stripe_customer_id
+  end
+
+  test "customer.subscription.updated upgrades Unlimited to Unlimited+ and updates storage allowance to 500 GB" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_upg_1",
+      stripe_subscription_id: "sub_upg_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    post_stripe_event(
+      type: "customer.subscription.updated",
+      object: stripe_subscription_payload(
+        id: "sub_upg_1",
+        customer: "cus_upg_1",
+        status: "active",
+        price_id: UNLIMITED_PLUS_PRICE_ID,
+        unit_amount: 2500,
+        metadata: { plan_key: "monthly_v1" } # stale metadata should be overridden by price_id
+      )
+    )
+
+    assert_response :ok
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_equal 2500, @account.subscription.next_amount_due_in_cents
+  end
+
+  test "customer.subscription.updated tracks scheduled cancellation and resume" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_sched_1",
+      stripe_subscription_id: "sub_sched_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    cancel_ts = Time.utc(2026, 7, 1).to_i
+
+    # Schedule cancel at period end
+    post_stripe_event(
+      type: "customer.subscription.updated",
+      object: stripe_subscription_payload(
+        id: "sub_sched_1",
+        customer: "cus_sched_1",
+        status: "active",
+        price_id: UNLIMITED_PRICE_ID,
+        current_period_end: cancel_ts,
+        cancel_at: cancel_ts,
+        cancel_at_period_end: true
+      )
+    )
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert subscription.active?
+    assert subscription.to_be_canceled?
+    assert_equal Time.at(cancel_ts).utc, subscription.cancel_at
+    assert_equal Plan.unlimited, @account.plan
+
+    # Resume subscription
+    post_stripe_event(
+      type: "customer.subscription.updated",
+      object: stripe_subscription_payload(
+        id: "sub_sched_1",
+        customer: "cus_sched_1",
+        status: "active",
+        price_id: UNLIMITED_PRICE_ID,
+        current_period_end: cancel_ts,
+        cancel_at: nil,
+        cancel_at_period_end: false
+      )
+    )
+
+    assert_response :ok
+    subscription.reload
+    assert subscription.active?
+    assert_not subscription.to_be_canceled?
+    assert_nil subscription.cancel_at
+  end
+
+  test "customer.subscription.deleted cancels subscription and reverts account to Free limits" do
+    @account.update_column(:cards_count, 1_000)
+    @account.create_subscription!(
+      stripe_customer_id: "cus_del_1",
+      stripe_subscription_id: "sub_del_1",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert_not @account.exceeding_card_limit?
+
+    post_stripe_event(
+      type: "customer.subscription.deleted",
+      object: stripe_subscription_payload(
+        id: "sub_del_1",
+        customer: "cus_del_1",
+        status: "canceled",
+        price_id: UNLIMITED_PLUS_PRICE_ID
+      )
+    )
+
+    assert_response :ok
+    @account.reload
+    assert @account.subscription.canceled?
+    assert_equal Plan.free, @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert @account.exceeding_card_limit?
+  end
+
+  test "stale customer.subscription.deleted for older subscription does not cancel newer active subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_resub",
+      stripe_subscription_id: "sub_new",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    post_stripe_event(
+      type: "customer.subscription.deleted",
+      object: stripe_subscription_payload(
+        id: "sub_old",
+        customer: "cus_resub",
+        status: "canceled",
+        price_id: UNLIMITED_PRICE_ID
+      )
+    )
+
+    assert_response :ok
+    assert @account.reload.subscription.active?
+    assert_equal "sub_new", @account.subscription.stripe_subscription_id
+  end
+
+  test "invoice.upcoming updates next_amount_due_in_cents" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_inv",
+      stripe_subscription_id: "sub_inv",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    post_stripe_event(
+      type: "invoice.upcoming",
+      object: {
+        id: "in_upcoming",
+        object: "invoice",
+        customer: "cus_inv",
+        subscription: "sub_inv",
+        amount_due: 2500
+      }
+    )
+
+    assert_response :ok
+    assert_equal 2500, @account.reload.subscription.next_amount_due_in_cents
+  end
+
+  test "handles unhandled event types and unknown customers gracefully" do
+    post_stripe_event(type: "charge.succeeded", object: { id: "ch_1", object: "charge" })
+    assert_response :ok
+
+    post_stripe_event(
+      type: "customer.subscription.updated",
+      object: stripe_subscription_payload(
+        id: "sub_unknown",
+        customer: "cus_unknown",
+        status: "active",
+        price_id: UNLIMITED_PRICE_ID
+      )
+    )
+    assert_response :ok
+  end
+
+  private
+    def post_stripe_event(type:, object:)
+      with_stripe_env do
+        payload = { id: "evt_#{SecureRandom.hex(6)}", type: type, data: { object: object } }.to_json
+        signature = sign_payload(payload, WEBHOOK_SECRET)
+
+        untenanted do
+          post "/stripe/webhooks",
+            params: payload,
+            headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => signature }
+        end
+      end
+    end
+
+    def stripe_subscription_payload(id:, customer:, status:, price_id:, unit_amount: 2000, current_period_end: 1.month.from_now.to_i, cancel_at: nil, cancel_at_period_end: false, metadata: {})
+      {
+        id: id,
+        object: "subscription",
+        customer: customer,
+        status: status,
+        cancel_at: cancel_at,
+        cancel_at_period_end: cancel_at_period_end,
+        metadata: metadata,
+        items: {
+          data: [
+            {
+              price: { id: price_id, unit_amount: unit_amount },
+              quantity: 1,
+              current_period_end: current_period_end
+            }
+          ]
+        }
+      }
+    end
+
+    def sign_payload(payload, secret)
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+      "t=#{timestamp.to_i},v1=#{signature}"
+    end
+
+    def with_stripe_env(&block)
+      with_env(
+        "STRIPE_WEBHOOK_SECRET" => WEBHOOK_SECRET,
+        "STRIPE_MONTHLY_V1_PRICE_ID" => UNLIMITED_PRICE_ID,
+        "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => UNLIMITED_PLUS_PRICE_ID,
+        &block
+      )
+    end
+
+    def with_env(overrides)
+      originals = overrides.keys.index_with { |key| ENV[key] }
+      overrides.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+    end
+end
diff --git a/saas/test/integration/billing_flow_test.rb b/saas/test/integration/billing_flow_test.rb
new file mode 100644
index 0000000..d972548
--- /dev/null
+++ b/saas/test/integration/billing_flow_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class BillingFlowTest < ActionDispatch::IntegrationTest
+  WEBHOOK_SECRET = "whsec_integration_test_secret"
+  UNLIMITED_PRICE_ID = "price_unlimited_e2e"
+  UNLIMITED_PLUS_PRICE_ID = "price_unlimited_plus_e2e"
+
+  test "full hosted billing lifecycle from Free limits through Upgrade, Unlimited+, cancellation, and support tools" do
+    account = accounts(:initech)
+    board = boards(:miltons_wish_list)
+    draft = cards(:unfinished_thoughts)
+
+    sign_in_as :mike
+
+    # 1. Free account at 950 cards sees "50 cards left" countdown on draft
+    account.update_column(:cards_count, 950)
+    get card_draft_path(draft, script_name: account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_match "50 cards left", response.body
+
+    # 2. Free account runs out of cards (1,000) -> can still draft, cannot publish or create via API, sees Upgrade pitch
+    account.update_column(:cards_count, 1_000)
+
+    post board_cards_path(board, script_name: account.slug)
+    assert_response :redirect # drafting still works
+
+    post board_cards_path(board, script_name: account.slug), params: { card: { title: "API blocked" } }, as: :json
+    assert_response :forbidden
+
+    post card_publish_path(draft, script_name: account.slug)
+    assert_response :forbidden
+    assert draft.reload.drafted?
+
+    get card_draft_path(draft, script_name: account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message button", text: "Upgrade"
+
+    # 3. Admin sees Free plan and Upgrade in settings, starts Stripe Checkout
+    get account_settings_path(script_name: account.slug)
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "button", text: "Upgrade"
+
+    with_stripe_env do
+      Stripe::Customer.expects(:create).returns(Stripe::Customer.construct_from(id: "cus_e2e_1"))
+      Stripe::Checkout::Session.expects(:create).returns(
+        Stripe::Checkout::Session.construct_from(id: "cs_e2e_1", url: "https://checkout.stripe.com/c/pay/cs_e2e_1")
+      )
+
+      post saas.account_subscription_path(script_name: account.slug), params: { plan_key: "monthly_v1" }
+      assert_response :see_other
+      assert_redirected_to "https://checkout.stripe.com/c/pay/cs_e2e_1"
+    end
+
+    # 4. Stripe webhook activates Unlimited ($20/month, 5 GB)
+    post_stripe_webhook("customer.subscription.created", {
+      id: "sub_e2e_1",
+      object: "subscription",
+      customer: "cus_e2e_1",
+      status: "active",
+      items: { data: [ { price: { id: UNLIMITED_PRICE_ID, unit_amount: 2000 }, quantity: 1, current_period_end: 1.month.from_now.to_i } ] }
+    })
+    assert_response :ok
+
+    assert_equal Plan.unlimited, account.reload.plan
+    assert_equal 5.gigabytes, account.storage_limit
+
+    # Publishing and API card creation now work
+    post board_cards_path(board, script_name: account.slug), params: { card: { title: "API allowed" } }, as: :json
+    assert_response :created
+
+    # 5. Unlimited brings 5 GB storage allowance (3 GB allowed, 10 GB blocked)
+    account.override_limits(bytes_used: 3.gigabytes)
+    post board_cards_path(board, script_name: account.slug), params: { card: { title: "Under 5 GB" } }, as: :json
+    assert_response :created
+
+    account.override_limits(bytes_used: 10.gigabytes)
+    post board_cards_path(board, script_name: account.slug), params: { card: { title: "Over 5 GB" } }, as: :json
+    assert_response :forbidden
+
+    # 6. Admin opens Customer Portal, upgrades to Unlimited+ ($25/month, 500 GB) via Stripe webhook
+    Stripe::BillingPortal::Session.expects(:create).returns(
+      Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/p/session/e2e")
+    )
+    post saas.account_billing_portal_path(script_name: account.slug)
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/e2e"
+
+    post_stripe_webhook("customer.subscription.updated", {
+      id: "sub_e2e_1",
+      object: "subscription",
+      customer: "cus_e2e_1",
+      status: "active",
+      items: { data: [ { price: { id: UNLIMITED_PLUS_PRICE_ID, unit_amount: 2500 }, quantity: 1, current_period_end: 1.month.from_now.to_i } ] }
+    })
+    assert_response :ok
+
+    assert_equal Plan.unlimited_plus, account.reload.plan
+    assert_equal 500.gigabytes, account.storage_limit
+
+    # 10 GB is now well within 500 GB allowance
+    post board_cards_path(board, script_name: account.slug), params: { card: { title: "Under 500 GB" } }, as: :json
+    assert_response :created
+
+    get account_settings_path(script_name: account.slug)
+    assert_response :success
+    assert_select "strong", text: "Unlimited+"
+    assert_match "500 GB", response.body
+
+    # 7. Subscription canceled via Stripe webhook -> reverts to Free limits
+    account.reset_overridden_limits
+    post_stripe_webhook("customer.subscription.deleted", {
+      id: "sub_e2e_1",
+      object: "subscription",
+      customer: "cus_e2e_1",
+      status: "canceled",
+      items: { data: [ { price: { id: UNLIMITED_PLUS_PRICE_ID, unit_amount: 2500 }, quantity: 1 } ] }
+    })
+    assert_response :ok
+
+    assert_equal Plan.free, account.reload.plan
+    assert_equal 1.gigabyte, account.storage_limit
+    post card_publish_path(draft, script_name: account.slug)
+    assert_response :forbidden
+
+    # 8. Support staff uses /admin/accounts to Comp -> publishing succeeds!
+    logout_and_sign_in_as :david
+    untenanted do
+      get "/admin/accounts"
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(account)}']", text: "Initech LLC"
+
+      post saas.admin_account_billing_waiver_path(account)
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    logout_and_sign_in_as :mike
+    post card_publish_path(draft, script_name: account.slug)
+    assert_response :redirect
+    assert draft.reload.published?
+  end
+
+  private
+    def post_stripe_webhook(type, object)
+      with_stripe_env do
+        payload = { id: "evt_#{SecureRandom.hex(6)}", type: type, data: { object: object } }.to_json
+        timestamp = Time.now
+        signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, WEBHOOK_SECRET)
+
+        untenanted do
+          post "/stripe/webhooks",
+            params: payload,
+            headers: {
+              "CONTENT_TYPE" => "application/json",
+              "Stripe-Signature" => "t=#{timestamp.to_i},v1=#{signature}"
+            }
+        end
+      end
+    end
+
+    def with_stripe_env
+      overrides = {
+        "STRIPE_WEBHOOK_SECRET" => WEBHOOK_SECRET,
+        "STRIPE_MONTHLY_V1_PRICE_ID" => UNLIMITED_PRICE_ID,
+        "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => UNLIMITED_PLUS_PRICE_ID
+      }
+      originals = overrides.keys.index_with { |key| ENV[key] }
+      overrides.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+    end
+end
