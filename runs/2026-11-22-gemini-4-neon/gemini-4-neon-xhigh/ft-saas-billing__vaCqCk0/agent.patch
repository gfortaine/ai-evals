+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "defines Free, Unlimited, and Unlimited+ plans with approved pricing and limits" do
+    assert_equal [ Plan.free, Plan.unlimited, Plan.unlimited_plus ], Plan.all
+
+    assert_equal "Free", Plan.free.name
+    assert_equal 0, Plan.free.price
+    assert_equal 1_000, Plan.free.card_limit
+    assert_equal 1.gigabyte, Plan.free.storage_limit
+    assert Plan.free.free?
+    assert_not Plan.free.paid?
+    assert Plan.free.limit_cards?
+    assert_not Plan.free.unlimited_cards?
+
+    assert_equal "Unlimited", Plan.unlimited.name
+    assert_equal 20, Plan.unlimited.price
+    assert_equal Float::INFINITY, Plan.unlimited.card_limit
+    assert_equal 5.gigabytes, Plan.unlimited.storage_limit
+    assert Plan.unlimited.paid?
+    assert_not Plan.unlimited.free?
+    assert Plan.unlimited.unlimited_cards?
+    assert_not Plan.unlimited.limit_cards?
+
+    assert_equal "Unlimited+", Plan.unlimited_plus.name
+    assert_equal 25, Plan.unlimited_plus.price
+    assert_equal Float::INFINITY, Plan.unlimited_plus.card_limit
+    assert_equal 500.gigabytes, Plan.unlimited_plus.storage_limit
+    assert Plan.unlimited_plus.paid?
+    assert_not Plan.unlimited_plus.free?
+    assert Plan.unlimited_plus.unlimited_cards?
+    assert_not Plan.unlimited_plus.limit_cards?
+  end
+
+  test "find looks up plans by symbol or string key" do
+    assert_equal Plan.free, Plan.find(:free_v1)
+    assert_equal Plan.free, Plan.find("free_v1")
+    assert_equal Plan.unlimited, Plan.find("monthly_v1")
+    assert_equal Plan.unlimited_plus, Plan.find(:monthly_extra_storage_v1)
+    assert_nil Plan.find("nonexistent")
+    assert_nil Plan.find(nil)
+    assert_nil Plan.find("")
+  end
+
+  test "find_by_price_id matches configured Stripe price IDs" do
+    with_env(
+      "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited_test",
+      "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_unlimited_plus_test"
+    ) do
+      assert_equal Plan.unlimited, Plan.find_by_price_id("price_unlimited_test")
+      assert_equal Plan.unlimited_plus, Plan.find_by_price_id("price_unlimited_plus_test")
+      assert_nil Plan.find_by_price_id("price_unknown")
+      assert_nil Plan.find_by_price_id(nil)
+      assert_nil Plan.find_by_price_id("")
+    end
+  end
+
+  test "find_by_price_id returns nil when env vars are unset" do
+    with_env(
+      "STRIPE_MONTHLY_V1_PRICE_ID" => nil,
+      "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => nil
+    ) do
+      assert_nil Plan.find_by_price_id(nil)
+      assert_nil Plan.find_by_price_id("")
+      assert_nil Plan.find_by_price_id("price_anything")
+    end
+  end
+
+  private
+    def with_env(overrides)
+      originals = overrides.keys.index_with { |key| ENV[key] }
+      overrides.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+    end
+end
