+  test "free account out of cards can still edit a draft" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    patch card_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug),
+      params: { card: { title: "Updated draft title" } },
