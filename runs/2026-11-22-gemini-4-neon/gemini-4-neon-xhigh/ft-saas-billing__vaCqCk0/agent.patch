+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--end">
+    <%= link_to "Stats", saas.admin_stats_path, class: "btn txt-small" %>
+  </div>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow full-width" style="max-inline-size: 100%;">
+    <div class="flex flex-column gap">
+      <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half" do |form| %>
+        <%= form.search_field :q, value: params[:q], placeholder: "Search by name or ID…", class: "input full-width" %>
+        <%= form.submit "Search", class: "btn" %>
+      <% end %>
+
+      <% if @page.records.any? %>
+        <ul class="margin-none list-style-none pad-none flex flex-column gap-half">
+          <% @page.records.each do |account| %>
+            <li class="flex align-center justify-space-between gap pad-block-half border-bottom">
+              <div class="flex flex-column txt-align-start min-width overflow-ellipsis">
+                <strong><%= link_to account.name, saas.admin_account_path(account) %></strong>
+                <span class="txt-x-small txt-ink-medium">
+                  #<%= account.external_account_id %> ·
+                  <%= account.plan.name %><%= " (Comped)" if account.comped? %><%= " · Overridden" if account.overridden_limits.present? %>
+                </span>
+              </div>
+
+              <div class="txt-small txt-ink-medium txt-align-end flex-item-no-shrink">
+                <div><%= number_with_delimiter(account.cards_used) %> cards</div>
+                <div><%= number_to_human_size(account.bytes_used) %> / <%= number_to_human_size(account.storage_limit) %></div>
+              </div>
+            </li>
+          <% end %>
+        </ul>
+
+        <% if @page.before_last? %>
+          <div class="txt-align-center margin-block-start-half">
+            <%= link_to "Next page", saas.admin_accounts_path(q: params[:q], page: @page.next_param), class: "btn txt-small" %>
+          </div>
+        <% end %>
+      <% else %>
+        <p class="txt-ink-medium txt-align-center">No accounts found.</p>
+      <% end %>
+    </div>
+  </div>
+</section>
