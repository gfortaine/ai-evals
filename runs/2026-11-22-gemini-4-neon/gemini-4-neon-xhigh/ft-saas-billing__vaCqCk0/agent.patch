new file mode 100644
index 0000000..01c314d
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,215 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts and open each account page by name" do
+    sign_in_as :david
+
+    untenanted do
+      get "/admin/accounts"
+
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(accounts(:"37s"))}']", text: "37signals"
+      assert_select "a[href='#{saas.admin_account_path(@account)}']", text: "Initech LLC"
+      assert_select "a[href='#{saas.admin_account_path(accounts(:acme))}']", text: "ACME"
+    end
+
+    untenanted do
+      get saas.admin_account_path(@account)
+    end
+
+    assert_response :success
+    assert_select "h1", text: "Initech LLC"
+    assert_select "button", text: "Comp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value='Override']"
+    assert_select "button", text: "Reset"
+  end
+
+  test "staff can search accounts by name or external ID" do
+    sign_in_as :david
+
+    untenanted do
+      get "/admin/accounts", params: { q: "Initech" }
+    end
+
+    assert_response :success
+    assert_select "a", text: "Initech LLC"
+    assert_select "a", text: "37signals", count: 0
+
+    untenanted do
+      get "/admin/accounts", params: { q: @account.external_account_id.to_s }
+    end
+
+    assert_response :success
+    assert_select "a", text: "Initech LLC"
+  end
+
+  test "non-staff cannot access admin accounts or support tools" do
+    sign_in_as :jz
+
+    untenanted do
+      get "/admin/accounts"
+      assert_response :forbidden
+
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+
+      post saas.admin_account_overridden_limits_path(@account),
+        params: { account_overridden_limits: { card_count: 1_000 } }
+      assert_response :forbidden
+
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_response :forbidden
+    end
+  end
+
+  test "staff can comp and uncomp an account from its admin page" do
+    sign_in_as :david
+    @account.update_column(:cards_count, 1_000)
+
+    # Comp
+    untenanted do
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      follow_redirect!
+    end
+
+    assert_response :success
+    assert @account.reload.comped?
+    assert_not @account.exceeding_card_limit?
+    assert_select "button", text: "Uncomp"
+    assert_select "button", text: "Comp", count: 0
+
+    # Uncomp
+    untenanted do
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      follow_redirect!
+    end
+
+    assert_response :success
+    assert_not @account.reload.comped?
+    assert @account.exceeding_card_limit?
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp", count: 0
+  end
+
+  test "staff can override card count and bytes used and reset the override" do
+    sign_in_as :david
+
+    # Create override
+    untenanted do
+      post saas.admin_account_overridden_limits_path(@account),
+        params: { account_overridden_limits: { card_count: "950", bytes_used: 2.gigabytes.to_s } }
+      assert_redirected_to saas.admin_account_path(@account)
+      follow_redirect!
+    end
+
+    assert_response :success
+    @account.reload
+    assert_equal 950, @account.cards_used
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+
+    # Update existing override
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account),
+        params: { account_overridden_limits: { card_count: "1000", bytes_used: "" } }
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+
+    @account.reload
+    assert_equal 1_000, @account.cards_used
+    assert @account.exceeding_card_limit?
+    assert_nil @account.overridden_limits.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Reset drops override
+    untenanted do
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+
+    @account.reload
+    assert_nil @account.overridden_limits
+    assert_equal 0, @account.cards_used
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "overriding card count and bytes used immediately enforces limits on draft cards" do
+    sign_in_as :david
+    account = accounts(:"37s")
+    draft = boards(:writebook).cards.create!(creator: users(:david), status: :drafted, title: "Limit test draft")
+
+    # Override card count to 950 -> "50 cards left"
+    untenanted do
+      post saas.admin_account_overridden_limits_path(account),
+        params: { account_overridden_limits: { card_count: "950" } }
+    end
+
+    get card_draft_path(draft, script_name: account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_match "50 cards left", response.body
+
+    # Override card count to 1000 -> Upgrade pitch & publishing refused
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(account),
+        params: { account_overridden_limits: { card_count: "1000" } }
+    end
+
+    get card_draft_path(draft, script_name: account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message", text: /Upgrade/
+
+    post card_publish_path(draft, script_name: account.slug)
+    assert_response :forbidden
+    assert draft.reload.drafted?
+
+    # Override bytes_used to 2 GB -> storage limit enforced even for staff when explicitly overridden
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(account),
+        params: { account_overridden_limits: { card_count: "", bytes_used: 2.gigabytes.to_s } }
+    end
+
+    post card_publish_path(draft, script_name: account.slug)
+    assert_response :forbidden
+    assert draft.reload.drafted?
+
+    # Reset -> publishing succeeds again
+    untenanted do
+      delete saas.admin_account_overridden_limits_path(account)
+    end
+
+    post card_publish_path(draft, script_name: account.slug)
+    assert_response :redirect
+    assert draft.reload.published?
+  end
+
+  test "negative override values are rejected with alert" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_overridden_limits_path(@account),
+        params: { account_overridden_limits: { card_count: "-5" } }
+
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+    assert flash[:alert].present?
+    assert_nil @account.reload.overridden_limits
+  end
+end
