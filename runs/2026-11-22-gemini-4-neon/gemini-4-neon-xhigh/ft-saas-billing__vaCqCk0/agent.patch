+<% if Current.user.admin? %>
+  <section class="settings__section">
+    <header>
+      <h2 class="divider">Subscription</h2>
+    </header>
+
+    <% if account.active_subscription %>
+      <div class="flex flex-column gap-half">
+        <p class="margin-none">
+          You’re on the <strong><%= account.plan.name %></strong> plan ($<%= account.plan.price %>/month, unlimited cards, <%= number_to_human_size(account.storage_limit) %> storage).
+        </p>
+
+        <% if account.active_subscription.to_be_canceled? %>
+          <p class="margin-none txt-small txt-ink-medium">
+            Your subscription will cancel on <strong><%= l(account.active_subscription.cancel_at.to_date, format: :long) %></strong>.
+          </p>
+        <% elsif account.active_subscription.current_period_end.present? %>
+          <p class="margin-none txt-small txt-ink-medium">
+            Renews on <%= l(account.active_subscription.current_period_end.to_date, format: :long) %>.
+          </p>
+        <% end %>
+
+        <% if account.plan == Plan.unlimited %>
+          <p class="margin-none txt-small txt-ink-medium">
+            Need more storage? Switch to <strong>Unlimited+</strong> ($25/month, 500 GB) in your billing portal.
+          </p>
+        <% end %>
+
+        <div class="margin-block-start-half">
+          <%= button_to "Manage subscription", saas.account_billing_portal_path, method: :post, class: "btn settings-subscription__button", data: { turbo: false } %>
+        </div>
+      </div>
+    <% elsif account.comped? %>
+      <div class="flex flex-column gap-half">
+        <p class="margin-none">
+          You’re on the <strong><%= account.plan.name %></strong> plan (Comped — unlimited cards, <%= number_to_human_size(account.storage_limit) %> storage).
+        </p>
+      </div>
+    <% else %>
+      <div class="flex flex-column gap-half">
+        <p class="margin-none">
+          You’re on the <strong><%= account.plan.name %></strong> plan (<%= number_with_delimiter(account.cards_used) %> of <%= number_with_delimiter(account.card_limit) %> cards, <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage).
+        </p>
+
+        <% if account.subscription&.past_due? %>
+          <p class="margin-none txt-small txt-negative">
+            Your last payment failed. Update your payment method to restore your paid plan.
+          </p>
+        <% end %>
+
+        <div class="flex flex-column gap-half margin-block-start-half">
+          <div class="flex align-center justify-space-between gap-half">
+            <div class="txt-align-start">
+              <strong>Unlimited</strong>
+              <div class="txt-small txt-ink-medium">$20/month · Unlimited cards · 5 GB storage</div>
+            </div>
+            <%= button_to "Upgrade", saas.account_subscription_path, params: { plan_key: Plan.unlimited.key }, class: "btn btn--link settings-subscription__button", data: { turbo: false } %>
+          </div>
+
+          <div class="flex align-center justify-space-between gap-half">
+            <div class="txt-align-start">
+              <strong>Unlimited+</strong>
+              <div class="txt-small txt-ink-medium">$25/month · Unlimited cards · 500 GB storage</div>
+            </div>
+            <%= button_to "Upgrade to Unlimited+", saas.account_subscription_path, params: { plan_key: Plan.unlimited_plus.key }, class: "btn settings-subscription__button", data: { turbo: false } %>
+          </div>
+        </div>
+
+        <% if account.subscription&.stripe_customer_id.present? %>
+          <div class="margin-block-start-half">
+            <%= button_to "Manage billing", saas.account_billing_portal_path, method: :post, class: "btn btn--plain txt-small txt-link", data: { turbo: false } %>
+          </div>
+        <% end %>
+      </div>
+    <% end %>
+  </section>
+<% end %>
