@@ -0,0 +1,294 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @user = users(:david)
+    @board = boards(:writebook)
+  end
+
+  test "blank queries return no cards" do
+    [ nil, "", "   ", '""', '"   "', [ "logo" ] ].each do |query|
+      search = Search.new(user: @user, query: query)
+      assert search.blank?, "Expected #{query.inspect} to be blank"
+      assert_empty search.cards
+    end
+  end
+
+  test "finds fixture cards by title case-insensitively" do
+    assert_equal [ cards(:logo) ], Search.new(user: @user, query: "logo").cards.to_a
+    assert_equal [ cards(:logo) ], Search.new(user: @user, query: "LOGO").cards.to_a
+    assert_equal [ cards(:layout) ], Search.new(user: @user, query: "broken").cards.to_a
+  end
+
+  test "finds cards by description plain text and ignores HTML tags and attributes" do
+    card = @board.cards.create!(
+      title: "Architecture notes",
+      description: '<p>We should <strong>refactor</strong> the <a href="https://example.com/secreturl">billing</a> pipeline &amp; cache.</p>',
+      status: :published
+    )
+
+    assert_equal [ card ], Search.new(user: @user, query: "refactor").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "billing").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "&").cards.to_a
+    assert_empty Search.new(user: @user, query: "strong").cards
+    assert_empty Search.new(user: @user, query: "href").cards
+    assert_empty Search.new(user: @user, query: "secreturl").cards
+  end
+
+  test "finds cards by comment body including fixtures and newly created comments" do
+    assert_equal [ cards(:layout) ], Search.new(user: @user, query: "overflowing").cards.to_a
+
+    card = cards(:buy_domain)
+    card.comments.create!(body: "<p>Let's register the <em>zeppelin</em> domain soon.</p>")
+
+    assert_equal [ card ], Search.new(user: @user, query: "zeppelin").cards.to_a
+    assert_empty Search.new(user: @user, query: "em").cards
+  end
+
+  test "ignores system-generated activity comments" do
+    card = cards(:buy_domain)
+    card.comments.create!(creator: users(:system), body: "Moved to <strong>Quasar</strong> column")
+
+    assert_empty Search.new(user: @user, query: "quasar").cards
+  end
+
+  test "reflects live updates and deletions on titles, descriptions, and comments" do
+    card = @board.cards.create!(
+      title: "Initial alpha title",
+      description: "Initial beta description",
+      status: :published
+    )
+    comment = card.comments.create!(body: "Initial gamma comment")
+
+    assert_equal [ card ], Search.new(user: @user, query: "alpha").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "beta").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "gamma").cards.to_a
+
+    card.update!(title: "Updated delta title")
+    assert_empty Search.new(user: @user, query: "alpha").cards
+    assert_equal [ card ], Search.new(user: @user, query: "delta").cards.to_a
+
+    card.update!(description: "Updated epsilon description")
+    assert_empty Search.new(user: @user, query: "beta").cards
+    assert_equal [ card ], Search.new(user: @user, query: "epsilon").cards.to_a
+
+    comment.update!(body: "Updated zeta comment")
+    assert_empty Search.new(user: @user, query: "gamma").cards
+    assert_equal [ card ], Search.new(user: @user, query: "zeta").cards.to_a
+
+    comment.destroy!
+    assert_empty Search.new(user: @user, query: "zeta").cards
+
+    card.destroy!
+    assert_empty Search.new(user: @user, query: "delta").cards
+  end
+
+  test "multi-word queries require all terms and can span title, description, and comments" do
+    card = @board.cards.create!(
+      title: "Narwhal migration",
+      description: "Requires zero-downtime rollout",
+      status: :published
+    )
+    card.comments.create!(body: "Verified on staging cluster")
+
+    assert_equal [ card ], Search.new(user: @user, query: "narwhal rollout").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "narwhal staging").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "rollout cluster").cards.to_a
+    assert_empty Search.new(user: @user, query: "narwhal nonexistent").cards
+  end
+
+  test "quoted phrases match contiguous words within the same field" do
+    matching = @board.cards.create!(title: "The quick brown fox", status: :published)
+    @board.cards.create!(title: "The quick red brown fox", status: :published)
+    @board.cards.create!(title: "quick", description: "brown", status: :published)
+
+    assert_equal [ matching ], Search.new(user: @user, query: '"quick brown"').cards.to_a
+  end
+
+  test "matches word prefixes without matching mid-word substrings" do
+    matching = @board.cards.create!(title: "Concatenate categories", status: :published)
+    non_matching = @board.cards.create!(title: "Concatenate strings", status: :published)
+
+    results = Search.new(user: @user, query: "cat").cards.to_a
+    assert_includes results, matching
+    assert_not_includes results, non_matching
+
+    assert_equal [ cards(:layout) ], Search.new(user: @user, query: "overflow").cards.to_a
+  end
+
+  test "handles unicode case folding and special characters safely" do
+    card = @board.cards.create!(
+      title: "CAFÉ 100% foo_bar foo!bar C++ (test)",
+      description: "The café is open & ready.",
+      status: :published
+    )
+    other = @board.cards.create!(title: "100xx fooXbar", status: :published)
+
+    assert_equal [ card ], Search.new(user: @user, query: "café").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "100%").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "foo_bar").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "foo!bar").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "c++").cards.to_a
+    assert_equal [ card ], Search.new(user: @user, query: "(test)").cards.to_a
+    assert_not_includes Search.new(user: @user, query: "100%").cards.to_a, other
+    assert_not_includes Search.new(user: @user, query: "foo_bar").cards.to_a, other
+  end
+
+  test "deduplicates cards that match across title, description, and multiple comments" do
+    card = @board.cards.create!(
+      title: "Phoenix launch",
+      description: "Phoenix checklist",
+      status: :published
+    )
+    comment_1 = card.comments.create!(body: "First phoenix note", created_at: 2.hours.ago)
+    comment_2 = card.comments.create!(body: "Second phoenix note", created_at: 1.hour.ago)
+
+    search = Search.new(user: @user, query: "phoenix")
+    cards_found = search.cards.to_a
+
+    assert_equal [ card ], cards_found
+
+    result = search.results_for(cards_found).sole
+    assert_equal "Phoenix launch", card.title
+    assert_equal "<mark>Phoenix</mark> launch", result.title_html
+    assert_equal "<mark>Phoenix</mark> checklist", result.description_html
+    assert_equal [ comment_2, comment_1 ], result.matching_comments
+  end
+
+  test "orders results newest first" do
+    oldest = @board.cards.create!(title: "Chrono oldest", status: :published, created_at: 3.days.ago)
+    middle = @board.cards.create!(title: "Chrono middle", status: :published, created_at: 2.days.ago)
+    newest = @board.cards.create!(title: "Chrono newest", status: :published, created_at: 1.day.ago)
+
+    assert_equal [ newest, middle, oldest ], Search.new(user: @user, query: "chrono").cards.to_a
+  end
+
+  test "orders results newest first deterministically when timestamps match" do
+    freeze_time do
+      first = @board.cards.create!(title: "SameTime first", status: :published)
+      second = @board.cards.create!(title: "SameTime second", status: :published)
+
+      assert_equal [ second, first ], Search.new(user: @user, query: "sametime").cards.to_a
+    end
+  end
+
+  test "only returns results from boards the user currently has access to" do
+    private_board = boards(:private)
+    secret_card = private_board.cards.create!(
+      title: "Submarine plans",
+      description: "Top secret submarine blueprint",
+      creator: users(:kevin),
+      status: :published
+    )
+    secret_card.comments.create!(creator: users(:kevin), body: "Submarine depth test passed")
+
+    # Kevin has access, David does not
+    assert_equal [ secret_card ], Search.new(user: users(:kevin), query: "submarine").cards.to_a
+    assert_empty Search.new(user: users(:david), query: "submarine").cards
+
+    # Grant David access
+    private_board.accesses.grant_to(users(:david))
+    assert_equal [ secret_card ], Search.new(user: users(:david), query: "submarine").cards.to_a
+
+    # Revoke David access
+    private_board.accesses.revoke_from(users(:david))
+    assert_empty Search.new(user: users(:david), query: "submarine").cards
+  end
+
+  test "reflects board moves immediately for access control" do
+    card = @board.cards.create!(title: "Periscope optic", status: :published)
+    card.comments.create!(body: "Periscope lens calibrated")
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "periscope").cards.to_a
+
+    card.move_to(boards(:private))
+
+    assert_empty Search.new(user: users(:david), query: "periscope").cards
+    assert_equal [ card ], Search.new(user: users(:kevin), query: "periscope").cards.to_a
+
+    card.move_to(@board)
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "periscope").cards.to_a
+  end
+
+  test "never leaks results across accounts" do
+    assert_empty Search.new(user: users(:david), query: "paycheck").cards
+    assert_empty Search.new(user: users(:david), query: "radio").cards
+
+    Current.with_account(accounts(:initech)) do
+      assert_equal [ cards(:paycheck) ], Search.new(user: users(:mike), query: "paycheck").cards.to_a
+      assert_empty Search.new(user: users(:mike), query: "logo").cards
+    end
+  end
+
+  test "never returns draft cards or their comments" do
+    # Draft card created by current user
+    draft = @board.cards.create!(
+      title: "Platypus draft title",
+      description: "Platypus draft description",
+      creator: @user,
+      status: :drafted
+    )
+    # Force-saved comment on a draft card
+    draft_comment = draft.comments.build(account: draft.account, creator: @user, body: "Platypus draft comment")
+    draft_comment.rich_text_body.account = draft.account
+    draft_comment.save!(validate: false)
+
+    assert_empty Search.new(user: @user, query: "platypus").cards
+
+    # Published card with comment reverted back to draft
+    published_then_drafted = @board.cards.create!(
+      title: "Echidna published title",
+      status: :published
+    )
+    published_then_drafted.comments.create!(body: "Echidna comment body")
+    assert_equal [ published_then_drafted ], Search.new(user: @user, query: "echidna").cards.to_a
+
+    published_then_drafted.drafted!
+    assert_empty Search.new(user: @user, query: "echidna").cards
+
+    # Publishing a draft makes it searchable
+    draft.publish
+    assert_equal [ draft ], Search.new(user: @user, query: "platypus").cards.to_a
+
+    # Existing fixture draft in initech
+    Current.with_account(accounts(:initech)) do
+      assert_empty Search.new(user: users(:mike), query: "unfinished").cards
+    end
+  end
+
+  test "includes closed, postponed, and golden published cards" do
+    closed_card = @board.cards.create!(title: "Albatross closed", status: :published, created_at: 3.days.ago)
+    closed_card.close(user: @user)
+
+    postponed_card = @board.cards.create!(title: "Albatross postponed", status: :published, created_at: 2.days.ago)
+    postponed_card.postpone(user: @user)
+
+    golden_card = @board.cards.create!(title: "Albatross golden", status: :published, created_at: 1.day.ago)
+    golden_card.gild
+
+    assert_equal [ golden_card, postponed_card, closed_card ], Search.new(user: @user, query: "albatross").cards.to_a
+  end
+
+  test "highlighter wraps matched words safely without corrupting HTML or XSS" do
+    search = Search.new(user: @user, query: "mark <script>")
+    highlighter = Search::Highlighter.new(search)
+
+    html = highlighter.highlight("Mark the <script>alert(1)</script> landmark")
+    assert html.html_safe?
+    assert_equal "<mark>Mark</mark> the <mark>&lt;script&gt;</mark>alert(1)&lt;/script&gt; landmark", html
+  end
+
+  test "highlighter extracts centered excerpts for long texts with distant matches" do
+    long_text = "#{"filler " * 60}alpha #{"middle " * 80}omega #{"ending " * 40}"
+    search = Search.new(user: @user, query: "alpha omega")
+    highlighter = Search::Highlighter.new(search)
+
+    excerpt = highlighter.excerpt(long_text)
+    assert_includes excerpt, "<mark>alpha</mark>"
+    assert_includes excerpt, "<mark>omega</mark>"
+    assert_includes excerpt, "…"
+    assert excerpt.length < long_text.length
+  end
+end
