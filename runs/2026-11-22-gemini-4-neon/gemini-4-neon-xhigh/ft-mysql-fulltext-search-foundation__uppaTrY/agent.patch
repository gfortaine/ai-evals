+@layer components {
+  .search {
+    --panel-size: 55ch;
+
+    text-align: start;
+
+    mark {
+      background-color: var(--color-highlight);
+      border-radius: 0.2em;
+      color: inherit;
+      padding-inline: 0.15em;
+    }
+  }
+
+  .search__form {
+    .input--actor {
+      background-color: var(--color-canvas);
+    }
+  }
+
+  .search__results {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space);
+  }
+
+  .search__result {
+    --card-padding-block: var(--block-space);
+    --card-padding-inline: var(--inline-space-double);
+
+    gap: var(--block-space-half);
+  }
+
+  .search__status {
+    font-weight: 600;
+  }
+
+  .search__body {
+    padding-block-start: var(--block-space-half);
+  }
+
+  .search__title {
+    font-size: var(--text-medium);
+    line-height: 1.3;
+  }
+
+  .search__title-link {
+    color: var(--color-ink);
+    text-decoration: none;
+
+    @media (any-hover: hover) {
+      &:hover {
+        text-decoration: underline;
+      }
+    }
+  }
+
+  .search__excerpt {
+    color: var(--color-ink-darker);
+    line-height: 1.5;
+  }
+
+  .search__comments {
+    border-block-start: var(--border);
+    margin: 0;
+    padding-block-start: var(--block-space-half);
+  }
+
+  .search__comment-link {
+    border-radius: 0.35em;
+    margin-inline: -0.5em;
+    padding: 0.35em 0.5em;
+
+    @media (any-hover: hover) {
+      &:hover {
+        background-color: var(--color-ink-lightest);
+      }
+    }
+  }
+
+  .search__comment-excerpt {
+    color: var(--color-ink-darker);
+    line-height: 1.45;
+  }
+}
