diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..37fca2b
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,66 @@
+<% card = result.card %>
+
+<%= tag.article id: dom_id(card, :search_result),
+      class: "search__result card",
+      style: "--card-color: #{card.color}" do %>
+  <header class="card__header">
+    <div class="card__board">
+      <span class="card__id">
+        <span class="for-screen-reader">Card number</span>
+        <%= card.number %>
+      </span>
+      <span class="card__board-name">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+      </span>
+    </div>
+
+    <% if card.closed? %>
+      <span class="search__status txt-x-small txt-uppercase translucent">Done</span>
+    <% elsif card.postponed? %>
+      <span class="search__status txt-x-small txt-uppercase translucent">Not Now</span>
+    <% elsif card.triaged? %>
+      <span class="search__status txt-x-small txt-uppercase translucent"><%= card.column.name %></span>
+    <% end %>
+
+    <div class="search__meta flex-item-grow txt-align-end txt-x-small translucent">
+      <%= local_datetime_tag(card.created_at, style: :daysago) %>
+    </div>
+  </header>
+
+  <div class="search__body flex flex-column gap-half">
+    <h2 class="search__title margin-none">
+      <%= link_to result.title_html, card_path(card), class: "search__title-link", data: { turbo_frame: "_top" } %>
+    </h2>
+
+    <% if result.description_html.present? %>
+      <p class="search__excerpt margin-none txt-small">
+        <%= result.description_html %>
+      </p>
+    <% end %>
+
+    <% if result.comment_matches.any? %>
+      <ul class="search__comments list-style-none flex flex-column gap-half">
+        <% result.comment_matches.each do |comment_match| %>
+          <% comment = comment_match.comment %>
+          <li class="search__comment" id="<%= dom_id(comment, :search_result) %>">
+            <%= link_to comment, class: "search__comment-link flex align-start gap-half txt-undecorated txt-ink", data: { turbo_frame: "_top" } do %>
+              <span class="avatar txt-xx-small flex-item-no-shrink" aria-hidden="true">
+                <%= avatar_image_tag comment.creator %>
+              </span>
+              <span class="search__comment-content flex flex-column min-width flex-item-grow">
+                <span class="search__comment-meta txt-x-small translucent">
+                  <strong><%= comment.creator.familiar_name %></strong>
+                  commented
+                  <%= local_datetime_tag(comment.created_at, style: :daysago) %>
+                </span>
+                <span class="search__comment-excerpt txt-small">
+                  <%= comment_match.excerpt_html %>
+                </span>
+              </span>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+    <% end %>
+  </div>
+<% end %>
