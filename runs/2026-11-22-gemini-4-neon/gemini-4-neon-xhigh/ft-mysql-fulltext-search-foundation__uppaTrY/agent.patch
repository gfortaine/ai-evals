+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "requires an account slug" do
+    integration_session.default_url_options[:script_name] = ""
+    get search_path(q: "logo")
+    assert_redirected_to session_menu_path
+  end
+
+  test "renders search page with form when q is absent or blank" do
+    get search_path
+    assert_response :success
+    assert_select "form[action=?][method=get] input[name=q]", search_path
+    assert_select ".search__result", count: 0
+
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "renders empty state when nothing matches" do
+    get search_path(q: "nonexistentxyzzy")
+    assert_response :success
+    assert_select ".search__result", count: 0
+    assert_select ".blank-slate", text: /No results found/
+  end
+
+  test "finds cards by title with matched word wrapped in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select ".search__result", count: 1
+    assert_select "##{dom_id(cards(:logo), :search_result)}" do
+      assert_select "a[href=?]", card_path(cards(:logo)) do
+        assert_select "mark", text: "logo"
+      end
+    end
+  end
+
+  test "case-insensitive title search preserves original casing inside mark" do
+    get search_path(q: "LAYOUT")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout), :search_result)} .search__title mark", text: "Layout"
+  end
+
+  test "finds cards by description with matched word wrapped in mark" do
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(
+        title: "Release checklist",
+        description: "<p>Calibrate the flux <strong>capacitor</strong> before deployment.</p>",
+        status: :published
+      )
+    end
+
+    get search_path(q: "capacitor")
+    assert_response :success
+
+    assert_select "##{dom_id(card, :search_result)}" do
+      assert_select ".search__title-link", text: "Release checklist"
+      assert_select ".search__excerpt mark", text: "capacitor"
+    end
+
+    get search_path(q: "strong")
+    assert_response :success
+    assert_select "##{dom_id(card, :search_result)}", count: 0
+  end
+
+  test "finds cards by comment body with matched word wrapped in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    comment = comments(:layout_overflowing_david)
+    assert_select ".search__result", count: 1
+    assert_select "##{dom_id(cards(:layout), :search_result)}" do
+      assert_select ".search__title-link[href=?]", card_path(cards(:layout)), text: "Layout is broken"
+      assert_select "##{dom_id(comment, :search_result)}" do
+        assert_select "a[href=?]", card_path(cards(:layout), anchor: dom_id(comment))
+        assert_select "mark", text: "overflowing"
+      end
+    end
+  end
+
+  test "finds cards matching multi-word query across title and comment" do
+    get search_path(q: "layout overflowing")
+    assert_response :success
+
+    assert_select ".search__result", count: 1
+    assert_select "##{dom_id(cards(:layout), :search_result)}" do
+      assert_select ".search__title mark", text: "Layout"
+      assert_select ".search__comment mark", text: "overflowing"
+    end
+  end
+
+  test "deduplicates card matching title, description, and comments while highlighting all matches" do
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(
+        title: "Phoenix initiative",
+        description: "Details about the phoenix launch",
+        status: :published
+      ).tap do |created|
+        created.comments.create!(body: "Phoenix review looks solid")
+      end
+    end
+
+    get search_path(q: "phoenix")
+    assert_response :success
+
+    assert_select "##{dom_id(card, :search_result)}", count: 1
+    assert_select "##{dom_id(card, :search_result)} .search__title mark", text: "Phoenix"
+    assert_select "##{dom_id(card, :search_result)} .search__excerpt mark", text: "phoenix"
+    assert_select "##{dom_id(card, :search_result)} .search__comment mark", text: "Phoenix"
+  end
+
+  test "orders results newest first" do
+    older, middle, newer = with_current_user(:david) do
+      [
+        boards(:writebook).cards.create!(title: "Orchid older", status: :published, created_at: 3.days.ago),
+        boards(:writebook).cards.create!(title: "Orchid middle", status: :published, created_at: 2.days.ago),
+        boards(:writebook).cards.create!(title: "Orchid newer", status: :published, created_at: 1.day.ago)
+      ]
+    end
+
+    get search_path(q: "orchid")
+    assert_response :success
+
+    ids = css_select(".search__result").map { |node| node["id"] }
+    assert_equal [
+      dom_id(newer, :search_result),
+      dom_id(middle, :search_result),
+      dom_id(older, :search_result)
+    ], ids
+  end
+
+  test "restricts results to boards the user currently has access to" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(
+        title: "Classified telemetry",
+        description: "Secret telemetry data",
+        status: :published
+      ).tap do |created|
+        created.comments.create!(body: "Telemetry confirmed")
+      end
+    end
+
+    get search_path(q: "telemetry")
+    assert_response :success
+    assert_select "##{dom_id(private_card, :search_result)}", count: 0
+
+    # Grant access to David -> immediately visible
+    boards(:private).accesses.grant_to(users(:david))
+    get search_path(q: "telemetry")
+    assert_response :success
+    assert_select "##{dom_id(private_card, :search_result)}", count: 1
+
+    # Revoke access from David -> immediately hidden
+    boards(:private).accesses.revoke_from(users(:david))
+    get search_path(q: "telemetry")
+    assert_response :success
+    assert_select "##{dom_id(private_card, :search_result)}", count: 0
+
+    # Kevin still sees it
+    logout_and_sign_in_as :kevin
+    get search_path(q: "telemetry")
+    assert_response :success
+    assert_select "##{dom_id(private_card, :search_result)}", count: 1
+  end
+
+  test "hides card and its comments when moved to a board the user cannot access" do
+    card = with_current_user(:kevin) do
+      boards(:writebook).cards.create!(title: "Compass calibration", status: :published).tap do |created|
+        created.comments.create!(body: "Compass needle aligned")
+      end
+    end
+
+    get search_path(q: "compass")
+    assert_response :success
+    assert_select "##{dom_id(card, :search_result)}", count: 1
+
+    with_current_user(:kevin) { card.move_to(boards(:private)) }
+
+    get search_path(q: "compass")
+    assert_response :success
+    assert_select "##{dom_id(card, :search_result)}", count: 0
+  end
+
+  test "isolates search results by account" do
+    get search_path(q: "paycheck")
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    logout_and_sign_in_as :mike
+    integration_session.default_url_options[:script_name] = accounts(:initech).slug
+
+    get search_path(q: "paycheck")
+    assert_response :success
+    assert_select "##{dom_id(cards(:paycheck), :search_result)}", count: 1
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    get search_path(q: "unfinished")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "never turns up draft cards or their comments" do
+    draft, _reverted = with_current_user(:david) do
+      created_draft = boards(:writebook).cards.create!(
+        title: "Stealthy draft walrus",
+        description: "Walrus draft description",
+        status: :drafted
+      )
+      draft_comment = created_draft.comments.build(
+        account: created_draft.account,
+        creator: users(:david),
+        body: "Walrus draft comment"
+      )
+      draft_comment.rich_text_body.account = created_draft.account
+      draft_comment.save!(validate: false)
+
+      reverted_card = boards(:writebook).cards.create!(title: "Reverted narwhal", status: :published)
+      reverted_card.comments.create!(body: "Comment mentioning narwhal")
+      reverted_card.drafted!
+
+      [ created_draft, reverted_card ]
+    end
+
+    get search_path(q: "walrus")
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    get search_path(q: "narwhal")
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    # Once published, the card turns up
+    with_current_user(:david) { draft.publish }
+    get search_path(q: "walrus")
+    assert_response :success
+    assert_select "##{dom_id(draft, :search_result)}", count: 1
+  end
+
+  test "includes closed and postponed cards" do
+    closed_card, postponed_card = with_current_user(:david) do
+      c1 = boards(:writebook).cards.create!(title: "Pelican closed", status: :published, created_at: 2.days.ago)
+      c1.close(user: users(:david))
+      c2 = boards(:writebook).cards.create!(title: "Pelican postponed", status: :published, created_at: 1.day.ago)
+      c2.postpone(user: users(:david))
+      [ c1, c2 ]
+    end
+
+    get search_path(q: "pelican")
+    assert_response :success
+
+    assert_select "##{dom_id(closed_card, :search_result)}", count: 1
+    assert_select "##{dom_id(postponed_card, :search_result)}", count: 1
+  end
+
+  test "escapes HTML in matched content while keeping mark tags" do
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(
+        title: "<script>alert(1)</script> dandelion",
+        status: :published
+      )
+    end
+
+    get search_path(q: "dandelion")
+    assert_response :success
+
+    assert_select "##{dom_id(card, :search_result)} .search__title mark", text: "dandelion"
+    assert_select "##{dom_id(card, :search_result)} script", count: 0
+    assert_includes response.body, "&lt;script&gt;alert(1)&lt;/script&gt;"
+  end
+
+  test "handles special query strings without errors" do
+    [ "mark", '"unclosed', "100%", "foo_bar", "(test)", "foo.*bar", "a OR b" ].each do |q|
+      get search_path(q: q)
+      assert_response :success
+    end
+
+    get "#{search_path}?q[]=array"
+    assert_response :success
+  end
+
+  test "highlights matches located far into a long description" do
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(
+        title: "Long document",
+        description: "#{"word " * 150}needle_at_end #{"tail " * 30}",
+        status: :published
+      )
+    end
+
+    get search_path(q: "needle_at_end")
+    assert_response :success
+
+    assert_select "##{dom_id(card, :search_result)} .search__excerpt mark", text: "needle_at_end"
+  end
+
+  test "paginates results newest first across pages" do
+    created = with_current_user(:david) do
+      18.times.map do |i|
+        boards(:writebook).cards.create!(
+          title: "Paginated item #{i}",
+          status: :published,
+          created_at: (18 - i).hours.ago
+        )
+      end
+    end
+
+    get search_path(q: "paginated")
+    assert_response :success
+    page_1_ids = css_select(".search__result").map { |node| node["id"] }
+    assert_equal 15, page_1_ids.size
+    assert_equal created.last(15).reverse.map { |c| dom_id(c, :search_result) }, page_1_ids
+    assert_select "a.pagination-link[href*='page=2']"
+
+    get search_path(q: "paginated", page: 2)
+    assert_response :success
+    page_2_ids = css_select(".search__result").map { |node| node["id"] }
+    assert_equal 3, page_2_ids.size
+    assert_equal created.first(3).reverse.map { |c| dom_id(c, :search_result) }, page_2_ids
+  end
+end
