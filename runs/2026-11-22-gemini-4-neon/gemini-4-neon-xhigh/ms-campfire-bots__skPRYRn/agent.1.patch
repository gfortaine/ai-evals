+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated users are redirected to sign in" do
+    get bots_url
+    assert_redirected_to new_session_url
+
+    get new_bot_url
+    assert_redirected_to new_session_url
+
+    post bots_url, params: { bot: { name: "Anon Bot" } }
+    assert_redirected_to new_session_url
+  end
+
+  test "any chat member sees Set up chat bots link on account settings page" do
+    sign_in :kevin
+    get edit_account_url
+    assert_response :success
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']"
+
+    sign_in :david
+    get edit_account_url
+    assert_response :success
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']"
+  end
+
+  test "bots do not appear in account members list and cannot be managed via account users" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :david
+    get edit_account_url
+    assert_response :success
+    assert_select "turbo-frame#account_users strong", text: "Deploy Bot", count: 0
+
+    get account_users_url(format: :turbo_stream)
+    assert_response :success
+    assert_no_match(/Deploy Bot/, response.body)
+
+    assert_raises ActiveRecord::RecordNotFound do
+      patch account_user_url(bot), params: { user: { role: "administrator" } }
+    end
+    assert bot.reload.bot?
+
+    assert_raises ActiveRecord::RecordNotFound do
+      delete account_user_url(bot)
+    end
+    assert bot.reload.active?
+  end
+
+  test "bots cannot sign in via session or transfer link and cannot be banned" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    post session_url, params: { email_address: "", password: "" }
+    assert_response :unauthorized
+
+    put session_transfer_url(bot.transfer_id)
+    assert_response :bad_request
+
+    sign_in :david
+    assert_raises ActiveRecord::RecordNotFound do
+      post user_ban_url(bot)
+    end
+    assert bot.reload.active?
+  end
+
+  test "index lists only current member's bots with name, read-only bot code, and edit link" do
+    kevin_bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    other_bot = User.create_bot!(name: "Other Bot", creator: users(:jz))
+    deleted_bot = User.create_bot!(name: "Retired Bot", creator: users(:kevin))
+    deleted_bot.deactivate
+
+    sign_in :kevin
+    get bots_url
+
+    assert_response :success
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_select "meta[name='turbo-cache-control'][content='no-store']"
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+
+    assert_select "li##{dom_id(kevin_bot)}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value='#{kevin_bot.bot_key}']"
+      assert_select "a[href='#{edit_bot_path(kevin_bot)}'][aria-label='Edit Deploy Bot']"
+    end
+
+    assert_select "li##{dom_id(other_bot)}", count: 0
+    assert_no_match(/#{Regexp.escape(other_bot.bot_key)}/, response.body)
+    assert_select "li##{dom_id(deleted_bot)}", count: 0
+  end
+
+  test "index shows all bots for administrators" do
+    kevin_bot = User.create_bot!(name: "Kevin Bot", creator: users(:kevin))
+    jz_bot = User.create_bot!(name: "JZ Bot", creator: users(:jz))
+
+    sign_in :david
+    get bots_url
+
+    assert_response :success
+    assert_select "li##{dom_id(kevin_bot)} input[readonly][value='#{kevin_bot.bot_key}']"
+    assert_select "li##{dom_id(jz_bot)} input[readonly][value='#{jz_bot.bot_key}']"
+  end
+
+  test "index shows all bots on one page without pagination" do
+    sign_in :kevin
+    bots = 30.times.map { |i| User.create_bot!(name: "Bot #{format('%02d', i)}", creator: users(:kevin)) }
+
+    get bots_url
+    assert_response :success
+
+    bots.each do |bot|
+      assert_select "li##{dom_id(bot)} strong", text: bot.name
+    end
+  end
+
+  test "new renders form with avatar field, required name field labelled Name the bot, and Save changes button" do
+    sign_in :kevin
+    get new_bot_url
+
+    assert_response :success
+    assert_select "form[action='#{bots_path}'][enctype='multipart/form-data']" do
+      assert_select "input[type='file'][name='bot[avatar]']"
+      assert_select "label", text: /Name the bot/ do
+        assert_select "input[name='bot[name]'][placeholder='Name the bot'][required]"
+      end
+      assert_select "button[type='submit']", text: /Save changes/
+    end
+  end
+
+  test "member can create a bot without avatar and it joins all open rooms" do
+    sign_in :kevin
+
+    assert_difference -> { User.active.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    assert_redirected_to bots_url
+
+    bot = User.bot.last
+    assert_equal "Deploy Bot", bot.name
+    assert_equal users(:kevin), bot.creator
+    assert_not bot.avatar.attached?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "member can create a bot with an avatar" do
+    sign_in :kevin
+
+    post bots_url, params: {
+      bot: {
+        name: "Avatar Bot",
+        avatar: fixture_file_upload("moon.jpg", "image/jpeg")
+      }
+    }
+
+    assert_redirected_to bots_url
+
+    bot = User.bot.last
+    assert bot.avatar.attached?
+
+    get user_avatar_url(bot.avatar_token)
+    assert_response :success
+    assert_equal "image/webp", response.content_type
+  end
+
+  test "creating a bot with blank name returns unprocessable content" do
+    sign_in :kevin
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "   " } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "creating a bot ignores unpermitted role, bot_token, and creator_id params" do
+    sign_in :kevin
+
+    post bots_url, params: {
+      bot: {
+        name: "Sneaky Bot",
+        role: "administrator",
+        bot_token: "chosen-by-attacker",
+        creator_id: users(:david).id
+      }
+    }
+
+    assert_redirected_to bots_url
+
+    bot = User.bot.last
+    assert bot.bot?
+    assert_equal users(:kevin), bot.creator
+    assert_not_equal "chosen-by-attacker", bot.bot_token
+  end
+
+  test "creator can view edit page with form and confirmed Delete this chat bot button" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    get edit_bot_url(bot)
+
+    assert_response :success
+    assert_select "form[action='#{bot_path(bot)}']" do
+      assert_select "input[type='file'][name='bot[avatar]']"
+      assert_select "input[name='bot[name]'][value='Deploy Bot'][placeholder='Name the bot'][required]"
+      assert_select "button[type='submit']", text: /Save changes/
+    end
+    assert_select "button[data-turbo-confirm]", text: /Delete this chat bot/
+  end
+
+  test "creator can update bot name and avatar while keeping bot code unchanged" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    original_key = bot.bot_key
+
+    sign_in :kevin
+    patch bot_url(bot), params: {
+      bot: {
+        name: "Release Bot",
+        avatar: fixture_file_upload("moon.jpg", "image/jpeg")
+      }
+    }
+
+    assert_redirected_to bots_url
+    bot.reload
+    assert_equal "Release Bot", bot.name
+    assert bot.avatar.attached?
+    assert_equal original_key, bot.bot_key
+
+    # Updating name without uploading a new avatar preserves the existing avatar
+    patch bot_url(bot), params: { bot: { name: "CI Bot", avatar: "" } }
+    assert_redirected_to bots_url
+    bot.reload
+    assert_equal "CI Bot", bot.name
+    assert bot.avatar.attached?
+    assert_equal original_key, bot.bot_key
+  end
+
+  test "updating a bot with blank name returns unprocessable content" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    patch bot_url(bot), params: { bot: { name: "" } }
+
+    assert_response :unprocessable_content
+    assert_equal "Deploy Bot", bot.reload.name
+  end
+
+  test "creator can delete their bot" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    old_key = bot.bot_key
+
+    sign_in :kevin
+    assert_difference -> { User.active.bot.count }, -1 do
+      delete bot_url(bot)
+    end
+
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+    assert_nil User.authenticate_bot(old_key)
+  end
+
+  test "administrator can edit and delete another member's bot" do
+    bot = User.create_bot!(name: "Kevin Bot", creator: users(:kevin))
+
+    sign_in :david
+    get edit_bot_url(bot)
+    assert_response :success
+
+    patch bot_url(bot), params: { bot: { name: "Renamed By Admin" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed By Admin", bot.reload.name
+
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+  end
+
+  test "other non-admin members cannot edit, update, or delete someone else's bot" do
+    bot = User.create_bot!(name: "Kevin Bot", creator: users(:kevin))
+
+    sign_in :jz
+    get edit_bot_url(bot)
+    assert_response :forbidden
+    assert_no_match(/Kevin Bot/, response.body)
+
+    patch bot_url(bot), params: { bot: { name: "Hijacked" } }
+    assert_response :forbidden
+    assert_equal "Kevin Bot", bot.reload.name
+
+    delete bot_url(bot)
+    assert_response :forbidden
+    assert bot.reload.active?
+  end
+
+  test "cannot edit, update, or delete a human user through bots endpoints" do
+    sign_in :david
+
+    get edit_bot_url(users(:kevin))
+    assert_response :not_found
+
+    patch bot_url(users(:kevin)), params: { bot: { name: "Not A Bot" } }
+    assert_response :not_found
+    assert_equal "Kevin", users(:kevin).reload.name
+
+    delete bot_url(users(:kevin))
+    assert_response :not_found
+    assert users(:kevin).reload.active?
+  end
+
+  test "bot can be added to a closed room the same way as people" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    closed_room = rooms(:designers)
+
+    assert_not_includes closed_room.users, bot
+
+    sign_in :david
+    get edit_rooms_closed_url(closed_room)
+    assert_response :success
+    assert_select "strong", text: "Deploy Bot"
+    assert_select "input[type='checkbox'][name='user_ids[]'][value='#{bot.id}']"
+
+    patch rooms_closed_url(closed_room), params: {
+      room: { name: closed_room.name },
+      user_ids: closed_room.user_ids + [ bot.id ]
+    }
+    assert_redirected_to room_url(closed_room)
+    assert_includes closed_room.reload.users, bot
+  end
+
+  test "viewing a bot profile renders cleanly without transfer link or ban button" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :david
+    get user_url(bot)
+    assert_response :success
+    assert_select "h1", text: "Deploy Bot"
+    assert_select "input#session_transfer_url", count: 0
+    assert_select "a[href^='mailto:']", count: 0
+  end
+end
