+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_no_match(/reached the limit/, response.body)
+  end
+
+  test "lowering Bots per member keeps existing bots working and only blocks new ones until under the new limit" do
+    bots = 3.times.map { |i| User.create_bot!(name: "Existing Bot #{i + 1}", creator: users(:kevin), add_to_all_open_rooms: true) }
+
+    # Admin lowers limit to 1
+    sign_in :david
+    patch account_url, params: { account: { name: accounts(:signal).name, settings: { bots_per_member: "1" } } }
+    assert_redirected_to edit_account_url
+    assert_equal 1, accounts(:signal).reload.settings.bots_per_member
+
+    # All 3 existing bots remain active and can still post messages
+    assert bots.all? { |b| b.reload.active? }
+    post room_bot_messages_url(rooms(:hq), bots.first.bot_key), params: "Still alive!"
+    assert_response :created
+
+    # Member sees all 3 bots, cannot add new ones, and gets reached the limit
+    sign_in :kevin
+    get bots_url
+    assert_response :success
+    assert_select "a[href='#{new_bot_path}']", count: 0
+    assert_match(/reached the limit/, response.body)
+    bots.each { |b| assert_select "li##{dom_id(b)} strong", text: b.name }
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "Fourth Bot" } }
+    end
+    assert_response :forbidden
+
+    # Deleting 2 bots leaves 1 active (still at limit of 1)
+    delete bot_url(bots[0])
+    delete bot_url(bots[1])
+    get bots_url
+    assert_select "a[href='#{new_bot_path}']", count: 0
+    assert_match(/reached the limit/, response.body)
+
+    # Deleting the 3rd bot drops below limit of 1 -> can create again
+    delete bot_url(bots[2])
+    get bots_url
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_no_match(/reached the limit/, response.body)
+
+    assert_difference -> { User.active.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "New Bot" } }
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "raising Bots per member unlocks creation for a member who was at the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    2.times { |i| User.create_bot!(name: "Bot #{i + 1}", creator: users(:kevin)) }
+
+    sign_in :kevin
+    get bots_url
+    assert_select "a[href='#{new_bot_path}']", count: 0
+    assert_match(/reached the limit/, response.body)
+
+    sign_in :david
+    patch account_url, params: { account: { name: accounts(:signal).name, settings: { bots_per_member: "3" } } }
+    assert_redirected_to edit_account_url
+
+    sign_in :kevin
+    get bots_url
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_no_match(/reached the limit/, response.body)
+
+    assert_difference -> { User.active.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Bot 3" } }
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "stale bot limit reached during save returns forbidden instead of unprocessable content" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    User.create_bot!(name: "First Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    # Simulate passing before_action in a race and hitting model validation on save
+    User.any_instance.stubs(:can_create_bot?).returns(true)
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "Raced Bot" } }
+    end
+    assert_response :forbidden
+    assert_match(/reached the limit/, response.body)
+  end
 end
diff --git a/test/models/account_test.rb b/test/models/account_test.rb
