diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
index 36f906b..1044106 100644
--- a/test/models/user/bot_test.rb
+++ b/test/models/user/bot_test.rb
@@ -163,4 +163,85 @@ class User::BotTest < ActiveSupport::TestCase
     assert_not Webhook.exists?(webhook_id)
     assert_nil bot.reload.webhook
   end
+
+  test "members are capped at bots_per_member (default 5) and deactivated bots do not count" do
+    kevin = users(:kevin)
+    jz = users(:jz)
+
+    bots = 5.times.map { |i| User.create_bot!(name: "Kevin Bot #{i}", creator: kevin) }
+    assert kevin.bot_limit_reached?
+    assert_not kevin.can_create_bot?
+
+    extra = User.new(role: :bot, name: "Bot 6", creator: kevin)
+    assert_not extra.valid?
+    assert extra.errors.of_kind?(:base, :bot_limit_reached)
+    assert_match(/reached the limit/, extra.errors.full_messages.to_sentence)
+
+    # Another member is unaffected
+    assert jz.can_create_bot?
+    assert_nothing_raised { User.create_bot!(name: "JZ Bot", creator: jz) }
+
+    # Deleting a bot frees a slot
+    bots.first.deactivate
+    assert kevin.can_create_bot?
+    assert_equal 4, kevin.active_bots_count
+    assert_nothing_raised { User.create_bot!(name: "Replacement Bot", creator: kevin) }
+    assert kevin.bot_limit_reached?
+  end
+
+  test "administrators are not limited by bots_per_member even when set to 0" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    david = users(:david)
+    assert david.can_create_bot?
+    assert_not david.bot_limit_reached?
+
+    6.times { |i| User.create_bot!(name: "Admin Bot #{i}", creator: david) }
+    assert_equal 6, david.active_bots_count
+    assert david.can_create_bot?
+
+    # Member with 0 bots is blocked when limit is 0
+    kevin = users(:kevin)
+    assert kevin.bot_limit_reached?
+    assert_not User.new(role: :bot, name: "Blocked Bot", creator: kevin).valid?
+  end
+
+  test "lowering bots_per_member preserves existing bots and allows editing them while blocking new ones" do
+    kevin = users(:kevin)
+    bots = 4.times.map { |i| User.create_bot!(name: "Bot #{i}", creator: kevin) }
+
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+    assert_equal 4, kevin.active_bots_count
+    assert bots.all? { |b| b.reload.active? }
+    assert kevin.bot_limit_reached?
+
+    # Existing bots can still be updated
+    assert bots.first.update(name: "Renamed Bot 0")
+
+    # Deleting down to 2 is still at limit; deleting down to 1 allows creating again
+    bots[0].deactivate
+    assert kevin.bot_limit_reached?
+    bots[1].deactivate
+    assert kevin.bot_limit_reached?
+    bots[2].deactivate
+    assert kevin.can_create_bot?
+    assert_nothing_raised { User.create_bot!(name: "Fresh Bot", creator: kevin) }
+  end
+
+  test "promoting a member removes the bot limit and demoting an admin enforces it without removing existing bots" do
+    kevin = users(:kevin)
+    5.times { |i| User.create_bot!(name: "Kevin Bot #{i}", creator: kevin) }
+    assert kevin.bot_limit_reached?
+
+    kevin.update!(role: :administrator)
+    assert kevin.can_create_bot?
+    assert_nothing_raised { User.create_bot!(name: "Sixth Bot", creator: kevin) }
+    assert_equal 6, kevin.active_bots_count
+
+    kevin.update!(role: :member)
+    assert_equal 6, kevin.active_bots_count
+    assert kevin.bot_limit_reached?
+    assert_not User.new(role: :bot, name: "Seventh Bot", creator: kevin).valid?
+  end
 end
