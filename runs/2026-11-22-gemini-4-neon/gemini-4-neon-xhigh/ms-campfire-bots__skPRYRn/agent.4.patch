diff --git a/app/models/account.rb b/app/models/account.rb
index dfa9bea..8a0f538 100644
--- a/app/models/account.rb
+++ b/app/models/account.rb
@@ -1,14 +1,69 @@
 class Account < ApplicationRecord
   include Joinable
 
+  DEFAULT_BOTS_PER_MEMBER = 5
+
   has_one_attached :logo do |attachable|
     attachable.variant :large, resize_to_limit: [ 512, 512 ], format: :png
     attachable.variant :small, resize_to_limit: [ 192, 192 ], format: :png
   end
 
-  has_json :settings, restrict_room_creation_to_administrators: false
+  has_json :settings, restrict_room_creation_to_administrators: false, bots_per_member: DEFAULT_BOTS_PER_MEMBER
+
+  validate :validate_bots_per_member
+
+  after_save :clear_bots_per_member_before_type_cast
 
   def logo_variant(size)
     logo.variant(size).processed if logo.variable?
   end
+
+  def bots_per_member_before_type_cast
+    if defined?(@bots_per_member_cast_check) && @bots_per_member_cast_check &&
+       settings.bots_per_member == @bots_per_member_cast_check[:cast]
+      @bots_per_member_cast_check[:raw]
+    else
+      settings.bots_per_member
+    end
+  end
+
+  def reload(*)
+    clear_bots_per_member_before_type_cast
+    super
+  end
+
+  private
+    module BotsPerMemberAssignment
+      def settings=(data)
+        if data.respond_to?(:key?) && (data.key?(:bots_per_member) || data.key?("bots_per_member"))
+          raw = data.key?(:bots_per_member) ? data[:bots_per_member] : data["bots_per_member"]
+          super
+          @bots_per_member_cast_check = { raw: raw, cast: settings.bots_per_member }
+        else
+          super
+        end
+      end
+    end
+    prepend BotsPerMemberAssignment
+
+    def validate_bots_per_member
+      unless valid_non_negative_integer?(bots_per_member_before_type_cast)
+        errors.add(:bots_per_member, "must be a whole number of 0 or more")
+      end
+    end
+
+    def valid_non_negative_integer?(value)
+      case value
+      when Integer
+        value >= 0
+      when String
+        /\A\s*\d+\s*\z/.match?(value)
+      else
+        false
+      end
+    end
+
+    def clear_bots_per_member_before_type_cast
+      @bots_per_member_cast_check = nil
+    end
 end
