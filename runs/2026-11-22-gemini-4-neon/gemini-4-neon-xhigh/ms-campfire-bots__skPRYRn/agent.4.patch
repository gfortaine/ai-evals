@@ -16,6 +16,49 @@ class AccountTest < ActiveSupport::TestCase
     assert_not accounts(:signal).reload.settings.restrict_room_creation_to_administrators?
   end
 
+  test "bots_per_member defaults to 5 and casts valid integer values" do
+    account = accounts(:signal)
+    assert_equal 5, account.settings.bots_per_member
+
+    account.update!(settings: { "bots_per_member" => "3" })
+    assert_equal 3, account.reload.settings.bots_per_member
+    assert_equal 3, account[:settings]["bots_per_member"]
+
+    account.update!(settings: { "bots_per_member" => "0" })
+    assert_equal 0, account.reload.settings.bots_per_member
+
+    account.update!(settings: { "bots_per_member" => " 12 " })
+    assert_equal 12, account.reload.settings.bots_per_member
+
+    # Updating another setting preserves bots_per_member
+    account.update!(settings: { "restrict_room_creation_to_administrators" => "true" })
+    account.reload
+    assert account.settings.restrict_room_creation_to_administrators?
+    assert_equal 12, account.settings.bots_per_member
+  end
+
+  test "bots_per_member rejects negative, blank, decimal, boolean, and non-numeric values" do
+    account = accounts(:signal)
+
+    [ -1, "-1", "", "   ", nil, "abc", "2.5", 2.5, true, false ].each do |invalid_value|
+      assert_not account.update(settings: { "bots_per_member" => invalid_value }),
+        "Expected #{invalid_value.inspect} to be rejected"
+      assert_includes account.errors[:bots_per_member], "must be a whole number of 0 or more"
+      assert_equal 5, account.reload.settings.bots_per_member
+    end
+
+    account.settings.bots_per_member = -3
+    assert_not account.valid?
+    assert_includes account.errors[:bots_per_member], "must be a whole number of 0 or more"
+
+    account.settings.bots_per_member = nil
+    assert_not account.valid?
+
+    account.reload
+    assert_equal 5, account.settings.bots_per_member
+    assert account.valid?
+  end
