+  end
+
+  test "webhook replies count towards flood limit, are suppressed during cooldown, and 5 attempts during cooldown suspend the bot" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} reply</div>"
+    )
+
+    travel_to Time.zone.parse("2026-11-20 12:00:00 UTC") do
+      # 6 API-equivalent posts + 4 webhook replies = 10 messages in 10 seconds
+      6.times { assert @bot.consume_post_rate_limit!.allowed? }
+
+      WebMock.stub_request(:post, "https://bot.example.com/hook")
+        .to_return(status: 200, body: "pong", headers: { "Content-Type" => "text/plain" })
+
+      assert_difference -> { @room.messages.count }, +4 do
