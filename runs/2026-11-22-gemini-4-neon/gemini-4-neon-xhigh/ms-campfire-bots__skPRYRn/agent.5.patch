+      -> { WebMock.stub_request(:post, "https://bot.example.com/hook").to_raise(Net::ReadTimeout) },
+      -> { WebMock.stub_request(:post, "https://bot.example.com/hook").to_raise(Errno::ECONNREFUSED) }
+    ]
+
+    failures.first(9).each_with_index do |stub_failure, idx|
+      WebMock.reset!
+      stub_failure.call
