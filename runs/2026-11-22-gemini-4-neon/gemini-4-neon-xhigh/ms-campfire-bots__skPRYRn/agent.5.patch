+
+  test "any 2xx delivery resets consecutive failure count across mention and joined events" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+    )
+
+    # 9 failures (mix of mention and joined) -> not suspended
+    WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 500)
+    8.times { @webhook.deliver(message) }
+    @webhook.deliver_joined(@room)
+    assert_equal 9, @webhook.reload.consecutive_failures
+    assert_not @bot.reload.suspended?
+
+    # 201 Created is 2xx -> resets consecutive failures to 0
+    WebMock.reset!
+    WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 201)
+    @webhook.deliver(message)
+    assert_equal 0, @webhook.reload.consecutive_failures
+    assert_not @bot.reload.suspended?
+
+    # 9 more failures still do not suspend
+    WebMock.reset!
+    WebMock.stub_request(:post, "https://bot.example.com/hook").to_raise(SocketError)
+    9.times { @webhook.deliver(message) }
+    assert_equal 9, @webhook.reload.consecutive_failures
+    assert_not @bot.reload.suspended?
+
+    # 204 No Content on joined also resets consecutive failures to 0
+    WebMock.reset!
+    WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 204)
