+      # A 204 response during cooldown is NOT a post attempt and does not count towards suspension
+      WebMock.reset!
+      WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 204)
+      3.times { @webhook.deliver(message) }
