+
+    @bot.reload
+    assert @bot.suspended?
+    assert_equal User::Bot::FAILING_WEBHOOKS_SUSPENSION_REASON, @bot.suspension_reason
+    assert_equal 10, @webhook.reload.consecutive_failures
