+      -> { WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 400) },
+      -> { WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 404) },
+      -> { WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 429) },
+      -> { WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 500) },
+      -> { WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 503) },
