+require "test_helper"
+require "socket"
+
+class WebhookTest < ActiveSupport::TestCase
+  include ActionDispatch::Assertions::SelectorAssertions
+  setup do
+    @alice = users(:kevin)
+    @room = rooms(:hq)
+    @bot = User.create_bot!(name: "Deploy Bot", creator: @alice, webhook_url: "https://bot.example.com/hook")
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+    @webhook = @bot.webhook
+  end
+
+  test "validates HTTP and HTTPS URLs and rejects invalid or non-HTTP URLs" do
+    valid_urls = [
+      "https://bot.example.com/hook",
+      "http://bot.example.com/hook?token=abc&env=prod",
+      "http://127.0.0.1:4567/campfire",
+      "http://localhost:8080/events",
+      "http://[::1]:4567/hook",
+      "https://hooks.example.com",
+      "  https://bot.example.com/trimmed  "
+    ]
+
+    valid_urls.each do |url|
+      assert Webhook.valid_url?(url), "Expected #{url.inspect} to be valid"
+      webhook = Webhook.new(user: @bot, url: url)
+      assert webhook.valid?, "Expected Webhook with #{url.inspect} to be valid: #{webhook.errors.full_messages}"
+    end
+
+    invalid_urls = [
+      "",
+      "   ",
+      "not-a-url",
+      "example.com/hook",
+      "ftp://bot.example.com/hook",
+      "javascript:alert(1)",
+      "file:///etc/passwd",
+      "http://",
+      "https:///only-path",
+      "http://bad host/hook",
+      "http://example.com:99999/hook",
+      "http://example.com/hook\r\nX-Injected: yes"
+    ]
+
+    invalid_urls.each do |url|
+      assert_not Webhook.valid_url?(url), "Expected #{url.inspect} to be invalid"
+      webhook = Webhook.new(user: @bot, url: url)
+      assert_not webhook.valid?, "Expected Webhook with #{url.inspect} to be invalid"
+    end
+  end
+
+  test "url is normalized by stripping whitespace" do
+    @webhook.update!(url: "  https://bot.example.com/clean  ")
+    assert_equal "https://bot.example.com/clean", @webhook.url
+  end
+
+  test "payload_for builds the exact mention payload with relative paths and stripped self-mention" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)}&nbsp;restart the <strong>build</strong> please</div>"
+    )
+
+    payload = @webhook.payload_for(message)
+
+    assert_equal "mention", payload[:event]
+    assert_equal({ id: @alice.id, name: @alice.name }, payload[:author])
+    assert_equal({
+      id: @room.id,
+      name: @room.name,
+      reply_to: "/rooms/#{@room.id}/#{@bot.bot_key}/messages"
+    }, payload[:room])
+    assert_equal message.id, payload[:message][:id]
+    assert_equal "restart the build please", payload[:message][:body][:text]
+    assert_equal message.body.body.to_html, payload[:message][:body][:html]
+    assert_includes payload[:message][:body][:html], "<strong>build</strong>"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload[:message][:link]
+  end
+
+  test "payload_for strips only the bot's own @-mention across edge cases without mutating message body" do
+    other_bot = User.create_bot!(name: "QA Bot", creator: @alice)
+
+    cases = [
+      [ "<div>#{mention_attachment_for(@bot)} restart the build please</div>", "restart the build please" ],
+      [ "<div>#{mention_attachment_for(@bot)}&nbsp;restart the build please</div>", "restart the build please" ],
+      [ "<div>please #{mention_attachment_for(@bot)} restart the build</div>", "please restart the build" ],
+      [ "<div>restart the build #{mention_attachment_for(@bot)}</div>", "restart the build" ],
+      [ "<div>#{mention_attachment_for(@bot)}</div>", "" ],
+      [ "<div>#{mention_attachment_for(@bot)}&nbsp;</div>", "" ],
+      [ "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(@bot)} hello</div>", "hello" ],
+      [ "<div>Hey #{mention_attachment_for(@bot)} #{mention_attachment_for(@bot)} check this</div>", "Hey check this" ],
+      [ "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(other_bot)} status</div>", "@QA Bot status" ],
+      [ "<div>#{mention_attachment_for(other_bot)} #{mention_attachment_for(@bot)} status</div>", "@QA Bot status" ],
+      [ "<div>#{mention_attachment_for(@bot)} deploy:<br>- app<br>- worker</div>", "deploy:\n- app\n- worker" ],
+      [ "<div>restart<br>#{mention_attachment_for(@bot)} please</div>", "restart\nplease" ],
+      [ "<div>#{mention_attachment_for(@bot)} tell @Deploy Bot users hi</div>", "tell @Deploy Bot users hi" ],
+      [ "<div><strong>#{mention_attachment_for(@bot)}</strong> restart</div>", "restart" ],
+      [ "<div>#{mention_attachment_for(@bot)}</div><div>restart the build</div>", "restart the build" ],
+      [ "<div>#{mention_attachment_for(:david)} and #{mention_attachment_for(@bot)} check</div>", "@David and check" ]
+    ]
+
+    cases.each do |html, expected_text|
+      message = @room.messages.create!(creator: @alice, body: html)
+      original_html = message.body.body.to_html
+
+      payload = @webhook.payload_for(message)
+
+      assert_equal expected_text, payload[:message][:body][:text], "Failed for HTML: #{html}"
+      assert_equal original_html, message.body.body.to_html, "Message body was mutated for HTML: #{html}"
+    end
+  end
+
+  test "payload_for provides participant name when mentioned in a direct room" do
+    direct_room = Rooms::Direct.create_for({ creator: @alice }, users: User.where(id: [ @alice.id, @bot.id ]))
+    message = direct_room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+    )
+
+    payload = @webhook.payload_for(message)
+    assert_equal @alice.name, payload[:room][:name]
+    assert_equal "/rooms/#{direct_room.id}/#{@bot.bot_key}/messages", payload[:room][:reply_to]
+    assert_equal "/rooms/#{direct_room.id}/@#{message.id}", payload[:message][:link]
+  end
+
+  test "deliver sends JSON POST and posts reply on 200 text/plain" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} restart the build</div>"
+    )
+
+    stub = WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .with(
+        headers: { "Content-Type" => "application/json" },
+        body: ->(body) {
+          parsed = JSON.parse(body)
+          parsed["event"] == "mention" &&
+            parsed.dig("author", "id") == @alice.id &&
+            parsed.dig("author", "name") == @alice.name &&
+            parsed.dig("room", "id") == @room.id &&
+            parsed.dig("room", "name") == @room.name &&
+            parsed.dig("room", "reply_to") == "/rooms/#{@room.id}/#{@bot.bot_key}/messages" &&
+            parsed.dig("message", "id") == message.id &&
+            parsed.dig("message", "body", "text") == "restart the build" &&
+            parsed.dig("message", "link") == "/rooms/#{@room.id}/@#{message.id}"
+        }
+      )
+      .to_return(
+        status: 200,
+        body: "Build restarted ✅\nCheck <b>logs</b> & status\n",
+        headers: { "Content-Type" => "text/plain; charset=utf-8" }
+      )
+
+    reply = nil
+    assert_difference -> { @room.messages.count }, +1 do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        reply = @webhook.deliver(message)
+      end
+    end
+
+    assert_requested stub
+    assert_equal @bot, reply.creator
+    assert_equal "Build restarted ✅\nCheck <b>logs</b> & status", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "&lt;b&gt;logs&lt;/b&gt;"
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body", text: /Build restarted ✅/
+      assert_select ".message__body b", count: 0
+    end
+  end
