+class User::BotTest < ActiveSupport::TestCase
+  test "creating a bot sets role, creator, empty password_digest, unique bot_key, and add_to_all_open_rooms false by default" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
