+test "full flooding lifecycle across API posts and webhook replies, suspension, and admin reactivation" do
+  bot = create_bot_in_room(name: "Chatty Bot", webhook_url: "https://chatty.example.com/hook")
+
+  travel_to Time.zone.parse("2026-11-20 12:00:00 UTC") do
+    # 7 posts through the API
+    7.times do |i|
+      post room_bot_messages_url(@room, bot.bot_key),
+        params: +"API message #{i + 1}",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :created
+    end
+
+    # 3 webhook replies bring the total to 10 messages in 10 seconds
+    WebMock.stub_request(:post, "https://chatty.example.com/hook")
+      .to_return(status: 200, body: "Webhook reply", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { bot.messages.count }, +3 do
+      3.times do |i|
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          post room_messages_url(@room, format: :turbo_stream), params: {
+            message: { body: "<div>#{mention_attachment_for(bot)} ping #{i}</div>" }
+          }
+        end
+      end
+    end
+
+    # 11th message via API is rejected with 429 and starts a 30s cooldown
+    assert_no_difference -> { bot.messages.count } do
+      post room_bot_messages_url(@room, bot.bot_key),
+        params: +"Over limit",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+
+    # During cooldown: 2 webhook replies are NOT posted (attempts 1 & 2 during cooldown)
+    assert_no_difference -> { bot.messages.count } do
+      2.times do |i|
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          post room_messages_url(@room, format: :turbo_stream), params: {
+            message: { body: "<div>#{mention_attachment_for(bot)} during cooldown #{i}</div>" }
+          }
+        end
+      end
+    end
+    assert_not bot.reload.suspended?
+
+    # 2 more API attempts during cooldown (attempts 3 & 4) return 429 with Retry-After
+    travel 10.seconds
+    2.times do |i|
+      post room_bot_messages_url(@room, bot.bot_key),
+        params: +"Cooldown API #{i}",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :too_many_requests
+      assert_equal "20", response.headers["Retry-After"]
+      assert_not bot.reload.suspended?
+    end
+
+    # 5th attempt during cooldown (via API) suspends the bot
+    post room_bot_messages_url(@room, bot.bot_key),
+      params: +"Fifth strike",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :forbidden
+    assert bot.reload.suspended?
+    assert_equal User::Bot::FLOODING_SUSPENSION_REASON, bot.suspension_reason
+
+    # Suspended bot receives NO webhooks on mention or room join (no jobs enqueued)
+    WebMock.reset!
+    stub = WebMock.stub_request(:post, "https://chatty.example.com/hook").to_return(status: 204)
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} hello?</div>" }
+      }
+    end
+
+    sign_in :david
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: rooms(:designers).name },
+        user_ids: rooms(:designers).user_ids + [ bot.id ]
+      }
+    end
+    assert_not_requested stub
+
+    # Admin sees Suspended + flooding reason and Reactivate button on /bots
+    get bots_url
+    assert_response :success
+    assert_select "li##{dom_id(bot)} strong", text: "Suspended"
+    assert_select "li##{dom_id(bot)}", text: /Flooding/
+    assert_select "li##{dom_id(bot)} button[data-turbo-confirm]", text: "Reactivate"
+
+    # Admin reactivates the bot
+    post bot_reactivation_url(bot)
+    assert_redirected_to bots_url
+    assert_not bot.reload.suspended?
+
+    # Bot can post via API and receive/reply to webhooks immediately
+    post room_bot_messages_url(@room, bot.bot_key),
+      params: +"Back in action",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+
+    WebMock.reset!
+    WebMock.stub_request(:post, "https://chatty.example.com/hook")
+      .to_return(status: 200, body: "Webhook back!", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { bot.messages.count }, +1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        post room_messages_url(@room, format: :turbo_stream), params: {
+          message: { body: "<div>#{mention_attachment_for(bot)} welcome back</div>" }
+        }
+      end
+    end
+    assert_equal "Webhook back!", bot.messages.order(:id).last.plain_text_body
+  end
+end
+
+test "full failing webhooks lifecycle stops queued deliveries after 10th failure, skips bulk open-room joined hooks, and recovers after admin reactivation" do
+  bot = create_bot_in_room(name: "Flaky Hook Bot", webhook_url: "https://flaky.example.com/hook")
+  bot.update!(add_to_all_open_rooms: true)
+  clear_enqueued_jobs
+
+  # Enqueue 12 mention deliveries while endpoint is returning 500
+  12.times do |i|
+    post room_messages_url(@room, format: :turbo_stream), params: {
+      message: { body: "<div>#{mention_attachment_for(bot)} job #{i + 1}</div>" }
+    }
+  end
+
+  WebMock.stub_request(:post, "https://flaky.example.com/hook").to_return(status: 500)
+
+  perform_enqueued_jobs only: Webhook::DeliveryJob
+
+  # Only 10 HTTP requests were attempted; jobs 11 and 12 skipped delivery once suspended
+  assert_requested :post, "https://flaky.example.com/hook", times: 10
+  assert bot.reload.suspended?
+  assert_equal User::Bot::FAILING_WEBHOOKS_SUSPENSION_REASON, bot.suspension_reason
+
+  # Suspended bot gets 403 from posting endpoint
+  post room_bot_messages_url(@room, bot.bot_key),
+    params: +"Cannot post",
+    headers: { "CONTENT_TYPE" => "text/plain" }
+  assert_response :forbidden
+
+  # Creating a new open room (bulk grant_all) does NOT enqueue a joined webhook for the suspended bot
+  sign_in :david
+  assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+    post rooms_opens_url, params: { room: { name: "New Open Room" } }
+  end
+
+  # Owner fixes webhook URL; bot stays suspended until admin reactivates
+  sign_in :kevin
+  patch bot_url(bot), params: { bot: { name: bot.name, webhook_url: "https://healthy.example.com/hook" } }
+  assert_redirected_to bots_url
+  assert bot.reload.suspended?
+
+  # Owner cannot reactivate
+  post bot_reactivation_url(bot)
+  assert_response :forbidden
+  assert bot.reload.suspended?
+
+  # Admin reactivates
+  sign_in :david
+  post bot_reactivation_url(bot)
+  assert_redirected_to bots_url
+  assert_not bot.reload.suspended?
+
+  # Now webhook delivers to the fixed URL and posts reply
+  WebMock.reset!
+  WebMock.stub_request(:post, "https://healthy.example.com/hook")
+    .to_return(status: 200, body: "All fixed!", headers: { "Content-Type" => "text/plain" })
+
+  assert_difference -> { bot.messages.count }, +1 do
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} status?</div>" }
+      }
+    end
+  end
+  assert_equal "All fixed!", @room.messages.ordered.last.plain_text_body
+end
+
+  private
+    def create_bot_in_room(name:, webhook_url: nil, room: @room)
+      bot = User.create_bot!(name: name, creator: @alice, webhook_url: webhook_url)
+      room.memberships.grant_to(bot)
+      clear_enqueued_jobs
+      bot
+    end
+end
