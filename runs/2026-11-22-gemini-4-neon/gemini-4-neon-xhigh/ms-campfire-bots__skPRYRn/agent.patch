+<% @page_title = "Chat bots" %>
+
+<% content_for :head do %>
+  <meta name="turbo-cache-control" content="no-store">
+<% end %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+<% end %>
+
+<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: bots">
+  <h1 class="txt-x-large margin-none">Chat bots</h1>
+
+  <% if Current.user.can_create_bot? %>
+    <div class="flex justify-center">
+      <%= link_to new_bot_path, class: "btn btn--reversed" do %>
+        <%= image_tag "add.svg", size: 20, aria: { hidden: "true" } %>
+        <span>Add a chat bot</span>
+      <% end %>
+    </div>
+  <% else %>
+    <p class="txt-subtle margin-none" role="status">
+      You've reached the limit of <%= pluralize(Current.account.settings.bots_per_member, "chat bot") %>.
