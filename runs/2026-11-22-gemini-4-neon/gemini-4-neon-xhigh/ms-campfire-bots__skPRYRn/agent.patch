@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+    @message = @room.messages.create!(
+      creator: users(:kevin),
+      body: "<div>#{mention_attachment_for(@bot)} deploy</div>"
+    )
+  end
+
+  test "uses the default queue processed by Resque" do
+    assert_equal "default", Webhook::DeliveryJob.new.queue_name
+  end
+
+  test "perform delegates to webhook.deliver for a message" do
+    WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .to_return(status: 200, body: "Deployed!", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      Webhook::DeliveryJob.perform_now(@bot.webhook, @message)
+    end
+
+    assert_equal "Deployed!", @room.messages.last.plain_text_body
+  end
+
+  test "perform delegates to webhook.deliver_joined for a room" do
+    WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .to_return(status: 200, body: "Hello room!", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      Webhook::DeliveryJob.perform_now(@bot.webhook, @room)
+    end
+
+    assert_equal "Hello room!", @room.messages.last.plain_text_body
+  end
+
+  test "joined job survives room converting between closed and open before execution" do
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+
+    job = Webhook::DeliveryJob.new(@bot.webhook, closed_room.becomes(Room))
+    serialized = job.serialize
+
+    closed_room.becomes!(Rooms::Open).save!
+
+    WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .to_return(status: 200, body: "Hello after opening!", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { closed_room.messages.count }, +1 do
+      ActiveJob::Base.execute(serialized)
+    end
+
+    assert_equal "Hello after opening!", closed_room.messages.last.plain_text_body
+  end
+
+  test "discards cleanly if webhook or room was removed before job executes" do
+    webhook = @bot.webhook
+    mention_job = Webhook::DeliveryJob.new(webhook, @message).serialize
+
+    @bot.update!(webhook_url: "")
+    assert_not Webhook.exists?(webhook.id)
+
+    assert_nothing_raised do
+      ActiveJob::Base.execute(mention_job)
+    end
+
+    @bot.update!(webhook_url: "https://bot.example.com/hook")
+    ephemeral_room = Rooms::Closed.create_for({ name: "Temp", creator: users(:david) }, users: [ users(:david), @bot ])
+    joined_job = Webhook::DeliveryJob.new(@bot.webhook, ephemeral_room.becomes(Room)).serialize
+    ephemeral_room.destroy!
+
+    assert_nothing_raised do
+      ActiveJob::Base.execute(joined_job)
+    end
+  end
+
+  test "does not enqueue joined job if transaction rolls back" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      ActiveRecord::Base.transaction do
+        rooms(:designers).memberships.grant_to(@bot)
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+end
