diff --git a/app/views/bots/_bot.html.erb b/app/views/bots/_bot.html.erb
new file mode 100644
index 0000000..06f2def
--- /dev/null
+++ b/app/views/bots/_bot.html.erb
@@ -0,0 +1,49 @@
+<li id="<%= dom_id(bot) %>" class="flex flex-column gap-half margin-none">
+  <div class="flex align-center gap">
+    <figure class="avatar flex-item-no-shrink" style="--avatar-size: 3.75ch;">
+      <%= avatar_tag bot, loading: :lazy %>
+    </figure>
+
+    <div class="min-width txt-align-start">
+      <div class="overflow-ellipsis"><strong><%= bot.name %></strong></div>
+      <% if bot.webhook.present? %>
+        <div class="overflow-ellipsis txt-small txt-subtle"><%= bot.webhook.url %></div>
+      <% end %>
+    </div>
+
+    <hr class="separator" aria-hidden="true">
+
+    <%= link_to edit_bot_path(bot), class: "btn txt-small flex-item-no-shrink", aria: { label: "Edit #{bot.name}" } do %>
+      <%= image_tag "pencil.svg", size: 20, aria: { hidden: "true" } %>
+      <span class="for-screen-reader">Edit <%= bot.name %></span>
+    <% end %>
+  </div>
+
+  <% if bot.suspended? %>
+    <div class="flex align-center justify-space-between gap pad-block-half pad-inline fill-white border-radius txt-align-start">
+      <div class="min-width txt-small">
+        <strong class="txt-negative">Suspended</strong><% if bot.suspension_reason_description.present? %><span>: <%= bot.suspension_reason_description %></span><% end %>
+      </div>
+
+      <% if Current.user.administrator? %>
+        <%= button_to bot_reactivation_path(bot), method: :post, class: "btn btn--reversed txt-small",
+              form_class: "flex-item-no-shrink",
+              data: { turbo_confirm: "Are you sure you want to reactivate #{bot.name}? It will be able to post messages and receive webhooks again." } do %>
+          <%= image_tag "refresh.svg", size: 16, aria: { hidden: "true" } %>
+          <span>Reactivate</span>
+        <% end %>
+      <% end %>
+    </div>
+  <% end %>
+
+  <div class="flex align-center gap-half">
+    <label for="<%= dom_id(bot, :code) %>" class="txt-small txt-subtle txt-nowrap flex-item-no-shrink">Bot code</label>
+    <input type="text" id="<%= dom_id(bot, :code) %>" class="input input--code txt-small flex-item-grow min-width fill-white" value="<%= bot.bot_key %>" autocomplete="off" readonly>
+    <span class="flex-item-no-shrink">
+      <%= button_to_copy_to_clipboard(bot.bot_key) do %>
+        <span class="for-screen-reader">Copy bot code</span>
+        <%= image_tag "copy-paste.svg", aria: { hidden: "true" }, size: 20, class: "colorize--black" %>
+      <% end %>
+    </span>
+  </div>
+</li>
diff --git a/app/views/bots/_form.html.erb b/app/views/bots/_form.html.erb
new file mode 100644
index 0000000..512e9a3
--- /dev/null
+++ b/app/views/bots/_form.html.erb
@@ -0,0 +1,59 @@
+<%= form_with model: bot, scope: :bot, url: bot.persisted? ? bot_path(bot) : bots_path, class: "flex flex-column gap" do |form| %>
+  <% if bot.errors.any? %>
+    <div class="txt-negative txt-small" role="alert">
+      <%= bot.errors.full_messages.to_sentence %>
+    </div>
+  <% end %>
+
+  <label class="align-center center avatar__form gap" data-controller="upload-preview">
+    <div class="btn input--file">
+      <%= image_tag "camera.svg", aria: { hidden: "true" }, size: 20 %>
+      <%= form.file_field :avatar, class: "input", accept: "image/*",
+            data: { upload_preview_target: "input", action: "upload-preview#previewImage" } %>
+      <span class="for-screen-reader">Upload avatar</span>
+    </div>
+
+    <div class="btn avatar input--file txt-xx-large">
+      <% if bot.persisted? %>
+        <%= image_tag fresh_user_avatar_path(bot), aria: { hidden: "true" }, size: 300, data: { upload_preview_target: "image" } %>
+      <% else %>
+        <%= image_tag "default-avatar.svg", aria: { hidden: "true" }, size: 300, data: { upload_preview_target: "image" } %>
+      <% end %>
+    </div>
+  </label>
+
+  <div class="flex align-center gap">
+    <label class="flex align-center gap flex-item-grow input input--actor">
+      <span class="for-screen-reader">Name the bot</span>
+      <%= form.text_field :name, class: "input txt-large", autocomplete: "off", placeholder: "Name the bot",
+            autofocus: true, required: true, data: { "1p-ignore": true } %>
+      <%= image_tag "bot.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
+    </label>
+  </div>
+
+  <div class="flex align-center gap">
+    <label class="flex align-center gap flex-item-grow input input--actor">
+      <span class="for-screen-reader">Webhook URL</span>
+      <%= form.url_field :webhook_url, class: "input txt-large", autocomplete: "off", placeholder: "Webhook URL",
+            data: { "1p-ignore": true } %>
+      <%= image_tag "link.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
+    </label>
+  </div>
+
+  <label class="pad-block pad-inline-double fill-shade border-radius flex align-center gap" style="cursor: pointer;">
+    <span class="flex-item-grow flex align-center gap txt-align-start">
+      <%= image_tag "everyone.svg", class: "colorize--black", aria: { hidden: "true" }, size: 18 %>
+      <span>Add to all open rooms</span>
+    </span>
+
+    <span class="switch flex-item-no-shrink">
+      <%= form.check_box :add_to_all_open_rooms, class: "switch__input" %>
+      <span class="switch__btn round"></span>
+    </span>
+  </label>
+
+  <%= form.button class: "btn btn--reversed center txt-large", type: "submit", aria: { label: "Save changes" } do %>
+    <%= image_tag "check.svg", aria: { hidden: "true" }, size: 20 %>
+    <span class="for-screen-reader">Save changes</span>
+  <% end %>
+<% end %>
