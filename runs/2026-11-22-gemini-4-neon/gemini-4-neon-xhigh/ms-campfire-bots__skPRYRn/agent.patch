+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_key),
+        params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+
+    # Other bot is completely unaffected
+    post room_bot_messages_url(@open_room, other_bot.bot_key),
+      params: +"Other bot works",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+  end
+end
+
+test "reactivating a suspended bot allows it to post via API again immediately" do
+  @bot.suspend!(reason: User::Bot::FAILING_WEBHOOKS_SUSPENSION_REASON)
+
+  post room_bot_messages_url(@open_room, @bot.bot_key),
+    params: +"Blocked",
+    headers: { "CONTENT_TYPE" => "text/plain" }
+  assert_response :forbidden
+
+  @bot.reactivate!
+
+  post room_bot_messages_url(@open_room, @bot.bot_key),
+    params: +"Welcome back",
+    headers: { "CONTENT_TYPE" => "text/plain" }
+  assert_response :created
+  assert_equal "Welcome back", @open_room.messages.last.plain_text_body
+end
+
+  private
+    def wait_for_web_push_delivery_pool_tasks(count)
+      pool = Rails.configuration.x.web_push_pool.delivery_pool
+      start = Time.now
+      timeout = 0.5
+      while pool.completed_task_count < count
+        raise "Timeout waiting for pool tasks to complete" if Time.now - start > timeout
+        sleep timeout / 10.0
+      end
+    end
+end
