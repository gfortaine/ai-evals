@@ -0,0 +1,14 @@
+class Webhook::DeliveryJob < ApplicationJob
+  self.enqueue_after_transaction_commit = true
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(webhook, target)
+    case target
+    when Message
+      webhook.deliver(target)
+    when Room
+      webhook.deliver_joined(target)
+    end
+  end
+end
