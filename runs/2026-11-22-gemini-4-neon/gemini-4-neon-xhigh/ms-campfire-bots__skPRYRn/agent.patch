@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = User.create_bot!(
+      name: "Misbehaving Bot",
+      creator: users(:kevin),
+      webhook_url: "https://bot.example.com/hook",
+      add_to_all_open_rooms: true
+    )
+    @bot.webhook.update_columns(consecutive_failures: 10)
+    @bot.suspend!(reason: User::Bot::FAILING_WEBHOOKS_SUSPENSION_REASON)
+  end
+
+  test "unauthenticated users are redirected to sign in" do
+    post bot_reactivation_url(@bot)
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+
+  test "non-admin members including the bot creator get forbidden and cannot reactivate" do
+    sign_in :kevin
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    sign_in :jz
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrator can reactivate a suspended bot and reset its suspension and failure state" do
+    sign_in :david
+
+    post bot_reactivation_url(@bot)
+    assert_redirected_to bots_url
+
+    @bot.reload
+    assert_not @bot.suspended?
+    assert_nil @bot.suspension_reason
+    assert_equal 0, @bot.webhook.reload.consecutive_failures
+  end
+
+  test "reactivating a nonexistent, deactivated, or non-bot user returns not found" do
+    sign_in :david
+
+    post bot_reactivation_url(999_999)
+    assert_response :not_found
+
+    post bot_reactivation_url(users(:kevin))
+    assert_response :not_found
+
+    @bot.deactivate
+    post bot_reactivation_url(@bot)
+    assert_response :not_found
+  end
+end
