diff --git a/app/models/webhook.rb b/app/models/webhook.rb
new file mode 100644
index 0000000..94e7b1e
--- /dev/null
+++ b/app/models/webhook.rb
@@ -0,0 +1,207 @@
+require "net/http"
+
+class Webhook < ApplicationRecord
+  OPEN_TIMEOUT = 7
+  READ_TIMEOUT = 15
+  WRITE_TIMEOUT = 7
+  MAX_RESPONSE_BYTES = 1.megabyte
+
+  ALLOWED_RESPONSE_CONTENT_TYPES = %w[ text/plain text/html ].freeze
+
+  NETWORK_ERRORS = [
+    Timeout::Error,
+    Errno::ECONNREFUSED,
+    Errno::ECONNRESET,
+    Errno::EHOSTUNREACH,
+    Errno::ENETUNREACH,
+    Errno::ETIMEDOUT,
+    Errno::EPIPE,
+    SocketError,
+    EOFError,
+    IOError,
+    OpenSSL::SSL::SSLError,
+    Net::HTTPExceptions,
+    Net::ProtocolError
+  ].freeze
+
+  belongs_to :user
+
+  normalizes :url, with: ->(url) { url.strip }
+
+  validates :url, presence: true
+  validate :url_must_be_http_or_https
+
+  def self.valid_url?(url)
+    return false if url.blank?
+
+    uri = URI.parse(url.to_s.strip)
+    uri.is_a?(URI::HTTP) && uri.host.present? && (uri.port.nil? || uri.port.between?(1, 65_535))
+  rescue URI::InvalidURIError
+    false
+  end
+
+  def deliver_later(message)
+    Webhook::DeliveryJob.perform_later(self, message)
+  end
+
+  def deliver(message)
+    return unless deliverable_for?(message)
+
+    response, raw_body = post_payload(payload_for(message))
+    handle_response(response, raw_body, message.room)
+  rescue *NETWORK_ERRORS => e
+    Rails.logger.warn "Webhook##{id} delivery failed for Message##{message.id}: #{e.class} #{e.message}"
+    nil
+  end
+
+  def payload_for(message)
+    room = message.room
+
+    {
+      event: "mention",
+      author: {
+        id: message.creator_id,
+        name: message.creator.name
+      },
+      room: {
+        id: room.id,
+        name: room_name_for(room),
+        reply_to: routes.room_bot_messages_path(room, user.bot_key)
+      },
+      message: {
+        id: message.id,
+        body: {
+          text: plain_text_without_self_mention(message),
+          html: message.body.body&.to_html.to_s
+        },
+        link: routes.room_at_message_path(room, message)
+      }
+    }
+  end
+
+  private
+    def url_must_be_http_or_https
+      if url.present? && !self.class.valid_url?(url)
+        errors.add(:url, "must be a valid HTTP or HTTPS URL")
+      end
+    end
+
+    def deliverable_for?(message)
+      user.active? && user.bot? && user.bot_key.present? && !message.creator.bot? && user.rooms.exists?(message.room_id)
+    end
+
+    def post_payload(payload)
+      uri = URI.parse(url)
+      request = Net::HTTP::Post.new(uri)
+      request["Content-Type"] = "application/json"
+      request["User-Agent"] = "Campfire"
+      request.body = payload.to_json
+
+      Net::HTTP.start(
+        uri.host,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT,
+        write_timeout: WRITE_TIMEOUT
+      ) do |http|
+        http.request(request) do |response|
+          body = read_capped_body(response) if response.is_a?(Net::HTTPOK) && allowed_content_type?(response)
+          return [ response, body ]
+        end
+      end
+    end
+
+    def read_capped_body(response)
+      return nil if response.content_length && response.content_length > MAX_RESPONSE_BYTES
+
+      buffer = String.new(encoding: Encoding::BINARY)
+      response.read_body do |chunk|
+        return nil if buffer.bytesize + chunk.bytesize > MAX_RESPONSE_BYTES
+        buffer << chunk.b
+      end
+
+      decode_response_body(buffer, response.type_params["charset"])
+    end
+
+    def decode_response_body(raw_body, charset)
+      encoding = find_encoding(charset)
+      decoded = raw_body.dup.force_encoding(encoding)
+      decoded = decoded.encode(Encoding::UTF_8, invalid: :replace, undef: :replace) unless encoding == Encoding::UTF_8
+      decoded.valid_encoding? ? decoded : decoded.scrub
+    end
+
+    def find_encoding(charset)
+      charset.present? ? Encoding.find(charset) : Encoding::UTF_8
+    rescue ArgumentError
+      Encoding::UTF_8
+    end
+
+    def handle_response(response, raw_body, room)
+      return unless response.is_a?(Net::HTTPOK)
+      return unless allowed_content_type?(response)
+      return if raw_body.blank?
+
+      formatted_body = format_response_body(raw_body, response.content_type)
+      return if formatted_body.blank?
+
+      reply = room.messages.create!(body: formatted_body, creator: user)
+      reply.broadcast_create
+      reply
+    end
+
+    def allowed_content_type?(response)
+      ALLOWED_RESPONSE_CONTENT_TYPES.include?(response.content_type)
+    end
+
+    def format_response_body(raw_body, content_type)
+      case content_type
+      when "text/plain"
+        escaped = ERB::Util.html_escape(raw_body.strip).gsub(/\r\n?|\n/, "<br>")
+        "<div>#{escaped}</div>"
+      when "text/html"
+        raw_body
+      end
+    end
+
+    def plain_text_without_self_mention(message)
+      content = message.body.body
+      return "" unless content
+
+      fragment = content.fragment.update do |source|
+        source.css(ActionText::Attachment.tag_name).each do |node|
+          next unless ActionText::Attachment.from_node(node).attachable == user
+
+          collapse_surrounding_space(node)
+          node.remove
+        end
+      end
+
+      ActionText::Content.new(fragment, canonicalize: false)
+        .to_plain_text
+        .gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+
+    def collapse_surrounding_space(node)
+      prev_node = node.previous_sibling
+      next_node = node.next_sibling
+
+      if prev_node&.text? && next_node&.text? &&
+         prev_node.content.match?(/[ \t\u00A0]\z/) &&
+         next_node.content.match?(/\A[ \t\u00A0]/)
+        next_node.content = next_node.content.sub(/\A[ \t\u00A0]/, "")
+        next_node.remove if next_node.content.empty?
+      elsif (prev_node.nil? || prev_node.name == "br") && next_node&.text?
+        next_node.content = next_node.content.sub(/\A[ \t\u00A0]+/, "")
+        next_node.remove if next_node.content.empty?
+      end
+    end
+
+    def room_name_for(room)
+      room.name.presence || room.users.without(user).ordered.pluck(:name).to_sentence
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+end
