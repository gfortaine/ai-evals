+++ b/test/integration/bot_webhooks_test.rb
@@ -0,0 +1,196 @@
+require "test_helper"
+require "socket"
+
+class BotWebhooksTest < ActionDispatch::IntegrationTest
+  setup do
+    @alice = users(:kevin)
+    @room = rooms(:hq)
+    sign_in @alice
+  end
+
+  test "mentioning a bot enqueues webhook delivery asynchronously without blocking the message POST" do
+    bot = User.create_bot!(name: "Slow Bot", creator: @alice, webhook_url: "https://slow.example.com/hook")
+
+    # No WebMock stub is registered: if any synchronous HTTP request occurred, WebMock would raise!
+    assert_difference -> { @room.messages.count }, +1 do
+      assert_enqueued_with(job: Webhook::DeliveryJob) do
+        post room_messages_url(@room, format: :turbo_stream), params: {
+          message: { body: "<div>#{mention_attachment_for(bot)} restart the build please</div>" }
+        }
+      end
+    end
+
+    assert_response :success
+  end
+
+  test "synchronous 200 text/plain reply posts into the room as the bot" do
+    bot = User.create_bot!(name: "Build Bot", creator: @alice, webhook_url: "https://build.example.com/hook")
+
+    WebMock.stub_request(:post, "https://build.example.com/hook")
+      .to_return(status: 200, body: "Restarting build #99", headers: { "Content-Type" => "text/plain" })
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} restart the build please</div>" }
+      }
+    end
+
+    assert_response :success
+    reply = @room.messages.ordered.last
+    assert_equal bot, reply.creator
+    assert_equal "Restarting build #99", reply.plain_text_body
+  end
+
+  test "synchronous 200 text/html reply posts rich HTML into the room as the bot" do
+    bot = User.create_bot!(name: "HTML Bot", creator: @alice, webhook_url: "https://html.example.com/hook")
+
+    WebMock.stub_request(:post, "https://html.example.com/hook")
+      .to_return(status: 200, body: "<div>Build <strong>green</strong>!</div>", headers: { "Content-Type" => "text/html" })
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} status</div>" }
+      }
+    end
+
+    reply = @room.messages.ordered.last
+    assert_equal bot, reply.creator
+    assert_equal "Build green!", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>green</strong>"
+  end
+
+  test "204 response posts nothing, and bot can reply asynchronously via room.reply_to and inspect message.link" do
+    bot = User.create_bot!(name: "Async Bot", creator: @alice, webhook_url: "https://async.example.com/hook")
+    captured_payload = nil
+
+    WebMock.stub_request(:post, "https://async.example.com/hook")
+      .with { |req| captured_payload = JSON.parse(req.body); true }
+      .to_return(status: 204)
+
+    assert_difference -> { @room.messages.count }, +1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        post room_messages_url(@room, format: :turbo_stream), params: {
+          message: { body: "<div>#{mention_attachment_for(bot)} run nightly suite</div>" }
+        }
+      end
+    end
+
+    assert_not_nil captured_payload
+    assert_equal "mention", captured_payload["event"]
+    assert_equal "run nightly suite", captured_payload.dig("message", "body", "text")
+
+    # Deep link opens the room at that message
+    get captured_payload.dig("message", "link")
+    assert_response :success
+    assert_select "##{dom_id(@room.messages.ordered.last)}"
+
+    # Bot replies out-of-band later using room.reply_to
+    assert_difference -> { @room.messages.count }, +1 do
+      post captured_payload.dig("room", "reply_to"),
+        params: +"Nightly suite finished: 100% green!",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :created
+    reply = @room.messages.ordered.last
+    assert_equal bot, reply.creator
+    assert_equal "Nightly suite finished: 100% green!", reply.plain_text_body
+  end
+
+  test "mentioning two bots triggers independent webhooks with each bot's own reply_to and stripped text" do
+    bot_a = User.create_bot!(name: "Alpha Bot", creator: @alice, webhook_url: "https://alpha.example.com/hook")
+    bot_b = User.create_bot!(name: "Beta Bot", creator: @alice, webhook_url: "https://beta.example.com/hook")
+
+    payloads = {}
+    WebMock.stub_request(:post, "https://alpha.example.com/hook")
+      .with { |req| payloads[:a] = JSON.parse(req.body); true }
+      .to_return(status: 204)
+    WebMock.stub_request(:post, "https://beta.example.com/hook")
+      .with { |req| payloads[:b] = JSON.parse(req.body); true }
+      .to_return(status: 204)
+
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot_a)} #{mention_attachment_for(bot_b)} report in</div>" }
+      }
+    end
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_equal "/rooms/#{@room.id}/#{bot_a.bot_key}/messages", payloads[:a].dig("room", "reply_to")
+    assert_equal "@Beta Bot report in", payloads[:a].dig("message", "body", "text")
+
+    assert_equal "/rooms/#{@room.id}/#{bot_b.bot_key}/messages", payloads[:b].dig("room", "reply_to")
+    assert_equal "@Alpha Bot report in", payloads[:b].dig("message", "body", "text")
+  end
+
+  test "mentioning the same bot twice triggers its webhook only once" do
+    bot = User.create_bot!(name: "Once Bot", creator: @alice, webhook_url: "https://once.example.com/hook")
+
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} hello #{mention_attachment_for(bot)}</div>" }
+      }
+    end
+  end
+
+  test "mentioning a bot without a webhook or outside a closed room does not enqueue webhook jobs" do
+    bot_without_webhook = User.create_bot!(name: "Quiet Bot", creator: @alice)
+    bot_with_webhook = User.create_bot!(name: "Closed Bot", creator: @alice, webhook_url: "https://closed.example.com/hook")
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot_without_webhook)} hello</div>" }
+      }
+    end
+
+    sign_in :david
+    closed_room = rooms(:designers)
+    assert_not_includes closed_room.users, bot_with_webhook
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(closed_room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot_with_webhook)} hello</div>" }
+      }
+    end
+  end
+
+  test "echoing HTML containing bot mentions in a synchronous reply does not trigger a webhook loop" do
+    bot = User.create_bot!(name: "Echo Bot", creator: @alice, webhook_url: "https://echo.example.com/hook")
+
+    WebMock.stub_request(:post, "https://echo.example.com/hook")
+      .to_return do |request|
+        payload = JSON.parse(request.body)
+        {
+          status: 200,
+          body: payload.dig("message", "body", "html"),
+          headers: { "Content-Type" => "text/html" }
+        }
+      end
+
+    assert_difference -> { @room.messages.count }, +2 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        post room_messages_url(@room, format: :turbo_stream), params: {
+          message: { body: "<div>#{mention_attachment_for(bot)} echo me</div>" }
+        }
+      end
+    end
+
+    assert_requested :post, "https://echo.example.com/hook", times: 1
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob
+  end
+
+  test "removing a bot's webhook prevents subsequent mentions from triggering callbacks" do
+    bot = User.create_bot!(name: "Toggle Bot", creator: @alice, webhook_url: "https://toggle.example.com/hook")
+
+    patch bot_url(bot), params: { bot: { name: bot.name, webhook_url: "" } }
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} hello</div>" }
+      }
+    end
+  end
+end
diff --git a/test/jobs/webhook/delivery_job_test.rb b/test/jobs/webhook/delivery_job_test.rb
