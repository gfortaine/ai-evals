@@ -79,4 +79,49 @@ class User::BotTest < ActiveSupport::TestCase
     assert_nothing_raised { User.destroy_all }
     assert_not User.exists?(bot.id)
   end
+
+  test "creating and updating a bot manages its optional webhook" do
+    bot = User.create_bot!(name: "Hook Bot", creator: users(:kevin), webhook_url: "  https://bot.example.com/hook  ")
+    assert_equal "https://bot.example.com/hook", bot.webhook_url
+    assert_equal "https://bot.example.com/hook", bot.webhook.url
+
+    # Updating only the name preserves the existing webhook
+    bot.update!(name: "Hook Bot v2")
+    assert_equal "https://bot.example.com/hook", bot.reload.webhook_url
+
+    # Updating webhook_url updates the existing webhook record
+    webhook_id = bot.webhook.id
+    bot.update!(webhook_url: "http://127.0.0.1:4567/new")
+    assert_equal webhook_id, bot.reload.webhook.id
+    assert_equal "http://127.0.0.1:4567/new", bot.webhook_url
+
+    # Clearing webhook_url removes the webhook
+    bot.update!(webhook_url: "   ")
+    assert_nil bot.webhook
+    assert_nil bot.webhook_url
+    assert_not Webhook.exists?(webhook_id)
+  end
+
+  test "invalid webhook_url fails validation without altering existing webhook and reload clears unsaved value" do
+    bot = User.create_bot!(name: "Hook Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+
+    assert_not bot.update(webhook_url: "ftp://invalid.example.com")
+    assert_includes bot.errors.full_messages, "Webhook URL must be a valid HTTP or HTTPS URL"
+    assert_equal "ftp://invalid.example.com", bot.webhook_url
+    assert_equal "https://bot.example.com/hook", bot.reload.webhook_url
+
+    # Validation failure on name must not prematurely delete an existing webhook
+    assert_not bot.update(name: "", webhook_url: "")
+    assert_equal "https://bot.example.com/hook", bot.reload.webhook_url
+  end
+
+  test "deactivating a bot destroys its webhook" do
+    bot = User.create_bot!(name: "Hook Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+    webhook_id = bot.webhook.id
+
+    bot.deactivate
+
+    assert_nil bot.webhook
+    assert_not Webhook.exists?(webhook_id)
+  end
 end
diff --git a/test/models/webhook_test.rb b/test/models/webhook_test.rb
new file mode 100644
index 0000000..d0cc98f
--- /dev/null
+++ b/test/models/webhook_test.rb
@@ -0,0 +1,353 @@
+require "test_helper"
+require "socket"
+
+class WebhookTest < ActiveSupport::TestCase
+  include ActionDispatch::Assertions::SelectorAssertions
+  setup do
+    @alice = users(:kevin)
+    @room = rooms(:hq)
+    @bot = User.create_bot!(name: "Deploy Bot", creator: @alice, webhook_url: "https://bot.example.com/hook")
+    @webhook = @bot.webhook
+  end
+
+  test "validates HTTP and HTTPS URLs and rejects invalid or non-HTTP URLs" do
+    valid_urls = [
+      "https://bot.example.com/hook",
+      "http://bot.example.com/hook?token=abc&env=prod",
+      "http://127.0.0.1:4567/campfire",
+      "http://localhost:8080/events",
+      "http://[::1]:4567/hook",
+      "https://hooks.example.com",
+      "  https://bot.example.com/trimmed  "
+    ]
+
+    valid_urls.each do |url|
+      assert Webhook.valid_url?(url), "Expected #{url.inspect} to be valid"
+      webhook = Webhook.new(user: @bot, url: url)
+      assert webhook.valid?, "Expected Webhook with #{url.inspect} to be valid: #{webhook.errors.full_messages}"
+    end
+
+    invalid_urls = [
+      "",
+      "   ",
+      "not-a-url",
+      "example.com/hook",
+      "ftp://bot.example.com/hook",
+      "javascript:alert(1)",
+      "file:///etc/passwd",
+      "http://",
+      "https:///only-path",
+      "http://bad host/hook",
+      "http://example.com:99999/hook",
+      "http://example.com/hook\r\nX-Injected: yes"
+    ]
+
+    invalid_urls.each do |url|
+      assert_not Webhook.valid_url?(url), "Expected #{url.inspect} to be invalid"
+      webhook = Webhook.new(user: @bot, url: url)
+      assert_not webhook.valid?, "Expected Webhook with #{url.inspect} to be invalid"
+    end
+  end
+
+  test "url is normalized by stripping whitespace" do
+    @webhook.update!(url: "  https://bot.example.com/clean  ")
+    assert_equal "https://bot.example.com/clean", @webhook.url
+  end
+
+  test "payload_for builds the exact mention payload with relative paths and stripped self-mention" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)}&nbsp;restart the <strong>build</strong> please</div>"
+    )
+
+    payload = @webhook.payload_for(message)
+
+    assert_equal "mention", payload[:event]
+    assert_equal({ id: @alice.id, name: @alice.name }, payload[:author])
+    assert_equal({
+      id: @room.id,
+      name: @room.name,
+      reply_to: "/rooms/#{@room.id}/#{@bot.bot_key}/messages"
+    }, payload[:room])
+    assert_equal message.id, payload[:message][:id]
+    assert_equal "restart the build please", payload[:message][:body][:text]
+    assert_equal message.body.body.to_html, payload[:message][:body][:html]
+    assert_includes payload[:message][:body][:html], "<strong>build</strong>"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload[:message][:link]
+  end
+
+  test "payload_for strips only the bot's own @-mention across edge cases without mutating message body" do
+    other_bot = User.create_bot!(name: "QA Bot", creator: @alice)
+
+    cases = [
+      [ "<div>#{mention_attachment_for(@bot)} restart the build please</div>", "restart the build please" ],
+      [ "<div>#{mention_attachment_for(@bot)}&nbsp;restart the build please</div>", "restart the build please" ],
+      [ "<div>please #{mention_attachment_for(@bot)} restart the build</div>", "please restart the build" ],
+      [ "<div>restart the build #{mention_attachment_for(@bot)}</div>", "restart the build" ],
+      [ "<div>#{mention_attachment_for(@bot)}</div>", "" ],
+      [ "<div>#{mention_attachment_for(@bot)}&nbsp;</div>", "" ],
+      [ "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(@bot)} hello</div>", "hello" ],
+      [ "<div>Hey #{mention_attachment_for(@bot)} #{mention_attachment_for(@bot)} check this</div>", "Hey check this" ],
+      [ "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(other_bot)} status</div>", "@QA Bot status" ],
+      [ "<div>#{mention_attachment_for(other_bot)} #{mention_attachment_for(@bot)} status</div>", "@QA Bot status" ],
+      [ "<div>#{mention_attachment_for(@bot)} deploy:<br>- app<br>- worker</div>", "deploy:\n- app\n- worker" ],
+      [ "<div>restart<br>#{mention_attachment_for(@bot)} please</div>", "restart\nplease" ],
+      [ "<div>#{mention_attachment_for(@bot)} tell @Deploy Bot users hi</div>", "tell @Deploy Bot users hi" ],
+      [ "<div><strong>#{mention_attachment_for(@bot)}</strong> restart</div>", "restart" ],
+      [ "<div>#{mention_attachment_for(@bot)}</div><div>restart the build</div>", "restart the build" ],
+      [ "<div>#{mention_attachment_for(:david)} and #{mention_attachment_for(@bot)} check</div>", "@David and check" ]
+    ]
+
+    cases.each do |html, expected_text|
+      message = @room.messages.create!(creator: @alice, body: html)
+      original_html = message.body.body.to_html
+
+      payload = @webhook.payload_for(message)
+
+      assert_equal expected_text, payload[:message][:body][:text], "Failed for HTML: #{html}"
+      assert_equal original_html, message.body.body.to_html, "Message body was mutated for HTML: #{html}"
+    end
+  end
+
+  test "payload_for provides participant name when mentioned in a direct room" do
+    direct_room = Rooms::Direct.create_for({ creator: @alice }, users: User.where(id: [ @alice.id, @bot.id ]))
+    message = direct_room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+    )
+
+    payload = @webhook.payload_for(message)
+    assert_equal @alice.name, payload[:room][:name]
+    assert_equal "/rooms/#{direct_room.id}/#{@bot.bot_key}/messages", payload[:room][:reply_to]
+    assert_equal "/rooms/#{direct_room.id}/@#{message.id}", payload[:message][:link]
+  end
+
+  test "deliver sends JSON POST and posts reply on 200 text/plain" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} restart the build</div>"
+    )
+
+    stub = WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .with(
+        headers: { "Content-Type" => "application/json" },
+        body: ->(body) {
+          parsed = JSON.parse(body)
+          parsed["event"] == "mention" &&
+            parsed.dig("author", "id") == @alice.id &&
+            parsed.dig("author", "name") == @alice.name &&
+            parsed.dig("room", "id") == @room.id &&
+            parsed.dig("room", "name") == @room.name &&
+            parsed.dig("room", "reply_to") == "/rooms/#{@room.id}/#{@bot.bot_key}/messages" &&
+            parsed.dig("message", "id") == message.id &&
+            parsed.dig("message", "body", "text") == "restart the build" &&
+            parsed.dig("message", "link") == "/rooms/#{@room.id}/@#{message.id}"
+        }
+      )
+      .to_return(
+        status: 200,
+        body: "Build restarted ✅\nCheck <b>logs</b> & status\n",
+        headers: { "Content-Type" => "text/plain; charset=utf-8" }
+      )
+
+    reply = nil
+    assert_difference -> { @room.messages.count }, +1 do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        reply = @webhook.deliver(message)
+      end
+    end
+
+    assert_requested stub
+    assert_equal @bot, reply.creator
+    assert_equal "Build restarted ✅\nCheck <b>logs</b> & status", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "&lt;b&gt;logs&lt;/b&gt;"
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body", text: /Build restarted ✅/
+      assert_select ".message__body b", count: 0
+    end
+  end
+
+  test "deliver posts rich HTML reply on 200 text/html and sanitizes unsafe markup on broadcast" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} status</div>"
+    )
+
+    WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .to_return(
+        status: 200,
+        body: '<div><strong>Build #42</strong> <script>alert(1)</script><a href="https://ci.example/42" onclick="evil()">view</a></div>',
+        headers: { "Content-Type" => "text/html; charset=utf-8" }
+      )
+
+    reply = nil
+    assert_difference -> { @room.messages.count }, +1 do
+      reply = @webhook.deliver(message)
+    end
+
+    assert_equal @bot, reply.creator
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select "strong", text: "Build #42"
+      assert_select "a[href='https://ci.example/42']", text: "view"
+      assert_select "script", count: 0
+      assert_select "a[onclick]", count: 0
+    end
+  end
+
+  test "deliver posts no message on 204 No Content" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} quiet</div>"
+    )
+
+    WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 204)
+
+    assert_no_difference -> { @room.messages.count } do
+      assert_nil @webhook.deliver(message)
+    end
+  end
+
+  test "deliver posts no message on unsupported content types, empty bodies, or non-200 statuses" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} check</div>"
+    )
+
+    non_posting_responses = [
+      { status: 200, body: '{"ok":true}', headers: { "Content-Type" => "application/json" } },
+      { status: 200, body: "no content type", headers: {} },
+      { status: 200, body: "   \n\t  ", headers: { "Content-Type" => "text/plain" } },
+      { status: 200, body: "", headers: { "Content-Type" => "text/html" } },
+      { status: 201, body: "Created", headers: { "Content-Type" => "text/plain" } },
+      { status: 302, body: "", headers: { "Location" => "https://other.example/hook" } },
+      { status: 404, body: "Not found", headers: { "Content-Type" => "text/plain" } },
+      { status: 500, body: "Internal error", headers: { "Content-Type" => "text/plain" } }
+    ]
+
+    non_posting_responses.each do |resp|
+      WebMock.reset!
+      WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(**resp)
+
+      assert_no_difference -> { @room.messages.count }, "Expected no message for #{resp.inspect}" do
+        assert_nil @webhook.deliver(message)
+      end
+    end
+  end
+
+  test "deliver handles network errors and timeouts gracefully without raising or posting" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} check</div>"
+    )
+
+    [ Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, SocketError ].each do |error_class|
+      WebMock.reset!
+      WebMock.stub_request(:post, "https://bot.example.com/hook").to_raise(error_class)
+
+      assert_no_difference -> { @room.messages.count } do
+        assert_nothing_raised do
+          assert_nil @webhook.deliver(message)
+        end
+      end
+    end
+  end
+
+  test "deliver ignores oversized response bodies" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} huge</div>"
+    )
+
+    oversized = "a" * (Webhook::MAX_RESPONSE_BYTES + 1)
+    WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .to_return(status: 200, body: oversized, headers: { "Content-Type" => "text/plain" })
+
+    assert_no_difference -> { @room.messages.count } do
+      assert_nil @webhook.deliver(message)
+    end
+  end
+
+  test "deliver transcodes non-UTF-8 charset response bodies safely" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} coffee</div>"
+    )
+
+    latin1_body = "Caf\xE9".b
+    WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .to_return(status: 200, body: latin1_body, headers: { "Content-Type" => "text/plain; charset=ISO-8859-1" })
+
+    reply = @webhook.deliver(message)
+    assert_equal "Café", reply.plain_text_body
+  end
+
+  test "deliver skips if bot is deactivated, removed from room, or message is from a bot" do
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} hello</div>"
+    )
+
+    # Bot message should never trigger webhook even if delivered directly
+    bot_message = @room.messages.create!(
+      creator: @bot,
+      body: "<div>#{mention_attachment_for(@bot)} echo</div>"
+    )
+    assert_nil @webhook.deliver(bot_message)
+
+    # Bot removed from closed room should not receive delivery
+    closed_room = rooms(:designers)
+    closed_message = closed_room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} secret</div>"
+    )
+    assert_nil @webhook.deliver(closed_message)
+
+    # Deactivated bot should not receive delivery
+    @bot.update!(status: :deactivated)
+    assert_nil @webhook.deliver(message)
+  end
+
+  test "deliver works over real HTTP against a local 127.0.0.1 server" do
+    WebMock.allow_net_connect!(net_http_connect_on_start: true)
+
+    server = TCPServer.new("127.0.0.1", 0)
+    port = server.addr[1]
+    received_payload = Queue.new
+
+    thread = Thread.new do
+      client = server.accept
+      request_line = client.gets
+      headers = {}
+      while (line = client.gets) && line != "\r\n"
+        key, value = line.split(": ", 2)
+        headers[key.downcase] = value.strip
+      end
+      body = client.read(headers["content-length"].to_i)
+      received_payload << { request_line: request_line.strip, content_type: headers["content-type"], json: JSON.parse(body) }
+
+      reply_body = "Local server replied!"
+      client.write("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: #{reply_body.bytesize}\r\nConnection: close\r\n\r\n#{reply_body}")
+      client.close
+    end
+
+    @bot.update!(webhook_url: "http://127.0.0.1:#{port}/campfire?source=local")
+    message = @room.messages.create!(
+      creator: @alice,
+      body: "<div>#{mention_attachment_for(@bot)} ping local</div>"
+    )
+
+    reply = @bot.webhook.deliver(message)
+    req = received_payload.pop
+
+    assert_equal "POST /campfire?source=local HTTP/1.1", req[:request_line]
+    assert_equal "application/json", req[:content_type]
+    assert_equal "ping local", req[:json].dig("message", "body", "text")
+    assert_equal "Local server replied!", reply.plain_text_body
+  ensure
+    thread&.join(2)
+    server&.close
+    WebMock.disable_net_connect!
+  end
+end
