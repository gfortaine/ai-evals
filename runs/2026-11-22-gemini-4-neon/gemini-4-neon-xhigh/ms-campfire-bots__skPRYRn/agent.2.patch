+    assert_select "label", text: /Webhook URL/ do
+      assert_select "input[type='url'][name='bot[webhook_url]'][placeholder='Webhook URL']"
+      assert_select "input[name='bot[webhook_url]'][required]", count: 0
+    end
+
+    bot = User.create_bot!(name: "Hook Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "label", text: /Webhook URL/ do
+      assert_select "input[type='url'][name='bot[webhook_url]'][value='https://bot.example.com/hook'][placeholder='Webhook URL']"
+    end
+  end
+
+  test "member can create, update, and remove a bot webhook URL through the form" do
+    sign_in :kevin
+
+    post bots_url, params: { bot: { name: "Hook Bot", webhook_url: "http://127.0.0.1:4567/hook" } }
+    assert_redirected_to bots_url
+
+    bot = User.bot.last
+    assert_equal "http://127.0.0.1:4567/hook", bot.webhook_url
+
+    get bots_url
+    assert_response :success
+    assert_select "li##{dom_id(bot)}", text: %r{http://127\.0\.0\.1:4567/hook}
+
+    patch bot_url(bot), params: { bot: { name: "Hook Bot", webhook_url: "https://bot.example.com/updated" } }
+    assert_redirected_to bots_url
+    assert_equal "https://bot.example.com/updated", bot.reload.webhook_url
