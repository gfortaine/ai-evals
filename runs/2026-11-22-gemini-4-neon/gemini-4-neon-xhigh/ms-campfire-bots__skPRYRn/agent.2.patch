       get autocompletable_users_url(room_id: rooms(:watercooler).id, format: :json), params: { query: "da" }
     end
   end
+
+  test "room autocomplete includes active bots in the room like people and excludes deactivated or non-member bots" do
+    open_bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    deactivated_bot = User.create_bot!(name: "Retired Bot", creator: users(:kevin))
+    deactivated_bot.deactivate
+
+    get autocompletable_users_url(room_id: rooms(:hq).id, format: :json), params: { query: "deploy" }
