diff --git a/test/integration/ticket_priority_filtering_and_search_test.rb b/test/integration/ticket_priority_filtering_and_search_test.rb
new file mode 100644
index 0000000..901e098
--- /dev/null
+++ b/test/integration/ticket_priority_filtering_and_search_test.rb
@@ -0,0 +1,614 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class TicketPriorityFilteringAndSearchTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @owner = @acme.owner
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    invite_staff_via_api(token: @owner_token, email: "sam@acme.test", role: "agent")
+    accept_invitation_via_api(token: extract_last_invitation_token, name: "Sam", password: "sam-password")
+    @agent = User.find_by!(account: @acme, email: "sam@acme.test")
+    @agent_token = sign_in_via_api(subdomain: "acme", email: "sam@acme.test", password: "sam-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password")
+    verify_last_email!(subdomain: "acme")
+    @avery = User.find_by!(account: @acme, email: "avery@example.test")
+    @avery_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "avery-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Blake", email: "blake@example.test", password: "blake-password")
+    verify_last_email!(subdomain: "acme")
+    @blake = User.find_by!(account: @acme, email: "blake@example.test")
+    @blake_token = sign_in_via_api(subdomain: "acme", email: "blake@example.test", password: "blake-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Max", email: "max@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex = Account.find_by!(subdomain: "globex")
+    @globex_owner = @globex.owner
+    @globex_owner_token = sign_in_via_api(subdomain: "globex", email: "max@globex.test", password: "globex-password")
+
+    register_customer_via_api(subdomain: "globex", name: "Quinn", email: "quinn@globex.test", password: "quinn-password")
+    verify_last_email!(subdomain: "globex")
+    @globex_customer = User.find_by!(account: @globex, email: "quinn@globex.test")
+    @globex_customer_token = sign_in_via_api(subdomain: "globex", email: "quinn@globex.test", password: "quinn-password")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "priority defaults to normal, is staff-updatable and exposed only on tickets, and never leaks to customers" do
+    base_time = Time.utc(2026, 11, 20, 12, 0, 0)
+    ticket1_id = nil
+    ticket2_id = nil
+
+    # Customer attempting to pass priority: "high" on request creation is ignored
+    travel_to base_time do
+      post "/api/v1/requests",
+        params: {
+          request: {
+            subject: "Cannot download receipt",
+            priority: "high",
+            comment: { body: "Download button fails" }
+          }
+        },
+        headers: account_headers("acme", token: @avery_token),
+        as: :json
+      assert_response :created
+      assert_not json_body["request"].key?("priority")
+      ticket1_id = json_body.dig("request", "id")
+    end
+
+    travel_to base_time + 5.minutes do
+      post "/api/v1/requests",
+        params: { request: { subject: "Second request", comment: { body: "Hello" } } },
+        headers: account_headers("acme", token: @avery_token),
+        as: :json
+      assert_response :created
+      assert_not json_body["request"].key?("priority")
+      ticket2_id = json_body.dig("request", "id")
+    end
+
+    # Staff sees default priority "normal" on GET /tickets and GET /tickets/:id
+    get "/api/v1/tickets/#{ticket1_id}", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal "normal", json_body.dig("ticket", "priority")
+
+    get "/api/v1/tickets", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [ "normal", "normal" ], json_body["tickets"].map { |t| t["priority"] }
+
+    # Capture customer baseline for ticket 1 and request order
+    get "/api/v1/requests/#{ticket1_id}", headers: account_headers("acme", token: @avery_token)
+    assert_response :ok
+    assert_not json_body["request"].key?("priority")
+    baseline_request1 = json_body["request"]
+
+    get "/api/v1/requests", headers: account_headers("acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [ ticket2_id, ticket1_id ], json_body["requests"].map { |r| r["id"] }
+    json_body["requests"].each { |r| assert_not r.key?("priority") }
+
+    # Agent marks ticket 1 high priority -> bumps staff /tickets, does NOT affect customer /requests timestamp or ordering
+    travel_to base_time + 15.minutes do
+      patch "/api/v1/tickets/#{ticket1_id}",
+        params: { ticket: { priority: "high" } },
+        headers: account_headers("acme", token: @agent_token),
+        as: :json
+      assert_response :ok
+      assert_equal "high", json_body.dig("ticket", "priority")
+      assert_operator Time.iso8601(json_body.dig("ticket", "updated_at")), :>, Time.iso8601(baseline_request1["updated_at"])
+    end
+
+    # Staff sees ticket 1 bumped to top with priority high
+    get "/api/v1/tickets", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ ticket1_id, ticket2_id ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal [ "high", "normal" ], json_body["tickets"].map { |t| t["priority"] }
+
+    # Customer sees NO change in /requests/:id or /requests ordering, and no priority key
+    get "/api/v1/requests/#{ticket1_id}", headers: account_headers("acme", token: @avery_token)
+    assert_response :ok
+    assert_equal baseline_request1, json_body["request"]
+
+    get "/api/v1/requests", headers: account_headers("acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [ ticket2_id, ticket1_id ], json_body["requests"].map { |r| r["id"] }
+
+    # Customer attempting to update priority via PATCH /requests/:id cannot change it
+    patch "/api/v1/requests/#{ticket1_id}",
+      params: { request: { priority: "normal" } },
+      headers: account_headers("acme", token: @avery_token),
+      as: :json
+    assert_response :ok
+    assert_not json_body["request"].key?("priority")
+    assert_equal "high", Ticket.find(ticket1_id).priority
+
+    # Customer attempting PATCH /tickets/:id gets 403
+    patch "/api/v1/tickets/#{ticket1_id}",
+      params: { ticket: { priority: "normal" } },
+      headers: account_headers("acme", token: @avery_token),
+      as: :json
+    assert_response :forbidden
+    assert_equal "high", Ticket.find(ticket1_id).priority
+
+    # Updating status/assignee without priority preserves priority "high"
+    patch "/api/v1/tickets/#{ticket1_id}",
+      params: { ticket: { status: "pending", assignee_id: @agent.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "high", json_body.dig("ticket", "priority")
+    assert_equal "pending", json_body.dig("ticket", "status")
+    assert_equal @agent.id, json_body.dig("ticket", "assignee_id")
+
+    # Admin resets priority back to normal via PUT as well
+    put "/api/v1/tickets/#{ticket1_id}",
+      params: { ticket: { priority: "normal" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "normal", json_body.dig("ticket", "priority")
+  end
+
+  test "rejects invalid priority on ticket update atomically without persisting other fields" do
+    post "/api/v1/requests",
+      params: { request: { subject: "Priority validation", comment: { body: "Initial" } } },
+      headers: account_headers("acme", token: @avery_token),
+      as: :json
+    ticket_id = json_body.dig("request", "id")
+
+    [ "urgent", "low", "HIGH", "Normal", "", nil, 1, true, false, [ "high" ], { value: "high" } ].each do |bad_priority|
+      assert_no_difference "TicketComment.count" do
+        patch "/api/v1/tickets/#{ticket_id}",
+          params: {
+            ticket: {
+              priority: bad_priority,
+              status: "solved",
+              assignee_id: @agent.id,
+              comment: { body: "Should roll back" }
+            }
+          },
+          headers: account_headers("acme", token: @owner_token),
+          as: :json
+      end
+      assert_response :unprocessable_content, "Expected 422 for priority=#{bad_priority.inspect}"
+      assert json_body.dig("errors", "priority").present?
+
+      ticket = Ticket.find(ticket_id)
+      assert_equal "normal", ticket.priority
+      assert_equal "open", ticket.status
+      assert_nil ticket.assignee_id
+    end
+
+    # Valid priority + invalid comment also rolls back priority
+    assert_no_difference "TicketComment.count" do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: {
+          ticket: {
+            priority: "high",
+            comment: { body: "   " }
+          }
+        },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+    end
+    assert_response :unprocessable_content
+    assert_equal "normal", Ticket.find(ticket_id).priority
+  end
+
+  test "staff filters tickets by status, assignee_id, requester_id, priority, and combined filters with pagination" do
+    base_time = Time.utc(2026, 11, 20, 14, 0, 0)
+
+    # Create a diverse set of tickets in Acme + one in Globex
+    t1 = create_ticket_as(@avery_token, subject: "Missing receipt for invoice", body: "Please send PDF receipt", at: base_time)
+    t2 = create_ticket_as(@avery_token, subject: "Login problem", body: "Password reset link expired", at: base_time + 1.minute)
+    t3 = create_ticket_as(@blake_token, subject: "Receipt shows wrong tax", body: "Need corrected receipt ASAP", at: base_time + 2.minutes)
+    t4 = create_ticket_as(@blake_token, subject: "Account upgrade", body: "Ready to upgrade plan", at: base_time + 3.minutes)
+    t5 = create_ticket_as(@agent_token, subject: "Internal tooling issue", body: "Staff-submitted receipt export bug", at: base_time + 4.minutes)
+
+    # Ticket in Globex that matches all filter values but MUST never appear in Acme
+    globex_t = create_ticket_as(@globex_customer_token, subdomain: "globex", subject: "Globex receipt", body: "Globex receipt body", at: base_time + 5.minutes)
+    patch "/api/v1/tickets/#{globex_t}",
+      params: { ticket: { priority: "high" } },
+      headers: account_headers("globex", token: @globex_owner_token),
+      as: :json
+    assert_response :ok
+
+    # Configure Acme tickets:
+    # t1: open,   unassigned,   high,   requester=avery, subject/body has "receipt"
+    # t2: pending, assignee=sam, normal, requester=avery
+    # t3: open,   assignee=jo,  high,   requester=blake, subject/body has "receipt"
+    # t4: solved, unassigned,   normal, requester=blake
