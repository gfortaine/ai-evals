diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..0450e84
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,123 @@
+# frozen_string_literal: true
+
+module Api
+  module V1
+    class UsersController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!
+      before_action :set_user, only: %i[show update]
+
+      def index
+        scope = current_account.users.ordered_by_id
+        errors = {}
+
+        if params.key?(:role) && !(params[:role].nil? || params[:role] == "")
+          if params[:role].is_a?(String) && User::ROLES.include?(params[:role])
+            scope = scope.where(role: params[:role])
+          else
+            errors[:role] = [ "is not included in the list" ]
+          end
+        end
+
+        if params.key?(:suspended) && !(params[:suspended].nil? || params[:suspended] == "")
+          case params[:suspended]
+          when true, "true"
+            scope = scope.suspended
+          when false, "false"
+            scope = scope.active
+          else
+            errors[:suspended] = [ "must be true or false" ]
+          end
+        end
+
+        if errors.any?
+          render_validation_errors(errors)
+          return
+        end
+
+        result = paginate(scope)
+        render json: {
+          users: result[:records].map { |user| serialize_user(user) }
+        }.merge(result[:meta]), status: :ok
+      end
+
+      def show
+        render json: { user: serialize_user(@user) }, status: :ok
+      end
+
+      def update
+        user_params = require_hash_param(params, :user)
+
+        name_provided = user_params.key?(:name)
+        raw_name = user_params[:name]
+        suspended_provided = user_params.key?(:suspended)
+        raw_suspended = user_params[:suspended]
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          @user.lock!
+
+          errors = {}
+
+          if name_provided
+            if raw_name.is_a?(String)
+              @user.name = raw_name
+            else
+              errors[:name] = [ "must be a string" ]
+            end
+          end
+
+          target_suspended = nil
+          if suspended_provided
+            if raw_suspended == true || raw_suspended == false
+              target_suspended = raw_suspended
+            else
+              errors[:suspended] = [ "must be a boolean" ]
+            end
+          end
+
+          unless @user.valid?
+            @user.errors.to_hash.each do |key, messages|
+              errors[key] ||= messages
+            end
+          end
+
+          if errors.any?
+            render_validation_errors(errors)
+            raise ActiveRecord::Rollback
+          end
+
+          if suspended_provided && target_suspended == true
+            if @user.admin? && !current_account.users.admins.active.where.not(id: @user.id).exists?
+              render_validation_errors(
+                { suspended: [ "cannot suspend the last active admin" ] },
+                message: "Cannot suspend the last active admin"
+              )
+              raise ActiveRecord::Rollback
+            end
+
+            @user.suspend!
+          elsif suspended_provided && target_suspended == false
+            @user.unsuspend!
+          elsif name_provided
+            @user.save!
+          end
+        end
+        return if performed?
+
+        render json: { user: serialize_user(@user.reload) }, status: :ok
+      end
+
+      private
+
+      def set_user
+        @user = find_scoped_record(current_account.users, params[:id])
+        return if @user
+
+        render_error("User not found", code: "not_found", status: :not_found)
+      end
+    end
+  end
+end
