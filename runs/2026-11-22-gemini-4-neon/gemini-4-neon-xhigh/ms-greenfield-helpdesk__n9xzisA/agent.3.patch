diff --git a/test/integration/invitations_test.rb b/test/integration/invitations_test.rb
new file mode 100644
index 0000000..09971a5
--- /dev/null
+++ b/test/integration/invitations_test.rb
@@ -0,0 +1,427 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class InvitationsTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Max", email: "max@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex = Account.find_by!(subdomain: "globex")
+    @globex_owner_token = sign_in_via_api(subdomain: "globex", email: "max@globex.test", password: "globex-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password")
+    verify_last_email!(subdomain: "acme")
+    @customer_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "avery-password")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "full invitation flow: invite agent, preview, accept without verification email, sign in, invite admin" do
+    # 1. Admin invites Sam as agent
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      invite_staff_via_api(token: @owner_token, email: "  Sam@Example.Test  ", role: "agent")
+    end
+    assert_response :created
+
+    invitation = json_body["invitation"]
+    assert_kind_of Integer, invitation["id"]
+    assert_equal @acme.id, invitation["account_id"]
+    assert_equal "sam@example.test", invitation["email"]
+    assert_equal "agent", invitation["role"]
+    assert_equal "pending", invitation["status"]
+    assert_not_nil invitation["expires_at"]
+    assert_nil invitation["accepted_at"]
+    assert_nil invitation["revoked_at"]
+    assert_not invitation.key?("token")
+    assert_not invitation.key?("token_digest")
+
+    # Verify email link format
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "sam@example.test" ], mail.to
+    link = extract_link_from_mail(mail, path: "/accept-invitation")
+    query = extract_query_params(link)
+    assert_equal "acme", query["account"]
+    sam_token = query["token"]
+    assert_not_empty sam_token
+
+    # 2. Admin can inspect invitation
+    get "/api/v1/invitations/#{invitation['id']}", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal invitation["id"], json_body.dig("invitation", "id")
+    assert_equal "pending", json_body.dig("invitation", "status")
+
+    # 3. Acceptance screen previews invitation without auth
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: sam_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    preview = json_body["invitation_preview"]
+    assert_equal "sam@example.test", preview["email"]
+    assert_equal "agent", preview["role"]
+    assert_equal "Acme", preview["account_name"]
+    assert_equal "acme", preview["subdomain"]
+    assert_equal "Acme", preview.dig("account", "name")
+    assert_equal "acme", preview.dig("account", "subdomain")
+    assert_equal invitation["expires_at"], preview["expires_at"]
+
+    # Wrong tenant preview fails
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: sam_token } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json_body["code"]
+
+    # 4. Invalid acceptance (short password / blank name) fails with 422 and keeps invitation pending
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
