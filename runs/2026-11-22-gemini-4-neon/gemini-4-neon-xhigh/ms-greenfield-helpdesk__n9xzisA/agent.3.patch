+  test "suspending a user revokes sessions, blocks sign in, clears assignments, removes from /staff; unsuspending restores access" do
+    # Create a ticket and assign to Sam
+    post "/api/v1/requests",
+      params: { request: { subject: "Billing help", comment: { body: "Need invoice" } } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
