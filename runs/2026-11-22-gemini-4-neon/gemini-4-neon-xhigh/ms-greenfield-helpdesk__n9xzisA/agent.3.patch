diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..4c43850
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,75 @@
+# frozen_string_literal: true
+
+module Api
+  module V1
+    class InvitationAcceptancesController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+
+      def create
+        acceptance_params = require_hash_param(params, :invitation_acceptance)
+        raw_token = acceptance_params[:token]
+
+        unless raw_token.is_a?(String) && !raw_token.strip.empty?
+          render_error("Invalid or expired invitation token", code: "invalid_token", status: :unprocessable_content)
+          return
+        end
+
+        invitation = current_account.invitations.pending.find_by_raw_token(raw_token.strip)
+        unless invitation
+          render_error("Invalid or expired invitation token", code: "invalid_token", status: :unprocessable_content)
+          return
+        end
+
+        raw_name = acceptance_params[:name]
+        raw_password = acceptance_params[:password]
+
+        user = current_account.users.build(
+          name: raw_name.is_a?(String) ? raw_name : nil,
+          email: invitation.email,
+          role: invitation.role,
+          email_verified_at: Time.current
+        )
+        user.password = raw_password if raw_password.is_a?(String)
+
+        valid = user.valid?
+        if !raw_name.nil? && !raw_name.is_a?(String)
+          user.errors.delete(:name)
+          user.errors.add(:name, "must be a string")
+          valid = false
+        end
+        if !raw_password.nil? && !raw_password.is_a?(String)
+          user.errors.delete(:password)
+          user.errors.add(:password, "must be a string")
+          valid = false
+        end
+
+        unless valid
+          render_validation_errors(user.errors.to_hash)
+          return
+        end
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          invitation.lock!
+          unless invitation.pending?
+            render_error("Invalid or expired invitation token", code: "invalid_token", status: :unprocessable_content)
+            raise ActiveRecord::Rollback
+          end
+
+          user.email_verified_at = Time.current
+          user.save!
+          invitation.update!(accepted_at: Time.current)
+        end
+        return if performed?
+
+        render json: {
+          user: serialize_user(user),
+          account: serialize_account(current_account)
+        }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        render_validation_errors({ email: [ "has already been taken" ] })
+      end
+    end
+  end
+end
