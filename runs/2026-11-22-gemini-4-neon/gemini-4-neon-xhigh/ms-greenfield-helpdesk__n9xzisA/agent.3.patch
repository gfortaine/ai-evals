+    assert_response :ok
+    patch "/api/v1/users/#{@customer.id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: @second_admin_token),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "suspended")
+
+    # Cross-tenant isolation: Acme admin cannot inspect/update Globex users; Globex /staff only lists Globex staff
+    get "/api/v1/users/#{@globex_owner.id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :not_found
+    patch "/api/v1/users/#{@globex_owner.id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :not_found
+
+    get "/api/v1/staff", headers: account_headers("globex", token: @globex_token)
+    assert_response :ok
+    assert_equal [ @globex_owner.id ], json_body["staff"].map { |u| u["id"] }
+
+    # Invalid suspended types and non-hash envelope
+    [ "true", "false", nil, 1, "yes", [ true ] ].each do |bad_val|
+      patch "/api/v1/users/#{@agent.id}",
+        params: { user: { suspended: bad_val } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 for suspended=#{bad_val.inspect}"
+      assert json_body.dig("errors", "suspended").present?
+    end
+
+    patch "/api/v1/users/#{@agent.id}",
+      params: { user: "not-a-hash" },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :bad_request
+
+    # Unpermitted role/email params are ignored on PATCH /users/:id
+    patch "/api/v1/users/#{@agent.id}",
+      params: { user: { role: "admin", email: "hacked@acme.test" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "agent", @agent.reload.role
+    assert_equal "sam@acme.test", @agent.email
+
+    # Non-numeric / huge IDs return 404
+    [ "abc", "-5", "99999999999999999999999" ].each do |bad_id|
+      get "/api/v1/users/#{bad_id}", headers: account_headers("acme", token: @owner_token)
+      assert_response :not_found
+    end
+  end
+end
