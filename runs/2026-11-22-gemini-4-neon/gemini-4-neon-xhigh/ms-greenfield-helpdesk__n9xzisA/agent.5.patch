+  test "deduplicates by Message-ID across identical and modified deliveries, and invalid deliveries never block a valid retry" do
+    with_env(RAILS_INBOUND_EMAIL_PASSWORD: RELAY_PASSWORD) do
+      # 1. Exact duplicate raw bytes -> processed once
+      raw1 = build_rfc822(
+        from: "Avery <avery@example.test>",
+        to: "acme@support.example.test",
