+        body: "Initial body",
+        message_id: "<dup-msg-1@example.test>"
+      )
+
+      assert_difference [ "Ticket.count", "TicketComment.count", "ActionMailer::Base.deliveries.size" ], 1 do
+        post_relay(raw1)
+        assert_response :no_content
+      end
+
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "ActionMailer::Base.deliveries.size" ] do
+        post_relay(raw1)
+        assert_response :no_content
+      end
+
+      # 2. Same Message-ID with DIFFERENT raw bytes (e.g., extra Received header / altered body) -> still deduplicated
+      raw1_modified = build_rfc822(
+        from: "Avery <avery@example.test>",
+        to: "acme@support.example.test",
+        subject: "Dedup test",
+        body: "Modified duplicate body",
+        message_id: "<dup-msg-1@example.test>",
+        extra_headers: { "Received" => "from relay2.example.test" }
+      )
+
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "ActionMailer::Base.deliveries.size" ] do
+        post_relay(raw1_modified)
+        assert_response :no_content
+      end
+
+      ticket = @acme.tickets.last
+      ActionMailer::Base.deliveries.clear
+
+      # 3. Duplicate reply delivery does NOT reopen solved ticket
+      patch "/api/v1/tickets/#{ticket.id}",
+        params: { ticket: { status: "pending", comment: { body: "Any update?" } } },
+        headers: account_headers("acme", token: @acme_owner_token),
+        as: :json
+      assert_response :ok
+      reply_addr = ActionMailer::Base.deliveries.last.reply_to.first
+
+      reply_raw = build_rfc822(
+        from: "avery@example.test",
+        to: reply_addr,
+        subject: "Re: Dedup test",
+        body: "Yes, fixed!",
+        message_id: "<dup-reply-1@example.test>"
+      )
+      assert_difference "ticket.comments.count", 1 do
+        post_relay(reply_raw)
+        assert_response :no_content
+      end
+      assert_equal "open", ticket.reload.status
+
+      # Staff marks solved
+      patch "/api/v1/tickets/#{ticket.id}",
+        params: { ticket: { status: "solved" } },
+        headers: account_headers("acme", token: @acme_owner_token),
+        as: :json
+      assert_response :ok
+      assert_equal "solved", ticket.reload.status
+
+      # Redelivery of same reply Message-ID (with different raw bytes) must NOT add comment or reopen solved ticket
+      reply_raw_redelivered = build_rfc822(
+        from: "avery@example.test",
+        to: reply_addr,
+        subject: "Re: Dedup test",
+        body: "Yes, fixed!",
+        message_id: "<dup-reply-1@example.test>",
+        extra_headers: { "Received" => "from retry-relay.example.test" }
+      )
+      assert_no_difference "ticket.comments.count" do
+        post_relay(reply_raw_redelivered)
+        assert_response :no_content
+      end
+      assert_equal "solved", ticket.reload.status
+
+      # 4. Invalid deliveries MUST NOT block a later valid retry with the SAME Message-ID:
+      # 4a. Multi-business invalid -> single-business valid retry
+      assert_no_difference "Ticket.count" do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          cc: "globex@support.example.test",
+          subject: "Retry multi",
+          body: "Should fail first",
+          message_id: "<retry-multi@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      assert_difference "Ticket.count", 1 do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          subject: "Retry multi",
+          body: "Now valid",
+          message_id: "<retry-multi@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      # And a 3rd delivery with that same Message-ID is now deduplicated!
+      assert_no_difference "Ticket.count" do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          subject: "Retry multi",
+          body: "Third attempt",
+          message_id: "<retry-multi@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      # 4b. Unauthorized reply sender -> real requester retry with SAME Message-ID
+      assert_no_difference "ticket.comments.count" do
