+          subject: "Before accepting invite",
+          body: "Should not break invite",
+          message_id: "<pending-invitee@example.test>"
+        ))
+        assert_response :no_content
+      end
+    end
+  end
+end
diff --git a/test/mailboxes/support_mailbox_test.rb b/test/mailboxes/support_mailbox_test.rb
new file mode 100644
index 0000000..67a23cd
--- /dev/null
+++ b/test/mailboxes/support_mailbox_test.rb
@@ -0,0 +1,238 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class SupportMailboxTest < ActionMailbox::TestCase
+  setup do
+    @acme = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = @acme.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "owner-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    @acme.update!(owner: @owner)
+  end
+
+  test "extracts plain-text part from multipart/alternative and ignores HTML" do
+    inbound = receive_inbound_email_from_mail do
+      from "Avery <avery@example.test>"
+      to "acme@support.example.test"
+      subject "Multipart issue"
+      message_id "<multi-1@example.test>"
+
+      text_part do
+        body "Plain text body content"
+      end
+
+      html_part do
+        content_type "text/html; charset=UTF-8"
+        body "<p>HTML <strong>version</strong> should not be used</p>"
+      end
+    end
+
+    assert inbound.delivered?
+    ticket = @acme.tickets.last
+    assert_equal "Multipart issue", ticket.subject
+    assert_equal "Plain text body content", ticket.comments.first.body
+  end
+
+  test "extracts inline text/plain from multipart/mixed and ignores text/plain attachment" do
+    inbound = receive_inbound_email_from_mail do
+      from "Avery <avery@example.test>"
+      to "acme@support.example.test"
+      subject "With log attachment"
+      message_id "<mixed-1@example.test>"
+
+      add_part(Mail::Part.new do
+        content_type "multipart/alternative"
+        text_part { body "Please check the attached log." }
+        html_part { content_type "text/html; charset=UTF-8"; body "<p>HTML body</p>" }
+      end)
+
+      add_file filename: "debug.txt", content: "SECRET ATTACHMENT CONTENT"
+    end
+
+    assert inbound.delivered?
+    ticket = @acme.tickets.last
+    assert_equal "Please check the attached log.", ticket.comments.first.body
+    assert_not_includes ticket.comments.first.body, "SECRET ATTACHMENT CONTENT"
+  end
+
+  test "converts HTML-only email to plain text" do
+    inbound = receive_inbound_email_from_mail do
+      from "Avery <avery@example.test>"
+      to "acme@support.example.test"
+      subject "HTML only"
+      message_id "<html-only-1@example.test>"
+      content_type "text/html; charset=UTF-8"
+      body "<html><head><title>Ignored</title><style>p{color:red}</style></head><body><p>Hello &amp; <b>help</b>!</p><p>Line two<br>Line three</p></body></html>"
+    end
+
+    assert inbound.delivered?
+    ticket = @acme.tickets.last
+    assert_equal "Hello & help!\nLine two\nLine three", ticket.comments.first.body
+  end
+
+  test "decodes non-UTF-8 charsets and RFC 2047 encoded headers" do
+    raw = <<~RFC822.gsub("\n", "\r\n")
+      From: =?UTF-8?B?Sm9zw6kgR2FyY8OtYQ==?= <jose@example.test>
+      To: acme@support.example.test
+      Subject: =?UTF-8?Q?Caf=C3=A9_order?=
+      Message-ID: <charset-1@example.test>
+      MIME-Version: 1.0
+      Content-Type: text/plain; charset=ISO-8859-1
+      Content-Transfer-Encoding: quoted-printable
+
+      Need help with Caf=E9 order.
+    RFC822
+
+    inbound = receive_inbound_email_from_source(raw)
+    assert inbound.delivered?
+
+    ticket = @acme.tickets.last
+    assert_equal "Café order", ticket.subject
+    assert_equal "Need help with Café order.", ticket.comments.first.body
+    assert_equal "José García", ticket.requester.name
+  end
+
+  test "handles missing subject with fallback and truncates subjects longer than 255 chars" do
+    inbound_no_subj = receive_inbound_email_from_mail(
+      from: "no-subj@example.test",
+      to: "acme@support.example.test",
+      message_id: "<no-subj@example.test>",
+      body: "Body without subject"
+    )
+    assert inbound_no_subj.delivered?
+    assert_equal "(No subject)", @acme.tickets.order(:id).last.subject
+    assert_equal "no-subj", @acme.users.find_by!(email: "no-subj@example.test").name
+
+    long_subject = "A" * 300
+    inbound_long = receive_inbound_email_from_mail(
+      from: "no-subj@example.test",
+      to: "acme@support.example.test",
+      subject: long_subject,
+      message_id: "<long-subj@example.test>",
+      body: "Body with long subject"
+    )
+    assert inbound_long.delivered?
+    assert_equal 255, @acme.tickets.order(:id).last.subject.length
+  end
+
+  test "ignores emails with blank body, HTML-only whitespace, or attachment-only content" do
+    assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count" ] do
+      inbound1 = receive_inbound_email_from_mail(
+        from: "blank@example.test",
+        to: "acme@support.example.test",
+        subject: "Empty",
+        message_id: "<blank-1@example.test>",
+        body: "   \r\n\t  "
+      )
+      assert inbound1.bounced?
+
+      inbound2 = receive_inbound_email_from_mail do
+        from "blank2@example.test"
+        to "acme@support.example.test"
+        subject "Empty HTML"
+        message_id "<blank-2@example.test>"
+        content_type "text/html; charset=UTF-8"
+        body "<html><body><div><br>&nbsp;</div></body></html>"
+      end
+      assert inbound2.bounced?
+
+      inbound3 = receive_inbound_email_from_mail do
+        from "blank3@example.test"
+        to "acme@support.example.test"
+        subject "Only attachment"
+        message_id "<blank-3@example.test>"
+        add_file filename: "note.txt", content: "Attachment only"
+      end
+      assert inbound3.bounced?
+    end
+  end
+
+  test "allows Auto-Submitted: no and valid Return-Path while ignoring automated, list, bounce, and loop mail" do
+    # Allowed: Auto-Submitted: no + normal Return-Path
+    inbound_ok = receive_inbound_email_from_mail do
+      from "Human <human@example.test>"
+      to "acme@support.example.test"
+      subject "Real human mail"
+      message_id "<human-ok@example.test>"
+      header["Auto-Submitted"] = "no"
+      header["Return-Path"] = "<human@example.test>"
+      body "This is a genuine message."
+    end
+    assert inbound_ok.delivered?
+    assert_equal 1, @acme.tickets.count
+    ActionMailer::Base.deliveries.clear
+
+    automated_cases = [
+      { headers: { "Auto-Submitted" => "auto-replied" }, desc: "Auto-Submitted: auto-replied" },
+      { headers: { "Auto-Submitted" => "auto-generated" }, desc: "Auto-Submitted: auto-generated" },
+      { headers: { "Auto-Submitted" => "auto-notified" }, desc: "Auto-Submitted: auto-notified" },
+      { headers: { "Precedence" => "bulk" }, desc: "Precedence: bulk" },
+      { headers: { "Precedence" => "list" }, desc: "Precedence: list" },
+      { headers: { "Precedence" => "junk" }, desc: "Precedence: junk" },
+      { headers: { "Precedence" => "auto_reply" }, desc: "Precedence: auto_reply" },
+      { headers: { "List-Id" => "<updates.example.test>" }, desc: "List-Id" },
+      { headers: { "List-Unsubscribe" => "<mailto:unsub@example.test>" }, desc: "List-Unsubscribe" },
+      { headers: { "List-Post" => "<mailto:list@example.test>" }, desc: "List-Post" },
+      { headers: { "Mailing-List" => "list foo@example.test" }, desc: "Mailing-List" },
+      { headers: { "X-Autoreply" => "yes" }, desc: "X-Autoreply" },
+      { headers: { "X-Auto-Reply" => "yes" }, desc: "X-Auto-Reply" },
+      { headers: { "X-Autorespond" => "yes" }, desc: "X-Autorespond" },
+      { headers: { "X-Auto-Response-Suppress" => "All" }, desc: "X-Auto-Response-Suppress" },
+      { headers: { "X-Loop" => "acme@support.example.test" }, desc: "X-Loop" },
+      { headers: { "X-Failed-Recipients" => "human@example.test" }, desc: "X-Failed-Recipients" },
+      { headers: { "Return-Path" => "<>" }, desc: "null Return-Path" },
+      { from: "mailer-daemon@example.test", desc: "mailer-daemon sender" },
+      { from: "postmaster@example.test", desc: "postmaster sender" },
+      { from: "noreply@example.test", desc: "noreply sender" },
+      { from: "no-reply@example.test", desc: "no-reply sender" },
+      { from: "do-not-reply@example.test", desc: "do-not-reply sender" },
+      { from: "acme@support.example.test", desc: "support domain loop sender" },
+      { from: "support@example.test", desc: "mail_from loop sender" }
+    ]
+
+    automated_cases.each_with_index do |tc, idx|
+      assert_no_difference [ "Ticket.count", "TicketComment.count", "User.count", "ActionMailer::Base.deliveries.size" ], "Expected ignored for #{tc[:desc]}" do
+        raw_headers = {
+          "From" => tc[:from] || "bot#{idx}@example.test",
+          "To" => "acme@support.example.test",
+          "Subject" => "Automated #{idx}",
+          "Message-ID" => "<auto-#{idx}@example.test>"
+        }.merge(tc[:headers] || {})
+
+        raw = raw_headers.map { |k, v| "#{k}: #{v}" }.join("\r\n") + "\r\n\r\nAutomated body\r\n"
+        inbound = receive_inbound_email_from_source(raw)
+        assert inbound.bounced?, "Expected bounced for #{tc[:desc]}"
+      end
+    end
+
+    # multipart/report bounce DSN
+    dsn_raw = <<~RFC822.gsub("\n", "\r\n")
+      From: bounces@example.test
+      To: acme@support.example.test
+      Subject: Undelivered Mail Returned to Sender
+      Message-ID: <dsn-1@example.test>
+      MIME-Version: 1.0
+      Content-Type: multipart/report; report-type=delivery-status; boundary="dsn-boundary"
+
+      --dsn-boundary
+      Content-Type: text/plain
+
+      Delivery failed.
+      --dsn-boundary
+      Content-Type: message/delivery-status
+
+      Action: failed
+      --dsn-boundary--
+    RFC822
+
+    assert_no_difference [ "Ticket.count", "TicketComment.count" ] do
+      inbound = receive_inbound_email_from_source(dsn_raw)
+      assert inbound.bounced?
+    end
+  end
+end
diff --git a/test/mailers/ticket_mailer_test.rb b/test/mailers/ticket_mailer_test.rb
new file mode 100644
index 0000000..775a39b
--- /dev/null
+++ b/test/mailers/ticket_mailer_test.rb
@@ -0,0 +1,68 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class TicketMailerTest < ActionMailer::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @customer = @account.users.create!(
+      name: "Avery",
+      email: "avery@example.test",
+      password: "customer-password",
+      role: "customer"
+    )
+    @staff = @account.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "staff-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    @ticket = @account.tickets.create!(
+      requester: @customer,
+      subject: "Billing question",
+      status: "open",
+      email_origin: true
+    )
+    @ticket.comments.create!(
+      account: @account,
+      author: @customer,
+      body: "Original email message",
+      public: true,
+      inbound_message_id: "orig-1@customer.test",
+      skip_ticket_touch: true
+    )
+    @reply_comment = @ticket.comments.create!(
+      account: @account,
+      author: @staff,
+      body: "Here is your updated receipt & details.",
+      public: true
+    )
+  end
+
+  test "staff_reply uses defaults, private reply address, Re: subject, and threading headers" do
+    with_env(HELPDESK_SUPPORT_DOMAIN: nil, HELPDESK_MAIL_FROM: nil) do
+      mail = TicketMailer.staff_reply(@ticket, @reply_comment)
+      assert_equal [ "support@example.test" ], mail.from
+      assert_equal [ "avery@example.test" ], mail.to
+      assert_equal [ "acme+#{@ticket.email_reply_token}@support.example.test" ], mail.reply_to
+      assert_equal "Re: Billing question", mail.subject
+      assert_equal "orig-1@customer.test", mail.in_reply_to
+      assert_equal "orig-1@customer.test", mail.references
+      assert_includes mail.body.decoded, "Here is your updated receipt & details."
+      assert_includes mail.body.decoded, "Jo"
+      assert_includes mail.body.decoded, "Acme Support"
+    end
+  end
+
+  test "staff_reply respects HELPDESK_SUPPORT_DOMAIN and HELPDESK_MAIL_FROM and avoids double Re:" do
+    @ticket.update!(subject: "Re: Existing thread")
+
+    with_env(HELPDESK_SUPPORT_DOMAIN: "MAIL.CUSTOM.TEST", HELPDESK_MAIL_FROM: "help@custom.test") do
+      mail = TicketMailer.staff_reply(@ticket, @reply_comment)
+      assert_equal [ "help@custom.test" ], mail.from
+      assert_equal [ "acme+#{@ticket.email_reply_token}@mail.custom.test" ], mail.reply_to
+      assert_equal "Re: Existing thread", mail.subject
+    end
+  end
+end
