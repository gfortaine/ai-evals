diff --git a/test/integration/email_support_test.rb b/test/integration/email_support_test.rb
new file mode 100644
index 0000000..fdc577a
--- /dev/null
+++ b/test/integration/email_support_test.rb
@@ -0,0 +1,854 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class EmailSupportTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  RELAY_PASSWORD = "test-inbound-secret-password"
+
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "acme-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @acme_owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "acme-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Sam", email: "sam@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex = Account.find_by!(subdomain: "globex")
+    @globex_owner_token = sign_in_via_api(subdomain: "globex", email: "sam@globex.test", password: "globex-password")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def relay_auth_header(username: "actionmailbox", password: RELAY_PASSWORD)
+    ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+  end
+
+  def build_rfc822(from:, to:, subject: "Help needed", body: "Please help me.", cc: nil, message_id: nil, extra_headers: {})
+    lines = []
+    lines << "From: #{from}" if from
+    lines << "To: #{to}" if to
+    lines << "Cc: #{cc}" if cc
+    lines << "Subject: #{subject}" unless subject.nil?
+    lines << "Message-ID: #{message_id}" if message_id
+    lines << "MIME-Version: 1.0"
+    lines << "Content-Type: text/plain; charset=UTF-8"
+    extra_headers.each { |k, v| lines << "#{k}: #{v}" }
+    "#{lines.join("\r\n")}\r\n\r\n#{body}\r\n"
+  end
+
+  def post_relay(raw_email, password: RELAY_PASSWORD, username: "actionmailbox", content_type: "message/rfc822", include_auth: true)
+    headers = { "Content-Type" => content_type }
+    headers["Authorization"] = relay_auth_header(username: username, password: password) if include_auth
+
+    post RELAY_PATH, params: raw_email, headers: headers
+  end
+
+  test "relay ingress requires HTTP basic auth with RAILS_INBOUND_EMAIL_PASSWORD and message/rfc822" do
+    raw = build_rfc822(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Auth check",
+      body: "Hello",
+      message_id: "<auth-1@example.test>"
+    )
+
+    with_env(RAILS_INBOUND_EMAIL_PASSWORD: RELAY_PASSWORD) do
+      # Missing auth
+      post_relay(raw, include_auth: false)
+      assert_response :unauthorized
+
+      # Wrong password
+      post_relay(raw, password: "wrong-password")
+      assert_response :unauthorized
+
+      # Wrong username
+      post_relay(raw, username: "wronguser")
+      assert_response :unauthorized
+
+      # Wrong content type
+      post_relay(raw, content_type: "text/plain")
+      assert_response :unsupported_media_type
+
+      # No tickets created from rejected requests
+      assert_equal 0, Ticket.count
+
+      # Valid request processes synchronously before response completes
+      post_relay(raw)
+      assert_response :no_content
+      assert_equal 1, @acme.tickets.count
+      assert_equal "Auth check", @acme.tickets.first.subject
+    end
+  end
+
+  test "new email opens ticket, creates unverified customer, sends verification email, and lets customer later use portal" do
+    raw = build_rfc822(
+      from: "Avery Chen <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Order #42 delayed",
+      body: "Hi, my order #42 has not arrived yet.",
+      message_id: "<order-42@example.test>"
+    )
+
+    with_env(RAILS_INBOUND_EMAIL_PASSWORD: RELAY_PASSWORD, HELPDESK_SUPPORT_DOMAIN: nil) do
+      assert_difference [ "Ticket.count", "TicketComment.count", "User.count" ], 1 do
+        assert_difference "ActionMailer::Base.deliveries.size", 1 do
+          post_relay(raw)
+          assert_response :no_content
+        end
+      end
+    end
+
+    # Customer created unverified
+    customer = @acme.users.find_by!(email: "avery@example.test")
+    assert_equal "Avery Chen", customer.name
+    assert_equal "customer", customer.role
+    assert_not customer.verified?
+    assert_nil customer.email_verified_at
+
+    # Verification email was sent
+    verification_mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], verification_mail.to
+    verify_link = extract_link_from_mail(verification_mail, path: "/verify-email")
+    verify_params = extract_query_params(verify_link)
+    assert_equal "acme", verify_params["account"]
+    assert verify_params["token"].present?
+
+    # Ticket visible to Acme staff (not Globex)
+    get "/api/v1/tickets", headers: account_headers("acme", token: @acme_owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    ticket_id = json_body["tickets"].first["id"]
+    assert_equal "Order #42 delayed", json_body["tickets"].first["subject"]
+    assert_equal "open", json_body["tickets"].first["status"]
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: account_headers("acme", token: @acme_owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal "Hi, my order #42 has not arrived yet.", json_body["comments"].first["body"]
+    assert_equal true, json_body["comments"].first["public"]
+
+    get "/api/v1/tickets", headers: account_headers("globex", token: @globex_owner_token)
+    assert_response :ok
+    assert_equal 0, json_body["count"]
+
+    # Password reset BEFORE verifying does NOT allow signing in (receiving email did not verify)
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "avery@example.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    reset_token = extract_query_params(extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password"))["token"]
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "portal-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "portal-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+    assert_equal "email_not_verified", json_body["code"]
+
+    # Confirming verification email allows customer to sign in and view their email-origin ticket
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_params["token"] } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+
+    customer_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "portal-password-1")
+    get "/api/v1/requests", headers: account_headers("acme", token: customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal ticket_id, json_body["requests"].first["id"]
+  end
+
+  test "reuses existing customer without sending verification email and preserves unverified state" do
+    # Existing verified customer
+    register_customer_via_api(subdomain: "acme", name: "Verified Pat", email: "pat@example.test", password: "pat-password")
+    verify_last_email!(subdomain: "acme")
+
+    # Existing unverified customer
+    register_customer_via_api(subdomain: "acme", name: "Unverified Lee", email: "lee@example.test", password: "lee-password")
+    ActionMailer::Base.deliveries.clear
+
+    with_env(RAILS_INBOUND_EMAIL_PASSWORD: RELAY_PASSWORD) do
+      # Verified customer emails support (case-insensitive)
+      assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+        assert_difference "Ticket.count", 1 do
+          post_relay(build_rfc822(
+            from: "PAT@EXAMPLE.TEST",
+            to: "acme@support.example.test",
+            subject: "Verified question",
+            body: "Quick question.",
+            message_id: "<reuse-verified@example.test>"
+          ))
+          assert_response :no_content
+        end
+      end
+      assert @acme.users.find_by!(email: "pat@example.test").verified?
+
+      # Unverified customer emails support -> reused, STILL unverified, no new verification email
+      assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+        assert_difference "Ticket.count", 1 do
+          post_relay(build_rfc822(
+            from: "lee@example.test",
+            to: "acme@support.example.test",
+            subject: "Unverified question",
+            body: "Another question.",
+            message_id: "<reuse-unverified@example.test>"
+          ))
+          assert_response :no_content
+        end
+      end
+      assert_not @acme.users.find_by!(email: "lee@example.test").verified?
+
+      # Same email sent to Globex creates an independent Globex customer + sends verification email
+      assert_difference [ "User.count", "Ticket.count", "ActionMailer::Base.deliveries.size" ], 1 do
+        post_relay(build_rfc822(
+          from: "Pat <pat@example.test>",
+          to: "globex@support.example.test",
+          subject: "Globex question",
+          body: "Hello Globex.",
+          message_id: "<globex-new-cust@example.test>"
+        ))
+        assert_response :no_content
+      end
+      globex_pat = @globex.users.find_by!(email: "pat@example.test")
+      assert_not globex_pat.verified?
+    end
+  end
+
+  test "finds business from Cc, respects HELPDESK_SUPPORT_DOMAIN, and ignores multi-business or unknown mail" do
+    with_env(RAILS_INBOUND_EMAIL_PASSWORD: RELAY_PASSWORD, HELPDESK_SUPPORT_DOMAIN: "mail.helpdesk.test") do
+      # Default domain ignored when HELPDESK_SUPPORT_DOMAIN is overridden
+      assert_no_difference [ "Ticket.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_relay(build_rfc822(
+          from: "cust@example.test",
+          to: "acme@support.example.test",
+          subject: "Wrong domain",
+          body: "Should be ignored",
+          message_id: "<wrong-domain@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      # Found via Cc on custom domain
+      assert_difference "Ticket.count", 1 do
+        post_relay(build_rfc822(
+          from: "cust@example.test",
+          to: "coworker@example.test",
+          cc: "\"Acme Support\" <ACME@MAIL.HELPDESK.TEST>",
+          subject: "CC to Acme",
+          body: "Found in Cc.",
+          message_id: "<cc-acme@example.test>"
+        ))
+        assert_response :no_content
+      end
+      assert_equal 1, @acme.tickets.count
+      ActionMailer::Base.deliveries.clear
+
+      # Same business in both To and Cc opens one ticket
+      assert_difference "Ticket.count", 1 do
+        post_relay(build_rfc822(
