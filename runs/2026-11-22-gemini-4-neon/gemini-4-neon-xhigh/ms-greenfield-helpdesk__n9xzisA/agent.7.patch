+    third_id = create_request(token: @avery_token, subject: "Third", body: "Initial third", at: base_time + 2.minutes)
+
+    patch "/api/v1/tickets/#{source_id}",
+      params: { ticket: { group_id: @billing_id, assignee_id: @sam.id } },
