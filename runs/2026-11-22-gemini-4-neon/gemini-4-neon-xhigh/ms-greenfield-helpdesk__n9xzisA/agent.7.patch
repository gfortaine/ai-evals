+            headers: account_headers("acme", token: @owner_token),
+            as: :json
+        end
+        assert_response :unprocessable_content, "Expected 422 for staff PATCH #{payload.inspect} on closed ticket"
+      end
+
+      # Customer cannot reply, mark solved, or send empty patch on a closed request
+      [
+        { comment: { body: "Customer follow-up" } },
+        { status: "solved" },
+        { status: "solved", comment: { body: "Closing again" } }
+      ].each do |payload|
