+  test "chained merges preserve original links rather than rewriting history" do
+    base_time = Time.utc(2026, 11, 20, 14, 0, 0)
+    a1 = create_request(token: @avery_token, subject: "Ticket A1", body: "A1 body", at: base_time)
+    a2 = create_request(token: @avery_token, subject: "Ticket A2", body: "A2 body", at: base_time + 1.minute)
+    b = create_request(token: @avery_token, subject: "Ticket B", body: "B body", at: base_time + 2.minutes)
+    c = create_request(token: @avery_token, subject: "Ticket C", body: "C body", at: base_time + 3.minutes)
+
+    # First merge A1 -> B and A2 -> B
+    travel_to base_time + 10.minutes do
+      post "/api/v1/tickets/#{a1}/merge", params: { merge: { target_id: b } }, headers: account_headers("acme", token: @owner_token), as: :json
+      assert_response :ok
+      post "/api/v1/tickets/#{a2}/merge", params: { merge: { target_id: b } }, headers: account_headers("acme", token: @owner_token), as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/tickets/#{a1}", headers: account_headers("acme", token: @owner_token)
+    a1_ticket_snapshot = json_body["ticket"]
+    get "/api/v1/requests/#{a1}", headers: account_headers("acme", token: @avery_token)
+    a1_request_snapshot = json_body["request"]
+
+    get "/api/v1/tickets/#{a2}", headers: account_headers("acme", token: @owner_token)
+    a2_ticket_snapshot = json_body["ticket"]
+
+    # Later merge B -> C
+    travel_to base_time + 25.minutes do
+      post "/api/v1/tickets/#{b}/merge", params: { merge: { target_id: c } }, headers: account_headers("acme", token: @owner_token), as: :json
+      assert_response :ok
+    end
+
+    assert_equal "closed", json_body.dig("source", "status")
+    assert_equal c, json_body.dig("source", "merged_into_id")
+    assert_equal "open", json_body.dig("target", "status")
+    assert_nil json_body.dig("target", "merged_into_id")
+
+    # Original links A1 -> B and A2 -> B are preserved untouched (NOT rewritten to C!)
+    get "/api/v1/tickets/#{a1}", headers: account_headers("acme", token: @owner_token)
+    assert_equal a1_ticket_snapshot, json_body["ticket"]
+    assert_equal b, json_body.dig("ticket", "merged_into_id")
+
+    get "/api/v1/requests/#{a1}", headers: account_headers("acme", token: @avery_token)
+    assert_equal a1_request_snapshot, json_body["request"]
+    assert_equal b, json_body.dig("request", "merged_into_id")
+
+    get "/api/v1/tickets/#{a2}", headers: account_headers("acme", token: @owner_token)
+    assert_equal a2_ticket_snapshot, json_body["ticket"]
+    assert_equal b, json_body.dig("ticket", "merged_into_id")
+
+    # Customer can follow A1 -> B -> C cleanly
+    get "/api/v1/requests/#{b}", headers: account_headers("acme", token: @avery_token)
+    assert_equal "closed", json_body.dig("request", "status")
+    assert_equal c, json_body.dig("request", "merged_into_id")
+
+    get "/api/v1/requests/#{c}", headers: account_headers("acme", token: @avery_token)
+    assert_equal "open", json_body.dig("request", "status")
+    assert_nil json_body.dig("request", "merged_into_id")
+
+    # Filtering closed returns all 3 closed tickets (A1, A2, B)
+    get "/api/v1/requests", params: { status: "closed" }, headers: account_headers("acme", token: @avery_token)
+    assert_equal [ a1, a2, b ].sort, json_body["requests"].map { |r| r["id"] }.sort
+
+    # None of the closed tickets can be merged or targeted again
+    [
+      [ c, a1 ],
+      [ c, b ],
+      [ a1, c ],
+      [ b, c ]
+    ].each do |src, tgt|
+      post "/api/v1/tickets/#{src}/merge", params: { merge: { target_id: tgt } }, headers: account_headers("acme", token: @owner_token), as: :json
+      assert_response :unprocessable_content, "Expected 422 merging #{src} -> #{tgt}"
+    end
+  end
