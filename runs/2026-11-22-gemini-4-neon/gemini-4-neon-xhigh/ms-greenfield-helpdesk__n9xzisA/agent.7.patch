+        params: { merge: { target_id: target_id } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/tickets/#{source_id}", headers: account_headers("acme", token: @owner_token)
+    snapshot_ticket = json_body["ticket"]
+    get "/api/v1/requests/#{source_id}", headers: account_headers("acme", token: @avery_token)
+    snapshot_request = json_body["request"]
+    baseline_comment_count = Ticket.find(source_id).comments.count
+
+    travel_to base_time + 20.minutes do
+      # Staff cannot update ANY attribute or add comments (or even empty patch) on a closed ticket
+      [
+        { status: "open" },
+        { status: "pending" },
+        { status: "solved" },
+        { status: "closed" },
+        { priority: "high" },
+        { group_id: nil },
+        { group_id: @tech_id },
+        { assignee_id: nil },
+        { assignee_id: @morgan.id },
+        { comment: { body: "Trying to add public reply", public: true } },
+        { comment: { body: "Trying to add private note", public: false } },
+        { priority: "normal" }
+      ].each do |payload|
+        assert_no_difference [ "TicketComment.count", "ActionMailer::Base.deliveries.size" ] do
+          patch "/api/v1/tickets/#{source_id}",
