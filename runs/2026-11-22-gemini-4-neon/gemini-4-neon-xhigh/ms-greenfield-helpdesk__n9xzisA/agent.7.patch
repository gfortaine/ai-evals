+          patch "/api/v1/requests/#{source_id}",
+            params: { request: payload },
+            headers: account_headers("acme", token: @avery_token),
+            as: :json
+        end
+        assert_response :unprocessable_content, "Expected 422 for customer PATCH #{payload.inspect} on closed request"
+      end
+
+      # Cannot merge closed source again
+      assert_no_difference "TicketComment.count" do
+        post "/api/v1/tickets/#{source_id}/merge",
+          params: { merge: { target_id: third_id } },
+          headers: account_headers("acme", token: @owner_token),
+          as: :json
+      end
+      assert_response :unprocessable_content
+
+      # Cannot merge another ticket into closed ticket
+      assert_no_difference "TicketComment.count" do
+        post "/api/v1/tickets/#{third_id}/merge",
+          params: { merge: { target_id: source_id } },
+          headers: account_headers("acme", token: @owner_token),
+          as: :json
+      end
+      assert_response :unprocessable_content
