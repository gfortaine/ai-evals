+  test "closed ticket rejects all further edits from staff and customer and cannot be merged again or targeted" do
+    base_time = Time.utc(2026, 11, 20, 12, 0, 0)
+    source_id = create_request(token: @avery_token, subject: "To close", body: "Initial", at: base_time)
