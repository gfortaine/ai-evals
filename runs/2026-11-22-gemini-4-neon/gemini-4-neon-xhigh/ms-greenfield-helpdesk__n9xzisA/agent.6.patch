diff --git a/test/integration/groups_and_memberships_test.rb b/test/integration/groups_and_memberships_test.rb
new file mode 100644
index 0000000..8fc9fd9
--- /dev/null
+++ b/test/integration/groups_and_memberships_test.rb
@@ -0,0 +1,537 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class GroupsAndMembershipsTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @owner = @acme.owner
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    invite_staff_via_api(token: @owner_token, email: "morgan@acme.test", role: "admin")
+    accept_invitation_via_api(token: extract_last_invitation_token, name: "Morgan", password: "morgan-password")
+    @second_admin = User.find_by!(account: @acme, email: "morgan@acme.test")
+    @second_admin_token = sign_in_via_api(subdomain: "acme", email: "morgan@acme.test", password: "morgan-password")
+
+    invite_staff_via_api(token: @owner_token, email: "sam@acme.test", role: "agent")
+    accept_invitation_via_api(token: extract_last_invitation_token, name: "Sam", password: "sam-password")
+    @agent = User.find_by!(account: @acme, email: "sam@acme.test")
+    @agent_token = sign_in_via_api(subdomain: "acme", email: "sam@acme.test", password: "sam-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password")
+    verify_last_email!(subdomain: "acme")
+    @customer = User.find_by!(account: @acme, email: "avery@example.test")
+    @customer_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "avery-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Max", email: "max@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex = Account.find_by!(subdomain: "globex")
+    @globex_owner = @globex.owner
+    @globex_token = sign_in_via_api(subdomain: "globex", email: "max@globex.test", password: "globex-password")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "admins create, list (ID asc), show, rename, and delete groups; staff browse groups" do
+    # Create Billing (owner) and Technical Support (invited admin) and Sales
+    post "/api/v1/groups",
+      params: { group: { name: "  Billing  " } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    billing_id = json_body.dig("group", "id")
+    assert_equal "Billing", json_body.dig("group", "name")
+    assert_equal @acme.id, json_body.dig("group", "account_id")
+    assert_not_nil json_body.dig("group", "created_at")
+    assert_not_nil json_body.dig("group", "updated_at")
+
+    post "/api/v1/groups",
+      params: { group: { name: "Technical Support" } },
+      headers: account_headers("acme", token: @second_admin_token),
+      as: :json
+    assert_response :created
+    tech_id = json_body.dig("group", "id")
+
+    post "/api/v1/groups",
+      params: { group: { name: "Sales" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    sales_id = json_body.dig("group", "id")
+
+    # Rename Billing via PATCH (updates updated_at, order must remain ID asc!)
+    travel 5.minutes do
+      patch "/api/v1/groups/#{billing_id}",
+        params: { group: { name: "Billing & Invoices" } },
+        headers: account_headers("acme", token: @second_admin_token),
+        as: :json
+      assert_response :ok
+      assert_equal "Billing & Invoices", json_body.dig("group", "name")
+    end
+
+    # Rename via PUT with case-only change works
+    put "/api/v1/groups/#{billing_id}",
+      params: { group: { name: "billing & invoices" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "billing & invoices", json_body.dig("group", "name")
+
+    # Unpermitted fields on PATCH are ignored without modifying name or account_id
+    patch "/api/v1/groups/#{billing_id}",
+      params: { group: { account_id: @globex.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "billing & invoices", json_body.dig("group", "name")
+    assert_equal @acme.id, json_body.dig("group", "account_id")
+
+    # Agent can list groups (strictly ID asc) and paginate
+    get "/api/v1/groups", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ billing_id, tech_id, sales_id ], json_body["groups"].map { |g| g["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_nil json_body["next_page"]
+
+    get "/api/v1/groups", params: { page: 1, per_page: 2 }, headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ billing_id, tech_id ], json_body["groups"].map { |g| g["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    get "/api/v1/groups", params: { page: 2, per_page: 2 }, headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ sales_id ], json_body["groups"].map { |g| g["id"] }
+    assert_nil json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+
+    # Agent can show single group
+    get "/api/v1/groups/#{tech_id}", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal "Technical Support", json_body.dig("group", "name")
+
+    # Admin deletes Sales -> 204 No Content, subsequent GET returns 404, name can be reused
+    delete "/api/v1/groups/#{sales_id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :no_content
+    assert_equal "", response.body
+
+    get "/api/v1/groups/#{sales_id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :not_found
+
+    post "/api/v1/groups",
+      params: { group: { name: "Sales" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    assert_operator json_body.dig("group", "id"), :>, sales_id
+  end
+
+  test "group validation errors, uniqueness, and cross-tenant isolation" do
+    post "/api/v1/groups",
+      params: { group: { name: "Billing" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    acme_billing_id = json_body.dig("group", "id")
+
+    post "/api/v1/groups",
+      params: { group: { name: "Technical Support" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    acme_tech_id = json_body.dig("group", "id")
+
+    # Same name in different account is allowed
+    post "/api/v1/groups",
+      params: { group: { name: "Billing" } },
+      headers: account_headers("globex", token: @globex_token),
+      as: :json
+    assert_response :created
+    globex_billing_id = json_body.dig("group", "id")
+
+    # Case-insensitive duplicate in same account rejected on create & update
+    post "/api/v1/groups",
+      params: { group: { name: "  billing  " } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "name").present?
+
+    patch "/api/v1/groups/#{acme_tech_id}",
+      params: { group: { name: "BILLING" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "name").present?
+    assert_equal "Technical Support", Group.find(acme_tech_id).name
+
+    # Invalid names on create and update
+    [ "", "   ", nil, 123, true, false, [ "Billing" ], { a: "b" }, "a" * 256 ].each do |bad_name|
+      post "/api/v1/groups",
+        params: { group: { name: bad_name } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 on create for name=#{bad_name.inspect}"
+      assert json_body.dig("errors", "name").present?
+
+      patch "/api/v1/groups/#{acme_billing_id}",
+        params: { group: { name: bad_name } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+      assert_response :unprocessable_content, "Expected 422 on update for name=#{bad_name.inspect}"
+      assert json_body.dig("errors", "name").present?
+    end
+
+    # Missing/empty/non-hash envelope returns 400
+    post "/api/v1/groups", params: {}, headers: account_headers("acme", token: @owner_token), as: :json
+    assert_response :bad_request
+    post "/api/v1/groups", params: { group: "Ops" }, headers: account_headers("acme", token: @owner_token), as: :json
+    assert_response :bad_request
+    patch "/api/v1/groups/#{acme_billing_id}", params: { group: {} }, headers: account_headers("acme", token: @owner_token), as: :json
+    assert_response :bad_request
+    patch "/api/v1/groups/#{acme_billing_id}", params: { group: "Ops" }, headers: account_headers("acme", token: @owner_token), as: :json
+    assert_response :bad_request
+
+    # Cross-tenant isolation on GET/PATCH/DELETE
+    get "/api/v1/groups", headers: account_headers("acme", token: @owner_token)
+    assert_equal [ acme_billing_id, acme_tech_id ], json_body["groups"].map { |g| g["id"] }
+
+    get "/api/v1/groups/#{globex_billing_id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :not_found
+    patch "/api/v1/groups/#{globex_billing_id}",
+      params: { group: { name: "Hacked" } },
