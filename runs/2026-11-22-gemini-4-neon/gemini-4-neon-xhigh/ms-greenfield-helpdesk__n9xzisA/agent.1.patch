+# frozen_string_literal: true
+
+class AccountMailer < ApplicationMailer
+  def email_verification(user, raw_token)
+    @user = user
+    @account = user.account
+    @verification_url = HelpdeskConfig.verify_email_url(account: @account, token: raw_token)
+
+    message = mail(
+      to: @user.email,
+      subject: "Verify your email for #{@account.name}"
+    ) do |format|
+      format.text
+    end
+    message.transport_encoding = "8bit"
+    message
+  end
+
+  def password_reset(user, raw_token)
+    @user = user
+    @account = user.account
+    @reset_url = HelpdeskConfig.reset_password_url(account: @account, token: raw_token)
+
+    message = mail(
+      to: @user.email,
+      subject: "Reset your password for #{@account.name}"
+    ) do |format|
+      format.text
+    end
+    message.transport_encoding = "8bit"
+    message
+  end
+end
