@@ -0,0 +1,84 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class AccountTest < ActiveSupport::TestCase
+  test "normalizes name and subdomain" do
+    account = Account.create!(name: "  Acme Corp  ", subdomain: "  ACME-1  ")
+    assert_equal "Acme Corp", account.name
+    assert_equal "acme-1", account.subdomain
+  end
+
+  test "validates subdomain format and uniqueness" do
+    Account.create!(name: "Acme", subdomain: "acme")
+
+    duplicate = Account.new(name: "Acme 2", subdomain: "ACME")
+    assert_not duplicate.valid?
+    assert_includes duplicate.errors[:subdomain], "has already been taken"
+
+    [ "", "-acme", "acme-", "bad_sub", "bad sub", "bad.sub", "a" * 64 ].each do |bad|
+      invalid = Account.new(name: "Bad", subdomain: bad)
+      assert_not invalid.valid?, "Expected subdomain #{bad.inspect} to be invalid"
+    end
+
+    [ "a", "ab", "acme-corp", "a1-b2" ].each do |good|
+      valid = Account.new(name: "Good", subdomain: good)
+      assert valid.valid?, "Expected subdomain #{good.inspect} to be valid: #{valid.errors.full_messages}"
+    end
+  end
+
+  test "cancel! revokes sessions and reactivate! restores active status" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    user = account.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "my-first-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    account.update!(owner: user)
+    Session.issue_for(user)
+
+    assert account.active?
+    assert_equal "active", account.status
+    assert_equal 1, account.sessions.count
+
+    account.cancel!
+    assert account.cancelled?
+    assert_equal "cancelled", account.status
+    assert account.reactivatable?
+    assert_equal 0, account.sessions.count
+
+    account.reactivate!
+    assert account.active?
+    assert_nil account.cancelled_at
+  end
+
+  test "purge_expired_cancelled! deletes accounts cancelled more than 90 days ago and all related data" do
+    active = Account.create!(name: "Active", subdomain: "active")
+    active_user = active.users.create!(name: "A", email: "a@test.test", password: "password123", role: "admin")
+    active.update!(owner: active_user)
+
+    recent_cancelled = Account.create!(name: "Recent", subdomain: "recent", cancelled_at: 89.days.ago)
+    recent_user = recent_cancelled.users.create!(name: "R", email: "r@test.test", password: "password123", role: "admin")
+    recent_cancelled.update!(owner: recent_user)
+
+    expired = Account.create!(name: "Expired", subdomain: "expired", cancelled_at: 91.days.ago)
+    expired_user = expired.users.create!(name: "E", email: "e@test.test", password: "password123", role: "admin")
+    expired.update!(owner: expired_user)
+    Session.issue_for(expired_user)
+    EmailVerification.issue_for(expired_user)
+    PasswordReset.issue_for(expired_user)
+
+    purged = Account.purge_expired_cancelled!
+    assert_equal 1, purged
+
+    assert Account.exists?(active.id)
+    assert Account.exists?(recent_cancelled.id)
+    assert_not Account.exists?(expired.id)
+    assert_not User.exists?(expired_user.id)
+    assert_equal 0, Session.where(account_id: expired.id).count
+    assert_equal 0, EmailVerification.where(account_id: expired.id).count
+    assert_equal 0, PasswordReset.where(account_id: expired.id).count
+  end
+end
