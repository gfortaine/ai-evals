@@ -0,0 +1,51 @@
+# frozen_string_literal: true
+
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+
+      def create
+        verification_params = require_hash_param(params, :email_verification).permit(:email)
+        email = verification_params[:email].to_s.strip.downcase
+
+        if email.empty?
+          render_validation_errors({ email: [ "can't be blank" ] })
+          return
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user && !user.verified?
+          verification = EmailVerification.issue_for(user)
+          AccountMailer.email_verification(user, verification.raw_token).deliver_now
+        end
+
+        render json: {
+          message: "If an unverified account exists for that email, a verification link has been sent."
+        }, status: :ok
+      end
+
+      def confirm
+        verification_params = require_hash_param(params, :email_verification).permit(:token)
+        raw_token = verification_params[:token].to_s.strip
+
+        if raw_token.empty?
+          render_error("Invalid or expired verification token", code: "invalid_token", status: :unprocessable_content)
+          return
+        end
+
+        verification = current_account.email_verifications.active.includes(:user).find_by_raw_token(raw_token)
+        unless verification
+          render_error("Invalid or expired verification token", code: "invalid_token", status: :unprocessable_content)
+          return
+        end
+
+        user = verification.user
+        user.verify_email!
+
+        render json: { user: serialize_user(user.reload) }, status: :ok
+      end
+    end
+  end
+end
