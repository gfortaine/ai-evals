+# frozen_string_literal: true
+
+require "test_helper"
+
+class UserTest < ActiveSupport::TestCase
+  test "allows same email across different accounts but rejects duplicate in same account" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    globex = Account.create!(name: "Globex", subdomain: "globex")
+
+    u1 = acme.users.create!(name: "Jo", email: "Jo@Shared.Test", password: "my-first-password", role: "admin")
+    assert_equal "jo@shared.test", u1.email
+
+    u2 = globex.users.create!(name: "Jo", email: "jo@shared.test", password: "other-password", role: "admin")
+    assert u2.persisted?
+
+    dup = acme.users.build(name: "Other Jo", email: "JO@SHARED.TEST", password: "another-password", role: "customer")
+    assert_not dup.valid?
+    assert_includes dup.errors[:email], "has already been taken"
+  end
+
+  test "enforces minimum password length" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    user = acme.users.build(name: "Jo", email: "jo@acme.test", password: "short", role: "admin")
+    assert_not user.valid?
+    assert user.errors[:password].any?
+  end
+end
