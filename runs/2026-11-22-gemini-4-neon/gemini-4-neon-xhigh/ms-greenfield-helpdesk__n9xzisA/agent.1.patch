+# frozen_string_literal: true
+
+module Api
+  module V1
+    class PasswordsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+
+      def update
+        change_params = require_hash_param(params, :password_change).permit(:current_password, :password)
+        current_password = change_params[:current_password]
+        new_password = change_params[:password]
+
+        unless current_password.is_a?(String) && current_user.authenticate(current_password)
+          render_validation_errors(
+            { current_password: [ "is incorrect" ] },
+            message: "Current password is incorrect"
+          )
+          return
+        end
+
+        unless new_password.is_a?(String) && !new_password.empty?
+          render_validation_errors({ password: [ "can't be blank" ] })
+          return
+        end
+
+        current_user.password = new_password
+        unless current_user.valid?
+          render_validation_errors(current_user.errors.to_hash)
+          return
+        end
+
+        ActiveRecord::Base.transaction do
+          current_user.save!
+          current_user.revoke_sessions!
+          current_user.password_resets.delete_all
+        end
+
+        render json: { message: "Password updated" }, status: :ok
+      end
+    end
+  end
+end
