@@ -0,0 +1,67 @@
+# frozen_string_literal: true
+
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+
+      def create
+        reset_params = require_hash_param(params, :password_reset).permit(:email)
+        email = reset_params[:email].to_s.strip.downcase
+
+        if email.empty?
+          render_validation_errors({ email: [ "can't be blank" ] })
+          return
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user
+          reset = PasswordReset.issue_for(user)
+          AccountMailer.password_reset(user, reset.raw_token).deliver_now
+        end
+
+        render json: {
+          message: "If an account exists for that email, a password reset link has been sent."
+        }, status: :ok
+      end
+
+      def confirm
+        reset_params = require_hash_param(params, :password_reset).permit(:token, :password)
+        raw_token = reset_params[:token].to_s.strip
+
+        if raw_token.empty?
+          render_error("Invalid or expired password reset token", code: "invalid_token", status: :unprocessable_content)
+          return
+        end
+
+        reset = current_account.password_resets.active.includes(:user).find_by_raw_token(raw_token)
+        unless reset
+          render_error("Invalid or expired password reset token", code: "invalid_token", status: :unprocessable_content)
+          return
+        end
+
+        new_password = reset_params[:password]
+        unless new_password.is_a?(String) && !new_password.empty?
+          render_validation_errors({ password: [ "can't be blank" ] })
+          return
+        end
+
+        user = reset.user
+        user.password = new_password
+        unless user.valid?
+          render_validation_errors(user.errors.to_hash)
+          return
+        end
+
+        ActiveRecord::Base.transaction do
+          user.save!
+          user.password_resets.delete_all
+          user.revoke_sessions!
+        end
+
+        render json: { message: "Password has been reset" }, status: :ok
+      end
+    end
+  end
+end
