+# frozen_string_literal: true
+
+require "test_helper"
+
+class RequestsAndTicketsTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api
+    verify_last_email!(subdomain: "acme")
+    @account = Account.find_by!(subdomain: "acme")
+    @owner = @account.owner
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    @agent = @account.users.create!(
+      name: "Alex Agent",
+      email: "alex@acme.test",
+      password: "agent-password",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+    @agent_token = sign_in_via_api(subdomain: "acme", email: "alex@acme.test", password: "agent-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    verify_last_email!(subdomain: "acme")
+    @customer = @account.users.find_by!(email: "avery@example.test")
+    @customer_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "full customer request and staff ticket conversation lifecycle with status rules and no reply emails" do
+    # 1. Customer opens a request (sends no email)
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/requests",
+        params: {
+          request: {
+            subject: "Cannot download my receipt",
+            comment: { body: "The download button does nothing." }
+          }
+        },
+        headers: account_headers("acme", token: @customer_token),
+        as: :json
+    end
+    assert_response :created
+
+    req = json_body["request"]
+    assert_kind_of Integer, req["id"]
+    assert_equal "Cannot download my receipt", req["subject"]
+    assert_equal "open", req["status"]
+    assert_equal @customer.id, req["requester_id"]
+    assert_not_nil req["created_at"]
+    assert_not_nil req["updated_at"]
+    assert_equal req["created_at"], req["updated_at"]
+    assert_not req.key?("requester")
+
+    ticket_id = req["id"]
+
+    # 2. Customer lists own requests, opens one, and reads comments
+    get "/api/v1/requests", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal [ ticket_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{ticket_id}", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal req, json_body["request"]
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal 1, json_body["comments"].size
+    first_comment = json_body["comments"].first
+    assert_equal "The download button does nothing.", first_comment["body"]
+    assert_equal({ "id" => @customer.id, "name" => "Avery" }, first_comment["author"])
+    assert_equal true, first_comment["public"]
+    assert_not_nil first_comment["created_at"]
+
+    # 3. Staff lists tickets, opens one, and reads comments (includes requester object)
+    get "/api/v1/tickets", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    listed_ticket = json_body["tickets"].first
+    assert_equal ticket_id, listed_ticket["id"]
+    assert_equal "Cannot download my receipt", listed_ticket["subject"]
+    assert_equal "open", listed_ticket["status"]
+    assert_equal({ "id" => @customer.id, "name" => "Avery", "email" => "avery@example.test" }, listed_ticket["requester"])
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal ticket_id, json_body.dig("ticket", "id")
+    assert_equal({ "id" => @customer.id, "name" => "Avery", "email" => "avery@example.test" }, json_body.dig("ticket", "requester"))
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal "The download button does nothing.", json_body["comments"].first["body"]
+
+    # 4. Owner answers and marks ticket pending (no email)
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: {
+          ticket: {
+            comment: { body: "Please try again now." },
+            status: "pending"
+          }
+        },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+    end
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+    assert_equal({ "id" => @customer.id, "name" => "Avery", "email" => "avery@example.test" }, json_body.dig("ticket", "requester"))
+
+    # 5. Agent posts a follow-up reply WITHOUT status -> status stays pending and updated_at advances
+    previous_updated_at = json_body.dig("ticket", "updated_at")
+    travel 1.minute
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { comment: { body: "Let us know if the link works." } } },
+        headers: account_headers("acme", token: @agent_token),
+        as: :json
+    end
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+    assert_operator json_body.dig("ticket", "updated_at"), :>, previous_updated_at
+
+    # 6. Customer replies to pending request without status -> reopens to open (no email)
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      patch "/api/v1/requests/#{ticket_id}",
+        params: { request: { comment: { body: "Still getting an empty file." } } },
+        headers: account_headers("acme", token: @customer_token),
+        as: :json
+    end
+    assert_response :ok
+    assert_equal "open", json_body.dig("request", "status")
+
+    # 7. Staff marks solved with a reply
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: { body: "Fixed the PDF generator." }, status: "solved" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("ticket", "status")
+
+    # 8. Staff posts another reply without status on solved ticket -> stays solved
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: { body: "Receipt PDF is now cached as well." } } },
+      headers: account_headers("acme", token: @agent_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("ticket", "status")
+
+    # 9. Customer replies to solved request without marking solved -> reopens to open
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "The totals look wrong on the PDF." } } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "open", json_body.dig("request", "status")
+
+    # 10. Staff marks pending, then customer replies AND marks solved in same update -> stays solved (does NOT reopen)
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "pending" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "Actually it looks right now, thanks!" }, status: "solved" } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("request", "status")
+
+    # 11. Customer replies to already-solved request WITH status: "solved" -> stays solved
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "Appreciate the quick help!" }, status: "solved" } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("request", "status")
+
+    # 12. Staff can reopen to open without comment, then customer can mark solved without comment
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "open" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "open", json_body.dig("ticket", "status")
+
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { status: "solved" } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("request", "status")
+
+    # 13. All comments appear oldest first on both customer and staff routes
+    expected_bodies = [
+      "The download button does nothing.",
+      "Please try again now.",
+      "Let us know if the link works.",
+      "Still getting an empty file.",
+      "Fixed the PDF generator.",
+      "Receipt PDF is now cached as well.",
+      "The totals look wrong on the PDF.",
+      "Actually it looks right now, thanks!",
+      "Appreciate the quick help!"
+    ]
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal expected_bodies.size, json_body["count"]
+    assert_equal expected_bodies, json_body["comments"].map { |c| c["body"] }
+    assert json_body["comments"].all? { |c| c["public"] == true }
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal expected_bodies.size, json_body["count"]
+    assert_equal expected_bodies, json_body["comments"].map { |c| c["body"] }
+    assert_equal [ "Avery", "Jo", "Alex Agent", "Avery", "Jo", "Alex Agent", "Avery", "Avery", "Avery" ],
+      json_body["comments"].map { |c| c.dig("author", "name") }
+
+    # Confirm zero emails were sent throughout entire conversation
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
+
+  test "validation errors and atomic rollbacks on request create and patch updates" do
+    # Missing subject or comment body fails atomically
+    assert_no_difference [ "Ticket.count", "TicketComment.count" ] do
+      post "/api/v1/requests",
+        params: { request: { subject: "  ", comment: { body: "   " } } },
+        headers: account_headers("acme", token: @customer_token),
+        as: :json
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "subject").present?
+    assert json_body.dig("errors", "comment", "body").present?
+
+    # Missing comment entirely fails with 422
+    assert_no_difference [ "Ticket.count", "TicketComment.count" ] do
+      post "/api/v1/requests",
+        params: { request: { subject: "No comment provided" } },
+        headers: account_headers("acme", token: @customer_token),
+        as: :json
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "comment", "body").present?
+
+    # Create valid request (status param ignored, forced open)
+    post "/api/v1/requests",
+      params: { request: { subject: "Valid issue", status: "solved", comment: { body: "Initial body", public: false } } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :created
+    ticket_id = json_body.dig("request", "id")
+    assert_equal "open", json_body.dig("request", "status")
+    assert_equal true, Ticket.find(ticket_id).comments.first.public
+
+    # Customer cannot set status to pending, open, or invalid values (and no comment is saved)
+    [ "pending", "open", "closed", "", nil, 123, [ "solved" ] ].each do |bad_status|
+      assert_no_difference "TicketComment.count" do
+        patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { comment: { body: "Should roll back" }, status: bad_status } },
+          headers: account_headers("acme", token: @customer_token),
+          as: :json
+      end
+      assert_response :unprocessable_content, "Expected 422 for customer status #{bad_status.inspect}"
+      assert_equal "open", Ticket.find(ticket_id).status
+    end
+
+    # Staff marks pending
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "pending" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+
+    # Customer blank reply does NOT reopen pending request
+    assert_no_difference "TicketComment.count" do
+      patch "/api/v1/requests/#{ticket_id}",
+        params: { request: { comment: { body: "   " } } },
+        headers: account_headers("acme", token: @customer_token),
+        as: :json
+    end
