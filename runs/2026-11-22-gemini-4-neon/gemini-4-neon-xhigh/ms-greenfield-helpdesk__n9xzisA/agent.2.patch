+      assert_no_difference "TicketComment.count" do
+        patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Should not save" }, status: bad_status } },
+          headers: account_headers("acme", token: @owner_token),
+          as: :json
+      end
+      assert_response :unprocessable_content, "Expected 422 for staff status #{bad_status.inspect}"
+      assert_equal "pending", Ticket.find(ticket_id).status
+    end
+
+    # Staff valid status + blank comment rolls back status
+    assert_no_difference "TicketComment.count" do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { comment: { body: "   " }, status: "solved" } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+    end
+    assert_response :unprocessable_content
+    assert_equal "pending", Ticket.find(ticket_id).status
+
+    # Non-hash envelopes and comment values return 400
+    post "/api/v1/requests",
+      params: { request: "not-a-hash" },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :bad_request
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Bad comment type", comment: "string" } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :bad_request
+
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: "string" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :bad_request
+
+    # Explicit null comment with valid status succeeds
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: nil, status: "solved" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("ticket", "status")
+  end
+
+  test "non-public comments are hidden from customers on /requests/:id/comments" do
+    post "/api/v1/requests",
+      params: { request: { subject: "Billing question", comment: { body: "Public initial message" } } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :created
+    ticket = Ticket.find(json_body.dig("request", "id"))
+
+    TicketComment.create!(
+      account: @account,
+      ticket: ticket,
+      author: @owner,
+      body: "Internal staff note",
+      public: false
+    )
+
+    get "/api/v1/requests/#{ticket.id}/comments", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal [ "Public initial message" ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/tickets/#{ticket.id}/comments", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal [ true, false ], json_body["comments"].map { |c| c["public"] }
+  end
+end
diff --git a/test/integration/requests_tickets_authorization_and_pagination_test.rb b/test/integration/requests_tickets_authorization_and_pagination_test.rb
