+    # Cross-endpoint replay: tickets cursor on /requests, users cursor on /staff, ticket comments on request comments
+    get "/api/v1/requests", params: { page: { after: acme_ticket_cursor, size: 1 } }, headers: avery_headers
+    assert_response :unprocessable_content
