+      get "/api/v1/tickets", params: { page: { after: bad_cursor, size: 2 } }, headers: owner_headers
+      assert_response :unprocessable_content, "Expected 422 for page[after]=#{bad_cursor.inspect}"
+
+      get "/api/v1/tickets", params: { page: { before: bad_cursor, size: 2 } }, headers: owner_headers
+      assert_response :unprocessable_content, "Expected 422 for page[before]=#{bad_cursor.inspect}"
+    end
+
+    # Invalid page[size] -> 422
+    [ "", "   ", "0", "-1", "01", "abc", "1.5", [ "10" ], { a: "10" } ].each do |bad_size|
+      get "/api/v1/tickets", params: { page: { size: bad_size } }, headers: owner_headers
+      assert_response :unprocessable_content, "Expected 422 for page[size]=#{bad_size.inspect}"
+    end
+
+    # Unknown page subkey -> 422
+    get "/api/v1/tickets?page[foo]=bar&page[size]=5", headers: owner_headers
