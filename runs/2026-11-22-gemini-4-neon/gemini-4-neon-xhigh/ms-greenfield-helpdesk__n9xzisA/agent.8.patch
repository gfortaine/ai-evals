+
+    get "/api/v1/tickets?page=2&page[size]=5", headers: owner_headers
+    assert_response :bad_request
+    assert json_body["error"].present?
+
+    # Null byte in q with cursor pagination returns clean 200 empty
+    get "/api/v1/tickets?q=test%00bad&page[size]=5", headers: owner_headers
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+    assert_equal false, json_body.dig("meta", "has_more")
+  end
