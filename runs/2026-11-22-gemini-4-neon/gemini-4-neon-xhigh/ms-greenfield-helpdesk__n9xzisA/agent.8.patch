+    assert_response :unprocessable_content
+
+    # Cross-user replay on /requests: Avery's cursor used by Blake -> 422
+    get "/api/v1/requests", params: { page: { after: avery_request_cursor, size: 1 } }, headers: blake_headers
+    assert_response :unprocessable_content
+
+    # Both after and before together -> 422
+    get "/api/v1/tickets",
+      params: { page: { after: acme_ticket_cursor, before: acme_ticket_cursor, size: 1 } },
+      headers: owner_headers
+    assert_response :unprocessable_content
+
+    # Invalid cursors -> 422
