+    invs = (1..4).map do |i|
+      inv = Invitation.build_for(account: @acme, invited_by: @owner, email: "stable-inv-#{i}@acme.test", role: "agent")
+      inv.save!
+      inv.id
+    end
+    get "/api/v1/invitations?status=pending&page[size]=2", headers: owner_headers
+    assert_response :ok
+    assert_equal invs[0..1], json_body["invitations"].map { |inv| inv["id"] }
+    inv_next = json_body.dig("links", "next")
+
+    # Revoke both page-1 invitations (including anchor!)
+    invs[0..1].each do |inv_id|
+      delete "/api/v1/invitations/#{inv_id}", headers: owner_headers
+      assert_response :ok
+    end
+
+    get inv_next, headers: owner_headers
+    assert_response :ok
+    assert_equal invs[2..3], json_body["invitations"].map { |inv| inv["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_nil json_body.dig("links", "prev")
+
+    # 3. Group membership deleted on page 1 while browsing group_memberships
+    gs = (1..4).map { |i| Group.create!(account: @acme, name: "GMGroup #{i}") }
+    gms = gs.map { |g| GroupMembership.create!(account: @acme, group: g, user: @agent).id }
+    get "/api/v1/group_memberships?user_id=#{@agent.id}&page[size]=2", headers: owner_headers
+    assert_response :ok
+    assert_equal gms[0..1], json_body["group_memberships"].map { |gm| gm["id"] }
+    gm_next = json_body.dig("links", "next")
+
+    delete "/api/v1/group_memberships/#{gms[1]}", headers: owner_headers
+    assert_response :no_content
+
+    get gm_next, headers: owner_headers
+    assert_response :ok
+    assert_equal gms[2..3], json_body["group_memberships"].map { |gm| gm["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+
+    # 4. Live comments arriving while browsing /requests/:id/comments & /tickets/:id/comments
+    comment_ticket = create_ticket_as(@avery_token, subject: "Live thread", body: "Msg 1", at: base_time + 20.minutes)
+    travel_to base_time + 21.minutes do
+      patch "/api/v1/tickets/#{comment_ticket}",
+        params: { ticket: { comment: { body: "Msg 2", public: true } } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests/#{comment_ticket}/comments?page[size]=2", headers: avery_headers
+    assert_response :ok
+    assert_equal [ "Msg 1", "Msg 2" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    req_after_cursor = json_body.dig("meta", "after_cursor")
+
+    get "/api/v1/tickets/#{comment_ticket}/comments?page[size]=2", headers: owner_headers
+    assert_response :ok
+    staff_after_cursor = json_body.dig("meta", "after_cursor")
+
+    # Staff adds private note then public reply
+    travel_to base_time + 22.minutes do
+      patch "/api/v1/tickets/#{comment_ticket}",
+        params: { ticket: { comment: { body: "Internal note", public: false } } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+    end
+    travel_to base_time + 23.minutes do
+      patch "/api/v1/tickets/#{comment_ticket}",
+        params: { ticket: { comment: { body: "Msg 3", public: true } } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+    end
+
+    # Customer polls with after_cursor -> receives only Msg 3 (not internal note)
+    get "/api/v1/requests/#{comment_ticket}/comments",
+      params: { page: { after: req_after_cursor, size: 2 } },
+      headers: avery_headers
+    assert_response :ok
+    assert_equal [ "Msg 3" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_not_nil json_body.dig("links", "prev")
+
+    # Staff polls with after_cursor -> receives both Internal note and Msg 3
+    get "/api/v1/tickets/#{comment_ticket}/comments",
+      params: { page: { after: staff_after_cursor, size: 2 } },
+      headers: owner_headers
+    assert_response :ok
+    assert_equal [ "Internal note", "Msg 3" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_not_nil json_body.dig("links", "prev")
+  end
+
+  test "preserves combined ticket filters including comment-body search across cursor links" do
+    base_time = Time.utc(2026, 11, 20, 20, 0, 0)
+    owner_headers = account_headers("acme", token: @owner_token)
+
+    matching_ids = (1..3).map do |i|
+      tid = create_ticket_as(@avery_token, subject: "Generic #{i}", body: "Contains needle phrase #{i}", at: base_time + i.minutes)
+      travel_to base_time + (10 + i).minutes do
+        patch "/api/v1/tickets/#{tid}",
+          params: { ticket: { priority: "high" } },
+          headers: owner_headers,
+          as: :json
+        assert_response :ok
+      end
+      tid
+    end
+    # Non-matching ticket (normal priority)
+    create_ticket_as(@avery_token, subject: "Generic 4", body: "Contains needle phrase 4", at: base_time + 20.minutes)
+
+    query = "page[size]=2&status=open&priority=high&group_id=unassigned&assignee_id=unassigned&requester_id=#{@avery.id}&q=needle+phrase"
+    got_ids, pages = collect_forward_ids("/api/v1/tickets?#{query}", collection_key: "tickets", headers: owner_headers)
+    assert_equal matching_ids.reverse, got_ids
+    assert_equal 2, pages.size
+
+    prev_link = pages.last.dig("links", "prev")
+    prev_query = URI.decode_www_form(URI.parse(prev_link).query).to_h
+    assert_equal "open", prev_query["status"]
+    assert_equal "high", prev_query["priority"]
+    assert_equal "unassigned", prev_query["group_id"]
+    assert_equal "unassigned", prev_query["assignee_id"]
+    assert_equal @avery.id.to_s, prev_query["requester_id"]
+    assert_equal "needle phrase", prev_query["q"]
+    assert_equal "2", prev_query["page[size]"]
+
+    get prev_link, headers: owner_headers
+    assert_response :ok
+    assert_equal matching_ids.reverse.first(2), json_body["tickets"].map { |t| t["id"] }
+  end
+end
