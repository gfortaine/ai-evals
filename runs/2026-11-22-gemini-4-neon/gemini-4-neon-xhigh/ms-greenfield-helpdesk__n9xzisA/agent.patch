+
+    # Cross-account target (even with same customer email in Globex!) -> 422
+    assert_no_difference "TicketComment.count" do
+      post "/api/v1/tickets/#{avery_t1}/merge",
+        params: { merge: { target_id: globex_t1 } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "target_id").present?
+
+    # Different customer in same account -> 422
+    assert_no_difference "TicketComment.count" do
+      post "/api/v1/tickets/#{avery_t1}/merge",
+        params: { merge: { target_id: blake_t1 } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "target_id").present?
+
+    # Self-merge -> 422
+    assert_no_difference "TicketComment.count" do
+      post "/api/v1/tickets/#{avery_t1}/merge",
+        params: { merge: { target_id: avery_t1 } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+    end
