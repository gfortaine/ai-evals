--- /dev/null
+++ b/test/models/account_test.rb
@@ -0,0 +1,84 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class AccountTest < ActiveSupport::TestCase
+  test "normalizes name and subdomain" do
+    account = Account.create!(name: "  Acme Corp  ", subdomain: "  ACME-1  ")
+    assert_equal "Acme Corp", account.name
+    assert_equal "acme-1", account.subdomain
+  end
+
+  test "validates subdomain format and uniqueness" do
+    Account.create!(name: "Acme", subdomain: "acme")
+
+    duplicate = Account.new(name: "Acme 2", subdomain: "ACME")
+    assert_not duplicate.valid?
+    assert_includes duplicate.errors[:subdomain], "has already been taken"
+
+    [ "", "-acme", "acme-", "bad_sub", "bad sub", "bad.sub", "a" * 64 ].each do |bad|
+      invalid = Account.new(name: "Bad", subdomain: bad)
+      assert_not invalid.valid?, "Expected subdomain #{bad.inspect} to be invalid"
+    end
+
+    [ "a", "ab", "acme-corp", "a1-b2" ].each do |good|
+      valid = Account.new(name: "Good", subdomain: good)
+      assert valid.valid?, "Expected subdomain #{good.inspect} to be valid: #{valid.errors.full_messages}"
+    end
+  end
+
+  test "cancel! revokes sessions and reactivate! restores active status" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    user = account.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "my-first-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    account.update!(owner: user)
+    Session.issue_for(user)
+
+    assert account.active?
+    assert_equal "active", account.status
+    assert_equal 1, account.sessions.count
+
+    account.cancel!
+    assert account.cancelled?
+    assert_equal "cancelled", account.status
+    assert account.reactivatable?
+    assert_equal 0, account.sessions.count
+
+    account.reactivate!
+    assert account.active?
+    assert_nil account.cancelled_at
+  end
+
+  test "purge_expired_cancelled! deletes accounts cancelled more than 90 days ago and all related data" do
+    active = Account.create!(name: "Active", subdomain: "active")
+    active_user = active.users.create!(name: "A", email: "a@test.test", password: "password123", role: "admin")
+    active.update!(owner: active_user)
+
+    recent_cancelled = Account.create!(name: "Recent", subdomain: "recent", cancelled_at: 89.days.ago)
+    recent_user = recent_cancelled.users.create!(name: "R", email: "r@test.test", password: "password123", role: "admin")
+    recent_cancelled.update!(owner: recent_user)
+
+    expired = Account.create!(name: "Expired", subdomain: "expired", cancelled_at: 91.days.ago)
+    expired_user = expired.users.create!(name: "E", email: "e@test.test", password: "password123", role: "admin")
+    expired.update!(owner: expired_user)
+    Session.issue_for(expired_user)
+    EmailVerification.issue_for(expired_user)
+    PasswordReset.issue_for(expired_user)
+
+    purged = Account.purge_expired_cancelled!
+    assert_equal 1, purged
+
+    assert Account.exists?(active.id)
+    assert Account.exists?(recent_cancelled.id)
+    assert_not Account.exists?(expired.id)
+    assert_not User.exists?(expired_user.id)
+    assert_equal 0, Session.where(account_id: expired.id).count
+    assert_equal 0, EmailVerification.where(account_id: expired.id).count
+    assert_equal 0, PasswordReset.where(account_id: expired.id).count
+  end
+end
diff --git a/test/models/group_membership_test.rb b/test/models/group_membership_test.rb
new file mode 100644
index 0000000..10883a7
--- /dev/null
+++ b/test/models/group_membership_test.rb
@@ -0,0 +1,159 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class GroupMembershipTest < ActiveSupport::TestCase
+  setup do
+    @acme = Account.create!(name: "Acme", subdomain: "acme")
+    @globex = Account.create!(name: "Globex", subdomain: "globex")
+
+    @admin = @acme.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "admin-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    @acme.update!(owner: @admin)
+
+    @agent = @acme.users.create!(
+      name: "Sam",
+      email: "sam@acme.test",
+      password: "agent-password",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+
+    @customer = @acme.users.create!(
+      name: "Avery",
+      email: "avery@example.test",
+      password: "customer-password",
+      role: "customer",
+      email_verified_at: Time.current
+    )
+
+    @globex_owner = @globex.users.create!(
+      name: "Max",
+      email: "max@globex.test",
+      password: "globex-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    @globex.update!(owner: @globex_owner)
+
+    @billing = @acme.groups.create!(name: "Billing")
+    @tech = @acme.groups.create!(name: "Technical Support")
+    @sales = @acme.groups.create!(name: "Sales")
+    @globex_group = @globex.groups.create!(name: "Globex Support")
+  end
+
+  test "validates staff role, same account, and uniqueness" do
+    customer_membership = @acme.group_memberships.build(group: @billing, user: @customer)
+    assert_not customer_membership.valid?
+    assert customer_membership.errors[:user_id].any?
+
+    cross_tenant_user = @acme.group_memberships.build(group: @billing, user: @globex_owner)
+    assert_not cross_tenant_user.valid?
+    assert cross_tenant_user.errors[:user_id].any?
+
+    cross_tenant_group = @acme.group_memberships.build(group: @globex_group, user: @agent)
+    assert_not cross_tenant_group.valid?
+    assert cross_tenant_group.errors[:group_id].any?
+
+    first = @acme.group_memberships.create!(group: @billing, user: @agent)
+    assert first.persisted?
+
+    duplicate = @acme.group_memberships.build(group: @billing, user: @agent)
+    assert_not duplicate.valid?
+    assert duplicate.errors[:user_id].any?
+  end
+
+  test "enforces single default invariant across create, make_default!, and destroy!" do
+    # First membership automatically becomes default even when default: false
+    m1 = @acme.group_memberships.create!(group: @billing, user: @agent, default: false)
+    assert m1.reload.default?
+    assert_equal @billing, @agent.default_group
+
+    # Second membership with default: false keeps first as default
+    m2 = @acme.group_memberships.create!(group: @tech, user: @agent, default: false)
+    assert_not m2.reload.default?
+    assert m1.reload.default?
+
+    # Third membership with default: true replaces default
+    m3 = @acme.group_memberships.create!(group: @sales, user: @agent, default: true)
+    assert m3.reload.default?
+    assert_not m1.reload.default?
+    assert_not m2.reload.default?
+
+    # make_default! switches default and is idempotent
+    m2.make_default!
+    assert m2.reload.default?
+    assert_not m1.reload.default?
+    assert_not m3.reload.default?
+
+    m2.make_default!
+    assert m2.reload.default?
+
+    # Destroying non-default keeps current default
+    m3.destroy!
+    assert m2.reload.default?
+    assert_not m1.reload.default?
+
+    # Destroying default promotes remaining membership (m1)
+    m2.destroy!
+    assert m1.reload.default?
+    assert_equal @billing, @agent.default_group
+
+    # Destroying last membership leaves no default
+    m1.destroy!
+    assert_nil @agent.default_group
+  end
+
+  test "destroying a membership clears only invalid assignments in that group without touching public_updated_at" do
+    @acme.group_memberships.create!(group: @billing, user: @admin, default: true)
+    m_agent_billing = @acme.group_memberships.create!(group: @billing, user: @agent, default: true)
+    m_agent_tech = @acme.group_memberships.create!(group: @tech, user: @agent, default: false)
+
+    t_billing_agent = @acme.tickets.create!(requester: @customer, group: @billing, assignee: @agent, subject: "Billing Sam")
+    t_billing_admin = @acme.tickets.create!(requester: @customer, group: @billing, assignee: @admin, subject: "Billing Jo")
+    t_tech_agent = @acme.tickets.create!(requester: @customer, group: @tech, assignee: @agent, subject: "Tech Sam")
+
+    original_public_updated_at = t_billing_agent.public_updated_at
+    original_updated_at = t_billing_agent.updated_at
+
+    travel 15.minutes do
+      m_agent_billing.destroy!
+    end
+
+    # Ticket in Billing assigned to Sam loses assignee ONLY (group stays Billing!)
+    t_billing_agent.reload
+    assert_equal @billing.id, t_billing_agent.group_id
+    assert_nil t_billing_agent.assignee_id
+    assert_operator t_billing_agent.updated_at, :>, original_updated_at
+    assert_equal original_public_updated_at, t_billing_agent.public_updated_at
+
+    # Other assignee in Billing and Sam's ticket in Tech are untouched
+    assert_equal @admin.id, t_billing_admin.reload.assignee_id
+    assert_equal @billing.id, t_billing_admin.group_id
+    assert_equal @agent.id, t_tech_agent.reload.assignee_id
+    assert_equal @tech.id, t_tech_agent.group_id
+
+    # Sam's Tech membership was promoted to default
+    assert m_agent_tech.reload.default?
+  end
+
+  test "ticket model validates group account and assignee membership in group" do
+    @acme.group_memberships.create!(group: @billing, user: @agent, default: true)
+
+    valid_ticket = @acme.tickets.build(requester: @customer, group: @billing, assignee: @agent, subject: "Valid")
+    assert valid_ticket.valid?
+
+    wrong_group_assignee = @acme.tickets.build(requester: @customer, group: @tech, assignee: @agent, subject: "Wrong group")
+    assert_not wrong_group_assignee.valid?
+    assert wrong_group_assignee.errors[:assignee_id].any?
+
+    cross_tenant_group = @acme.tickets.build(requester: @customer, group: @globex_group, subject: "Cross tenant")
+    assert_not cross_tenant_group.valid?
+    assert cross_tenant_group.errors[:group_id].any?
+  end
+end
diff --git a/test/models/group_test.rb b/test/models/group_test.rb
new file mode 100644
index 0000000..c7e57c5
--- /dev/null
+++ b/test/models/group_test.rb
@@ -0,0 +1,134 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class GroupTest < ActiveSupport::TestCase
+  setup do
+    @acme = Account.create!(name: "Acme", subdomain: "acme")
+    @globex = Account.create!(name: "Globex", subdomain: "globex")
+
+    @admin = @acme.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "admin-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    @acme.update!(owner: @admin)
+
+    @agent = @acme.users.create!(
+      name: "Sam",
+      email: "sam@acme.test",
+      password: "agent-password",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+
+    @customer = @acme.users.create!(
+      name: "Avery",
+      email: "avery@example.test",
+      password: "customer-password",
+      role: "customer",
+      email_verified_at: Time.current
+    )
+  end
+
+  test "normalizes name and enforces case-insensitive uniqueness per account" do
+    billing = @acme.groups.create!(name: "  Billing  ")
+    assert_equal "Billing", billing.name
+
+    dup_same_account = @acme.groups.build(name: "billing")
+    assert_not dup_same_account.valid?
+    assert_includes dup_same_account.errors[:name], "has already been taken"
+
+    same_name_other_account = @globex.groups.create!(name: "Billing")
+    assert same_name_other_account.persisted?
+
+    # Case-only rename on same record is valid
+    billing.update!(name: "BILLING")
+    assert_equal "BILLING", billing.reload.name
+
+    # Blank and over-length names are rejected
+    assert_not @acme.groups.build(name: "   ").valid?
+    assert_not @acme.groups.build(name: "a" * 256).valid?
+  end
+
+  test "destroying a group clears ticket group and assignee without touching public_updated_at and promotes new defaults" do
+    billing = @acme.groups.create!(name: "Billing")
+    tech = @acme.groups.create!(name: "Technical Support")
+    sales = @acme.groups.create!(name: "Sales")
+
+    # Agent is in Billing (default), Tech, and Sales; Admin is only in Billing (default)
+    @acme.group_memberships.create!(group: billing, user: @agent, default: true)
+    tech_membership = @acme.group_memberships.create!(group: tech, user: @agent, default: false)
+    sales_membership = @acme.group_memberships.create!(group: sales, user: @agent, default: false)
+    @acme.group_memberships.create!(group: billing, user: @admin, default: true)
+
+    # Suspend admin to confirm default promotion / cleanup still works for suspended staff
+    # Also test a second suspended agent who HAS another group
+    suspended_agent = @acme.users.create!(
+      name: "Pat",
+      email: "pat@acme.test",
+      password: "pat-password",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+    @acme.group_memberships.create!(group: billing, user: suspended_agent, default: true)
+    pat_sales = @acme.group_memberships.create!(group: sales, user: suspended_agent, default: false)
+    suspended_agent.suspend!
+
+    t_billing_assigned = @acme.tickets.create!(requester: @customer, group: billing, assignee: @agent, subject: "Billing assigned")
+    t_billing_unassigned = @acme.tickets.create!(requester: @customer, group: billing, subject: "Billing unassigned")
+    t_tech_assigned = @acme.tickets.create!(requester: @customer, group: tech, assignee: @agent, subject: "Tech assigned")
+
+    original_public_updated_at = t_billing_assigned.public_updated_at
+    original_updated_at = t_billing_assigned.updated_at
+
+    travel 10.minutes do
+      billing.destroy!
+    end
+
+    assert_not Group.exists?(billing.id)
+
+    t_billing_assigned.reload
+    assert_nil t_billing_assigned.group_id
+    assert_nil t_billing_assigned.assignee_id
+    assert_operator t_billing_assigned.updated_at, :>, original_updated_at
+    assert_equal original_public_updated_at, t_billing_assigned.public_updated_at
+
+    t_billing_unassigned.reload
+    assert_nil t_billing_unassigned.group_id
+    assert_nil t_billing_unassigned.assignee_id
+
+    t_tech_assigned.reload
+    assert_equal tech.id, t_tech_assigned.group_id
+    assert_equal @agent.id, t_tech_assigned.assignee_id
+
+    # Agent's lowest-ID remaining membership (Tech) became default; Sales stays non-default
+    assert tech_membership.reload.default?
+    assert_not sales_membership.reload.default?
+    assert_equal tech, @agent.default_group
+
+    # Admin had no remaining memberships
+    assert_equal 0, @admin.group_memberships.count
+    assert_nil @admin.default_group
+
+    # Suspended agent's remaining Sales membership became default
+    assert pat_sales.reload.default?
+    assert_equal sales, suspended_agent.default_group
+  end
+
+  test "purging an expired cancelled account also deletes its groups and group memberships" do
+    billing = @acme.groups.create!(name: "Billing")
+    membership = @acme.group_memberships.create!(group: billing, user: @agent, default: true)
+    ticket = @acme.tickets.create!(requester: @customer, group: billing, assignee: @agent, subject: "Help")
+
+    @acme.update!(cancelled_at: 91.days.ago)
+
+    assert_equal 1, Account.purge_expired_cancelled!
+    assert_not Account.exists?(@acme.id)
+    assert_not Group.exists?(billing.id)
+    assert_not GroupMembership.exists?(membership.id)
+    assert_not Ticket.exists?(ticket.id)
+  end
+end
diff --git a/test/models/invitation_test.rb b/test/models/invitation_test.rb
new file mode 100644
index 0000000..7edac89
--- /dev/null
+++ b/test/models/invitation_test.rb
@@ -0,0 +1,116 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class InvitationTest < ActiveSupport::TestCase
+  setup do
+    @acme = Account.create!(name: "Acme", subdomain: "acme")
+    @globex = Account.create!(name: "Globex", subdomain: "globex")
+
+    @admin = @acme.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "admin-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    @acme.update!(owner: @admin)
+
+    @globex_admin = @globex.users.create!(
+      name: "Max",
+      email: "max@globex.test",
+      password: "globex-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    @globex.update!(owner: @globex_admin)
+  end
+
+  test "validates email, role, same-account inviter, and competing invitations" do
+    inv = Invitation.build_for(account: @acme, invited_by: @admin, email: "  Sam@Example.Test ", role: "agent")
+    assert inv.valid?
+    assert_equal "sam@example.test", inv.email
+    assert_equal "pending", inv.status
+    inv.save!
+
+    # Competing pending invitation in same account is rejected
+    competing = Invitation.build_for(account: @acme, invited_by: @admin, email: "SAM@EXAMPLE.TEST", role: "admin")
+    assert_not competing.valid?
+    assert competing.errors[:email].any?
+
+    # Same email in different account is allowed
+    other_account_inv = Invitation.build_for(account: @globex, invited_by: @globex_admin, email: "sam@example.test", role: "agent")
+    assert other_account_inv.valid?
+    other_account_inv.save!
+
+    # Existing user email in same account is rejected
+    existing_user_inv = Invitation.build_for(account: @acme, invited_by: @admin, email: "jo@acme.test", role: "agent")
+    assert_not existing_user_inv.valid?
+    assert existing_user_inv.errors[:email].any?
+
+    # Invalid role ("customer") is rejected
+    customer_role = Invitation.build_for(account: @acme, invited_by: @admin, email: "new@example.test", role: "customer")
+    assert_not customer_role.valid?
+    assert customer_role.errors[:role].any?
+
+    # Cross-account inviter is rejected
+    cross_inviter = Invitation.build_for(account: @acme, invited_by: @globex_admin, email: "new@example.test", role: "agent")
+    assert_not cross_inviter.valid?
+    assert cross_inviter.errors[:invited_by].any?
+  end
+
+  test "tracks pending, accepted, revoked, and expired statuses and allows re-inviting after revoke or expiry" do
+    inv1 = Invitation.build_for(account: @acme, invited_by: @admin, email: "sam@example.test", role: "agent")
+    inv1.save!
+    raw1 = inv1.raw_token
+
+    assert_equal "pending", inv1.status
+    assert_equal inv1, @acme.invitations.pending.find_by_raw_token(raw1)
+
+    # Resend rotates token and extends expiry
+    travel 2.days do
+      old_expires = inv1.expires_at
+      inv1.resend!
+      raw2 = inv1.raw_token
+
+      assert_not_equal raw1, raw2
+      assert_operator inv1.expires_at, :>, old_expires
+      assert_nil @acme.invitations.find_by_raw_token(raw1)
+      assert_equal inv1, @acme.invitations.pending.find_by_raw_token(raw2)
+    end
+
+    # Revoke transitions to revoked and allows creating a new invitation for the same email
+    inv1.revoke!
+    assert_equal "revoked", inv1.status
+    assert_includes @acme.invitations.revoked, inv1
+    assert_not_includes @acme.invitations.pending, inv1
+
+    inv2 = Invitation.build_for(account: @acme, invited_by: @admin, email: "sam@example.test", role: "admin")
+    assert inv2.valid?
+    inv2.save!
+
+    # Expiry boundary transitions pending -> expired and allows creating a new invitation
+    travel_to inv2.expires_at + 1.second do
+      assert_equal "expired", inv2.status
+      assert_includes @acme.invitations.expired, inv2
+      assert_not_includes @acme.invitations.pending, inv2
+
+      inv3 = Invitation.build_for(account: @acme, invited_by: @admin, email: "sam@example.test", role: "agent")
+      assert inv3.valid?
+      inv3.save!
+
+      inv3.update!(accepted_at: Time.current)
+      assert_equal "accepted", inv3.status
+      assert_includes @acme.invitations.accepted, inv3
+    end
+  end
+
+  test "purging an expired cancelled account also deletes its invitations" do
+    inv = Invitation.build_for(account: @acme, invited_by: @admin, email: "sam@example.test", role: "agent")
+    inv.save!
+
+    @acme.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_expired_cancelled!
+    assert_not Invitation.exists?(inv.id)
+  end
+end
diff --git a/test/models/ticket_test.rb b/test/models/ticket_test.rb
