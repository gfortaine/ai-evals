index 0000000..1ebb045
--- /dev/null
+++ b/test/tasks/purge_cancelled_accounts_test.rb
@@ -0,0 +1,50 @@
+# frozen_string_literal: true
+
+require "test_helper"
+require "rake"
+
+class PurgeCancelledAccountsTest < ActiveSupport::TestCase
+  setup do
+    Helpdesk::Application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+  end
+
+  test "helpdesk:purge_cancelled_accounts permanently deletes only accounts cancelled more than 90 days ago" do
+    active = Account.create!(name: "Active", subdomain: "active")
+    active_user = active.users.create!(name: "Jo", email: "jo@shared.test", password: "password123", role: "admin", email_verified_at: Time.current)
+    active.update!(owner: active_user)
+    active_session = Session.issue_for(active_user)
+
+    within_window = Account.create!(name: "Within", subdomain: "within", cancelled_at: 89.days.ago)
+    within_user = within_window.users.create!(name: "Jo", email: "jo@shared.test", password: "password123", role: "admin", email_verified_at: Time.current)
+    within_window.update!(owner: within_user)
+
+    expired = Account.create!(name: "Expired", subdomain: "expired", cancelled_at: 91.days.ago)
+    expired_user = expired.users.create!(name: "Jo", email: "jo@shared.test", password: "password123", role: "admin", email_verified_at: Time.current)
+    expired.update!(owner: expired_user)
+    expired_session = Session.issue_for(expired_user)
+    expired_verification = EmailVerification.issue_for(expired_user)
+    expired_reset = PasswordReset.issue_for(expired_user)
+
+    assert_output(/Purged 1 cancelled account/) do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+    end
+
+    assert Account.exists?(active.id)
+    assert User.exists?(active_user.id)
+    assert Session.exists?(active_session.id)
+
+    assert Account.exists?(within_window.id)
+    assert User.exists?(within_user.id)
+
+    assert_not Account.exists?(expired.id)
+    assert_not User.exists?(expired_user.id)
+    assert_not Session.exists?(expired_session.id)
+    assert_not EmailVerification.exists?(expired_verification.id)
+    assert_not PasswordReset.exists?(expired_reset.id)
+
+    # Subdomain of purged account can now be reused
+    recreated = Account.create!(name: "Expired Reborn", subdomain: "expired")
+    assert recreated.persisted?
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..fc940c0
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,144 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+require "uri"
+
+module ActiveSupport
+  class TestCase
+    setup do
+      ActionMailer::Base.deliveries.clear
+    end
+
+    def with_env(overrides)
+      originals = {}
+      overrides.each do |key, value|
+        key_s = key.to_s
+        originals[key_s] = ENV.key?(key_s) ? ENV[key_s] : :__unset__
+        if value.nil?
+          ENV.delete(key_s)
+        else
+          ENV[key_s] = value
+        end
+      end
+      yield
+    ensure
+      originals.each do |key_s, original|
+        if original == :__unset__
+          ENV.delete(key_s)
+        else
+          ENV[key_s] = original
+        end
+      end
+    end
+  end
+end
+
+module ApiTestHelper
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def account_headers(subdomain, token: nil, extra: {})
+    headers = {
+      "X-Helpdesk-Account" => subdomain,
+      "Accept" => "application/json"
+    }
+    headers["Authorization"] = "Bearer #{token}" if token
+    headers.merge(extra)
+  end
+
+  def extract_link_from_mail(mail, path:)
+    body = mail.body.decoded
+    match = body.match(%r{https?://[^\s]+#{Regexp.escape(path)}\?[^\s]+})
+    assert_not_nil match, "Expected link containing #{path} in mail body:\n#{body}"
+    match[0]
+  end
+
+  def extract_query_params(url)
+    uri = URI.parse(url)
+    URI.decode_www_form(uri.query.to_s).to_h
+  end
+
+  def create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+  end
+
+  def register_customer_via_api(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: {
+        user: {
+          name: name,
+          email: email,
+          password: password
+        }
+      },
+      headers: account_headers(subdomain),
+      as: :json
+  end
+
+  def verify_last_email!(subdomain:)
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail, "Expected a verification email to have been sent"
+    link = extract_link_from_mail(mail, path: "/verify-email")
+    params = extract_query_params(link)
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: params["token"] } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+    params["token"]
+  end
+
+  def sign_in_via_api(subdomain:, email:, password:)
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    json_body.dig("session", "token")
+  end
+
+  def invite_staff_via_api(subdomain: "acme", token:, email:, role: "agent")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: account_headers(subdomain, token: token),
+      as: :json
+  end
+
+  def extract_last_invitation_token
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail, "Expected an invitation email to have been sent"
+    link = extract_link_from_mail(mail, path: "/accept-invitation")
+    extract_query_params(link)["token"]
+  end
+
+  def accept_invitation_via_api(subdomain: "acme", token:, name:, password:)
+    post "/api/v1/invitation_acceptances",
+      params: {
+        invitation_acceptance: {
+          token: token,
+          name: name,
+          password: password
+        }
+      },
+      headers: account_headers(subdomain),
+      as: :json
+  end
+end
+
+class ActionDispatch::IntegrationTest
+  include ApiTestHelper
+end
