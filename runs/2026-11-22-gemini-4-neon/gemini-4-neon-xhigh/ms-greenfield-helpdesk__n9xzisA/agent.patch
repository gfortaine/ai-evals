+      end
+      assert_response :unprocessable_content, "Expected 422 for target_id=#{bad_target.inspect}"
+      assert json_body.dig("errors", "target_id").present?
+    end
+
+    # Malformed / empty envelopes -> 400
+    [
+      {},
+      { merge: {} },
+      { merge: "57" },
+      { merge: [ avery_t2 ] },
+      { merge: nil },
+      { merge: { target_id: avery_t2, source_comment: "plain text" } },
+      { merge: { target_id: avery_t2, target_comment: 123 } },
+      { merge: { target_id: avery_t2, source_comment: [ { body: "x" } ] } }
+    ].each do |bad_payload|
+      assert_no_difference "TicketComment.count" do
+        post "/api/v1/tickets/#{avery_t1}/merge",
+          params: bad_payload,
+          headers: account_headers("acme", token: @owner_token),
+          as: :json
+      end
+      assert_response :bad_request, "Expected 400 for payload #{bad_payload.inspect}"
+    end
