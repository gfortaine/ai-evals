+  test "assignment and group interaction rules: default group, membership validation, moving groups, clearing assignee vs group" do
+    # 1. Assigning someone WITH a default group (Sam -> default Billing) to an ungrouped ticket uses their default group
+    t1 = create_ticket(subject: "T1", body: "Body 1")
+    patch "/api/v1/tickets/#{t1}",
+      params: { ticket: { assignee_id: @sam.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @billing_id, json_body.dig("ticket", "group_id")
+    assert_equal({ "id" => @billing_id, "name" => "Billing" }, json_body.dig("ticket", "group"))
+    assert_equal @sam.id, json_body.dig("ticket", "assignee_id")
+
+    # 2. Assigning someone WITHOUT any group memberships (Jo) to an ungrouped ticket leaves group nil
+    t2 = create_ticket(subject: "T2", body: "Body 2")
+    patch "/api/v1/tickets/#{t2}",
+      params: { ticket: { assignee_id: @owner.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "group")
+    assert_equal @owner.id, json_body.dig("ticket", "assignee_id")
+
+    # 3. Reassigning ungrouped ticket from Jo (no groups) to Morgan (default Tech) sets Tech group!
+    patch "/api/v1/tickets/#{t2}",
+      params: { ticket: { assignee_id: @morgan.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @tech_id, json_body.dig("ticket", "group_id")
+    assert_equal @morgan.id, json_body.dig("ticket", "assignee_id")
+
+    # 4. Assigning Sam to T2 (already in Tech Support, which is NOT Sam's default, but Sam IS a member)
+    #    succeeds and keeps T2 in Tech Support!
+    patch "/api/v1/tickets/#{t2}",
+      params: { ticket: { assignee_id: @sam.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @tech_id, json_body.dig("ticket", "group_id")
+    assert_equal @sam.id, json_body.dig("ticket", "assignee_id")
+
+    # 5. Assigning Morgan (only in Tech) or Jo (no groups) to T1 (in Billing) fails with 422 atomically!
+    [ @morgan.id, @owner.id ].each do |non_member_id|
+      assert_no_difference "TicketComment.count" do
+        patch "/api/v1/tickets/#{t1}",
+          params: { ticket: { assignee_id: non_member_id, status: "solved", comment: { body: "Should not save" } } },
+          headers: account_headers("acme", token: @owner_token),
+          as: :json
+      end
+      assert_response :unprocessable_content
+      assert json_body.dig("errors", "assignee_id").present?
+      assert_equal "open", Ticket.find(t1).status
+      assert_equal @sam.id, Ticket.find(t1).assignee_id
+      assert_equal @billing_id, Ticket.find(t1).group_id
+    end
+
+    # 6. Moving T1 from Billing to Tech Support KEEPS Sam (because Sam belongs to Tech Support too!)
+    patch "/api/v1/tickets/#{t1}",
+      params: { ticket: { group_id: @tech_id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @tech_id, json_body.dig("ticket", "group_id")
+    assert_equal @sam.id, json_body.dig("ticket", "assignee_id")
+
+    # 7. Moving T1 from Tech Support to Sales CLEARS Sam (because Sam does NOT belong to Sales!)
+    patch "/api/v1/tickets/#{t1}",
+      params: { ticket: { group_id: @sales_id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @sales_id, json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+
+    # 8. Clearing assignee on T2 (Tech, Sam) leaves Tech group in place
+    patch "/api/v1/tickets/#{t2}",
+      params: { ticket: { assignee_id: nil } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @tech_id, json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "assignee_id")
+
+    # 9. Reassign Morgan to T2, then explicitly clear group_id: nil -> ALSO clears assignee!
+    patch "/api/v1/tickets/#{t2}",
+      params: { ticket: { assignee_id: @morgan.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @tech_id, json_body.dig("ticket", "group_id")
+    assert_equal @morgan.id, json_body.dig("ticket", "assignee_id")
+
+    patch "/api/v1/tickets/#{t2}",
+      params: { ticket: { group_id: nil } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "group")
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+
+    # Explicitly clearing group on an ungrouped ticket assigned to Jo (no groups) ALSO clears Jo!
+    patch "/api/v1/tickets/#{t2}",
+      params: { ticket: { assignee_id: @owner.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_equal @owner.id, json_body.dig("ticket", "assignee_id")
+
+    patch "/api/v1/tickets/#{t2}",
+      params: { ticket: { group_id: nil } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "assignee_id")
+
+    # 10. Simultaneous group_id + assignee_id updates:
+    # 10a: Move T1 (Sales, nil) to Tech + Morgan atomically
+    patch "/api/v1/tickets/#{t1}",
+      params: { ticket: { group_id: @tech_id, assignee_id: @morgan.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @tech_id, json_body.dig("ticket", "group_id")
+    assert_equal @morgan.id, json_body.dig("ticket", "assignee_id")
+
+    # 10b: Move T1 to Billing + Sam atomically
+    patch "/api/v1/tickets/#{t1}",
+      params: { ticket: { group_id: @billing_id, assignee_id: @sam.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @billing_id, json_body.dig("ticket", "group_id")
+    assert_equal @sam.id, json_body.dig("ticket", "assignee_id")
+
+    # 10c: Incompatible group_id + assignee_id fails atomically (neither group nor assignee changes!)
+    patch "/api/v1/tickets/#{t1}",
+      params: { ticket: { group_id: @billing_id, assignee_id: @morgan.id, priority: "high" } },
+      headers: account_headers("acme", token: @owner_token),
