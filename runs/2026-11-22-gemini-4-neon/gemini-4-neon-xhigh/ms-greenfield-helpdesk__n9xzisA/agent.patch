@@ -0,0 +1,53 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class UserTest < ActiveSupport::TestCase
+  test "allows same email across different accounts but rejects duplicate in same account" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    globex = Account.create!(name: "Globex", subdomain: "globex")
+
+    u1 = acme.users.create!(name: "Jo", email: "Jo@Shared.Test", password: "my-first-password", role: "admin")
+    assert_equal "jo@shared.test", u1.email
+
+    u2 = globex.users.create!(name: "Jo", email: "jo@shared.test", password: "other-password", role: "admin")
+    assert u2.persisted?
+
+    dup = acme.users.build(name: "Other Jo", email: "JO@SHARED.TEST", password: "another-password", role: "customer")
+    assert_not dup.valid?
+    assert_includes dup.errors[:email], "has already been taken"
+  end
+
+  test "enforces minimum password length" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    user = acme.users.build(name: "Jo", email: "jo@acme.test", password: "short", role: "admin")
+    assert_not user.valid?
+    assert user.errors[:password].any?
+  end
+
+  test "suspend revokes sessions and clears ticket assignments without changing public_updated_at" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    admin = acme.users.create!(name: "Jo", email: "jo@acme.test", password: "admin-password", role: "admin", email_verified_at: Time.current)
+    agent = acme.users.create!(name: "Sam", email: "sam@acme.test", password: "agent-password", role: "agent", email_verified_at: Time.current)
+    customer = acme.users.create!(name: "Avery", email: "avery@example.test", password: "customer-password", role: "customer", email_verified_at: Time.current)
+
+    Session.issue_for(admin)
+    Session.issue_for(agent)
+    ticket = acme.tickets.create!(requester: customer, assignee: agent, subject: "Help")
+    original_public_updated_at = ticket.public_updated_at
+
+    travel 10.minutes do
+      agent.suspend!
+    end
+
+    assert agent.reload.suspended?
+    assert_equal 0, agent.sessions.count
+    assert_equal 1, admin.sessions.count
+    assert_nil ticket.reload.assignee_id
+    assert_equal original_public_updated_at, ticket.public_updated_at
+
+    agent.unsuspend!
+    assert_not agent.reload.suspended?
+    assert agent.active?
+  end
+end
