@@ -0,0 +1,297 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class TicketTest < ActiveSupport::TestCase
+  setup do
+    @acme = Account.create!(name: "Acme", subdomain: "acme")
+    @globex = Account.create!(name: "Globex", subdomain: "globex")
+
+    @customer = @acme.users.create!(
+      name: "Avery",
+      email: "avery@example.test",
+      password: "customer-password",
+      role: "customer",
+      email_verified_at: Time.current
+    )
+    @staff = @acme.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "staff-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    @agent = @acme.users.create!(
+      name: "Sam",
+      email: "sam@acme.test",
+      password: "agent-password",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+    @acme.update!(owner: @staff)
+
+    @other_user = @globex.users.create!(
+      name: "Other",
+      email: "other@globex.test",
+      password: "other-password",
+      role: "customer",
+      email_verified_at: Time.current
+    )
+    @other_staff = @globex.users.create!(
+      name: "Other Staff",
+      email: "staff@globex.test",
+      password: "other-password",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+  end
+
+  test "validates subject, status, priority, same-account requester, and active staff assignee" do
+    ticket = @acme.tickets.build(requester: @customer, assignee: @agent, subject: "  Receipt issue  ")
+    assert ticket.valid?
+    assert_equal "open", ticket.status
+    assert_equal "normal", ticket.priority
+    assert ticket.normal_priority?
+    assert_not ticket.high_priority?
+    assert_equal "Receipt issue", ticket.subject
+
+    high_ticket = @acme.tickets.build(requester: @customer, subject: "Urgent", priority: "high")
+    assert high_ticket.valid?
+    assert high_ticket.high_priority?
+    assert_not high_ticket.normal_priority?
+
+    [ "urgent", "low", "HIGH", "", nil ].each do |bad_priority|
+      invalid_priority = @acme.tickets.build(requester: @customer, subject: "Help", priority: bad_priority)
+      assert_not invalid_priority.valid?, "Expected priority=#{bad_priority.inspect} to be invalid"
+      assert invalid_priority.errors[:priority].any?
+    end
+
+    blank_subject = @acme.tickets.build(requester: @customer, subject: "   ")
+    assert_not blank_subject.valid?
+    assert blank_subject.errors[:subject].any?
+
+    invalid_status = @acme.tickets.build(requester: @customer, subject: "Help", status: "archived")
+    assert_not invalid_status.valid?
+    assert invalid_status.errors[:status].any?
+
+    cross_account = @acme.tickets.build(requester: @other_user, subject: "Cross tenant")
+    assert_not cross_account.valid?
+    assert cross_account.errors[:requester].any?
+
+    customer_assignee = @acme.tickets.build(requester: @customer, assignee: @customer, subject: "Bad assignee")
+    assert_not customer_assignee.valid?
+    assert customer_assignee.errors[:assignee_id].any?
+
+    cross_staff_assignee = @acme.tickets.build(requester: @customer, assignee: @other_staff, subject: "Cross assignee")
+    assert_not cross_staff_assignee.valid?
+    assert cross_staff_assignee.errors[:assignee_id].any?
+
+    @agent.suspend!
+    suspended_assignee = @acme.tickets.build(requester: @customer, assignee: @agent, subject: "Suspended assignee")
+    assert_not suspended_assignee.valid?
+    assert suspended_assignee.errors[:assignee_id].any?
+  end
+
+  test "ticket comment validates body and same-account associations and tracks public vs internal activity" do
+    ticket = @acme.tickets.create!(requester: @customer, subject: "Need help")
+
+    blank_comment = TicketComment.new(account: @acme, ticket: ticket, author: @customer, body: "   ")
+    assert_not blank_comment.valid?
+    assert blank_comment.errors[:body].any?
+
+    cross_author = TicketComment.new(account: @acme, ticket: ticket, author: @other_user, body: "Hi")
+    assert_not cross_author.valid?
+    assert cross_author.errors[:author].any?
+
+    cross_account = TicketComment.new(account: @globex, ticket: ticket, author: @other_user, body: "Hi")
+    assert_not cross_account.valid?
+    assert cross_account.errors[:ticket].any?
+
+    original_updated_at = ticket.updated_at
+    original_public_updated_at = ticket.public_updated_at
+
+    # Public comment touches both updated_at and public_updated_at
+    travel 5.minutes do
+      comment = TicketComment.create!(account: @acme, ticket: ticket, author: @staff, body: "Looking into it")
+      assert_equal true, comment.public
+      ticket.reload
+      assert_operator ticket.updated_at, :>, original_updated_at
+      assert_operator ticket.public_updated_at, :>, original_public_updated_at
+    end
+
+    after_public_updated_at = ticket.updated_at
+    after_public_public_updated_at = ticket.public_updated_at
+
+    # Private note touches updated_at only, NOT public_updated_at
+    travel 10.minutes do
+      note = TicketComment.create!(account: @acme, ticket: ticket, author: @staff, body: "Internal check", public: false)
+      assert_equal false, note.public
+      ticket.reload
+      assert_operator ticket.updated_at, :>, after_public_updated_at
+      assert_equal after_public_public_updated_at, ticket.public_updated_at
+    end
+
+    # Assignment change touches updated_at only, NOT public_updated_at
+    travel 15.minutes do
+      ticket.update!(assignee: @agent)
+      ticket.reload
+      assert_equal after_public_public_updated_at, ticket.public_updated_at
+    end
+
+    # Priority change touches updated_at only, NOT public_updated_at
+    after_assign_updated_at = ticket.updated_at
+    travel 20.minutes do
+      ticket.update!(priority: "high")
+      ticket.reload
+      assert_operator ticket.updated_at, :>, after_assign_updated_at
+      assert_equal after_public_public_updated_at, ticket.public_updated_at
+    end
+  end
+
+  test "search_text matches subjects and public comments literally and case-insensitively" do
+    t_literal = @acme.tickets.create!(requester: @customer, subject: "100% refund for err_500")
+    TicketComment.create!(account: @acme, ticket: t_literal, author: @customer, body: 'Path C:\Users\Avery failed with (a|b).*')
+
+    t_non_literal = @acme.tickets.create!(requester: @customer, subject: "1000 refund for errX500")
+    TicketComment.create!(account: @acme, ticket: t_non_literal, author: @customer, body: "Path C:UsersAvery failed with a")
+    TicketComment.create!(account: @acme, ticket: t_non_literal, author: @staff, body: "Secret 100% private note", public: false)
+
+    t_other = @globex.tickets.create!(requester: @other_user, subject: "100% Globex refund")
+
+    assert_equal [ t_literal.id ], @acme.tickets.search_text("100%").pluck(:id)
+    assert_equal [ t_literal.id ], @acme.tickets.search_text("ERR_500").pluck(:id)
+    assert_equal [ t_literal.id ], @acme.tickets.search_text('c:\users').pluck(:id)
+    assert_equal [ t_literal.id ], @acme.tickets.search_text("(A|B).*").pluck(:id)
+    assert_equal [], @acme.tickets.search_text("Secret").pluck(:id)
+    assert_equal [], @acme.tickets.search_text("foo\x00bar").pluck(:id)
+    assert_equal [], @acme.tickets.search_text("\xFF\xFE".dup.force_encoding("UTF-8")).pluck(:id)
+    assert_equal [ t_literal.id, t_non_literal.id ].sort, @acme.tickets.search_text("   ").pluck(:id).sort
+    assert_not_includes @acme.tickets.search_text("100%").pluck(:id), t_other.id
+  end
+
+  test "purging an expired cancelled account also deletes its tickets and comments" do
+    ticket = @acme.tickets.create!(requester: @customer, subject: "Receipt issue")
+    comment = TicketComment.create!(account: @acme, ticket: ticket, author: @customer, body: "Cannot download")
+
+    @acme.update!(cancelled_at: 91.days.ago)
+
+    purged = Account.purge_expired_cancelled!
+    assert_equal 1, purged
+    assert_not Account.exists?(@acme.id)
+    assert_not Ticket.exists?(ticket.id)
+    assert_not TicketComment.exists?(comment.id)
+  end
+
+  test "supports closed status, merged_into validations, closed immutability, and safe account/user deletion of merge chains" do
+    t1 = @acme.tickets.create!(requester: @customer, subject: "First")
+    t2 = @acme.tickets.create!(requester: @customer, subject: "Second")
+    t3 = @acme.tickets.create!(requester: @customer, subject: "Third")
+    other_customer = @acme.users.create!(
+      name: "Other Customer",
+      email: "other-cust@example.test",
+      password: "password123",
+      role: "customer",
+      email_verified_at: Time.current
+    )
+    t_other_customer = @acme.tickets.create!(requester: other_customer, subject: "Other customer ticket")
+    t_other_account = @globex.tickets.create!(requester: @other_user, subject: "Globex ticket")
+
+    assert_not t1.closed?
+    assert_not t1.merged?
+    assert_nil t1.merged_into_id
+
+    # Cannot set merged_into_id without closing
+    t1.merged_into = t2
+    assert_not t1.valid?
+    assert t1.errors[:status].any?
+    t1.reload
+
+    # Cannot merge into self
+    t1.status = "closed"
+    t1.merged_into = t1
+    assert_not t1.valid?
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Cannot merge into another account's ticket
+    t1.status = "closed"
+    t1.merged_into = t_other_account
+    assert_not t1.valid?
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Cannot merge into another requester's ticket
+    t1.status = "closed"
+    t1.merged_into = t_other_customer
+    assert_not t1.valid?
+    assert t1.errors[:merged_into_id].any?
+    t1.reload
+
+    # Valid merge t1 -> t2
+    t1.update!(status: "closed", merged_into: t2)
+    assert t1.closed?
+    assert t1.merged?
+    assert_equal t2.id, t1.merged_into_id
+    assert_equal [ t1.id ], t2.merged_tickets.pluck(:id)
+
+    # Closed ticket rejects further model edits
+    assert_not t1.update(priority: "high")
+    assert t1.errors[:status].any?
+    assert_equal "normal", t1.reload.priority
+
+    # Closed ticket rejects new comments unless allow_closed_ticket is explicitly set
+    blocked_comment = TicketComment.new(account: @acme, ticket: t1, author: @staff, body: "Nope")
+    assert_not blocked_comment.valid?
+    assert blocked_comment.errors[:ticket].any?
+
+    allowed_comment = TicketComment.create!(
+      account: @acme,
+      ticket: t1,
+      author: @staff,
+      body: "Allowed merge note",
+      public: false,
+      allow_closed_ticket: true
+    )
+    assert allowed_comment.persisted?
+
+    # Cannot merge another ticket into closed t1
+    t3.status = "closed"
+    t3.merged_into = t1
+    assert_not t3.valid?
+    assert t3.errors[:merged_into_id].any?
+    t3.reload
+
+    # Chained merge t2 -> t3 preserves t1 -> t2
+    t2.update!(status: "closed", merged_into: t3)
+    assert_equal t2.id, t1.reload.merged_into_id
+    assert_equal t3.id, t2.reload.merged_into_id
+    assert_nil t3.reload.merged_into_id
+
+    # DB check constraint blocks self-reference even via update_all
+    assert_raises(ActiveRecord::StatementInvalid) do
+      ActiveRecord::Base.transaction(requires_new: true) do
+        Ticket.where(id: t3.id).update_all(merged_into_id: t3.id)
+      end
+    end
+
+    # Purging a cancelled account with chained merges succeeds cleanly
+    @acme.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_expired_cancelled!
+    assert_not Ticket.exists?(t1.id)
+    assert_not Ticket.exists?(t2.id)
+    assert_not Ticket.exists?(t3.id)
+  end
+
+  test "destroying a user with chained merged tickets succeeds cleanly" do
+    t1 = @acme.tickets.create!(requester: @customer, subject: "Chain 1")
+    t2 = @acme.tickets.create!(requester: @customer, subject: "Chain 2")
+    t3 = @acme.tickets.create!(requester: @customer, subject: "Chain 3")
+    t1.update!(status: "closed", merged_into: t2)
+    t2.update!(status: "closed", merged_into: t3)
+
+    @customer.destroy!
+    assert_not Ticket.exists?(t1.id)
+    assert_not Ticket.exists?(t2.id)
+    assert_not Ticket.exists?(t3.id)
+  end
+end
