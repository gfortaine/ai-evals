+# frozen_string_literal: true
+
+require "test_helper"
+
+class MultiTenancyAndCorsTest < ActionDispatch::IntegrationTest
+  test "same email can belong to multiple businesses with complete tenant isolation" do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo Acme", email: "jo@shared.test", password: "acme-password")
+    assert_response :created
+    acme_verify_token = extract_query_params(extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email"))["token"]
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Jo Globex", email: "jo@shared.test", password: "globex-password")
+    assert_response :created
+    globex_verify_token = extract_query_params(extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email"))["token"]
+
+    # Acme verification token fails under Globex header
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: acme_verify_token } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Confirm both in their respective accounts
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: acme_verify_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: globex_verify_token } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :ok
+
+    acme_token = sign_in_via_api(subdomain: "acme", email: "jo@shared.test", password: "acme-password")
+    globex_token = sign_in_via_api(subdomain: "globex", email: "jo@shared.test", password: "globex-password")
+
+    # Acme session token cannot access Globex
+    get "/api/v1/me", headers: account_headers("globex", token: acme_token)
+    assert_response :unauthorized
+
+    get "/api/v1/account", headers: account_headers("globex", token: acme_token)
+    assert_response :unauthorized
+
+    # Globex password does not work in Acme
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@shared.test", password: "globex-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    # Password reset token for Acme cannot be used under Globex
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@shared.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    acme_reset_token = extract_query_params(extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password"))["token"]
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: acme_reset_token, password: "new-globex-password" } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Changing password in Acme revokes Acme session but NOT Globex session
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "acme-password", password: "acme-new-password" } },
+      headers: account_headers("acme", token: acme_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("acme", token: acme_token)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: account_headers("globex", token: globex_token)
+    assert_response :ok
+    assert_equal "Jo Globex", json_body.dig("user", "name")
+  end
+
+  test "CORS allows requests from configured frontend origin and rejects other origins" do
+    create_account_via_api
+    assert_response :created
+
+    with_env(HELPDESK_FRONTEND_URL: nil) do
+      # Preflight from default origin
+      options "/api/v1/sessions",
+        headers: {
+          "Origin" => "http://localhost:3001",
+          "Access-Control-Request-Method" => "POST",
+          "Access-Control-Request-Headers" => "Content-Type, X-Helpdesk-Account, Authorization"
+        }
+      assert_response :ok
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+      assert_includes response.headers["Access-Control-Allow-Methods"], "POST"
+      assert_includes response.headers["Access-Control-Allow-Headers"], "X-Helpdesk-Account"
+      assert_includes response.headers["Access-Control-Allow-Headers"], "Authorization"
+
+      # Actual request from default origin
+      get "/api/v1/portal", headers: account_headers("acme", extra: { "Origin" => "http://localhost:3001" })
+      assert_response :ok
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+      # Request from disallowed origin
+      get "/api/v1/portal", headers: account_headers("acme", extra: { "Origin" => "http://evil.test" })
+      assert_response :ok
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+    end
+
+    with_env(HELPDESK_FRONTEND_URL: "https://frontend.example.com/subpath") do
+      get "/api/v1/portal", headers: account_headers("acme", extra: { "Origin" => "https://frontend.example.com" })
+      assert_response :ok
+      assert_equal "https://frontend.example.com", response.headers["Access-Control-Allow-Origin"]
+
+      # Old default origin is now disallowed
+      get "/api/v1/portal", headers: account_headers("acme", extra: { "Origin" => "http://localhost:3001" })
+      assert_response :ok
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+end
