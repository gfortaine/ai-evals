+
+  test "enforces authorization, tenant isolation, same-requester rule, validation, and atomicity on merge" do
+    avery_t1 = create_request(token: @avery_token, subject: "Avery 1", body: "A1")
+    avery_t2 = create_request(token: @avery_token, subject: "Avery 2", body: "A2")
+    blake_t1 = create_request(token: @blake_token, subject: "Blake 1", body: "B1")
+    globex_t1 = create_request(token: @globex_avery_token, subject: "Globex Avery", body: "G1", subdomain: "globex")
+
+    # Unauthenticated -> 401
+    post "/api/v1/tickets/#{avery_t1}/merge",
+      params: { merge: { target_id: avery_t2 } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    # Customer -> 403
