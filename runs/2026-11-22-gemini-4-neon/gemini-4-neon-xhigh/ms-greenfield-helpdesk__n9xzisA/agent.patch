+    assert_equal [ "sam@example.test" ], mail.to
+    link = extract_link_from_mail(mail, path: "/accept-invitation")
+    query = extract_query_params(link)
+    assert_equal "acme", query["account"]
+    sam_token = query["token"]
+    assert_not_empty sam_token
