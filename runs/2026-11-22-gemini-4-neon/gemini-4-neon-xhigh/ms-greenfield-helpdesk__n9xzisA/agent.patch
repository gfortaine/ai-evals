+# frozen_string_literal: true
+
+require "test_helper"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "owner-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @owner = @acme.users.find_by!(email: "jo@acme.test")
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "owner-password")
+
+    @agent = User.create!(
+      account: @acme,
+      name: "Sam",
+      email: "sam@acme.test",
+      password: "agent-password",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+    @agent_token = sign_in_via_api(subdomain: "acme", email: "sam@acme.test", password: "agent-password")
+
+    @avery = User.create!(
+      account: @acme,
+      name: "Avery",
+      email: "avery@example.test",
+      password: "avery-password",
+      role: "customer",
+      email_verified_at: Time.current
+    )
+    @avery_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "avery-password")
+
+    @blake = User.create!(
+      account: @acme,
+      name: "Blake",
+      email: "blake@example.test",
+      password: "blake-password",
+      role: "customer",
+      email_verified_at: Time.current
+    )
+    @blake_token = sign_in_via_api(subdomain: "acme", email: "blake@example.test", password: "blake-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Hank", email: "hank@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex = Account.find_by!(subdomain: "globex")
+    @globex_token = sign_in_via_api(subdomain: "globex", email: "hank@globex.test", password: "globex-password")
+  end
+
+  def create_ticket_as(token, subject:, body:, at:, subdomain: "acme")
+    travel_to at do
+      post "/api/v1/requests",
+        params: { request: { subject: subject, comment: { body: body } } },
+        headers: account_headers(subdomain, token: token),
+        as: :json
+      assert_response :created
+      json_body.dig("request", "id")
+    end
+  end
+
+  def collect_forward_ids(initial_path, collection_key:, headers:)
+    ids = []
+    pages = []
+    url = initial_path
+
+    loop do
+      get url, headers: headers
+      assert_response :ok
+      assert_equal [ collection_key, "meta", "links" ].sort, json_body.keys.sort
+
+      page_ids = json_body[collection_key].map { |item| item["id"] }
+      ids.concat(page_ids)
+      pages << json_body
+
+      if json_body.dig("meta", "has_more")
+        assert_not_nil json_body.dig("links", "next")
+        url = json_body.dig("links", "next")
+      else
+        assert_nil json_body.dig("links", "next")
+        break
+      end
+    end
+
+    [ ids, pages ]
+  end
+
+  def collect_backward_pages(start_prev_url, collection_key:, headers:)
+    pages = []
+    url = start_prev_url
+
+    while url
+      get url, headers: headers
+      assert_response :ok
+      assert_equal [ collection_key, "meta", "links" ].sort, json_body.keys.sort
+      pages << json_body
+
+      if json_body.dig("meta", "has_more")
+        assert_not_nil json_body.dig("links", "prev")
+        url = json_body.dig("links", "prev")
+      else
+        assert_nil json_body.dig("links", "prev")
+        url = nil
+      end
+    end
+
+    pages
+  end
+
+  def capture_sql
+    queries = []
+    callback = lambda do |_name, _started, _finished, _unique_id, payload|
+      next if payload[:name] == "SCHEMA" || payload[:cached]
+      queries << payload[:sql]
+    end
+    ActiveSupport::Notifications.subscribed(callback, "sql.active_record") { yield }
+    queries
+  end
+
+  test "empty cursor response matches exact contract and omits offset metadata" do
+    get "/api/v1/tickets?page[size]=25&status=open",
+      headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal(
+      {
+        "tickets" => [],
+        "meta" => {
+          "has_more" => false,
+          "after_cursor" => nil,
+          "before_cursor" => nil
+        },
+        "links" => {
+          "next" => nil,
+          "prev" => nil
+        }
+      },
+      json_body
+    )
+  end
+
+  test "forward and backward navigation via links and manual cursors on tickets with filters and page size changes" do
+    base_time = Time.utc(2026, 11, 20, 10, 0, 0)
+    open_ids = (1..5).map do |i|
+      create_ticket_as(@avery_token, subject: "Billing & 50% issue #{i}", body: "Details #{i}", at: base_time + i.minutes)
+    end
+    closed_id = create_ticket_as(@avery_token, subject: "Billing & 50% closed", body: "Done", at: base_time + 10.minutes)
+    patch "/api/v1/tickets/#{closed_id}",
+      params: { ticket: { status: "solved" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+
+    # Expected order for open tickets: newest updated_at first -> [5, 4, 3, 2, 1]
+    expected_ids = open_ids.reverse
+    headers = account_headers("acme", token: @owner_token)
+
+    # Walk forward via links.next with status + special-character q filter
+    forward_ids, forward_pages = collect_forward_ids(
+      "/api/v1/tickets?page[size]=2&status=open&q=#{URI.encode_www_form_component('Billing & 50%')}",
+      collection_key: "tickets",
+      headers: headers
+    )
+    assert_equal expected_ids, forward_ids
+    assert_equal 3, forward_pages.size
+
+    # Verify Page 1 shape
+    p1 = forward_pages[0]
+    assert_equal expected_ids[0..1], p1["tickets"].map { |t| t["id"] }
+    assert_equal true, p1.dig("meta", "has_more")
+    assert_not_nil p1.dig("meta", "before_cursor")
+    assert_not_nil p1.dig("meta", "after_cursor")
+    assert_not_nil p1.dig("links", "next")
+    assert_nil p1.dig("links", "prev")
+    assert_equal @avery.email, p1["tickets"].first.dig("requester", "email")
+
+    # Verify filter params preserved in links.next
+    next_query = URI.decode_www_form(URI.parse(p1.dig("links", "next")).query).to_h
+    assert_equal "open", next_query["status"]
+    assert_equal "Billing & 50%", next_query["q"]
+    assert_equal "2", next_query["page[size]"]
+    assert_equal p1.dig("meta", "after_cursor"), next_query["page[after]"]
+    assert_nil next_query["page[before]"]
+
+    # Verify Page 2 shape
+    p2 = forward_pages[1]
+    assert_equal expected_ids[2..3], p2["tickets"].map { |t| t["id"] }
+    assert_equal true, p2.dig("meta", "has_more")
+    assert_not_nil p2.dig("links", "next")
+    assert_not_nil p2.dig("links", "prev")
+
+    # Verify Page 3 shape (last page)
+    p3 = forward_pages[2]
+    assert_equal [ expected_ids[4] ], p3["tickets"].map { |t| t["id"] }
+    assert_equal false, p3.dig("meta", "has_more")
+    assert_not_nil p3.dig("meta", "before_cursor")
+    assert_not_nil p3.dig("meta", "after_cursor")
+    assert_nil p3.dig("links", "next")
+    assert_not_nil p3.dig("links", "prev")
+
+    # Walk backward from Page 3 via links.prev
+    backward_pages = collect_backward_pages(p3.dig("links", "prev"), collection_key: "tickets", headers: headers)
+    assert_equal 2, backward_pages.size
+
+    # First backward page is Page 2 (records in canonical DESC order!)
+    assert_equal expected_ids[2..3], backward_pages[0]["tickets"].map { |t| t["id"] }
+    assert_equal true, backward_pages[0].dig("meta", "has_more")
+    assert_not_nil backward_pages[0].dig("links", "prev")
+    assert_not_nil backward_pages[0].dig("links", "next")
+
+    # Second backward page is Page 1 (has_more: false in backward direction, links.prev: nil, links.next: present!)
+    assert_equal expected_ids[0..1], backward_pages[1]["tickets"].map { |t| t["id"] }
+    assert_equal false, backward_pages[1].dig("meta", "has_more")
+    assert_nil backward_pages[1].dig("links", "prev")
+    assert_not_nil backward_pages[1].dig("links", "next")
+
+    # Manual navigation with page[after] + changed page[size]
+    get "/api/v1/tickets",
+      params: { status: "open", page: { after: p1.dig("meta", "after_cursor"), size: 3 } },
+      headers: headers
+    assert_response :ok
+    assert_equal expected_ids[2..4], json_body["tickets"].map { |t| t["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_nil json_body.dig("links", "next")
+    assert_not_nil json_body.dig("links", "prev")
+
+    # Manual navigation with page[before] and omitted page[size] (defaults to 25)
+    get "/api/v1/tickets",
+      params: { status: "open", page: { before: p3.dig("meta", "before_cursor") } },
+      headers: headers
+    assert_response :ok
+    assert_equal expected_ids[0..3], json_body["tickets"].map { |t| t["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_nil json_body.dig("links", "prev")
+    next_q = URI.decode_www_form(URI.parse(json_body.dig("links", "next")).query).to_h
+    assert_equal "25", next_q["page[size]"]
+
+    # Manual stepping past end / before start returns clean empty page
+    get "/api/v1/tickets",
+      params: { status: "open", page: { after: p3.dig("meta", "after_cursor"), size: 2 } },
+      headers: headers
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+    assert_equal({ "has_more" => false, "after_cursor" => nil, "before_cursor" => nil }, json_body["meta"])
+    assert_equal({ "next" => nil, "prev" => nil }, json_body["links"])
+
+    get "/api/v1/tickets",
+      params: { status: "open", page: { before: p1.dig("meta", "before_cursor"), size: 2 } },
+      headers: headers
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+    assert_equal({ "has_more" => false, "after_cursor" => nil, "before_cursor" => nil }, json_body["meta"])
+    assert_equal({ "next" => nil, "prev" => nil }, json_body["links"])
+
+    # Single-page populated result has cursors but null next/prev links
+    get "/api/v1/tickets?page[size]=25&status=open", headers: headers
+    assert_response :ok
+    assert_equal expected_ids, json_body["tickets"].map { |t| t["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_not_nil json_body.dig("meta", "before_cursor")
+    assert_not_nil json_body.dig("meta", "after_cursor")
+    assert_nil json_body.dig("links", "next")
+    assert_nil json_body.dig("links", "prev")
+  end
+
+  test "exact multiple of page size does not produce false has_more or extra empty page" do
+    base_time = Time.utc(2026, 11, 20, 11, 0, 0)
+    ids = (1..4).map do |i|
+      create_ticket_as(@avery_token, subject: "Exact #{i}", body: "Body #{i}", at: base_time + i.minutes)
+    end
+    headers = account_headers("acme", token: @owner_token)
+
+    forward_ids, pages = collect_forward_ids("/api/v1/tickets?page[size]=2", collection_key: "tickets", headers: headers)
+    assert_equal ids.reverse, forward_ids
