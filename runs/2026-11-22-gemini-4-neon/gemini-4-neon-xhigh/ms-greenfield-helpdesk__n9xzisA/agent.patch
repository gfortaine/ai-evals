diff --git a/test/integration/account_lifecycle_test.rb b/test/integration/account_lifecycle_test.rb
new file mode 100644
index 0000000..e3c9206
--- /dev/null
+++ b/test/integration/account_lifecycle_test.rb
@@ -0,0 +1,148 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class AccountLifecycleTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api
+    verify_last_email!(subdomain: "acme")
+    @account = Account.find_by!(subdomain: "acme")
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    @agent = @account.users.create!(
+      name: "Alex Agent",
+      email: "alex@acme.test",
+      password: "agent-password",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+    @agent_token = sign_in_via_api(subdomain: "acme", email: "alex@acme.test", password: "agent-password")
+  end
+
+  test "non-owner cannot cancel account" do
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: @agent_token)
+    assert_response :forbidden
+    assert @account.reload.active?
+  end
+
+  test "owner can cancel account, revoking sessions and stopping ordinary access, and reactivate within 90 days" do
+    # Cancel account
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal "cancelled", json_body.dig("account", "status")
+    assert_not_nil json_body.dig("account", "cancelled_at")
+
+    # All existing sessions (owner + agent) are revoked
+    get "/api/v1/me", headers: account_headers("acme", token: @owner_token)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: account_headers("acme", token: @agent_token)
+    assert_response :unauthorized
+
+    get "/api/v1/account", headers: account_headers("acme", token: @owner_token)
+    assert_response :unauthorized
+
+    # Public portal and ordinary unauthenticated flows are stopped
+    get "/api/v1/portal", headers: account_headers("acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json_body["code"]
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Non-owner cannot sign in while cancelled
+    post "/api/v1/sessions",
+      params: { session: { email: "alex@acme.test", password: "agent-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+    assert_equal "account_cancelled", json_body["code"]
+
+    # Owner CAN sign in while cancelled
+    owner_cancelled_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    assert_equal "cancelled", json_body.dig("account", "status")
+
+    # Even with owner's session, ordinary business access is still blocked until reactivated
+    get "/api/v1/account", headers: account_headers("acme", token: owner_cancelled_token)
+    assert_response :forbidden
+
+    get "/api/v1/me", headers: account_headers("acme", token: owner_cancelled_token)
+    assert_response :forbidden
+
+    patch "/api/v1/me",
+      params: { user: { name: "Blocked Update" } },
+      headers: account_headers("acme", token: owner_cancelled_token),
+      as: :json
+    assert_response :forbidden
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "blocked-new-password" } },
+      headers: account_headers("acme", token: owner_cancelled_token),
+      as: :json
+    assert_response :forbidden
+
+    # Cancelling again returns 422 and does NOT reset cancelled_at
+    original_cancelled_at = @account.reload.cancelled_at
+    travel 10.days do
+      post "/api/v1/account/cancel", headers: account_headers("acme", token: owner_cancelled_token)
+      assert_response :unprocessable_content
+      assert_equal original_cancelled_at.to_i, @account.reload.cancelled_at.to_i
+    end
+
+    # Owner can sign out while cancelled
+    delete "/api/v1/session", headers: account_headers("acme", token: owner_cancelled_token)
+    assert_response :no_content
+
+    # Owner signs in again at day 89 and reactivates
+    travel 89.days do
+      reactivate_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+      post "/api/v1/account/reactivate", headers: account_headers("acme", token: reactivate_token)
+      assert_response :ok
+      assert_equal "active", json_body.dig("account", "status")
+      assert_nil json_body.dig("account", "cancelled_at")
+
+      # Reactivating an already active account returns 422
+      post "/api/v1/account/reactivate", headers: account_headers("acme", token: reactivate_token)
+      assert_response :unprocessable_content
+
+      # Ordinary business access is restored!
+      get "/api/v1/portal", headers: account_headers("acme")
+      assert_response :ok
+
+      get "/api/v1/account", headers: account_headers("acme", token: reactivate_token)
+      assert_response :ok
+
+      get "/api/v1/me", headers: account_headers("acme", token: reactivate_token)
+      assert_response :ok
+
+      # Non-owner can sign in again
+      new_agent_token = sign_in_via_api(subdomain: "acme", email: "alex@acme.test", password: "agent-password")
+      get "/api/v1/me", headers: account_headers("acme", token: new_agent_token)
+      assert_response :ok
+    end
+  end
+
+  test "owner cannot reactivate after 90 days" do
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+
+    travel 91.days do
+      owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+      post "/api/v1/account/reactivate", headers: account_headers("acme", token: owner_token)
+      assert_response :unprocessable_content
+      assert_equal "reactivation_expired", json_body["code"]
+      assert @account.reload.cancelled?
+    end
+  end
+end
diff --git a/test/integration/authentication_and_profile_test.rb b/test/integration/authentication_and_profile_test.rb
new file mode 100644
index 0000000..540032f
--- /dev/null
+++ b/test/integration/authentication_and_profile_test.rb
@@ -0,0 +1,234 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class AuthenticationAndProfileTest < ActionDispatch::IntegrationTest
+  test "full signup, portal, verification, sign in, account, profile update, password change, and sign out flow" do
+    # 1. Signup
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      create_account_via_api
+    end
+    assert_response :created
+
+    body = json_body
+    account = body["account"]
+    user = body["user"]
+
+    assert_kind_of Integer, account["id"]
+    assert_equal "Acme", account["name"]
+    assert_equal "acme", account["subdomain"]
+    assert_equal "active", account["status"]
+    assert_equal user["id"], account["owner_id"]
+    assert_nil account["cancelled_at"]
+    assert_not_nil account["created_at"]
+    assert_not_nil account["updated_at"]
+
+    assert_kind_of Integer, user["id"]
+    assert_equal account["id"], user["account_id"]
+    assert_equal "Jo", user["name"]
+    assert_equal "jo@acme.test", user["email"]
+    assert_equal "admin", user["role"]
+    assert_equal false, user["verified"]
+    assert_nil user["email_verified_at"]
+    assert_not_nil user["created_at"]
+    assert_not_nil user["updated_at"]
+    assert_not user.key?("password_digest")
+
+    # 2. Public GET /portal works without auth
+    get "/api/v1/portal", headers: account_headers("acme")
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_body)
+
+    # GET /portal with case-insensitive header
+    get "/api/v1/portal", headers: account_headers("ACME")
+    assert_response :ok
+
+    # GET /portal with missing or unknown account
+    get "/api/v1/portal"
+    assert_response :bad_request
+
+    get "/api/v1/portal", headers: account_headers("does-not-exist")
+    assert_response :not_found
+
+    # 3. GET /account requires auth
+    get "/api/v1/account", headers: account_headers("acme")
+    assert_response :unauthorized
+
+    # 4. Cannot sign in before verifying email
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+    assert_equal "email_not_verified", json_body["code"]
+
+    # Wrong password for unverified user still returns 401 (does not leak verification state)
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "wrong-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    # 5. Verify email from outgoing Action Mailer email
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], mail.from
+    assert_equal [ "jo@acme.test" ], mail.to
+    link = extract_link_from_mail(mail, path: "/verify-email")
+    assert link.start_with?("http://localhost:3001/verify-email?")
+    query = extract_query_params(link)
+    assert_equal "acme", query["account"]
+    assert_not_empty query["token"]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: query["token"] } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+    assert_not_nil json_body.dig("user", "email_verified_at")
+
+    # Reusing verification token fails
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: query["token"] } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # 6. Sign in (two separate sessions)
+    post "/api/v1/sessions",
+      params: { session: { email: "JO@ACME.TEST", password: "my-first-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    login_body = json_body
+    token1 = login_body.dig("session", "token")
+    assert_not_empty token1
+    assert_equal "Jo", login_body.dig("user", "name")
+    assert_equal true, login_body.dig("user", "verified")
+    assert_equal "Acme", login_body.dig("account", "name")
+
+    token2 = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    assert_not_equal token1, token2
+
+    # 7. GET /account returns full account
+    get "/api/v1/account", headers: account_headers("acme", token: token1)
+    assert_response :ok
+    assert_equal account["id"], json_body.dig("account", "id")
+    assert_equal "Acme", json_body.dig("account", "name")
+    assert_equal "acme", json_body.dig("account", "subdomain")
+    assert_equal "active", json_body.dig("account", "status")
+
+    # 8. DELETE /session signs out only token1, leaving token2 active
+    delete "/api/v1/session", headers: account_headers("acme", token: token1)
+    assert_response :no_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: token1)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: account_headers("acme", token: token2)
+    assert_response :ok
+    assert_equal "Jo", json_body.dig("user", "name")
+
+    # 9. PATCH /me updates name and ignores disallowed attributes
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Smith", role: "customer", email: "hacked@acme.test" } },
+      headers: account_headers("acme", token: token2),
+      as: :json
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+    assert_equal "admin", json_body.dig("user", "role")
+    assert_equal "jo@acme.test", json_body.dig("user", "email")
+
+    # Blank name rejected
+    patch "/api/v1/me",
+      params: { user: { name: "   " } },
+      headers: account_headers("acme", token: token2),
+      as: :json
+    assert_response :unprocessable_content
+
+    # 10. PUT /me/password fails on wrong current password without revoking sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: token2),
+      as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: token2)
+    assert_response :ok
+
+    # Fails on short/blank new password without revoking sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "short" } },
+      headers: account_headers("acme", token: token2),
+      as: :json
+    assert_response :unprocessable_content
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "" } },
+      headers: account_headers("acme", token: token2),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Create a third session before changing password
+    token3 = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    # 11. PUT /me/password succeeds and signs out ALL existing sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: token2),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("acme", token: token2)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: account_headers("acme", token: token3)
+    assert_response :unauthorized
+
+    # Old password fails, new password works
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    new_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+    get "/api/v1/me", headers: account_headers("acme", token: new_token)
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+  end
+
+  test "signup validation failures roll back cleanly and send no email" do
+    # Invalid admin rolls back account creation
+    assert_no_difference [ "Account.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+      create_account_via_api(email: "not-an-email")
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "admin", "email").present?
+
+    # Duplicate subdomain fails cleanly
+    create_account_via_api(subdomain: "acme")
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+
+    assert_no_difference [ "Account.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+      create_account_via_api(subdomain: "ACME", email: "other@acme.test")
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "subdomain").present?
+  end
+
+  test "handles malformed JSON and missing envelopes gracefully" do
+    post "/api/v1/account/create",
+      params: "{invalid json",
+      headers: { "CONTENT_TYPE" => "application/json", "Accept" => "application/json" }
+    assert_response :bad_request
+    assert_equal "invalid_json", json_body["code"]
+
+    post "/api/v1/account/create",
+      params: { account: { name: "Acme", subdomain: "acme" } },
+      as: :json
+    assert_response :bad_request
+    assert_equal "parameter_missing", json_body["code"]
+  end
+end
