@@ -0,0 +1,85 @@
+# frozen_string_literal: true
+
+class Account < ApplicationRecord
+  CANCELLATION_GRACE_PERIOD = 90.days
+  SUBDOMAIN_FORMAT = /\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/
+
+  belongs_to :owner, class_name: "User", optional: true
+
+  has_many :ticket_comments, dependent: :delete_all
+  has_many :tickets, dependent: :delete_all
+  has_many :group_memberships, dependent: :delete_all
+  has_many :groups, dependent: :delete_all
+  has_many :invitations, dependent: :delete_all
+  has_many :sessions, dependent: :delete_all
+  has_many :email_verifications, dependent: :delete_all
+  has_many :password_resets, dependent: :delete_all
+  has_many :users, dependent: :destroy
+
+  before_destroy :clear_owner_reference
+
+  normalizes :name, with: ->(value) { value.to_s.strip }
+  normalizes :subdomain, with: ->(value) { value.to_s.strip.downcase }
+
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :subdomain,
+    presence: true,
+    uniqueness: { case_sensitive: false },
+    format: {
+      with: SUBDOMAIN_FORMAT,
+      message: "must contain only lowercase letters, numbers, and hyphens, and cannot start or end with a hyphen"
+    }
+
+  scope :active, -> { where(cancelled_at: nil) }
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+  scope :purgeable, -> { cancelled.where("cancelled_at < ?", CANCELLATION_GRACE_PERIOD.ago) }
+
+  def self.find_by_subdomain_header(value)
+    normalized = value.to_s.strip.downcase
+    return nil if normalized.empty?
+
+    find_by(subdomain: normalized)
+  end
+
+  def self.purge_expired_cancelled!
+    purged = 0
+    purgeable.find_each do |account|
+      account.destroy!
+      purged += 1
+    end
+    purged
+  end
+
+  def active?
+    cancelled_at.nil?
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def status
+    cancelled? ? "cancelled" : "active"
+  end
+
+  def reactivatable?
+    cancelled? && cancelled_at >= CANCELLATION_GRACE_PERIOD.ago
+  end
+
+  def cancel!
+    transaction do
+      update!(cancelled_at: Time.current)
+      sessions.delete_all
+    end
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+
+  private
+
+  def clear_owner_reference
+    update_column(:owner_id, nil) if owner_id.present?
+  end
+end
