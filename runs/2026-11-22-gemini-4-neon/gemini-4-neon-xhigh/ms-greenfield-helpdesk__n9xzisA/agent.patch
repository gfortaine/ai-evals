+      assert_response :unprocessable_content
+
+      delete "/api/v1/invitations/#{inv3_id}", headers: account_headers("acme", token: @owner_token)
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "prevents competing invitations and prevents customer registration from taking a pending invite email" do
+    # Cannot invite an already-registered customer or admin
+    assert_no_difference [ "Invitation.count", "ActionMailer::Base.deliveries.size" ] do
+      invite_staff_via_api(token: @owner_token, email: "AVERY@EXAMPLE.TEST", role: "agent")
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "email").present?
+
+    assert_no_difference [ "Invitation.count", "ActionMailer::Base.deliveries.size" ] do
+      invite_staff_via_api(token: @owner_token, email: "jo@acme.test", role: "admin")
+    end
+    assert_response :unprocessable_content
+
+    # Create pending invitation
+    invite_staff_via_api(token: @owner_token, email: "sam@example.test", role: "agent")
+    assert_response :created
+    inv_id = json_body.dig("invitation", "id")
+
+    # Competing invitation in same account fails (case-insensitive)
+    assert_no_difference [ "Invitation.count", "ActionMailer::Base.deliveries.size" ] do
+      invite_staff_via_api(token: @owner_token, email: "SAM@example.test", role: "admin")
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "email").present?
+
+    # Customer registration with pending invite email fails in Acme (no user, no email)
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      register_customer_via_api(subdomain: "acme", name: "Sneaky", email: "SAM@EXAMPLE.TEST", password: "customer-password")
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "email").present?
+
+    # Customer registration with same email SUCCEEDS in Globex (multi-tenant isolation)
+    assert_difference [ "User.count", "ActionMailer::Base.deliveries.size" ], 1 do
+      register_customer_via_api(subdomain: "globex", name: "Sam Globex", email: "sam@example.test", password: "customer-password")
+    end
+    assert_response :created
+
+    # Once revoked in Acme, customer CAN register that email in Acme
+    delete "/api/v1/invitations/#{inv_id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+
+    assert_difference "User.count", 1 do
+      register_customer_via_api(subdomain: "acme", name: "Sam Customer", email: "sam@example.test", password: "customer-password")
+    end
+    assert_response :created
+
+    # Once expired, both re-inviting and customer registration are allowed
+    invite_staff_via_api(token: @owner_token, email: "expiring@example.test", role: "agent")
+    assert_response :created
+
+    travel 8.days do
+      assert_difference "User.count", 1 do
+        register_customer_via_api(subdomain: "acme", name: "Exp Customer", email: "expiring@example.test", password: "customer-password")
+      end
+      assert_response :created
+    end
+  end
+
+  test "lists invitations by ID ascending, filters by status, enforces multi-tenancy, roles, cancelled account, and validates inputs" do
+    # Create 4 invitations in all 4 statuses
+    invite_staff_via_api(token: @owner_token, email: "expired@example.test", role: "agent")
+    expired_id = json_body.dig("invitation", "id")
+
+    travel 8.days do
+      invite_staff_via_api(token: @owner_token, email: "accepted@example.test", role: "agent")
+      accepted_id = json_body.dig("invitation", "id")
+      accepted_token = extract_last_invitation_token
+      accept_invitation_via_api(token: accepted_token, name: "Acc", password: "accepted-password")
+      assert_response :created
+
+      invite_staff_via_api(token: @owner_token, email: "revoked@example.test", role: "admin")
+      revoked_id = json_body.dig("invitation", "id")
+      delete "/api/v1/invitations/#{revoked_id}", headers: account_headers("acme", token: @owner_token)
+      assert_response :ok
+
+      invite_staff_via_api(token: @owner_token, email: "pending@example.test", role: "agent")
+      pending_id = json_body.dig("invitation", "id")
+
+      # Globex invitation must not leak into Acme's list
+      invite_staff_via_api(subdomain: "globex", token: @globex_owner_token, email: "globex@example.test", role: "agent")
+      assert_response :created
+      globex_inv_id = json_body.dig("invitation", "id")
+
+      # List all ordered by ID ascending
+      get "/api/v1/invitations", headers: account_headers("acme", token: @owner_token)
+      assert_response :ok
+      assert_equal 4, json_body["count"]
+      assert_equal [ expired_id, accepted_id, revoked_id, pending_id ], json_body["invitations"].map { |i| i["id"] }
+      assert_equal %w[expired accepted revoked pending], json_body["invitations"].map { |i| i["status"] }
+
+      # Pagination
+      get "/api/v1/invitations", params: { page: 2, per_page: 2 }, headers: account_headers("acme", token: @owner_token)
+      assert_response :ok
+      assert_equal 4, json_body["count"]
+      assert_equal [ revoked_id, pending_id ], json_body["invitations"].map { |i| i["id"] }
+      assert_equal 1, json_body["previous_page"]
+      assert_nil json_body["next_page"]
+
+      # Status filters
+      {
+        "pending" => [ pending_id ],
+        "accepted" => [ accepted_id ],
+        "revoked" => [ revoked_id ],
+        "expired" => [ expired_id ]
+      }.each do |status, expected_ids|
+        get "/api/v1/invitations", params: { status: status }, headers: account_headers("acme", token: @owner_token)
+        assert_response :ok
+        assert_equal expected_ids, json_body["invitations"].map { |i| i["id"] }, "Mismatch for status=#{status}"
+        assert_equal expected_ids.size, json_body["count"]
