+        from: "avery@example.test",
+        to: reply_addr,
+        subject: "Re: Dedup test",
+        body: "Yes, fixed!",
+        message_id: "<dup-reply-1@example.test>",
+        extra_headers: { "Received" => "from retry-relay.example.test" }
+      )
+      assert_no_difference "ticket.comments.count" do
+        post_relay(reply_raw_redelivered)
+        assert_response :no_content
+      end
+      assert_equal "solved", ticket.reload.status
+
+      # 4. Invalid deliveries MUST NOT block a later valid retry with the SAME Message-ID:
+      # 4a. Multi-business invalid -> single-business valid retry
+      assert_no_difference "Ticket.count" do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          cc: "globex@support.example.test",
+          subject: "Retry multi",
+          body: "Should fail first",
+          message_id: "<retry-multi@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      assert_difference "Ticket.count", 1 do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          subject: "Retry multi",
+          body: "Now valid",
+          message_id: "<retry-multi@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      # And a 3rd delivery with that same Message-ID is now deduplicated!
+      assert_no_difference "Ticket.count" do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          subject: "Retry multi",
+          body: "Third attempt",
+          message_id: "<retry-multi@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      # 4b. Unauthorized reply sender -> real requester retry with SAME Message-ID
+      assert_no_difference "ticket.comments.count" do
+        post_relay(build_rfc822(
+          from: "impostor@example.test",
+          to: reply_addr,
+          subject: "Re: Dedup test",
+          body: "Impostor reply",
+          message_id: "<retry-auth@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      assert_difference "ticket.comments.count", 1 do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: reply_addr,
+          subject: "Re: Dedup test",
+          body: "Legit requester retry",
+          message_id: "<retry-auth@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      # 4c. Blank body / automated header -> valid retry with SAME Message-ID
+      assert_no_difference "Ticket.count" do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          subject: "Retry blank",
+          body: "   ",
+          message_id: "<retry-blank@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      assert_difference "Ticket.count", 1 do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          subject: "Retry blank",
+          body: "Now with content",
+          message_id: "<retry-blank@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      assert_no_difference "Ticket.count" do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          subject: "Retry auto",
+          body: "Auto first",
+          message_id: "<retry-auto@example.test>",
+          extra_headers: { "Auto-Submitted" => "auto-generated" }
+        ))
+        assert_response :no_content
+      end
+
+      assert_difference "Ticket.count", 1 do
+        post_relay(build_rfc822(
+          from: "avery@example.test",
+          to: "acme@support.example.test",
+          subject: "Retry auto",
+          body: "Valid retry",
+          message_id: "<retry-auto@example.test>"
+        ))
+        assert_response :no_content
+      end
+
+      # 4d. Cancelled account -> reactivated account retry with IDENTICAL raw bytes!
+      post "/api/v1/account/cancel", headers: account_headers("acme", token: @acme_owner_token)
+      assert_response :ok
+
+      same_bytes_retry = build_rfc822(
+        from: "avery@example.test",
+        to: "acme@support.example.test",
+        subject: "Sent while cancelled",
+        body: "Retried identically after reactivation",
+        message_id: "<retry-identical-bytes@example.test>"
+      )
+
+      assert_no_difference "Ticket.count" do
+        post_relay(same_bytes_retry)
+        assert_response :no_content
+      end
+
+      # Owner signs back in and reactivates Acme
+      reactivate_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "acme-password")
+      post "/api/v1/account/reactivate", headers: account_headers("acme", token: reactivate_token)
+      assert_response :ok
+
+      assert_difference "Ticket.count", 1 do
+        post_relay(same_bytes_retry)
+        assert_response :no_content
+      end
+
+      # And exact same bytes a 3rd time is now deduplicated!
+      assert_no_difference "Ticket.count" do
+        post_relay(same_bytes_retry)
+        assert_response :no_content
+      end
+    end
+  end
+
+  test "ignores mail from suspended users and pending staff invitees" do
+    register_customer_via_api(subdomain: "acme", name: "Suspended Sam", email: "suspended@example.test", password: "sam-password")
+    verify_last_email!(subdomain: "acme")
+    suspended_user = @acme.users.find_by!(email: "suspended@example.test")
+
+    # Invite a staff member (pending invitation)
+    invite_staff_via_api(subdomain: "acme", token: @acme_owner_token, email: "invitee@acme.test", role: "agent")
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+
+    with_env(RAILS_INBOUND_EMAIL_PASSWORD: RELAY_PASSWORD) do
+      # First open a ticket before suspending
+      post_relay(build_rfc822(
+        from: "suspended@example.test",
+        to: "acme@support.example.test",
+        subject: "Before suspension",
+        body: "Hello",
+        message_id: "<before-susp@example.test>"
+      ))
+      assert_response :no_content
+      ticket = @acme.tickets.last
+
+      patch "/api/v1/tickets/#{ticket.id}",
+        params: { ticket: { status: "pending", comment: { body: "Reply before suspend" } } },
+        headers: account_headers("acme", token: @acme_owner_token),
+        as: :json
+      assert_response :ok
+      reply_addr = ActionMailer::Base.deliveries.last.reply_to.first
+
+      # Suspend user
+      patch "/api/v1/users/#{suspended_user.id}",
+        params: { user: { suspended: true } },
+        headers: account_headers("acme", token: @acme_owner_token),
+        as: :json
+      assert_response :ok
+      ActionMailer::Base.deliveries.clear
+
+      # Suspended user cannot open new ticket or reply to existing ticket
+      assert_no_difference [ "Ticket.count", "TicketComment.count" ] do
+        post_relay(build_rfc822(
+          from: "suspended@example.test",
+          to: "acme@support.example.test",
+          subject: "While suspended",
+          body: "Blocked",
+          message_id: "<while-susp-new@example.test>"
+        ))
+        assert_response :no_content
+
+        post_relay(build_rfc822(
+          from: "suspended@example.test",
+          to: reply_addr,
+          subject: "Re: Before suspension",
+          body: "Blocked reply",
+          message_id: "<while-susp-reply@example.test>"
+        ))
+        assert_response :no_content
+      end
+      assert_equal "pending", ticket.reload.status
+
+      # Pending staff invitee email is ignored and does not create a customer blocking acceptance
+      assert_no_difference [ "Ticket.count", "User.count", "ActionMailer::Base.deliveries.size" ] do
+        post_relay(build_rfc822(
+          from: "invitee@acme.test",
+          to: "acme@support.example.test",
+          subject: "Before accepting invite",
+          body: "Should not break invite",
+          message_id: "<pending-invitee@example.test>"
+        ))
+        assert_response :no_content
+      end
+    end
+  end
+end
diff --git a/test/integration/email_verification_and_password_reset_test.rb b/test/integration/email_verification_and_password_reset_test.rb
new file mode 100644
index 0000000..5e40ce0
--- /dev/null
+++ b/test/integration/email_verification_and_password_reset_test.rb
@@ -0,0 +1,177 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class EmailVerificationAndPasswordResetTest < ActionDispatch::IntegrationTest
+  test "requesting a new email verification link replaces the old one" do
+    create_account_via_api
+    assert_response :created
+
+    first_mail = ActionMailer::Base.deliveries.last
+    first_token = extract_query_params(extract_link_from_mail(first_mail, path: "/verify-email"))["token"]
+
+    # Request a fresh verification link
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "jo@acme.test" } },
+        headers: account_headers("acme"),
+        as: :json
+    end
+    assert_response :ok
+
+    second_mail = ActionMailer::Base.deliveries.last
+    second_token = extract_query_params(extract_link_from_mail(second_mail, path: "/verify-email"))["token"]
+    assert_not_equal first_token, second_token
+
+    # Old token is invalidated
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: first_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # New token works
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: second_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+
+    # Requesting verification for already-verified or unknown email returns 200 without sending mail
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "jo@acme.test" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "unknown@acme.test" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+    end
+  end
+
+  test "expired email verification token is rejected" do
+    create_account_via_api
+    token = extract_query_params(extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/verify-email"))["token"]
+
+    travel 25.hours do
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "password reset flow replaces old links, revokes existing sessions, and updates password" do
+    with_env(HELPDESK_FRONTEND_URL: "https://app.helpdesk.test", HELPDESK_MAIL_FROM: "help@helpdesk.test") do
+      create_account_via_api
+      verify_last_email!(subdomain: "acme")
+      session_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+      ActionMailer::Base.deliveries.clear
+
+      # First reset request
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        post "/api/v1/password_resets",
+          params: { password_reset: { email: "jo@acme.test" } },
+          headers: account_headers("acme"),
+          as: :json
+      end
+      assert_response :ok
+
+      first_mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "help@helpdesk.test" ], first_mail.from
+      first_link = extract_link_from_mail(first_mail, path: "/reset-password")
+      assert first_link.start_with?("https://app.helpdesk.test/reset-password?")
+      first_params = extract_query_params(first_link)
+      assert_equal "acme", first_params["account"]
+      first_token = first_params["token"]
+
+      # Second reset request replaces the first
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        post "/api/v1/password_resets",
+          params: { password_reset: { email: "jo@acme.test" } },
+          headers: account_headers("acme"),
+          as: :json
+      end
+      assert_response :ok
+
+      second_token = extract_query_params(extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password"))["token"]
+      assert_not_equal first_token, second_token
+
+      # Old token fails
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: first_token, password: "my-new-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+
+      # Invalid password does NOT consume valid token
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: second_token, password: "short" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+
+      # Valid confirmation succeeds and signs out existing sessions
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: second_token, password: "my-new-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+
+      # Replaying token fails
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: second_token, password: "another-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+
+      # Existing session was revoked
+      get "/api/v1/me", headers: account_headers("acme", token: session_token)
+      assert_response :unauthorized
+
+      # Old password rejected, new password accepted
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unauthorized
+
+      new_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+      assert_not_empty new_token
+
+      # Unknown email returns 200 without sending email
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        post "/api/v1/password_resets",
+          params: { password_reset: { email: "nobody@acme.test" } },
+          headers: account_headers("acme"),
+          as: :json
+        assert_response :ok
+      end
+    end
+  end
+
+  test "expired password reset token is rejected" do
+    create_account_via_api
+    verify_last_email!(subdomain: "acme")
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    token = extract_query_params(extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password"))["token"]
+
+    travel 3.hours do
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: token, password: "my-new-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+    end
+  end
+end
diff --git a/test/integration/groups_and_memberships_test.rb b/test/integration/groups_and_memberships_test.rb
new file mode 100644
index 0000000..8fc9fd9
--- /dev/null
+++ b/test/integration/groups_and_memberships_test.rb
@@ -0,0 +1,537 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class GroupsAndMembershipsTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @owner = @acme.owner
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    invite_staff_via_api(token: @owner_token, email: "morgan@acme.test", role: "admin")
+    accept_invitation_via_api(token: extract_last_invitation_token, name: "Morgan", password: "morgan-password")
+    @second_admin = User.find_by!(account: @acme, email: "morgan@acme.test")
+    @second_admin_token = sign_in_via_api(subdomain: "acme", email: "morgan@acme.test", password: "morgan-password")
+
+    invite_staff_via_api(token: @owner_token, email: "sam@acme.test", role: "agent")
+    accept_invitation_via_api(token: extract_last_invitation_token, name: "Sam", password: "sam-password")
+    @agent = User.find_by!(account: @acme, email: "sam@acme.test")
+    @agent_token = sign_in_via_api(subdomain: "acme", email: "sam@acme.test", password: "sam-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password")
+    verify_last_email!(subdomain: "acme")
+    @customer = User.find_by!(account: @acme, email: "avery@example.test")
+    @customer_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "avery-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Max", email: "max@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex = Account.find_by!(subdomain: "globex")
+    @globex_owner = @globex.owner
+    @globex_token = sign_in_via_api(subdomain: "globex", email: "max@globex.test", password: "globex-password")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "admins create, list (ID asc), show, rename, and delete groups; staff browse groups" do
+    # Create Billing (owner) and Technical Support (invited admin) and Sales
+    post "/api/v1/groups",
+      params: { group: { name: "  Billing  " } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    billing_id = json_body.dig("group", "id")
+    assert_equal "Billing", json_body.dig("group", "name")
+    assert_equal @acme.id, json_body.dig("group", "account_id")
+    assert_not_nil json_body.dig("group", "created_at")
+    assert_not_nil json_body.dig("group", "updated_at")
+
+    post "/api/v1/groups",
+      params: { group: { name: "Technical Support" } },
+      headers: account_headers("acme", token: @second_admin_token),
+      as: :json
+    assert_response :created
+    tech_id = json_body.dig("group", "id")
+
+    post "/api/v1/groups",
+      params: { group: { name: "Sales" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    sales_id = json_body.dig("group", "id")
+
+    # Rename Billing via PATCH (updates updated_at, order must remain ID asc!)
+    travel 5.minutes do
+      patch "/api/v1/groups/#{billing_id}",
+        params: { group: { name: "Billing & Invoices" } },
+        headers: account_headers("acme", token: @second_admin_token),
+        as: :json
+      assert_response :ok
+      assert_equal "Billing & Invoices", json_body.dig("group", "name")
+    end
+
+    # Rename via PUT with case-only change works
+    put "/api/v1/groups/#{billing_id}",
+      params: { group: { name: "billing & invoices" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "billing & invoices", json_body.dig("group", "name")
+
+    # Unpermitted fields on PATCH are ignored without modifying name or account_id
+    patch "/api/v1/groups/#{billing_id}",
+      params: { group: { account_id: @globex.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "billing & invoices", json_body.dig("group", "name")
+    assert_equal @acme.id, json_body.dig("group", "account_id")
+
+    # Agent can list groups (strictly ID asc) and paginate
+    get "/api/v1/groups", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ billing_id, tech_id, sales_id ], json_body["groups"].map { |g| g["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_nil json_body["next_page"]
+
+    get "/api/v1/groups", params: { page: 1, per_page: 2 }, headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ billing_id, tech_id ], json_body["groups"].map { |g| g["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    get "/api/v1/groups", params: { page: 2, per_page: 2 }, headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ sales_id ], json_body["groups"].map { |g| g["id"] }
+    assert_nil json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+
+    # Agent can show single group
+    get "/api/v1/groups/#{tech_id}", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal "Technical Support", json_body.dig("group", "name")
+
+    # Admin deletes Sales -> 204 No Content, subsequent GET returns 404, name can be reused
+    delete "/api/v1/groups/#{sales_id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :no_content
+    assert_equal "", response.body
+
+    get "/api/v1/groups/#{sales_id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :not_found
+
+    post "/api/v1/groups",
+      params: { group: { name: "Sales" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    assert_operator json_body.dig("group", "id"), :>, sales_id
+  end
+
+  test "group validation errors, uniqueness, and cross-tenant isolation" do
+    post "/api/v1/groups",
+      params: { group: { name: "Billing" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    acme_billing_id = json_body.dig("group", "id")
+
+    post "/api/v1/groups",
+      params: { group: { name: "Technical Support" } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :created
+    acme_tech_id = json_body.dig("group", "id")
+
+    # Same name in different account is allowed
+    post "/api/v1/groups",
+      params: { group: { name: "Billing" } },
+      headers: account_headers("globex", token: @globex_token),
+      as: :json
+    assert_response :created
+    globex_billing_id = json_body.dig("group", "id")
+
+    # Case-insensitive duplicate in same account rejected on create & update
