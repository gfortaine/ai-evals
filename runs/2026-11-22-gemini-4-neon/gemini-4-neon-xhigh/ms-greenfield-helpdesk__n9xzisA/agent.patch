+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,439 @@
+# frozen_string_literal: true
+
+module Api
+  module V1
+    class TicketsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_staff!
+      before_action :set_ticket, only: %i[show update comments merge]
+
+      def index
+        scope = current_account.tickets.includes(:requester, :assignee, :group).recently_active_first
+        errors = {}
+
+        if filter_param_present?(:status)
+          raw_status = params[:status]
+          if raw_status.is_a?(String) && Ticket::STATUSES.include?(raw_status)
+            scope = scope.with_status(raw_status)
+          else
+            errors[:status] = [ "is not included in the list" ]
+          end
+        end
+
+        if filter_param_present?(:priority)
+          raw_priority = params[:priority]
+          if raw_priority.is_a?(String) && Ticket::PRIORITIES.include?(raw_priority)
+            scope = scope.with_priority(raw_priority)
+          else
+            errors[:priority] = [ "is not included in the list" ]
+          end
+        end
+
+        if filter_param_present?(:group_id)
+          raw_group_id = params[:group_id]
+          if raw_group_id == "unassigned"
+            scope = scope.ungrouped
+          else
+            parsed_group_id = parse_positive_bigint(raw_group_id)
+            if parsed_group_id
+              scope = scope.in_group(parsed_group_id)
+            else
+              errors[:group_id] = [ "must be a positive integer or unassigned" ]
+            end
+          end
+        end
+
+        if filter_param_present?(:assignee_id)
+          raw_assignee_id = params[:assignee_id]
+          if raw_assignee_id == "unassigned"
+            scope = scope.unassigned
+          else
+            parsed_assignee_id = parse_positive_bigint(raw_assignee_id)
+            if parsed_assignee_id
+              scope = scope.assigned_to(parsed_assignee_id)
+            else
+              errors[:assignee_id] = [ "must be a positive integer or unassigned" ]
+            end
+          end
+        end
+
+        if filter_param_present?(:requester_id)
+          parsed_requester_id = parse_positive_bigint(params[:requester_id])
+          if parsed_requester_id
+            scope = scope.requested_by(parsed_requester_id)
+          else
+            errors[:requester_id] = [ "must be a positive integer" ]
+          end
+        end
+
+        if filter_param_present?(:q)
+          raw_q = params[:q]
+          if raw_q.is_a?(String)
+            scope = scope.search_text(raw_q)
+          else
+            errors[:q] = [ "must be a string" ]
+          end
+        end
+
+        if errors.any?
+          render_validation_errors(errors)
+          return
+        end
+
+        render_paginated(
+          :tickets,
+          scope,
+          keyset: TICKET_KEYSET,
+          scope_key: "tickets:#{current_account.id}"
+        ) { |ticket| serialize_ticket(ticket) }
+      end
+
+      def show
+        render json: { ticket: serialize_ticket(@ticket) }, status: :ok
+      end
+
+      def update
+        ticket_params = require_hash_param(params, :ticket)
+        comment_params = optional_hash_param(ticket_params, :comment)
+
+        comment = nil
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          @ticket = current_account.tickets.lock.find_by(id: @ticket.id)
+          unless @ticket
+            render_error("Ticket not found", code: "not_found", status: :not_found)
+            raise ActiveRecord::Rollback
+          end
+
+          if @ticket.closed?
+            render_validation_errors(
+              { status: [ "cannot update a closed ticket" ] },
+              message: "Closed tickets cannot be updated"
+            )
+            raise ActiveRecord::Rollback
+          end
+
+          errors = {}
+
+          status_provided = ticket_params.key?(:status)
+          requested_status = ticket_params[:status]
+          if status_provided
+            if requested_status.is_a?(String) && Ticket::EDITABLE_STATUSES.include?(requested_status)
+              @ticket.status = requested_status
+            else
+              errors[:status] = [ "is not included in the list" ]
+            end
+          end
+
+          priority_provided = ticket_params.key?(:priority)
+          requested_priority = ticket_params[:priority]
+          if priority_provided
+            if requested_priority.is_a?(String) && Ticket::PRIORITIES.include?(requested_priority)
+              @ticket.priority = requested_priority
+            else
+              errors[:priority] = [ "is not included in the list" ]
+            end
+          end
+
+          group_provided = ticket_params.key?(:group_id)
+          target_group = nil
+          if group_provided
+            raw_group_id = ticket_params[:group_id]
+            if raw_group_id.nil?
+              target_group = nil
+            else
+              parsed_group_id = parse_positive_bigint(raw_group_id)
+              found_group = parsed_group_id ? current_account.groups.find_by(id: parsed_group_id) : nil
+              if found_group
+                target_group = found_group
+              else
+                errors[:group_id] = [ "must be a valid group in this account" ]
+              end
+            end
+          end
+
+          assignee_provided = ticket_params.key?(:assignee_id)
+          target_assignee = nil
+          if assignee_provided
+            raw_assignee_id = ticket_params[:assignee_id]
+            if raw_assignee_id.nil?
+              target_assignee = nil
+            else
+              parsed_assignee_id = parse_positive_bigint(raw_assignee_id)
+              found_assignee = parsed_assignee_id ? current_account.users.staff.active.find_by(id: parsed_assignee_id) : nil
+              if found_assignee
+                target_assignee = found_assignee
+              else
+                errors[:assignee_id] = [ "must be an active staff member in this account" ]
+              end
+            end
+          end
+
+          if !errors.key?(:group_id) && !errors.key?(:assignee_id)
+            if group_provided && assignee_provided
+              if target_group.nil? && target_assignee.nil?
+                @ticket.group = nil
+                @ticket.assignee = nil
+              elsif target_group.nil?
+                errors[:assignee_id] = [ "cannot be set when clearing the group" ]
+              elsif target_assignee.nil?
+                @ticket.group = target_group
+                @ticket.assignee = nil
+              elsif current_account.group_memberships.exists?(group_id: target_group.id, user_id: target_assignee.id)
+                @ticket.group = target_group
+                @ticket.assignee = target_assignee
+              else
+                errors[:assignee_id] = [ "must belong to the ticket's group" ]
+              end
+            elsif group_provided
+              if target_group.nil?
+                @ticket.group = nil
+                @ticket.assignee = nil
+              else
+                @ticket.group = target_group
+                if @ticket.assignee_id.present? &&
+                    !current_account.group_memberships.exists?(group_id: target_group.id, user_id: @ticket.assignee_id)
+                  @ticket.assignee = nil
+                end
+              end
+            elsif assignee_provided
+              if target_assignee.nil?
+                @ticket.assignee = nil
+              elsif @ticket.group_id.present?
+                if current_account.group_memberships.exists?(group_id: @ticket.group_id, user_id: target_assignee.id)
+                  @ticket.assignee = target_assignee
+                else
+                  errors[:assignee_id] = [ "must belong to the ticket's group" ]
+                end
+              else
+                @ticket.group = target_assignee.default_group
+                @ticket.assignee = target_assignee
+              end
+            end
+          end
+
+          if comment_params
+            comment_errors = {}
+
+            raw_body = comment_params[:body]
+            body_value = raw_body.is_a?(String) ? raw_body : nil
+            if !raw_body.nil? && !raw_body.is_a?(String)
+              comment_errors[:body] = [ "must be a string" ]
+            end
+
+            if comment_params.key?(:public)
+              raw_public = comment_params[:public]
+              if raw_public == true || raw_public == false
+                is_public = raw_public
+              else
+                comment_errors[:public] = [ "must be a boolean" ]
+                is_public = true
+              end
+            else
+              is_public = true
+            end
+
+            comment = TicketComment.new(
+              account: current_account,
+              ticket: @ticket,
+              author: current_user,
+              body: body_value,
+              public: is_public
+            )
+
+            unless comment.valid?
+              comment.errors.to_hash.each do |key, messages|
+                comment_errors[key] ||= messages
+              end
+            end
+
+            errors[:comment] = comment_errors if comment_errors.any?
+          end
+
+          if errors.any?
+            render_validation_errors(errors)
+            raise ActiveRecord::Rollback
+          end
+
+          unless @ticket.valid?
+            render_validation_errors(@ticket.errors.to_hash)
+            raise ActiveRecord::Rollback
+          end
+
+          @ticket.save! if @ticket.changed?
+          comment&.save!
+        end
+        return if performed?
+
+        if comment&.public? && @ticket.email_origin?
+          TicketMailer.staff_reply(@ticket, comment).deliver_now
+        end
+
+        render json: { ticket: serialize_ticket(@ticket) }, status: :ok
+      end
+
+      def merge
+        merge_params = require_hash_param(params, :merge)
+        source_comment_params = optional_hash_param(merge_params, :source_comment)
+        target_comment_params = optional_hash_param(merge_params, :target_comment)
+        parsed_target_id = parse_positive_bigint(merge_params[:target_id])
+
+        source_id = nil
+        target_id = nil
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+
+          ids_to_lock = [ @ticket.id ]
+          ids_to_lock << parsed_target_id if parsed_target_id && parsed_target_id != @ticket.id
+          locked_tickets = current_account.tickets.where(id: ids_to_lock).order(:id).lock.index_by(&:id)
+
+          source = locked_tickets[@ticket.id]
+          unless source
+            render_error("Ticket not found", code: "not_found", status: :not_found)
+            raise ActiveRecord::Rollback
+          end
+
+          target = parsed_target_id ? locked_tickets[parsed_target_id] : nil
+          errors = {}
+
+          if source.closed?
+            errors[:source] = [ "cannot merge a closed ticket" ]
+          end
+
+          if target.nil?
+            errors[:target_id] = [ "must be a valid ticket in this account" ]
+          elsif target.id == source.id
+            errors[:target_id] = [ "cannot be the same as the source ticket" ]
+          elsif target.closed?
+            errors[:target_id] = [ "cannot merge into a closed ticket" ]
+          elsif target.requester_id != source.requester_id
+            errors[:target_id] = [ "must belong to the same requester" ]
+          end
+
+          default_source_body = target ? "This ticket was closed and merged into ticket ##{target.id}." : "This ticket was closed and merged."
+          default_target_body = "Ticket ##{source.id} was closed and merged into this ticket."
+
+          parsed_source_comment = parse_merge_comment(source_comment_params, default_body: default_source_body)
+          errors[:source_comment] = parsed_source_comment[:errors] if parsed_source_comment[:errors].any?
+
+          parsed_target_comment = parse_merge_comment(target_comment_params, default_body: default_target_body)
+          errors[:target_comment] = parsed_target_comment[:errors] if parsed_target_comment[:errors].any?
+
+          if errors.any?
+            render_validation_errors(errors)
+            raise ActiveRecord::Rollback
+          end
+
+          source.status = "closed"
+          source.merged_into = target
+
+          source_comment = TicketComment.new(
+            account: current_account,
+            ticket: source,
+            author: current_user,
+            body: parsed_source_comment[:body],
+            public: parsed_source_comment[:public],
+            allow_closed_ticket: true
+          )
+
+          target_comment = TicketComment.new(
+            account: current_account,
+            ticket: target,
+            author: current_user,
+            body: parsed_target_comment[:body],
+            public: parsed_target_comment[:public]
+          )
+
+          source_valid = source.valid?
+          source_comment_valid = source_comment.valid?
+          target_comment_valid = target_comment.valid?
+
+          unless source_valid && source_comment_valid && target_comment_valid
+            model_errors = source.errors.to_hash
+            model_errors[:source_comment] = source_comment.errors.to_hash if source_comment.errors.any?
+            model_errors[:target_comment] = target_comment.errors.to_hash if target_comment.errors.any?
+            render_validation_errors(model_errors)
+            raise ActiveRecord::Rollback
+          end
+
+          source.save!
+          source_comment.save!
+          target_comment.save!
+
+          source_id = source.id
+          target_id = target.id
+        end
+        return if performed?
+
+        reloaded = current_account.tickets
+          .includes(:requester, :assignee, :group)
+          .where(id: [ source_id, target_id ])
+          .index_by(&:id)
+
+        render json: {
+          source: serialize_ticket(reloaded.fetch(source_id)),
+          target: serialize_ticket(reloaded.fetch(target_id))
+        }, status: :ok
+      end
+
+      def comments
+        render_paginated(
+          :comments,
+          @ticket.comments.includes(:author).oldest_first,
+          keyset: COMMENT_KEYSET,
+          scope_key: "ticket_comments:#{current_account.id}:#{@ticket.id}"
+        ) { |comment| serialize_comment(comment) }
+      end
+
+      private
+
+      def parse_merge_comment(comment_params, default_body:)
+        comment_errors = {}
+
+        if comment_params.nil?
+          return { body: default_body, public: false, errors: comment_errors }
+        end
+
+        if comment_params.key?(:body)
+          raw_body = comment_params[:body]
+          if raw_body.is_a?(String)
+            body_value = raw_body
+            comment_errors[:body] = [ "can't be blank" ] if body_value.blank?
+          elsif raw_body.nil?
+            body_value = nil
+            comment_errors[:body] = [ "can't be blank" ]
+          else
+            body_value = nil
+            comment_errors[:body] = [ "must be a string" ]
+          end
+        else
+          body_value = default_body
+        end
+
+        if comment_params.key?(:public)
+          raw_public = comment_params[:public]
+          if raw_public == true || raw_public == false
+            is_public = raw_public
+          else
+            comment_errors[:public] = [ "must be a boolean" ]
+            is_public = false
+          end
+        else
+          is_public = false
+        end
+
+        { body: body_value, public: is_public, errors: comment_errors }
+      end
+
+      def set_ticket
+        @ticket = find_scoped_record(current_account.tickets.includes(:requester, :assignee, :group), params[:id])
+        return if @ticket
+
+        render_error("Ticket not found", code: "not_found", status: :not_found)
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..b353f18
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,125 @@
+# frozen_string_literal: true
+
+module Api
+  module V1
+    class UsersController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!
+      before_action :set_user, only: %i[show update]
+
+      def index
+        scope = current_account.users.ordered_by_id
+        errors = {}
+
+        if params.key?(:role) && !(params[:role].nil? || params[:role] == "")
+          if params[:role].is_a?(String) && User::ROLES.include?(params[:role])
+            scope = scope.where(role: params[:role])
+          else
+            errors[:role] = [ "is not included in the list" ]
+          end
+        end
+
+        if params.key?(:suspended) && !(params[:suspended].nil? || params[:suspended] == "")
+          case params[:suspended]
+          when true, "true"
+            scope = scope.suspended
+          when false, "false"
+            scope = scope.active
+          else
+            errors[:suspended] = [ "must be true or false" ]
+          end
+        end
+
+        if errors.any?
+          render_validation_errors(errors)
+          return
+        end
+
+        render_paginated(
+          :users,
+          scope,
+          keyset: ID_KEYSET,
+          scope_key: "users:#{current_account.id}"
+        ) { |user| serialize_user(user) }
+      end
+
+      def show
+        render json: { user: serialize_user(@user) }, status: :ok
+      end
+
+      def update
+        user_params = require_hash_param(params, :user)
+
+        name_provided = user_params.key?(:name)
+        raw_name = user_params[:name]
+        suspended_provided = user_params.key?(:suspended)
+        raw_suspended = user_params[:suspended]
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          @user.lock!
+
+          errors = {}
+
+          if name_provided
+            if raw_name.is_a?(String)
+              @user.name = raw_name
+            else
+              errors[:name] = [ "must be a string" ]
+            end
+          end
+
+          target_suspended = nil
+          if suspended_provided
+            if raw_suspended == true || raw_suspended == false
+              target_suspended = raw_suspended
+            else
+              errors[:suspended] = [ "must be a boolean" ]
+            end
+          end
+
+          unless @user.valid?
+            @user.errors.to_hash.each do |key, messages|
+              errors[key] ||= messages
+            end
+          end
+
+          if errors.any?
+            render_validation_errors(errors)
+            raise ActiveRecord::Rollback
+          end
+
+          if suspended_provided && target_suspended == true
+            if @user.admin? && !current_account.users.admins.active.where.not(id: @user.id).exists?
+              render_validation_errors(
+                { suspended: [ "cannot suspend the last active admin" ] },
+                message: "Cannot suspend the last active admin"
+              )
+              raise ActiveRecord::Rollback
+            end
+
+            @user.suspend!
+          elsif suspended_provided && target_suspended == false
+            @user.unsuspend!
+          elsif name_provided
+            @user.save!
+          end
+        end
+        return if performed?
+
+        render json: { user: serialize_user(@user.reload) }, status: :ok
+      end
+
+      private
+
+      def set_user
+        @user = find_scoped_record(current_account.users, params[:id])
+        return if @user
+
+        render_error("User not found", code: "not_found", status: :not_found)
+      end
+    end
+  end
+end
