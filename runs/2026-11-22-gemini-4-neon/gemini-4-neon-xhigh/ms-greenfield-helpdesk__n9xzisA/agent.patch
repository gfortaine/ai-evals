+# frozen_string_literal: true
+
+require "test_helper"
+
+class AccountMailerTest < ActionMailer::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @user = @account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+  end
+
+  test "email_verification uses defaults for frontend url and mail from" do
+    with_env(HELPDESK_FRONTEND_URL: nil, HELPDESK_MAIL_FROM: nil) do
+      mail = AccountMailer.email_verification(@user, "tok123")
+      assert_equal [ "support@example.test" ], mail.from
+      assert_equal [ "jo@acme.test" ], mail.to
+      assert_includes mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token=tok123"
+      assert_includes mail.to_s, "http://localhost:3001/verify-email?account=acme&token=tok123"
+    end
+  end
+
+  test "password_reset respects HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM" do
+    with_env(HELPDESK_FRONTEND_URL: "https://desk.example.com/", HELPDESK_MAIL_FROM: "noreply@desk.example.com") do
+      mail = AccountMailer.password_reset(@user, "reset456")
+      assert_equal [ "noreply@desk.example.com" ], mail.from
+      assert_equal [ "jo@acme.test" ], mail.to
+      assert_includes mail.body.decoded, "https://desk.example.com/reset-password?account=acme&token=reset456"
+    end
+  end
+
+  test "invitation uses defaults and respects HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM" do
+    invitation = Invitation.build_for(account: @account, invited_by: @user, email: "sam@example.test", role: "agent")
+    invitation.save!
+
+    with_env(HELPDESK_FRONTEND_URL: nil, HELPDESK_MAIL_FROM: nil) do
+      mail = AccountMailer.invitation(invitation, "inv789")
+      assert_equal [ "support@example.test" ], mail.from
+      assert_equal [ "sam@example.test" ], mail.to
+      assert_includes mail.body.decoded, "http://localhost:3001/accept-invitation?account=acme&token=inv789"
+      assert_includes mail.to_s, "http://localhost:3001/accept-invitation?account=acme&token=inv789"
+    end
+
+    with_env(HELPDESK_FRONTEND_URL: "https://desk.example.com/", HELPDESK_MAIL_FROM: "team@desk.example.com") do
+      mail = AccountMailer.invitation(invitation, "inv789")
+      assert_equal [ "team@desk.example.com" ], mail.from
+      assert_equal [ "sam@example.test" ], mail.to
+      assert_includes mail.body.decoded, "https://desk.example.com/accept-invitation?account=acme&token=inv789"
+    end
+  end
+end
