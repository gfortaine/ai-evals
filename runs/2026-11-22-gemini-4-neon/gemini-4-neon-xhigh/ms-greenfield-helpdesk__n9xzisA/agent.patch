+# frozen_string_literal: true
+
+require "test_helper"
+
+class TicketAssignmentsAndPrivateNotesTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @owner = @acme.owner
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    invite_staff_via_api(token: @owner_token, email: "sam@acme.test", role: "agent")
+    accept_invitation_via_api(token: extract_last_invitation_token, name: "Sam", password: "sam-password")
+    @agent = User.find_by!(account: @acme, email: "sam@acme.test")
+    @agent_token = sign_in_via_api(subdomain: "acme", email: "sam@acme.test", password: "sam-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password")
+    verify_last_email!(subdomain: "acme")
+    @customer = User.find_by!(account: @acme, email: "avery@example.test")
+    @customer_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "avery-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Max", email: "max@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex_owner = Account.find_by!(subdomain: "globex").owner
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "staff assigns, reassigns, and clears tickets; exposes assignee_id and assignee on tickets only" do
+    post "/api/v1/requests",
+      params: { request: { subject: "Receipt issue", comment: { body: "Cannot download" } } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :created
+    ticket_id = json_body.dig("request", "id")
+
+    # Initially unassigned on GET /tickets and GET /tickets/:id
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert json_body["ticket"].key?("assignee_id")
+    assert json_body["ticket"].key?("assignee")
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+
+    # Agent assigns ticket to self
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { assignee_id: @agent.id } },
+      headers: account_headers("acme", token: @agent_token),
+      as: :json
+    assert_response :ok
+    assert_equal @agent.id, json_body.dig("ticket", "assignee_id")
+    assert_equal({ "id" => @agent.id, "name" => "Sam" }, json_body.dig("ticket", "assignee"))
+
+    # Appears on GET /tickets list too
+    get "/api/v1/tickets", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal @agent.id, json_body["tickets"].first["assignee_id"]
+    assert_equal({ "id" => @agent.id, "name" => "Sam" }, json_body["tickets"].first["assignee"])
+
+    # Customer GET /requests and GET /requests/:id never expose assignee
+    get "/api/v1/requests/#{ticket_id}", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_not json_body["request"].key?("assignee_id")
+    assert_not json_body["request"].key?("assignee")
+
+    # Updating status without assignee_id preserves existing assignee
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "pending" } },
+      headers: account_headers("acme", token: @agent_token),
+      as: :json
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+    assert_equal @agent.id, json_body.dig("ticket", "assignee_id")
+
+    # Reassign to admin Jo
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { assignee_id: @owner.id } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal @owner.id, json_body.dig("ticket", "assignee_id")
+    assert_equal({ "id" => @owner.id, "name" => "Jo" }, json_body.dig("ticket", "assignee"))
+
+    # Clear assignment with null
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { assignee_id: nil } },
+      headers: account_headers("acme", token: @agent_token),
+      as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+  end
+
+  test "rejects invalid assignee_id atomically without changing status or saving comments" do
+    post "/api/v1/requests",
+      params: { request: { subject: "Help", comment: { body: "Details" } } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    ticket_id = json_body.dig("request", "id")
+
+    # Create a suspended agent to test rejection
+    invite_staff_via_api(token: @owner_token, email: "suspended@acme.test", role: "agent")
+    accept_invitation_via_api(token: extract_last_invitation_token, name: "Suspended", password: "suspended-password")
+    suspended_agent = User.find_by!(account: @acme, email: "suspended@acme.test")
+    patch "/api/v1/users/#{suspended_agent.id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", token: @owner_token),
+      as: :json
+    assert_response :ok
+
+    bad_assignees = [
+      @customer.id,
+      suspended_agent.id,
+      @globex_owner.id,
+      999_999_999,
+      0,
+      -5,
+      "abc",
+      "",
+      true,
+      false,
+      [ @agent.id ],
+      12.5,
+      "99999999999999999999999"
+    ]
+
+    bad_assignees.each do |bad_assignee|
+      assert_no_difference "TicketComment.count" do
+        patch "/api/v1/tickets/#{ticket_id}",
+          params: {
+            ticket: {
+              assignee_id: bad_assignee,
+              status: "solved",
+              comment: { body: "Should roll back" }
+            }
+          },
+          headers: account_headers("acme", token: @owner_token),
+          as: :json
+      end
+      assert_response :unprocessable_content, "Expected 422 for assignee_id=#{bad_assignee.inspect}"
+      assert json_body.dig("errors", "assignee_id").present?
+      ticket = Ticket.find(ticket_id)
+      assert_nil ticket.assignee_id
+      assert_equal "open", ticket.status
+    end
+  end
+
+  test "private notes and assignment changes do not alter customer-facing request timestamps, ordering, or comments" do
+    base_time = Time.utc(2026, 11, 20, 12, 0, 0)
+    ticket1_id = nil
+    ticket2_id = nil
+
+    travel_to base_time do
+      post "/api/v1/requests",
+        params: { request: { subject: "First ticket", comment: { body: "Initial 1" } } },
+        headers: account_headers("acme", token: @customer_token),
+        as: :json
+      assert_response :created
+      ticket1_id = json_body.dig("request", "id")
+    end
+
+    travel_to base_time + 5.minutes do
+      post "/api/v1/requests",
+        params: { request: { subject: "Second ticket", comment: { body: "Initial 2" } } },
+        headers: account_headers("acme", token: @customer_token),
+        as: :json
+      assert_response :created
+      ticket2_id = json_body.dig("request", "id")
+    end
+
+    # Baseline customer request view
+    get "/api/v1/requests/#{ticket1_id}", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    baseline_request1 = json_body["request"]
+
+    get "/api/v1/requests", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal [ ticket2_id, ticket1_id ], json_body["requests"].map { |r| r["id"] }
+
+    # 1. Agent adds a private note to ticket 1 -> bumps ticket 1 in /tickets, does NOT affect /requests!
+    travel_to base_time + 15.minutes do
+      patch "/api/v1/tickets/#{ticket1_id}",
+        params: { ticket: { comment: { body: "Checking this with billing.", public: false } } },
+        headers: account_headers("acme", token: @agent_token),
+        as: :json
+      assert_response :ok
+      assert_equal "open", json_body.dig("ticket", "status")
+      assert_operator Time.iso8601(json_body.dig("ticket", "updated_at")), :>, Time.iso8601(baseline_request1["updated_at"])
+    end
+
+    # Staff sees ticket 1 bumped to top of /tickets and sees private note in /tickets/:id/comments
+    get "/api/v1/tickets", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal [ ticket1_id, ticket2_id ], json_body["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets/#{ticket1_id}/comments", headers: account_headers("acme", token: @agent_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal [ true, false ], json_body["comments"].map { |c| c["public"] }
+    assert_equal "Checking this with billing.", json_body["comments"].last["body"]
+    assert_equal({ "id" => @agent.id, "name" => "Sam" }, json_body["comments"].last["author"])
+
+    # Customer sees ZERO change on /requests/:id, /requests order, and /requests/:id/comments
+    get "/api/v1/requests/#{ticket1_id}", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal baseline_request1, json_body["request"]
+
+    get "/api/v1/requests", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal [ ticket2_id, ticket1_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{ticket1_id}/comments", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal [ "Initial 1" ], json_body["comments"].map { |c| c["body"] }
+
+    # 2. Assigning and unassigning ticket 1 + no-op status with private note ALSO do not affect /requests!
+    travel_to base_time + 20.minutes do
+      patch "/api/v1/tickets/#{ticket1_id}",
+        params: {
+          ticket: {
+            assignee_id: @agent.id,
+            status: "open",
+            comment: { body: "Assigning to myself internally", public: false }
+          }
+        },
+        headers: account_headers("acme", token: @agent_token),
+        as: :json
+      assert_response :ok
+    end
+
+    travel_to base_time + 25.minutes do
+      patch "/api/v1/tickets/#{ticket1_id}",
+        params: { ticket: { assignee_id: nil } },
+        headers: account_headers("acme", token: @agent_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests/#{ticket1_id}", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal baseline_request1, json_body["request"]
+
+    get "/api/v1/requests", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal [ ticket2_id, ticket1_id ], json_body["requests"].map { |r| r["id"] }
+
+    # 3. Public reply DOES update customer-facing request and bumps it to top of /requests!
+    travel_to base_time + 30.minutes do
+      patch "/api/v1/tickets/#{ticket1_id}",
+        params: { ticket: { comment: { body: "We confirmed with billing!", public: true } } },
+        headers: account_headers("acme", token: @agent_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests/#{ticket1_id}", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_operator Time.iso8601(json_body.dig("request", "updated_at")), :>, Time.iso8601(baseline_request1["updated_at"])
+
+    get "/api/v1/requests", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal [ ticket1_id, ticket2_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{ticket1_id}/comments", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+    assert_equal [ "Initial 1", "We confirmed with billing!" ], json_body["comments"].map { |c| c["body"] }
+
+    # 4. Status change + private note updates customer-facing status and timestamp, while still hiding the private note
+    after_public_updated_at = json_body["comments"].last["created_at"]
+    travel_to base_time + 40.minutes do
+      patch "/api/v1/tickets/#{ticket1_id}",
+        params: {
+          ticket: {
+            status: "pending",
+            comment: { body: "Waiting on customer reply", public: false }
+          }
+        },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests/#{ticket1_id}", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal "pending", json_body.dig("request", "status")
+    assert_operator Time.iso8601(json_body.dig("request", "updated_at")), :>, Time.iso8601(after_public_updated_at)
+
+    get "/api/v1/requests/#{ticket1_id}/comments", headers: account_headers("acme", token: @customer_token)
+    assert_response :ok
+    assert_equal 2, json_body["count"]
+
+    # 5. Invalid public value on ticket comment fails atomically with 422
+    [ "false", "true", nil, 0, 1, "yes", [ false ] ].each do |bad_public|
+      assert_no_difference "TicketComment.count" do
+        patch "/api/v1/tickets/#{ticket1_id}",
+          params: {
+            ticket: {
+              status: "solved",
+              assignee_id: @agent.id,
+              comment: { body: "Bad public flag", public: bad_public }
+            }
+          },
+          headers: account_headers("acme", token: @agent_token),
+          as: :json
+      end
+      assert_response :unprocessable_content, "Expected 422 for public=#{bad_public.inspect}"
+      assert json_body.dig("errors", "comment", "public").present?
+      ticket = Ticket.find(ticket1_id)
+      assert_equal "pending", ticket.status
+      assert_nil ticket.assignee_id
+    end
+
+    # 6. Customer trying to pass public: false on /requests still creates a public comment
+    patch "/api/v1/requests/#{ticket1_id}",
+      params: { request: { comment: { body: "Customer reply", public: false } } },
+      headers: account_headers("acme", token: @customer_token),
+      as: :json
+    assert_response :ok
+    assert_equal true, Ticket.find(ticket1_id).comments.last.public
+  end
+end
