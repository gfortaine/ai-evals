+    get "/api/v1/invitations/#{invitation['id']}", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal invitation["id"], json_body.dig("invitation", "id")
+    assert_equal "pending", json_body.dig("invitation", "status")
+
+    # 3. Acceptance screen previews invitation without auth
