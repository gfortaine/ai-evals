+    assert_response :unprocessable_content
+
+    delete "/api/v1/invitations/#{inv2_id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :unprocessable_content
+
+    # Expired invitation cannot be previewed, accepted, resent, or revoked
+    invite_staff_via_api(token: @owner_token, email: "late@example.test", role: "agent")
+    assert_response :created
+    inv3_id = json_body.dig("invitation", "id")
+    inv3_token = extract_last_invitation_token
+
+    travel 8.days do
