+
+  test "resend rotates token and extends expiry; revoke invalidates token; non-pending cannot be resent or revoked" do
+    invite_staff_via_api(token: @owner_token, email: "sam@example.test", role: "agent")
+    assert_response :created
+    inv_id = json_body.dig("invitation", "id")
+    original_expires = json_body.dig("invitation", "expires_at")
+    original_token = extract_last_invitation_token
+
+    # Resend after 1 day rotates token and extends expiry
+    travel 1.day do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        post "/api/v1/invitations/#{inv_id}/resend", headers: account_headers("acme", token: @owner_token)
+      end
+      assert_response :ok
+      assert_equal "pending", json_body.dig("invitation", "status")
+      assert_operator Time.iso8601(json_body.dig("invitation", "expires_at")), :>, Time.iso8601(original_expires)
+
+      new_token = extract_last_invitation_token
+      assert_not_equal original_token, new_token
+
+      # Old token rejected for preview and acceptance
+      post "/api/v1/invitation_previews",
+        params: { invitation_preview: { token: original_token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+
+      accept_invitation_via_api(token: original_token, name: "Sam", password: "my-team-password")
+      assert_response :unprocessable_content
+
+      # New token works for preview
+      post "/api/v1/invitation_previews",
+        params: { invitation_preview: { token: new_token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+
+      # Revoke invalidates the new token
+      delete "/api/v1/invitations/#{inv_id}", headers: account_headers("acme", token: @owner_token)
+      assert_response :ok
+      assert_equal "revoked", json_body.dig("invitation", "status")
+      assert_not_nil json_body.dig("invitation", "revoked_at")
+
+      post "/api/v1/invitation_previews",
+        params: { invitation_preview: { token: new_token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_content
+
+      accept_invitation_via_api(token: new_token, name: "Sam", password: "my-team-password")
+      assert_response :unprocessable_content
+
+      # Cannot resend or revoke an already revoked invitation
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        post "/api/v1/invitations/#{inv_id}/resend", headers: account_headers("acme", token: @owner_token)
+      end
+      assert_response :unprocessable_content
+
+      delete "/api/v1/invitations/#{inv_id}", headers: account_headers("acme", token: @owner_token)
+      assert_response :unprocessable_content
+    end
+
+    # Accepted invitation cannot be resent or revoked
+    invite_staff_via_api(token: @owner_token, email: "sam@example.test", role: "agent")
+    assert_response :created
+    inv2_id = json_body.dig("invitation", "id")
