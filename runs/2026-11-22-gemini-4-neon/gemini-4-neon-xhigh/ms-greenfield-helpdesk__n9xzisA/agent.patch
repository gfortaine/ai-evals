+# frozen_string_literal: true
+
+require "test_helper"
+
+class RequestsTicketsAuthorizationAndPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "avery-password")
+    verify_last_email!(subdomain: "acme")
+    @avery_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "avery-password")
+
+    register_customer_via_api(subdomain: "acme", name: "Blake", email: "blake@example.test", password: "blake-password")
+    verify_last_email!(subdomain: "acme")
+    @blake_token = sign_in_via_api(subdomain: "acme", email: "blake@example.test", password: "blake-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Sam", email: "sam@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex_owner_token = sign_in_via_api(subdomain: "globex", email: "sam@globex.test", password: "globex-password")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "enforces role isolation, per-customer isolation, and multi-tenant isolation" do
+    post "/api/v1/requests",
+      params: { request: { subject: "Avery issue", comment: { body: "Avery details" } } },
+      headers: account_headers("acme", token: @avery_token),
+      as: :json
+    assert_response :created
+    avery_ticket_id = json_body.dig("request", "id")
+
+    # Unauthenticated calls fail with 401
+    get "/api/v1/requests", headers: account_headers("acme")
+    assert_response :unauthorized
+    get "/api/v1/tickets", headers: account_headers("acme")
+    assert_response :unauthorized
+
+    # Customers cannot access any /tickets routes (403)
+    get "/api/v1/tickets", headers: account_headers("acme", token: @avery_token)
+    assert_response :forbidden
+    get "/api/v1/tickets/#{avery_ticket_id}", headers: account_headers("acme", token: @avery_token)
+    assert_response :forbidden
+    get "/api/v1/tickets/#{avery_ticket_id}/comments", headers: account_headers("acme", token: @avery_token)
+    assert_response :forbidden
+    patch "/api/v1/tickets/#{avery_ticket_id}",
+      params: { ticket: { status: "pending" } },
+      headers: account_headers("acme", token: @avery_token),
+      as: :json
+    assert_response :forbidden
+
+    # Another customer (Blake) cannot see or touch Avery's request
+    get "/api/v1/requests", headers: account_headers("acme", token: @blake_token)
+    assert_response :ok
+    assert_equal 0, json_body["count"]
+    assert_equal [], json_body["requests"]
+
+    get "/api/v1/requests/#{avery_ticket_id}", headers: account_headers("acme", token: @blake_token)
+    assert_response :not_found
+
+    get "/api/v1/requests/#{avery_ticket_id}/comments", headers: account_headers("acme", token: @blake_token)
+    assert_response :not_found
+
+    patch "/api/v1/requests/#{avery_ticket_id}",
+      params: { request: { comment: { body: "Intrusion" } } },
+      headers: account_headers("acme", token: @blake_token),
+      as: :json
+    assert_response :not_found
+
+    # Staff cannot access customer's request via /requests/:id
+    get "/api/v1/requests/#{avery_ticket_id}", headers: account_headers("acme", token: @owner_token)
+    assert_response :not_found
+
+    # Other account's staff (Globex) cannot see or touch Acme's ticket
+    get "/api/v1/tickets", headers: account_headers("globex", token: @globex_owner_token)
+    assert_response :ok
+    assert_equal 0, json_body["count"]
+    assert_equal [], json_body["tickets"]
+
+    get "/api/v1/tickets/#{avery_ticket_id}", headers: account_headers("globex", token: @globex_owner_token)
+    assert_response :not_found
+
+    get "/api/v1/tickets/#{avery_ticket_id}/comments", headers: account_headers("globex", token: @globex_owner_token)
+    assert_response :not_found
+
+    patch "/api/v1/tickets/#{avery_ticket_id}",
+      params: { ticket: { status: "solved" } },
+      headers: account_headers("globex", token: @globex_owner_token),
+      as: :json
+    assert_response :not_found
+
+    # Non-numeric and huge IDs return 404 cleanly
+    [ "abc", "1abc", "-5", "99999999999999999999999" ].each do |bad_id|
+      get "/api/v1/tickets/#{bad_id}", headers: account_headers("acme", token: @owner_token)
+      assert_response :not_found, "Expected 404 for ticket id #{bad_id}"
+
+      get "/api/v1/requests/#{bad_id}", headers: account_headers("acme", token: @avery_token)
+      assert_response :not_found, "Expected 404 for request id #{bad_id}"
+    end
+  end
+
+  test "cancelled account blocks requests and tickets until reactivated" do
+    post "/api/v1/requests",
+      params: { request: { subject: "Before cancel", comment: { body: "Initial" } } },
+      headers: account_headers("acme", token: @avery_token),
+      as: :json
+    assert_response :created
+    ticket_id = json_body.dig("request", "id")
+
+    # Owner cancels account
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+
+    # Existing customer token was revoked (401)
+    get "/api/v1/requests", headers: account_headers("acme", token: @avery_token)
+    assert_response :unauthorized
+
+    # Owner signs in while cancelled -> blocked on /tickets and /requests with 403 account_cancelled
+    cancelled_owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    get "/api/v1/tickets", headers: account_headers("acme", token: cancelled_owner_token)
+    assert_response :forbidden
+    assert_equal "account_cancelled", json_body["code"]
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: cancelled_owner_token)
+    assert_response :forbidden
+    assert_equal "account_cancelled", json_body["code"]
+
+    # Reactivate -> access restored for staff and customer
+    post "/api/v1/account/reactivate", headers: account_headers("acme", token: cancelled_owner_token)
+    assert_response :ok
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", token: cancelled_owner_token)
+    assert_response :ok
+
+    new_avery_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "avery-password")
+    get "/api/v1/requests/#{ticket_id}", headers: account_headers("acme", token: new_avery_token)
+    assert_response :ok
+    assert_equal "Before cancel", json_body.dig("request", "subject")
+  end
+
+  test "paginates lists with defaults and custom page/per_page, orders tickets recently active first and comments oldest first" do
+    base_time = Time.current.change(usec: 0)
+    ticket_ids = []
+
+    # Create 28 requests at 1-minute intervals (26 for Avery, 2 for Blake)
+    28.times do |i|
+      token = i < 26 ? @avery_token : @blake_token
+      travel_to base_time + i.minutes do
+        post "/api/v1/requests",
+          params: { request: { subject: "Ticket #{i + 1}", comment: { body: "Body #{i + 1}" } } },
+          headers: account_headers("acme", token: token),
+          as: :json
+        assert_response :created
+        ticket_ids << json_body.dig("request", "id")
+      end
+    end
+
+    # Default pagination (page 1, per_page 25) on /tickets
+    get "/api/v1/tickets", headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 28, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal 25, json_body["tickets"].size
+    assert_equal ticket_ids.last, json_body["tickets"].first["id"]
+
+    # Page 2 on /tickets
+    get "/api/v1/tickets", params: { page: 2 }, headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 28, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal 3, json_body["tickets"].size
+    assert_equal ticket_ids.first, json_body["tickets"].last["id"]
+
+    # Default pagination on Avery's /requests (26 total)
+    get "/api/v1/requests", headers: account_headers("acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 26, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal 25, json_body["requests"].size
+
+    # Staff reply WITHOUT status change bumps ticket #1 to the top of both /tickets and /requests!
+    oldest_ticket_id = ticket_ids.first
+    travel_to base_time + 60.minutes do
+      patch "/api/v1/tickets/#{oldest_ticket_id}",
+        params: { ticket: { comment: { body: "Bumping oldest ticket" } } },
+        headers: account_headers("acme", token: @owner_token),
+        as: :json
+      assert_response :ok
+      assert_equal "open", json_body.dig("ticket", "status")
+    end
+
+    get "/api/v1/tickets", params: { page: 1, per_page: 5 }, headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal oldest_ticket_id, json_body["tickets"].first["id"]
+    assert_equal 5, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    get "/api/v1/requests", params: { page: 1, per_page: 5 }, headers: account_headers("acme", token: @avery_token)
+    assert_response :ok
+    assert_equal oldest_ticket_id, json_body["requests"].first["id"]
+
+    # Customer reply bumps ticket #2 above ticket #1!
+    second_ticket_id = ticket_ids[1]
+    travel_to base_time + 70.minutes do
+      patch "/api/v1/requests/#{second_ticket_id}",
+        params: { request: { comment: { body: "Customer follow-up" } } },
+        headers: account_headers("acme", token: @avery_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests", params: { page: 1, per_page: 3 }, headers: account_headers("acme", token: @avery_token)
+    assert_response :ok
+    assert_equal [ second_ticket_id, oldest_ticket_id, ticket_ids[25] ], json_body["requests"].map { |r| r["id"] }
+
+    # Comment pagination (oldest first!)
+    4.times do |i|
+      travel_to base_time + (80 + i).minutes do
+        patch "/api/v1/tickets/#{oldest_ticket_id}",
+          params: { ticket: { comment: { body: "Reply #{i + 1}" } } },
+          headers: account_headers("acme", token: @owner_token),
+          as: :json
+        assert_response :ok
+      end
+    end
+
+    # Total 6 comments: "Body 1", "Bumping oldest ticket", "Reply 1", "Reply 2", "Reply 3", "Reply 4"
+    get "/api/v1/requests/#{oldest_ticket_id}/comments",
+      params: { page: 1, per_page: 2 },
+      headers: account_headers("acme", token: @avery_token)
+    assert_response :ok
+    assert_equal 6, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal [ "Body 1", "Bumping oldest ticket" ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/tickets/#{oldest_ticket_id}/comments",
+      params: { page: 2, per_page: 2 },
+      headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 6, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 3, json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal [ "Reply 1", "Reply 2" ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/tickets/#{oldest_ticket_id}/comments",
+      params: { page: 3, per_page: 2 },
+      headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_nil json_body["next_page"]
+    assert_equal 2, json_body["previous_page"]
+    assert_equal [ "Reply 3", "Reply 4" ], json_body["comments"].map { |c| c["body"] }
+
+    # Page past the end & huge/invalid pagination params handled cleanly
+    get "/api/v1/tickets/#{oldest_ticket_id}/comments",
+      params: { page: 4, per_page: 2 },
+      headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [], json_body["comments"]
+    assert_equal 6, json_body["count"]
+    assert_nil json_body["next_page"]
+    assert_equal 3, json_body["previous_page"]
+
+    get "/api/v1/tickets",
+      params: { page: "99999999999999999999999", per_page: "500" },
+      headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+    assert_equal 100, json_body["per_page"]
+    assert_nil json_body["next_page"]
+
+    get "/api/v1/tickets",
+      params: { page: "-1", per_page: "abc" },
+      headers: account_headers("acme", token: @owner_token)
+    assert_response :ok
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+  end
+end
diff --git a/test/integration/ticket_assignments_and_private_notes_test.rb b/test/integration/ticket_assignments_and_private_notes_test.rb
