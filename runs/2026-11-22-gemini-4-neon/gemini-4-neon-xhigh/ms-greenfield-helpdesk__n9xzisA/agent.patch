+++ b/test/integration/customer_registration_test.rb
@@ -0,0 +1,226 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class CustomerRegistrationTest < ActionDispatch::IntegrationTest
+  setup do
+    create_account_via_api
+    verify_last_email!(subdomain: "acme")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "customer registers and uses existing verification, login, profile, password change, recovery, and logout flows" do
+    # 1. Register customer
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      register_customer_via_api
+    end
+    assert_response :created
+
+    user = json_body["user"]
+    assert_kind_of Integer, user["id"]
+    assert_equal "Avery", user["name"]
+    assert_equal "avery@example.test", user["email"]
+    assert_equal "customer", user["role"]
+    assert_equal false, user["verified"]
+    assert_nil user["email_verified_at"]
+    assert_not_nil user["created_at"]
+    assert_not_nil user["updated_at"]
+    assert_not user.key?("password_digest")
+
+    # Verification email sent with tenant link
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], mail.to
+    link = extract_link_from_mail(mail, path: "/verify-email")
+    query = extract_query_params(link)
+    assert_equal "acme", query["account"]
+
+    # 2. Cannot sign in before verifying email
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+    assert_equal "email_not_verified", json_body["code"]
+
+    # 3. Resend verification works
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "avery@example.test" } },
+        headers: account_headers("acme"),
+        as: :json
+    end
+    assert_response :ok
+
+    # Confirm using latest email
+    verify_last_email!(subdomain: "acme")
+    assert_equal true, json_body.dig("user", "verified")
+    assert_equal "customer", json_body.dig("user", "role")
+
+    # 4. Sign in
+    token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+    assert_equal "customer", json_body.dig("user", "role")
+
+    # 5. Profile view & update
+    get "/api/v1/me", headers: account_headers("acme", token: token)
+    assert_response :ok
+    assert_equal "Avery", json_body.dig("user", "name")
+
+    patch "/api/v1/me",
+      params: { user: { name: "Avery Jordan" } },
+      headers: account_headers("acme", token: token),
+      as: :json
+    assert_response :ok
+    assert_equal "Avery Jordan", json_body.dig("user", "name")
+
+    # 6. Password change revokes old session
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-customer-password", password: "customer-password-2" } },
+      headers: account_headers("acme", token: token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("acme", token: token)
+    assert_response :unauthorized
+
+    # 7. Password reset flow
+    ActionMailer::Base.deliveries.clear
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "avery@example.test" } },
+        headers: account_headers("acme"),
+        as: :json
+    end
+    assert_response :ok
+
+    reset_token = extract_query_params(
+      extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password")
+    )["token"]
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "customer-password-3" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    new_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "customer-password-3")
+    assert_not_empty new_token
+
+    # 8. Sign out
+    delete "/api/v1/session", headers: account_headers("acme", token: new_token)
+    assert_response :no_content
+
+    get "/api/v1/me", headers: account_headers("acme", token: new_token)
+    assert_response :unauthorized
+  end
+
+  test "registration forces customer role and rejects invalid or duplicate inputs without sending email" do
+    # Cannot escalate role or pre-verify via params
+    post "/api/v1/registrations",
+      params: {
+        user: {
+          name: "Avery",
+          email: "avery@example.test",
+          password: "my-customer-password",
+          role: "admin",
+          email_verified_at: Time.current.iso8601
+        }
+      },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    assert_equal "customer", json_body.dig("user", "role")
+    assert_equal false, json_body.dig("user", "verified")
+    ActionMailer::Base.deliveries.clear
+
+    # Duplicate email (case-insensitive) in same account fails
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      register_customer_via_api(email: "AVERY@EXAMPLE.TEST")
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "email").present?
+
+    # Duplicate email against existing staff email fails
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      register_customer_via_api(email: "jo@acme.test")
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "email").present?
+
+    # Short password and blank name fail
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      register_customer_via_api(name: "  ", email: "bad-email", password: "short")
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "name").present?
+    assert json_body.dig("errors", "email").present?
+    assert json_body.dig("errors", "password").present?
+
+    # Non-string password returns 422 cleanly
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      post "/api/v1/registrations",
+        params: { user: { name: "Num", email: "num@example.test", password: 12345678 } },
+        headers: account_headers("acme"),
+        as: :json
+    end
+    assert_response :unprocessable_content
+    assert json_body.dig("errors", "password").present?
+
+    # Missing user envelope returns 400
+    post "/api/v1/registrations",
+      params: {},
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :bad_request
+    assert_equal "parameter_missing", json_body["code"]
+  end
+
+  test "same customer email can register independently across different accounts" do
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Sam", email: "sam@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    ActionMailer::Base.deliveries.clear
+
+    register_customer_via_api(subdomain: "acme", name: "Avery Acme", email: "avery@example.test", password: "acme-customer-pass")
+    assert_response :created
+    verify_last_email!(subdomain: "acme")
+
+    register_customer_via_api(subdomain: "globex", name: "Avery Globex", email: "avery@example.test", password: "globex-customer-pass")
+    assert_response :created
+    verify_last_email!(subdomain: "globex")
+
+    acme_token = sign_in_via_api(subdomain: "acme", email: "avery@example.test", password: "acme-customer-pass")
+    globex_token = sign_in_via_api(subdomain: "globex", email: "avery@example.test", password: "globex-customer-pass")
+
+    get "/api/v1/me", headers: account_headers("acme", token: acme_token)
+    assert_response :ok
+    assert_equal "Avery Acme", json_body.dig("user", "name")
+
+    get "/api/v1/me", headers: account_headers("globex", token: globex_token)
+    assert_response :ok
+    assert_equal "Avery Globex", json_body.dig("user", "name")
+
+    # Cross-account token rejected
+    get "/api/v1/me", headers: account_headers("globex", token: acme_token)
+    assert_response :unauthorized
+  end
+
+  test "registration requires an active existing account" do
+    post "/api/v1/registrations",
+      params: { user: { name: "Avery", email: "avery@example.test", password: "my-customer-password" } },
+      as: :json
+    assert_response :bad_request
+
+    register_customer_via_api(subdomain: "nonexistent")
+    assert_response :not_found
+
+    owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+
+    assert_no_difference [ "User.count", "ActionMailer::Base.deliveries.size" ] do
+      register_customer_via_api(subdomain: "acme")
+    end
+    assert_response :forbidden
+    assert_equal "account_cancelled", json_body["code"]
+  end
+end
diff --git a/test/integration/edge_cases_test.rb b/test/integration/edge_cases_test.rb
new file mode 100644
index 0000000..0333697
--- /dev/null
+++ b/test/integration/edge_cases_test.rb
@@ -0,0 +1,211 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class EdgeCasesTest < ActionDispatch::IntegrationTest
+  test "CORS headers are included on 4xx error responses for allowed origin and omitted for disallowed origin" do
+    with_env(HELPDESK_FRONTEND_URL: nil) do
+      get "/api/v1/portal", headers: account_headers("missing", extra: { "Origin" => "http://localhost:3001" })
+      assert_response :not_found
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+      get "/api/v1/portal", headers: account_headers("missing", extra: { "Origin" => "http://attacker.test" })
+      assert_response :not_found
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+
+      # Preflight for PUT
+      options "/api/v1/me/password",
+        headers: {
+          "Origin" => "http://localhost:3001",
+          "Access-Control-Request-Method" => "PUT",
+          "Access-Control-Request-Headers" => "Content-Type, X-Helpdesk-Account, Authorization"
+        }
+      assert_response :ok
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+      assert_includes response.headers["Access-Control-Allow-Methods"], "PUT"
+    end
+  end
+
+  test "non-owner admin cannot cancel account or sign in while cancelled" do
+    create_account_via_api
+    verify_last_email!(subdomain: "acme")
+    account = Account.find_by!(subdomain: "acme")
+    owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    other_admin = account.users.create!(
+      name: "Sam Admin",
+      email: "sam@acme.test",
+      password: "sam-password-123",
+      role: "admin",
+      email_verified_at: Time.current
+    )
+    sam_token = sign_in_via_api(subdomain: "acme", email: other_admin.email, password: "sam-password-123")
+
+    # Non-owner admin cannot cancel
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: sam_token)
+    assert_response :forbidden
+    assert account.reload.active?
+
+    # Owner cancels
+    post "/api/v1/account/cancel", headers: account_headers("acme", token: owner_token)
+    assert_response :ok
+
+    # Non-owner admin cannot sign in while cancelled
+    post "/api/v1/sessions",
+      params: { session: { email: other_admin.email, password: "sam-password-123" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+    assert_equal "account_cancelled", json_body["code"]
+  end
+
+  test "changing password revokes only that user's sessions, not other users in the same account" do
+    create_account_via_api
+    verify_last_email!(subdomain: "acme")
+    account = Account.find_by!(subdomain: "acme")
+    jo_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    account.users.create!(
+      name: "Alex",
+      email: "alex@acme.test",
+      password: "alex-password",
+      role: "agent",
+      email_verified_at: Time.current
+    )
+    alex_token = sign_in_via_api(subdomain: "acme", email: "alex@acme.test", password: "alex-password")
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: account_headers("acme", token: jo_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("acme", token: jo_token)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: account_headers("acme", token: alex_token)
+    assert_response :ok
+    assert_equal "Alex", json_body.dig("user", "name")
+  end
+
+  test "password reset does not bypass email verification requirement" do
+    create_account_via_api
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    reset_token = extract_query_params(extract_link_from_mail(ActionMailer::Base.deliveries.last, path: "/reset-password"))["token"]
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :ok
+
+    # Still must verify email before signing in
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+    assert_equal "email_not_verified", json_body["code"]
+  end
+
+  test "reactivated account is not purged after 90 days and re-cancelling starts a fresh 90-day window" do
+    start_time = Time.current.change(usec: 0)
+    create_account_via_api
+    verify_last_email!(subdomain: "acme")
+    account = Account.find_by!(subdomain: "acme")
+    token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    # Day 0: cancel
+    travel_to start_time do
+      post "/api/v1/account/cancel", headers: account_headers("acme", token: token)
+      assert_response :ok
+    end
+
+    # Day 50: reactivate
+    owner_token = nil
+    travel_to start_time + 50.days do
+      owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+      post "/api/v1/account/reactivate", headers: account_headers("acme", token: owner_token)
+      assert_response :ok
+    end
+
+    # Day 60: cancel again
+    travel_to start_time + 60.days do
+      post "/api/v1/account/cancel", headers: account_headers("acme", token: owner_token)
+      assert_response :ok
+    end
+
+    # Day 100 (40 days after 2nd cancel, 100 days after 1st): NOT purged!
+    travel_to start_time + 100.days do
+      assert_equal 0, Account.purge_expired_cancelled!
+      assert Account.exists?(account.id)
+    end
+
+    # Day 151 (91 days after 2nd cancel): purged!
+    travel_to start_time + 151.days do
+      assert_equal 1, Account.purge_expired_cancelled!
+      assert_not Account.exists?(account.id)
+    end
+  end
+
+  test "malformed parameter types and authorization headers return clean 4xx JSON" do
+    create_account_via_api
+    verify_last_email!(subdomain: "acme")
+
+    # Non-hash envelope
+    post "/api/v1/sessions",
+      params: { session: "not-a-hash" },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :bad_request
+
+    # Non-scalar values inside envelope
+    post "/api/v1/sessions",
+      params: { session: { email: [ "jo@acme.test" ], password: { a: 1 } } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    # Blank email/token on verification and reset endpoints
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "   " } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: "" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: "", password: "new-password-123" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    # Invalid Authorization headers
+    [ "", "Basic abc123", "Token abc123", "Bearer ", "Bearer invalid-token" ].each do |auth|
+      get "/api/v1/me", headers: account_headers("acme", extra: { "Authorization" => auth })
+      assert_response :unauthorized, "Expected 401 for Authorization: #{auth.inspect}"
+    end
+
+    delete "/api/v1/session", headers: account_headers("acme")
+    assert_response :unauthorized
+  end
+end
diff --git a/test/integration/email_support_test.rb b/test/integration/email_support_test.rb
new file mode 100644
index 0000000..fdc577a
--- /dev/null
+++ b/test/integration/email_support_test.rb
@@ -0,0 +1,854 @@
+# frozen_string_literal: true
+
+require "test_helper"
+
+class EmailSupportTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  RELAY_PASSWORD = "test-inbound-secret-password"
+
+  setup do
+    create_account_via_api(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "acme-password")
+    verify_last_email!(subdomain: "acme")
+    @acme = Account.find_by!(subdomain: "acme")
+    @acme_owner_token = sign_in_via_api(subdomain: "acme", email: "jo@acme.test", password: "acme-password")
+
+    create_account_via_api(name: "Globex", subdomain: "globex", admin_name: "Sam", email: "sam@globex.test", password: "globex-password")
+    verify_last_email!(subdomain: "globex")
+    @globex = Account.find_by!(subdomain: "globex")
+    @globex_owner_token = sign_in_via_api(subdomain: "globex", email: "sam@globex.test", password: "globex-password")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def relay_auth_header(username: "actionmailbox", password: RELAY_PASSWORD)
+    ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+  end
+
+  def build_rfc822(from:, to:, subject: "Help needed", body: "Please help me.", cc: nil, message_id: nil, extra_headers: {})
+    lines = []
+    lines << "From: #{from}" if from
+    lines << "To: #{to}" if to
+    lines << "Cc: #{cc}" if cc
+    lines << "Subject: #{subject}" unless subject.nil?
+    lines << "Message-ID: #{message_id}" if message_id
+    lines << "MIME-Version: 1.0"
+    lines << "Content-Type: text/plain; charset=UTF-8"
+    extra_headers.each { |k, v| lines << "#{k}: #{v}" }
+    "#{lines.join("\r\n")}\r\n\r\n#{body}\r\n"
+  end
+
+  def post_relay(raw_email, password: RELAY_PASSWORD, username: "actionmailbox", content_type: "message/rfc822", include_auth: true)
+    headers = { "Content-Type" => content_type }
+    headers["Authorization"] = relay_auth_header(username: username, password: password) if include_auth
+
+    post RELAY_PATH, params: raw_email, headers: headers
+  end
+
+  test "relay ingress requires HTTP basic auth with RAILS_INBOUND_EMAIL_PASSWORD and message/rfc822" do
+    raw = build_rfc822(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Auth check",
+      body: "Hello",
+      message_id: "<auth-1@example.test>"
+    )
+
+    with_env(RAILS_INBOUND_EMAIL_PASSWORD: RELAY_PASSWORD) do
+      # Missing auth
+      post_relay(raw, include_auth: false)
+      assert_response :unauthorized
+
+      # Wrong password
+      post_relay(raw, password: "wrong-password")
+      assert_response :unauthorized
+
+      # Wrong username
+      post_relay(raw, username: "wronguser")
+      assert_response :unauthorized
+
+      # Wrong content type
+      post_relay(raw, content_type: "text/plain")
+      assert_response :unsupported_media_type
+
+      # No tickets created from rejected requests
+      assert_equal 0, Ticket.count
+
+      # Valid request processes synchronously before response completes
