+  test "full invitation flow: invite agent, preview, accept without verification email, sign in, invite admin" do
+    # 1. Admin invites Sam as agent
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      invite_staff_via_api(token: @owner_token, email: "  Sam@Example.Test  ", role: "agent")
+    end
+    assert_response :created
+
+    invitation = json_body["invitation"]
+    assert_kind_of Integer, invitation["id"]
+    assert_equal @acme.id, invitation["account_id"]
