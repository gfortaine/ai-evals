+    assert_nil pages.last.dig("links", "next")
+
+    backward_pages = collect_backward_pages(pages.last.dig("links", "prev"), collection_key: "tickets", headers: headers)
+    assert_equal 1, backward_pages.size
+    assert_equal ids.reverse[0..1], backward_pages.first["tickets"].map { |t| t["id"] }
+    assert_equal false, backward_pages.first.dig("meta", "has_more")
+    assert_nil backward_pages.first.dig("links", "prev")
+    assert_not_nil backward_pages.first.dig("links", "next")
+  end
+
+  test "supports cursor pagination on all 9 existing collections (forward and backward)" do
+    base_time = Time.utc(2026, 11, 20, 12, 0, 0)
+    owner_headers = account_headers("acme", token: @owner_token)
