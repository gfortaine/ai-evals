+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,16 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest lists published books with short edit dates" do
+    books(:handbook).update_columns(published: true, updated_at: Time.utc(2024, 6, 17, 14, 30, 0))
+    books(:manual).update_columns(published: false, updated_at: Time.utc(2024, 6, 18, 10, 0, 0))
+
+    email = ReportDigestMailer.weekly(users(:david))
+
+    assert_equal [ "david@example.com" ], email.to
+    assert_equal "Your Writebook digest", email.subject
+    assert_includes email.body.encoded, "Hi David,"
+    assert_includes email.body.encoded, "* Handbook, last edited 17 Jun"
+    assert_not_includes email.body.encoded, "* Manual"
+  end
+end
diff --git a/test/models/book/reportable_test.rb b/test/models/book/reportable_test.rb
new file mode 100644
index 0000000..598e2b0
--- /dev/null
+++ b/test/models/book/reportable_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report_summary formats character counts with delimiters" do
+    book = books(:handbook)
+    pages(:welcome).update!(body: "x" * 1_500)
+
+    expected_length = book.markable.length.to_fs(:delimited)
+    assert_includes expected_length, ","
+    assert_equal "Handbook — #{expected_length} characters", book.report_summary
+  end
+
+  test "report_summary handles an empty book" do
+    assert_equal "Manual — 0 characters", books(:manual).report_summary
+  end
+
+  test "leaf_count counts active leaves" do
+    assert_equal 4, books(:handbook).leaf_count
+
+    leaves(:summary_page).trashed!
+    assert_equal 3, books(:handbook).leaf_count
+  end
+
+  test "last_edited_at returns the latest active leaf timestamp or nil when empty" do
+    assert_nil books(:manual).last_edited_at
+
+    older = Time.utc(2024, 6, 1, 9, 0, 0)
+    latest = Time.utc(2024, 6, 17, 14, 30, 5)
+    books(:handbook).leaves.update_all(updated_at: older)
+    leaves(:welcome_page).update_columns(updated_at: latest)
+
+    assert_equal latest, books(:handbook).last_edited_at
+  end
+end
