diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..f5dac9d
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  test "archives book with default formatted last_edited_at timestamp" do
+    book = books(:handbook)
+    timestamp = Time.utc(2024, 6, 17, 14, 30, 5)
+    book.leaves.active.update_all(updated_at: timestamp)
+    archive_path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+
+    ReportArchiveJob.perform_now(book)
+
+    assert File.exist?(archive_path)
+    content = File.read(archive_path)
+    assert_equal "# archived 2024-06-17 14:30:05 UTC\n\n#{book.markable}", content
+  ensure
+    FileUtils.rm_f(archive_path) if archive_path
+  end
+
+  test "archives book with no active leaves" do
+    book = books(:manual)
+    archive_path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+
+    ReportArchiveJob.perform_now(book)
+
+    assert File.exist?(archive_path)
+    assert_equal "# archived \n\n", File.read(archive_path)
+  ensure
+    FileUtils.rm_f(archive_path) if archive_path
+  end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..b5c51ea
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text formats rows and active leaf ids" do
+    book = books(:handbook)
+    book.update_columns(
+      created_at: Time.utc(2024, 6, 1, 9, 15, 0),
+      updated_at: Time.utc(2024, 6, 17, 14, 30, 5)
+    )
+    leaves(:summary_page).trashed!
+
+    expected_ids = [ leaves(:welcome_section), leaves(:welcome_page), leaves(:reading_picture) ].map(&:id).join(",")
+    expected = <<~TEXT
+      Book: Handbook
+      Leaves: 3
+      Started: June 01, 2024 09:15
+      Updated: 17 Jun 14:30
+      Covers: #{expected_ids}
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+
+  test "to_text formats empty leaves as null" do
+    book = books(:manual)
+    book.update_columns(
+      created_at: Time.utc(2024, 6, 1, 9, 15, 0),
+      updated_at: Time.utc(2024, 6, 17, 14, 30, 5)
+    )
+
+    expected = <<~TEXT
+      Book: Manual
+      Leaves: 0
+      Started: June 01, 2024 09:15
+      Updated: 17 Jun 14:30
+      Covers: null
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+end
diff --git a/test/mailers/report_digest_mailer_test.rb b/test/mailers/report_digest_mailer_test.rb
