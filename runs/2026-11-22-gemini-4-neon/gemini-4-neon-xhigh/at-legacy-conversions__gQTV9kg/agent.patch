diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..a64f62f
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "show renders the shelf report with formatted date and delimited character count" do
+    book = books(:handbook)
+    pages(:welcome).update!(body: "a" * 1_200)
+    book.update_columns(updated_at: Time.utc(2024, 6, 17, 14, 30, 5))
+
+    get book_report_path(book)
+
+    assert_response :success
+    assert_in_body "Handbook"
+    assert_in_body "Last updated June 17, 2024"
+    assert_in_body "Handbook — #{book.markable.length.to_fs(:delimited)} characters"
+    assert_in_body "1,2"
+    assert_in_body book_report_path(book, format: :text)
+  end
+
+  test "show as text downloads the report card with numbered timestamp filename" do
+    book = books(:handbook)
+    book.update_columns(
+      created_at: Time.utc(2024, 6, 1, 9, 15, 0),
+      updated_at: Time.utc(2024, 6, 17, 14, 30, 5)
+    )
+
+    get book_report_path(book, format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_includes response.headers["Content-Disposition"], "filename=\"shelf-report-20240617143005.txt\""
+    assert_in_body "Book: Handbook\n"
+    assert_in_body "Leaves: 4\n"
+    assert_in_body "Started: June 01, 2024 09:15\n"
+    assert_in_body "Updated: 17 Jun 14:30\n"
+    assert_in_body "Covers: #{book.leaves.active.positioned.ids.join(",")}\n"
+  end
+
+  test "show as text handles a book with no active leaves" do
+    book = books(:manual)
+    book.update_columns(
+      created_at: Time.utc(2024, 6, 1, 9, 15, 0),
+      updated_at: Time.utc(2024, 6, 17, 14, 30, 5)
+    )
+
+    get book_report_path(book, format: :text)
+
+    assert_response :success
+    assert_in_body "Leaves: 0\n"
+    assert_in_body "Covers: null\n"
+  end
+end
