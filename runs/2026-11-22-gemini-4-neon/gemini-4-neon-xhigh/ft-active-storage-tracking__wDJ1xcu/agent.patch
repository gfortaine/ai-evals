--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,20 @@
+module Storage
+  def self.table_name_prefix
+    "storage_"
+  end
+
+  def self.materialize_pending
+    account_ids = Storage::Entry.distinct.pluck(:account_id)
+    return if account_ids.empty?
+
+    existing_ids = Account.where(id: account_ids).pluck(:id)
+    orphaned_ids = account_ids - existing_ids
+    Storage::Entry.where(account_id: orphaned_ids).delete_all if orphaned_ids.any?
+
+    Account.where(id: existing_ids).find_each(&:materialize_storage_later)
+  end
+
+  def self.reconcile_all_later
+    Storage::ReconcileAllJob.perform_later
+  end
+end
diff --git a/app/models/storage/attachment_tracker.rb b/app/models/storage/attachment_tracker.rb
new file mode 100644
index 0000000..6b4fd3b
--- /dev/null
+++ b/app/models/storage/attachment_tracker.rb
@@ -0,0 +1,67 @@
+class Storage::AttachmentTracker
+  attr_reader :attachment
+
+  def initialize(attachment)
+    @attachment = attachment
+  end
+
+  def track_addition
+    track(operation: "attach", sign: 1)
+  end
+
+  def track_removal
+    track(operation: "detach", sign: -1)
+  end
+
+  private
+    def track(operation:, sign:)
+      account_id, board_id = resolve_target
+      return unless account_id && board_id
+
+      byte_size = attachment.blob&.byte_size.to_i
+      return if byte_size.zero?
+
+      Storage::Entry.record(
+        account_id: account_id,
+        board_id: board_id,
+        blob_id: attachment.blob_id,
+        delta: byte_size * sign,
+        operation: operation
+      )
+    end
+
+    def resolve_target
+      case attachment.record_type
+      when "Card"
+        resolve_card_image
+      when "ActionText::RichText"
+        resolve_rich_text_embed
+      end
+    end
+
+    def resolve_card_image
+      if attachment.name == "image" && (card = attachment.record)
+        [ card.account_id, card.board_id ]
+      end
+    end
+
+    def resolve_rich_text_embed
+      return unless attachment.name == "embeds"
+
+      rich_text = attachment.record
+      return unless rich_text
+
+      case [ rich_text.record_type, rich_text.name ]
+      when [ "Board", "public_description" ]
+        [ rich_text.account_id, rich_text.record_id ]
+      when [ "Card", "description" ]
+        if card = rich_text.record
+          [ card.account_id, card.board_id ]
+        end
+      when [ "Comment", "body" ]
+        if card = rich_text.record&.card
+          [ card.account_id, card.board_id ]
+        end
+      end
+    end
+end
diff --git a/app/models/storage/calculator.rb b/app/models/storage/calculator.rb
new file mode 100644
index 0000000..e07d2c9
--- /dev/null
+++ b/app/models/storage/calculator.rb
@@ -0,0 +1,66 @@
+class Storage::Calculator
+  BATCH_SIZE = 1000
+
+  class << self
+    def card_bytes(card)
+      card_image_bytes(card.account_id, [ card.id ]) +
+        rich_text_embed_bytes(card.account_id, "Card", [ card.id ], "description") +
+        card_comments_bytes(card.account_id, [ card.id ])
+    end
+
+    def board_bytes(board)
+      total = rich_text_embed_bytes(board.account_id, "Board", [ board.id ], "public_description")
+
+      board.cards.in_batches(of: BATCH_SIZE) do |cards|
+        card_ids = cards.pluck(:id)
+        total += card_image_bytes(board.account_id, card_ids)
+        total += rich_text_embed_bytes(board.account_id, "Card", card_ids, "description")
+        total += card_comments_bytes(board.account_id, card_ids)
+      end
+
+      total
+    end
+
+    private
+      def card_image_bytes(account_id, card_ids)
+        return 0 if card_ids.empty?
+
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .where(account_id: account_id, record_type: "Card", record_id: card_ids, name: "image")
+          .sum("active_storage_blobs.byte_size")
+          .to_i
+      end
+
+      def card_comments_bytes(account_id, card_ids)
+        return 0 if card_ids.empty?
+
+        total = 0
+
+        Comment.where(account_id: account_id, card_id: card_ids).in_batches(of: BATCH_SIZE) do |comments|
+          comment_ids = comments.pluck(:id)
+          total += rich_text_embed_bytes(account_id, "Comment", comment_ids, "body")
+        end
+
+        total
+      end
+
+      def rich_text_embed_bytes(account_id, record_type, record_ids, name)
+        return 0 if record_ids.empty?
+
+        rich_text_ids = ActionText::RichText
+          .where(account_id: account_id, record_type: record_type, record_id: record_ids, name: name)
+          .pluck(:id)
+
+        if rich_text_ids.any?
+          ActiveStorage::Attachment
+            .joins(:blob)
+            .where(account_id: account_id, record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+            .sum("active_storage_blobs.byte_size")
+            .to_i
+        else
+          0
+        end
+      end
+  end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..639ac9e
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,62 @@
+class Storage::Entry < ApplicationRecord
+  OPERATIONS = %w[ attach detach transfer ].freeze
+
+  belongs_to :account
+  belongs_to :board, optional: true
+  belongs_to :blob, class_name: "ActiveStorage::Blob", optional: true
+
+  validates :operation, inclusion: { in: OPERATIONS }
+
+  class << self
+    def record(account_id:, board_id:, delta:, operation:, blob_id: nil)
+      return if delta.zero?
+
+      create!(
+        account_id: account_id,
+        board_id: board_id,
+        blob_id: blob_id,
+        delta: delta,
+        operation: operation
+      )
+
+      schedule_materialization(account_id)
+    end
+
+    private
+      def schedule_materialization(account_id)
+        transaction = current_transaction
+
+        if transaction.open?
+          schedule_after_commit(transaction, account_id)
+        else
+          enqueue_materialization(account_id)
+        end
+      end
+
+      def schedule_after_commit(transaction, account_id)
+        pending = pending_materializations
+
+        unless pending.key?(transaction.uuid)
+          pending[transaction.uuid] = Set.new
+          transaction.after_rollback { pending.delete(transaction.uuid) }
+        end
+
+        if pending[transaction.uuid].add?(account_id)
+          transaction.after_commit do
+            pending.delete(transaction.uuid)
+            enqueue_materialization(account_id)
+          end
+        end
+      end
+
+      def pending_materializations
+        Thread.current[:storage_pending_materializations] ||= {}
+      end
+
+      def enqueue_materialization(account_id)
+        if account = Account.find_by(id: account_id)
+          account.materialize_storage_later
+        end
+      end
+  end
+end
diff --git a/app/models/storage/materializer.rb b/app/models/storage/materializer.rb
new file mode 100644
index 0000000..fc99879
--- /dev/null
+++ b/app/models/storage/materializer.rb
@@ -0,0 +1,97 @@
+class Storage::Materializer
+  BATCH_SIZE = 1000
+  MAX_BATCHES_PER_RUN = 100
+
+  attr_reader :account
+
+  def initialize(account)
+    @account = account
+  end
+
+  def materialize
+    return unless account.storage_entries.exists?
+    return unless Account.exists?(account.id)
+
+    account_total = Storage::Total.for(account)
+    batches = 0
+
+    while batches < MAX_BATCHES_PER_RUN
+      status = materialize_batch(account_total)
+      break if status == :done
+
+      account_total = Storage::Total.for(account) if status == :reload
+      batches += 1
+      break if status == :drained
+    end
+
+    reschedule if account.storage_entries.exists?
+  end
+
+  private
+    def materialize_batch(account_total)
+      status = :done
+
+      account_total.with_lock do
+        entries = account.storage_entries.limit(BATCH_SIZE).pluck(:id, :board_id, :delta)
+
+        if entries.any?
+          entry_ids, account_delta, board_deltas = aggregate_entries(entries)
+          deleted = Storage::Entry.where(id: entry_ids).delete_all
+
+          if deleted == entry_ids.size
+            apply_board_deltas(board_deltas) if board_deltas.any?
+            apply_delta(account_total, account_delta)
+            status = entries.size < BATCH_SIZE ? :drained : :processed
+          else
+            status = :retry
+            raise ActiveRecord::Rollback
+          end
+        end
+      end
+
+      status
+    rescue ActiveRecord::RecordNotFound
+      Account.exists?(account.id) ? :reload : :done
+    end
+
+    def aggregate_entries(entries)
+      entry_ids = []
+      account_delta = 0
+      board_deltas = Hash.new(0)
+
+      entries.each do |id, board_id, delta|
+        entry_ids << id
+        account_delta += delta
+        board_deltas[board_id] += delta if board_id
+      end
+
+      [ entry_ids, account_delta, board_deltas ]
+    end
+
+    def apply_board_deltas(board_deltas)
+      existing_boards = account.boards.where(id: board_deltas.keys).order(:id).to_a
+      return if existing_boards.empty?
+
+      totals_by_board_id = Storage::Total
+        .where(owner_type: "Board", owner_id: existing_boards.map(&:id))
+        .index_by(&:owner_id)
+
+      existing_boards.each do |board|
+        board_total = totals_by_board_id[board.id] || Storage::Total.for(board)
+        apply_delta(board_total, board_deltas[board.id])
+      end
+    end
+
+    def apply_delta(total, delta)
+      Storage::Total.where(id: total.id).update_all([
+        "bytes_used = bytes_used + ?, revision = revision + 1, updated_at = ?",
+        delta, Time.current
+      ])
+    end
+
+    def reschedule
+      Current.with_account(account) do
+        Storage::MaterializeJob.set(wait: 1.second).perform_later(account)
+      end
+    end
+end
diff --git a/app/models/storage/reconciler.rb b/app/models/storage/reconciler.rb
new file mode 100644
index 0000000..3d2f761
--- /dev/null
+++ b/app/models/storage/reconciler.rb
@@ -0,0 +1,94 @@
+class Storage::Reconciler
+  MAX_ATTEMPTS = 3
+
+  def reconcile_board(board)
+    account = board.account
+    account.materialize_storage
+
+    MAX_ATTEMPTS.times do
+      return true unless Board.exists?(board.id)
+
+      board_total = Storage::Total.for(board)
+      before_revision = board_total.revision
+      actual_bytes = Storage::Calculator.board_bytes(board)
+
+      return true if apply_board_reconciliation(account, board, before_revision, actual_bytes)
+
+      account.materialize_storage
+    end
+
+    false
+  end
+
+  def reconcile_account(account)
+    account.materialize_storage
+
+    account.boards.find_each do |board|
+      reconcile_board(board)
+    end
+
+    reconcile_account_total(account)
+  end
+
+  def reconcile_account_total(account)
+    return unless Account.exists?(account.id)
+
+    account_total = Storage::Total.for(account)
+
+    account_total.with_lock do
+      remove_orphaned_board_totals(account)
+
+      unless account.storage_entries.exists?
+        boards_sum = Storage::Total.where(account_id: account.id, owner_type: "Board").sum(:bytes_used).to_i
+
+        if account_total.bytes_used != boards_sum
+          Storage::Total.where(id: account_total.id).update_all([
+            "bytes_used = ?, revision = revision + 1, updated_at = ?",
+            boards_sum, Time.current
+          ])
+        end
+      end
+    end
+  end
+
+  private
+    def apply_board_reconciliation(account, board, before_revision, actual_bytes)
+      account_total = Storage::Total.for(account)
+
+      account_total.with_lock do
+        return true unless Board.exists?(board.id)
+
+        board_total = Storage::Total.find_by(owner: board)
+        return false unless board_total && board_total.revision == before_revision
+        return false if account.storage_entries.where(board_id: board.id).exists?
+
+        drift = actual_bytes - board_total.bytes_used
+
+        if drift != 0
+          now = Time.current
+          Storage::Total.where(id: board_total.id).update_all([
+            "bytes_used = ?, revision = revision + 1, updated_at = ?",
+            actual_bytes, now
+          ])
+          Storage::Total.where(id: account_total.id).update_all([
+            "bytes_used = bytes_used + ?, revision = revision + 1, updated_at = ?",
+            drift, now
+          ])
+        end
+
+        true
+      end
+    end
+
+    def remove_orphaned_board_totals(account)
+      board_total_owner_ids = Storage::Total.where(account_id: account.id, owner_type: "Board").pluck(:owner_id)
+      return if board_total_owner_ids.empty?
+
+      existing_board_ids = account.boards.where(id: board_total_owner_ids).pluck(:id)
+      orphaned_ids = board_total_owner_ids - existing_board_ids
+
+      if orphaned_ids.any?
+        Storage::Total.where(account_id: account.id, owner_type: "Board", owner_id: orphaned_ids).delete_all
+      end
+    end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
