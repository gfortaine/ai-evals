+class Storage::ReconcileAllJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform
+    step :reconcile_accounts do |step|
+      Account.active.find_each(start: step.cursor) do |account|
+        account.reconcile_storage_later
+        step.advance! from: account.id
+      end
+    end
+  end
+end
