@@ -0,0 +1,20 @@
+class Storage::Total < ApplicationRecord
+  belongs_to :account, default: -> { owner.account }
+  belongs_to :owner, polymorphic: true
+
+  class << self
+    def for(owner)
+      find_by(owner: owner) || create_or_find_by!(owner_type: owner.class.name, owner_id: owner.id) do |total|
+        total.account_id = owner.account.id
+      end
+    end
+
+    def bytes_used_for(owner)
+      if owner.persisted?
+        where(owner: owner).pick(:bytes_used) || 0
+      else
+        0
+      end
+    end
+  end
+end
diff --git a/app/models/storage/tracked.rb b/app/models/storage/tracked.rb
