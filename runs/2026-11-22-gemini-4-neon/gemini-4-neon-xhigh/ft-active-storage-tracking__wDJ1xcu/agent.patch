+++ b/app/models/storage/tracked.rb
@@ -0,0 +1,17 @@
+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total", dependent: :destroy
+  end
+
+  def bytes_used
+    raw_bytes = if association(:storage_total).loaded?
+      storage_total&.bytes_used || 0
+    else
+      Storage::Total.bytes_used_for(self)
+    end
+
+    [ raw_bytes, 0 ].max
+  end
+end
