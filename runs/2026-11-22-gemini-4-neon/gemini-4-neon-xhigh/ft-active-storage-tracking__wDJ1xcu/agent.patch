+class Storage::MaterializeJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::StatementTimeout
+
+  limits_concurrency to: 1, key: ->(account) { account }, on_conflict: :discard
+
+  def perform(account)
+    account.materialize_storage
+  end
+end
