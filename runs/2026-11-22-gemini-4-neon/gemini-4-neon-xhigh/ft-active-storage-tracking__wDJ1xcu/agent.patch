+++ b/test/integration/storage_tracking_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class StorageTrackingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "tracks storage across card image upload, deletion, rich text embeds, comments, card moves, and board deletion" do
+    # 1. Attach image to card and delete via Cards::ImagesController#destroy
+    image_file = fixture_file_upload("moon.jpg", "image/jpeg")
+    image_size = file_fixture("moon.jpg").size
+
+    patch card_path(@card), as: :turbo_stream, params: { card: { image: image_file } }
+    assert_response :success
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal image_size, @board.bytes_used
+    assert_equal image_size, @account.bytes_used
+
+    # 2. Embed file in board public_description via BoardsController#update
+    board_blob = Current.with_account(@account) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("b" * 200), filename: "board.txt", content_type: "text/plain")
+    end
+
+    patch board_path(@board), params: {
+      board: { public_description: %(<action-text-attachment sgid="#{board_blob.attachable_sgid}"></action-text-attachment>) }
+    }, as: :json
+    assert_response :success
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal image_size + 200, @board.bytes_used
+    assert_equal image_size + 200, @account.bytes_used
+
+    # 3. Create comment with embedded file via Cards::CommentsController#create
+    comment_blob = Current.with_account(@account) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("c" * 300), filename: "comment.txt", content_type: "text/plain")
+    end
+
+    post card_comments_path(@card), params: {
+      comment: { body: %(<action-text-attachment sgid="#{comment_blob.attachable_sgid}"></action-text-attachment>) }
+    }, as: :json
+    assert_response :created
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal image_size + 500, @board.bytes_used
+    assert_equal image_size + 500, @account.bytes_used
+
+    # 4. Move card to another board via Cards::BoardsController#update
+    put card_board_path(@card), params: { board_id: @other_board.id }, as: :json
+    assert_response :success
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 200, @board.bytes_used
+    assert_equal image_size + 300, @other_board.bytes_used
+    assert_equal image_size + 500, @account.bytes_used
+
+    # 5. Delete card image via Cards::ImagesController#destroy
+    delete card_image_path(@card), as: :json
+    assert_response :no_content
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 200, @board.bytes_used
+    assert_equal 300, @other_board.bytes_used
+    assert_equal 500, @account.bytes_used
+
+    # 6. Delete card via CardsController#destroy
+    delete card_path(@card), as: :json
+    assert_response :no_content
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 200, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 200, @account.bytes_used
+
+    # 7. Delete board via BoardsController#destroy
+    delete board_path(@board), as: :json
+    assert_response :no_content
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 0, @account.bytes_used
+  end
+end
