+require "test_helper"
+
+class Storage::ReconcilerTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @second_board = @account.boards.create!(name: "Second Board", creator: users(:david))
+    @card = cards(:logo)
+    Current.user = users(:david)
+  end
+
+  test "reconcile_board corrects drifted board and account totals" do
+    desc_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("a" * 300), filename: "desc.txt", content_type: "text/plain")
+    comment_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("b" * 400), filename: "cm.txt", content_type: "text/plain")
+    board_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("c" * 200), filename: "bd.txt", content_type: "text/plain")
+
+    @board.update!(public_description: %(<action-text-attachment sgid="#{board_blob.attachable_sgid}"></action-text-attachment>))
+    @card.image.attach(io: StringIO.new("d" * 100), filename: "img.png", content_type: "image/png")
+    @card.update!(description: %(<action-text-attachment sgid="#{desc_blob.attachable_sgid}"></action-text-attachment>))
+    @card.comments.create!(body: %(<action-text-attachment sgid="#{comment_blob.attachable_sgid}"></action-text-attachment>))
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+
+    # Simulate drift on board and account
+    Storage::Total.for(@board).update!(bytes_used: 250)
+    Storage::Total.for(@account).update!(bytes_used: 250)
+
+    @board.reconcile_storage_later
+    perform_enqueued_jobs only: Storage::ReconcileBoardJob
+
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+  end
+
+  test "reconcile_account corrects drifted totals across boards and removes orphaned board totals" do
+    @card.image.attach(io: StringIO.new("a" * 500), filename: "one.png", content_type: "image/png")
+    card_2 = @second_board.cards.create!(title: "Two", creator: users(:david), status: :published)
+    card_2.image.attach(io: StringIO.new("b" * 700), filename: "two.png", content_type: "image/png")
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    # Introduce drift and an orphaned board total
+    Storage::Total.for(@board).update!(bytes_used: 10)
+    Storage::Total.for(@second_board).update!(bytes_used: 9999)
+    Storage::Total.for(@account).update!(bytes_used: 12345)
+
+    orphan_id = ActiveRecord::Type::Uuid.generate
+    Storage::Total.insert!({
+      id: orphan_id,
+      account_id: @account.id,
+      owner_type: "Board",
+      owner_id: ActiveRecord::Type::Uuid.generate,
+      bytes_used: 5000,
+      revision: 0,
+      created_at: Time.current,
+      updated_at: Time.current
+    })
+
+    @account.reconcile_storage_later
+    perform_enqueued_jobs only: Storage::ReconcileJob
+
+    assert_equal 500, @board.bytes_used
+    assert_equal 700, @second_board.bytes_used
+    assert_equal 1200, @account.bytes_used
+    assert_not Storage::Total.exists?(orphan_id)
+  end
+
+  test "reconcile_board handles concurrent upload during scan without losing or double-counting bytes" do
+    @card.image.attach(io: StringIO.new("a" * 500), filename: "initial.png", content_type: "image/png")
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    # Simulate drift
+    Storage::Total.for(@board).update!(bytes_used: 100)
+    Storage::Total.for(@account).update!(bytes_used: 100)
+
+    call_count = 0
+    original_board_bytes = Storage::Calculator.method(:board_bytes)
+    concurrent_card = @board.cards.create!(title: "Concurrent", creator: users(:david), status: :published)
+
+    Storage::Calculator.define_singleton_method(:board_bytes) do |board|
+      call_count += 1
+      if call_count == 1
+        concurrent_card.image.attach(io: StringIO.new("b" * 300), filename: "concurrent.png", content_type: "image/png")
+      end
+      original_board_bytes.call(board)
+    end
+
+    begin
+      assert @board.reconcile_storage
+    ensure
+      Storage::Calculator.define_singleton_method(:board_bytes, &original_board_bytes)
+    end
+
+    assert_equal 2, call_count
+    assert_equal 800, @board.bytes_used
+    assert_equal 800, @account.bytes_used
+  end
+
+  test "reconcile_board works across multiple calculator batches" do
+    card_2 = @board.cards.create!(title: "Card 2", creator: users(:david), status: :published)
