+
+    @card.image.attach(io: StringIO.new("c" * 333), filename: "img1.png", content_type: "image/png")
+    card_2.image.attach(io: StringIO.new("d" * 444), filename: "img2.png", content_type: "image/png")
+    @card.comments.create!(body: %(<action-text-attachment sgid="#{blob_1.attachable_sgid}"></action-text-attachment>))
+    @card.comments.create!(body: %(<action-text-attachment sgid="#{blob_2.attachable_sgid}"></action-text-attachment>))
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    Storage::Total.for(@board).update!(bytes_used: 0)
+    Storage::Total.for(@account).update!(bytes_used: 0)
+
+    original_batch_size = Storage::Calculator::BATCH_SIZE
+    Storage::Calculator.send(:remove_const, :BATCH_SIZE)
+    Storage::Calculator.const_set(:BATCH_SIZE, 1)
+
+    begin
+      @board.reconcile_storage
+    ensure
+      Storage::Calculator.send(:remove_const, :BATCH_SIZE)
+      Storage::Calculator.const_set(:BATCH_SIZE, original_batch_size)
+    end
+
+    assert_equal 111 + 222 + 333 + 444, @board.bytes_used
+    assert_equal 111 + 222 + 333 + 444, @account.bytes_used
+  end
+
+  test "ReconcileAllJob enqueues reconciliation for active accounts" do
+    assert_enqueued_jobs Account.active.count, only: Storage::ReconcileJob do
+      Storage::ReconcileAllJob.perform_now
+    end
+  end
+end
