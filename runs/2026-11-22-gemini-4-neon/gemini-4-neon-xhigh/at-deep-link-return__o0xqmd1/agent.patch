@@ -30,4 +32,34 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    def safe_return_to_url
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.valid_encoding? && return_to.present?
+      return if return_to.match?(/[\x00-\x1f\x7f\\]/)
+
+      uri = URI.parse(return_to)
+
+      if uri.scheme.nil?
+        return_to if uri.host.nil? && uri.opaque.nil? && return_to.start_with?("/") && !return_to.start_with?("//")
+      elsif safe_absolute_return_to?(uri, return_to)
+        uri.host = request.host
+        uri.to_s
+      end
+    rescue URI::Error, ArgumentError
+      nil
+    end
+
+    def safe_absolute_return_to?(uri, raw)
+      return false unless uri.is_a?(URI::HTTP)
+      return false unless uri.opaque.nil? && uri.userinfo.nil? && uri.user.nil? && uri.password.nil?
+      return false if raw.match?(/\Ahttps?:\/\/[^\/?#]*@/i)
+      return false unless uri.host.present? && uri.host.casecmp?(request.host)
+
+      if uri.scheme == request.scheme
+        uri.port == request.port
+      else
+        uri.scheme == "https" && request.standard_port? && uri.port == uri.default_port
+      end
+    end
 end
