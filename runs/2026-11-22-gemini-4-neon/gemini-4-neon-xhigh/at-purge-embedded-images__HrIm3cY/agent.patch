     leaves(:welcome_page).edit leafable_params: { body: "New body" }
 
@@ -63,4 +65,56 @@ class Leaf::EditableTest < ActiveSupport::TestCase
     assert leaves(:welcome_page).edits.last.trash?
     assert_equal "This is _such_ a great handbook.", leaves(:welcome_page).edits.last.page.body.content
   end
+
+  test "destroying an edited leaf purges markdown uploads from previous revisions" do
+    leaf = leaves(:welcome_page)
+    original_page = leaf.page
+    original_page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    original_page.body.save!
+
+    attachment = original_page.body.uploads.attachments.last
+    blob = attachment.blob
+
+    leaf.edit leafable_params: { body: "Updated with ![reading](#{attachment.slug_path})" }
+
+    perform_enqueued_jobs do
+      leaf.destroy
+    end
+
+    assert_not Page.exists?(original_page.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
+
+  test "destroying a trashed leaf with edits cleans up all revisions and uploads" do
+    leaf = leaves(:welcome_page)
+    original_page = leaf.page
+    original_page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    original_page.body.save!
+    first_attachment = original_page.body.uploads.attachments.last
+    first_blob = first_attachment.blob
+
+    leaf.edit leafable_params: { body: "Updated with ![reading](#{first_attachment.slug_path})" }
+    current_page = leaf.page
+    current_page.body.uploads.attach io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp"
+    current_page.body.save!
+    second_attachment = current_page.body.uploads.attachments.last
+    second_blob = second_attachment.blob
+
+    leaf.trashed!
+
+    perform_enqueued_jobs do
+      Leaf.find(leaf.id).destroy
+    end
+
+    assert_not Page.exists?(original_page.id)
+    assert_not Page.exists?(current_page.id)
+    assert_not ActiveStorage::Attachment.exists?(first_attachment.id)
+    assert_not ActiveStorage::Blob.exists?(first_blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(first_blob.key)
+    assert_not ActiveStorage::Attachment.exists?(second_attachment.id)
+    assert_not ActiveStorage::Blob.exists?(second_blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(second_blob.key)
+  end
 end
