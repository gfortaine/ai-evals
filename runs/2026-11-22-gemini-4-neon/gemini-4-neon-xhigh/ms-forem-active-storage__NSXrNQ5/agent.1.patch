+++ b/spec/models/concerns/profile_image_attachable_spec.rb
@@ -0,0 +1,360 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe ProfileImageAttachable do
+  let(:image_jpg) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:image_png) { fixture_file_upload("800x600.png", "image/png") }
+  let(:image_webp) { fixture_file_upload("800x600.webp", "image/webp") }
+  let(:image_with_gps) { fixture_file_upload("image_gps_data.jpg", "image/jpeg") }
+
+  shared_examples "a profile image attachable model" do |factory_name|
+    describe "new profile pictures go to Active Storage" do
+      it "stores uploaded image in Active Storage and leaves legacy column nil", :aggregate_failures do
+        record = create(factory_name, profile_image: image_jpg)
+        record.reload
+        first_url = record.profile_image_url
+
+        expect(record.profile_image).to be_attached
+        expect(record[:profile_image]).to be_nil
+        expect(record.profile_image.blob.content_type).to eq("image/jpeg")
+        expect(record.profile_image.blob.key).to end_with(".jpg")
+        expect(record.profile_image.blob.filename.to_s).to match(/\A[0-9a-f-]{36}\.jpg\z/)
+        expect(record.profile_image.blob.analyzed?).to be(true)
+        expect(record.profile_image.blob.metadata["width"]).to eq(800)
+        expect(record.profile_image.blob.metadata["height"]).to eq(600)
+        expect(first_url).to start_with("/rails/active_storage/blobs/proxy/")
+        expect(record.profile_image_url).to eq(first_url)
+        expect(record.profile_image_90).to eq(first_url)
+        expect(record.as_json["profile_image"]).to eq({ "url" => first_url })
+      end
+
+      it "accepts PNG and WebP images" do
+        png_record = create(factory_name, profile_image: image_png)
+        webp_record = create(factory_name, profile_image: image_webp)
+
+        expect(png_record.profile_image).to be_attached
+        expect(png_record.profile_image.blob.content_type).to eq("image/png")
+        expect(webp_record.profile_image).to be_attached
+        expect(webp_record.profile_image.blob.content_type).to eq("image/webp")
+      end
+
+      it "accepts File objects from Images::ProfileImageGenerator" do
+        record = create(factory_name, profile_image: Images::ProfileImageGenerator.call)
+
+        expect(record.profile_image).to be_attached
+        expect(record[:profile_image]).to be_nil
+        expect(record.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      end
+
+      it "strips EXIF and GPS data on upload" do
+        expect(EXIFR::JPEG.new(image_with_gps.path).exif?).to be(true)
+        expect(EXIFR::JPEG.new(image_with_gps.path).gps.present?).to be(true)
+
+        record = create(factory_name, profile_image: image_with_gps)
+        downloaded = StringIO.new(record.profile_image.download)
+
+        expect(EXIFR::JPEG.new(downloaded).exif?).to be(false)
+        downloaded.rewind
+        expect(EXIFR::JPEG.new(downloaded).gps.present?).to be(false)
+      end
+
+      it "downloads and stores remote_profile_image_url in Active Storage" do
+        stub_request(:get, "https://cdn.example.com/avatar.jpg")
+          .to_return(status: 200, body: File.binread(image_jpg.path), headers: { "Content-Type" => "image/jpeg" })
+
+        record = create(factory_name)
+        record.remote_profile_image_url = "https://cdn.example.com/avatar.jpg"
+        record.save!
+        record.reload
+
+        expect(record.profile_image).to be_attached
+        expect(record[:profile_image]).to be_nil
+        expect(record.profile_image.blob.content_type).to eq("image/jpeg")
+      end
+
+      it "handles File fallback returned by Images::SafeRemoteProfileImageUrl" do
+        record = create(factory_name)
+        record.remote_profile_image_url = Images::SafeRemoteProfileImageUrl.call("not-a-url")
+        record.save!
+
+        expect(record.profile_image).to be_attached
+        expect(record[:profile_image]).to be_nil
+      end
+
+      it "replaces an existing Active Storage image immediately without requiring reload" do
+        record = create(factory_name, profile_image: image_jpg)
+        original_url = record.profile_image_url
+
+        record.profile_image = image_png
+        record.save!
+
+        expect(record.profile_image_url).not_to eq(original_url)
+        expect(record.profile_image_url).to eq(record.reload.profile_image_url)
+        expect(record.profile_image.blob.content_type).to eq("image/png")
+      end
+    end
+
+    describe "legacy CarrierWave profile pictures stay working" do
+      let(:legacy_filename) { "legacy-12345.png" }
+      let(:legacy_record) do
+        record = create(factory_name)
+        record.profile_image.purge
+        record.update_columns(profile_image: legacy_filename)
+        record.reload
+      end
+
+      it "serves the exact CarrierWave URL when no Active Storage attachment exists" do
+        expected_url = "/uploads/#{factory_name}/profile_image/#{legacy_record.id}/#{legacy_filename}"
+
+        expect(legacy_record.profile_image).not_to be_attached
+        expect(legacy_record.profile_image_present?).to be(true)
+        expect(legacy_record.profile_image_url).to eq(expected_url)
+        expect(legacy_record.profile_image_90).to eq(expected_url)
+        expect(legacy_record.profile_image_url_for(length: 320)).to eq(expected_url)
+        expect(legacy_record.as_json["profile_image"]).to eq({ "url" => expected_url })
+      end
+
+      it "keeps the legacy CarrierWave image when updating unrelated attributes" do
+        expected_url = "/uploads/#{factory_name}/profile_image/#{legacy_record.id}/#{legacy_filename}"
+
+        legacy_record.name = "Updated Name"
+        expect(legacy_record.save).to be(true)
+        legacy_record.reload
+
+        expect(legacy_record.profile_image).not_to be_attached
+        expect(legacy_record[:profile_image]).to eq(legacy_filename)
+        expect(legacy_record.profile_image_url).to eq(expected_url)
+      end
+
+      it "switches to Active Storage on new upload while preserving legacy column" do
+        legacy_record.profile_image = image_png
+        legacy_record.save!
+        legacy_record.reload
+
+        expect(legacy_record.profile_image).to be_attached
+        expect(legacy_record.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+        expect(legacy_record.as_json["profile_image"]).to eq({ "url" => legacy_record.profile_image_url })
+        # Legacy column stays intact for zero-downtime rolling deploys / rollbacks
+        expect(legacy_record[:profile_image]).to eq(legacy_filename)
+      end
+
+      it "resolves legacy CarrierWave URLs when CarrierWave is configured for Fog S3 or Forem Cloud" do
+        original_storage = ProfileImageUploader.storage
+        original_fog_dir = ProfileImageUploader.fog_directory
+        original_fog_creds = ProfileImageUploader.fog_credentials
+        original_asset_host = ProfileImageUploader.asset_host
+        original_fog_public = ProfileImageUploader.fog_public
+
+        ProfileImageUploader.storage = :fog
+        ProfileImageUploader.fog_directory = "forem-prod-bucket"
+        ProfileImageUploader.fog_credentials = {
+          provider: "AWS",
+          aws_access_key_id: "key",
+          aws_secret_access_key: "secret",
+          region: "us-east-1"
+        }
+        ProfileImageUploader.asset_host = nil
+        ProfileImageUploader.fog_public = true
+
+        expected_s3_path = "uploads/#{factory_name}/profile_image/#{legacy_record.id}/#{legacy_filename}"
+        expect(legacy_record.profile_image_url).to eq("https://forem-prod-bucket.s3.amazonaws.com/#{expected_s3_path}")
+
+        ProfileImageUploader.asset_host = "https://#{ApplicationConfig['APP_DOMAIN']}/remoteimages"
+        ProfileImageUploader.fog_public = false
+
+        expect(legacy_record.profile_image_url).to eq(
+          "https://#{Settings::General.app_domain}/remoteimages/#{expected_s3_path}",
+        )
+      ensure
+        ProfileImageUploader.storage = original_storage
+        ProfileImageUploader.fog_directory = original_fog_dir
+        ProfileImageUploader.fog_credentials = original_fog_creds
+        ProfileImageUploader.asset_host = original_asset_host
+        ProfileImageUploader.fog_public = original_fog_public
+      end
+    end
+
+    describe "validations and error handling" do
+      it "rejects unsupported formats like PDF without replacing the existing image" do
+        record = create(factory_name, profile_image: image_jpg)
+        original_blob_id = record.profile_image.blob.id
+        pdf_payload = {
+          io: StringIO.new("%PDF-1.4\n%fake pdf content"),
+          filename: "doc.pdf",
+          content_type: "application/pdf"
+        }
+
+        record.profile_image = pdf_payload
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image]).to include(I18n.t("errors.messages.unsupported_image_type"))
+        expect(record.reload.profile_image.blob.id).to eq(original_blob_id)
+      end
+
+      it "rejects files exceeding ProfileImageUploader::MAX_FILE_SIZE" do
+        stub_const("ProfileImageUploader::MAX_FILE_SIZE", 2.megabytes)
+        large_image = fixture_file_upload("large_profile_img.jpg", "image/jpeg")
+
+        record = create(factory_name)
+        record.profile_image = large_image
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image]).to include("File size should be less than 2 MB")
+      end
+
+      it "rejects empty 0-byte files" do
+        empty_io = StringIO.new("")
+        record = create(factory_name)
+        record.profile_image = { io: empty_io, filename: "empty.png", content_type: "image/png" }
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image]).to be_present
+      end
+
+      it "rejects image bombs exceeding 4096x4096 pixels" do
+        record = create(factory_name)
+        fake_fast_image = instance_double(FastImage, type: :png, size: [5000, 5000])
+        allow(FastImage).to receive(:new).and_return(fake_fast_image)
+
+        record.profile_image = image_png
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image]).to include("Image size should be less than or equal to 4096x4096")
+      end
+
+      it "rejects animated GIFs with too many frames" do
+        gif_file = fixture_file_upload("high_frame_count.gif", "image/gif")
+        stub_const("Images::ProfileImageProcessor::FRAME_MAX", 5)
+
+        record = create(factory_name)
+        record.profile_image = gif_file
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image].first).to include("GIF contains too many frames")
+      end
+
+      it "adds a timeout error if MiniMagick times out" do
+        record = create(factory_name)
+        allow(MiniMagick::Image).to receive(:open).and_raise(Timeout::Error)
+
+        record.profile_image = image_jpg
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image]).to include(I18n.t("uploaders.base_uploader.timeout"))
+      end
+
+      it "does not crash when profile_image_url is called on an unsaved record with a new file" do
+        unsaved = build(factory_name, profile_image: image_jpg)
+        expect { unsaved.profile_image_url }.not_to raise_error
+        expect(unsaved.profile_image_url).to be_nil
+      end
+
+      it "preserves the current persisted URL when an update with a new image fails validation" do
+        record = create(factory_name, profile_image: image_jpg)
+        current_url = record.profile_image_url
+
+        record.name = ""
+        record.profile_image = image_png
+        expect(record.save).to be(false)
+        expect(record.profile_image_url).to eq(current_url)
+      end
+
+      it "adds a validation error when remote_profile_image_url download fails" do
+        stub_request(:get, "https://broken.example.com/404.png").to_return(status: 404, body: "Not Found")
+
+        record = create(factory_name)
