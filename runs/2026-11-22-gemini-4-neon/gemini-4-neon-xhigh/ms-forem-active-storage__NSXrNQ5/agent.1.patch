+require "rails_helper"
+
+RSpec.describe "Active Storage profile images" do
+  let(:image_jpg) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:image_png) { fixture_file_upload("800x600.png", "image/png") }
+
+  describe "serving Active Storage profile image routes" do
+    it "serves a newly uploaded user profile picture via proxy route with HTTP 200 and image bytes" do
+      user = create(:user, profile_image: image_jpg)
+      url = user.profile_image_url
+
+      expect(url).to start_with("/rails/active_storage/blobs/proxy/")
+
+      get url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/jpeg")
+      expect(response.headers["Cache-Control"]).to include("public")
+      expect(FastImage.type(StringIO.new(response.body))).to eq(:jpeg)
+    end
+
+    it "serves a newly uploaded organization profile picture via proxy route with HTTP 200" do
+      org = create(:organization, profile_image: image_png)
+      url = org.profile_image_url
+
+      expect(url).to start_with("/rails/active_storage/blobs/proxy/")
+
+      get url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/png")
+      expect(FastImage.type(StringIO.new(response.body))).to eq(:png)
+    end
+
+    it "also allows redirect and disk routes without catch-all pages#show swallowing them" do
+      user = create(:user, profile_image: image_jpg)
+      redirect_path = rails_service_blob_path(user.profile_image.blob.signed_id, user.profile_image.blob.filename)
+
+      get redirect_path
+      expect(response).to have_http_status(:found)
+      expect(response.location).to include("/rails/active_storage/disk/")
+
+      follow_redirect!
+      expect(response).to have_http_status(:ok)
+      expect(FastImage.type(StringIO.new(response.body))).to eq(:jpeg)
+    end
+  end
+
+  describe "uploading via user controllers" do
+    let(:user) { create(:user) }
+
+    before { sign_in user }
+
+    it "stores new user avatar in Active Storage and returns profile_image.url in PUT /users/:id JSON" do
+      put "/users/#{user.id}",
+          params: { user: { profile_image: image_png } },
+          headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      json = response.parsed_body
+      uploaded_url = json.dig("user", "profile_image", "url")
+      expect(uploaded_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+      get uploaded_url
+      expect(response).to have_http_status(:ok)
+      expect(FastImage.type(StringIO.new(response.body))).to eq(:png)
+    end
+
+    it "does not wipe existing user profile image when PUT /users/:id submits blank profile_image" do
+      original_url = user.profile_image_url
+
+      put "/users/#{user.id}",
+          params: { user: { name: "Updated Name", profile_image: "" } },
+          headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      expect(user.reload.profile_image).to be_attached
+      expect(user.profile_image_url).to eq(original_url)
+    end
+
+    it "stores new user avatar in Active Storage via PUT /profiles/:id" do
+      put profile_path(user.id),
+          params: { user: { name: user.name, username: user.username, profile_image: image_png } }
+
+      expect(response).to redirect_to(user_settings_path)
+      expect(user.reload.profile_image).to be_attached
+      expect(user[:profile_image]).to be_nil
+
+      get user.profile_image_url
+      expect(response).to have_http_status(:ok)
+      expect(FastImage.type(StringIO.new(response.body))).to eq(:png)
+    end
+
+    it "preserves a legacy CarrierWave user avatar on unrelated profile updates and transitions on new upload" do
+      user.profile_image.purge
+      user.update_columns(profile_image: "legacy-user.png")
+      user.reload
+      legacy_url = "/uploads/user/profile_image/#{user.id}/legacy-user.png"
+
+      put profile_path(user.id), params: { user: { name: "Renamed Legacy User", username: user.username } }
+      expect(response).to redirect_to(user_settings_path)
+      expect(user.reload.profile_image).not_to be_attached
+      expect(user.profile_image_url).to eq(legacy_url)
+
+      put profile_path(user.id),
+          params: { user: { name: "Renamed Legacy User", username: user.username, profile_image: image_png } }
+      expect(response).to redirect_to(user_settings_path)
+      expect(user.reload.profile_image).to be_attached
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+      get user.profile_image_url
+      expect(response).to have_http_status(:ok)
+      expect(FastImage.type(StringIO.new(response.body))).to eq(:png)
+    end
+  end
+
+  describe "uploading via organization controllers" do
+    let(:org_admin) { create(:user, :org_admin) }
+    let(:organization) { org_admin.organizations.first }
+
+    before { sign_in org_admin }
+
+    it "creates a new organization with its profile picture in Active Storage" do
+      post organizations_path, params: {
+        organization: {
+          name: "Active Storage Org",
+          slug: "active-storage-org",
+          summary: "An org on Active Storage",
+          profile_image: image_png
+        }
+      }
+
+      created_org = Organization.find_by!(slug: "active-storage-org")
+      expect(created_org.profile_image).to be_attached
+      expect(created_org[:profile_image]).to be_nil
+
+      get created_org.profile_image_url
+      expect(response).to have_http_status(:ok)
+      expect(FastImage.type(StringIO.new(response.body))).to eq(:png)
+    end
+
+    it "preserves legacy CarrierWave org logo on unrelated settings update and transitions on new upload" do
+      organization.profile_image.purge
+      organization.update_columns(profile_image: "legacy-org.png")
+      organization.reload
+      legacy_url = "/uploads/organization/profile_image/#{organization.id}/legacy-org.png"
+
+      patch organization_settings_path(organization.slug), params: {
+        organization: { name: "Updated Legacy Org" }
+      }
+      expect(response).to redirect_to(organization_settings_path(organization.slug))
+      expect(organization.reload.profile_image).not_to be_attached
+      expect(organization.profile_image_url).to eq(legacy_url)
+
+      patch organization_settings_path(organization.slug), params: {
+        organization: { name: "Updated Legacy Org", profile_image: image_jpg }
+      }
+      expect(response).to redirect_to(organization_settings_path(organization.slug))
+      expect(organization.reload.profile_image).to be_attached
+      expect(organization.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+      get organization.profile_image_url
+      expect(response).to have_http_status(:ok)
+      expect(FastImage.type(StringIO.new(response.body))).to eq(:jpeg)
+    end
+  end
+
+  describe "coexistence in API, views, and mailers" do
+    let(:legacy_user) do
+      u = create(:user)
+      u.profile_image.purge
+      u.update_columns(profile_image: "old-user-avatar.jpg")
+      u.reload
+    end
+
+    let(:legacy_org) do
+      o = create(:organization)
+      o.profile_image.purge
+      o.update_columns(profile_image: "old-org-logo.png")
+      o.reload
+    end
+
+    it "serves legacy CarrierWave URLs and Active Storage URLs side by side in /api/profile_images/:username" do
+      as_user = create(:user, profile_image: image_png)
+      expected_user_url = "/uploads/user/profile_image/#{legacy_user.id}/old-user-avatar.jpg"
+      expected_org_url = "/uploads/organization/profile_image/#{legacy_org.id}/old-org-logo.png"
+
+      get api_profile_image_path(legacy_user.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(expected_user_url)
+
+      get api_profile_image_path(as_user.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(as_user.profile_image_url)
+
+      get api_profile_image_path(legacy_org.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(expected_org_url)
+    end
+
+    it "renders profile pages for both legacy CarrierWave and Active Storage users" do
+      as_user = create(:user, profile_image: image_png)
+
+      get "/#{legacy_user.username}"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include("/uploads/user/profile_image/#{legacy_user.id}/old-user-avatar.jpg")
+
+      get "/#{as_user.username}"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(as_user.profile_image_url)
+    end
+
+    it "renders valid image URLs in admin organization pages" do
+      admin = create(:user, :super_admin)
+      sign_in admin
+
+      as_org = create(:organization, profile_image: image_png)
+      get admin_organization_path(as_org)
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(as_org.profile_image_url)
+      expect(response.body).not_to include("ActiveStorage::Attached::One")
+
+      get admin_organization_path(legacy_org)
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include("/uploads/organization/profile_image/#{legacy_org.id}/old-org-logo.png")
+    end
+
+    it "renders valid follower image URL in NotifyMailer#new_follower_email" do
+      recipient = create(:user)
+      as_follower = create(:user, profile_image: image_jpg)
+      follow = Follow.create!(follower: as_follower, followable: recipient)
+      expected_legacy_url = "/uploads/user/profile_image/#{legacy_user.id}/old-user-avatar.jpg"
+
+      mail = NotifyMailer.with(follow: follow).new_follower_email
+      expect(mail.html_part.body.to_s).to include(as_follower.profile_image_url)
+      expect(mail.html_part.body.to_s).not_to include("ActiveStorage::Attached::One")
+
+      legacy_follow = Follow.create!(follower: legacy_user, followable: recipient)
+      legacy_mail = NotifyMailer.with(follow: legacy_follow).new_follower_email
+      expect(legacy_mail.html_part.body.to_s).to include(expected_legacy_url)
+    end
+  end
+end
