+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @other_account = accounts(:initech)
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    freeze_time do
+      @account.cancel(initiated_by: @user)
+      @account.cancellation.update_column(:created_at, 30.days.ago - 1.second)
+
+      assert @account.due_for_incineration?
+      assert_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "due_for_incineration excludes active, recently cancelled, boundary, and reactivated accounts" do
+    freeze_time do
+      assert_not @account.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, @account
+
+      @account.cancel(initiated_by: @user)
+      assert_not @account.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, @account
+
+      @account.cancellation.update_column(:created_at, 29.days.ago)
+      assert_not @account.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, @account
+
+      @account.cancellation.update_column(:created_at, 30.days.ago)
+      assert_not @account.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, @account
+
+      @account.cancellation.update_column(:created_at, 31.days.ago)
+      @account.reactivate
+      @account.reload
+      assert_not @account.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, @account
+
+      @account.cancel(initiated_by: @user)
+      assert_not @account.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "incinerate does nothing for an active account" do
+    assert_no_difference -> { Account.count } do
+      assert_no_difference -> { Board.count } do
+        assert_no_difference -> { Card.count } do
+          @account.incinerate
+        end
+      end
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate removes a minimal cancelled account with no boards or cards" do
+    empty_account = Account.create_with_owner(
+      account: { name: "Minimal Account" },
+      owner: { name: "Minimal Owner", identity: identities(:david) }
+    )
+    empty_account.cancel(initiated_by: empty_account.users.owner.first)
+
+    empty_account.incinerate
+
+    assert empty_account.destroyed?
+    assert_not Account.exists?(empty_account.id)
+    assert_equal 0, User.where(account_id: empty_account.id).count
+    assert_equal 0, Account::JoinCode.where(account_id: empty_account.id).count
+    assert_equal 0, Entropy.where(account_id: empty_account.id).count
+    assert_equal 0, Account::Cancellation.where(account_id: empty_account.id).count
+  end
+
+  test "incinerate permanently removes all data across every account-scoped table and storage" do
+    Current.account = @account
+    Current.user = @user
+
+    board = @account.boards.first
+    card = @account.cards.published.first
+    comment = card.comments.first
+    tag = @account.tags.first
+    filter = @user.filters.first || @user.filters.create!(fields: {})
+
+    # Populate every account-scoped table
+    @account.cancel(initiated_by: @user)
+    import = @account.imports.create!(identity: @user.identity, status: :completed)
+    account_export = @account.exports.create!(user: @user, status: :completed)
+    user_export = @user.data_exports.create!(account: @account, status: :completed)
+    @user.search_queries.create!(terms: "incinerate test")
+    @user.push_subscriptions.build(
+      account: @account,
+      endpoint: "https://fcm.googleapis.com/fcm/send/incinerate-test",
+      p256dh_key: "key",
+      auth_key: "auth"
+    ).save!(validate: false)
+    @user.notification_bundles.create!(starts_at: 1.hour.ago, ends_at: Time.current)
+
+    board.publish unless board.published?
+    board.public_description = "Public board description"
+    board.save!
+
+    card_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("card image data"),
+      filename: "card.png",
+      content_type: "image/png"
+    )
+    card.image.attach(card_blob)
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("embedded data"),
+      filename: "embed.txt",
+      content_type: "text/plain"
+    )
+    card.update!(description: "<action-text-attachment sgid=\"#{embed_blob.attachable_sgid}\"></action-text-attachment>")
+
+    avatar_blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    @user.avatar.attach(avatar_blob)
+    @user.avatar.variant(:thumb).processed
+
+    export_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("export zip"),
+      filename: "export.zip",
+      content_type: "application/zip"
+    )
+    account_export.file.attach(export_blob)
+
+    import_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("import zip"),
+      filename: "import.zip",
+      content_type: "application/zip"
+    )
+    import.file.attach(import_blob)
+
+    orphan_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("orphan upload"),
+      filename: "orphan.txt",
+      content_type: "text/plain"
+    )
+
+    card.reindex
+    comment.reindex
+    card.steps.create!(content: "A step")
+    card.create_activity_spike! unless card.activity_spike
+    @account.cards.create!(board: board, creator: @user, title: "Postponed card", status: :published).postpone(user: @user)
+    @account.cards.create!(board: board, creator: @user, title: "Closed card", status: :published).close(user: @user)
+    card.gild unless card.golden?
+    card.taggings.find_or_create_by!(tag: tag)
+    card.assignments.find_or_create_by!(assignee: @user, assigner: @user)
+    card.pin_by(@user) unless card.pinned_by?(@user)
+    card.watch_by(@user) unless card.watched_by?(@user)
+    card.reactions.create!(reacter: @user, content: "👍")
+    card.mentions.create!(mentioner: @user, mentionee: users(:jason))
+    Notification.create!(user: @user, creator: users(:jason), source: card.events.first)
+
+    Storage::Entry.create!(account: @account, board: board, delta: 1024, operation: "attach")
+    @account.materialize_storage
+    board.materialize_storage
+
+    webhook = board.webhooks.first || board.webhooks.create!(
+      name: "Test Hook",
+      url: "https://example.com/hook",
+      subscribed_actions: [ "card_published" ]
+    )
+    webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+    event = card.events.first || Event.create!(account: @account, board: board, creator: @user, eventable: card, action: "card_published")
+    webhook.deliveries.create!(event: event, state: :completed)
+
+    # Also insert an orphan event whose eventable no longer exists
+    Event.insert!({
+      id: ActiveRecord::Type::Uuid.generate,
+      account_id: @account.id,
+      board_id: board.id,
+      creator_id: @user.id,
+      eventable_type: "Card",
+      eventable_id: ActiveRecord::Type::Uuid.generate,
+      action: "card_published",
+      created_at: Time.current,
+      updated_at: Time.current
+    })
+
+    # Populate all 6 filter join tables
+    filter.tags << tag unless filter.tags.include?(tag)
+    filter.board_ids = (filter.board_ids + [ board.id ]).uniq
+    filter.assignees << @user unless filter.assignees.include?(@user)
+    filter.creators << @user unless filter.creators.include?(@user)
+    filter.closers << @user unless filter.closers.include?(@user)
+    insert_assigner_filter(@user.id, filter.id)
+
+    # Create global records for shared identity to verify they survive
+    shared_identity = @user.identity
+    access_token = shared_identity.access_tokens.create!(description: "API", permission: :read)
+    magic_link = shared_identity.magic_links.create!
+    session = shared_identity.sessions.create!
+
+    # Populate other account with blob, search record, storage total, and filter to verify isolation
+    Current.account = @other_account
+    other_user = @other_account.users.active.first!
+    other_board = @other_account.boards.first || @other_account.boards.create!(name: "Initech Board", creator: other_user)
+    other_card = other_board.cards.create!(title: "Surviving searchable rocket", number: 999, status: :published, creator: other_user)
+    other_card.reindex
+    other_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("other account data"),
+      filename: "other.txt",
+      content_type: "text/plain"
+    )
+    Storage::Entry.create!(account: @other_account, board: other_board, delta: 512, operation: "attach")
+    @other_account.materialize_storage
+    other_board.materialize_storage
+    other_filter = other_user.filters.create!(fields: {})
+    other_filter.board_ids = [ other_board.id ]
+
+    # Snapshot IDs & counts before incineration
+    account_id = @account.id
+    board_ids = @account.boards.pluck(:id)
+    filter_ids = Filter.where(account_id: account_id).pluck(:id)
+    user_ids = @account.users.pluck(:id)
+    tag_ids = @account.tags.pluck(:id)
+    search_record_ids = Search::Record.for(account_id).where(account_id: account_id).pluck(:id)
