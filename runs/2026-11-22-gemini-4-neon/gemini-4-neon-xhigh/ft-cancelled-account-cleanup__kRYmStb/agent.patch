+      Storage::Entry.create!(account: @account, board: b, delta: 100, operation: "attach")
+      b.materialize_storage
+
+      t = @account.tags.create!(title: "batchtag#{i}")
+      c = b.cards.create!(title: "Batch Card #{i}", status: :published, creator: @user)
+      c.reindex
+
+      f = @user.filters.create!(fields: { terms: [ "term#{i}" ] })
+      f.board_ids = [ b.id ]
+      f.tags << t
+      f.assignees << @user
+
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("batch blob #{i}"),
+        filename: "batch-#{i}.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    @account.cancel(initiated_by: @user)
+
+    account_id = @account.id
+    board_ids = @account.boards.pluck(:id)
+    filter_ids = Filter.where(account_id: account_id).pluck(:id)
+    user_ids = @account.users.pluck(:id)
+    tag_ids = @account.tags.pluck(:id)
+    search_record_ids = Search::Record.for(account_id).where(account_id: account_id).pluck(:id)
+    blob_keys = ActiveStorage::Blob.where(account_id: account_id).pluck(:key)
+
+    assert_operator board_ids.size, :>=, 4
+    assert_operator filter_ids.size, :>=, 4
+    assert_operator tag_ids.size, :>=, 4
+    assert_operator search_record_ids.size, :>=, 4
+    assert_operator blob_keys.size, :>=, 4
+
+    Account::Incineration.new(@account, batch_size: 2).run
+
+    assert_not Account.exists?(account_id)
+    assert_zero_rows_for_account(account_id, board_ids, filter_ids, user_ids, tag_ids, search_record_ids)
