+    assert other_blob.service.exist?(other_blob.key)
+    assert_equal other_search_record_ids.size, Search::Record::SQLite::Fts.where(rowid: other_search_record_ids).count if sqlite?
+    assert_includes Search::Record.for(@other_account.id).search("rocket", user: other_user).map(&:card_id), other_card.id
+    assert Storage::Total.exists?(owner_type: "Account", owner_id: @other_account.id)
+    assert Storage::Total.exists?(owner_type: "Board", owner_id: other_board.id)
+    assert_equal 1, count_join_rows("boards_filters", :filter_id, [ other_filter.id ])
+  ensure
+    other_blob&.delete
