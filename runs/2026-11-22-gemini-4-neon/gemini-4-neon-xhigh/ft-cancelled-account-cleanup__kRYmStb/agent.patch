+
+    other_search_record_ids = Search::Record.for(@other_account.id).where(account_id: @other_account.id).pluck(:id)
+    other_counts_before = snapshot_account_counts(@other_account.id)
+
+    # Sanity check: EVERY account-scoped table actually has rows for @account before incineration
+    assert_every_account_table_populated(account_id, board_ids, filter_ids, search_record_ids)
+    assert_operator target_blob_keys.size, :>=, 6
+    assert_not_nil user_export
+
+    assert_no_enqueued_jobs do
