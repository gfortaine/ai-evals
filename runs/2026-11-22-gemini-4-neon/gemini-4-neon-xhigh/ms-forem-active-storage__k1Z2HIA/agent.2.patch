+require "rails_helper"
+
+RSpec.describe "profile_images tasks", type: :task do
+  let(:jpg_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:created_dirs) { [] }
+
+  before do
+    Rake.application["profile_images:copy"].reenable
+  end
+
+  after do
+    created_dirs.each { |dir| FileUtils.rm_rf(dir) }
+  end
+
+  it "copies legacy User and Organization profile pictures into Active Storage and is safe to re-run",
+     :aggregate_failures do
+    user = create(:user, profile_image: nil)
+    user_dir = Rails.root.join("public/uploads/user/profile_image/#{user.id}")
+    FileUtils.mkdir_p(user_dir)
+    created_dirs << user_dir
+    FileUtils.cp(jpg_path, user_dir.join("task-user.jpg"))
+    user.update_column(:profile_image, "task-user.jpg")
+
+    org = create(:organization)
+    org.profile_image.purge
+    org_dir = Rails.root.join("public/uploads/organization/profile_image/#{org.id}")
+    FileUtils.mkdir_p(org_dir)
+    created_dirs << org_dir
+    FileUtils.cp(png_path, org_dir.join("task-org.png"))
+    org.update_column(:profile_image, "task-org.png")
+
+    expect do
+      Rake::Task["profile_images:copy"].invoke
+    end.to output(/copied=2 skipped=0 missing=0 failed=0/).to_stdout
+
+    expect(user.reload.profile_image).to be_attached
+    expect(user.profile_image.download).to eq(File.binread(jpg_path))
+    expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+    expect(org.reload.profile_image).to be_attached
+    expect(org.profile_image.download).to eq(File.binread(png_path))
+    expect(org.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+    Rake.application["profile_images:copy"].reenable
+    expect do
+      Rake::Task["profile_images:copy"].invoke
+    end.to output(/copied=0 skipped=0 missing=0 failed=0/).to_stdout
+      .and not_change(ActiveStorage::Blob, :count)
+  end
+end
