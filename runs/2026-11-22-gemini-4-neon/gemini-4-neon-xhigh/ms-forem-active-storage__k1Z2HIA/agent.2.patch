diff --git a/lib/tasks/profile_images.rake b/lib/tasks/profile_images.rake
new file mode 100644
index 0000000..a3be8b0
--- /dev/null
+++ b/lib/tasks/profile_images.rake
@@ -0,0 +1,13 @@
+namespace :profile_images do
+  desc "Copy existing CarrierWave profile images of users and organizations into Active Storage"
+  task copy: :environment do
+    batch_size = ENV.fetch("BATCH_SIZE", Images::CopyProfileImagesToActiveStorage::DEFAULT_BATCH_SIZE).to_i
+    result = Images::CopyProfileImagesToActiveStorage.call(batch_size: batch_size)
+    puts(
+      "Profile images copy complete: " \
+      "copied=#{result.copied} skipped=#{result.skipped} " \
+      "missing=#{result.missing} failed=#{result.failed} " \
+      "articles_refreshed=#{result.articles_refreshed}",
+    )
+  end
+end
diff --git a/spec/requests/active_storage_profile_images_spec.rb b/spec/requests/active_storage_profile_images_spec.rb
index 12f93c6..97d7d21 100644
--- a/spec/requests/active_storage_profile_images_spec.rb
+++ b/spec/requests/active_storage_profile_images_spec.rb
@@ -114,4 +114,97 @@
       expect(by_id[as_org.id]["profile_image"]).to eq({ "url" => as_org.profile_image_url })
     end
   end
+
+  describe "end-to-end copy and serving from Active Storage" do
+    let(:api_v1_headers) { { "Accept" => "application/vnd.forem.api-v1+json" } }
+    let(:created_dirs) { [] }
+
+    after do
+      created_dirs.each { |dir| FileUtils.rm_rf(dir) }
+    end
+
+    it "keeps CarrierWave pictures working before copy and serves every picture from Active Storage after copy",
+       :aggregate_failures do
+      legacy_user = create(:user, profile_image: nil)
+      user_dir = Rails.root.join("public/uploads/user/profile_image/#{legacy_user.id}")
+      FileUtils.mkdir_p(user_dir)
+      created_dirs << user_dir
+      FileUtils.cp(jpg_path, user_dir.join("e2e-user.jpg"))
+      legacy_user.update_column(:profile_image, "e2e-user.jpg")
+
+      legacy_org = create(:organization)
+      legacy_org.profile_image.purge
+      org_dir = Rails.root.join("public/uploads/organization/profile_image/#{legacy_org.id}")
+      FileUtils.mkdir_p(org_dir)
+      created_dirs << org_dir
+      FileUtils.cp(png_path, org_dir.join("e2e-org.png"))
+      legacy_org.update_column(:profile_image, "e2e-org.png")
+
+      article = create(
+        :article,
+        user: User.find(legacy_user.id),
+        organization: Organization.find(legacy_org.id),
+        published: true,
+      )
+
+      # Before copy: CarrierWave URLs continue working across API and profile pages
+      get api_profile_image_path(legacy_user.username), headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(
+        "/uploads/user/profile_image/#{legacy_user.id}/e2e-user.jpg",
+      )
+
+      get api_profile_image_path(legacy_org.slug), headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(
+        "/uploads/organization/profile_image/#{legacy_org.id}/e2e-org.png",
+      )
+
+      # Copy existing profile pictures into Active Storage
+      result = Images::CopyProfileImagesToActiveStorage.call
+      expect(result.copied).to eq(2)
+
+      legacy_user.reload
+      legacy_org.reload
+      article.reload
+
+      # After copy: API endpoints return Active Storage URLs and serving those URLs returns the exact image bytes
+      get api_profile_image_path(legacy_user.username), headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+      user_served_url = response.parsed_body["profile_image"]
+      expect(user_served_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(user_served_url).to eq(legacy_user.profile_image_url)
+
+      get user_served_url
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/jpeg")
+      expect(response.body.b).to eq(File.binread(jpg_path))
+
+      get api_profile_image_path(legacy_org.slug), headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+      org_served_url = response.parsed_body["profile_image"]
+      expect(org_served_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(org_served_url).to eq(legacy_org.profile_image_url)
+
+      get org_served_url
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/png")
+      expect(response.body.b).to eq(File.binread(png_path))
+
+      # User & Org profile HTML pages serve the Active Storage URLs
+      get "/#{legacy_user.username}"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(legacy_user.profile_image_url)
+      expect(response.body).not_to include("/uploads/user/profile_image/#{legacy_user.id}/e2e-user.jpg")
+
+      get "/#{legacy_org.slug}"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(legacy_org.profile_image_url)
+      expect(response.body).not_to include("/uploads/organization/profile_image/#{legacy_org.id}/e2e-org.png")
+
+      # Article cached_user and cached_organization serve Active Storage URLs
+      expect(article.cached_user.profile_image_url).to eq(legacy_user.profile_image_url)
+      expect(article.cached_organization.profile_image_url).to eq(legacy_org.profile_image_url)
+    end
+  end
 end
