diff --git a/spec/lib/active_storage/service/fog_aws_service_spec.rb b/spec/lib/active_storage/service/fog_aws_service_spec.rb
new file mode 100644
index 0000000..cd8adbd
--- /dev/null
+++ b/spec/lib/active_storage/service/fog_aws_service_spec.rb
@@ -0,0 +1,105 @@
+require "rails_helper"
+require "active_storage/service/fog_aws_service"
+
+RSpec.describe ActiveStorage::Service::FogAwsService do
+  let(:bucket_name) { "forem-test-bucket" }
+  let(:key) { "abc123def456.jpg" }
+  let(:payload) { "hello active storage world" }
+  let(:checksum) { Base64.strict_encode64(Digest::MD5.digest(payload)) }
+
+  let(:service) do
+    ActiveStorage::Service.configure(
+      :amazon,
+      {
+        amazon: {
+          service: "FogAws",
+          bucket: bucket_name,
+          aws_access_key_id: "test-key",
+          aws_secret_access_key: "test-secret",
+          region: "us-east-1",
+          cache_control: "public, max-age=31536000",
+          public: true
+        }
+      },
+    )
+  end
+
+  before do
+    Fog.mock!
+    Fog::Mock.reset
+    service.client.directories.create(key: bucket_name)
+  end
+
+  after do
+    Fog.unmock!
+  end
+
+  it "uploads, checks existence, downloads, streams, downloads chunks, and deletes files", :aggregate_failures do
+    service.upload(key, StringIO.new(payload), checksum: checksum, content_type: "image/jpeg")
+
+    expect(service.exist?(key)).to be(true)
+    expect(service.download(key)).to eq(payload)
+
+    streamed = +""
+    service.download(key) { |chunk| streamed << chunk }
+    expect(streamed).to eq(payload)
+
+    expect(service.download_chunk(key, 0..4)).to eq("hello")
+    expect(service.download_chunk(key, 6...12)).to eq("active")
+
+    service.delete(key)
+    expect(service.exist?(key)).to be(false)
+  end
+
+  it "deletes prefixed keys" do
+    service.upload("prefix/one.jpg", StringIO.new(payload), checksum: checksum)
+    service.upload("prefix/two.jpg", StringIO.new(payload), checksum: checksum)
+    service.upload("other/three.jpg", StringIO.new(payload), checksum: checksum)
+
+    service.delete_prefixed("prefix/")
+
+    expect(service.exist?("prefix/one.jpg")).to be(false)
+    expect(service.exist?("prefix/two.jpg")).to be(false)
+    expect(service.exist?("other/three.jpg")).to be(true)
+  end
+
+  it "raises ActiveStorage::IntegrityError on checksum mismatch" do
+    expect do
+      service.upload(key, StringIO.new(payload), checksum: "invalid-checksum")
+    end.to raise_error(ActiveStorage::IntegrityError)
+  end
+
+  it "raises ActiveStorage::FileNotFoundError for missing keys" do
+    expect { service.download("nonexistent") }.to raise_error(ActiveStorage::FileNotFoundError)
+  end
+
+  it "returns permanent S3 public URLs when configured as public" do
+    expect(service).to be_public
+    expect(service.url(key)).to eq("https://#{bucket_name}.s3.amazonaws.com/#{key}")
+  end
+
+  it "uses asset_host with dynamic Settings::General.app_domain for Forem Cloud" do
+    forem_cloud_service = ActiveStorage::Service.configure(
+      :forem_cloud,
+      {
+        forem_cloud: {
+          service: "FogAws",
+          bucket: bucket_name,
+          aws_access_key_id: "test-key",
+          aws_secret_access_key: "test-secret",
+          region: "us-east-2",
+          asset_host: "https://boot-domain.test/remoteimages",
+          fog_public: false,
+          public: true
+        }
+      },
+    )
+
+    allow(ApplicationConfig).to receive(:[]).and_call_original
+    allow(ApplicationConfig).to receive(:[]).with("APP_DOMAIN").and_return("boot-domain.test")
+    allow(Settings::General).to receive(:app_domain).and_return("runtime-domain.example")
+
+    expect(forem_cloud_service).to be_public
+    expect(forem_cloud_service.url(key)).to eq("https://runtime-domain.example/remoteimages/#{key}")
+  end
+end
