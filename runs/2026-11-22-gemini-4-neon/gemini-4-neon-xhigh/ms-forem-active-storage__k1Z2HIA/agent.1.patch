+        content_type: "image/png",
+      )
+      user.update!(profile_image: signed_blob.signed_id)
+      expect(user.reload.profile_image.blob).to eq(signed_blob)
+    end
+
+    it "ignores non-signed plain strings safely like CarrierWave did" do
+      user = create(:user, profile_image: "https://example.com/some-url.png")
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to be_nil
+    end
+  end
+
+  describe "existing CarrierWave profile pictures stay working untouched" do
+    let(:legacy_filename) { "af153cd6-9994-4a68-83f4-8ddf3e13f0bf.jpg" }
+
+    it "resolves legacy CarrierWave User profile pictures without an Active Storage attachment",
