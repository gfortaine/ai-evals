+      user.update_column(:profile_image, legacy_filename)
+      reloaded = User.find(user.id)
+
+      expected_url = "/uploads/user/profile_image/#{user.id}/#{legacy_filename}"
+      expect(reloaded.profile_image).not_to be_attached
+      expect(reloaded.profile_image).to be_present
+      expect(reloaded.profile_image).not_to be_blank
+      expect(reloaded.profile_image_url).to eq(expected_url)
+      expect(reloaded.profile_image_90).to eq(expected_url)
+      expect(reloaded.profile_image.url).to eq(expected_url)
