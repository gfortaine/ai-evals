diff --git a/spec/requests/active_storage_profile_images_spec.rb b/spec/requests/active_storage_profile_images_spec.rb
new file mode 100644
index 0000000..12f93c6
--- /dev/null
+++ b/spec/requests/active_storage_profile_images_spec.rb
@@ -0,0 +1,117 @@
+require "rails_helper"
+
+RSpec.describe "Active Storage profile images" do
+  let(:jpg_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+
+  describe "serving Active Storage profile images via /rails/active_storage/blobs/proxy" do
+    it "serves a User's Active Storage profile picture directly without being intercepted by catch-all routes",
+       :aggregate_failures do
+      user = create(:user, profile_image: fixture_file_upload("800x600.jpg", "image/jpeg"))
+
+      get user.profile_image_url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/jpeg")
+      expect(response.headers["Cache-Control"]).to include("public")
+      expect(response.body.b).to eq(File.binread(jpg_path))
+    end
+
+    it "serves an Organization's Active Storage profile picture directly", :aggregate_failures do
+      org = create(:organization, profile_image: fixture_file_upload("800x600.png", "image/png"))
+
+      get org.profile_image_url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/png")
+      expect(response.body.b).to eq(File.binread(png_path))
+    end
+
+    it "does not break multi-segment Page catch-all routes" do
+      page = create(:page, slug: "guides/getting-started", is_top_level_path: true)
+
+      get "/#{page.slug}"
+
+      expect(response).to have_http_status(:ok)
+    end
+  end
+
+  describe "uploading via controllers" do
+    it "uploads a User profile image via PUT /users/:id JSON (onboarding flow) and returns profile_image.url",
+       :aggregate_failures do
+      user = create(:user, profile_image: nil)
+      sign_in user
+
+      put "/users/#{user.id}",
+          params: { user: { profile_image: fixture_file_upload("800x600.png", "image/png") } },
+          headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      body = response.parsed_body
+      expect(body["success"]).to be(true)
+
+      user.reload
+      expect(user.profile_image).to be_attached
+      expect(body.dig("user", "profile_image", "url")).to eq(user.profile_image_url)
+
+      get body.dig("user", "profile_image", "url")
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(File.binread(png_path))
+    end
+
+    it "uploads a User profile image via PATCH /profiles", :aggregate_failures do
+      user = create(:user, profile_image: nil)
+      sign_in user
+
+      patch profile_path(user), params: {
+        user: {
+          name: user.name,
+          username: user.username,
+          profile_image: fixture_file_upload("800x600.jpg", "image/jpeg")
+        }
+      }
+
+      expect(response).to redirect_to(user_settings_path)
+      user.reload
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+    end
+  end
+
+  describe "API endpoints with both legacy CarrierWave and new Active Storage records" do
+    let(:api_v1_headers) { { "Accept" => "application/vnd.forem.api-v1+json" } }
+
+    it "returns profile image URLs for both legacy CarrierWave and Active Storage users", :aggregate_failures do
+      legacy_user = create(:user, profile_image: nil)
+      legacy_user.update_column(:profile_image, "legacy-avatar.jpg")
+      as_user = create(:user, profile_image: fixture_file_upload("800x600.jpg", "image/jpeg"))
+
+      get api_profile_image_path(legacy_user.username), headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(
+        "/uploads/user/profile_image/#{legacy_user.id}/legacy-avatar.jpg",
+      )
+
+      get api_profile_image_path(as_user.username), headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(as_user.profile_image_url)
+    end
+
+    it "returns profile image URLs for both legacy CarrierWave and Active Storage organizations",
+       :aggregate_failures do
+      legacy_org = create(:organization)
+      legacy_org.profile_image.purge
+      legacy_org.update_column(:profile_image, "legacy-org.png")
+      as_org = create(:organization, profile_image: fixture_file_upload("800x600.png", "image/png"))
+
+      get api_organizations_path, headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+
+      by_id = response.parsed_body.index_by { |o| o["id"] }
+      expect(by_id[legacy_org.id]["profile_image"]).to eq(
+        { "url" => "/uploads/organization/profile_image/#{legacy_org.id}/legacy-org.png" },
+      )
+      expect(by_id[as_org.id]["profile_image"]).to eq({ "url" => as_org.profile_image_url })
+    end
+  end
+end
