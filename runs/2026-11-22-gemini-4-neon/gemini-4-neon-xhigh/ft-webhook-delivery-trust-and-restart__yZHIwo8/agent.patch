diff --git a/test/integration/webhooks_test.rb b/test/integration/webhooks_test.rb
new file mode 100644
index 0000000..4385864
--- /dev/null
+++ b/test/integration/webhooks_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class WebhooksTest < ActionDispatch::IntegrationTest
+  PUBLIC_IP = "93.184.216.34"
+  WEBHOOK_JOBS = [ Event::RelayJob, Webhook::DeliveryJob ].freeze
+
+  setup do
+    sign_in_as :kevin
+    stub_dns_resolution(PUBLIC_IP)
+  end
+
+  test "board event posts to receiver and records delivery in HTML and JSON logs" do
+    webhook = webhooks(:active)
+    captured_body = nil
+    captured_headers = nil
+
+    request_stub = stub_request(:post, webhook.url)
+      .with(ipaddr: PUBLIC_IP) do |request|
+        captured_body = request.body
+        captured_headers = request.headers
+        true
+      end
+      .to_return(status: 200)
+
+    card = nil
+    perform_enqueued_jobs only: WEBHOOK_JOBS do
+      card = publish_card("Ship webhooks")
+    end
+
+    assert_requested request_stub, times: 1
+
+    # Verify receiver got valid JSON and HMAC-SHA256 signature
+    parsed = JSON.parse(captured_body)
+    assert_equal "card_published", parsed["action"]
+    assert_equal card.id, parsed.dig("eventable", "id")
+    assert_equal "Ship webhooks", parsed.dig("eventable", "title")
+
+    expected_signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, captured_body)
+    assert_equal expected_signature, captured_headers["X-Webhook-Signature"]
+
+    # Verify JSON delivery log shows how it went (without signature)
+    get board_webhook_deliveries_path(webhook.board, webhook), as: :json
+    assert_response :success
+
+    latest = @response.parsed_body.first
+    assert_equal "completed", latest["state"]
+    assert_equal 200, latest.dig("response", "code")
+    assert_nil latest.dig("response", "error")
+    assert_equal "fizzy/1.0.0 Webhook", latest.dig("request", "headers", "User-Agent")
+    assert_not latest.dig("request", "headers").key?("X-Webhook-Signature")
+    assert_equal "card_published", latest.dig("event", "action")
+    assert_equal card.id, latest.dig("event", "eventable", "id")
+
+    # Verify HTML webhook page shows the delivery
+    get board_webhook_path(webhook.board, webhook)
+    assert_response :success
+    assert_select "li.delivery--succeeded strong", text: "completed"
+  end
+
+  test "closing a card via HTTP triggers subscribed webhook" do
+    webhook = webhooks(:active)
+    request_stub = stub_request(:post, webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 204)
+
+    perform_enqueued_jobs only: WEBHOOK_JOBS do
+      post card_closure_path(cards(:logo)), as: :json
+      assert_response :no_content
+    end
+
+    assert_requested request_stub, times: 1
+    delivery = webhook.deliveries.ordered.first
+    assert delivery.succeeded?
+    assert_equal 204, delivery.response[:code]
+    assert_equal "card_closed", delivery.event.action
+  end
+
+  test "delivers exactly once even if relay and delivery jobs are replayed" do
+    webhook = webhooks(:active)
+    request_stub = stub_request(:post, webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+
+    card = nil
+    perform_enqueued_jobs only: WEBHOOK_JOBS do
+      card = publish_card("Once only")
+    end
+
+    event = card.events.find_by!(action: "card_published")
+    delivery = webhook.deliveries.find_by!(event: event)
+
+    # Replaying both jobs must not send another POST
+    Event::RelayJob.perform_now(event)
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested request_stub, times: 1
+    assert_equal 1, webhook.deliveries.where(event: event).count
+  end
+
+  test "receiver failing 10 times in a row over an hour is switched off and can be reactivated" do
+    webhook = webhooks(:active)
+    fail_stub = stub_request(:post, webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 500)
+
+    freeze_time do
+      # First failure
+      perform_enqueued_jobs only: WEBHOOK_JOBS do
+        publish_card("Fail 1")
+      end
+      assert webhook.reload.active?
+
+      # Failures 2..9 within 59 minutes
+      travel 59.minutes
+      8.times do |i|
+        perform_enqueued_jobs only: WEBHOOK_JOBS do
+          publish_card("Fail #{i + 2}")
+        end
+      end
+      assert webhook.reload.active?
+
+      # 10th consecutive failure at 1 hour -> switched off
+      travel 1.minute
+      perform_enqueued_jobs only: WEBHOOK_JOBS do
+        publish_card("Fail 10")
+      end
+      assert_not webhook.reload.active?
+      assert_requested fail_stub, times: 10
+
+      # 11th event does not send a POST while switched off
+      perform_enqueued_jobs only: WEBHOOK_JOBS do
+        publish_card("Ignored while off")
+      end
+      assert_requested fail_stub, times: 10
+
+      # Show page renders Reactivate button
+      get board_webhook_path(webhook.board, webhook)
+      assert_response :success
+      assert_select "button", text: "Reactivate"
+
+      # Reactivating resets failure count and resumes delivery
+      post board_webhook_activation_path(webhook.board, webhook)
+      assert_redirected_to board_webhook_path(webhook.board, webhook)
+      assert webhook.reload.active?
+      assert_equal 0, webhook.delinquency_tracker.reload.consecutive_failures_count
+
+      WebMock.reset!
+      ok_stub = stub_request(:post, webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+
+      perform_enqueued_jobs only: WEBHOOK_JOBS do
+        publish_card("Back online")
+      end
+      assert_requested ok_stub, times: 1
+      assert webhook.reload.active?
+    end
+  end
+
+  test "delivery log keeps one week of deliveries" do
+    webhook = webhooks(:active)
+    stub_request(:post, webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+
+    freeze_time do
+      perform_enqueued_jobs only: WEBHOOK_JOBS do
+        publish_card("Week old")
+      end
+      old_delivery = webhook.deliveries.ordered.first
+
+      travel 6.days
+      perform_enqueued_jobs only: WEBHOOK_JOBS do
+        publish_card("Still fresh")
+      end
+      fresh_delivery = webhook.deliveries.ordered.first
+
+      travel 1.day
+      Webhook::Delivery.cleanup
+
+      get board_webhook_deliveries_path(webhook.board, webhook), as: :json
+      assert_response :success
+
+      delivery_ids = @response.parsed_body.pluck("id")
+      assert_not_includes delivery_ids, old_delivery.id
+      assert_includes delivery_ids, fresh_delivery.id
+    end
+  end
+
+  private
+    def publish_card(title)
+      Current.with(account: accounts("37s"), user: users(:kevin)) do
+        boards(:writebook).cards.create!(title: title, creator: users(:kevin), status: :published)
+      end
+    end
+end
