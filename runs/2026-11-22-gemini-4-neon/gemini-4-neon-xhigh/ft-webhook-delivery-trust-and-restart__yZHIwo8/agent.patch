@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  test "creating an event enqueues Event::RelayJob" do
+    assert_enqueued_with(job: Event::RelayJob) do
+      boards(:writebook).events.create!(
+        action: "card_published",
+        creator: users(:david),
+        eventable: cards(:logo)
+      )
+    end
+  end
+
+  test "relay_now triggers active webhooks subscribed to the event action" do
+    event = boards(:writebook).events.create!(
+      action: "card_published",
+      creator: users(:david),
+      eventable: cards(:logo)
+    )
+
+    assert_difference -> { webhooks(:active).deliveries.count }, +1 do
+      assert_enqueued_with(job: Webhook::DeliveryJob) do
+        event.relay_now
+      end
+    end
+
+    delivery = webhooks(:active).deliveries.ordered.first
+    assert_equal event, delivery.event
+    assert_equal "pending", delivery.state
+  end
+
+  test "relay_now ignores inactive webhooks" do
+    event = boards(:private).events.create!(
+      action: "card_published",
+      creator: users(:kevin),
+      eventable: cards(:text)
+    )
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now ignores webhooks not subscribed to the event action" do
+    event = boards(:writebook).events.create!(
+      action: "comment_created",
+      creator: users(:david),
+      eventable: comments(:layout_overflowing_david)
+    )
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now triggers multiple matching active webhooks on the same board" do
+    second_webhook = boards(:writebook).webhooks.create!(
+      name: "Second Webhook",
+      url: "https://second.example.com/webhooks",
+      subscribed_actions: %w[ card_published ]
+    )
+    unsubscribed_webhook = boards(:writebook).webhooks.create!(
+      name: "Unsubscribed",
+      url: "https://third.example.com/webhooks",
+      subscribed_actions: %w[ comment_created ]
+    )
+
+    event = boards(:writebook).events.create!(
+      action: "card_published",
+      creator: users(:david),
+      eventable: cards(:logo)
+    )
+
+    assert_difference -> { Webhook::Delivery.count }, +2 do
+      event.relay_now
+    end
+
+    assert webhooks(:active).deliveries.exists?(event: event)
+    assert second_webhook.deliveries.exists?(event: event)
