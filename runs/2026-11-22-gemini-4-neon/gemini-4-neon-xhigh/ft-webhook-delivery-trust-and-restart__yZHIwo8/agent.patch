+      recent_delivery = Webhook::Delivery.create!(webhook: webhooks(:active), event: events(:layout_assignment_jz))
+      recent_delivery.update_columns(created_at: 1.week.ago + 1.minute)
+
+      Webhook::Delivery.cleanup
+
+      assert_not Webhook::Delivery.exists?(old_delivery.id)
+      assert_not Webhook::Delivery.exists?(boundary_delivery.id)
+      assert_not Webhook::Delivery.exists?(successfully_completed_id)
+      assert_not Webhook::Delivery.exists?(errored_id)
+
+      assert Webhook::Delivery.exists?(recent_delivery.id)
+      assert Webhook::Delivery.exists?(unsuccessfully_completed_id)
+      assert Webhook::Delivery.exists?(pending_id)
+      assert Webhook::Delivery.exists?(in_progress_id)
+    end
+  end
 end
