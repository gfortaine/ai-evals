+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  HTTP_ERRORS = [
+    Timeout::Error,
+    SocketError,
+    SystemCallError,
+    IOError,
+    OpenSSL::SSL::SSLError,
+    Net::ProtocolError,
+    Net::HTTPBadResponse,
+    Net::HTTPHeaderSyntaxError,
+    Resolv::ResolvError,
+    URI::InvalidURIError,
