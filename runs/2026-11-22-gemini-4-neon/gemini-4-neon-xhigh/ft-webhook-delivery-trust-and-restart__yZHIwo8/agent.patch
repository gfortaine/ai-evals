@@ -0,0 +1,32 @@
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Current.with_account(account) do
+      Event::RelayJob.perform_later(self)
+    end
+  end
+
+  def relay_now
+    return if webhooks_to_trigger.empty?
+
+    with_lock do
+      webhooks_to_trigger.each do |webhook|
+        webhook.trigger(self) unless webhook_deliveries.exists?(webhook: webhook)
+      end
+    end
+  end
+
+  private
+    def webhooks_to_trigger
+      if board
+        board.webhooks.active.select { |webhook| webhook.subscribed_to?(action) }
+      else
+        []
+      end
+    end
+end
