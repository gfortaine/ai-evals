index 0000000..03f178d
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,356 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+    @comment_without_reactions = comments(:layout_overflowing_david)
+  end
+
+  test "displaying existing reactions with reacter info and adding new reactions" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment)}") do
+      # Shows existing reaction and who left it
+      within(".reactions") do
+        assert_selector ".reactions__list .reaction", text: "👍"
+        assert_selector ".reaction .reaction__avatar img[title='David']"
+        assert_selector ".reactions__trigger img[src*='boost-color']"
+
+        # Clicking trigger turns button into small input with confirm and cancel
+        find(".reactions__trigger").click
+        assert_no_selector ".reactions__trigger"
+        assert_selector ".reaction.reaction__form"
+        assert_selector "input.reaction__input[maxlength='16']"
+        assert_selector ".reaction__submit-btn"
+        assert_selector ".reaction__cancel-btn"
+
+        # Typing a short bit of text and confirming puts it in the strip, removes input, restores button
+        find("input.reaction__input").fill_in with: "Ship it!"
+        find(".reaction__submit-btn").click
+
+        assert_no_selector ".reaction.reaction__form"
+        assert_selector ".reactions__trigger"
+        assert_selector ".reactions__list .reaction", text: "Ship it!", count: 1
+        assert_selector ".reactions__list .reaction span.txt-small:not(.txt-medium)", text: "Ship it!"
+
+        # Can immediately add another reaction (emoji-only)
+        find(".reactions__trigger").click
+        find("input.reaction__input").fill_in with: "🚀"
+        find(".reaction__submit-btn").click
+
+        assert_no_selector ".reaction.reaction__form"
+        assert_selector ".reactions__trigger"
+        assert_selector ".reactions__list .reaction span.txt-small.txt-medium", text: "🚀", count: 1
+      end
+    end
+  end
+
+  test "canceling reaction input with cancel button and escape key" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment)} .reactions") do
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in with: "Never mind"
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reactions__list .reaction", text: "Never mind"
+
+      # Pressing Escape cancels input without navigating away from the card
+      find(".reactions__trigger").click
+      assert_selector "input.reaction__input"
+      find("input.reaction__input").send_keys :escape
+
+      assert_no_selector ".reaction.reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_current_path card_path(@card)
+  end
+
+  test "enforces 16 character maximum in the input" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment)} .reactions") do
+      find(".reactions__trigger").click
+      input = find("input.reaction__input")
+      input.fill_in with: "12345678901234567890"
+      assert_equal "1234567890123456", input.value
+
+      find(".reaction__submit-btn").click
+      assert_selector ".reactions__list .reaction", text: "1234567890123456"
+    end
+  end
+
+  test "picking an emoji from the emoji picker popup" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment)} .reactions") do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      assert_selector "dialog.reaction__popup[open]"
+
+      within(".reaction__emoji-list") do
+        click_button "🔥"
+      end
+
+      assert_no_selector ".reaction.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reactions__list .reaction span.txt-small.txt-medium", text: "🔥", count: 1
+    end
+  end
+
+  test "clicking your own reaction reveals remove button, clicking someone else's does not" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    # David owns logo_agreement_jz_thumbs_up on logo_agreement_jz
+    own_reaction = reactions(:logo_agreement_jz_thumbs_up)
+    within("##{dom_id(own_reaction)}") do
+      assert_selector ".reaction__delete", visible: :hidden
+    end
+
+    # Clicking own reaction reveals remove button
+    find("##{dom_id(own_reaction)}").click
+    assert_selector "##{dom_id(own_reaction)}.reaction--deleteable.expanded"
+    within("##{dom_id(own_reaction)}") do
+      assert_selector ".reaction__delete", visible: :visible
+    end
+
+    # Pressing Escape collapses it without leaving the card
+    send_keys :escape
+    assert_no_selector "##{dom_id(own_reaction)}.expanded"
+    assert_current_path card_path(@card)
+
+    # Click again and delete it
+    find("##{dom_id(own_reaction)}").click
+    within("##{dom_id(own_reaction)}") do
+      find(".reaction__delete").click
+    end
+    assert_no_selector "##{dom_id(own_reaction)}"
+
+    # JZ owns logo_agreement_kevin_nice on logo_agreement_kevin; David cannot delete it
+    other_reaction = reactions(:logo_agreement_kevin_nice)
+    assert_no_selector "##{dom_id(other_reaction)}.reaction--deleteable"
+    find("##{dom_id(other_reaction)}").click
+    assert_no_selector "##{dom_id(other_reaction)}.expanded"
+    within("##{dom_id(other_reaction)}") do
+      assert_no_selector ".reaction__delete", visible: :visible
+    end
+  end
+
+  test "adding a reaction to a comment that previously had none and then removing it" do
+    card = cards(:layout)
+    comment = @comment_without_reactions
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    within("##{dom_id(comment)} .reactions") do
+      assert_no_selector ".reactions__list .reaction"
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in with: "First!"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction", text: "First!", count: 1
+      assert_selector ".reactions__trigger"
+
+      reaction_el = find(".reactions__list .reaction", text: "First!")
+      reaction_el.click
+      reaction_el.find(".reaction__delete").click
+
+      assert_no_selector ".reactions__list .reaction"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "submitting with enter, rejecting blank input, escaping HTML, and collapsing on click outside" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment)} .reactions") do
+      # Whitespace-only submit is prevented and keeps the form open
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in with: "   "
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction.reaction__form"
+
+      # Submitting via Enter key works and escapes HTML safely
+      find("input.reaction__input").fill_in with: "<b>hi</b>"
+      find("input.reaction__input").send_keys :enter
+
+      assert_no_selector ".reaction.reaction__form"
+      assert_selector ".reactions__list .reaction", text: "<b>hi</b>", count: 1
+      assert_no_selector ".reactions__list .reaction b"
+    end
+
+    # Clicking own reaction expands it, clicking second own reaction collapses the first, clicking outside collapses
+    first_own = find("##{dom_id(reactions(:logo_agreement_jz_thumbs_up))}")
+    second_own = find("##{dom_id(@comment)} .reactions__list .reaction", text: "<b>hi</b>")
+
+    first_own.click
+    assert first_own[:class].include?("expanded")
+
+    # Toggle off by clicking again
+    first_own.click
+    assert_not first_own[:class].include?("expanded")
+
+    # Expand first, then click second -> first collapses, second expands
+    first_own.click
+    assert first_own[:class].include?("expanded")
+    second_own.click
+    assert_not first_own[:class].include?("expanded")
+    assert second_own[:class].include?("expanded")
+
+    # Click outside collapses second
+    find("h1").click
+    assert_not second_own[:class].include?("expanded")
+  end
+
+  test "reacting to a newly created comment without reloading" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    find("lexxy-editor").click
+    fill_in_lexxy with: "Brand new comment for reactions"
+    assert_selector "button.comment__submit:not([disabled])"
+    click_on "Post"
+
+    new_comment = find(".comment", text: "Brand new comment for reactions")
+    within(new_comment) do
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in with: "🎉"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction", text: "🎉", count: 1
+    end
+  end
+
+  test "everyone looking at the card sees reactions land and vanish live without reloading" do
+    # David opens the card in his session
+    sign_in_as(users(:david))
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    # Kevin opens the same card in a separate session
+    using_session(:kevin) do
+      sign_in_as(users(:kevin))
+      visit card_url(@card)
+      wait_for_cable_subscriptions
+
+      # Kevin also opens his reaction input on the same comment to make sure incoming reactions don't clobber it
+      within("##{dom_id(@comment)} .reactions") do
+        find(".reactions__trigger").click
+        find("input.reaction__input").fill_in with: "Drafting"
+      end
+    end
+
+    # David adds a reaction
+    within("##{dom_id(@comment)} .reactions") do
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in with: "Live! 🎉"
+      find(".reaction__submit-btn").click
+
+      # David sees his reaction exactly once (no duplicate from HTTP + broadcast)
+      assert_selector ".reactions__list .reaction", text: "Live! 🎉", count: 1
+    end
+
+    # Kevin sees David's reaction appear WITHOUT reloading, cannot delete it, and still has his open draft input
+    using_session(:kevin) do
+      within("##{dom_id(@comment)} .reactions") do
+        assert_selector ".reactions__list .reaction", text: "Live! 🎉", count: 1, wait: 5
+        assert_selector ".reactions__list .reaction .reaction__avatar img[title='David']"
+
+        live_reaction = find(".reactions__list .reaction", text: "Live! 🎉")
+        live_reaction.click
+        assert_no_selector ".reactions__list .reaction.expanded"
+
+        # Kevin's in-progress reaction input was preserved!
+        assert_equal "Drafting", find("input.reaction__input").value
+      end
+    end
+
+    # David deletes his reaction
+    within("##{dom_id(@comment)} .reactions") do
+      live_reaction = find(".reactions__list .reaction", text: "Live! 🎉")
+      live_reaction.click
+      live_reaction.find(".reaction__delete").click
+      assert_no_selector ".reactions__list .reaction", text: "Live! 🎉"
+    end
+
+    # Kevin sees David's reaction disappear live WITHOUT reloading
+    using_session(:kevin) do
+      within("##{dom_id(@comment)} .reactions") do
+        assert_no_selector ".reactions__list .reaction", text: "Live! 🎉", wait: 5
+      end
+    end
+  end
+
+  test "same user in another window sees their new reaction live and can delete it" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    second_window = open_new_window
+    within_window(second_window) do
+      visit card_url(@card)
+      wait_for_cable_subscriptions
+    end
+
+    # Add reaction in window 1
+    within("##{dom_id(@comment)} .reactions") do
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in with: "Sync!"
+      find(".reaction__submit-btn").click
+      assert_selector ".reactions__list .reaction", text: "Sync!", count: 1
+    end
+
+    # Window 2 sees it live and can delete it directly
+    within_window(second_window) do
+      within("##{dom_id(@comment)} .reactions") do
+        synced = find(".reactions__list .reaction.reaction--deleteable", text: "Sync!", wait: 5)
+        synced.click
+        synced.find(".reaction__delete").click
+        assert_no_selector ".reactions__list .reaction", text: "Sync!"
+      end
+    end
