new file mode 100644
index 0000000..3aa5785
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,61 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preload(reacter: [ :avatar_attachment, :account, :identity ])
+  end
+
+  def new
+  end
+
+  def show
+  end
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_delete_controller.js b/app/javascript/controllers/reaction_delete_controller.js
new file mode 100644
index 0000000..a8d0be9
--- /dev/null
+++ b/app/javascript/controllers/reaction_delete_controller.js
@@ -0,0 +1,66 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  #boundHandleEscape
+
+  connect() {
+    this.#updateDeleteable()
+    this.#boundHandleEscape = this.#handleEscape.bind(this)
+    document.addEventListener("keydown", this.#boundHandleEscape, { capture: true })
+  }
+
+  disconnect() {
+    document.removeEventListener("keydown", this.#boundHandleEscape, { capture: true })
+  }
+
+  toggle(event) {
+    if (!this.#isOwnedByCurrentUser) return
+    if (event.target.closest("form")) return
+
+    if (event.type === "keydown") event.preventDefault()
+    this.element.classList.toggle(this.expandedClass)
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.element.classList.remove(this.expandedClass)
+    }
+  }
+
+  animateDeletion() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  preserveState(event) {
+    if (event.detail?.attributeName === "class" || event.detail?.attributeName === "tabindex") {
+      event.preventDefault()
+    }
+  }
+
+  #handleEscape(event) {
+    if (event.key === "Escape" && this.element.classList.contains(this.expandedClass)) {
+      this.element.classList.remove(this.expandedClass)
+      event.preventDefault()
+      event.stopPropagation()
+    }
+  }
+
+  #updateDeleteable() {
+    const owned = this.#isOwnedByCurrentUser
+    this.element.classList.toggle(this.deleteableClass, owned)
+
+    if (owned) {
+      this.element.setAttribute("tabindex", "0")
+    } else {
+      this.element.removeAttribute("tabindex")
+      this.element.classList.remove(this.expandedClass)
+    }
+  }
+
+  get #isOwnedByCurrentUser() {
+    return Current.user?.id === this.reacterIdValue
+  }
+}
