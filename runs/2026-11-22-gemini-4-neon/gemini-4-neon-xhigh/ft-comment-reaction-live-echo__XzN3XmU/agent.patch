diff --git a/app/views/cards/comments/reactions/new.html.erb b/app/views/cards/comments/reactions/new.html.erb
new file mode 100644
index 0000000..172ada7
--- /dev/null
+++ b/app/views/cards/comments/reactions/new.html.erb
@@ -0,0 +1,69 @@
+<%= turbo_frame_tag @comment, :reacting do %>
+  <div class="reaction reaction__form expanded" data-controller="morph-guard">
+    <figure class="reaction__avatar margin-none" style="--avatar-size: auto;">
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+    </figure>
+
+    <div class="reaction__menu"
+         data-controller="dialog"
+         data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button"
+              class="reaction__menu-btn btn btn--circle borderless"
+              data-action="click->dialog#toggle:stop">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow"
+              data-dialog-target="dialog"
+              data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= button_to card_comment_reactions_path(@card, @comment),
+                  params: { reaction: { content: emoji } },
+                  class: "btn btn--circle borderless",
+                  title: label,
+                  aria: { label: label } do %>
+              <%= emoji %>
+            <% end %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form_with model: [ @card, @comment, @reaction || Reaction.new ],
+          class: "flex align-center gap-half",
+          data: {
+            controller: "form",
+            action: "keydown.esc->form#cancel:stop submit->form#preventEmptySubmit submit->form#preventComposingSubmit"
+          } do |form| %>
+      <label class="reaction__form-label flex align-center">
+        <span class="for-screen-reader">Reaction</span>
+        <%= form.text_field :content,
+              class: "input reaction__input txt-small",
+              maxlength: 16,
+              required: true,
+              autofocus: true,
+              autocomplete: "off",
+              aria: { label: "Reaction" },
+              data: {
+                form_target: "input",
+                action: "compositionstart->form#compositionStart compositionend->form#compositionEnd",
+                "1p-ignore": "true"
+              } %>
+      </label>
+
+      <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless" do %>
+        <%= icon_tag "check-circle" %>
+        <span class="for-screen-reader">Confirm</span>
+      <% end %>
+
+      <%= link_to card_comment_reactions_path(@card, @comment),
+            class: "reaction__cancel-btn btn btn--circle borderless",
+            data: { form_target: "cancel", turbo_frame: dom_id(@comment, :reacting) } do %>
+        <%= icon_tag "close-circle" %>
+        <span class="for-screen-reader">Cancel</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
