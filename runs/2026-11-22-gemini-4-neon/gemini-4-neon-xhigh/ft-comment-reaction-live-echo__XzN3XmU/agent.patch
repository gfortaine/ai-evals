+    post card_comment_reactions_path(private_card, private_comment),
+      params: { reaction: { content: "👍" } },
+      as: :turbo_stream
+    assert_response :not_found
+  end
+
+  test "index as JSON" do
+    comment = comments(:logo_agreement_jz)
+
+    get card_comment_reactions_path(comment.card, comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.count, @response.parsed_body.count
+    first = @response.parsed_body.first
+    assert_equal "👍", first["content"]
+    assert_equal users(:david).id, first.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(comment.card, comment, reactions(:logo_agreement_jz_thumbs_up)), first["url"]
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment),
+        params: { reaction: { content: "Great 👍" } },
+        as: :json
+    end
+
+    assert_response :created
+    reaction = Reaction.last
+    assert_equal card_comment_reaction_path(comment.card, comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+  end
+
+  test "create as JSON with flat params" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment),
+        params: { content: "🔥" },
+        as: :json
+    end
+
+    assert_response :created
+    assert_equal "🔥", Reaction.last.content
+  end
+
+  test "create as JSON rejects over-length content" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment),
+        params: { reaction: { content: "a" * 17 } },
+        as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy as JSON" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(comment.card, comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy someone else's reaction as JSON returns forbidden" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up)
+    comment = reaction.reactable
+
+    delete card_comment_reaction_path(comment.card, comment, reaction), as: :json
+
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+
+  test "comment fragment cache invalidates when reactions are added and removed" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    with_actionview_partial_caching do
+      get card_path(card)
+      assert_response :success
+      assert_no_match "Cached!", @response.body
+
+      post card_comment_reactions_path(card, comment),
+        params: { reaction: { content: "Cached!" } },
+        as: :turbo_stream
+      reaction = Reaction.last
+
+      get card_path(card)
+      assert_response :success
+      assert_match "Cached!", @response.body
+
+      delete card_comment_reaction_path(card, comment, reaction), as: :turbo_stream
+
+      get card_path(card)
+      assert_response :success
+      assert_no_match "Cached!", @response.body
+    end
+  end
+end
