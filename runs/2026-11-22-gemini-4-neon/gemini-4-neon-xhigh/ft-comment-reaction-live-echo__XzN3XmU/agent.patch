new file mode 100644
index 0000000..1d153d4
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "validates presence and 16-character maximum length of content" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_not comment.reactions.build(content: "").valid?
+    assert_not comment.reactions.build(content: "   ").valid?
+    assert comment.reactions.build(content: "a" * 16).valid?
+    assert_not comment.reactions.build(content: "a" * 17).valid?
+    assert comment.reactions.build(content: "👍").valid?
+    assert comment.reactions.build(content: "❤️").valid?
+    assert comment.reactions.build(content: "Great 👍").valid?
+  end
+
+  test "normalizes content by stripping leading and trailing whitespace" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "  Nice!  ")
+
+    assert_equal "Nice!", reaction.content
+  end
+
+  test "defaults account from reactable and reacter from Current.user" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "🔥")
+
+    assert_equal comment.account, reaction.account
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "all_emoji? identifies emoji-only reactions" do
+    assert Reaction.new(content: "👍").all_emoji?
+    assert Reaction.new(content: "🎉🔥").all_emoji?
+    assert Reaction.new(content: "❤️").all_emoji?
+    assert_not Reaction.new(content: "Nice!").all_emoji?
+    assert_not Reaction.new(content: "Great 👍").all_emoji?
+    assert_not Reaction.new(content: nil).all_emoji?
+  end
+
+  test "touches comment when created and destroyed" do
+    comment = comments(:logo_agreement_jz)
+    original_updated_at = comment.updated_at
+
+    reaction = nil
+    travel 1.minute do
+      reaction = comment.reactions.create!(content: "🎉")
+      assert_operator comment.reload.updated_at, :>, original_updated_at
+    end
+
+    after_create_updated_at = comment.updated_at
+    travel 2.minutes do
+      reaction.destroy!
+      assert_operator comment.reload.updated_at, :>, after_create_updated_at
+    end
+  end
+
+  test "broadcasts replacement on create and removal on destroy" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    reaction = nil
+    assert_turbo_stream_broadcasts [ card, :activity ], count: 1 do
+      reaction = comment.reactions.create!(content: "🚀")
+    end
+
+    assert_turbo_stream_broadcasts [ card, :activity ], count: 1 do
+      reaction.destroy!
+    end
+  end
+
+  test "destroying a comment destroys its reactions without individual removal broadcasts" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+    reaction_ids = comment.reactions.pluck(:id)
+    assert reaction_ids.any?
+
+    assert_no_turbo_stream_broadcasts [ card, :activity ] do
+      comment.destroy!
+    end
+
+    assert_empty Reaction.where(id: reaction_ids)
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
