diff --git a/test/controllers/books/searches_rate_limit_test.rb b/test/controllers/books/searches_rate_limit_test.rb
new file mode 100644
index 0000000..2fc0c74
--- /dev/null
+++ b/test/controllers/books/searches_rate_limit_test.rb
@@ -0,0 +1,211 @@
+require "test_helper"
+
+class Books::SearchesRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    Rails.cache.clear
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    Leaf.reindex_all
+  end
+
+  teardown do
+    Rails.cache.clear
+  end
+
+  test "allows 30 unauthenticated searches per minute and refuses the rest with 429" do
+    ip = "203.0.113.10"
+
+    30.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+      assert_in_body "<mark>Thanks</mark> for reading"
+    end
+
+    5.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :too_many_requests
+      assert_not response.redirect?
+      assert_not response.server_error?
+      assert_nil response.headers["Location"]
+      assert_operator response.headers["Retry-After"].to_i, :>=, 1
+    end
+  end
+
+  test "counts requests across different published books for the same address" do
+    ip = "203.0.113.11"
+
+    15.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+    end
+
+    15.times do
+      post book_search_path(books(:manual)), params: { search: "anything" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+    assert_response :too_many_requests
+
+    post book_search_path(books(:manual)), params: { search: "anything" }, env: { "REMOTE_ADDR" => ip }
+    assert_response :too_many_requests
+  end
+
+  test "does not execute search or book queries when refused" do
+    ip = "203.0.113.12"
+
+    30.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+    end
+
+    queries = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_name, _start, _finish, _id, payload|
+      queries << payload[:sql] unless payload[:name] == "SCHEMA"
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+    assert_response :too_many_requests
+    assert_empty queries.select { |sql| sql.include?("leaf_search_index") || sql.include?("books") }
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
+
+  test "automatically serves the address again after the burst stops" do
+    ip = "203.0.113.13"
+
+    freeze_time do
+      30.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+        assert_response :success
+      end
+
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :too_many_requests
+
+      travel 59.seconds
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :too_many_requests
+
+      travel 1.second
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+      assert_in_body "<mark>Thanks</mark> for reading"
+    end
+  end
+
+  test "recovers well within five minutes after a sustained burst stops" do
+    ip = "203.0.113.14"
+
+    freeze_time do
+      40.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      end
+      assert_response :too_many_requests
+
+      travel 5.minutes
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+      assert_in_body "<mark>Thanks</mark> for reading"
+    end
+  end
+
+  test "enforces a sliding one-minute window across boundaries" do
+    ip = "203.0.113.15"
+
+    freeze_time do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+
+      travel 50.seconds
+      29.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+        assert_response :success
+      end
+
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :too_many_requests
+
+      travel 15.seconds
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :too_many_requests
+
+      travel 45.seconds
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+      assert_response :success
+    end
+  end
+
+  test "other addresses searching the same book still get results without signing in" do
+    blocked_ip = "203.0.113.16"
+    reader_ip = "198.51.100.16"
+
+    31.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => blocked_ip }
+    end
+    assert_response :too_many_requests
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => reader_ip }
+    assert_response :success
+    assert_in_body "<mark>Thanks</mark> for reading"
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => blocked_ip }
+    assert_response :too_many_requests
+  end
+
+  test "a refused address can still open the book and its pages" do
+    ip = "203.0.113.17"
+
+    31.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+    end
+    assert_response :too_many_requests
+
+    get book_slug_path(books(:handbook)), env: { "REMOTE_ADDR" => ip }
+    assert_response :success
+    assert_in_body "Handbook"
+
+    get leafable_slug_path(leaves(:welcome_page)), env: { "REMOTE_ADDR" => ip }
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+
+    get leafable_slug_path(leaves(:summary_page)), env: { "REMOTE_ADDR" => ip }
+    assert_response :success
+    assert_in_body "Thanks for reading"
+  end
+
+  test "isolates addresses forwarded by a local proxy via X-Forwarded-For" do
+    blocked_ip = "203.0.113.18"
+    reader_ip = "198.51.100.18"
+
+    31.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { "X-Forwarded-For" => blocked_ip }
+    end
+    assert_response :too_many_requests
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { "X-Forwarded-For" => reader_ip }
+    assert_response :success
+    assert_in_body "<mark>Thanks</mark> for reading"
+  end
+
+  test "cannot bypass rate limit by spoofing X-Forwarded-For from a public remote address" do
+    attacker_ip = "203.0.113.19"
+
+    30.times do |i|
+      post book_search_path(books(:handbook)),
+        params: { search: "Thanks" },
+        env: { "REMOTE_ADDR" => attacker_ip },
+        headers: { "X-Forwarded-For" => "198.51.100.#{i + 1}" }
+      assert_response :success
+    end
+
+    post book_search_path(books(:handbook)),
+      params: { search: "Thanks" },
+      env: { "REMOTE_ADDR" => attacker_ip },
+      headers: { "X-Forwarded-For" => "198.51.100.99" }
+    assert_response :too_many_requests
+  end
+end
