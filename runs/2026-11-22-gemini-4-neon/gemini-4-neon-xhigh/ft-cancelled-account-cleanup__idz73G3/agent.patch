diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..38335c9
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,134 @@
+require "fugit"
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago and keeps others" do
+    due_account = Account.create_with_owner(
+      account: { name: "Due Account" },
+      owner: { name: "Owner", identity: identities(:david) }
+    )
+    due_owner = due_account.users.owner.first
+    due_board = nil
+    due_card = nil
+
+    Current.set(account: due_account, user: due_owner) do
+      due_board = due_account.boards.create!(name: "Due Board", creator: due_owner)
+      due_card = due_board.cards.create!(title: "Due Card", creator: due_owner, status: :published)
+    end
+
+    recent_account = Account.create_with_owner(
+      account: { name: "Recently Cancelled" },
+      owner: { name: "Owner", identity: identities(:david) }
+    )
+    active_account = accounts(:"37s")
+
+    freeze_time do
+      due_account.cancel(initiated_by: due_owner)
+      travel 5.days
+      recent_account.cancel(initiated_by: recent_account.users.owner.first)
+
+      # Move to 30 days + 1 second after due_account was cancelled (25 days + 1 second after recent_account)
+      travel 25.days + 1.second
+
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(due_account.id)
+    assert_not Board.exists?(due_board.id)
+    assert_not Card.exists?(due_card.id)
+    assert_not Account::Cancellation.exists?(account_id: due_account.id)
+
+    assert Account.exists?(recent_account.id)
+    assert recent_account.reload.cancelled?
+    assert Account.exists?(active_account.id)
+    assert Identity.exists?(identities(:david).id)
+  end
+
+  test "does not incinerate an account cancelled exactly 30 days ago" do
+    account = accounts(:initech)
+    owner = account.users.first
+
+    freeze_time do
+      account.cancel(initiated_by: owner)
+
+      travel Account::Incineratable::INCINERATION_GRACE_PERIOD
+      Account::IncinerateDueJob.perform_now
+      assert Account.exists?(account.id), "Account should not be incinerated at exactly 30 days"
+
+      travel 1.second
+      Account::IncinerateDueJob.perform_now
+      assert_not Account.exists?(account.id), "Account should be incinerated after more than 30 days"
+    end
+  end
+
+  test "incinerates multiple due accounts in a single run" do
+    due_1 = accounts(:initech)
+    due_2 = Account.create_with_owner(
+      account: { name: "Old Cancelled Account" },
+      owner: { name: "Owner", identity: identities(:david) }
+    )
+    active = accounts(:"37s")
+
+    due_1.create_cancellation!(initiated_by: due_1.users.first, created_at: 31.days.ago)
+    due_2.create_cancellation!(initiated_by: due_2.users.owner.first, created_at: 60.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due_1.id)
+    assert_not Account.exists?(due_2.id)
+    assert Account.exists?(active.id)
+  end
+
+  test "does not incinerate reactivated accounts" do
+    account = accounts(:initech)
+    owner = account.users.first
+
+    freeze_time do
+      account.cancel(initiated_by: owner)
+      travel 10.days
+      account.reactivate
+      travel 30.days
+
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+    assert_not account.reload.cancelled?
+  end
+
+  test "runs cleanly via perform_later without capturing a tenant account" do
+    ephemeral = Account.create_with_owner(
+      account: { name: "Ephemeral" },
+      owner: { name: "Owner", identity: identities(:david) }
+    )
+    due_account = accounts(:initech)
+    due_account.create_cancellation!(initiated_by: due_account.users.first, created_at: 31.days.ago)
+
+    Current.with_account(ephemeral) do
+      Account::IncinerateDueJob.perform_later
+    end
+
+    # Even if the enqueuing Current.account is gone before execution, the job still runs
+    ephemeral.incinerate
+
+    perform_enqueued_jobs only: Account::IncinerateDueJob
+
+    assert_not Account.exists?(due_account.id)
+  end
+
+  test "is queued on the backend queue" do
+    assert_equal "backend", Account::IncinerateDueJob.new.queue_name
+  end
+
+  test "is configured as a valid recurring job in config/recurring.yml" do
+    path = Rails.root.join("config/recurring.yml")
+    erb = ERB.new(path.read)
+    erb.filename = path.to_s
+    config = YAML.safe_load(erb.result, aliases: true)
+    task_config = config.dig("production", "incinerate_due_accounts")
+
+    assert_not_nil task_config, "Expected incinerate_due_accounts in config/recurring.yml"
+    assert_equal Account::IncinerateDueJob, task_config["class"].safe_constantize
+    assert_instance_of Fugit::Cron, Fugit.parse(task_config["schedule"], multi: :fail)
+  end
+end
