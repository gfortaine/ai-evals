+  test "incinerate_due skips accounts reactivated before incineration begins" do
+    account = accounts(:initech)
+    account.create_cancellation!(initiated_by: account.users.first, created_at: 35.days.ago)
+
+    # Simulate reactivation happening after initial query returns the account
+    reloaded = Account.due_for_incineration.to_a
