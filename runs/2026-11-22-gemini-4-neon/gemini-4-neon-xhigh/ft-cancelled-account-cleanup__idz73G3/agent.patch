--- /dev/null
+++ b/app/models/account/incineration.rb
@@ -0,0 +1,140 @@
+class Account::Incineration
+  BATCH_SIZE = 1000
+
+  ACCOUNT_SCOPED_MODELS = [
+    ActionText::RichText,
+    Assignment,
+    Card::ActivitySpike,
+    Card::Goldness,
+    Card::NotNow,
+    Closure,
+    Comment,
+    Mention,
+    Notification,
+    Notification::Bundle,
+    Pin,
+    Reaction,
+    Step,
+    Tagging,
+    Watch,
+    Card,
+    Board::Publication,
+    Column,
+    Entropy,
+    Event,
+    Webhook::DelinquencyTracker,
+    Webhook::Delivery,
+    Webhook,
+    Tag,
+    Access,
+    Push::Subscription,
+    Search::Query,
+    User::Settings,
+    User,
+    Account::Import,
+    Account::JoinCode,
+    Export,
+    Storage::Entry
+  ].freeze
+
+  FILTER_JOIN_TABLES = %w[
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+  ].freeze
+
+  attr_reader :account, :batch_size
+
+  def initialize(account, batch_size: BATCH_SIZE)
+    @account = account
+    @batch_size = batch_size
+  end
+
+  def run
+    purge_storage
+    delete_search_records
+    delete_filters
+    delete_boards
+    delete_account_storage_total
+    delete_account_scoped_records
+    delete_account
+  end
+
+  private
+    def purge_storage
+      delete_in_batches(ActiveStorage::Attachment)
+      delete_in_batches(ActiveStorage::VariantRecord)
+      purge_blobs
+    end
+
+    def purge_blobs
+      ActiveStorage::Blob.unscoped.where(account_id: account.id).find_each(batch_size: batch_size, &:purge)
+    end
+
+    def delete_search_records
+      Search::Record.delete_all_for_account(account.id, batch_size: batch_size)
+    end
+
+    def delete_filters
+      loop do
+        filter_ids = Filter.unscoped.where(account_id: account.id).limit(batch_size).pluck(:id)
+        break if filter_ids.empty?
+
+        delete_filter_join_records(filter_ids)
+        Filter.unscoped.where(id: filter_ids).delete_all
+      end
+    end
+
+    def delete_filter_join_records(filter_ids)
+      serialized_ids = filter_ids.map { |id| uuid_type.serialize(id) }
+      connection = ApplicationRecord.connection
+
+      FILTER_JOIN_TABLES.each do |table|
+        sql = ApplicationRecord.sanitize_sql_array([
+          "DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (?)",
+          serialized_ids
+        ])
+        connection.delete(sql)
+      end
+    end
+
+    def uuid_type
+      @uuid_type ||= ActiveRecord::Type::Uuid.new
+    end
+
+    def delete_boards
+      loop do
+        board_ids = Board.unscoped.where(account_id: account.id).limit(batch_size).pluck(:id)
+        break if board_ids.empty?
+
+        Storage::Total.unscoped.where(owner_type: "Board", owner_id: board_ids).delete_all
+        Board.unscoped.where(id: board_ids).delete_all
+      end
+    end
+
+    def delete_account_storage_total
+      Storage::Total.unscoped.where(owner_type: "Account", owner_id: account.id).delete_all
+    end
+
+    def delete_account_scoped_records
+      ACCOUNT_SCOPED_MODELS.each do |model|
+        delete_in_batches(model)
+      end
+    end
+
+    def delete_account
+      Account.transaction do
+        Account::Cancellation.unscoped.where(account_id: account.id).delete_all
+        account.delete
+      end
+    end
+
+    def delete_in_batches(model)
+      loop do
+        break if model.unscoped.where(account_id: account.id).limit(batch_size).delete_all.zero?
+      end
+    end
+end
