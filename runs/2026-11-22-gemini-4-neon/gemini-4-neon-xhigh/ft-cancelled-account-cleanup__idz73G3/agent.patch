+  test "every table with an account_id column is handled by Account::Incineration" do
+    handled_tables = (
+      Account::Incineration::ACCOUNT_SCOPED_MODELS + [
+        ActiveStorage::Attachment,
+        ActiveStorage::VariantRecord,
+        ActiveStorage::Blob,
+        Search::Record,
+        Filter,
+        Board,
+        Account::Cancellation
+      ]
+    ).map(&:table_name)
+
+    db_account_id_tables = ApplicationRecord.connection.tables.select do |table|
+      ApplicationRecord.connection.columns(table).any? { |col| col.name == "account_id" }
+    end
+
+    # On MySQL, sharded search_records_0..15 are handled via Search::Record.delete_all_for_account
+    db_account_id_tables.reject! { |table| table.match?(/\Asearch_records_\d+\z/) }
+
+    unhandled = db_account_id_tables - handled_tables
+    assert_empty unhandled, "Tables with account_id missing from Account::Incineration: #{unhandled.join(', ')}"
+  end
+
+  private
+    def sqlite?
+      ApplicationRecord.connection.adapter_name == "SQLite"
+    end
+
+    def account_row_counts(account_id)
+      uuid = ActiveRecord::Type::Uuid.new.serialize(account_id)
+      conn = ApplicationRecord.connection
+
+      conn.tables.each_with_object({}) do |table, counts|
+        next unless conn.columns(table).any? { |col| col.name == "account_id" }
+
+        sql = ApplicationRecord.sanitize_sql_array([
+          "SELECT COUNT(*) FROM #{conn.quote_table_name(table)} WHERE account_id = ?", uuid
+        ])
+        counts[table] = conn.select_value(sql).to_i
+      end
+    end
+
+    def count_filter_join_rows(table, filter_ids)
+      return 0 if filter_ids.empty?
+
+      uuid_type = ActiveRecord::Type::Uuid.new
+      serialized_ids = filter_ids.map { |id| uuid_type.serialize(id) }
+      conn = ApplicationRecord.connection
+
+      sql = ApplicationRecord.sanitize_sql_array([
+        "SELECT COUNT(*) FROM #{conn.quote_table_name(table)} WHERE filter_id IN (?)", serialized_ids
+      ])
+      conn.select_value(sql).to_i
+    end
+
+    def insert_assigners_filter(assigner_id, filter_id)
+      uuid_type = ActiveRecord::Type::Uuid.new
+      sql = ApplicationRecord.sanitize_sql_array([
+        "INSERT INTO assigners_filters (assigner_id, filter_id) VALUES (?, ?)",
+        uuid_type.serialize(assigner_id),
+        uuid_type.serialize(filter_id)
+      ])
+      ApplicationRecord.connection.insert(sql)
+    end
+end
