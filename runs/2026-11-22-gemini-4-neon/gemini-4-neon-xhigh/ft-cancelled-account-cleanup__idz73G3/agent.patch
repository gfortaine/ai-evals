@@ -0,0 +1,426 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  test "due_for_incineration includes only accounts cancelled more than 30 days ago" do
+    freeze_time do
+      due_account = accounts(:initech)
+      boundary_account = Account.create_with_owner(
+        account: { name: "Boundary Cancel" },
+        owner: { name: "Owner", identity: identities(:david) }
+      )
+      recent_account = Account.create_with_owner(
+        account: { name: "Recent Cancel" },
+        owner: { name: "Owner", identity: identities(:david) }
+      )
+      active_account = accounts(:"37s")
+
+      due_account.create_cancellation!(initiated_by: due_account.users.first, created_at: 30.days.ago - 1.second)
+      boundary_account.create_cancellation!(initiated_by: boundary_account.users.owner.first, created_at: 30.days.ago)
+      recent_account.create_cancellation!(initiated_by: recent_account.users.owner.first, created_at: 29.days.ago)
+
+      due = Account.due_for_incineration
+
+      assert_includes due, due_account
+      assert_not_includes due, boundary_account
+      assert_not_includes due, recent_account
+      assert_not_includes due, active_account
+
+      assert due_account.due_for_incineration?
+      assert_not boundary_account.due_for_incineration?
+      assert_not recent_account.due_for_incineration?
+      assert_not active_account.due_for_incineration?
+    end
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    account = accounts(:initech)
+    account.create_cancellation!(initiated_by: account.users.first, created_at: 35.days.ago)
+
+    assert_includes Account.due_for_incineration, account
+
+    account.reactivate
+
+    assert_not_includes Account.due_for_incineration, account
+    assert_not account.due_for_incineration?
+  end
+
+  test "incinerate permanently removes all account data across every table and preserves other accounts and global records" do
+    sole_identity = Identity.create!(email_address: "sole-owner@example.com")
+    sole_session = sole_identity.sessions.create!(ip_address: "127.0.0.1", user_agent: "Test")
+    sole_magic_link = MagicLink.create!(identity: sole_identity)
+    sole_token = sole_identity.access_tokens.create!(description: "API", permission: :read)
+    shared_identity = identities(:david)
+
+    # Set up survivor account data to verify complete isolation
+    survivor_account = accounts(:"37s")
+    survivor_card = cards(:logo)
+    survivor_card.reindex
+    survivor_blob = Current.with_account(survivor_account) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("survivor data"),
+        filename: "survivor.txt",
+        content_type: "text/plain"
+      )
+    end
+    survivor_filter = filters(:jz_assignments)
+    survivor_board = boards(:writebook)
+    survivor_filter.update!(board_ids: [ survivor_board.id ])
+    Storage::Entry.record(account: survivor_account, board: survivor_board, delta: 1234, operation: "attach")
+    survivor_account.materialize_storage
+    survivor_board.materialize_storage
+    survivor_counts_before = account_row_counts(survivor_account.id)
+    survivor_search_count_before = Search::Record.for(survivor_account.id).where(account_id: survivor_account.id).count
+
+    # Create target account and populate EVERY single account-scoped table
+    account = Account.create_with_owner(
+      account: { name: "Doomed Corp" },
+      owner: { name: "Doomed Owner", identity: sole_identity }
+    )
+    owner = account.users.owner.first
+    member = account.users.create!(name: "Shared Member", identity: shared_identity, role: :member, verified_at: Time.current)
+
+    blobs = []
+    board_ids = []
+    filter_ids = []
+    search_record_ids = []
+
+    Current.set(account: account, user: owner) do
+      img_path = file_fixture("moon.jpg")
+
+      # User settings & push subscriptions
+      owner.settings.update!(timezone_name: "UTC")
+      Push::Subscription.new(
+        account: account,
+        user: owner,
+        endpoint: "https://fcm.googleapis.com/fcm/send/test",
+        p256dh_key: "key",
+        auth_key: "auth"
+      ).save!(validate: false)
+
+      # Boards, publications, columns, board entropies, rich text
+      board = account.boards.create!(name: "Doomed Board", creator: owner, all_access: true)
+      board.update!(public_description: "<p>Public board info</p>", auto_postpone_period: 7.days)
+      board.publish
+      column = board.columns.create!(name: "In Progress")
+
+      # Tags
+      tag = account.tags.create!(title: "urgent")
+
+      # Cards with image, variant, rich text embed, steps, assignments, taggings, watches, pins,
+      # goldness, activity spike, closure, not_now, reactions, comments, mentions, events, notifications
+      embed_blob = ActiveStorage::Blob.create_and_upload!(
+        io: File.open(img_path), filename: "embed.jpg", content_type: "image/jpeg"
+      )
+      embed_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+
+      card = board.cards.create!(
+        title: "Doomed Card",
+        creator: owner,
+        column: column,
+        status: :published,
+        description: "<p>Card description #{embed_html}</p>"
+      )
+      card.image.attach(io: File.open(img_path), filename: "card.jpg", content_type: "image/jpeg")
+      card.image.blob.upload(File.open(img_path)) unless card.image.blob.service.exist?(card.image.blob.key)
+      card.image.variant(resize_to_limit: [ 50, 50 ]).processed
+
+      owner.avatar.attach(io: File.open(img_path), filename: "avatar.jpg", content_type: "image/jpeg")
+      owner.avatar.blob.upload(File.open(img_path)) unless owner.avatar.blob.service.exist?(owner.avatar.blob.key)
+
+      card.steps.create!(content: "Step 1")
+      card.assignments.create!(assignee: member, assigner: owner)
+      card.taggings.create!(tag: tag)
+      card.watches.find_or_create_by!(user: member)
+      card.pins.create!(user: owner)
+      card.create_goldness!
+      card.create_activity_spike!
+      card.create_closure!(user: owner)
+      card.create_not_now!(user: owner)
+      card.reactions.create!(reacter: owner, content: "thumbsup")
+
+      comment = card.comments.create!(creator: owner, body: "<p>A doomed comment</p>")
+      comment.reactions.create!(reacter: member, content: "heart")
+      mention = Mention.create!(source: comment, mentioner: owner, mentionee: member)
+      event = Event.create!(account: account, board: board, creator: owner, eventable: card, action: "card_published")
+      Notification.create!(user: member, creator: owner, source: event, card: card)
+      Notification.create!(user: owner, creator: member, source: mention, card: card)
+
+      # Webhooks, delinquency tracker, deliveries
+      webhook = board.webhooks.create!(name: "Hook", url: "https://example.com/hook", subscribed_actions: [ "card_published" ])
+      webhook.deliveries.create!(event: event, state: :completed)
+
+      # Filters + ALL 6 HABTM join tables (including legacy assigners_filters)
+      filter = owner.filters.create!(
+        tags: [ tag ],
+        boards: [ board ],
+        assignees: [ member ],
+        creators: [ owner ],
+        closers: [ owner ]
+      )
+      insert_assigners_filter(owner.id, filter.id)
+
+      # Exports (Account::Export and User::DataExport) & Imports
+      account_export = Account::Export.create!(account: account, user: owner)
+      account_export.file.attach(io: StringIO.new("zip1"), filename: "account.zip", content_type: "application/zip")
+      account_export.file.blob.upload(StringIO.new("zip1")) unless account_export.file.blob.service.exist?(account_export.file.blob.key)
+
+      user_export = User::DataExport.create!(account: account, user: owner)
+      user_export.file.attach(io: StringIO.new("zip2"), filename: "user.zip", content_type: "application/zip")
+      user_export.file.blob.upload(StringIO.new("zip2")) unless user_export.file.blob.service.exist?(user_export.file.blob.key)
+
+      import = Account::Import.create!(account: account, identity: sole_identity, status: :completed)
+      import.file.attach(io: StringIO.new("zip3"), filename: "import.zip", content_type: "application/zip")
+      import.file.blob.upload(StringIO.new("zip3")) unless import.file.blob.service.exist?(import.file.blob.key)
+
+      # Unattached direct upload blob
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("unattached"), filename: "orphan.txt", content_type: "text/plain"
+      )
+
+      # Search queries (both with user and orphaned without user)
+      Search::Query.create!(account: account, user: owner, terms: "doomed")
+      Search::Query.create!(account: account, user: member, terms: "member query")
+
+      # Search records (and FTS5 rows on SQLite)
+      card.reindex
+      comment.reindex
+
+      # Storage entries & materialized storage totals (for both Account and Board)
+      Storage::Entry.record(account: account, board: board, recordable: card, delta: 4096, operation: "attach")
+      account.materialize_storage
+      board.materialize_storage
+
+      # Cancel account > 30 days ago
+      account.create_cancellation!(initiated_by: owner, created_at: 31.days.ago)
+
+      blobs = ActiveStorage::Blob.where(account_id: account.id).to_a
+      board_ids = account.boards.pluck(:id)
+      filter_ids = Filter.where(account_id: account.id).pluck(:id)
+      search_record_ids = Search::Record.for(account.id).where(account_id: account.id).pluck(:id)
+    end
+
+    # Sanity check: EVERY SINGLE account_id table has at least 1 row before incineration!
+    counts_before = account_row_counts(account.id)
+    empty_tables = counts_before.select { |_, count| count.zero? }.keys
+    assert_empty empty_tables, "Test setup should populate every account_id table; missing: #{empty_tables.join(', ')}"
+    assert_operator blobs.size, :>=, 5
+    assert blobs.all? { |b| b.service.exist?(b.key) }, "Blobs should exist on storage before incineration"
+    assert_operator search_record_ids.size, :>=, 2
+    assert_operator Storage::Total.where(owner_type: "Account", owner_id: account.id).count, :==, 1
+    assert_operator Storage::Total.where(owner_type: "Board", owner_id: board_ids).count, :==, 1
+    Account::Incineration::FILTER_JOIN_TABLES.each do |table|
+      assert_operator count_filter_join_rows(table, filter_ids), :>=, 1, "Expected #{table} to have rows before incineration"
+    end
+
+    # Run incineration and ensure NO spurious background jobs are enqueued
+    assert_no_enqueued_jobs do
+      account.incinerate
+    end
+
+    # 1. Account itself is gone and marked destroyed
+    assert account.destroyed?
+    assert_not Account.exists?(account.id)
+
+    # 2. ZERO rows remain in EVERY SINGLE table with account_id
+    counts_after = account_row_counts(account.id)
+    leftover = counts_after.select { |_, count| count > 0 }
+    assert_empty leftover, "Leftover rows found after incineration: #{leftover.inspect}"
+
+    # 3. ZERO rows remain in ALL 6 filter join tables
+    Account::Incineration::FILTER_JOIN_TABLES.each do |table|
+      assert_equal 0, count_filter_join_rows(table, filter_ids), "Leftover rows in #{table}"
+    end
+
+    # 4. ZERO rows remain in storage_totals for account or its boards
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: account.id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Board", owner_id: board_ids).count
+
+    # 5. ZERO rows remain in SQLite FTS5 virtual table for incinerated search records
+    if sqlite?
+      fts_remaining = ApplicationRecord.connection.select_value(
+        ApplicationRecord.sanitize_sql_array([
+          "SELECT COUNT(*) FROM search_records_fts WHERE rowid IN (?)", search_record_ids
+        ])
+      )
+      assert_equal 0, fts_remaining, "Leftover rows in search_records_fts"
+    end
+
+    # 6. Physical blob files are removed from storage service
+    blobs.each do |blob|
+      assert_not blob.service.exist?(blob.key), "Expected blob file #{blob.key} (#{blob.filename}) to be deleted"
+    end
+
+    # 7. Global records (identities, sessions, magic links, access tokens) are preserved!
+    assert Identity.exists?(sole_identity.id)
+    assert Identity.exists?(shared_identity.id)
+    assert Session.exists?(sole_session.id)
+    assert MagicLink.exists?(sole_magic_link.id)
+    assert Identity::AccessToken.exists?(sole_token.id)
+
+    # 8. Survivor account data is completely untouched!
+    assert Account.exists?(survivor_account.id)
+    assert_equal survivor_counts_before, account_row_counts(survivor_account.id)
+    assert_equal survivor_search_count_before, Search::Record.for(survivor_account.id).where(account_id: survivor_account.id).count
+    assert survivor_blob.service.exist?(survivor_blob.key)
+    assert_equal 1, Storage::Total.where(owner_type: "Account", owner_id: survivor_account.id).count
+    assert_equal 1, Storage::Total.where(owner_type: "Board", owner_id: survivor_board.id).count
+    assert_equal 1, count_filter_join_rows("boards_filters", [ survivor_filter.id ])
+  end
