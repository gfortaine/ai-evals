+  test "incinerate works across multiple batches" do
+    account = Account.create_with_owner(
+      account: { name: "Batched Account" },
+      owner: { name: "Owner", identity: identities(:david) }
+    )
+    owner = account.users.owner.first
+
+    board_ids = []
+    filter_ids = []
+
+    Current.set(account: account, user: owner) do
+      5.times do |i|
+        board = account.boards.create!(name: "Board #{i}", creator: owner)
+        board.create_storage_total!(bytes_stored: 100 * i)
+        board_ids << board.id
+
+        card = board.cards.create!(title: "Card #{i}", creator: owner, status: :published)
+        card.reindex
+
+        tag = account.tags.create!(title: "tag-#{i}")
+        filter = owner.filters.create!(boards: [ board ], tags: [ tag ])
+        filter_ids << filter.id
+
+        ActiveStorage::Blob.create_and_upload!(
+          io: StringIO.new("data #{i}"), filename: "file_#{i}.txt", content_type: "text/plain"
+        )
+      end
+
+      account.create_cancellation!(initiated_by: owner, created_at: 40.days.ago)
+    end
+
+    Account::Incineration.new(account, batch_size: 2).run
+
+    assert_not Account.exists?(account.id)
+    assert_empty account_row_counts(account.id).select { |_, count| count > 0 }
+    assert_equal 0, Storage::Total.where(owner_type: "Board", owner_id: board_ids).count
+    assert_equal 0, count_filter_join_rows("boards_filters", filter_ids)
+    assert_equal 0, count_filter_join_rows("filters_tags", filter_ids)
+  end
+
+  test "incinerate is idempotent and recovers cleanly from partial deletion" do
+    account = Account.create_with_owner(
+      account: { name: "Partial Account" },
+      owner: { name: "Owner", identity: identities(:david) }
+    )
+    owner = account.users.owner.first
+
+    Current.set(account: account, user: owner) do
+      board = account.boards.create!(name: "Board", creator: owner)
+      board.cards.create!(title: "Card", creator: owner, status: :published)
+      account.create_cancellation!(initiated_by: owner, created_at: 40.days.ago)
+    end
+
+    # Simulate partial deletion before crash (boards already gone, cards still present)
+    Board.where(account_id: account.id).delete_all
+
+    # Account is still due for incineration
+    assert_includes Account.due_for_incineration, account
+
+    # Retry completes cleanly
+    account.incinerate
+    assert_not Account.exists?(account.id)
+    assert_empty account_row_counts(account.id).select { |_, count| count > 0 }
+
+    # Calling incinerate a second time on the already-incinerated account does not raise
+    assert_nothing_raised { account.incinerate }
+  end
