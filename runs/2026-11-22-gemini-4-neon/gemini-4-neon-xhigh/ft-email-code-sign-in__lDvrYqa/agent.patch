diff --git a/test/controllers/sessions/magic_links_controller_test.rb b/test/controllers/sessions/magic_links_controller_test.rb
new file mode 100644
index 0000000..29c8ee1
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,282 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:david)
+  end
+
+  test "show renders code input form when pending authentication token is present" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      follow_redirect!
+
+      assert_response :success
+      assert_select "form[action='#{session_magic_link_path}']" do
+        assert_select "input[name='code'][autocomplete='one-time-code']"
+      end
+      assert_in_body @identity.email_address
+      assert_not_includes response.body, "Psst, here's your code"
+    end
+  end
+
+  test "show redirects to new session when pending authentication token is missing" do
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to new_session_path
+      assert_equal "Enter your email address to sign in.", flash[:alert]
+    end
+  end
+
+  test "show redirects authenticated users" do
+    sign_in_as :david
+
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to root_url
+    end
+  end
+
+  test "create signs in with a valid code from the email subject" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+      assert_equal 6, code.length
+
+      assert_difference -> { MagicLink.count }, -1 do
+        assert_difference -> { Session.count }, 1 do
+          post session_magic_link_path, params: { code: code }
+        end
+      end
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create signs in with lowercase, spaced, or visually ambiguous code characters" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      magic_link = @identity.magic_links.last
+      magic_link.update!(code: "01A2B3")
+
+      post session_magic_link_path, params: { code: " o-i a2b3 " }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create redirects sign-up magic link to signup completion" do
+    untenanted do
+      assert_emails 1 do
+        post signup_path, params: { signup: { email_address: "newperson@example.com" } }
+      end
+
+      code = extract_code_from_last_email
+
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create works up to 15 minutes" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = @identity.magic_links.last.code
+
+      travel 14.minutes + 59.seconds do
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to landing_url
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects code after 15 minutes" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = @identity.magic_links.last.code
+
+      travel 15.minutes + 1.second do
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects an expired code even when pending token is refreshed" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      first_code = @identity.magic_links.last.code
+
+      travel 10.minutes do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: first_code }
+        assert_redirected_to session_magic_link_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects invalid code and preserves pending authentication token" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      post session_magic_link_path, params: { code: "WR0NG1" }
+
+      assert_redirected_to session_magic_link_path
+      assert flash[:shake]
+      assert_equal "Try another code.", flash[:alert]
+      assert_not cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create rejects blank code" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      post session_magic_link_path, params: { code: "" }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects reusing an already consumed code" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = @identity.magic_links.last.code
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      sign_out
+
+      post session_path, params: { email_address: @identity.email_address }
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects another identity's code without consuming it" do
+    other_identity = identities(:kevin)
+    other_link = other_identity.magic_links.create!
+
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      post session_magic_link_path, params: { code: other_link.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(other_link.id), "Other identity's magic link must not be consumed"
+    end
+  end
+
+  test "create rejects missing pending authentication token" do
+    magic_link = @identity.magic_links.create!
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "create authenticates via JSON and returns session_token" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }, as: :json
+      end
+
+      assert_response :created
+      pending_token = @response.parsed_body["pending_authentication_token"]
+      assert pending_token.present?
+
+      code = extract_code_from_last_email
+
+      post session_magic_link_path,
+        params: { code: code },
+        headers: { "Cookie" => "pending_authentication_token=#{pending_token}" },
+        as: :json
+
+      assert_response :success
+      session_token = @response.parsed_body["session_token"]
+      assert session_token.present?
+
+      get my_identity_path,
+        headers: { "Cookie" => "session_token=#{session_token}" },
+        as: :json
+
+      assert_response :success
+    end
+  end
+
+  test "create via JSON rejects invalid code with 401" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }, as: :json
+      pending_token = @response.parsed_body["pending_authentication_token"]
+
+      post session_magic_link_path,
+        params: { code: "WR0NG1" },
+        headers: { "Cookie" => "pending_authentication_token=#{pending_token}" },
+        as: :json
+
+      assert_response :unauthorized
+      assert @response.parsed_body["message"].present?
+    end
+  end
+
+  test "create via JSON rejects missing pending token with 401" do
+    magic_link = @identity.magic_links.create!
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }, as: :json
+
+      assert_response :unauthorized
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: "WR0NG1" }
+      assert_redirected_to session_magic_link_path
+      assert_equal "Wait 15 minutes, then try again.", flash[:alert]
+
+      post session_magic_link_path, params: { code: "WR0NG1" }, as: :json
+      assert_response :too_many_requests
+    end
+  end
+
+  private
+    def extract_code_from_last_email
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email, "Expected a magic link email to be delivered"
+      match = email.subject.match(/\b([0-9A-Z]{6})\b/)
+      assert_not_nil match, "Expected a 6-character code in subject #{email.subject.inspect}"
+      match[1]
+    end
+end
