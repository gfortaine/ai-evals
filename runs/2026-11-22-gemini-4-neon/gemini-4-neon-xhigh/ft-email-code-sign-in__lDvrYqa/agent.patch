@@ -0,0 +1,36 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:shake] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p class="margin-none-block-start">
+    Then enter the verification code included in the email below:
+  </p>
+
+  <%= form_with url: session_magic_link_path, method: :post, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <label class="for-screen-reader" for="code">Verification code</label>
+    <%= form.text_field :code, required: true, class: "input center txt-align-center",
+          autofocus: true, autocorrect: "off", autocapitalize: "characters", spellcheck: "false",
+          autocomplete: "one-time-code", placeholder: "••••••", value: params[:code] %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle">
+    The code sent to <strong><%= email_address_pending_authentication %></strong> will work for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.
+  </p>
+
+  <% if Rails.env.development? && flash[:magic_link_code].present? %>
+    <div class="fill-shade border-radius pad margin-block-start flex align-center justify-center gap-half">
+      <span>Psst, here's your code:</span>
+      <code class="txt-large font-weight-black"><%= flash[:magic_link_code] %></code>
+    </div>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
