--- /dev/null
+++ b/test/models/magic_link/code_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class MagicLink::CodeTest < ActiveSupport::TestCase
+  test "generate produces codes of requested length using unambiguous alphabet" do
+    50.times do
+      code = MagicLink::Code.generate(6)
+
+      assert_equal 6, code.length
+      assert_match(/\A[0-9A-HJ-NP-TV-Z]{6}\z/, code)
+      assert_no_match(/[OILU]/, code)
+    end
+  end
+
+  test "sanitize normalizes casing, whitespace, punctuation, and ambiguous characters" do
+    assert_equal "ABC123", MagicLink::Code.sanitize("abc123")
+    assert_equal "ABC123", MagicLink::Code.sanitize("  abc 123  ")
+    assert_equal "ABC123", MagicLink::Code.sanitize("a-b-c-1-2-3")
+    assert_equal "011234", MagicLink::Code.sanitize("oil234")
+    assert_equal "011234", MagicLink::Code.sanitize("OIL234")
+    assert_nil MagicLink::Code.sanitize("")
+    assert_nil MagicLink::Code.sanitize("   ")
+    assert_nil MagicLink::Code.sanitize("---")
+    assert_nil MagicLink::Code.sanitize(nil)
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..46443c8
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:david)
+  end
+
+  test "creating a magic link generates a 6-character code and 15-minute expiration" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_equal 6, magic_link.code.length
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "purpose supports sign_in and sign_up" do
+    sign_in_link = @identity.magic_links.create!(purpose: :sign_in)
+    sign_up_link = @identity.magic_links.create!(purpose: :sign_up)
+
+    assert sign_in_link.for_sign_in?
+    assert_not sign_in_link.for_sign_up?
+
+    assert sign_up_link.for_sign_up?
+    assert_not sign_up_link.for_sign_in?
+  end
+
+  test "generates a unique code if a collision occurs" do
+    existing = @identity.magic_links.create!
+    MagicLink::Code.stubs(:generate).returns(existing.code, "XYZ789")
+
+    magic_link = @identity.magic_links.create!
+
+    assert_equal "XYZ789", magic_link.code
+  end
+
+  test "active and stale scopes respect the 15-minute expiration" do
+    magic_link = @identity.magic_links.create!
+
+    assert_includes MagicLink.active, magic_link
+    assert_not_includes MagicLink.stale, magic_link
+
+    travel 14.minutes + 59.seconds do
+      assert_includes MagicLink.active, magic_link
+      assert_not_includes MagicLink.stale, magic_link
+    end
+
+    travel 15.minutes + 1.second do
+      assert_not_includes MagicLink.active, magic_link
+      assert_includes MagicLink.stale, magic_link
+    end
+  end
+
+  test "consume finds, deletes, and returns an active magic link" do
+    magic_link = @identity.magic_links.create!
+
+    consumed = MagicLink.consume(magic_link.code)
+
+    assert_equal magic_link, consumed
+    assert consumed.destroyed?
+    assert_equal @identity, consumed.identity
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume sanitizes code input" do
+    magic_link = @identity.magic_links.create!(code: "01A2B3")
+
+    consumed = MagicLink.consume(" o-i a2b3 ")
+
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume returns nil for already consumed code" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume returns nil for expired code" do
+    magic_link = @identity.magic_links.create!
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "consume returns nil for invalid or blank code" do
+    assert_nil MagicLink.consume("NOPE99")
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume(nil)
+  end
+
+  test "scoped consume only matches the given identity and preserves other identities' links" do
+    davids_link = identities(:david).magic_links.create!
+    kevins_link = identities(:kevin).magic_links.create!
+
+    assert_nil identities(:david).magic_links.consume(kevins_link.code)
+    assert MagicLink.exists?(kevins_link.id), "Kevin's magic link should not be consumed by David"
+
+    assert_equal davids_link, identities(:david).magic_links.consume(davids_link.code)
+    assert_equal kevins_link, identities(:kevin).magic_links.consume(kevins_link.code)
+  end
+
+  test "cleanup removes expired magic links and keeps active ones" do
+    expired_link = @identity.magic_links.create!(expires_at: 1.minute.ago)
+    active_link = @identity.magic_links.create!(expires_at: 10.minutes.from_now)
+
+    assert_difference -> { MagicLink.count }, -1 do
+      MagicLink.cleanup
+    end
+
+    assert_not MagicLink.exists?(expired_link.id)
+    assert MagicLink.exists?(active_link.id)
+  end
+end
