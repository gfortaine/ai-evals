diff --git a/test/system/magic_link_authentication_test.rb b/test/system/magic_link_authentication_test.rb
new file mode 100644
index 0000000..7c32001
--- /dev/null
+++ b/test/system/magic_link_authentication_test.rb
@@ -0,0 +1,98 @@
+require "application_system_test_case"
+
+class MagicLinkAuthenticationTest < ApplicationSystemTestCase
+  include ActionMailer::TestHelper
+
+  test "sign in by email code" do
+    identity = identities(:david)
+
+    visit new_session_url(script_name: nil)
+    fill_in "email_address", with: identity.email_address
+
+    assert_emails 1 do
+      click_on "Let’s go"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+
+    # Wrong code first shows alert and stays on code screen
+    fill_in "code", with: "WR0NG1"
+    click_on "Continue"
+    assert_selector "h1", text: "Check your email"
+    assert_text "Try another code."
+
+    # Right code signs in and lands in account
+    fill_in "code", with: code.downcase
+    click_on "Continue"
+
+    assert_no_selector "h1", text: "Check your email"
+    assert_current_path root_path(script_name: accounts("37s").slug)
+  end
+
+  test "sign up by email code" do
+    Account.any_instance.stubs(:setup_customer_template)
+
+    visit new_signup_url(script_name: nil)
+    fill_in "signup_email_address", with: "alice.signup@example.com"
+
+    assert_emails 1 do
+      click_on "Let’s go"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+    fill_in "code", with: code
+    click_on "Continue"
+
+    assert_selector "h1", text: "Complete your sign-up"
+
+    fill_in "signup_full_name", with: "Alice Example"
+    click_on "Continue"
+    assert_no_selector "h1", text: "Complete your sign-up"
+
+    identity = Identity.find_by!(email_address: "alice.signup@example.com")
+    account = identity.accounts.last
+    assert_not_nil account
+    assert_current_path root_path(script_name: account.slug)
+  end
+
+  test "join account with a join code by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    visit join_url(code: join_code.code, script_name: account.slug)
+    fill_in "email_address", with: "bob.joiner@example.com"
+
+    assert_emails 1 do
+      click_on "Continue"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+    fill_in "code", with: code
+    click_on "Continue"
+
+    # Auto-submits verification and lands on name entry screen
+    assert_selector "h1", text: "Great! Now enter your name"
+
+    fill_in "user_name", with: "Bob Joiner"
+    click_on "Continue"
+
+    assert_no_selector "h1", text: "Great! Now enter your name"
+
+    identity = Identity.find_by!(email_address: "bob.joiner@example.com")
+    user = account.users.find_by!(identity: identity)
+    assert user.verified?
+    assert_equal "Bob Joiner", user.name
+  end
+
+  private
+    def extract_code_from_last_email
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email, "Expected a magic link email to be delivered"
+      match = email.subject.match(/\b([0-9A-Z]{6})\b/)
+      assert_not_nil match, "Expected a 6-character code in subject #{email.subject.inspect}"
+      match[1]
+    end
+end
