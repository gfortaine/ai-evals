diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..e0225b5 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -38,4 +38,46 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "uploaded picture is derived once and reused when opening the book" do
+    transforms = 0
+    callback = ->(*) { transforms += 1 }
+
+    ActiveSupport::Notifications.subscribed(callback, "transform.active_storage") do
+      perform_enqueued_jobs do
+        put leafable_path(leaves(:reading_picture)), params: {
+          picture: {
+            image: fixture_file_upload("white-rabbit.webp", "image/webp")
+          }
+        }
+      end
+
+      assert_response :no_content
+      blob = leaves(:reading_picture).reload.picture.image.blob
+      assert_equal 1, transforms
+      assert_equal 1, blob.variant_records.count
+      assert ActiveStorage::Blob.service.exist?(blob.variant_records.first.image.key)
+
+      sign_in :jz
+
+      assert_no_difference -> { ActiveStorage::Blob.count } do
+        get book_slug_path(books(:handbook))
+        assert_response :success
+
+        image_src = css_select("img[src*='/rails/active_storage/representations/']").first["src"]
+        assert image_src.present?
+
+        get image_src
+        assert_response :redirect
+
+        follow_redirect!
+        assert_response :success
+        assert_equal "image/webp", response.media_type
+        assert_equal blob.variant_records.first.image.download, response.body
+      end
+
+      assert_equal 1, transforms
+      assert_equal 1, blob.variant_records.reload.count
+    end
+  end
 end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..0ec9a0f 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,11 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "large_image variation digest is stable across URL key round-trip" do
+    variant = pictures(:reading).large_image
+    decoded = pictures(:reading).image.blob.variant(variant.variation.key)
+
+    assert_equal variant.variation.digest, decoded.variation.digest
+  end
 end
