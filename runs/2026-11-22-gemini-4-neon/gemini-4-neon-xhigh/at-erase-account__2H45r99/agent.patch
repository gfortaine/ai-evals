diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..83cdde6
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,253 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "erasing an active user removes user, sessions, sign-in events, accesses, and reading marks" do
+    kevin = users(:kevin)
+    david = users(:david)
+
+    kevin.sessions.start!(user_agent: "TestBrowser", ip_address: "10.0.0.1")
+    old_session = kevin.sessions.start!(user_agent: "OldBrowser", ip_address: "10.0.0.2")
+    old_session.destroy!
+    kevin.sessions.start!(user_agent: "ActiveBrowser", ip_address: "10.0.0.3")
+
+    david.sessions.start!(user_agent: "DavidBrowser", ip_address: "10.0.0.4")
+
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+    ReadingMark.remember(leaves(:welcome_page), user: david)
+
+    assert_equal 4, SignInEvent.for_address(kevin.email_address).count
+    assert_equal 2, kevin.sessions.count
+
+    Current.user = david
+    kevin.destroy!
+
+    assert_not User.exists?(kevin.id)
+    assert_empty Session.where(user_id: kevin.id)
+    assert_empty SignInEvent.for_address(kevin.email_address)
+    assert_empty Access.where(user_id: kevin.id)
+    assert_empty ReadingMark.where(user_id: kevin.id)
+
+    # Other users' data remains intact
+    assert User.exists?(david.id)
+    assert_equal 1, SignInEvent.for_address(david.email_address).count
+    assert_equal 1, ReadingMark.where(user_id: david.id).count
+    assert Book.exists?(books(:handbook).id)
+  end
+
+  test "erasing a user destroys private books, their revisions, attachments, blobs, and search index entries" do
+    kevin = users(:kevin)
+    david = users(:david)
+
+    Current.user = kevin
+    private_book = Book.create!(title: "Kevin Private Notes", author: "Kevin", everyone_access: false, published: true)
+    private_book.cover.attach(io: file_fixture("reading.webp").open, filename: "cover.webp", content_type: "image/webp")
+    private_book.update_access(editors: [ kevin.id ], readers: [ david.id ])
+
+    page_leaf = private_book.press(Page.new(body: "Original secret quokka"), title: "Secret Page")
+    page_leaf.page.body.uploads.attach(io: file_fixture("pixel.bmp").open, filename: "rev1.bmp", content_type: "image/bmp")
+    page_leaf.page.body.save!
+    page_leaf.edit(leafable_params: { body: "Updated secret quokka" })
+    page_leaf.page.body.uploads.attach(io: file_fixture("pixel.bmp").open, filename: "rev2.bmp", content_type: "image/bmp")
+    page_leaf.page.body.save!
+
+    trashed_leaf = private_book.press(Page.new(body: "Trashed secret narwhal"), title: "Trashed Page")
+    trashed_leaf.edit(leafable_params: { body: "Trashed edited narwhal" })
+    trashed_leaf.trashed!
+
+    section_leaf = private_book.press(Section.new(body: "Section secret axolotl"), title: "Secret Section")
+    section_leaf.edit(leafable_params: { body: "Updated section axolotl" })
+
+    cleared_section = private_book.press(Section.new(body: "Cleared secret capybara"), title: "Cleared Section")
+    cleared_section.leafable.update!(body: nil)
+    cleared_section.update!(title: "Cleared Section Updated")
+
+    picture_leaf = private_book.press(Picture.new(caption: "Secret picture"), title: "Secret Picture")
+    picture_leaf.picture.image.attach(io: file_fixture("white-rabbit.webp").open, filename: "rabbit.webp", content_type: "image/webp")
+    picture_leaf.picture.large_image.processed
+    picture_leaf.edit(leafable_params: { caption: "Edited secret picture" })
+
+    ReadingMark.remember(page_leaf, user: kevin)
+    ReadingMark.remember(page_leaf, user: david)
+
+    leaf_ids = private_book.leaves.pluck(:id)
+    page_ids = (Leaf.where(id: leaf_ids, leafable_type: "Page").pluck(:leafable_id) +
+      Edit.where(leaf_id: leaf_ids, leafable_type: "Page").pluck(:leafable_id)).uniq
+    section_ids = (Leaf.where(id: leaf_ids, leafable_type: "Section").pluck(:leafable_id) +
+      Edit.where(leaf_id: leaf_ids, leafable_type: "Section").pluck(:leafable_id)).uniq
+    picture_ids = (Leaf.where(id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id) +
+      Edit.where(leaf_id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id)).uniq
+    markdown_ids = ActionText::Markdown.where(record_type: "Page", record_id: page_ids).pluck(:id)
+
+    primary_blob_ids = (
+      ActiveStorage::Attachment.where(record_type: "Book", record_id: private_book.id).pluck(:blob_id) +
+      ActiveStorage::Attachment.where(record_type: "Picture", record_id: picture_ids).pluck(:blob_id) +
+      ActiveStorage::Attachment.where(record_type: "ActionText::Markdown", record_id: markdown_ids).pluck(:blob_id)
+    ).uniq
+    variant_record_ids = ActiveStorage::VariantRecord.where(blob_id: primary_blob_ids).pluck(:id)
+    variant_blob_ids = ActiveStorage::Attachment.where(record_type: "ActiveStorage::VariantRecord", record_id: variant_record_ids).pluck(:blob_id)
+    all_blob_ids = (primary_blob_ids + variant_blob_ids).uniq
+    all_blob_keys = ActiveStorage::Blob.where(id: all_blob_ids).pluck(:key)
+
+    assert_not_empty all_blob_ids
+    assert_not_empty variant_record_ids
+
+    Current.user = david
+    kevin.destroy!
+
+    assert_not Book.exists?(private_book.id)
+    assert_empty Access.where(book_id: private_book.id)
+    assert_empty Leaf.where(id: leaf_ids)
+    assert_empty Edit.where(leaf_id: leaf_ids)
+    assert_empty ReadingMark.where(leaf_id: leaf_ids)
+    assert_empty Page.where(id: page_ids)
+    assert_empty Section.where(id: section_ids)
+    assert_empty Picture.where(id: picture_ids)
+    assert_empty ActionText::Markdown.where(id: markdown_ids)
+    assert_empty ActiveStorage::Attachment.where(blob_id: all_blob_ids)
+    assert_empty ActiveStorage::VariantRecord.where(id: variant_record_ids)
+    assert_empty ActiveStorage::Blob.where(id: all_blob_ids)
+
+    all_blob_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key), "Expected blob file #{key} to be deleted"
+    end
+
+    fts_rows = ActiveRecord::Base.connection.select_all(
+      "select rowid from leaf_search_index where rowid in (#{leaf_ids.join(',')})"
+    ).to_a
+    assert_empty fts_rows
+
+    assert_empty Leaf.search("quokka")
+    assert_empty Leaf.search("narwhal")
+    assert_empty Leaf.search("axolotl")
+    assert_empty Leaf.search("capybara")
+
+    # Background purge jobs (if any were enqueued) also complete cleanly
+    assert_nothing_raised { perform_enqueued_jobs }
+  end
+
+  test "erasing a user keeps everyone-access books and bylines them Deleted author" do
+    kevin = users(:kevin)
+    david = users(:david)
+
+    Current.user = kevin
+    shared_book = Book.create!(title: "Team Playbook", author: "Kevin Smith", everyone_access: true)
+    shared_book.update_access(editors: [ kevin.id ], readers: [])
+    shared_page = shared_book.press(Page.new(body: "Shared knowledge flamingo"), title: "Intro")
+
+    blank_author_shared_book = Book.create!(title: "Untitled Notes", author: nil, everyone_access: true)
+    blank_author_shared_book.update_access(editors: [ kevin.id ], readers: [])
+
+    ReadingMark.remember(shared_page, user: kevin)
+    ReadingMark.remember(shared_page, user: david)
+
+    Current.user = david
+    kevin.destroy!
+
+    assert Book.exists?(shared_book.id)
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert shared_book.everyone_access?
+
+    blank_author_shared_book.reload
+    assert_nil blank_author_shared_book.creator_id
+    assert_equal "Deleted author", blank_author_shared_book.author
+
+    # Other users still have access, reading marks, and search hits on the shared book
+    assert shared_book.accessable?(user: david)
+    assert_not shared_book.accessable?(user: kevin)
+    assert ReadingMark.exists?(user_id: david.id, leaf_id: shared_page.id)
+    assert_not ReadingMark.exists?(user_id: kevin.id)
+    assert_includes shared_book.leaves.search("flamingo"), shared_page
+
+    # Subsequent edits by another user do not reassign creator_id
+    shared_book.update!(title: "Team Playbook v2")
+    assert_nil shared_book.reload.creator_id
+  end
+
+  test "erasing a previously deactivated user removes their original sign-in events and all other data" do
+    alice = User.create!(name: "Alice", email_address: "alice.smith+work@example.com", password: "secret123456")
+    other = User.create!(name: "Malice", email_address: "malice.smith+work@example.com", password: "secret123456")
+
+    alice.sessions.start!(user_agent: "Safari", ip_address: "192.0.2.1")
+    s2 = alice.sessions.start!(user_agent: "Chrome", ip_address: "192.0.2.2")
+    s2.destroy!
+    other.sessions.start!(user_agent: "Firefox", ip_address: "192.0.2.3")
+
+    Current.user = alice
+    private_book = Book.create!(title: "Alice Diary", author: "Alice", everyone_access: false)
+    private_book.update_access(editors: [ alice.id ], readers: [])
+    diary_page = private_book.press(Page.new(body: "Personal secret platypus"), title: "Day 1")
+
+    shared_book = Book.create!(title: "Company Wiki", author: "Alice", everyone_access: true)
+    shared_book.update_access(editors: [ alice.id ], readers: [])
+
+    ReadingMark.remember(diary_page, user: alice)
+    ReadingMark.remember(leaves(:welcome_page), user: alice)
+
+    # Simulate old deactivation flow
+    alice.deactivate
+    assert_not alice.active?
+    assert_match(/\Aalice\.smith\+work-deactivated-[0-9a-f-]+@example\.com\z/, alice.email_address)
+
+    # Also add a sign-in event under the deactivated address just in case
+    SignInEvent.create!(action: :signed_out, email_address: alice.email_address, ip_address: "192.0.2.1")
+
+    Current.user = users(:david)
+    alice.destroy!
+
+    assert_not User.exists?(alice.id)
+    assert_empty SignInEvent.for_address("alice.smith+work@example.com")
+    assert_empty SignInEvent.for_address(alice.email_address)
+    assert_equal 1, SignInEvent.for_address("malice.smith+work@example.com").count
+
+    assert_empty Access.where(user_id: alice.id)
+    assert_empty ReadingMark.where(user_id: alice.id)
+    assert_not Book.exists?(private_book.id)
+    assert_empty Leaf.search("platypus")
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+  end
+
+  test "erasing a user deactivated multiple times or with a non-uuid deactivated suffix still erases original sign-in events" do
+    multi = User.create!(name: "Multi", email_address: "multi@example.com", password: "secret123456")
+    multi.sessions.start!(user_agent: "UA", ip_address: "127.0.0.1")
+    multi.deactivate
+    multi.deactivate
+    multi.destroy!
+    assert_empty SignInEvent.for_address("multi@example.com")
+
+    legacy = User.create!(name: "Legacy", email_address: "legacy-deactivated-oldtoken@example.com", password: "secret123456", active: false)
+    SignInEvent.create!(action: :signed_in, email_address: "legacy@example.com", ip_address: "127.0.0.1")
+    legacy.destroy!
+    assert_empty SignInEvent.for_address("legacy@example.com")
+  end
+
+  test "erasing an active user whose email contains -deactivated- does not erase another user's sign-in events" do
+    real_user = User.create!(name: "Real", email_address: "real@example.com", password: "secret123456")
+    real_user.sessions.start!(user_agent: "UA", ip_address: "127.0.0.1")
+
+    tricky = User.create!(name: "Tricky", email_address: "real-deactivated-note@example.com", password: "secret123456", active: true)
+    tricky.sessions.start!(user_agent: "UA", ip_address: "127.0.0.2")
+
+    tricky.destroy!
+
+    assert_empty SignInEvent.for_address("real-deactivated-note@example.com")
+    assert_equal 1, SignInEvent.for_address("real@example.com").count
+  end
+
+  test "erased user's name and email can be reused by a new user" do
+    kevin = users(:kevin)
+    original_name = kevin.name
+    original_email = kevin.email_address
+
+    kevin.destroy!
+
+    new_user = User.create!(name: original_name, email_address: original_email, password: "secret123456")
+    assert new_user.persisted?
+  end
+end
