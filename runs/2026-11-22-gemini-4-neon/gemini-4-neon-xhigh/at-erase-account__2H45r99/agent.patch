+    leaf.edit leafable_params: { body: "Updated body" }
+    updated_page_id = leaf.leafable_id
+    leaf.trashed!
+
+    leaf.destroy!
+
+    assert_empty Edit.where(leaf_id: leaf.id)
+    assert_empty Page.where(id: [ original_page_id, updated_page_id ])
+    assert_empty ActionText::Markdown.where(record_type: "Page", record_id: [ original_page_id, updated_page_id ])
+  end
 end
