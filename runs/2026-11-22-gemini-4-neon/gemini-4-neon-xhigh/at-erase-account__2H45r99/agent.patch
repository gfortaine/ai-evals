diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..ca68f5c
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,98 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DEACTIVATED_EMAIL_UUID_PATTERN = /(?:-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})+(?=@)/i
+  DEACTIVATED_EMAIL_FALLBACK_PATTERN = /-deactivated-[^@]+(?=@)/i
+
+  included do
+    before_destroy :prepare_erasure, prepend: true
+    after_destroy :erase_sign_in_events
+    after_destroy_commit :purge_erased_blobs
+  end
+
+  private
+    def prepare_erasure
+      @erased_email_addresses = sign_in_email_addresses
+      @erased_primary_blob_ids, @erased_secondary_blob_ids = collect_private_book_blob_ids
+
+      anonymize_shared_books
+      destroy_private_books
+    end
+
+    def anonymize_shared_books
+      Book.where(creator_id: id, everyone_access: true).find_each(&:anonymize_author)
+    end
+
+    def destroy_private_books
+      Book.where(creator_id: id).find_each(&:destroy!)
+    end
+
+    def erase_sign_in_events
+      SignInEvent.for_address(@erased_email_addresses).delete_all
+    end
+
+    def purge_erased_blobs
+      if @erased_primary_blob_ids.present?
+        ActiveStorage::Blob.where(id: @erased_primary_blob_ids).find_each(&:purge)
+      end
+
+      if @erased_secondary_blob_ids.present?
+        ActiveStorage::Blob.where(id: @erased_secondary_blob_ids).find_each(&:purge)
+      end
+    ensure
+      @erased_primary_blob_ids = nil
+      @erased_secondary_blob_ids = nil
+    end
+
+    def sign_in_email_addresses
+      address = email_address_in_database.presence || email_address
+      [ address, original_email_address(address) ].compact.uniq
+    end
+
+    def original_email_address(address)
+      return if address.blank?
+
+      if address.match?(DEACTIVATED_EMAIL_UUID_PATTERN)
+        address.sub(DEACTIVATED_EMAIL_UUID_PATTERN, "")
+      elsif !active_in_database && address.match?(DEACTIVATED_EMAIL_FALLBACK_PATTERN)
+        address.sub(DEACTIVATED_EMAIL_FALLBACK_PATTERN, "")
+      end
+    end
+
+    def collect_private_book_blob_ids
+      book_ids = Book.where(creator_id: id, everyone_access: false).pluck(:id)
+      return [ [], [] ] if book_ids.empty?
+
+      leaf_ids = Leaf.where(book_id: book_ids).pluck(:id)
+
+      page_ids = (
+        Leaf.where(id: leaf_ids, leafable_type: "Page").pluck(:leafable_id) +
+        Edit.where(leaf_id: leaf_ids, leafable_type: "Page").pluck(:leafable_id)
+      ).uniq
+
+      picture_ids = (
+        Leaf.where(id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id) +
+        Edit.where(leaf_id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id)
+      ).uniq
+
+      markdown_ids = ActionText::Markdown.where(record_type: "Page", record_id: page_ids).pluck(:id)
+
+      primary_blob_ids = (
+        ActiveStorage::Attachment.where(record_type: "Book", record_id: book_ids).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "Picture", record_id: picture_ids).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "ActionText::Markdown", record_id: markdown_ids).pluck(:blob_id)
+      ).uniq
+
+      secondary_blob_ids = if primary_blob_ids.any?
+        variant_record_ids = ActiveStorage::VariantRecord.where(blob_id: primary_blob_ids).pluck(:id)
+        (
+          ActiveStorage::Attachment.where(record_type: "ActiveStorage::VariantRecord", record_id: variant_record_ids).pluck(:blob_id) +
+          ActiveStorage::Attachment.where(record_type: "ActiveStorage::Blob", record_id: primary_blob_ids).pluck(:blob_id)
+        ).uniq
+      else
+        []
+      end
+
+      [ primary_blob_ids, secondary_blob_ids ]
+    end
+end
