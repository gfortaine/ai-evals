diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..96e6d78
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "finds matching leaves in readable books" do
+    get library_search_path, params: { q: "Handbook" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /Welcome to The Handbook!/
+  end
+
+  test "search is case insensitive" do
+    get library_search_path, params: { q: "handbook" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /Welcome to The Handbook!/
+  end
+
+  test "empty and blank queries return no results" do
+    get library_search_path
+    assert_response :success
+    assert_select "a.search__result", count: 0
+
+    get library_search_path, params: { q: "   " }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "excludes trashed leaves" do
+    leaves(:summary_page).trashed!
+
+    get library_search_path, params: { q: "Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "does not leak pages from unreadable books via SQL injection" do
+    books(:manual).press Page.new(body: "Classified"), title: "Secret Manual Page"
+
+    [
+      "' OR 1=1 --",
+      "') OR 1=1 --",
+      "' OR 1=1 OR 'a'='a",
+      "' UNION SELECT * FROM leaves --",
+      "Secret"
+    ].each do |payload|
+      get library_search_path, params: { q: payload }
+
+      assert_response :success
+      assert_not_in_body "Secret Manual Page"
+    end
+  end
+
+  test "signed-out users only see results from published books even with SQL injection" do
+    books(:manual).press Page.new(body: "Classified"), title: "Secret Manual Page"
+    sign_out
+
+    get library_search_path, params: { q: "Handbook" }
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "' OR 1=1 OR 'a'='a" }
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Secret Manual Page"
+
+    books(:handbook).update!(published: true)
+
+    get library_search_path, params: { q: "Handbook" }
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "') OR 1=1 --" }
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "handles apostrophes and punctuation without error and matches literally" do
+    leaves(:summary_page).update!(title: "O'Brien's \"Guide\" (C:\\docs)")
+
+    get library_search_path, params: { q: "No'Match" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+
+    get library_search_path, params: { q: "'" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /O'Brien's/
+
+    get library_search_path, params: { q: "O'Brien" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /O'Brien's/
+
+    get library_search_path, params: { q: '"' }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /O'Brien's/
+
+    get library_search_path, params: { q: "\\" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /O'Brien's/
+  end
+
+  test "percent sign matches literally and does not act as a wildcard" do
+    leaves(:summary_page).update!(title: "Save 50% off")
+    books(:manual).press Page.new(body: "Secret discount"), title: "Secret 50% off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /Save 50% off/
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /Save 50% off/
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Secret 50% off"
+
+    get library_search_path, params: { q: "%%" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "underscore matches literally and does not act as a wildcard" do
+    leaves(:summary_page).update!(title: "snake_case_guide")
+    books(:handbook).press Page.new(body: "Other"), title: "snakeXcaseXguide"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /snake_case_guide/
+    assert_not_in_body "snakeXcaseXguide"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "snake_case" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /snake_case_guide/
+    assert_not_in_body "snakeXcaseXguide"
+
+    get library_search_path, params: { q: "_______" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+end
