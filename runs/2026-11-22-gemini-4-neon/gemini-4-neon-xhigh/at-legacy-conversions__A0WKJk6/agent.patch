diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..372900d
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "show renders HTML shelf report with formatted date and delimited character count" do
+    book = books(:handbook)
+    leaves(:welcome_page).leafable.update!(body: "a" * 1200)
+    book.update_columns(updated_at: Time.utc(2025, 3, 15, 14, 30, 0))
+
+    get book_report_path(book)
+
+    assert_response :success
+    assert_in_body "Last updated March 15, 2025"
+    assert_in_body "Handbook — #{book.markable.length.to_fs(:delimited)} characters"
+    assert_in_body "1,2"
+  end
+
+  test "show downloads text report card with timestamped filename and formatted rows" do
+    book = books(:handbook)
+    book.update_columns(
+      created_at: Time.utc(2025, 2, 1, 9, 5, 0),
+      updated_at: Time.utc(2025, 3, 15, 14, 30, 0)
+    )
+
+    get book_report_path(book, format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_includes response.headers["Content-Disposition"], "shelf-report-20250315143000.txt"
+
+    expected_ids = [
+      leaves(:welcome_section).id,
+      leaves(:welcome_page).id,
+      leaves(:summary_page).id,
+      leaves(:reading_picture).id
+    ].join(",")
+
+    assert_equal <<~TEXT, response.body
+      Book: Handbook
+      Leaves: 4
+      Started: February 01, 2025 09:05
+      Updated: 15 Mar 14:30
+      Covers: #{expected_ids}
+    TEXT
+  end
+
+  test "show handles book with no leaves in HTML and text formats" do
+    book = books(:manual)
+    book.update_columns(
+      created_at: Time.utc(2025, 1, 10, 8, 0, 0),
+      updated_at: Time.utc(2025, 1, 10, 8, 0, 0)
+    )
+
+    get book_report_path(book)
+    assert_response :success
+    assert_in_body "Last updated January 10, 2025"
+    assert_in_body "Manual — 0 characters"
+
+    get book_report_path(book, format: :text)
+    assert_response :success
+    assert_in_body "Leaves: 0"
+    assert_in_body "Covers: null"
+  end
+end
