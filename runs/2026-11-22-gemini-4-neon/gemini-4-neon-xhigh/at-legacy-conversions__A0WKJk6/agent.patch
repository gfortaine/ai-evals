+end
diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..fc71cd1
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  test "perform archives book content with default formatted last_edited_at timestamp" do
+    book = books(:handbook)
+    edited_at = Time.utc(2025, 3, 15, 14, 30, 0)
+    book.leaves.update_all(updated_at: edited_at)
+    path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+
+    begin
+      ReportArchiveJob.perform_now(book)
+
+      assert File.exist?(path)
+      assert_equal "# archived 2025-03-15 14:30:00 UTC\n\n#{book.markable}", File.read(path)
+
+      Time.use_zone("America/New_York") do
+        ReportArchiveJob.perform_now(book)
+        assert_equal "# archived 2025-03-15 10:30:00 -0400\n\n#{book.markable}", File.read(path)
+      end
+    ensure
+      FileUtils.rm_f(path)
+      Dir.rmdir(path.dirname) rescue nil
+    end
+  end
+
+  test "perform handles books without active leaves" do
+    book = books(:manual)
+    path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+
+    begin
+      ReportArchiveJob.perform_now(book)
+
+      assert File.exist?(path)
+      assert_equal "# archived \n\n", File.read(path)
+    ensure
+      FileUtils.rm_f(path)
+      Dir.rmdir(path.dirname) rescue nil
+    end
+  end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
