index 0000000..9d27859
--- /dev/null
+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,16 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest formats published book dates in short format" do
+    books(:handbook).update_columns(published: true, updated_at: Time.utc(2025, 3, 15, 14, 30, 0))
+    books(:manual).update_columns(published: false, updated_at: Time.utc(2025, 4, 1, 10, 0, 0))
+
+    email = ReportDigestMailer.weekly(users(:david))
+
+    assert_equal [ "david@example.com" ], email.to
+    assert_equal "Your Writebook digest", email.subject
+    assert_includes email.body.decoded, "Hi David,"
+    assert_includes email.body.decoded, "* Handbook, last edited 15 Mar"
+    assert_not_includes email.body.decoded, "Manual"
+  end
+end
diff --git a/test/models/book/reportable_test.rb b/test/models/book/reportable_test.rb
new file mode 100644
index 0000000..e212f1a
--- /dev/null
+++ b/test/models/book/reportable_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report_summary formats character counts with delimiters" do
+    leaves(:welcome_page).leafable.update!(body: "x" * 1000)
+
+    summary = books(:handbook).report_summary
+    expected_length = books(:handbook).markable.length
+
+    assert_operator expected_length, :>=, 1000
+    assert_equal "Handbook — #{ActiveSupport::NumberHelper.number_to_delimited(expected_length)} characters", summary
+  end
+
+  test "report_summary handles empty books" do
+    assert_equal "Manual — 0 characters", books(:manual).report_summary
+  end
+
+  test "leaf_count counts active leaves" do
+    assert_equal 4, books(:handbook).leaf_count
+
+    leaves(:summary_page).trashed!
+    assert_equal 3, books(:handbook).leaf_count
+  end
+
+  test "last_edited_at returns latest active leaf timestamp or nil" do
+    earlier = Time.utc(2025, 4, 19, 10, 0, 0)
+    latest = Time.utc(2025, 4, 20, 18, 45, 0)
+
+    books(:handbook).leaves.update_all(updated_at: earlier)
+    leaves(:welcome_page).update_columns(updated_at: latest)
+
+    assert_equal latest, books(:handbook).last_edited_at
+    assert_nil books(:manual).last_edited_at
+  end
+end
