index 0000000..30d2f2f
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text renders formatted metadata and active positioned leaf ids" do
+    book = books(:handbook)
+    book.update_columns(
+      created_at: Time.utc(2025, 2, 1, 9, 5, 0),
+      updated_at: Time.utc(2025, 3, 15, 14, 30, 0)
+    )
+
+    expected_ids = [
+      leaves(:welcome_section).id,
+      leaves(:welcome_page).id,
+      leaves(:summary_page).id,
+      leaves(:reading_picture).id
+    ].join(",")
+
+    assert_equal <<~TEXT, Publishing::ReportCard.new(book).to_text
+      Book: Handbook
+      Leaves: 4
+      Started: February 01, 2025 09:05
+      Updated: 15 Mar 14:30
+      Covers: #{expected_ids}
+    TEXT
+  end
+
+  test "to_text excludes trashed leaves from count and covers" do
+    book = books(:handbook)
+    leaves(:summary_page).trashed!
+    book.update_columns(
+      created_at: Time.utc(2025, 2, 1, 9, 5, 0),
+      updated_at: Time.utc(2025, 3, 15, 14, 30, 0)
+    )
+
+    expected_ids = [
+      leaves(:welcome_section).id,
+      leaves(:welcome_page).id,
+      leaves(:reading_picture).id
+    ].join(",")
+
+    assert_equal <<~TEXT, Publishing::ReportCard.new(book).to_text
+      Book: Handbook
+      Leaves: 3
+      Started: February 01, 2025 09:05
+      Updated: 15 Mar 14:30
+      Covers: #{expected_ids}
+    TEXT
+  end
+
+  test "to_text renders null when no active leaves exist" do
+    book = books(:manual)
+    book.update_columns(
+      created_at: Time.utc(2025, 1, 5, 10, 0, 0),
+      updated_at: Time.utc(2025, 1, 6, 11, 15, 0)
+    )
+
+    assert_equal <<~TEXT, Publishing::ReportCard.new(book).to_text
+      Book: Manual
+      Leaves: 0
+      Started: January 05, 2025 10:00
+      Updated: 06 Jan 11:15
+      Covers: null
+    TEXT
+  end
+end
diff --git a/test/mailers/report_digest_mailer_test.rb b/test/mailers/report_digest_mailer_test.rb
