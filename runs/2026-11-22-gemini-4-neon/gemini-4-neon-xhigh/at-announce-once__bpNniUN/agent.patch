diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..1992af3
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,271 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "publishing a draft book announces once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+        book.update!(published: true)
+      end
+    end
+  end
+
+  test "publishing a book and adding a page in the same transaction announces once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+        book.transaction do
+          book.update!(published: true)
+          book.press Page.new(body: ""), title: "Chapter 1"
+        end
+      end
+    end
+
+    assert book.reload.published?
+    assert_equal 1, book.leaves.count
+  end
+
+  test "publishing a book with multiple updates, touches, reloads, and page changes in one transaction announces once" do
+    book = books(:handbook)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+        book.transaction do
+          book.update!(published: true)
+          book.press Page.new(body: ""), title: "New Chapter"
+          leaves(:welcome_page).update!(title: "Updated Welcome")
+          leaves(:summary_page).update!(status: :trashed)
+          book.update!(slug: "updated-handbook")
+          book.touch
+          book.reload
+        end
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "publishing a book when another instance of the same book is updated in the same transaction announces once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+        book.transaction do
+          book.update!(published: true)
+          Book.find(book.id).update!(title: "Manual Revised")
+        end
+      end
+    end
+  end
+
+  test "publishing a book when a separately loaded leaf touches it in the same transaction announces once" do
+    book = books(:handbook)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+        book.transaction do
+          book.update!(published: true)
+          Leaf.find(leaves(:welcome_page).id).update!(title: "Renamed Separately")
+        end
+      end
+    end
+  end
+
+  test "unpublishing a live book does not announce" do
+    book = books(:manual)
+    book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "saving an already-live book again does not announce" do
+    book = books(:manual)
+    book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(slug: "new-slug")
+      book.update!(published: true)
+      book.transaction do
+        book.update!(published: true, title: "Manual 2nd Edition")
+        book.press Page.new(body: ""), title: "Bonus Chapter"
+      end
+    end
+  end
+
+  test "saving a draft book without publishing does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(slug: "draft-slug")
+      book.transaction do
+        book.update!(published: false)
+        book.press Page.new(body: ""), title: "Draft Page"
+      end
+    end
+  end
+
+  test "publishing then unpublishing in the same transaction does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.update!(published: false)
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "publishing, unpublishing, and republishing in the same transaction announces once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.update!(published: false)
+        book.update!(published: true)
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "unpublishing then republishing an already-live book in the same transaction does not announce" do
+    book = books(:manual)
+    book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: false)
+        book.update!(published: true)
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "failing transaction after marking live leaves a draft and does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(ActiveRecord::RecordNotFound) do
+        book.transaction do
+          book.update!(published: true)
+          book.press Page.new(body: ""), title: "Rolled Back Page"
+          book.leaves.find(-1)
+        end
+      end
+    end
+
+    assert_not book.reload.published?
+    assert_equal 0, book.leaves.count
+  end
+
+  test "explicit rollback after marking live leaves a draft and does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "publishing then destroying in the same transaction does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.destroy!
+      end
+    end
+  end
+
+  test "creating a published book announces once and creating a draft does not" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create!(title: "Draft Book")
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create!(title: "Published Book", published: true)
+    end
+  end
+
+  test "creating a draft book and publishing it in the same transaction announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        book = Book.create!(title: "Created And Published")
+        book.update!(published: true)
+        book.press Page.new(body: ""), title: "Intro"
+      end
+    end
+  end
+
+  test "nested savepoint rollback after publishing does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.transaction(requires_new: true) do
+          book.update!(published: true)
+          raise ActiveRecord::Rollback
+        end
+        book.update!(slug: "still-a-draft")
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "nested savepoint rollback of unpublish preserves outer publication announcement" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.transaction(requires_new: true) do
+          book.update!(published: false)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "publishing multiple books in the same transaction announces each once" do
+    assert_enqueued_jobs 2, only: AnnouncePublicationJob do
+      Book.transaction do
+        books(:manual).update!(published: true)
+        books(:handbook).update!(published: true)
+        books(:handbook).press Page.new(body: ""), title: "Extra"
+      end
+    end
+  end
+
+  test "enqueued announcement job performs successfully" do
+    book = books(:handbook)
+
+    perform_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.press Page.new(body: ""), title: "Launch Note"
+      end
+    end
+
+    assert book.reload.published?
+  end
+end
