diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..92bf902
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,270 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "announces once when a draft book goes live" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+        @book.update!(published: true)
+      end
+    end
+  end
+
+  test "announces once when going live and adding a page in the same transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+        @book.transaction do
+          @book.update!(published: true)
+          assert_no_enqueued_jobs only: AnnouncePublicationJob
+          @book.press Page.new(body: "Hello"), title: "New Page"
+        end
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal "New Page", @book.leaves.positioned.last.title
+  end
+
+  test "announces once whatever else the sitting does after going live" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.press Page.new(body: "One"), title: "Added Page 1"
+        @book.press Page.new(body: "Two"), title: "Added Page 2"
+        leaves(:welcome_page).update!(title: "Renamed Welcome")
+        leaves(:summary_page).update!(status: :trashed)
+        leaves(:welcome_page).move_to_position(0)
+        @book.update!(slug: "updated-handbook")
+        @book.touch
+        @book.reload
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal "updated-handbook", @book.slug
+  end
+
+  test "announces once when adding a page before going live in the same transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.press Page.new(body: "Hello"), title: "Before Live"
+        @book.update!(published: true)
+      end
+    end
+  end
+
+  test "does not announce when taking a live book back down" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(published: false)
+    end
+  end
+
+  test "does not announce again when an already-live book is saved again" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(published: true)
+      @book.update!(slug: "new-slug")
+      @book.update!(title: "Updated Handbook")
+      @book.touch
+      @book.transaction do
+        @book.update!(published: true, slug: "another-slug")
+        @book.press Page.new(body: "Extra"), title: "Extra Page"
+      end
+    end
+  end
+
+  test "does not announce when a draft book is saved without going live" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(slug: "still-draft")
+      @book.update!(published: false)
+      @book.transaction do
+        @book.update!(published: false)
+        @book.press Page.new(body: "Draft"), title: "Draft Page"
+      end
+    end
+  end
+
+  test "does not announce when going live and back down in the same transaction" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "announces once when toggling live, down, and live again in the same transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "does not announce when an already-live book goes down and back live in the same transaction" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "tracks transitions across separate instances of the same book in one transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        Book.find(@book.id).update!(slug: "second-instance-slug")
+      end
+    end
+
+    @book.reload.update!(published: false)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        Book.find(@book.id).update!(published: false)
+      end
+    end
+
+    @book.reload.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: false)
+        Book.find(@book.id).update!(published: true)
+      end
+    end
+  end
+
+  test "leaves a draft and announces nothing when a transaction fails after going live" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(RuntimeError) do
+        @book.transaction do
+          @book.update!(published: true)
+          @book.press Page.new(body: "Rolled back"), title: "Rolled Back Page"
+          raise "something failed"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+    assert_not @book.leaves.exists?(title: "Rolled Back Page")
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(slug: "still-a-draft")
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update!(published: true)
+    end
+  end
+
+  test "handles nested savepoint rollbacks accurately" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.transaction(requires_new: true) do
+          @book.update!(published: true)
+          raise ActiveRecord::Rollback
+        end
+        @book.reload.update!(slug: "after-savepoint-rollback")
+      end
+    end
+    assert_not @book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.transaction(requires_new: true) do
+          @book.update!(published: false)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+    assert @book.reload.published?
+
+    @book.update!(published: false)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.transaction(requires_new: true) do
+          @book.update!(published: true)
+        end
+        raise ActiveRecord::Rollback
+      end
+    end
+    assert_not @book.reload.published?
+  end
+
+  test "announces when created live and handles create-plus-update in one transaction" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create!(title: "Draft Book")
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create!(title: "Born Live", published: true)
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        book = Book.create!(title: "Created Then Published")
+        book.update!(published: true)
+        book.press Page.new(body: "Intro"), title: "Intro"
+      end
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        book = Book.create!(title: "Born Live Then Draft", published: true)
+        book.update!(published: false)
+      end
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.create!(title: "Born Live Rolled Back", published: true)
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "does not announce when taken live and destroyed in the same transaction" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.destroy!
+      end
+    end
+  end
+
+  test "announces each book once when multiple books go live in the same transaction" do
+    manual = books(:manual)
+
+    assert_enqueued_jobs 2, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update!(published: true)
+        manual.update!(published: true)
+        @book.press Page.new(body: ""), title: "Handbook Page"
+        manual.press Page.new(body: ""), title: "Manual Page"
+      end
+    end
+  end
+end
