diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..69e1ca4 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,64 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy deletes the book and archives its access list" do
+    book = books(:handbook)
+
+    assert_empty AccessArchive.where(book_id: book.id)
+
+    delete book_path(book)
+
+    assert_redirected_to root_url
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 4, archives.count
+
+    expected = [
+      [ users(:david).id, users(:david).name, "editor" ],
+      [ users(:jason).id, users(:jason).name, "editor" ],
+      [ users(:jz).id, users(:jz).name, "reader" ],
+      [ users(:kevin).id, users(:kevin).name, "editor" ]
+    ]
+    assert_equal expected.sort, archives.pluck(:user_id, :user_name, :level).sort
+    assert archives.all? { |archive| archive.book_title == "Handbook" }
+  end
+
+  test "destroy records updated access levels and excludes revoked users" do
+    sign_in :david
+    book = books(:manual)
+
+    patch book_path(book), params: {
+      book: { title: book.title, everyone_access: false },
+      editor_ids: [ users(:david).id ],
+      reader_ids: [ users(:jason).id ]
+    }
+
+    assert_empty AccessArchive.where(book_id: book.id)
+
+    delete book_path(book)
+
+    assert_redirected_to root_url
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+
+    archives = AccessArchive.where(book_id: book.id)
+    expected = [
+      [ users(:david).id, users(:david).name, "editor" ],
+      [ users(:jason).id, users(:jason).name, "reader" ]
+    ]
+    assert_equal expected.sort, archives.pluck(:user_id, :user_name, :level).sort
+  end
+
+  test "destroy is forbidden for readers and writes no archive rows" do
+    sign_in :jz
+
+    assert_no_difference [ -> { Book.count }, -> { Access.count }, -> { AccessArchive.count } ] do
+      delete book_path(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..4eefbac 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,80 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives each user's access and removes the book and its accesses" do
+    book = books(:handbook)
+
+    assert_empty AccessArchive.where(book_id: book.id)
+
+    book.destroy
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 4, archives.count
+
+    expected = [
+      [ users(:david).id, users(:david).name, "editor" ],
+      [ users(:jason).id, users(:jason).name, "editor" ],
+      [ users(:jz).id, users(:jz).name, "reader" ],
+      [ users(:kevin).id, users(:kevin).name, "editor" ]
+    ]
+    assert_equal expected.sort, archives.pluck(:user_id, :user_name, :level).sort
+    assert archives.all? { |archive| archive.book_title == "Handbook" }
+  end
+
+  test "destroying a book reflects access changes and excludes revoked users" do
+    book = books(:manual)
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:david).id ], readers: [ users(:jason).id ])
+
+    assert_empty AccessArchive.where(book_id: book.id)
+
+    book.destroy
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+
+    archives = AccessArchive.where(book_id: book.id)
+    expected = [
+      [ users(:david).id, users(:david).name, "editor" ],
+      [ users(:jason).id, users(:jason).name, "reader" ]
+    ]
+    assert_equal expected.sort, archives.pluck(:user_id, :user_name, :level).sort
+  end
+
+  test "destroying a book with stale cached accesses archives current accesses" do
+    book = books(:manual)
+    book.accesses.load
+
+    Access.find_by!(book: book, user: users(:jz)).destroy!
+    Access.create!(book: book, user: users(:kevin), level: :reader)
+
+    assert_empty AccessArchive.where(book_id: book.id)
+
+    book.destroy!
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+
+    archives = AccessArchive.where(book_id: book.id)
+    expected = [
+      [ users(:david).id, users(:david).name, "editor" ],
+      [ users(:jason).id, users(:jason).name, "editor" ],
+      [ users(:kevin).id, users(:kevin).name, "reader" ]
+    ]
+    assert_equal expected.sort, archives.pluck(:user_id, :user_name, :level).sort
+  end
+
+  test "destroying a book with no accesses writes no archive rows" do
+    book = Book.create!(title: "Unshared", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+
+    assert_not Book.exists?(book.id)
+  end
 end
