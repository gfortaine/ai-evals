diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..9176bb2
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    @book = books(:handbook)
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "edit renders the release form for an editor" do
+    get edit_book_release_path(@book)
+
+    assert_response :success
+    assert_in_body "Release this book"
+  end
+
+  test "edit is forbidden for non-editors" do
+    sign_in :jz
+
+    get edit_book_release_path(@book)
+
+    assert_response :forbidden
+  end
+
+  test "releasing a book shows the new title and published status in Recently updated" do
+    patch book_release_path(@book), params: { book: { title: "Published Handbook", subtitle: "Final Edition" } }
+
+    assert_redirected_to root_path
+    follow_redirect!
+    assert_response :success
+
+    assert_select ".library__recents" do
+      assert_select "h2", text: "Recently updated"
+      assert_select "strong", text: "Published Handbook"
+      assert_select "strong", text: "Handbook", count: 0
+      assert_select "span", text: "Published"
+    end
+
+    get book_slug_path(@book.reload)
+    assert_response :success
+    assert_in_body "Published Handbook"
+  end
+
+  test "releasing one book preserves another book's recap in Recently updated" do
+    books(:manual).update!(title: "Updated Manual")
+
+    patch book_release_path(@book), params: { book: { title: "Published Handbook", subtitle: "" } }
+    assert_redirected_to root_path
+    follow_redirect!
+
+    assert_select ".library__recents strong", text: "Published Handbook"
+    assert_select ".library__recents strong", text: "Updated Manual"
+  end
+
+  test "recap disappears from Recently updated after expiration" do
+    patch book_release_path(@book), params: { book: { title: "Published Handbook", subtitle: "" } }
+    assert_redirected_to root_path
+
+    travel Rails.application.config.x.recap.expires_in + 1.second do
+      get root_path
+      assert_response :success
+      assert_select ".library__recents", count: 0
+    end
+  end
+
+  test "ordinary rename still updates Recently updated" do
+    patch book_path(@book), params: { book: { title: "Renamed Handbook" } }
+    assert_redirected_to book_slug_path(@book.reload)
+
+    get root_path
+    assert_response :success
+    assert_select ".library__recents" do
+      assert_select "strong", text: "Renamed Handbook"
+      assert_select "span", text: "Draft"
+    end
+  end
+
+  test "releasing an already published book redirects back to the book without changing it" do
+    @book.update!(published: true)
+
+    patch book_release_path(@book), params: { book: { title: "Ignored Title" } }
+
+    assert_redirected_to book_slug_path(@book)
+    assert_equal "Handbook", @book.reload.title
+  end
+
+  test "update is forbidden for non-editors" do
+    sign_in :jz
+
+    patch book_release_path(@book), params: { book: { title: "Unauthorized Release" } }
+
+    assert_response :forbidden
+    assert_equal "Handbook", @book.reload.title
+    assert_not @book.published?
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..2f8212d
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "updating a book writes its title and published status to its recap" do
+    book = books(:handbook)
+
+    book.update!(title: "Updated Handbook")
+
+    assert_equal({ title: "Updated Handbook", published: false }, book.cached_recap)
+  end
+
+  test "updating a book preserves saved_changes on the record" do
+    book = books(:handbook)
+
+    book.update!(title: "Updated Handbook")
+
+    assert book.saved_change_to_title?
+    assert_equal [ "Handbook", "Updated Handbook" ], book.saved_change_to_title
+  end
+
+  test "updating two instances of the same book in one transaction caches committed state" do
+    first = books(:handbook)
+    second = Book.find(first.id)
+
+    Book.transaction do
+      first.update!(title: "Final Handbook")
+      second.update!(published: true)
+    end
+
+    assert_equal({ title: "Final Handbook", published: true }, first.cached_recap)
+  end
+
+  test "updating published then title across two instances in one transaction caches committed state" do
+    first = books(:handbook)
+    second = Book.find(first.id)
+
+    Book.transaction do
+      first.update!(published: true)
+      second.update!(title: "Final Handbook")
+    end
+
+    assert_equal({ title: "Final Handbook", published: true }, first.cached_recap)
+  end
+
+  test "updating with ReleaseMarker and another book instance in one transaction caches committed state" do
+    book = books(:handbook)
+    marker = ReleaseMarker.for(book.id)
+
+    Book.transaction do
+      book.update!(title: "Released Handbook")
+      marker.publish!
+    end
+
+    assert_equal({ title: "Released Handbook", published: true }, book.cached_recap)
+  end
+
+  test "recaps are stored per book without overwriting each other" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "Handbook Second Edition")
+    manual.update!(title: "Manual Revised", published: true)
+
+    assert_equal({ title: "Handbook Second Edition", published: false }, handbook.cached_recap)
+    assert_equal({ title: "Manual Revised", published: true }, manual.cached_recap)
+  end
+
+  test "recaps expire according to the configured schedule" do
+    book = books(:handbook)
+    expires_in = Rails.application.config.x.recap.expires_in
+
+    book.update!(title: "Expiring Handbook")
+
+    travel expires_in - 1.minute do
+      assert_equal({ title: "Expiring Handbook", published: false }, book.cached_recap)
+    end
+
+    travel expires_in + 1.second do
+      assert_nil book.cached_recap
+    end
+  end
+
+  test "rolled back updates do not write a recap" do
+    book = books(:handbook)
+
+    Book.transaction do
+      book.update!(title: "Rolled Back Title")
+      raise ActiveRecord::Rollback
+    end
+
+    assert_nil book.cached_recap
+  end
+
+  test "rolled back nested savepoint does not leak into recap" do
+    book = books(:handbook)
+
+    Book.transaction do
+      book.update!(title: "Committed Title")
+
+      Book.transaction(requires_new: true) do
+        Book.find(book.id).update!(published: true)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_equal({ title: "Committed Title", published: false }, book.cached_recap)
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..12b6120
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "finalize_release updates title, subtitle, publishes the book, and caches the released recap" do
+    book = books(:handbook)
+
+    assert Book.finalize_release(book.id, title: "Published Handbook", subtitle: "First Edition")
+
+    book.reload
+    assert_equal "Published Handbook", book.title
+    assert_equal "First Edition", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Published Handbook", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release with unchanged title still publishes and caches the recap" do
+    book = books(:handbook)
+
+    assert Book.finalize_release(book.id, title: book.title)
+
+    assert book.reload.published?
+    assert_equal({ title: "Handbook", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release replaces an earlier draft recap with the released title and published status" do
+    book = books(:handbook)
+    book.update!(title: "Working Draft Title")
+    assert_equal({ title: "Working Draft Title", published: false }, book.cached_recap)
+
+    assert Book.finalize_release(book.id, title: "Official Title")
+
+    assert_equal({ title: "Official Title", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release preserves existing subtitle when subtitle is nil" do
+    book = books(:handbook)
+    book.update!(subtitle: "Original Subtitle")
+
+    assert Book.finalize_release(book.id, title: "Official Title", subtitle: nil)
+
+    book.reload
+    assert_equal "Official Title", book.title
+    assert_equal "Original Subtitle", book.subtitle
+    assert book.published?
+  end
+
+  test "finalize_release returns false and makes no changes when book is already published" do
+    book = books(:handbook)
+    book.update!(published: true)
+    assert_equal({ title: "Handbook", published: true }, book.cached_recap)
+
+    assert_not Book.finalize_release(book.id, title: "Ignored Title", subtitle: "Ignored")
+
+    book.reload
+    assert_equal "Handbook", book.title
+    assert_nil book.subtitle
+    assert_equal({ title: "Handbook", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release raises RecordNotFound for unknown id" do
+    assert_raises ActiveRecord::RecordNotFound do
+      Book.finalize_release(-1, title: "Missing")
+    end
+  end
+
+  test "finalize_release rolls back and does not update recap if save fails" do
+    book = books(:handbook)
+
+    assert_raises ActiveRecord::NotNullViolation do
+      Book.finalize_release(book.id, title: nil)
+    end
+
+    book.reload
+    assert_equal "Handbook", book.title
+    assert_not book.published?
+    assert_nil book.cached_recap
+  end
+end
