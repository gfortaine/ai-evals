diff --git a/test/models/webhook_test.rb b/test/models/webhook_test.rb
new file mode 100644
index 0000000..9721e6b
--- /dev/null
+++ b/test/models/webhook_test.rb
@@ -0,0 +1,379 @@
+require "test_helper"
+
+class WebhookTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper, Turbo::Broadcastable::TestHelper
+
+  setup do
+    @bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook?secret=abc")
+    @room = rooms(:hq)
+  end
+
+  test "validates HTTP and HTTPS URLs including localhost and IPv6" do
+    [
+      "https://bot.example.com/hook",
+      "http://bot.example.com:8080/events?token=123",
+      "http://localhost:4567/webhook",
+      "http://127.0.0.1:9999/cb",
+      "http://[::1]:8080/hook",
+      "  https://bot.example.com/trimmed  "
+    ].each do |url|
+      webhook = Webhook.new(user: @bot, url: url)
+      assert webhook.valid?, "Expected #{url.inspect} to be valid: #{webhook.errors.full_messages}"
+    end
+
+    [
+      "",
+      "   ",
+      "not-a-url",
+      "ftp://example.com/hook",
+      "javascript:alert(1)",
+      "file:///etc/passwd",
+      "http://",
+      "https:///path",
+      "http://exa mple.com/hook"
+    ].each do |url|
+      webhook = Webhook.new(user: @bot, url: url)
+      assert_not webhook.valid?, "Expected #{url.inspect} to be invalid"
+    end
+  end
+
+  test "payload matches exact contract with stripped mention text and full rich-text HTML" do
+    body_html = "<div>#{mention_attachment_for(@bot)}&nbsp;<strong>restart</strong> the build please</div>"
+    message = @room.messages.create!(creator: users(:kevin), body: body_html)
+
+    payload = @bot.webhook.payload_for(message)
+
+    assert_equal "mention", payload[:event]
+    assert_equal({ id: users(:kevin).id, name: users(:kevin).name }, payload[:author])
+    assert_equal(
+      {
+        id: @room.id,
+        name: @room.name,
+        reply_to: "/rooms/#{@room.id}/#{@bot.bot_key}/messages"
+      },
+      payload[:room]
+    )
+    assert_equal message.id, payload[:message][:id]
+    assert_equal "restart the build please", payload[:message][:body][:text]
+    assert_equal message.body.body.to_html, payload[:message][:body][:html]
+    assert_includes payload[:message][:body][:html], "<strong>restart</strong>"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload[:message][:link]
+  end
+
+  test "plain_text_without_mention strips only the target bot mention cleanly" do
+    other_bot = User.create_bot!(name: "CI Bot", creator: users(:kevin))
+
+    cases = [
+      [ "<div>#{mention_attachment_for(@bot)} restart the build please</div>", "restart the build please" ],
+      [ "<div>#{mention_attachment_for(@bot)}&nbsp;restart the build please</div>", "restart the build please" ],
+      [ "<div>Hey #{mention_attachment_for(@bot)}&nbsp;restart the build</div>", "Hey restart the build" ],
+      [ "<div>Hey&nbsp;#{mention_attachment_for(@bot)}&nbsp;restart the build</div>", "Hey restart the build" ],
+      [ "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(other_bot)} status</div>", "@CI Bot status" ],
+      [ "<div>#{mention_attachment_for(other_bot)} #{mention_attachment_for(@bot)} status</div>", "@CI Bot status" ],
+      [ "<div>restart #{mention_attachment_for(@bot)} now #{mention_attachment_for(@bot)}</div>", "restart now" ],
+      [ "<div>#{mention_attachment_for(@bot)}</div>", "" ],
+      [ "<div>#{mention_attachment_for(@bot)} line 1<br>line 2</div>", "line 1\nline 2" ],
+      [ "<div>#{mention_attachment_for(@bot)} echo @Deploy Bot</div>", "echo @Deploy Bot" ]
+    ]
+
+    cases.each do |html, expected|
+      message = @room.messages.create!(creator: users(:kevin), body: html)
+      assert_equal expected, message.plain_text_without_mention(@bot), "Failed for HTML: #{html}"
+    end
+  end
+
+  test "mentioning a bot with a webhook enqueues Webhook::DeliveryJob without blocking" do
+    assert_enqueued_jobs 1, only: [ Webhook::DeliveryJob ] do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} deploy</div>")
+    end
+
+    assert_not_requested :post, "https://bot.example.com/hook?secret=abc"
+  end
+
+  test "mentioning a bot without a webhook or a human enqueues no webhook jobs" do
+    quiet_bot = User.create_bot!(name: "Quiet Bot", creator: users(:kevin))
+
+    assert_no_enqueued_jobs only: [ Webhook::DeliveryJob ] do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(quiet_bot)} hi</div>")
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(:david)} hi</div>")
+      @room.messages.create!(creator: users(:kevin), body: "<div>Just a normal message</div>")
+    end
+  end
+
+  test "mentioning the same bot twice enqueues only one webhook job" do
+    assert_enqueued_jobs 1, only: [ Webhook::DeliveryJob ] do
+      @room.messages.create!(
+        creator: users(:kevin),
+        body: "<div>#{mention_attachment_for(@bot)} hey #{mention_attachment_for(@bot)}</div>"
+      )
+    end
+  end
+
+  test "mentioning two bots with webhooks delivers independently to each with bot-specific payload" do
+    other_bot = User.create_bot!(name: "CI Bot", creator: users(:kevin), webhook_url: "https://ci.example.com/hook")
+
+    received = {}
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return do |request|
+      received[:deploy] = JSON.parse(request.body)
+      { status: 204 }
+    end
+    WebMock.stub_request(:post, "https://ci.example.com/hook").to_return do |request|
+      received[:ci] = JSON.parse(request.body)
+      { status: 204 }
+    end
+
+    assert_enqueued_jobs 2, only: [ Webhook::DeliveryJob ] do
+      @room.messages.create!(
+        creator: users(:kevin),
+        body: "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(other_bot)} status</div>"
+      )
+    end
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_equal "@CI Bot status", received[:deploy]["message"]["body"]["text"]
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_key}/messages", received[:deploy]["room"]["reply_to"]
+
+    assert_equal "@Deploy Bot status", received[:ci]["message"]["body"]["text"]
+    assert_equal "/rooms/#{@room.id}/#{other_bot.bot_key}/messages", received[:ci]["room"]["reply_to"]
+  end
+
+  test "mentioning a bot in a closed room it does not belong to triggers no webhook, but works after adding" do
+    closed_room = rooms(:watercooler)
+
+    assert_no_enqueued_jobs only: [ Webhook::DeliveryJob ] do
+      closed_room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} secret</div>")
+    end
+
+    closed_room.memberships.grant_to(@bot)
+
+    assert_enqueued_jobs 1, only: [ Webhook::DeliveryJob ] do
+      closed_room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} deploy</div>")
+    end
+  end
+
+  test "mentioning a bot in a direct room triggers its webhook" do
+    direct_room = Rooms::Direct.create_for({ creator: users(:kevin) }, users: User.where(id: [ users(:kevin).id, @bot.id ]))
+
+    received_payload = nil
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return do |request|
+      received_payload = JSON.parse(request.body)
+      { status: 200, body: "Pong!", headers: { "Content-Type" => "text/plain" } }
+    end
+
+    message = nil
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      message = direct_room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+    end
+
+    assert_equal "mention", received_payload["event"]
+    assert_equal direct_room.id, received_payload["room"]["id"]
+    assert_nil received_payload["room"]["name"]
+    assert_equal "/rooms/#{direct_room.id}/#{@bot.bot_key}/messages", received_payload["room"]["reply_to"]
+    assert_equal "/rooms/#{direct_room.id}/@#{message.id}", received_payload["message"]["link"]
+    assert_equal "ping", received_payload["message"]["body"]["text"]
+
+    reply = direct_room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Pong!", reply.plain_text_body
+  end
+
+  test "bot messages mentioning bots never trigger webhooks" do
+    other_bot = User.create_bot!(name: "CI Bot", creator: users(:kevin), webhook_url: "https://ci.example.com/hook")
+
+    assert_no_enqueued_jobs only: [ Webhook::DeliveryJob ] do
+      @room.messages.create!(creator: @bot, body: "<div>#{mention_attachment_for(@bot)} loop</div>")
+      @room.messages.create!(creator: @bot, body: "<div>#{mention_attachment_for(other_bot)} ping pong</div>")
+    end
+  end
+
+  test "200 text/plain response posts escaped reply as bot, broadcasts, and enqueues push notifications" do
+    received_headers = nil
+    received_payload = nil
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return do |request|
+      received_headers = request.headers
+      received_payload = JSON.parse(request.body)
+      {
+        status: 200,
+        body: "Build #42 restarted 🚀\nCheck <b>logs</b> & 1 < 2",
+        headers: { "Content-Type" => "text/plain; charset=utf-8" }
+      }
+    end
+
+    message = @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} restart the build please</div>")
+
+    assert_difference -> { @room.messages.count }, +1 do
+      assert_turbo_stream_broadcasts([ @room, :messages ], count: 1) do
+        assert_broadcasts(UnreadRoomsChannel.stream_name_for(users(:kevin).id), 1) do
+          assert_enqueued_jobs 1, only: [ Room::PushMessageJob ] do
+            perform_enqueued_jobs only: Webhook::DeliveryJob
+          end
+        end
+      end
+    end
+
+    assert_equal "application/json", received_headers["Content-Type"]
+    assert_equal "restart the build please", received_payload["message"]["body"]["text"]
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build #42 restarted 🚀\nCheck <b>logs</b> & 1 < 2", reply.plain_text_body
+    rendered = ApplicationController.helpers.message_presentation(reply).to_s
+    assert_includes rendered, "Build #42 restarted 🚀<br>Check &lt;b&gt;logs&lt;/b&gt; &amp; 1 &lt; 2"
+  end
+
+  test "200 text/plain without charset and with non-UTF-8 charset decodes properly" do
+    # UTF-8 without explicit charset parameter
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc")
+      .to_return(status: 200, body: "Deployed ✅".b, headers: { "Content-Type" => "TEXT/PLAIN" })
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} status</div>")
+    end
+    assert_equal "Deployed ✅", @room.messages.order(:id).last.plain_text_body
+
+    # ISO-8859-1 charset
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc")
+      .to_return(status: 200, body: "Caf\xE9 ready".b, headers: { "Content-Type" => "text/plain; charset=ISO-8859-1" })
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} coffee</div>")
+    end
+    assert_equal "Café ready", @room.messages.order(:id).last.plain_text_body
+  end
+
+  test "200 text/html response posts rich HTML reply as bot and sanitizes unsafe tags on render" do
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc")
+      .to_return(
+        status: 200,
+        body: "<div>Build <strong>#42</strong> restarted! <a href=\"https://ci.example.com/42\">Logs</a><script>alert(1)</script></div>",
+        headers: { "Content-Type" => "text/html; charset=utf-8" }
+      )
+
+    assert_difference -> { @room.messages.count }, +2 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} restart</div>")
+      end
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    rendered = ApplicationController.helpers.message_presentation(reply).to_s
+    assert_includes rendered, "<strong>#42</strong>"
+    assert_includes rendered, "https://ci.example.com/42"
+    assert_not_includes rendered, "<script>"
+  end
+
+  test "204 response posts no message" do
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc")
+      .to_return(status: 204, body: "")
+
+    assert_difference -> { @room.messages.count }, +1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ack</div>")
+      end
+    end
+
+    assert_requested :post, "https://bot.example.com/hook?secret=abc", times: 1
+  end
+
+  test "blank body, unsupported content type, redirects, error statuses, and oversized body post no message" do
+    responses = [
+      { status: 200, body: "   \n  ", headers: { "Content-Type" => "text/plain" } },
+      { status: 200, body: "", headers: { "Content-Type" => "text/html" } },
+      { status: 200, body: '{"ok":true}', headers: { "Content-Type" => "application/json" } },
+      { status: 200, body: "no content type", headers: {} },
+      { status: 200, body: "x" * (Webhook::MAX_RESPONSE_BODY_SIZE + 1), headers: { "Content-Type" => "text/plain" } },
+      { status: 302, body: "", headers: { "Location" => "https://other.example.com/steal" } },
+      { status: 400, body: "Bad Request", headers: { "Content-Type" => "text/plain" } },
+      { status: 500, body: "Internal Error", headers: { "Content-Type" => "text/plain" } }
+    ]
+
+    responses.each do |stub_response|
+      WebMock.reset!
+      WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(stub_response)
+
+      assert_difference -> { @room.messages.count }, +1, "Should not post reply for #{stub_response[:status]} #{stub_response[:headers]}" do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+        end
+      end
+    end
+
+    assert_not_requested :post, "https://other.example.com/steal"
+  end
+
+  test "network errors and timeouts are handled gracefully without raising or posting" do
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_timeout
+
+    assert_difference -> { @room.messages.count }, +1 do
+      assert_nothing_raised do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+        end
+      end
+    end
+
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_raise(Errno::ECONNREFUSED)
+
+    assert_difference -> { @room.messages.count }, +1 do
+      assert_nothing_raised do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+        end
+      end
+    end
+  end
+
+  test "removing webhook or deleting bot or message before job runs safely skips delivery" do
+    # Removing webhook discards job via DeserializationError
+    @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+    @bot.update!(webhook_url: "")
+    assert_nothing_raised { perform_enqueued_jobs only: Webhook::DeliveryJob }
+    assert_not_requested :post, "https://bot.example.com/hook?secret=abc"
+
+    # Re-add webhook and test deleting message before delivery
+    @bot.update!(webhook_url: "https://bot.example.com/hook?secret=abc")
+    message = @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ephemeral</div>")
+    message.destroy!
+    assert_nothing_raised { perform_enqueued_jobs only: Webhook::DeliveryJob }
+    assert_not_requested :post, "https://bot.example.com/hook?secret=abc"
+
+    # Removing bot from closed room before delivery skips HTTP call
+    closed_room = rooms(:watercooler)
+    closed_room.memberships.grant_to(@bot)
+    closed_room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} removed</div>")
+    closed_room.memberships.revoke_from(@bot)
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    assert_not_requested :post, "https://bot.example.com/hook?secret=abc"
+  end
+
+  test "deactivating bot during in-flight webhook prevents posting reply" do
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return do
+      @bot.deactivate
+      { status: 200, body: "Too late!", headers: { "Content-Type" => "text/plain" } }
+    end
+
+    assert_difference -> { @room.messages.count }, +1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} race</div>")
+      end
+    end
+  end
+
+  test "supports basic auth credentials in webhook URL" do
+    @bot.update!(webhook_url: "https://botuser:s3cr%40t@bot.example.com/hook")
+
+    received_auth = nil
+    WebMock.stub_request(:post, "https://bot.example.com/hook").to_return do |request|
+      received_auth = request.headers["Authorization"]
+      { status: 204 }
+    end
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} auth test</div>")
+    end
+
+    assert_equal "Basic #{Base64.strict_encode64('botuser:s3cr@t')}", received_auth
+  end
+end
