+test "end-to-end mixed API and webhook reply flooding suspends bot and admin reactivation restores it" do
+  WebMock.allow_net_connect!(allow_localhost: true)
+
+  received_requests = Queue.new
+  server = TCPServer.new("127.0.0.1", 0)
+  port = server.addr[1]
+  server_thread = Thread.new do
+    loop do
+      client = server.accept
+      begin
+        request_line = client.gets
+        next unless request_line
+
+        headers = {}
+        while (line = client.gets) && line != "\r\n"
+          k, v = line.split(":", 2)
+          headers[k.downcase] = v.strip
+        end
+        body = client.read(headers["content-length"].to_i)
+        received_requests << JSON.parse(body)
+
+        reply = "Webhook reply!"
+        client.write "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: #{reply.bytesize}\r\nConnection: close\r\n\r\n#{reply}"
+      ensure
+        client.close
+      end
+    end
+  rescue IOError, Errno::EBADF
+    # Server closed during teardown
+  end
+
+  webhook_url = "http://127.0.0.1:#{port}/hook"
+  bot = User.create_bot!(name: "Chatty Bot", creator: users(:kevin), webhook_url: webhook_url)
+  @room.memberships.grant_to(bot)
+  clear_enqueued_jobs
+
+  freeze_time do
+    # 6 API posts + 4 webhook replies = 10 messages within 10 seconds
+    6.times do |i|
+      post room_bot_messages_url(@room, bot.bot_key), params: +"API #{i}"
+      assert_response :created
+    end
+
+    4.times do |i|
+      assert_difference -> { @room.messages.where(creator: bot).count }, +1 do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} hi #{i}</div>")
+        end
+      end
+    end
+    assert_equal 4, received_requests.size
+    received_requests.clear
+
+    # 11th message via webhook reply goes over limit: dropped and starts 30-second cooldown
+    assert_no_difference -> { @room.messages.where(creator: bot).count } do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} trigger cooldown</div>")
+      end
+    end
+    assert_equal 1, received_requests.size
+    received_requests.clear
+
+    # During cooldown: 2 webhook replies dropped + 2 API calls rejected with 429 & Retry-After
+    travel 4.seconds
+    2.times do
+      assert_no_difference -> { @room.messages.where(creator: bot).count } do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} during cooldown</div>")
+        end
+      end
+    end
+    assert_equal 2, received_requests.size
+    received_requests.clear
+
+    2.times do
+      post room_bot_messages_url(@room, bot.bot_key), params: +"api during cooldown"
+      assert_response :too_many_requests
+      assert_equal "26", response.headers["Retry-After"]
+    end
+    assert_not bot.reload.suspended?
+
+    # 5th attempt during the same cooldown suspends the bot
+    post room_bot_messages_url(@room, bot.bot_key), params: +"fifth strike"
+    assert_response :forbidden
+    assert bot.reload.suspended?
+    assert_equal "flooding", bot.suspension_reason
+
+    # While suspended: API gets 403, mentions send NO webhooks, rooms and messages preserved
+    post room_bot_messages_url(@room, bot.bot_key), params: +"blocked"
+    assert_response :forbidden
+
+    assert_no_enqueued_jobs only: [ Webhook::DeliveryJob ] do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} ignored</div>")
+    end
+    assert_predicate received_requests, :empty?
+    assert_includes @room.reload.users, bot
+    assert_equal 10, @room.messages.where(creator: bot).count
+
+    # Member sees Suspended + reason on /bots, no Reactivate button, cannot POST reactivation
+    sign_in :kevin
+    get bots_url
+    assert_select "li#user_#{bot.id}" do
+      assert_select "strong", text: "Suspended"
+      assert_select "*", text: /Flooding/
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+    post bot_reactivation_url(bot)
+    assert_response :forbidden
+
+    # Admin sees Reactivate button with confirmation and reactivates the bot
+    sign_in :david
+    get bots_url
+    assert_select "li#user_#{bot.id} form[action='#{bot_reactivation_path(bot)}'] button[data-turbo-confirm]", text: "Reactivate"
+    post bot_reactivation_url(bot)
+    assert_redirected_to bots_url
+
+    get bots_url
+    assert_select "li#user_#{bot.id} strong", text: "Suspended", count: 0
+
+    # Reactivated bot immediately posts via API and replies via webhook again
+    post room_bot_messages_url(@room, bot.bot_key), params: +"Back online!"
+    assert_response :created
+
+    assert_difference -> { @room.messages.where(creator: bot).count }, +1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} welcome back</div>")
+      end
+    end
+    assert_equal 1, received_requests.size
+  end
+ensure
+  server&.close
+  server_thread&.join(1)
+  WebMock.disable_net_connect!
+end
+
+test "end-to-end 10 consecutive failing webhooks over real TCP server suspend bot and admin reactivation restores it" do
+  WebMock.allow_net_connect!(allow_localhost: true)
+
+  response_mode = :fail_500
+  request_count = 0
+  server = TCPServer.new("127.0.0.1", 0)
+  port = server.addr[1]
+  server_thread = Thread.new do
+    loop do
+      client = server.accept
+      begin
+        request_line = client.gets
+        next unless request_line
+
+        headers = {}
+        while (line = client.gets) && line != "\r\n"
+          k, v = line.split(":", 2)
+          headers[k.downcase] = v.strip
+        end
+        client.read(headers["content-length"].to_i)
+        request_count += 1
+
+        case response_mode
+        when :fail_500
+          client.write "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 5\r\nConnection: close\r\n\r\nerror"
+        when :drop_connection
+          # Close immediately without writing a response (EOFError)
+        when :ok_204
+          client.write "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n"
+        end
+      ensure
+        client.close
+      end
+    end
+  rescue IOError, Errno::EBADF
+    # Server closed during teardown
+  end
+
+  webhook_url = "http://127.0.0.1:#{port}/hook"
+  bot = User.create_bot!(name: "Flaky Bot", creator: users(:kevin), webhook_url: webhook_url)
+  @room.memberships.grant_to(bot)
+  clear_enqueued_jobs
+
+  # 9 failures (500s + dropped connections), then 1 success resets count
+  5.times do
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} fail</div>")
+    end
+  end
+  response_mode = :drop_connection
+  4.times do
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} drop</div>")
+    end
+  end
+  assert_not bot.reload.suspended?
+  assert_equal 9, bot.webhook.reload.consecutive_failures
+
+  response_mode = :ok_204
+  perform_enqueued_jobs only: Webhook::DeliveryJob do
+    @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} ok</div>")
+  end
+  assert_equal 0, bot.webhook.reload.consecutive_failures
+
+  # Now 10 consecutive failures suspend the bot
+  response_mode = :fail_500
+  10.times do
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} fail again</div>")
+    end
+  end
+  assert bot.reload.suspended?
+  assert_equal "failing_webhooks", bot.suspension_reason
+  assert_equal 20, request_count
+
+  # Suspended bot receives no further webhooks and gets 403 from posting endpoint
+  perform_enqueued_jobs only: Webhook::DeliveryJob do
+    @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} silenced</div>")
+  end
+  assert_equal 20, request_count
+
+  post room_bot_messages_url(@room, bot.bot_key), params: +"blocked"
+  assert_response :forbidden
+
+  # Admin sees Suspended with reason on /bots and reactivates
+  sign_in :david
+  get bots_url
+  assert_select "li#user_#{bot.id}" do
+    assert_select "strong", text: "Suspended"
+    assert_select "*", text: /Failing webhooks/
+    assert_select "button[data-turbo-confirm]", text: "Reactivate"
+  end
+
+  post bot_reactivation_url(bot)
+  assert_redirected_to bots_url
+  assert_not bot.reload.suspended?
+  assert_equal 0, bot.webhook.reload.consecutive_failures
+
+  # Webhook delivers again after reactivation
+  response_mode = :ok_204
+  perform_enqueued_jobs only: Webhook::DeliveryJob do
+    @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} restored</div>")
+  end
+  assert_equal 21, request_count
+ensure
+  server&.close
+  server_thread&.join(1)
+  WebMock.disable_net_connect!
+end
+end
