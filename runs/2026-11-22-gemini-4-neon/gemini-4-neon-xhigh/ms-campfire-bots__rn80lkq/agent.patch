diff --git a/test/controllers/bots/reactivations_controller_test.rb b/test/controllers/bots/reactivations_controller_test.rb
new file mode 100644
index 0000000..c9ea630
--- /dev/null
+++ b/test/controllers/bots/reactivations_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = User.create_bot!(name: "Flood Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+    @bot.suspend!(reason: "flooding")
+  end
+
+  test "unauthenticated user is redirected to sign in" do
+    post bot_reactivation_url(@bot)
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+
+  test "member including bot creator gets 403 Forbidden and cannot reactivate" do
+    sign_in :kevin
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    sign_in :jz
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrator can reactivate any suspended bot and resets state" do
+    @bot.webhook.update_columns(consecutive_failures: 10)
+
+    sign_in :david
+    post bot_reactivation_url(@bot)
+
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+    assert_nil @bot.bot_cooldown_until
+    assert_equal 0, @bot.bot_cooldown_attempts
+    assert_equal [], @bot.bot_recent_post_timestamps
+    assert_equal 0, @bot.webhook.reload.consecutive_failures
+  end
+
+  test "administrator reactivating non-bot, deactivated bot, or missing id raises RecordNotFound" do
+    sign_in :david
+
+    assert_raises ActiveRecord::RecordNotFound do
+      post bot_reactivation_url(users(:kevin))
+    end
+
+    @bot.deactivate
+    assert_raises ActiveRecord::RecordNotFound do
+      post bot_reactivation_url(@bot)
+    end
+
+    assert_raises ActiveRecord::RecordNotFound do
+      post bot_reactivation_url(999_999)
+    end
+  end
+
+  test "reactivating an already active bot is idempotent for administrator" do
+    @bot.reactivate
+
+    sign_in :david
+    post bot_reactivation_url(@bot)
+
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+  end
+end
