diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..4b47bd5
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,224 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  FLOOD_LIMIT = 10
+  FLOOD_WINDOW = 10.seconds
+  FLOOD_WINDOW_USEC = FLOOD_WINDOW.to_i * 1_000_000
+  COOLDOWN_DURATION = 30.seconds
+  COOLDOWN_STRIKE_LIMIT = 5
+
+  SUSPENSION_REASONS = {
+    "flooding" => "Flooding — repeated attempts to post during cooldown",
+    "failing_webhooks" => "Failing webhooks — 10 consecutive failed deliveries"
+  }.freeze
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :created_bots, -> { bot }, class_name: "User", foreign_key: :creator_id
+    has_one :webhook, dependent: :destroy
+
+    before_validation :initialize_bot, on: :create, if: :bot?
+    validate :validate_webhook_url, if: :bot?
+    validate :validate_bot_limit, on: :create, if: :bot?
+    after_save :sync_webhook, if: :bot?
+
+    scope :without_bots, -> { where.not(role: :bot) }
+    scope :suspended, -> { where.not(suspended_at: nil) }
+    scope :not_suspended, -> { where(suspended_at: nil) }
+  end
+
+  class_methods do
+    def create_bot!(attributes)
+      transaction do
+        create! attributes.merge(role: :bot)
+      end
+    end
+
+    def authenticate_bot(bot_key)
+      id, token = bot_key.to_s.split("-", 2)
+      return nil unless id&.match?(/\A\d+\z/) && token.present?
+
+      if bot = active.bot.find_by(id: id)
+        bot if bot.bot_token.present? && ActiveSupport::SecurityUtils.secure_compare(bot.bot_token, token)
+      end
+    end
+  end
+
+  def bot_key
+    "#{id}-#{bot_token}" if bot? && bot_token.present?
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspension_reason_description
+    SUSPENSION_REASONS[suspension_reason]
+  end
+
+  def suspend!(reason:)
+    reason = reason.to_s
+    raise ArgumentError, "Unknown suspension reason: #{reason.inspect}" unless SUSPENSION_REASONS.key?(reason)
+
+    transaction do
+      reload
+      return false unless active? && bot? && !suspended?
+
+      update!(
+        suspended_at: current_time_to_usec,
+        suspension_reason: reason,
+        bot_cooldown_until: nil,
+        bot_cooldown_attempts: 0,
+        bot_recent_post_timestamps: []
+      )
+      true
+    end
+  end
+
+  def reactivate
+    transaction do
+      reload
+      return false unless active? && bot?
+
+      update!(
+        suspended_at: nil,
+        suspension_reason: nil,
+        bot_cooldown_until: nil,
+        bot_cooldown_attempts: 0,
+        bot_recent_post_timestamps: []
+      )
+      webhook&.update!(consecutive_failures: 0)
+      true
+    end
+  end
+
+  def consume_bot_post_slot!(room: nil)
+    now = current_time_to_usec
+    now_usec = time_to_usec(now)
+    window_cutoff_usec = now_usec - FLOOD_WINDOW_USEC
+
+    transaction do
+      reload
+      return [ :inactive ] unless active? && bot?
+      return [ :suspended ] if suspended?
+      return [ :inactive ] if room && !rooms.exists?(room.id)
+
+      if bot_cooldown_until.present? && bot_cooldown_until > now
+        attempts = bot_cooldown_attempts + 1
+        if attempts >= COOLDOWN_STRIKE_LIMIT
+          update!(
+            suspended_at: now,
+            suspension_reason: "flooding",
+            bot_cooldown_until: nil,
+            bot_cooldown_attempts: 0,
+            bot_recent_post_timestamps: []
+          )
+          return [ :suspended ]
+        else
+          update_columns(bot_cooldown_attempts: attempts)
+          remaining_usec = time_to_usec(bot_cooldown_until) - now_usec
+          retry_after = [ (remaining_usec + 999_999) / 1_000_000, 1 ].max
+          return [ :rate_limited, retry_after ]
+        end
+      end
+
+      recent = Array(bot_recent_post_timestamps).select { |ts| ts > window_cutoff_usec }
+
+      if recent.length >= FLOOD_LIMIT
+        cooldown_until = now + COOLDOWN_DURATION
+        update_columns(
+          bot_cooldown_until: cooldown_until,
+          bot_cooldown_attempts: 0,
+          bot_recent_post_timestamps: recent
+        )
+        return [ :rate_limited, COOLDOWN_DURATION.to_i ]
+      end
+
+      recent << now_usec
+      update_columns(
+        bot_cooldown_until: nil,
+        bot_cooldown_attempts: 0,
+        bot_recent_post_timestamps: recent
+      )
+      [ :allowed ]
+    end
+  end
+
+  def at_bot_limit?(account: Current.account)
+    return false if administrator? || account.nil?
+
+    created_bots.active.count >= account.settings.bots_per_member
+  end
+
+  def can_create_bot?(account: Current.account)
+    !at_bot_limit?(account: account)
+  end
+
+  def webhook_url
+    if defined?(@webhook_url)
+      @webhook_url
+    else
+      webhook&.url
+    end
+  end
+
+  def webhook_url=(value)
+    @webhook_url = value.to_s.strip
+  end
+
+  def reload(*)
+    remove_instance_variable(:@webhook_url) if defined?(@webhook_url)
+    super
+  end
+
+  private
+    def current_time_to_usec
+      now = Time.current
+      Time.at(now.to_i, now.usec, :microsecond).in_time_zone(Time.zone)
+    end
+
+    def time_to_usec(time)
+      time.to_i * 1_000_000 + time.usec
+    end
+
+    def initialize_bot
+      self.bot_token ||= generate_bot_token
+      self.password_digest ||= ""
+    end
+
+    def generate_bot_token
+      SecureRandom.base58(24)
+    end
+
+    def validate_webhook_url
+      return unless defined?(@webhook_url) && @webhook_url.present?
+
+      unless Webhook.valid_url?(@webhook_url)
+        errors.add :webhook_url, "must be a valid HTTP or HTTPS URL"
+      end
+    end
+
+    def validate_bot_limit
+      return unless active? && creator&.at_bot_limit?
+
+      limit = Current.account.settings.bots_per_member
+      errors.add :base, "You’ve reached the limit of #{limit} #{"chat bot".pluralize(limit)}."
+    end
+
+    def sync_webhook
+      return unless defined?(@webhook_url)
+
+      if @webhook_url.present?
+        if webhook
+          webhook.update!(url: @webhook_url)
+        else
+          create_webhook!(url: @webhook_url)
+        end
+      else
+        webhook&.destroy!
+        association(:webhook).reset
+      end
+
+      remove_instance_variable(:@webhook_url)
+    end
+end
