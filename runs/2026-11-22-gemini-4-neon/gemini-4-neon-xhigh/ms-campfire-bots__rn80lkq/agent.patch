diff --git a/app/models/webhook.rb b/app/models/webhook.rb
new file mode 100644
index 0000000..9283733
--- /dev/null
+++ b/app/models/webhook.rb
@@ -0,0 +1,257 @@
+require "net/http"
+
+class Webhook < ApplicationRecord
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 15
+  WRITE_TIMEOUT = 5
+  MAX_RESPONSE_BODY_SIZE = 1.megabyte
+  CONSECUTIVE_FAILURE_LIMIT = 10
+
+  DELIVERY_ERRORS = [
+    Timeout::Error,
+    SocketError,
+    SystemCallError,
+    IOError,
+    OpenSSL::SSL::SSLError,
+    Net::HTTPExceptions,
+    Net::ProtocolError,
+    Net::HTTPBadResponse,
+    Net::HTTPHeaderSyntaxError,
+    URI::InvalidURIError
+  ].freeze
+
+  belongs_to :user
+
+  normalizes :url, with: ->(url) { url.strip }
+
+  validates :url, presence: true
+  validate :validate_url_format
+
+  before_save :reset_consecutive_failures, if: :will_save_change_to_url?
+
+  class << self
+    def valid_url?(value)
+      uri = URI.parse(value.to_s)
+      uri.is_a?(URI::HTTP) && uri.host.present?
+    rescue URI::InvalidURIError
+      false
+    end
+  end
+
+  def deliver_later(message)
+    Webhook::DeliveryJob.perform_later(self, message)
+  end
+
+  def deliver(message)
+    return unless deliverable_for?(message)
+
+    reply_body = post_and_extract_reply(payload_for(message))
+    post_reply(message.room, reply_body) if reply_body
+  end
+
+  def deliver_joined_later(room)
+    Webhook::DeliveryJob.perform_later(self, room)
+  end
+
+  def deliver_joined(room)
+    return unless deliverable_joined_for?(room)
+
+    reply_body = post_and_extract_reply(joined_payload_for(room))
+    post_reply(room, reply_body) if reply_body
+  end
+
+  def payload_for(message)
+    {
+      event: "mention",
+      author: {
+        id: message.creator.id,
+        name: message.creator.name
+      },
+      room: room_payload(message.room),
+      message: {
+        id: message.id,
+        body: {
+          text: message.plain_text_without_mention(user),
+          html: message.body.body&.to_html.to_s
+        },
+        link: routes.room_at_message_path(message.room, message)
+      }
+    }
+  end
+
+  def joined_payload_for(room)
+    {
+      event: "joined",
+      room: room_payload(room)
+    }
+  end
+
+  private
+    def validate_url_format
+      return if url.blank?
+
+      unless self.class.valid_url?(url)
+        errors.add :url, "must be a valid HTTP or HTTPS URL"
+      end
+    end
+
+    def reset_consecutive_failures
+      self.consecutive_failures = 0
+    end
+
+    def room_payload(room)
+      {
+        id: room.id,
+        name: room.name,
+        reply_to: routes.room_bot_messages_path(room, user.bot_key)
+      }
+    end
+
+    def deliverable_in?(room)
+      user.reload
+      user.active? && !user.suspended? && user.bot? && user.bot_token.present? && user.rooms.exists?(room.id)
+    rescue ActiveRecord::RecordNotFound
+      false
+    end
+
+    def deliverable_for?(message)
+      deliverable_in?(message.room)
+    end
+
+    def deliverable_joined_for?(room)
+      !room.direct? && deliverable_in?(room)
+    end
+
+    def post_and_extract_reply(payload)
+      uri = URI.parse(url)
+
+      succeeded = false
+      reply = nil
+
+      post_json(uri, payload) do |response|
+        if response.is_a?(Net::HTTPSuccess)
+          succeeded = true
+          reply = extract_reply(response)
+        end
+      end
+
+      if succeeded
+        record_delivery_success
+      else
+        record_delivery_failure
+      end
+
+      reply
+    rescue *DELIVERY_ERRORS => e
+      Rails.logger.warn "Failed to deliver webhook #{id} for bot #{user_id} (#{e.class}: #{e.message})"
+      record_delivery_failure
+      nil
+    end
+
+    def record_delivery_success
+      User.transaction do
+        return unless reload_for_delivery_tracking
+
+        update_columns(consecutive_failures: 0) if consecutive_failures > 0
+      end
+    end
+
+    def record_delivery_failure
+      User.transaction do
+        return unless reload_for_delivery_tracking
+
+        failures = consecutive_failures + 1
+        update_columns(consecutive_failures: failures)
+        user.suspend!(reason: "failing_webhooks") if failures >= CONSECUTIVE_FAILURE_LIMIT
+      end
+    end
+
+    def reload_for_delivery_tracking
+      reload
+      user.reload
+      user.active? && !user.suspended? && user.bot?
+    rescue ActiveRecord::RecordNotFound
+      false
+    end
+
+    def post_json(uri, payload, &)
+      Net::HTTP.start(
+        uri.hostname,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT,
+        write_timeout: WRITE_TIMEOUT
+      ) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri)
+        request["Content-Type"] = "application/json"
+        request["User-Agent"] = "Campfire"
+        if uri.user
+          request.basic_auth(
+            URI::DEFAULT_PARSER.unescape(uri.user),
+            URI::DEFAULT_PARSER.unescape(uri.password.to_s)
+          )
+        end
+        request.body = payload.to_json
+
+        http.request(request, &)
+      end
+    end
+
+    def extract_reply(response)
+      return nil unless response.is_a?(Net::HTTPOK)
+
+      media_type = response.content_type&.downcase
+      return nil unless media_type.in?(%w[ text/plain text/html ])
+
+      raw_body = read_response_body(response)
+      return nil if raw_body.nil?
+
+      decoded_body = decode_body(raw_body, response)
+      return nil if decoded_body.blank?
+
+      format_reply_body(decoded_body, media_type)
+    end
+
+    def read_response_body(response)
+      return nil if response.content_length && response.content_length > MAX_RESPONSE_BODY_SIZE
+
+      body = +"".b
+      response.read_body do |chunk|
+        return nil if body.bytesize + chunk.bytesize > MAX_RESPONSE_BODY_SIZE
+        body << chunk
+      end
+      body
+    end
+
+    def decode_body(raw_body, response)
+      charset = response.type_params["charset"]
+      encoding = (Encoding.find(charset) if charset.present?) || Encoding::UTF_8
+      decoded = raw_body.dup.force_encoding(encoding)
+      decoded = decoded.encode(Encoding::UTF_8) unless encoding == Encoding::UTF_8
+      decoded.valid_encoding? ? decoded : decoded.scrub
+    rescue ArgumentError, Encoding::UndefinedConversionError, Encoding::InvalidByteSequenceError
+      raw_body.dup.force_encoding(Encoding::UTF_8).scrub
+    end
+
+    def format_reply_body(body, media_type)
+      case media_type
+      when "text/plain"
+        ERB::Util.html_escape(body).gsub(/\r\n|\r|\n/, "<br>")
+      when "text/html"
+        body
+      end
+    end
+
+    def post_reply(room, body)
+      status, = user.consume_bot_post_slot!(room: room)
+      return unless status == :allowed
+
+      reply = room.messages.create!(creator: user, body: body)
+      reply.broadcast_create
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+end
