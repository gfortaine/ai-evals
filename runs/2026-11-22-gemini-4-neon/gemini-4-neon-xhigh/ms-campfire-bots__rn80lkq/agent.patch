+
+  def settings=(data)
+    if data.respond_to?(:key?) && (data.key?(:bots_per_member) || data.key?("bots_per_member"))
+      raw = data.key?(:bots_per_member) ? data[:bots_per_member] : data["bots_per_member"]
+      unless valid_bots_per_member_input?(raw)
+        data = data.to_h.merge("bots_per_member" => nil)
+        data.delete(:bots_per_member)
+      end
+    end
+
+    settings.assign_data_with_type_casting(data)
+  end
 
   def logo_variant(size)
     logo.variant(size).processed if logo.variable?
   end
+
+  private
+    def validate_bots_per_member
+      limit = settings.bots_per_member
+      unless limit.is_a?(Integer) && limit >= 0
+        errors.add :bots_per_member, "must be a whole number of 0 or more"
+      end
+    end
+
+    def valid_bots_per_member_input?(value)
+      case value
+      when Integer then value >= 0
+      when String then value.match?(/\A\s*\d+\s*\z/)
+      else false
+      end
+    end
 end
