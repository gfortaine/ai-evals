+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated users are redirected to sign in" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    get bots_url
+    assert_redirected_to new_session_url
+
+    get new_bot_url
+    assert_redirected_to new_session_url
+
+    post bots_url, params: { bot: { name: "New Bot" } }
+    assert_redirected_to new_session_url
+
+    get edit_bot_url(bot)
+    assert_redirected_to new_session_url
+
+    patch bot_url(bot), params: { bot: { name: "Updated" } }
+    assert_redirected_to new_session_url
+
+    delete bot_url(bot)
+    assert_redirected_to new_session_url
+  end
+
+  test "account settings shows Set up chat bots link to both members and administrators" do
+    sign_in :kevin
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']" do
+      assert_select ".for-screen-reader", text: "Set up chat bots"
+    end
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']"
+  end
+
+  test "member sees only their own bots on /bots with name, read-only Bot code, and Edit link in same list item" do
+    kevins_bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    jzs_bot = User.create_bot!(name: "Secret Bot", creator: users(:jz))
+    deleted_bot = User.create_bot!(name: "Old Bot", creator: users(:kevin))
+    deleted_bot.deactivate
+
+    sign_in :kevin
+    get bots_url
+
+    assert_response :ok
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+
+    assert_select "li#user_#{kevins_bot.id}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "label[for='bot_code_user_#{kevins_bot.id}']", text: "Bot code"
+      assert_select "input[readonly][id='bot_code_user_#{kevins_bot.id}'][value='#{kevins_bot.bot_key}']"
+      assert_select "a[href='#{edit_bot_path(kevins_bot)}'][aria-label='Edit Deploy Bot']"
+    end
+
+    assert_not_includes response.body, jzs_bot.name
+    assert_not_includes response.body, jzs_bot.bot_key
+    assert_not_includes response.body, deleted_bot.name
+  end
+
+  test "administrator sees all active bots on /bots without pagination" do
+    accounts(:signal).update!(settings: { bots_per_member: 20 })
+
+    created_bots = 30.times.map do |i|
+      creator = i.even? ? users(:kevin) : users(:jz)
+      User.create_bot!(name: "Bot #{format('%02d', i)}", creator: creator)
+    end
+
+    sign_in :david
+    get bots_url
+
+    assert_response :ok
+    created_bots.each do |bot|
+      assert_select "li#user_#{bot.id}" do
+        assert_select "strong", text: bot.name
+        assert_select "input[readonly][value='#{bot.bot_key}']"
+      end
+    end
