+test "consume_bot_post_slot! enforces sliding 10 messages per 10 seconds window, 30s cooldown, and 5-strike suspension" do
+  bot = User.create_bot!(name: "Rate Bot", creator: users(:kevin))
+
+  freeze_time do
+    # 5 messages at t=0, 5 messages at t=6 => 10 messages in 10s
+    5.times { assert_equal [ :allowed ], bot.consume_bot_post_slot! }
+
+    travel 6.seconds
+    5.times { assert_equal [ :allowed ], bot.consume_bot_post_slot! }
+
+    # At t=8, all 10 messages are still within 10 seconds => rejected and starts 30s cooldown
+    travel 2.seconds
+    assert_equal [ :rate_limited, 30 ], bot.consume_bot_post_slot!
+    assert_not bot.reload.suspended?
+
+    # 4 more attempts during the same cooldown do not suspend and report decreasing seconds left
+    travel 5.seconds
+    assert_equal [ :rate_limited, 25 ], bot.consume_bot_post_slot!
+    travel 5.seconds
+    assert_equal [ :rate_limited, 20 ], bot.consume_bot_post_slot!
+    travel 5.seconds
+    assert_equal [ :rate_limited, 15 ], bot.consume_bot_post_slot!
+    travel_to(Time.current + 14.4.seconds, with_usec: true)
+    assert_equal [ :rate_limited, 1 ], bot.consume_bot_post_slot!
+    assert_not bot.reload.suspended?
+    assert_equal 4, bot.bot_cooldown_attempts
+
+    # After cooldown ends (at t=38), bot can post again and strike count resets
+    travel_to(Time.current + 0.6.seconds, with_usec: true)
+    assert_equal [ :allowed ], bot.consume_bot_post_slot!
+    assert_equal 0, bot.reload.bot_cooldown_attempts
+    assert_nil bot.bot_cooldown_until
+
+    # Fill a new 10-message window and trigger a new cooldown
+    9.times { assert_equal [ :allowed ], bot.consume_bot_post_slot! }
+    assert_equal [ :rate_limited, 30 ], bot.consume_bot_post_slot!
+
+    # 4 attempts in new cooldown do not suspend (previous cooldown strikes did not carry over)
+    4.times { assert_equal [ :rate_limited, 30 ], bot.consume_bot_post_slot! }
+    assert_not bot.reload.suspended?
+
+    # 5th attempt in the same cooldown suspends the bot for flooding
+    assert_equal [ :suspended ], bot.consume_bot_post_slot!
+    assert bot.reload.suspended?
+    assert_equal "flooding", bot.suspension_reason
+    assert_match(/Flooding/i, bot.suspension_reason_description)
+
+    # Even long after 30s, bot stays suspended
+    travel 1.hour
+    assert_equal [ :suspended ], bot.consume_bot_post_slot!
+  end
+end
+
+test "sliding window expires only messages older than 10 seconds" do
+  bot = User.create_bot!(name: "Sliding Bot", creator: users(:kevin))
+
+  freeze_time do
+    6.times { assert_equal [ :allowed ], bot.consume_bot_post_slot! }
+
+    travel 5.seconds
+    4.times { assert_equal [ :allowed ], bot.consume_bot_post_slot! }
+
+    # At t=10s, the 6 messages from t=0 expire, while the 4 from t=5s remain in window
+    travel 5.seconds
+    6.times { assert_equal [ :allowed ], bot.consume_bot_post_slot! }
+
+    # A 7th message at t=10s makes 11 within (0s..10s] => rejected with 30s cooldown
+    assert_equal [ :rate_limited, 30 ], bot.consume_bot_post_slot!
+  end
+end
+
+test "suspended bot keeps rooms, messages, bot_key, and counts toward owner bot limit; deactivate frees slot" do
+  accounts(:signal).update!(settings: { bots_per_member: 1 })
+  bot = User.create_bot!(name: "Kept Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+  rooms(:hq).memberships.grant_to(bot)
+  rooms(:watercooler).memberships.grant_to(bot)
+  message = rooms(:hq).messages.create!(creator: bot, body: "Before suspension")
+  original_key = bot.bot_key
+
+  assert bot.suspend!(reason: "failing_webhooks")
+  bot.reload
+
+  assert bot.active?
+  assert bot.suspended?
+  assert_equal "failing_webhooks", bot.suspension_reason
+  assert_equal original_key, bot.bot_key
+  assert_equal bot, User.authenticate_bot(original_key)
+  assert_equal [ rooms(:hq).id, rooms(:watercooler).id ].sort, bot.rooms.pluck(:id).sort
+  assert Message.exists?(message.id)
+
+  # Still counts toward owner bot limit
+  assert users(:kevin).at_bot_limit?
+  assert_not User.new(role: :bot, name: "Extra Bot", creator: users(:kevin)).valid?
+
+  # Does not overwrite original suspension reason if suspend! called again
+  assert_not bot.suspend!(reason: "flooding")
+  assert_equal "failing_webhooks", bot.reload.suspension_reason
+
+  # Reactivate clears suspension and webhook failures while preserving rooms and messages
+  bot.webhook.update_columns(consecutive_failures: 10)
+  assert bot.reactivate
+  bot.reload
+  assert_not bot.suspended?
+  assert_nil bot.suspension_reason
+  assert_equal 0, bot.webhook.reload.consecutive_failures
+  assert_equal [ rooms(:hq).id, rooms(:watercooler).id ].sort, bot.rooms.pluck(:id).sort
+  assert Message.exists?(message.id)
+
+  # Deleting a suspended bot frees owner bot limit slot
+  bot.suspend!(reason: "flooding")
+  bot.deactivate
+  assert_not bot.reload.active?
+  assert_not bot.suspended?
+  assert_not users(:kevin).at_bot_limit?
+end
+end
