+class Webhook::DeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(webhook, event_record)
+    case event_record
+    when Message
+      webhook.deliver(event_record)
+    when Room
+      webhook.deliver_joined(event_record)
+    end
+  end
+end
