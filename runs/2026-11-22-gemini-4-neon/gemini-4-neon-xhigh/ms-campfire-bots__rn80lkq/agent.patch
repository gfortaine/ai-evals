+test "suspended bot receives no mention or joined webhooks, including already-enqueued jobs, until reactivated" do
+  @bot.suspend!(reason: "failing_webhooks")
+
+  # Mentioning suspended bot enqueues no webhook jobs
+  assert_no_enqueued_jobs only: [ Webhook::DeliveryJob ] do
+    @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} hello</div>")
+  end
+
+  # Adding suspended bot to closed room or open room enqueues no joined webhook jobs
+  assert_no_enqueued_jobs only: [ Webhook::DeliveryJob ] do
+    rooms(:watercooler).memberships.grant_to(@bot)
+    @bot.update!(add_to_all_open_rooms: true)
+    Rooms::Open.create!(name: "New Open While Suspended", creator: users(:david))
+  end
+
+  # Already-enqueued job before suspension is skipped once suspended
+  @bot.reactivate
+  @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} queued</div>")
+  assert_enqueued_jobs 1, only: [ Webhook::DeliveryJob ]
+  @bot.suspend!(reason: "flooding")
+
+  WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 204)
+  perform_enqueued_jobs only: Webhook::DeliveryJob
+  assert_not_requested :post, "https://bot.example.com/hook?secret=abc"
+
+  # After reactivation, mention webhooks work again and need 10 fresh failures to re-suspend
+  @bot.reactivate
+  WebMock.reset!
+  WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(
+    status: 200, body: "I am back!", headers: { "Content-Type" => "text/plain" }
+  )
+
+  assert_difference -> { @room.messages.count }, +2 do
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} welcome back</div>")
+    end
+  end
+  assert_equal "I am back!", @room.messages.order(:id).last.plain_text_body
+end
+
+test "webhook replies count toward flooding limit, drop replies during cooldown, and suspend on 5th cooldown reply attempt" do
+  freeze_time do
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(
+      status: 200, body: "Pong!", headers: { "Content-Type" => "text/plain" }
+    )
+
+    message = @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+    clear_enqueued_jobs
+
+    # First 10 webhook replies succeed
+    assert_difference -> { @room.messages.where(creator: @bot).count }, +10 do
+      10.times { @bot.webhook.deliver(message) }
+    end
+
+    # 11th reply goes over limit: not posted, starts 30s cooldown
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      @bot.webhook.deliver(message)
+    end
+    assert_not @bot.reload.suspended?
+    assert @bot.bot_cooldown_until > Time.current
+    assert_equal 0, @bot.bot_cooldown_attempts
+
+    # A 204 during cooldown does NOT count as a posting attempt
+    WebMock.reset!
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 204)
+    @bot.webhook.deliver(message)
+    assert_equal 0, @bot.reload.bot_cooldown_attempts
+
+    # 4 reply attempts during cooldown are dropped without suspending
+    WebMock.reset!
+    WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(
+      status: 200, body: "Spam", headers: { "Content-Type" => "text/plain" }
+    )
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      4.times { @bot.webhook.deliver(message) }
+    end
+    assert_not @bot.reload.suspended?
+    assert_equal 4, @bot.bot_cooldown_attempts
+
+    # 5th reply attempt during cooldown is dropped and suspends the bot for flooding
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      @bot.webhook.deliver(message)
+    end
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+  end
+end
+
+test "updating webhook_url resets consecutive_failures on active bot and does not reactivate suspended bot" do
+  message = @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+  clear_enqueued_jobs
+
+  WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 500)
+  5.times { @bot.webhook.deliver(message) }
+  assert_equal 5, @bot.webhook.reload.consecutive_failures
+
+  # Updating bot name without changing URL keeps failure count
+  @bot.update!(name: "Deploy Bot 2")
+  assert_equal 5, @bot.webhook.reload.consecutive_failures
+
+  # Changing URL resets failure count
+  @bot.update!(webhook_url: "https://new-bot.example.com/hook")
+  assert_equal 0, @bot.webhook.reload.consecutive_failures
+
+  # Changing URL on a suspended bot does not reactivate it
+  @bot.suspend!(reason: "failing_webhooks")
+  @bot.update!(webhook_url: "https://fixed-bot.example.com/hook")
+  assert @bot.reload.suspended?
+end
+end
