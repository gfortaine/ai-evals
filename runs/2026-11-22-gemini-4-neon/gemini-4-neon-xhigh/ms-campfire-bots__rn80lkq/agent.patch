diff --git a/test/integration/bot_webhooks_test.rb b/test/integration/bot_webhooks_test.rb
new file mode 100644
index 0000000..f97506c
--- /dev/null
+++ b/test/integration/bot_webhooks_test.rb
@@ -0,0 +1,632 @@
+require "test_helper"
+require "socket"
+
+class BotWebhooksTest < ActionDispatch::IntegrationTest
+  setup do
+    @room = rooms(:hq)
+    sign_in :kevin
+  end
+
+  test "end-to-end bot webhook lifecycle via forms and real localhost HTTP server" do
+    WebMock.allow_net_connect!(allow_localhost: true)
+
+    received_requests = Queue.new
+    mode = :plain
+
+    server = TCPServer.new("127.0.0.1", 0)
+    port = server.addr[1]
+    server_thread = Thread.new do
+      loop do
+        client = server.accept
+        begin
+          request_line = client.gets
+          next unless request_line
+
+          headers = {}
+          while (line = client.gets) && line != "\r\n"
+            k, v = line.split(":", 2)
+            headers[k.downcase] = v.strip
+          end
+          body = client.read(headers["content-length"].to_i)
+          received_requests << { request_line: request_line, headers: headers, body: body }
+
+          case mode
+          when :plain
+            resp_body = "Restarting build #42 🚀"
+            client.write "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: #{resp_body.bytesize}\r\nConnection: close\r\n\r\n#{resp_body}"
+          when :chunked_utf8
+            # Split a 4-byte emoji across two HTTP chunks to ensure decoding happens on the assembled buffer
+            full = "Chunked 🚀 done".b
+            first_chunk = full.byteslice(0, 10)
+            second_chunk = full.byteslice(10..)
+            client.write(
+              "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n" \
+              "#{first_chunk.bytesize.to_s(16)}\r\n#{first_chunk}\r\n" \
+              "#{second_chunk.bytesize.to_s(16)}\r\n#{second_chunk}\r\n" \
+              "0\r\n\r\n"
+            )
+          when :html
+            resp_body = "<div>Build <strong>#43</strong> succeeded!</div>"
+            client.write "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: #{resp_body.bytesize}\r\nConnection: close\r\n\r\n#{resp_body}"
+          when :async_204
+            client.write "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n"
+          when :slow
+            sleep 0.4
+            resp_body = "Slow reply finished"
+            client.write "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: #{resp_body.bytesize}\r\nConnection: close\r\n\r\n#{resp_body}"
+          end
+        ensure
+          client.close
+        end
+      end
+    rescue IOError, Errno::EBADF
+      # Server closed during teardown
+    end
+
+    webhook_url = "http://127.0.0.1:#{port}/campfire-webhook"
+
+    # Create bot via /bots form with Webhook URL (off by default for open rooms)
+    post bots_url, params: { bot: { name: "Deploy Bot", webhook_url: webhook_url } }
+    assert_redirected_to bots_url
+    bot = User.active.bot.order(:id).last
+    assert_equal webhook_url, bot.webhook_url
+    assert_empty bot.rooms
+
+    # Add bot to @room manually as room admin
+    sign_in :david
+    mode = :async_204
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      put rooms_open_url(@room), params: { room: { name: @room.name }, user_ids: [ "", bot.id.to_s ] }
+      assert_redirected_to room_url(@room)
+    end
+    joined_payload = JSON.parse(received_requests.pop(true)[:body])
+    assert_equal "joined", joined_payload["event"]
+    assert_equal @room.id, joined_payload["room"]["id"]
+
+    sign_in :kevin
+
+    # Bot appears in room @-mention autocomplete
+    get autocompletable_users_url(room_id: @room.id, format: :json), params: { query: "Deploy" }
+    assert_response :ok
+    assert_equal [ bot.id ], response.parsed_body.map { |u| u["value"] }
+
+    # 1. Synchronous text/plain reply
+    mode = :plain
+    post room_messages_url(@room, format: :turbo_stream), params: {
+      message: { body: "<div>#{mention_attachment_for(bot)}&nbsp;restart the build please</div>" }
+    }
+    assert_response :success
+    mention_message = @room.messages.order(:id).last
+
+    ActionCable.server.pubsub.clear
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    req = received_requests.pop(true)
+    assert_equal "application/json", req[:headers]["content-type"]
+    payload = JSON.parse(req[:body])
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:kevin).id, "name" => users(:kevin).name }, payload["author"])
+    assert_equal(
+      { "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{bot.bot_key}/messages" },
+      payload["room"]
+    )
+    assert_equal mention_message.id, payload["message"]["id"]
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+    assert_includes payload["message"]["body"]["html"], "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{mention_message.id}", payload["message"]["link"]
+
+    reply = @room.messages.order(:id).last
+    assert_equal bot, reply.creator
+    assert_equal "Restarting build #42 🚀", reply.plain_text_body
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body", text: /Restarting build #42 🚀/
+    end
+
+    # Deep link from payload opens the room with the mentioned message
+    get payload["message"]["link"]
+    assert_response :ok
+    assert_select "##{dom_id(mention_message)}"
+
+    # 2. Chunked UTF-8 response with split multibyte character
+    mode = :chunked_utf8
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} chunk test</div>" }
+      }
+      assert_response :success
+    end
+    received_requests.pop(true)
+    assert_equal "Chunked 🚀 done", @room.messages.order(:id).last.plain_text_body
+
+    # 3. Synchronous text/html reply
+    mode = :html
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} status</div>" }
+      }
+      assert_response :success
+    end
+
+    received_requests.pop(true)
+    html_reply = @room.messages.order(:id).last
+    assert_equal bot, html_reply.creator
+    get room_url(@room)
+    assert_response :ok
+    assert_select "##{dom_id(html_reply)} .message__body strong", text: "#43"
+
+    # 4. 204 No Content + asynchronous reply later via payload's room.reply_to
+    mode = :async_204
+    assert_difference -> { @room.messages.count }, +1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        post room_messages_url(@room, format: :turbo_stream), params: {
+          message: { body: "<div>#{mention_attachment_for(bot)} run nightly</div>" }
+        }
+        assert_response :success
+      end
+    end
+
+    async_payload = JSON.parse(received_requests.pop(true)[:body])
+    assert_equal "run nightly", async_payload["message"]["body"]["text"]
+
+    # Bot replies out-of-band using room.reply_to
+    post async_payload["room"]["reply_to"],
+      params: +"Nightly build green!",
+      headers: { "Content-Type" => "text/plain" }
+    assert_response :created
+    async_reply = @room.messages.order(:id).last
+    assert_equal bot, async_reply.creator
+    assert_equal "Nightly build green!", async_reply.plain_text_body
+
+    # 5. Slow webhook does not delay the person posting the message
+    mode = :slow
+    started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+    assert_enqueued_jobs 1, only: [ Webhook::DeliveryJob ] do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} take your time</div>" }
+      }
+      assert_response :success
+    end
+    elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at
+    assert_operator elapsed, :<, 0.3, "Posting a message took #{elapsed}s; webhook delivery must not block the request"
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    received_requests.pop(true)
+    assert_equal "Slow reply finished", @room.messages.order(:id).last.plain_text_body
+
+    # 6. Clearing webhook URL via edit form stops future webhook deliveries
+    patch bot_url(bot), params: { bot: { name: "Deploy Bot", webhook_url: "" } }
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook
+
+    assert_no_enqueued_jobs only: [ Webhook::DeliveryJob ] do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} hello after removal</div>" }
+      }
+      assert_response :success
+    end
+    assert_predicate received_requests, :empty?
+  ensure
+    server&.close
+    server_thread&.join(1)
+    WebMock.disable_net_connect!
+  end
+
+  test "end-to-end bot room membership opt-in and joined webhook lifecycle over real HTTP" do
+    WebMock.allow_net_connect!(allow_localhost: true)
