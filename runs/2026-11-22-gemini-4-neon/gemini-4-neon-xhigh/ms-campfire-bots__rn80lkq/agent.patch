+test "10 consecutive failed webhook deliveries suspend the bot across non-2xx, timeouts, and connection errors" do
+  failures = [
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 500) },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 502) },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 404) },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 400) },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 302, headers: { "Location" => "https://other.example.com" }) },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 429) },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_timeout },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_raise(Net::ReadTimeout) },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_raise(Errno::ECONNREFUSED) },
+    -> { WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_raise(SocketError) }
+  ]
+
+  message = @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+  clear_enqueued_jobs
+
+  failures.first(9).each_with_index do |stub_failure, index|
+    WebMock.reset!
+    stub_failure.call
+    @bot.webhook.deliver(message)
+    assert_equal index + 1, @bot.webhook.reload.consecutive_failures
+    assert_not @bot.reload.suspended?, "Should not suspend after #{index + 1} failures"
+  end
+
+  # 10th consecutive failure suspends the bot
+  WebMock.reset!
+  failures.last.call
+  @bot.webhook.deliver(message)
+
+  assert @bot.reload.suspended?
+  assert_equal "failing_webhooks", @bot.suspension_reason
+  assert_equal 10, @bot.webhook.reload.consecutive_failures
+
+  # Already-created delivery attempts do not make any HTTP requests once suspended
+  WebMock.reset!
+  WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 204)
+  @bot.webhook.deliver(message)
+  @bot.webhook.deliver_joined(rooms(:hq))
+  assert_not_requested :post, "https://bot.example.com/hook?secret=abc"
+end
+
+test "successful 2xx webhook delivery resets consecutive failure count" do
+  message = @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+  clear_enqueued_jobs
+
+  WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 500)
+  9.times { @bot.webhook.deliver(message) }
+  assert_equal 9, @bot.webhook.reload.consecutive_failures
+  assert_not @bot.reload.suspended?
+
+  # A 202 Accepted (any 2xx) resets consecutive_failures to 0
+  WebMock.reset!
+  WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 202)
+  @bot.webhook.deliver(message)
+  assert_equal 0, @bot.webhook.reload.consecutive_failures
+  assert_not @bot.reload.suspended?
+
+  # 9 more failures after reset still do not suspend
+  WebMock.reset!
+  WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 503)
+  9.times { @bot.webhook.deliver(message) }
+  assert_equal 9, @bot.webhook.reload.consecutive_failures
+  assert_not @bot.reload.suspended?
+
+  # 10th consecutive failure suspends
+  @bot.webhook.deliver(message)
+  assert @bot.reload.suspended?
+  assert_equal "failing_webhooks", @bot.suspension_reason
+end
+
+test "mention and joined webhook failures count together toward the 10-failure suspension threshold" do
+  message = @room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+  clear_enqueued_jobs
+
+  WebMock.stub_request(:post, "https://bot.example.com/hook?secret=abc").to_return(status: 500)
