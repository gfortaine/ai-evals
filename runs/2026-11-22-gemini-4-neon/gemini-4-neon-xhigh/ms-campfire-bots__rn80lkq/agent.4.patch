+    post bots_url, params: { bot: { name: "Admin Bot 1" } }
+    assert_redirected_to bots_url
+    post bots_url, params: { bot: { name: "Admin Bot 2" } }
+    assert_redirected_to bots_url
+  end
+end
+
+test "role promotion lifts the limit and role demotion enforces it without deleting existing bots" do
+  accounts(:signal).update!(settings: { bots_per_member: 1 })
+  3.times { |i| User.create_bot!(name: "Admin Bot #{i}", creator: users(:david)) }
+
+  # Demoting admin with 3 bots keeps all 3 bots and blocks creating more
+  users(:david).update!(role: :member)
+  assert_equal 3, users(:david).created_bots.active.count
+
+  sign_in :david
+  get bots_url
+  assert_response :ok
+  assert_not_includes response.body, "Add a chat bot"
+  assert_includes response.body, "reached the limit"
+
+  assert_no_difference -> { User.count } do
+    post bots_url, params: { bot: { name: "Blocked After Demotion" } }
+  end
+  assert_response :forbidden
+
+  # Promoting back to administrator lifts the limit immediately
+  users(:david).update!(role: :administrator)
+  get bots_url
+  assert_response :ok
+  assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+  assert_difference -> { User.active.bot.count }, +1 do
+    post bots_url, params: { bot: { name: "Allowed After Promotion" } }
+  end
+  assert_redirected_to bots_url
+end
 end
