+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated users are redirected to sign in" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    get bots_url
+    assert_redirected_to new_session_url
+
+    get new_bot_url
+    assert_redirected_to new_session_url
+
+    post bots_url, params: { bot: { name: "New Bot" } }
+    assert_redirected_to new_session_url
+
+    get edit_bot_url(bot)
+    assert_redirected_to new_session_url
+
+    patch bot_url(bot), params: { bot: { name: "Updated" } }
+    assert_redirected_to new_session_url
+
+    delete bot_url(bot)
+    assert_redirected_to new_session_url
+  end
+
+  test "account settings shows Set up chat bots link to both members and administrators" do
+    sign_in :kevin
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']" do
+      assert_select ".for-screen-reader", text: "Set up chat bots"
+    end
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']"
+  end
+
+  test "member sees only their own bots on /bots with name, read-only Bot code, and Edit link in same list item" do
+    kevins_bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    jzs_bot = User.create_bot!(name: "Secret Bot", creator: users(:jz))
+    deleted_bot = User.create_bot!(name: "Old Bot", creator: users(:kevin))
+    deleted_bot.deactivate
+
+    sign_in :kevin
+    get bots_url
+
+    assert_response :ok
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+
+    assert_select "li#user_#{kevins_bot.id}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "label[for='bot_code_user_#{kevins_bot.id}']", text: "Bot code"
+      assert_select "input[readonly][id='bot_code_user_#{kevins_bot.id}'][value='#{kevins_bot.bot_key}']"
+      assert_select "a[href='#{edit_bot_path(kevins_bot)}'][aria-label='Edit Deploy Bot']"
+    end
+
+    assert_not_includes response.body, jzs_bot.name
+    assert_not_includes response.body, jzs_bot.bot_key
+    assert_not_includes response.body, deleted_bot.name
+  end
+
+  test "administrator sees all active bots on /bots without pagination" do
+    created_bots = 30.times.map do |i|
+      creator = i.even? ? users(:kevin) : users(:jz)
+      User.create_bot!(name: "Bot #{format('%02d', i)}", creator: creator)
+    end
+
+    sign_in :david
+    get bots_url
+
+    assert_response :ok
+    created_bots.each do |bot|
+      assert_select "li#user_#{bot.id}" do
+        assert_select "strong", text: bot.name
+        assert_select "input[readonly][value='#{bot.bot_key}']"
+      end
+    end
+  end
+
+  test "new renders form with avatar upload, required Name the bot field, and Save changes button" do
+    sign_in :kevin
+    get new_bot_url
+
+    assert_response :ok
+    assert_select "form[action='#{bots_path}'][method='post']" do
+      assert_select "input[type='file'][name='bot[avatar]']"
+      assert_select "label[for='bot_name']", text: /Name the bot/
+      assert_select "input[name='bot[name]'][placeholder='Name the bot'][required]"
+      assert_select "button[type='submit'][aria-label='Save changes']", text: /Save changes/
+    end
+  end
+
+  test "member can create a bot without avatar and it joins all open rooms" do
+    sign_in :kevin
+
+    assert_difference -> { User.active.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    assert_redirected_to bots_url
+
+    bot = User.active.bot.order(:id).last
+    assert_equal "Deploy Bot", bot.name
+    assert_equal users(:kevin), bot.creator
+    assert_not bot.avatar.attached?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "member can create a bot with an avatar" do
+    sign_in :kevin
+
+    assert_difference -> { User.active.bot.count }, +1 do
+      post bots_url, params: {
+        bot: {
+          name: "Avatar Bot",
+          avatar: fixture_file_upload("earth.png", "image/png")
+        }
+      }
+    end
+
+    assert_redirected_to bots_url
+    bot = User.active.bot.order(:id).last
+    assert bot.avatar.attached?
+  end
+
+  test "create rejects blank name and ignores unpermitted attributes" do
+    sign_in :kevin
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "   " } }
+    end
+    assert_response :unprocessable_content
+
+    post bots_url, params: {
+      bot: {
+        name: "Sneaky Bot",
+        role: "administrator",
+        creator_id: users(:david).id,
+        bot_token: "predictable-token"
+      }
+    }
+    assert_redirected_to bots_url
+
+    bot = User.order(:id).last
+    assert bot.bot?
+    assert_equal users(:kevin), bot.creator
+    assert_not_equal "predictable-token", bot.bot_token
+  end
+
+  test "edit renders form and Delete this chat bot confirmation button" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    get edit_bot_url(bot)
+
+    assert_response :ok
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_select "form[action='#{bot_path(bot)}']" do
+      assert_select "input[name='bot[name]'][value='Deploy Bot'][required]"
+      assert_select "button[type='submit'][aria-label='Save changes']"
+    end
+    assert_select "form[action='#{bot_path(bot)}'] button[data-turbo-confirm]", text: /Delete this chat bot/
+  end
+
+  test "creator can update bot name and avatar while preserving bot code and existing avatar" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin), avatar: fixture_file_upload("earth.png", "image/png"))
+    original_key = bot.bot_key
+    original_blob_id = bot.avatar.blob_id
+
+    sign_in :kevin
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    bot.reload
+    assert_equal "Release Bot", bot.name
+    assert_equal original_key, bot.bot_key
+    assert_equal original_blob_id, bot.avatar.blob_id
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    assert_redirected_to bots_url
+    assert_not_equal original_blob_id, bot.reload.avatar.blob_id
+  end
+
+  test "update rejects blank name with 422" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    patch bot_url(bot), params: { bot: { name: "" } }
+
+    assert_response :unprocessable_content
+    assert_equal "Deploy Bot", bot.reload.name
+  end
+
+  test "administrator can edit, update, and delete another member's bot" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :david
+    get edit_bot_url(bot)
+    assert_response :ok
+
+    patch bot_url(bot), params: { bot: { name: "Admin Renamed Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Admin Renamed Bot", bot.reload.name
+    assert_equal users(:kevin), bot.creator
+
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+  end
+
+  test "non-admin member cannot edit, update, or delete another member's bot" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :jz
+
+    get edit_bot_url(bot)
+    assert_response :forbidden
+
+    patch bot_url(bot), params: { bot: { name: "Hijacked" } }
+    assert_response :forbidden
+    assert_equal "Deploy Bot", bot.reload.name
+
+    delete bot_url(bot)
+    assert_response :forbidden
+    assert bot.reload.active?
+  end
+
+  test "cannot manage human users or deleted bots through /bots" do
+    deleted_bot = User.create_bot!(name: "Gone Bot", creator: users(:kevin))
+    deleted_bot.deactivate
+
+    sign_in :david
+
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(users(:kevin))
+    end
+
+    assert_raises ActiveRecord::RecordNotFound do
+      delete bot_url(users(:kevin))
+    end
+
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(deleted_bot)
+    end
+  end
+
+  test "deleting a bot removes it from /bots and invalidates its bot code" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    bot_key = bot.bot_key
+
+    sign_in :kevin
+    delete bot_url(bot)
+
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+
+    get bots_url
+    assert_not_includes response.body, "Deploy Bot"
+
+    post room_bot_messages_url(rooms(:hq), bot_key), params: +"Still here?"
+    assert_response :unauthorized
+  end
+
+  test "bots are excluded from account user lists, cannot be role-changed or banned, and cannot sign in" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :david
+
+    get edit_account_url
+    assert_response :ok
+    assert_not_includes response.body, "Deploy Bot"
+
+    assert_raises ActiveRecord::RecordNotFound do
+      put account_user_url(bot), params: { user: { role: "administrator" } }
+    end
+
+    assert_raises ActiveRecord::RecordNotFound do
+      post user_ban_url(bot)
+    end
+
+    get user_url(bot)
+    assert_response :ok
+    assert_not_includes response.body, bot.bot_key
+    assert_not_includes response.body, "Ban Deploy Bot"
+    assert_not_includes response.body, "session_transfer_url"
+
+    delete session_url
+    post session_url, params: { email_address: nil, password: "" }
+    assert_response :unauthorized
+
+    put session_transfer_url(bot.transfer_id)
+    assert_response :bad_request
+  end
+
+  test "bots can be added to closed rooms and direct rooms the same way as people" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :david
+    get edit_rooms_closed_url(rooms(:watercooler))
+    assert_response :ok
+    assert_select "input[type='checkbox'][name='user_ids[]'][value='#{bot.id}']"
+
+    put rooms_closed_url(rooms(:watercooler)), params: {
+      room: { name: rooms(:watercooler).name },
+      user_ids: rooms(:watercooler).user_ids + [ bot.id ]
+    }
+    assert_redirected_to room_url(rooms(:watercooler))
+    assert_includes rooms(:watercooler).reload.users, bot
+
+    assert_difference -> { Rooms::Direct.count }, +1 do
+      post rooms_directs_url, params: { user_ids: [ bot.id ] }
+    end
+    direct_room = Rooms::Direct.order(:id).last
+    assert_includes direct_room.users, bot
+  end
+end
