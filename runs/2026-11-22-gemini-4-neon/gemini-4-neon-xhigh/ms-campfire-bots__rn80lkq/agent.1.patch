diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..ddae268
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,61 @@
+class BotsController < ApplicationController
+  before_action :no_store, only: %i[ index edit ]
+  before_action :set_bot, :ensure_can_administer, only: %i[ edit update destroy ]
+
+  def index
+    @bots = accessible_bots.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = User.new(role: :bot)
+  end
+
+  def create
+    @bot = User.new(bot_params.merge(role: :bot, creator: Current.user))
+
+    if @bot.save
+      redirect_to bots_url, notice: "✓"
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, notice: "✓"
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url, notice: "✓"
+  end
+
+  private
+    def accessible_bots
+      if Current.user.administrator?
+        User.active.bot
+      else
+        User.active.bot.where(creator: Current.user)
+      end
+    end
+
+    def set_bot
+      @bot = User.active.bot.find(params[:id])
+    end
+
+    def ensure_can_administer
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar).tap do |permitted|
+        permitted.delete(:avatar) if permitted[:avatar].blank?
+      end
+    end
+end
diff --git a/app/controllers/messages/by_bots_controller.rb b/app/controllers/messages/by_bots_controller.rb
new file mode 100644
index 0000000..7e72ec7
--- /dev/null
+++ b/app/controllers/messages/by_bots_controller.rb
@@ -0,0 +1,60 @@
+class Messages::ByBotsController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :authenticate_bot, :set_room
+
+  def set_request!(request)
+    unless request.media_type == "multipart/form-data"
+      request.set_header("action_dispatch.request.request_parameters", {})
+    end
+    super
+  end
+
+  def create
+    if attachment_uploaded?
+      @message = @room.messages.create_with_attachment!(attachment: params[:attachment], creator: @bot)
+    elsif (body = raw_text_body).present?
+      @message = @room.messages.create!(body: body, creator: @bot)
+    else
+      return head :unprocessable_content
+    end
+
+    @message.broadcast_create
+    head :created, location: message_path(@message)
+  end
+
+  private
+    def allow_browser(*)
+    end
+
+    def authenticate_bot
+      if @bot = User.authenticate_bot(params[:bot_key])
+        Current.user = @bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def set_room
+      if params[:room_id].to_s.match?(/\A\d+\z/)
+        @room = @bot.rooms.find_by(id: params[:room_id])
+      end
+
+      head :not_found unless @room
+    end
+
+    def attachment_uploaded?
+      request.media_type == "multipart/form-data" &&
+        params[:attachment].is_a?(ActionDispatch::Http::UploadedFile)
+    end
+
+    def raw_text_body
+      return if request.media_type == "multipart/form-data"
+
+      body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+      body.valid_encoding? ? body : body.scrub
+    end
+end
