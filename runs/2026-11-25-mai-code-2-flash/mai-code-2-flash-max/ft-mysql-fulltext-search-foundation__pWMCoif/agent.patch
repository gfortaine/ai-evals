+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<div class="pad-inline">
+  <%= form_with url: search_path, method: :get, local: true, class: "flex gap-half center margin-block" do %>
+    <%= search_field_tag :q, @query, placeholder: "Search cards…", class: "input flex-item-grow", autofocus: true %>
+    <%= submit_tag "Search", class: "btn btn--primary" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <section class="cards cards--grid">
+      <div class="cards__list hide-scrollbar">
+        <% @cards.each do |card| %>
+          <%= render "cards/display/preview", card: card, draggable: false, query: @query %>
+        <% end %>
+
+        <% if @cards.empty? %>
+          <div class="blank-slate">No cards match “<%= @query %>”</div>
+        <% end %>
+      </div>
+    </section>
+  <% end %>
+</div>
