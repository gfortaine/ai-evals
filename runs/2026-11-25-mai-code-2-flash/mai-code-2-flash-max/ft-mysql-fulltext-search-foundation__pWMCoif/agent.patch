+def highlight_search(text, query)
+  terms = query.to_s.strip.split(/\s+/).reject(&:blank?)
+  plain_text = text.to_s
+
+  if terms.empty?
+    ERB::Util.html_escape(plain_text).html_safe
+  else
+    terms = terms.sort_by { |term| -term.length }
+    pattern = Regexp.union(terms.map { |term| Regexp.new(Regexp.escape(term), Regexp::IGNORECASE) })
+    highlight_search_segments(plain_text, pattern)
+  end
+end
+
+def search_text_matches?(text, query)
+  terms = query.to_s.strip.split(/\s+/).reject(&:blank?)
+  return false if terms.empty?
+
+  plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+  plain_text = plain_text.gsub(/\s+/, " ").strip
+  terms.any? do |term|
+    Regexp.new(Regexp.escape(term), Regexp::IGNORECASE).match?(plain_text)
+  end
+end
+
+def search_excerpt(text, query, length: 200)
+  plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+  plain_text = plain_text.gsub(/\s+/, " ").strip
+  return plain_text.truncate(length) if plain_text.blank?
+
+  terms = query.to_s.strip.split(/\s+/).reject(&:blank?)
+  if terms.empty?
+    plain_text.truncate(length)
+  else
+    match = nil
+    terms.each do |term|
+      match = Regexp.new(Regexp.escape(term), Regexp::IGNORECASE).match(plain_text)
+      break if match
+    end
+
+    if match
+      start_at = [ match.begin(0) - (length / 4), 0 ].max
+      excerpt = plain_text[start_at, length]
+      excerpt = "...#{excerpt}" if start_at.positive?
+      excerpt = "#{excerpt}..." if start_at + length < plain_text.length
+      excerpt
+    else
+      plain_text.truncate(length)
+    end
+  end
+end
+
+def highlight_search_segments(text, pattern)
+  escaped = +""
+  offset = 0
+
+  text.to_enum(:scan, pattern).each do
+    match = Regexp.last_match
+    escaped << ERB::Util.html_escape(text[offset...match.begin(0)].to_s)
+    escaped << "<mark>#{ERB::Util.html_escape(match[0])}</mark>"
+    offset = match.end(0)
+  end
+
+  escaped << ERB::Util.html_escape(text[offset..].to_s)
+  escaped.html_safe
+end
+
