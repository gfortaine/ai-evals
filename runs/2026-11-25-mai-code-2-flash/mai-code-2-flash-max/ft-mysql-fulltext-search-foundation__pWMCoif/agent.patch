+class SearchesController < ApplicationController
+  def index
+    @query = (params[:q].presence || params[:term].presence).to_s.strip
+
+    @cards = if @query.present?
+      search_cards
+    else
+      Current.user.accessible_cards.published.none
+    end
+  end
+
+  private
+    def search_cards
+      Current.user.accessible_cards
+        .published
+        .where(account: Current.account)
+        .search(@query)
+        .preload(comments: :rich_text_body)
+        .preloaded
+    end
+end
