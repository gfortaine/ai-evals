diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..b73f594
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "search page finds cards by title" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "article.card", id: dom_id(cards(:logo), :article)
+    assert_select "article.card mark", text: "logo"
+  end
+
+  test "search page finds cards by description" do
+    card = cards(:logo)
+    card.update!(description: "Refresh the purple launch checklist")
+
+    get search_path(q: "purple launch")
+
+    assert_response :success
+    assert_select "article.card", id: dom_id(card, :article)
+    assert_select "article.card", text: /Description:/
+    assert_select "article.card mark", text: /purple|launch/
+  end
+
+  test "search page finds cards by comment body" do
+    comment = comments(:logo_agreement_kevin)
+
+    with_current_user(:kevin) do
+      comment.update!(body: "Please confirm the observability plan")
+    end
+
+    get search_path(q: "observability")
+
+    assert_response :success
+    assert_select "article.card", id: dom_id(comment.card, :article)
+    assert_select "article.card", text: /Comment:/
+    assert_select "article.card mark", text: "observability"
+  end
+
+  test "search terms can match different parts of a card" do
+    card = cards(:logo)
+
+    card.update_column(:title, "Purple launch")
+    with_current_user(:kevin) do
+      card.update!(description: "Observability checklist")
+    end
+
+    get search_path(q: "purple observability")
+
+    assert_response :success
+    assert_select "article.card", id: dom_id(card, :article)
+  end
+
+  test "searches are newest first" do
+    older = cards(:layout)
+    newer = cards(:logo)
+    older.update_columns(title: "Shared horizon older", created_at: 2.days.ago)
+    newer.update_columns(title: "Shared horizon newer", created_at: 1.day.ago)
+
+    get search_path(q: "horizon")
+
+    assert_response :success
+    articles = css_select("article.card")
+    assert_equal [ dom_id(newer, :article), dom_id(older, :article) ], articles.map { |article| article["id"] }
+  end
+
+  test "draft cards and their comments do not appear" do
+    board = boards(:writebook)
+
+    with_current_user(:kevin) do
+      draft = board.cards.create!(creator: users(:kevin), status: :drafted, title: "Hidden draft")
+      draft.update!(description: "Hidden draft description")
+    end
+
+    get search_path(q: "hidden draft")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "cards on inaccessible boards do not appear" do
+    board = boards(:private)
+    board.accesses.revoke_from users(:kevin)
+
+    card = nil
+    with_current_user(:kevin) do
+      card = board.cards.create!(creator: users(:kevin), status: :published, title: "Private telescopes")
+    end
+
+    get search_path(q: "telescopes")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_not_includes css_select("article.card").map { |article| article["id"] }, dom_id(card, :article)
+  end
+
+  test "highlighted matches escape HTML" do
+    card = cards(:logo)
+    card.update_column(:title, "<script>alert('x')</script> logo")
+
+    get search_path(q: "script")
+
+    assert_response :success
+    assert_select "mark", text: "script"
+    card_html = css_select("article.card").first.to_html
+    assert_includes card_html, "&lt;script&gt;"
+  end
+end
