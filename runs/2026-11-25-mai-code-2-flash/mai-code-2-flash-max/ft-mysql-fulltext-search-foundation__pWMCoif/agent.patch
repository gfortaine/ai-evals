@@ -25,6 +25,45 @@ class Card < ApplicationRecord
   scope :with_users,              -> { preload(creator: [ :avatar_attachment, :account ], assignees: [ :avatar_attachment, :account ]) }
   scope :preloaded,               -> { with_users.preload(:column, :tags, :steps, :closure, :goldness, :activity_spike, :image_attachment, reactions: :reacter, board: [ :entropy, :columns ], not_now: [ :user ]).with_rich_text_description_and_embeds }
 
+scope :search, ->(query) do
+  terms = query.to_s.strip.split(/\s+/)
+
+  if terms.empty?
+    none
+  else
+    relation = published
+      .joins(<<~SQL.squish)
+        LEFT JOIN action_text_rich_texts AS search_card_descriptions
+          ON search_card_descriptions.record_type = 'Card'
+          AND search_card_descriptions.record_id = cards.id
+          AND search_card_descriptions.name = 'description'
+          AND search_card_descriptions.account_id = cards.account_id
+      SQL
+      .joins(<<~SQL.squish)
+        LEFT JOIN comments AS search_comments
+          ON search_comments.card_id = cards.id
+          AND search_comments.account_id = cards.account_id
+      SQL
+      .joins(<<~SQL.squish)
+        LEFT JOIN action_text_rich_texts AS search_comment_bodies
+          ON search_comment_bodies.record_type = 'Comment'
+          AND search_comment_bodies.record_id = search_comments.id
+          AND search_comment_bodies.name = 'body'
+          AND search_comment_bodies.account_id = cards.account_id
+      SQL
+
+    terms.each do |term|
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+      relation = relation.where(
+        "cards.title LIKE :term OR search_card_descriptions.body LIKE :term OR search_comment_bodies.body LIKE :term",
+        term: pattern
+      )
+    end
+
+    relation.distinct.reverse_chronologically
+  end
+end
+
