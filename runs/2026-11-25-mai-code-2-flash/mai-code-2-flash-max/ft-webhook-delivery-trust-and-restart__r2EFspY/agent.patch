   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  class << self
+    def cleanup
+      expired.delete_all
+    end
+  end
+
+  def deliver_later
+    if pending?
+      Webhook::DeliveryJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    deliver_now
+  end
+
+  def deliver_now
+    return unless webhook.active?
+
+    delivery_started = with_lock do
+      if pending?
+        update!(state: :in_progress)
+        true
+      else
+        false
+      end
+    end
+
+    return unless delivery_started
+
+    body = payload
+    timestamp = event.created_at.utc.iso8601
+    headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body),
+      "X-Webhook-Timestamp" => timestamp
+    }
+
+    update!(request: { headers: headers })
+
+    begin
+      response = post(body, headers)
+      code = response.code.to_i
+
+      update!(state: :completed, response: { code: code })
+
+      if code.between?(200, 299)
+        webhook.delinquency_tracker&.record_success
+      else
+        webhook.delinquency_tracker&.record_failure
+      end
+    rescue StandardError
+      update!(state: :errored, response: { error: DESTINATION_UNREACHABLE })
+      webhook.delinquency_tracker&.record_failure
+    end
+  end
+
+  def payload
+    if webhook.for_slack?
+      { text: event_description }.to_json
+    elsif webhook.for_campfire?
+      { body: event_description }.to_json
+    elsif webhook.for_basecamp?
+      { content: event_description }.to_json
+    else
+      ApplicationController.render(
+        template: "webhooks/event",
+        formats: [ :json ],
+        assigns: { event: event }
+      )
+    end
+  end
+
+  alias_method :body, :payload
+  alias_method :payload_body, :payload
+  alias_method :request_body, :payload
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +109,32 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    if completed? && response.present?
+      response[:error].blank? && response[:code].to_s.to_i.between?(200, 299)
+    else
+      false
+    end
   end
+
+  private
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+
+      Net::HTTP.start(
+        uri.host,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: 10,
+        read_timeout: 10
+      ) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri)
+        headers.each { |name, value| request[name] = value }
+        request.body = body
+        http.request(request)
+      end
+    end
+
+    def event_description
+      event.description_for(event.creator).to_plain_text.to_s
+    end
 end
