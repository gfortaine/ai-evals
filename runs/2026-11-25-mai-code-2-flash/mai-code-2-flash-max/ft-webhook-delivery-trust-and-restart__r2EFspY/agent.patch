+++ b/app/models/event/relaying.rb
@@ -0,0 +1,25 @@
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Webhook::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    board.webhooks.active.filter_map do |webhook|
+      if webhook.subscribed_to?(action)
+        delivery_created = false
+        delivery = webhook.deliveries.find_or_create_by!(event: self) do
+          delivery_created = true
+        end
+
+        delivery.deliver_later if delivery_created
+        delivery
+      end
+    end
+  end
+end
