+  end
+
+  def model_dir
+    "files"
+  end
+
+  def export_to(zip)
+    raise ArgumentError, "No ZIP writer given" unless zip
+
+    records.find_each do |blob|
+      path = file_path_for(blob)
+      zip.add_file(path, compress: false) do |sink|
+        blob.open do |file|
+          IO.copy_stream(file, sink)
+        end
+      end
     end
+  end
+
+  def import_from(reader, account:, id_map: {}, blob_map: {}, created_blobs: [], **options)
+    file_entries = reader.glob("files/*")
+
+    blob_map.each do |source_key, blob|
+      next unless source_key.is_a?(String)
 
+      entry_path = file_entries.find do |entry|
+        entry == "files/#{source_key}" || entry.start_with?("files/#{source_key}/")
+      end
+
+      if entry_path
+        reader.open_entry(entry_path) do |stream|
+          blob.upload(stream)
+        end
+
+        source_attributes = blob_source_attributes(reader, source_key)
+        if source_attributes
+          blob.update!(
+            byte_size: source_attributes["byte_size"] || blob.byte_size,
+            checksum: source_attributes["checksum"] || blob.checksum,
+            metadata: source_attributes["metadata"] || blob.metadata
+          )
+        end
+      end
+    end
+
+    missing_keys = blob_map.keys.grep(String).uniq.reject do |source_key|
+      file_entries.any? do |entry|
+        entry == "files/#{source_key}" || entry.start_with?("files/#{source_key}/")
+      end
+    end
+
+    if missing_keys.any?
+      raise ArgumentError, "Missing file data for #{missing_keys.first}"
+    end
+  end
+
+  private
     def excluded_blob_ids
       ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
     end
 
+    def file_path_for(blob)
+      filename = blob.filename.to_s
+      filename = File.basename(filename) if filename.present?
+      filename = "file" if filename.blank?
+      "files/#{blob.key}/#{filename}"
+    end
+
+    def blob_source_attributes(reader, source_key)
+      reader.json_records_for("active_storage_blobs") do |attributes|
+        return attributes if attributes["key"] == source_key
+      end
+
+      nil
+    rescue ArgumentError
+      nil
+    end
 end
