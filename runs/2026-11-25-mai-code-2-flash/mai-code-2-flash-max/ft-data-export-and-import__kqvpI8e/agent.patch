diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..dc87eb2
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,86 @@
+require "zip"
+
+class ZipFile::Reader
+  attr_reader :path
+
+  def initialize(path)
+    @path = if path.respond_to?(:path)
+      path.path
+    else
+      path.to_s
+    end
+  end
+
+  def self.open(path)
+    reader = new(path)
+    reader.open { yield reader if block_given? }
+  end
+
+  def open
+    raise ArgumentError, "No block given" unless block_given?
+
+    @archive = Zip::File.open(path)
+    yield self
+  ensure
+    close
+  end
+
+  def close
+    @archive&.close
+  end
+
+  def entries
+    @archive.entries.reject(&:directory?).map(&:name)
+  end
+
+  def glob(pattern)
+    entries.select { |entry| File.fnmatch(pattern, entry) }.sort
+  end
+
+  def exists?(path)
+    entries.include?(path)
+  end
+
+  def read(path)
+    entry = @archive.find_entry(path)
+    raise ArgumentError, "Missing ZIP entry: #{path}" unless entry
+
+    entry.get_input_stream do |stream|
+      stream.read
+    end
+  end
+
+  def open_entry(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    entry = @archive.find_entry(path)
+    raise ArgumentError, "Missing ZIP entry: #{path}" unless entry
+
+    entry.get_input_stream do |stream|
+      yield stream
+    end
+  end
+
+  def read_json(path)
+    JSON.parse(read(path))
+  end
+
+  def json_records_for(directory)
+    paths = glob("#{directory}/*.json")
+    if paths.empty?
+      aggregate = "#{directory}.json"
+      paths = [ aggregate ] if exists?(aggregate)
+    end
+
+    paths.each do |json_path|
+      parsed = read_json(json_path)
+      if parsed.is_a?(Array)
+        parsed.each { |record| yield record }
+      elsif parsed.is_a?(Hash)
+        yield parsed
+      else
+        raise ArgumentError, "Invalid JSON in #{json_path}"
+      end
+    end
+  end
+end
