+++ b/app/models/export.rb
@@ -0,0 +1,241 @@
+class Export < ApplicationRecord
+  belongs_to :account, optional: true
+  belongs_to :user, optional: true
+  belongs_to :identity, optional: true
+
+  has_one_attached :file
+
+  after_create_commit :export_later
+
+  validates :kind, inclusion: { in: %w[ account cards ] }
+
+  scope :pending, -> { where(status: "pending") }
+  scope :processing, -> { where(status: "processing") }
+  scope :ready, -> { where(status: "ready") }
+  scope :failed, -> { where(status: "failed") }
+
+  def requested_by
+    user
+  end
+
+  def requested_by=(user)
+    self.user = user
+  end
+
+  def zip
+    file
+  end
+
+  def zip=(attachable)
+    file.attach(attachable)
+  end
+
+  def archive
+    file
+  end
+
+  def owner
+    requested_by
+  end
+
+  def owner=(owner)
+    self.requested_by = owner
+  end
+
+  def account_export?
+    kind == "account"
+  end
+
+  def cards_export?
+    kind == "cards"
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def processing?
+    status == "processing"
+  end
+
+  def ready?
+    status == "ready"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def completed?
+    ready?
+  end
+
+  def succeeded?
+    ready?
+  end
+
+  def complete?
+    ready?
+  end
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+
+  def export_now(deliver: true)
+    update!(status: "processing", error: nil)
+
+    target_account = account || user&.account
+    raise ArgumentError, "No account is available for this export" unless target_account
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account_export?
+        Account::DataTransfer::Manifest.new(target_account).export_to(zip)
+      else
+        export_cards_to(zip)
+      end
+    end
+
+    update!(status: "ready", ready_at: Time.current, error: nil)
+    ExportMailer.ready(self).deliver_later if deliver && recipient
+    true
+  rescue => error
+    update!(status: "failed", error: error.message)
+    ExportMailer.failed(self).deliver_later if deliver && recipient
+    false
+  end
+
+  def fail!(error)
+    update!(status: "failed", error: error.message)
+    ExportMailer.failed(self).deliver_later if recipient
+  end
+
+  def recipient
+    identity || requested_by&.identity
+  end
+
+  private
+    def filename
+      if account_export?
+        "#{account.name.parameterize.presence || "fizzy-account"}-export.zip"
+      else
+        "#{user.name.parameterize.presence || "fizzy-cards"}-cards.zip"
+      end
+    end
+
+    def export_cards_to(zip)
+      user.accessible_cards.includes(:board, :column, :creator, :tags, comments: [ :creator, :card ]).find_each do |card|
+        comments = card.comments.chronologically.to_a
+        attachments = attachments_for_card(card, comments)
+
+        attachments.each do |attachment|
+          blob = attachment.blob
+          zip.add_file(file_path_for(blob), compress: false) do |sink|
+            blob.open do |file|
+              IO.copy_stream(file, sink)
+            end
+          end
+        end
+
+        card_hash = card_attributes(card, comments, attachments)
+        zip.add_file("cards/#{card.number}.json", card_hash.to_json)
+      end
+    end
+
+    def card_attributes(card, comments, attachments)
+      {
+        "id" => card.id,
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "description" => card.description.to_plain_text,
+        "description_html" => card.description.to_s,
+        "due_on" => card.due_on,
+        "created_at" => card.created_at,
+        "updated_at" => card.updated_at,
+        "last_active_at" => card.last_active_at,
+        "board" => {
+          "id" => card.board.id,
+          "name" => card.board.name
+        },
+        "column" => card.column && {
+          "id" => card.column.id,
+          "name" => card.column.name
+        },
+        "creator" => person_attributes(card.creator),
+        "assignees" => card.assignees.map { |person| person_attributes(person) },
+        "tags" => card.tags.map(&:title).sort,
+        "steps" => card.steps.map { |step| { "id" => step.id, "content" => step.content, "completed" => step.completed } },
+        "comments" => comments.map { |comment| comment_attributes(comment) },
+        "attachments" => attachment_attributes(attachments)
+      }
+    end
+
+    def comment_attributes(comment)
+      {
+        "id" => comment.id,
+        "created_at" => comment.created_at,
+        "updated_at" => comment.updated_at,
+        "body" => comment.body.to_plain_text,
+        "body_html" => comment.body.to_s,
+        "creator" => person_attributes(comment.creator),
+        "attachments" => attachment_attributes(attachments_for_comment(comment))
+      }
+    end
+
+    def person_attributes(person)
+      {
+        "id" => person.id,
+        "name" => person.name,
+        "role" => person.role,
+        "verified" => person.verified?
+      }
+    end
+
+    def attachments_for_card(card, comments)
+      attachments = ActiveStorage::Attachment.where(record_type: "Card", record_id: card.id).includes(:blob).to_a
+      attachments.concat ActiveStorage::Attachment.where(record_type: "Comment", record_id: comments.map(&:id)).includes(:blob).to_a
+
+      rich_text_ids = [ card.description&.id ]
+      rich_text_ids.concat comments.filter_map { |comment| comment.body&.id }
+      rich_text_ids.compact!
+
+      if rich_text_ids.any?
+        attachments.concat ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_ids).includes(:blob).to_a
+      end
+
+      attachments.uniq(&:blob_id)
+    end
+
+    def attachments_for_comment(comment)
+      direct = ActiveStorage::Attachment.where(record_type: "Comment", record_id: comment.id).includes(:blob).to_a
+      rich_text_id = comment.body&.id
+      embeds = if rich_text_id
+        ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_id).includes(:blob).to_a
+      else
+        []
+      end
+
+      (direct + embeds).uniq(&:blob_id)
+    end
+
+    def attachment_attributes(attachments)
+      attachments.map do |attachment|
+        blob = attachment.blob
+        {
+          "id" => blob.id,
+          "filename" => blob.filename.to_s,
+          "content_type" => blob.content_type,
+          "byte_size" => blob.byte_size,
+          "path" => file_path_for(blob)
+        }
+      end
+    end
+
+    def file_path_for(blob)
+      filename = blob.filename.to_s
+      filename = File.basename(filename) if filename.present?
+      filename = "file" if filename.blank?
+      "files/#{blob.key}/#{filename}"
+    end
+end
