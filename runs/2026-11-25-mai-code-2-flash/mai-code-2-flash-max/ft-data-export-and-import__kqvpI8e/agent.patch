@@ -0,0 +1,132 @@
+class Import < ApplicationRecord
+  belongs_to :identity, optional: true
+  belongs_to :account, optional: true
+
+  has_one_attached :file
+
+  after_create_commit :import_later
+
+  scope :pending, -> { where(status: "pending") }
+  scope :processing, -> { where(status: "processing") }
+  scope :completed, -> { where(status: "completed") }
+  scope :failed, -> { where(status: "failed") }
+
+  def archive
+    file
+  end
+
+  def archive=(attachable)
+    file.attach(attachable)
+  end
+
+  def zip
+    file
+  end
+
+  def zip=(attachable)
+    file.attach(attachable)
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def processing?
+    status == "processing"
+  end
+
+  def completed?
+    status == "completed"
+  end
+
+  def complete?
+    completed?
+  end
+
+  def succeeded?
+    completed?
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def import_later
+    ImportJob.perform_later(self)
+  end
+
+  def import_now
+    update!(status: "processing", error: nil)
+    raise ArgumentError, "No account ZIP was provided" unless file.attached?
+
+    account_for_import = nil
+    blob_map = {}
+    created_blobs = []
+
+    file.open do |tempfile|
+      ZipFile::Reader.open(tempfile.path) do |reader|
+        source_account = read_source_account(reader)
+        raise ArgumentError, "This ZIP is not an account export" unless source_account
+
+        Account.transaction do
+          account_for_import = Account.create!(name: source_account["name"].presence || "Imported Account")
+
+          id_map = {}
+          if source_account["id"].present?
+            id_map[source_account["id"]] = account_for_import.id
+          end
+
+          manifest = Account::DataTransfer::Manifest.new(account_for_import)
+          Current.with_account(account_for_import) do
+            manifest.import_from(
+              reader,
+              account: account_for_import,
+              id_map: id_map,
+              owner_identity: identity,
+              blob_map: blob_map,
+              created_blobs: created_blobs
+            )
+          end
+
+          account_for_import.reload
+        end
+      end
+    end
+
+    update!(status: "completed", account: account_for_import, completed_at: Time.current, error: nil)
+    ImportMailer.completed(self).deliver_later
+    account_for_import
+  rescue => error
+    created_blobs&.each do |blob|
+      begin
+        blob.purge
+      rescue
+        nil
+      end
+    end
+
+    update!(status: "failed", error: error.message, account: nil)
+    ImportMailer.failed(self).deliver_later
+    nil
+  end
+
+  def fail!(error)
+    update!(status: "failed", error: error.message, account: nil)
+    ImportMailer.failed(self).deliver_later
+  end
+
+  private
+    def read_source_account(reader)
+      account = nil
+
+      reader.json_records_for("accounts") do |attributes|
+        account ||= attributes
+      end
+
+      account
+    rescue ArgumentError
+      if reader.exists?("account.json")
+        reader.read_json("account.json")
+      end
+    end
+end
