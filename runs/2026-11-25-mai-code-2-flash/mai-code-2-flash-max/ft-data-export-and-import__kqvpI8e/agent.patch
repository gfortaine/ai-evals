diff --git a/test/mailers/export_import_mailer_test.rb b/test/mailers/export_import_mailer_test.rb
new file mode 100644
index 0000000..b762522
--- /dev/null
+++ b/test/mailers/export_import_mailer_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+require "stringio"
+
+class ExportImportMailerTest < ActionMailer::TestCase
+  test "export ready email includes a download link" do
+    export = Export.create!(kind: "account", account: accounts(:"37s"), user: users(:kevin))
+    export.file.attach(io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip")
+
+    email = ExportMailer.ready(export)
+
+    assert_equal [ users(:kevin).identity.email_address ], email.to
+    assert_match /24 hours/, email.body.encoded
+    assert_match /Download/, email.body.encoded
+  end
+
+  test "import completed email goes to the requesting identity" do
+    account = accounts(:"37s")
+    import = Import.create!(identity: identities(:david), account: account)
+
+    email = ImportMailer.completed(import)
+
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_match /complete/, email.subject.downcase
+  end
+
+  test "import failed email includes the reason" do
+    import = Import.create!(identity: identities(:david), status: "failed", error: "Missing account JSON")
+
+    email = ImportMailer.failed(import)
+
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_match /Missing account JSON/, email.body.encoded
+  end
+end
diff --git a/test/models/data_export_import_test.rb b/test/models/data_export_import_test.rb
new file mode 100644
index 0000000..e670782
--- /dev/null
+++ b/test/models/data_export_import_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+require "stringio"
+
+class DataExportImportTest < ActiveSupport::TestCase
+  test "account export creates a ZIP with account records" do
+    export = Export.create!(kind: "account", account: accounts(:"37s"), user: users(:kevin))
+
+    result = export.export_now(deliver: false)
+    assert result, export.reload.error
+    assert export.reload.ready?
+    assert export.file.attached?
+
+    export.file.open do |file|
+      ZipFile::Reader.open(file.path) do |reader|
+        assert reader.exists?("accounts/#{accounts(:"37s").id}.json")
+        assert reader.exists?("cards/#{cards(:logo).id}.json")
+        assert reader.entries.include?("users/#{users(:david).id}.json")
+      end
+    end
+  end
+
+  test "card export includes JSON comments and an attached file" do
+    card = cards(:logo)
+    card.image.attach(
+      io: File.open(Rails.root.join("test/fixtures/files/moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    export = Export.create!(kind: "cards", account: card.account, user: users(:david))
+
+    result = export.export_now(deliver: false)
+    assert result, export.reload.error
+
+    export.file.open do |file|
+      ZipFile::Reader.open(file.path) do |reader|
+        card_json = reader.read_json("cards/#{card.number}.json")
+        assert_equal card.title, card_json["title"]
+        assert card_json["comments"].is_a?(Array)
+        assert card_json["attachments"].any? { |attachment| attachment["filename"] == "moon.jpg" }
+        assert reader.entries.any? { |entry| entry.end_with?("moon.jpg") }
+      end
+    end
+  end
+
+  test "account import creates a complete new account" do
+    source_account = accounts(:"37s")
+    cards(:logo).image.attach(
+      io: File.open(Rails.root.join("test/fixtures/files/moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    export = Export.create!(kind: "account", account: source_account, user: users(:kevin))
+    assert export.export_now(deliver: false), export.reload.error
+
+    import = Import.new(identity: identities(:david))
+    import.file.attach(export.file.blob)
+    import.save!
+
+    account_count = Account.count
+    card_count = Card.where(account: source_account).count
+
+    imported_account = import.import_now
+
+    assert import.reload.completed?, import.reload.error
+    assert_not_nil imported_account
+    assert_equal account_count + 1, Account.count
+    assert_equal source_account.name, imported_account.name
+    assert_equal card_count, imported_account.cards.count
+    assert imported_account.users.where(role: :owner).exists?
+    assert imported_account.users.where(role: :system).exists?
+
+    imported_card = imported_account.cards.find_by!(number: cards(:logo).number)
+    assert imported_card.image.attached?
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+  end
+
+  test "failed import leaves no account behind" do
+    import = Import.new(identity: identities(:david))
+    import.file.attach(
+      io: StringIO.new("not a zip"),
+      filename: "not-an-account.zip",
+      content_type: "application/zip"
+    )
+    import.save!
+
+    account_count = Account.count
+
+    result = import.import_now
+
+    assert_nil result
+    assert import.reload.failed?, import.reload.error
+    assert import.error.present?
+    assert_equal account_count, Account.count
+  end
+end
