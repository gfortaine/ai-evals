index 0000000..91db588
--- /dev/null
+++ b/app/mailers/export_mailer.rb
@@ -0,0 +1,26 @@
+class ExportMailer < ApplicationMailer
+  def ready(export)
+    @export = export
+    @recipient = export.recipient
+    @download_url = if @export.file.attached?
+      rails_blob_url(@export.file.blob, disposition: :attachment, expires_in: 24.hours)
+    end
+
+    mail(
+      to: @recipient&.email_address,
+      subject: @export.account_export? ? "Your Fizzy account export is ready" : "Your Fizzy cards export is ready"
+    )
+  end
+
+  def failed(export)
+    @export = export
+    @recipient = export.recipient
+
+    mail(
+      to: @recipient&.email_address,
+      subject: "Your Fizzy export could not be completed"
+    )
+  end
+
+  alias_method :ready_for_download, :ready
+end
