diff --git a/app/jobs/storage_usage/update_all_job.rb b/app/jobs/storage_usage/update_all_job.rb
new file mode 100644
index 0000000..f40ed46
--- /dev/null
+++ b/app/jobs/storage_usage/update_all_job.rb
@@ -0,0 +1,21 @@
+class StorageUsage::UpdateAllJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform(batch_size: 500)
+    step :boards do |step|
+      Board.find_each(start: step.cursor, batch_size: batch_size) do |board|
+        board.update_bytes_used_now
+        step.advance! from: board.id
+      end
+    end
+
+    step :accounts do |step|
+      Account.find_each(start: step.cursor, batch_size: batch_size) do |account|
+        account.update_bytes_used_now
+        step.advance! from: account.id
+      end
+    end
+  end
+end
