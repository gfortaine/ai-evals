diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
new file mode 100644
index 0000000..e2ebe42
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,121 @@
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    if persisted?
+      ApplicationRecord.connected_to(role: :writing) do
+        self.class.where(id: id).pick(:bytes_used).to_i
+      end
+    else
+      self[:bytes_used].to_i
+    end
+  end
+
+  def calculate_bytes_used
+    account_id = storage_usage_account_id
+    return 0 unless account_id
+
+    ApplicationRecord.connected_to(role: :writing) do
+      relation = ActiveStorage::Blob.where(id: counted_blob_ids)
+      relation.sum(:byte_size).to_i
+    end
+  end
+
+  def update_bytes_used_now
+    bytes = calculate_bytes_used
+    update_column(:bytes_used, bytes)
+    bytes
+  end
+
+  def update_bytes_used_later
+    if is_a?(Account)
+      Account::UpdateBytesUsedJob.perform_later(self)
+    elsif is_a?(Board)
+      Board::UpdateBytesUsedJob.perform_later(self)
+    end
+  end
+
+  def calculate_bytes_used_now
+    update_bytes_used_now
+  end
+
+  def calculate_bytes_used_later
+    update_bytes_used_later
+  end
+
+  private
+    def counted_blob_ids
+      if is_a?(Account)
+        account_counted_blob_ids
+      else
+        board_counted_blob_ids
+      end
+    end
+
+    def account_counted_blob_ids
+      board_ids = Board.where(account_id: id).select(:id)
+      card_ids = Card.where(board_id: board_ids).select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      board_rich_text_ids = ActionText::RichText
+        .where(record_type: "Board", name: "public_description", record_id: board_ids)
+        .select(:id)
+      card_rich_text_ids = ActionText::RichText
+        .where(record_type: "Card", name: "description", record_id: card_ids)
+        .select(:id)
+      comment_rich_text_ids = ActionText::RichText
+        .where(record_type: "Comment", name: "body", record_id: comment_ids)
+        .select(:id)
+
+      rich_text_ids = board_rich_text_ids
+        .or(card_rich_text_ids)
+        .or(comment_rich_text_ids)
+
+      card_images = ActiveStorage::Attachment
+        .where(record_type: "Card", name: "image", record_id: card_ids)
+      rich_text_embeds = ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+
+      card_images
+        .or(rich_text_embeds)
+        .select(:blob_id)
+        .distinct
+    end
+
+    def board_counted_blob_ids
+      card_ids = Card.where(board_id: id).select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      board_rich_text_ids = ActionText::RichText
+        .where(record_type: "Board", name: "public_description", record_id: id)
+        .select(:id)
+      card_rich_text_ids = ActionText::RichText
+        .where(record_type: "Card", name: "description", record_id: card_ids)
+        .select(:id)
+      comment_rich_text_ids = ActionText::RichText
+        .where(record_type: "Comment", name: "body", record_id: comment_ids)
+        .select(:id)
+
+      rich_text_ids = board_rich_text_ids
+        .or(card_rich_text_ids)
+        .or(comment_rich_text_ids)
+
+      card_images = ActiveStorage::Attachment
+        .where(record_type: "Card", name: "image", record_id: card_ids)
+      rich_text_embeds = ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+
+      card_images
+        .or(rich_text_embeds)
+        .select(:blob_id)
+        .distinct
+    end
+
+    def storage_usage_account_id
+      if is_a?(Account)
+        id
+      else
+        account_id
+      end
+    end
+end
diff --git a/app/models/concerns/storage_usage_callbacks.rb b/app/models/concerns/storage_usage_callbacks.rb
new file mode 100644
index 0000000..1f093d5
--- /dev/null
+++ b/app/models/concerns/storage_usage_callbacks.rb
@@ -0,0 +1,116 @@
+module StorageUsageCallbacks
+  def self.update_later_for(record, account: nil)
+    board = case record
+    when Board
+      record
+    when Card
+      record.board
+    when Comment
+      record.board
+    end
+
+    case record
+    when Board
+      account = record.account
+    when Card
+      account = board&.account
+    when Comment
+      account = board&.account
+    end
+
+    board&.update_bytes_used_later
+    account&.update_bytes_used_later
+  end
+
+  module ActionTextRichText
+    extend ActiveSupport::Concern
+
+    included do
+      before_validation :reconcile_embeds
+    end
+
+    private
+      def reconcile_embeds
+        attachables = body&.attachables&.grep(ActiveStorage::Blob) || []
+        self.embeds = attachables.uniq
+      end
+  end
+
+  module ActiveStorageAttachment
+    extend ActiveSupport::Concern
+
+    included do
+      after_create :update_storage_usage_later
+      after_destroy :update_storage_usage_later
+    end
+
+    def update_storage_usage_later
+      relevant_record = if record_type == "Card" && name == "image"
+        record || Card.find_by(id: record_id)
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        rich_text = record || ActionText::RichText.find_by(id: record_id)
+
+        if rich_text
+          case rich_text.record
+          when Board
+            rich_text.record if rich_text.name == "public_description"
+          when Card
+            rich_text.record if rich_text.name == "description"
+          when Comment
+            rich_text.record if rich_text.name == "body"
+          end
+        end
+      end
+
+      if relevant_record
+        account = Account.find_by(id: account_id)
+        StorageUsageCallbacks.update_later_for(relevant_record, account: account)
+      end
+    end
+  end
+
+  module ActiveStorageAttachmentMethods
+    def purge
+      result = super
+      update_storage_usage_later
+      result
+    end
+
+    def purge_later
+      result = super
+      update_storage_usage_later
+      result
+    end
+  end
+
+  module DetachOne
+    def detach
+      attachment = self.attachment
+      result = super
+      attachment&.update_storage_usage_later
+      result
+    end
+  end
+
+  module ActiveStorageBlob
+    extend ActiveSupport::Concern
+
+    included do
+      after_update_commit :update_storage_usage_later, if: :saved_change_to_byte_size?
+    end
+
+    private
+      def update_storage_usage_later
+        attachments.find_each(&:update_storage_usage_later)
+      end
+  end
+
+  module DetachMany
+    def detach
+      attachment_records = attachments.to_a
+      result = super
+      attachment_records.each(&:update_storage_usage_later)
+      result
+    end
+  end
+end
