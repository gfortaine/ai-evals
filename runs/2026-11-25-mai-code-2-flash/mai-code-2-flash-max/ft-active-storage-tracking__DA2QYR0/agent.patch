diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..1f1332f
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "board and account count card images" do
+    account = accounts("37s")
+    board = boards("writebook")
+    card = cards("logo")
+    blob = create_blob(bytes: 1024)
+
+    card.image.attach(blob)
+
+    assert_equal 1024, board.calculate_bytes_used
+    assert_equal 1024, account.calculate_bytes_used
+
+    board.update_bytes_used_now
+    account.update_bytes_used_now
+
+    assert_equal 1024, board.bytes_used
+    assert_equal 1024, account.bytes_used
+  end
+
+  test "board and account count rich text embeds once" do
+    account = accounts("37s")
+    board = boards("writebook")
+    card = cards("logo")
+    comment = comments("logo_1")
+    blob = create_blob(bytes: 2048)
+
+    board.update!(public_description: rich_text_with(blob))
+    card.update!(description: rich_text_with(blob))
+    comment.update!(body: rich_text_with(blob))
+
+    board.update_bytes_used_now
+    account.update_bytes_used_now
+
+    assert_equal 2048, board.bytes_used
+    assert_equal 2048, account.bytes_used
+  end
+
+  test "account usage is unique across boards" do
+    account = accounts("37s")
+    first_board = boards("writebook")
+    second_board = boards("private")
+    first_card = cards("logo")
+    second_card = cards("buy_domain")
+    second_card.update!(board: second_board)
+    blob = create_blob(bytes: 4096)
+
+    first_card.image.attach(blob)
+    second_card.update!(description: rich_text_with(blob))
+
+    first_board.update_bytes_used_now
+    second_board.update_bytes_used_now
+    account.update_bytes_used_now
+
+    assert_equal 4096, first_board.bytes_used
+    assert_equal 4096, second_board.bytes_used
+    assert_equal 4096, account.bytes_used
+  end
+
+  test "removing counted content lowers usage" do
+    account = accounts("37s")
+    board = boards("writebook")
+    card = cards("logo")
+    blob = create_blob(bytes: 512)
+
+    card.image.attach(blob)
+    board.update_bytes_used_now
+    account.update_bytes_used_now
+
+    card.image.detach
+    board.update_bytes_used_now
+    account.update_bytes_used_now
+
+    assert_equal 0, board.bytes_used
+    assert_equal 0, account.bytes_used
+  end
+
+  test "removing a rich text embed lowers usage" do
+    account = accounts("37s")
+  board = boards("writebook")
+  card = cards("logo")
+  blob = create_blob(bytes: 1024)
+
+  card.update!(description: rich_text_with(blob))
+  board.update_bytes_used_now
+  account.update_bytes_used_now
+
+  assert_equal 1024, board.bytes_used
+
+  card.update!(description: "")
+  board.update_bytes_used_now
+  account.update_bytes_used_now
+
+  assert_equal 0, board.bytes_used
+  assert_equal 0, account.bytes_used
+  end
+
+  test "unrelated attachments are ignored" do
+    account = accounts("37s")
+    board = boards("writebook")
+    blob = create_blob(bytes: 8192)
+
+    users("david").avatar.attach(blob)
+
+    board.update_bytes_used_now
+    account.update_bytes_used_now
+
+    assert_equal 0, board.bytes_used
+    assert_equal 0, account.bytes_used
+  end
+
+  test "card image attachment enqueues recalculation" do
+    account = accounts("37s")
+  board = boards("writebook")
+  card = cards("logo")
+  blob = create_blob(bytes: 512)
+
+  assert_enqueued_with(job: Board::UpdateBytesUsedJob, args: [ board ]) do
+    assert_enqueued_with(job: Account::UpdateBytesUsedJob, args: [ account ]) do
+      card.image.attach(blob)
+    end
+  end
+  end
+
+  test "card description embed enqueues recalculation" do
+    account = accounts("37s")
+  board = boards("writebook")
+  card = cards("logo")
+  blob = create_blob(bytes: 512)
+
+  assert_enqueued_with(job: Board::UpdateBytesUsedJob, args: [ board ]) do
+    assert_enqueued_with(job: Account::UpdateBytesUsedJob, args: [ account ]) do
+      card.update!(description: rich_text_with(blob))
+    end
+  end
+end
+
+  private
+    def create_blob(bytes:)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * bytes),
+        filename: "usage-#{bytes}.bin",
+        content_type: "application/octet-stream"
+      )
+    end
+
+    def rich_text_with(blob)
+      ActionText::Content.new.append_attachables(blob)
+    end
+end
