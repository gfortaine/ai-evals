diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..bf649da 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -6,20 +6,112 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
+    return Result.new([], nil) if @grants.empty?
+
+    sheet_bad_index = bad_row_in_sheet_index
+    if sheet_bad_index == 0
+      return Result.new([], sheet_bad_index)
+    end
+
+    existing_duplicate_index = existing_duplicate_index()
+    duplicate_index = [ sheet_bad_index, existing_duplicate_index ].compact.min
+
+    return Result.new([], duplicate_index) if duplicate_index
+
+    rows = @grants.map { |grant| { user_id: grant[:user_id], level: grant[:level].to_s } }
+    inserted_accesses = []
 
     Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
+      begin
+        result = @book.accesses.insert_all!(rows,
+          returning: %w[ id user_id book_id level created_at updated_at ])
+        inserted_accesses = instantiate_inserted_accesses(result)
       rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
+        duplicate_index = duplicate_index_after_insert_conflict || bad_row_in_sheet_index
         raise ActiveRecord::Rollback
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    if duplicate_index
+      Result.new([], duplicate_index)
+    else
+      inserted_accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
+      Result.new(inserted_accesses, nil)
+    end
   end
+
+  private
+    def bad_row_in_sheet_index
+      seen = {}
+
+      @grants.each_with_index do |grant, index|
+        return index unless Access.levels.key?(grant[:level].to_s)
+
+        user_id = normalized_user_id(grant[:user_id])
+        return index if seen.key?(user_id)
+
+        seen[user_id] = true
+      end
+
+      nil
+    end
+
+    def existing_duplicate_index
+      user_ids = @grants.map { |grant| normalized_user_id(grant[:user_id]) }.compact.uniq
+      existing_user_ids = Set.new(@book.accesses.where(user_id: user_ids).pluck(:user_id))
+
+      @grants.each_with_index do |grant, index|
+        return index if existing_user_ids.include?(normalized_user_id(grant[:user_id]))
+      end
+
+      nil
+    end
+
+    def duplicate_index_after_insert_conflict
+      user_ids = @grants.map { |grant| normalized_user_id(grant[:user_id]) }.compact.uniq
+      existing_user_ids = Set.new(@book.accesses.where(user_id: user_ids).pluck(:user_id))
+      seen = {}
+
+      @grants.each_with_index do |grant, index|
+        user_id = normalized_user_id(grant[:user_id])
+        return index if existing_user_ids.include?(user_id) || seen.key?(user_id)
+
+        seen[user_id] = true
+      end
+
+      nil
+    end
+
+    def instantiate_inserted_accesses(result)
+      accesses_by_user_id = {}
+
+      result.to_a.each do |attributes|
+        access = Access.instantiate(attributes)
+        access.association(:book).target = @book
+        accesses_by_user_id[access.user_id] = access
+      end
+
+      inserted_accesses = @grants.filter_map do |grant|
+        accesses_by_user_id[normalized_user_id(grant[:user_id])]
+      end
+
+      return inserted_accesses if inserted_accesses.length == @grants.length
+
+      reload_inserted_accesses
+    end
+
+    def reload_inserted_accesses
+      user_ids = @grants.map { |grant| normalized_user_id(grant[:user_id]) }.compact.uniq
+      accesses_by_user_id = @book.accesses.where(user_id: user_ids).index_by(&:user_id)
+
+      @grants.filter_map do |grant|
+        access = accesses_by_user_id[normalized_user_id(grant[:user_id])]
+        access.association(:book).target = @book if access
+        access
+      end
+    end
+
+    def normalized_user_id(user_id)
+      Access.type_for_attribute("user_id").cast(user_id)
+    end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..db59c32 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -1,6 +1,7 @@
 require "test_helper"
 
 class Book::AccessableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
   test "update_access always grants read access to everyone when everyone_access is set" do
     book = Book.create!(title: "My new book")
     book.update_access(editors: [], readers: [])
@@ -33,4 +34,68 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "access import grants all valid rows in one insert and notifies" do
+    book = books(:manual)
+
+    assert_queries_match(/INSERT INTO "accesses"/i, count: 1) do
+      assert_enqueued_jobs 1, only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(book, [
+          { user_id: users(:kevin).id, level: :reader }
+        ]).import
+
+        assert_equal [ users(:kevin).id ], result.accesses.map(&:user_id)
+        assert_nil result.duplicate_index
+      end
+    end
+
+    assert book.accessable?(user: users(:kevin))
+  end
+
+  test "access import rejects an existing access without notifying" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, [
+        { user_id: users(:david).id, level: :reader }
+      ]).import
+
+      assert_empty result.accesses
+      assert_equal 0, result.duplicate_index
+    end
+
+    assert_equal "editor", book.access_for(user: users(:david)).level
+  end
+
+  test "access import rejects duplicate rows without notifying" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, [
+        { user_id: users(:kevin).id, level: :reader },
+        { user_id: users(:kevin).id, level: :editor }
+      ]).import
+
+      assert_empty result.accesses
+      assert_equal 1, result.duplicate_index
+    end
+
+    assert_not book.accessable?(user: users(:kevin))
+  end
+
+  test "access import rejects unknown levels without notifying or raising" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, [
+        { user_id: users(:kevin).id, level: :reader },
+        { user_id: users(:jz).id, level: :owner }
+      ]).import
+
+      assert_empty result.accesses
+      assert_equal 1, result.duplicate_index
+    end
+
+    assert_not book.accessable?(user: users(:kevin))
+  end
 end
