@@ -0,0 +1,117 @@
+class Sessions::MagicLinksController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access
+
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @pending_authentication_token = pending_authentication_token
+  end
+
+  def create
+    if magic_link = MagicLink.from_pending_authentication_token(pending_authentication_token)
+      if magic_link.valid_code?(code_param)
+        authenticate_magic_link magic_link
+      else
+        invalid_magic_link
+      end
+    else
+      invalid_magic_link
+    end
+  end
+
+  private
+    def code_param
+      params[:code].presence || params.dig(:magic_link, :code)
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token].presence || params[:pending_authentication_token].presence
+    end
+
+    def authenticate_magic_link(magic_link)
+      if magic_link.join?
+        authenticate_join magic_link
+      elsif magic_link.signup?
+        authenticate_signup magic_link
+      else
+        authenticate_sign_in magic_link
+      end
+    end
+
+    def authenticate_sign_in(magic_link)
+      identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+      start_new_session_for identity
+      clear_pending_authentication
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def authenticate_signup(magic_link)
+      identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+      start_new_session_for identity
+      clear_pending_authentication
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path(script_name: nil) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def authenticate_join(magic_link)
+      account = Account.find_by(id: magic_link.account_id)
+      join_code = Account::JoinCode.find_by(code: magic_link.join_code, account: account) if account
+
+      if join_code&.active?
+        identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+        start_new_session_for identity
+        join_code.redeem_if { |joining_account| identity.join(joining_account) }
+        clear_pending_authentication
+
+        user = account.users.find_by!(identity: identity)
+
+        respond_to do |format|
+          format.html do
+            if user.setup?
+              redirect_to landing_url(script_name: account.slug)
+            else
+              redirect_to new_users_verification_url(script_name: account.slug)
+            end
+          end
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        join_code_expired
+      end
+    end
+
+    def clear_pending_authentication
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def invalid_magic_link
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+
+    def join_code_expired
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: "That join code is no longer active." }
+        format.json { render json: { message: "That join code is no longer active." }, status: :gone }
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
