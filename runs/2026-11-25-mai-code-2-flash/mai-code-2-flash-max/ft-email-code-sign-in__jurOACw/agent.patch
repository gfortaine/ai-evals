index 0000000..fc592cb
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "new renders the code form" do
+    untenanted do
+      get new_session_magic_link_path
+    end
+
+    assert_response :success
+    assert_select "input[name='code']"
+  end
+
+  test "create signs in for a valid code" do
+    magic_link = MagicLink.generate(email_address: identities(:kevin).email_address)
+    cookies[:pending_authentication_token] = magic_link.pending_authentication_token
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+    end
+
+    assert_redirected_to landing_url(script_name: nil)
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create signs up for a valid signup code" do
+    magic_link = MagicLink.generate(email_address: "new-user@example.com", purpose: :signup)
+    cookies[:pending_authentication_token] = magic_link.pending_authentication_token
+
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        post session_magic_link_path, params: { code: magic_link.code }
+      end
+    end
+
+    assert_redirected_to new_signup_completion_url(script_name: nil)
+  end
+
+
+  test "create joins an account for a valid join code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    magic_link = MagicLink.generate(
+      email_address: "new-member@example.com",
+      purpose: :join,
+      account: account,
+      join_code: join_code
+    )
+    cookies[:pending_authentication_token] = magic_link.pending_authentication_token
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        assert_difference -> { join_code.reload.usage_count }, 1 do
+          post session_magic_link_path, params: { code: magic_link.code }
+        end
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+
+  test "create rejects an invalid code" do
+    magic_link = MagicLink.generate(email_address: identities(:kevin).email_address)
+    cookies[:pending_authentication_token] = magic_link.pending_authentication_token
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "BAD000" }
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "create rejects an expired code" do
+    token = MagicLink.verifier.generate(
+      { email_address: identities(:kevin).email_address, code: "ABC123", purpose: "sign_in" },
+      expires_in: -1.second,
+      purpose: :pending_authentication
+    )
+    cookies[:pending_authentication_token] = token
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+    end
+
+    assert_response :unauthorized
+  end
+end
