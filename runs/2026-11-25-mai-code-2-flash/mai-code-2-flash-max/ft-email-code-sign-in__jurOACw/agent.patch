+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap", data: { controller: "form", turbo: false } do |form| %>
+    <%= form.text_field :code,
+          required: true,
+          autofocus: true,
+          autocomplete: "one-time-code",
+          maxlength: MagicLink::CODE_LENGTH,
+          pattern: "[A-Za-z0-9]{6}",
+          class: "input txt-x-large txt-align-center font-weight-black full-width",
+          placeholder: "ABC123" %>
+
+    <p>Enter the 6-character code we emailed you. It expires in 15 minutes.</p>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
