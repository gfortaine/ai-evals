+class IdentityMailer < ApplicationMailer
+  def magic_link(positional_email_address = nil, email_address: nil, code: nil, identity: nil)
+    identity ||= positional_email_address if positional_email_address.is_a?(Identity)
+    positional_email_address = nil if positional_email_address.is_a?(Identity)
+    email_address ||= positional_email_address || identity&.email_address
+    @code = code
+
+    mail to: email_address, subject: @code
+  end
+
+  alias_method :magic_link_code, :magic_link
+  alias_method :sign_in_code, :magic_link
+end
