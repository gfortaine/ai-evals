@@ -0,0 +1,31 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generate creates a six-character code and pending token" do
+    magic_link = MagicLink.generate(email_address: "New.User@Example.com", purpose: :sign_in)
+
+    assert_equal "new.user@example.com", magic_link.email_address
+    assert_equal 6, magic_link.code.length
+    assert magic_link.pending_authentication_token.present?
+    assert MagicLink.from_pending_authentication_token(magic_link.pending_authentication_token).valid_code?(magic_link.code.downcase)
+  end
+
+  test "from_pending_authentication_token rejects expired tokens" do
+    token = MagicLink.verifier.generate(
+      { email_address: "new-user@example.com", code: "ABC123", purpose: "sign_in" },
+      expires_in: -1.second,
+      purpose: :pending_authentication
+    )
+
+    assert_nil MagicLink.from_pending_authentication_token(token)
+  end
+
+  test "authenticate finds or creates the identity" do
+    magic_link = MagicLink.generate(email_address: "magic-link-user@example.com", purpose: :sign_in)
+
+    assert_difference -> { Identity.count }, 1 do
+      identity = MagicLink.authenticate(code: magic_link.code, pending_authentication_token: magic_link.pending_authentication_token)
+      assert_equal "magic-link-user@example.com", identity.email_address
+    end
+  end
+end
