diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..5d1dcce
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,95 @@
+class MagicLink
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  EXPIRATION = 15.minutes
+  EXPIRATION_DURATION = EXPIRATION
+  CODE_LENGTH = 6
+
+  attribute :email_address, :string
+  attribute :code, :string
+  attribute :purpose, :string
+  attribute :account_id, :string
+  attribute :join_code, :string
+  attribute :pending_authentication_token, :string
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+
+  class << self
+    def generate(email_address:, purpose: :sign_in, account: nil, join_code: nil)
+      normalized_email_address = email_address.to_s.strip.downcase.presence
+      code = SecureRandom.base58(CODE_LENGTH).upcase
+
+      new(
+        email_address: normalized_email_address,
+        code: code,
+        purpose: purpose.to_s,
+        account_id: account&.id,
+        join_code: join_code.respond_to?(:code) ? join_code.code : join_code,
+        pending_authentication_token: verifier.generate(
+          {
+            email_address: normalized_email_address,
+            code: code,
+            purpose: purpose.to_s,
+            account_id: account&.id,
+            join_code: join_code.respond_to?(:code) ? join_code.code : join_code
+          }.compact,
+          expires_in: EXPIRATION,
+          purpose: :pending_authentication
+        )
+      )
+    end
+
+    alias_method :issue, :generate
+
+    def from_pending_authentication_token(token)
+      return unless token.present?
+
+      if payload = verifier.verified(token, purpose: :pending_authentication)
+        new(
+          email_address: payload["email_address"] || payload[:email_address],
+          code: payload["code"] || payload[:code],
+          purpose: payload["purpose"] || payload[:purpose],
+          account_id: payload["account_id"] || payload[:account_id],
+          join_code: payload["join_code"] || payload[:join_code],
+          pending_authentication_token: token
+        )
+      end
+    end
+
+    alias_method :from_token, :from_pending_authentication_token
+    alias_method :find_by_pending_authentication_token, :from_pending_authentication_token
+    alias_method :find_by_token, :from_pending_authentication_token
+
+    def authenticate(code:, pending_authentication_token: nil, token: nil)
+      magic_link = from_pending_authentication_token(pending_authentication_token || token)
+
+      if magic_link&.valid_code?(code)
+        Identity.find_or_create_by!(email_address: magic_link.email_address)
+      end
+    end
+
+    def verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+  end
+
+  def valid_code?(submitted_code)
+    submitted_code = submitted_code.to_s.strip.upcase
+
+    code.present? && submitted_code.length == CODE_LENGTH &&
+      ActiveSupport::SecurityUtils.secure_compare(code, submitted_code)
+  end
+
+  def sign_in?
+    purpose == "sign_in"
+  end
+
+  def signup?
+    purpose.in?(%w[ signup sign_up ])
+  end
+
+  def join?
+    purpose == "join"
+  end
+end
