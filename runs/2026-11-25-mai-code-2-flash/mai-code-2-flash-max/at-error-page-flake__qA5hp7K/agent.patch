diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..5815934 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -2,6 +2,30 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+module RaisedExceptionsTestIsolation
+  EXECUTION_STATE_KEY = :test_raised_exceptions
+  SHOW_EXCEPTIONS_KEY = "action_dispatch.show_exceptions"
+  NORMAL_SHOW_EXCEPTIONS = Rails.application.config.action_dispatch.show_exceptions
+
+  def show?(request)
+    return false if ActiveSupport::IsolatedExecutionState[EXECUTION_STATE_KEY]
+
+    previous = request.get_header(SHOW_EXCEPTIONS_KEY)
+    request.set_header(SHOW_EXCEPTIONS_KEY, NORMAL_SHOW_EXCEPTIONS)
+    begin
+      super
+    ensure
+      if previous
+        request.set_header(SHOW_EXCEPTIONS_KEY, previous)
+      else
+        request.delete_header(SHOW_EXCEPTIONS_KEY)
+      end
+    end
+  end
+end
+
+ActionDispatch::ExceptionWrapper.prepend(RaisedExceptionsTestIsolation)
+
 module ActiveSupport
   class TestCase
     # Run tests in parallel with specified workers
@@ -13,11 +37,24 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
+      execution_state_was_set = ActiveSupport::IsolatedExecutionState.key?(RaisedExceptionsTestIsolation::EXECUTION_STATE_KEY)
+      previous_execution_state = ActiveSupport::IsolatedExecutionState[RaisedExceptionsTestIsolation::EXECUTION_STATE_KEY]
       previous = Rails.application.config.action_dispatch.show_exceptions
+      previous_env_config = Rails.application.env_config[RaisedExceptionsTestIsolation::SHOW_EXCEPTIONS_KEY]
+
       Rails.application.config.action_dispatch.show_exceptions = :none
+      Rails.application.env_config[RaisedExceptionsTestIsolation::SHOW_EXCEPTIONS_KEY] = :none
+      ActiveSupport::IsolatedExecutionState[RaisedExceptionsTestIsolation::EXECUTION_STATE_KEY] = true
       yield
     ensure
       Rails.application.config.action_dispatch.show_exceptions = previous
+      Rails.application.env_config[RaisedExceptionsTestIsolation::SHOW_EXCEPTIONS_KEY] = previous_env_config
+
+      if execution_state_was_set
+        ActiveSupport::IsolatedExecutionState[RaisedExceptionsTestIsolation::EXECUTION_STATE_KEY] = previous_execution_state
+      else
+        ActiveSupport::IsolatedExecutionState.delete(RaisedExceptionsTestIsolation::EXECUTION_STATE_KEY)
+      end
     end
   end
 end
