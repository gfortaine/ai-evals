@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal "👍", Comment::Reaction.last.content
+  end
+
+  test "create with flat params" do
+    comment = comments(:logo_agreement_kevin)
+
+    post card_comment_reactions_path(cards(:logo), comment), params: { body: "Agreed" }, as: :json
+
+    assert_response :created
+    assert_equal "Agreed", Comment::Reaction.last.content
+  end
+
+  test "create rejects overlong content" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "x" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy own reaction" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = Comment::Reaction.create!(comment: comment, creator: users(:kevin), content: "👍")
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(cards(:logo), comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "cannot destroy another person's reaction" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = Comment::Reaction.create!(comment: comment, creator: users(:jz), content: "Agreed")
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(cards(:logo), comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show as JSON" do
