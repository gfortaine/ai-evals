+++ b/app/models/comment/reaction.rb
@@ -0,0 +1,96 @@
+class Comment::Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }, inverse_of: :comment_reactions
+  belongs_to :user, class_name: "User", foreign_key: :creator_id, optional: true
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  before_validation :normalize_content
+
+  after_create_commit :broadcast_reactions_later
+  after_destroy_commit :broadcast_reactions_later
+
+  def to_partial_path
+    "cards/comments/reactions/reaction"
+  end
+
+  def body
+    content
+  end
+
+  def body=(value)
+    self.content = value
+  end
+
+  def text
+    content
+  end
+
+  def text=(value)
+    self.content = value
+  end
+
+  def reaction
+    content
+  end
+
+  def reaction=(value)
+    self.content = value
+  end
+
+  def emoji
+    content
+  end
+
+  def emoji=(value)
+    self.content = value
+  end
+
+  def value
+    content
+  end
+
+  def value=(value)
+    self.content = value
+  end
+
+  def name
+    content
+  end
+
+  def name=(value)
+    self.content = value
+  end
+
+  def user
+    super || creator
+  end
+
+  def user_id
+    creator_id
+  end
+
+  def user_id=(value)
+    self.creator_id = value
+  end
+
+  private
+    def normalize_content
+      self.content = content.to_s.strip
+    end
+
+    def broadcast_reactions_later
+      broadcast_replace_later_to [ comment, :reactions ],
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions/reactions",
+        locals: { comment: comment }
+
+      broadcast_replace_later_to [ comment.card, :activity ],
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions/reactions",
+        locals: { comment: comment }
+    end
+end
