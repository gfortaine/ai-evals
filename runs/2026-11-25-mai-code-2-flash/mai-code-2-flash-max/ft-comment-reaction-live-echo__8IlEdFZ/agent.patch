+require "test_helper"
+
+class Comment::ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "creates a reaction with content" do
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = Comment::Reaction.create!(comment: comment, creator: users(:kevin), content: "👍")
+
+    assert_equal "👍", reaction.content
+    assert_includes comment.reactions.reload, reaction
+  end
+
+  test "accepts body and text aliases" do
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = Comment::Reaction.create!(comment: comment, creator: users(:kevin), body: "Agreed")
+
+    assert_equal "Agreed", reaction.content
+    assert_equal "Agreed", reaction.text
+  end
+
+  test "rejects blank and overlong content" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_not Comment::Reaction.create(comment: comment, creator: users(:kevin), content: "  ").persisted?
+    assert_not Comment::Reaction.create(comment: comment, creator: users(:kevin), content: "x" * 17).persisted?
+  end
+
+  test "strips surrounding whitespace" do
+    reaction = Comment::Reaction.create!(
+      comment: comments(:logo_agreement_kevin),
+      creator: users(:kevin),
+      content: "  Nice  "
+    )
+
+    assert_equal "Nice", reaction.content
+  end
+
+  test "a comment can have multiple reactions from the same person" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +2 do
+      Comment::Reaction.create!(comment: comment, creator: users(:kevin), content: "👍")
+      Comment::Reaction.create!(comment: comment, creator: users(:kevin), content: "Agreed")
+    end
+  end
+end
