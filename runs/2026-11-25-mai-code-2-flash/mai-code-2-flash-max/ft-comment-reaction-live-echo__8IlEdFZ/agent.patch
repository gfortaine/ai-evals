+<% own_reaction = Current.user.present? && reaction.creator == Current.user %>
+
+<% if own_reaction %>
+  <div id="<%= dom_id(reaction) %>" class="reaction reaction--deleteable"
+       data-controller="toggle-class"
+       data-toggle-class-toggle-class="expanded"
+       data-action="click->toggle-class#toggle"
+       title="<%= reaction.creator.name %>: <%= reaction.content %>"
+       aria-label="<%= reaction.creator.name %> reacted with <%= reaction.content %>. Click to remove.">
+    <span class="reaction__avatar"><%= avatar_tag reaction.creator, hidden_for_screen_reader: true %></span>
+    <span class="txt-small txt-medium"><%= reaction.content %></span>
+
+    <%= button_to card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction),
+          method: :delete,
+          class: "reaction__delete btn btn--circle borderless",
+          form: { class: "reaction__delete-form" },
+          aria: { label: "Remove #{reaction.creator.name}'s reaction" } do %>
+      <%= icon_tag "close" %>
+    <% end %>
+  </div>
+<% else %>
+  <div id="<%= dom_id(reaction) %>" class="reaction"
+       title="<%= reaction.creator.name %>: <%= reaction.content %>"
+       aria-label="<%= reaction.creator.name %> reacted with <%= reaction.content %>">
+    <span class="reaction__avatar"><%= avatar_tag reaction.creator, hidden_for_screen_reader: true %></span>
+    <span class="txt-small txt-medium"><%= reaction.content %></span>
+  </div>
+<% end %>
