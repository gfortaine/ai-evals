+<div class="reaction reaction__form" hidden data-reaction-target="form">
+  <%= form_with url: card_comment_reactions_path(comment.card, comment), scope: :reaction, class: "flex align-center" do |form| %>
+    <label class="reaction__form-label">
+      <span class="for-screen-reader">Add reaction</span>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: 16, required: true,
+            autocomplete: "off", placeholder: "React", data: { reaction_target: "input", action: "keydown.esc->reaction#cancel" } %>
+    </label>
+
+    <button type="submit" class="reaction__submit-btn btn btn--circle borderless" aria-label="Confirm reaction">
+      <%= icon_tag "check" %>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" aria-label="Cancel reaction"
+          data-action="reaction#cancel">
+      <%= icon_tag "close" %>
+    </button>
+  <% end %>
+</div>
+
+<button type="button" class="reactions__trigger btn btn--circle"
+      aria-label="Add reaction" data-reaction-target="trigger" data-action="reaction#open">
+  <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+</button>
