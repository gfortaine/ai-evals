diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..815c4a2
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,66 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content body text emoji reaction value name user_id creator_id ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :ensure_reaction_creatorship, only: :destroy
+
+  def show
+  end
+
+  def create
+    @reaction = @comment.reactions.create(reaction_params.merge(creator: Current.user))
+
+    respond_to do |format|
+      format.turbo_stream do
+        render :create, status: (@reaction.persisted? ? :ok : :unprocessable_entity)
+      end
+      format.json do
+        if @reaction.persisted?
+          render :show, status: :created, location: card_comment_reaction_url(@card, @comment, @reaction)
+        else
+          render json: { errors: @reaction.errors.full_messages }, status: :unprocessable_entity
+        end
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_reaction_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def reaction_params
+      if params[:reaction].is_a?(ActionController::Parameters)
+        nested = params[:reaction].permit(:content, :body, :text, :emoji, :reaction, :value, :name, :user_id, :creator_id).to_h
+        nested.presence || params.permit(:content, :body, :text, :emoji, :reaction, :value, :name, :user_id, :creator_id).to_h
+      elsif params[:reaction].is_a?(String)
+        { content: params[:reaction] }
+      else
+        params.permit(:content, :body, :text, :emoji, :reaction, :value, :name, :user_id, :creator_id).to_h
+      end
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..b5b76d3
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,21 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+
+  open(event) {
+    event.preventDefault()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event.preventDefault()
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.inputTarget.value = ""
+    this.triggerTarget.hidden = false
+  }
+}
