index 0000000..035adee
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,41 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create_account
+
+  def create
+    if params[:scope] == "account"
+      create_account
+    else
+      create_cards
+    end
+  end
+
+  def create_account
+    export = Current.account.exports.create!(user: Current.user, kind: "account")
+    Account::ExportJob.perform_later(export)
+    redirect_to account_settings_path, notice: "Your export is being prepared. We'll email you when it's ready."
+  end
+
+  def create_cards
+    cards = Current.user.accessible_cards.published.where(id: card_ids)
+    export = Current.account.exports.create!(user: Current.user, kind: "cards", card_ids: cards.ids)
+    Account::ExportJob.perform_later(export)
+    redirect_to user_path(Current.user), notice: "Your card export is being prepared. We'll email you when it's ready."
+  end
+
+  def download
+    unless params[:token].present?
+      head :not_found
+      return
+    end
+
+    export = Export.find_by_download_token(params[:token])
+    return head :forbidden unless export&.completed? && export.archive.attached?
+
+    redirect_to rails_blob_url(export.archive, disposition: "attachment", filename: export.filename)
+  end
+
+  private
+    def card_ids
+      Array(params[:card_ids]).compact
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
