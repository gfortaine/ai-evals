diff --git a/app/models/account/data_transfer/card_record_set.rb b/app/models/account/data_transfer/card_record_set.rb
new file mode 100644
index 0000000..024bc53
--- /dev/null
+++ b/app/models/account/data_transfer/card_record_set.rb
@@ -0,0 +1,54 @@
+class Account::DataTransfer::CardRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, cards: nil)
+    super(account: account, model: Card)
+    @cards = cards
+  end
+
+  def export_to(zip)
+    records.find_each do |card|
+      zip.add_file(record_path(card), JSON.pretty_generate(card_export(card)))
+
+      card.comments.chronologically.find_each do |comment|
+        zip.add_file("comments/#{comment.id}.json", JSON.pretty_generate(comment_export(comment)))
+      end
+    end
+  end
+
+  private
+    def records
+      @cards || super
+    end
+
+    def card_export(card)
+      {
+        "id" => card.id,
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "description" => card.description.to_s,
+        "description_plain_text" => card.description.to_plain_text,
+        "board_id" => card.board_id,
+        "column_id" => card.column_id,
+        "creator_id" => card.creator_id,
+        "due_on" => card.due_on,
+        "created_at" => card.created_at,
+        "updated_at" => card.updated_at,
+        "last_active_at" => card.last_active_at,
+        "tags" => card.tags.pluck(:title),
+        "steps" => card.steps.map { |step| step.attributes.slice("id", "content", "completed", "created_at", "updated_at") },
+        "assignee_ids" => card.assignee_ids,
+        "comments" => card.comments.chronologically.map { |comment| comment_export(comment) }
+      }.as_json
+    end
+
+    def comment_export(comment)
+      {
+        "id" => comment.id,
+        "creator_id" => comment.creator_id,
+        "body" => comment.body.to_s,
+        "body_plain_text" => comment.body.to_plain_text,
+        "created_at" => comment.created_at,
+        "updated_at" => comment.updated_at
+      }.as_json
+    end
+end
