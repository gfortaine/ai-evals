@@ -0,0 +1,22 @@
+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel shadow center" style="--panel-size: 45ch;">
+  <%= form_with url: account_imports_path(script_name: nil), multipart: true, class: "flex flex-column gap" do |form| %>
+    <p class="txt-medium">Choose a Fizzy account export (.zip). We'll create a new account and email you when the import is done.</p>
+
+    <label class="input input--file flex align-center gap">
+      <%= form.file_field :archive, accept: ".zip,application/zip", required: true, class: "input" %>
+    </label>
+
+    <div class="flex flex-column gap-half">
+      <%= form.label :name, "Account name (optional)", class: "txt-small txt-tinted" %>
+      <%= form.text_field :name, class: "input", placeholder: "Imported account" %>
+    </div>
+
+    <button type="submit" class="btn btn--reversed center">Import account</button>
+  <% end %>
+</div>
