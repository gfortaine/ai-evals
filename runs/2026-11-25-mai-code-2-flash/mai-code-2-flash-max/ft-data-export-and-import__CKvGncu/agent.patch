+          creator_id: account.users.find_by(id: remap_id(:users, attrs["creator_id"]))&.id,
+          card_id: card.id,
+          source_type: source ? source.class.base_class.name : attrs["source_type"],
+          source_id: source ? source.id : attrs["source_id"],
+          read_at: attrs["read_at"],
+          unread_count: attrs.fetch("unread_count", 0),
+          created_at: attrs["created_at"],
