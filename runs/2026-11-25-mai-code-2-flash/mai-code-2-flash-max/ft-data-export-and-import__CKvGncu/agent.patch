+    def import_blob_records(zip)
+      each_json(zip, "active_storage_blobs") do |attrs|
+        old_id = attrs["id"]
+        old_path = attrs["path"]
+        entry = old_path ? zip.find_entry(old_path) : nil
+        unless entry
+          prefix = "files/#{old_id}/"
+          entry = zip.entries.find { |item| item.file? && item.name.start_with?(prefix) }
+        end
+        raise InvalidArchive, "The archive is missing file #{attrs["filename"]}" unless entry
+
+        io = StringIO.new(entry.get_input_stream.read)
+        io.set_encoding(Encoding::BINARY)
+
+        blob = nil
+        Current.with_account(account) do
+          blob = ActiveStorage::Blob.create_and_upload!(
+            io: io,
+            filename: attrs["filename"],
+            content_type: attrs["content_type"],
+            metadata: attrs["metadata"] || {},
+            identify: false
+          )
+          blob.update!(account: account) if blob.account_id != account.id
+        end
+
+        @created_blobs << blob
+        map_id(:active_storage_blobs, old_id, blob.id)
+        @old_blob_sgids[attrs["sgid"]] = blob.attachable_sgid
+      end
+    end
+
+    def import_rich_text_records(zip)
+      each_json(zip, "action_text_rich_texts") do |attrs|
+        record = polymorphic_rich_text_record(attrs["record_type"], attrs["record_id"])
+        next unless record
+
+        body = remap_rich_text_body(attrs["body"])
+        rich_text = ActionText::RichText.create!(
+          account: account,
+          record: record,
+          name: attrs["name"],
+          body: body,
+          created_at: attrs["created_at"],
+          updated_at: attrs["updated_at"]
+        )
+        map_id(:action_text_rich_texts, attrs["id"], rich_text.id)
+      end
+    end
+
+    def polymorphic_rich_text_record(type, old_id)
+      case type
+      when "Card"
+        account.cards.find_by(id: remap_id(:cards, old_id))
+      when "Comment"
+        account.comments.find_by(id: remap_id(:comments, old_id))
+      when "Board"
+        account.boards.find_by(id: remap_id(:boards, old_id))
+      end
+    end
+
+    def remap_rich_text_body(body)
+      result = body.to_s
+      @old_blob_sgids.each do |old_sgid, new_sgid|
+        result = result.gsub(old_sgid, new_sgid) if old_sgid.present?
+      end
+      result
+    end
+
+    def import_attachment_records(zip)
+      each_json(zip, "active_storage_attachments") do |attrs|
+        record_type = attrs["record_type"]
+        next if [ "Export", "Import" ].include?(record_type)
+
+        record = polymorphic_attachment_record(record_type, attrs["record_id"])
+        blob = ActiveStorage::Blob.find_by(id: remap_id(:active_storage_blobs, attrs["blob_id"]))
+        next unless record && blob
+
+        ActiveStorage::Attachment.create!(
+          account: account,
+          blob: blob,
+          record: record,
+          name: attrs["name"],
+          created_at: attrs["created_at"]
+        )
+      rescue ActiveRecord::RecordInvalid
+        # Rich-text embed attachments are recreated while restoring rich text.
+        raise unless record_type == "ActionText::RichText"
+      end
+    end
+
+    def polymorphic_attachment_record(record_type, old_id)
+      case record_type
+      when "Card"
+        account.cards.find_by(id: remap_id(:cards, old_id))
+      when "Comment"
+        account.comments.find_by(id: remap_id(:comments, old_id))
+      when "Board"
+        account.boards.find_by(id: remap_id(:boards, old_id))
+      when "User"
+        account.users.find_by(id: remap_id(:users, old_id))
+      when "Identity"
+        identity
+      when "ActionText::RichText"
+        account_rich_text = account_rich_text_by_old_id(old_id)
+        account_rich_text
+      end
+    end
+
+    def account_rich_text_by_old_id(old_id)
+      new_id = remap_id(:action_text_rich_texts, old_id)
+      ActionText::RichText.find_by(id: new_id)
+    end
+end
