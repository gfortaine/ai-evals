@@ -0,0 +1,24 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  def new
+  end
+
+  def create
+    unless params[:archive].respond_to?(:read)
+      redirect_to new_account_import_path(script_name: nil), alert: "Choose a Fizzy account export to import"
+      return
+    end
+
+    uploaded = params[:archive]
+    import = Import.create!(
+      identity: Current.identity,
+      filename: params[:name].presence || uploaded.original_filename
+    )
+    import.archive.attach(io: uploaded, filename: uploaded.original_filename, content_type: uploaded.content_type)
+
+    Account::ImportJob.perform_later(import)
+
+    redirect_to new_account_import_path(script_name: nil), notice: "Your account import is running. We'll email you when it's done."
+  end
+end
diff --git a/app/jobs/account/export_job.rb b/app/jobs/account/export_job.rb
new file mode 100644
index 0000000..bbdb04f
--- /dev/null
+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,27 @@
+class Account::ExportJob < ApplicationJob
+  queue_as :exports
+
+  def perform(export)
+    export.mark_processing!
+
+    filename = if export.account_export?
+      "#{export.account.name.parameterize.presence || "account"}-export.zip"
+    else
+      "cards-export.zip"
+    end
+
+    ZipFile.create_for(export.archive, filename: filename) do |zip|
+      Account::DataTransfer::Exporter.new(
+        account: export.account,
+        cards: export.cards_export? ? export.account.cards.where(id: Array(export.card_ids)) : nil
+      ).public_send(export.account_export? ? :write_account_to : :write_cards_to, zip)
+    end
+
+    export.mark_completed!(filename: filename)
+    AccountMailer.export_ready(export).deliver_later
+  rescue => error
+    export.mark_failed!(error: error)
+    AccountMailer.export_failed(export).deliver_later
+    Rails.error.report(error, severity: :error)
+  end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..5b1ae41
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,26 @@
+class Account::ImportJob < ApplicationJob
+  queue_as :imports
+
+  def perform(import)
+    import.mark_processing!
+
+    account = Account::DataTransfer::Importer.new(
+      identity: import.identity,
+      archive: import.archive,
+      name: import.filename.presence
+    ).import
+
+    import.mark_completed!(account: account, filename: import.filename)
+    AccountMailer.import_completed(import).deliver_later
+  rescue => error
+    import.mark_failed!(error: error_message(error), filename: import.filename)
+    AccountMailer.import_failed(import).deliver_later
+    Rails.error.report(error, severity: :error)
+  end
+
+  private
+    def error_message(error)
+      message = error.message.to_s.strip
+      message.presence || error.class.name
+    end
+end
