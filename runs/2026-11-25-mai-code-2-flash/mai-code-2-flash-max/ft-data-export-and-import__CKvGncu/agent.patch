@@ -0,0 +1,23 @@
+class Account::DataTransfer::CardsManifest
+  attr_reader :account, :cards
+
+  def initialize(account, cards)
+    @account = account
+    @cards = cards
+  end
+
+  def each_record_set
+    raise ArgumentError, "No block given" unless block_given?
+
+    yield Account::DataTransfer::CardRecordSet.new(account, cards: cards)
+
+    blob_ids = cards.flat_map do |card|
+      Card::DataTransferAttachmentIds.for(card)
+    end.uniq
+
+    yield Account::DataTransfer::Cards::BlobRecordSet.new(account, blob_ids)
+    yield Account::DataTransfer::Cards::AttachmentRecordSet.new(account, cards)
+    yield Account::DataTransfer::Cards::RichTextRecordSet.new(account, cards)
+    yield Account::DataTransfer::Cards::FileRecordSet.new(account, blob_ids)
+  end
+end
