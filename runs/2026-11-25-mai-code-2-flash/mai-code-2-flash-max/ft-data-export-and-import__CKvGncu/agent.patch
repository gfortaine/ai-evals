--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,32 @@
+class Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  has_one_attached :archive
+
+  STATUSES = %w[pending processing completed failed].freeze
+
+  validates :status, inclusion: { in: STATUSES }
+
+  scope :recent, -> { order(created_at: :desc) }
+
+  def completed?
+    status == "completed"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def mark_processing!
+    update!(status: "processing")
+  end
+
+  def mark_completed!(account:, filename: nil)
+    update!(status: "completed", account: account, filename: filename)
+  end
+
+  def mark_failed!(error:, filename: nil)
+    update!(status: "failed", error: error.to_s, filename: filename)
+  end
+end
