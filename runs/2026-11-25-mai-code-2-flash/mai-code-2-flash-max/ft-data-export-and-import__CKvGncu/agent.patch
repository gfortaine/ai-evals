diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..a67709b
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,766 @@
+class Account::DataTransfer::Importer
+  class InvalidArchive < StandardError; end
+
+  attr_reader :account, :identity, :archive
+
+  def initialize(identity:, archive:, name: nil)
+    @identity = identity
+    @archive = archive
+    @name = name
+    @id_map = {}
+    @old_blob_sgids = {}
+    @created_blobs = []
+  end
+
+  def import
+    download_to_tempfile do |tempfile|
+      validate_archive!(tempfile)
+
+      Account.transaction do
+        @account = create_account!(tempfile)
+
+        Zip::File.open(tempfile.path) do |zip|
+          import_users(zip)
+          import_settings(zip)
+          import_tags(zip)
+          import_boards(zip)
+          import_columns(zip)
+          import_entropies(zip)
+          import_publications(zip)
+          import_accesses(zip)
+          import_cards(zip)
+          import_comments(zip)
+          import_steps(zip)
+          import_assignments(zip)
+          import_taggings(zip)
+          import_closures(zip)
+          import_goldnesses(zip)
+          import_not_nows(zip)
+          import_activity_spikes(zip)
+          import_watches(zip)
+          import_pins(zip)
+          import_reactions(zip)
+          import_mentions(zip)
+          import_filters(zip)
+          import_webhooks(zip)
+          import_events(zip)
+          import_notifications(zip)
+          import_blob_records(zip)
+          import_rich_text_records(zip)
+          import_attachment_records(zip)
+        end
+
+        account.update!(cards_count: account.cards.count)
+        account
+      end
+    end
+  rescue InvalidArchive, ActiveRecord::RecordInvalid, ActiveRecord::RecordNotFound, Zip::Error => error
+    @created_blobs.each do |blob|
+      blob.purge rescue nil
+    end
+    raise error
+  end
+
+  private
+    attr_reader :name
+
+    def download_to_tempfile
+      tempfile = Tempfile.new([ "account-import", ".zip" ])
+      tempfile.binmode
+      archive.download { |chunk| tempfile.write(chunk) }
+      tempfile.flush
+      tempfile.rewind
+      yield tempfile
+    ensure
+      tempfile&.close
+      tempfile&.unlink
+    end
+
+    def validate_archive!(tempfile)
+      Zip::File.open(tempfile.path) do |zip|
+        entry = zip.find_entry("manifest.json")
+        raise InvalidArchive, "The archive is missing manifest.json" unless entry
+
+        manifest = JSON.parse(entry.get_input_stream.read)
+        unless manifest["format"] == "fizzy-account-export" && manifest["version"] == 1
+          raise InvalidArchive, "This is not a supported Fizzy account export"
+        end
+      end
+    rescue JSON::ParserError
+      raise InvalidArchive, "manifest.json is not valid JSON"
+    rescue Zip::Error
+      raise InvalidArchive, "The uploaded file is not a valid ZIP archive"
+    end
+
+    def create_account!(tempfile)
+      old_account = nil
+
+      Zip::File.open(tempfile.path) do |zip|
+        old_account = read_single_json(zip, "accounts")
+      end
+
+      old_owner = nil
+      Zip::File.open(tempfile.path) do |zip|
+        each_json(zip, "users") do |attrs|
+          old_owner ||= attrs if attrs["role"] == "owner"
+        end
+      end
+
+      account_name = name.presence || old_account&.fetch("name", nil).presence || "Imported account"
+      owner_name = old_owner&.fetch("name", nil).presence || identity.email_address
+
+      Account.create_with_owner(
+        account: { name: account_name },
+        owner: { name: owner_name, identity: identity }
+      ).tap do |new_account|
+        map_id(:accounts, old_account["id"], new_account.id) if old_account
+        map_id(:users, old_owner["id"], new_account.users.owner.first.id) if old_owner
+        new_account.update!(cards_count: old_account["cards_count"] || 0) if old_account
+      end
+    end
+
+    def read_single_json(zip, table)
+      entry = zip.entries.find { |item| item.file? && item.name.start_with?("records/#{table}/") && item.name.end_with?(".json") }
+      entry ? JSON.parse(entry.get_input_stream.read) : nil
+    rescue JSON::ParserError
+      raise InvalidArchive, "Invalid JSON in records/#{table}"
+    end
+
+    def each_json(zip, table)
+      entries = zip.entries.select { |entry| entry.file? && entry.name.start_with?("records/#{table}/") && entry.name.end_with?(".json") }
+      entries.each do |entry|
+        begin
+          yield JSON.parse(entry.get_input_stream.read)
+        rescue JSON::ParserError
+          raise InvalidArchive, "Invalid JSON in #{entry.name}"
+        end
+      end
+    end
+
+    def remap_id(table, old_id)
+      @id_map.dig(table, old_id) || old_id
+    end
+
+    def map_id(table, old_id, new_id)
+      return if old_id.blank? || new_id.blank?
+      @id_map[table] ||= {}
+      @id_map[table][old_id] = new_id
+    end
+
+    def import_users(zip)
+      old_owner = nil
+      each_json(zip, "users") do |attrs|
+        old_owner ||= attrs if attrs["role"] == "owner"
+      end
+
+      system_user = account.system_user
+
+      each_json(zip, "users") do |attrs|
+        if attrs["role"] == "system"
+          map_id(:users, attrs["id"], system_user.id)
+          next
+        end
+
+        owner_match = old_owner && attrs["id"] == old_owner["id"]
+        user_identity = identity_for(attrs)
+
+        if owner_match
+          user = account.users.owner.first
+          user.update!(
+            name: attrs["name"],
+            identity: identity,
+            active: attrs.fetch("active", true),
+            verified_at: attrs["verified_at"] || Time.current,
+            created_at: attrs["created_at"],
+            updated_at: attrs["updated_at"]
+          )
+        else
+          role = attrs["role"] == "owner" ? "admin" : attrs["role"]
+          user = account.users.find_or_initialize_by(identity: user_identity)
+          user.assign_attributes(
+            account: account,
+            name: attrs["name"],
+            role: role,
+            identity: user_identity,
+            active: attrs.fetch("active", true),
+            verified_at: attrs["verified_at"],
+            created_at: attrs["created_at"],
+            updated_at: attrs["updated_at"]
+          )
+          user.save!
+        end
+
+        map_id(:users, attrs["id"], user.id)
+      end
+    end
+
+    def identity_for(attrs)
+      email = attrs["email_address"]
+      return identity if email.present? && email.downcase == identity.email_address.downcase
+      return nil if email.blank?
+
+      Identity.find_or_create_by!(email_address: email)
+    end
