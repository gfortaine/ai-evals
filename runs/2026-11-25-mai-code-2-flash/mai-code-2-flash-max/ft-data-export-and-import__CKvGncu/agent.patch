diff --git a/app/models/card/data_transfer_attachment_ids.rb b/app/models/card/data_transfer_attachment_ids.rb
new file mode 100644
index 0000000..9d3d229
--- /dev/null
+++ b/app/models/card/data_transfer_attachment_ids.rb
@@ -0,0 +1,24 @@
+class Card::DataTransferAttachmentIds
+  class << self
+    def for(card)
+      direct = ActiveStorage::Attachment
+        .where(account: card.account, record_type: "Card", record_id: card.id)
+        .pluck(:blob_id)
+
+      rich_text_ids = ActionText::RichText
+        .where(account: card.account, record_type: [ "Card", "Comment" ], record_id: card_export_record_ids(card))
+        .ids
+
+      embedded = ActiveStorage::Attachment
+        .where(account: card.account, record_type: "ActionText::RichText", record_id: rich_text_ids)
+        .pluck(:blob_id)
+
+      (direct + embedded).uniq
+    end
+
+    private
+      def card_export_record_ids(card)
+        [ card.id, *card.comment_ids ]
+      end
+  end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..f1cbe0a
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,52 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :archive
+
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  STATUSES = %w[pending processing completed failed].freeze
+  KINDS = %w[account cards].freeze
+
+  validates :kind, inclusion: { in: KINDS }
+  validates :status, inclusion: { in: STATUSES }
+
+  scope :recent, -> { order(created_at: :desc) }
+
+  def account_export?
+    kind == "account"
+  end
+
+  def cards_export?
+    kind == "cards"
+  end
+
+  def completed?
+    status == "completed"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def download_token
+    signed_id(purpose: :export_download, expires_in: DOWNLOAD_LINK_EXPIRY)
+  end
+
+  def self.find_by_download_token(token)
+    find_signed(token, purpose: :export_download)
+  end
+
+  def mark_processing!
+    update!(status: "processing")
+  end
+
+  def mark_completed!(filename:)
+    update!(status: "completed", filename: filename)
+  end
+
+  def mark_failed!(error:)
+    update!(status: "failed", error: error.to_s)
+  end
+end
