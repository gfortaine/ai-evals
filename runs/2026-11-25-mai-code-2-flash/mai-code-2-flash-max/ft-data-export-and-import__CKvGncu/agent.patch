+class Account::DataTransfer::Cards::AttachmentRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, cards)
+    super(account: account, model: ActiveStorage::Attachment)
+    @cards = cards
+  end
+
+  private
+    def records
+      card_ids = @cards.map(&:id)
+      comment_ids = Comment.where(account: account, card_id: card_ids).ids
+      rich_text_ids = ActionText::RichText
+        .where(account: account, record_type: [ "Card", "Comment", "Board" ], record_id: card_ids + comment_ids + @cards.map(&:board_id).uniq)
+        .ids
+
+      ActiveStorage::Attachment.where(account: account).where(
+        "(record_type = 'Card' AND record_id IN (?) OR record_type = 'Comment' AND record_id IN (?) OR record_type = 'ActionText::RichText' AND record_id IN (?))",
+        card_ids,
+        comment_ids,
+        rich_text_ids
+      )
+    end
+end
