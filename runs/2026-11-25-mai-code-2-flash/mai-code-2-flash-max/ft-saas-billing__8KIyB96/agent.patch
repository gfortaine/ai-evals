diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..df84a65
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,52 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+    set_account
+  end
+
+  def comp
+    set_account
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    set_account
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    set_account
+
+    @account.override_limits(
+      card_count: override_param(:card_count),
+      bytes_used: override_param(:bytes_used)
+    )
+
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  end
+
+  def reset
+    set_account
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Override reset"
+  end
+
+  alias_method :destroy, :reset
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) || Account.find_by(external_account_id: params[:id]) || Account.find(params[:id])
+    end
+
+    def override_param(name)
+      value = params[name] || params.dig(:overridden_limit, name) || params.dig(:account, name)
+      value.present? ? value.to_i : nil
+    end
+end
diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..7d06339
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,63 @@
+require "stripe"
+
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+  end
+
+  def create
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"] if ENV["STRIPE_SECRET_KEY"].present?
+    plan_key = Subscription.normalize_plan_key(params[:plan] || params[:plan_key])
+
+    if plan_key == "free"
+      redirect_to saas.billing_checkout_path, alert: "Choose a paid plan"
+      return
+    end
+
+    price_id = price_id_for(plan_key)
+
+    checkout_params = {
+      mode: "subscription",
+      line_items: [ { price: price_id, quantity: 1 } ],
+      success_url: account_settings_url(script_name: Current.account.slug),
+      cancel_url: account_settings_url(script_name: Current.account.slug),
+      client_reference_id: Current.account.external_account_id.to_s,
+      metadata: {
+        account_id: Current.account.id,
+        external_account_id: Current.account.external_account_id,
+        plan_key: plan_key
+      },
+      subscription_data: {
+        metadata: {
+          account_id: Current.account.id,
+          external_account_id: Current.account.external_account_id,
+          plan_key: plan_key
+        }
+      }
+    }
+
+    if active_subscription_customer_id.present?
+      checkout_params[:customer] = active_subscription_customer_id
+    else
+      checkout_params[:customer_email] = Current.account.owner_email
+    end
+
+    session = Stripe::Checkout::Session.create(checkout_params)
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def active_subscription_customer_id
+      Current.account.active_subscription&.stripe_customer_id
+    end
+
+    def price_id_for(plan_key)
+      if plan_key == "unlimited_plus"
+        ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] || ENV["STRIPE_UNLIMITED_PLUS_MONTHLY_PRICE_ID"] || ENV["STRIPE_PLUS_PRICE_ID"]
+      else
+        ENV["STRIPE_UNLIMITED_PRICE_ID"] || ENV["STRIPE_UNLIMITED_MONTHLY_PRICE_ID"]
+      end
+    end
+end
