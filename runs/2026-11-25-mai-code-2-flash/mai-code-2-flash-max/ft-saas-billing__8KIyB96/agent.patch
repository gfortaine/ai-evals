index 0000000..bef00b4
--- /dev/null
+++ b/saas/test/controllers/billing/checkouts_controller_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Billing::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "pricing page shows approved plans" do
+    sign_in_as :mike
+
+    get saas.billing_checkout_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "h2", text: "Unlimited"
+    assert_select "h2", text: "Unlimited+"
+    assert_select "strong", text: "$20/month"
+    assert_select "strong", text: "$25/month"
+  end
+
+  test "checkout creates unlimited session and redirects" do
+    sign_in_as :mike
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited"
+
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:mode] == "subscription" &&
+        params[:line_items].first[:price] == "price_unlimited" &&
+        params[:subscription_data][:metadata][:plan_key] == "unlimited"
+    end.returns(stub(url: "https://checkout.stripe.test/session"))
+
+    post saas.billing_checkout_path(script_name: @account.slug), params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  ensure
+    ENV.delete("STRIPE_UNLIMITED_PRICE_ID")
+  end
+
+  test "checkout creates unlimited plus session" do
+    sign_in_as :mike
+    ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = "price_plus"
+
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:line_items].first[:price] == "price_plus" &&
+        params[:subscription_data][:metadata][:plan_key] == "unlimited_plus"
+    end.returns(stub(url: "https://checkout.stripe.test/plus"))
+
+    post saas.billing_checkout_path(script_name: @account.slug), params: { plan: "unlimited_plus" }
+
+    assert_redirected_to "https://checkout.stripe.test/plus"
+  ensure
+    ENV.delete("STRIPE_UNLIMITED_PLUS_PRICE_ID")
+  end
+end
