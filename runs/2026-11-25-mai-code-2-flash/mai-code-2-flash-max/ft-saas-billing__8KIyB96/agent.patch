diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..27b022e
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff sees account list with names linking to account pages" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: @account.name
+  end
+
+  test "staff sees account plan override and reset controls" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+    end
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value='Override']"
+    assert_select "button", text: "Reset"
+  end
+
+  test "comp and uncomp update the account" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.comp_admin_account_path(@account)
+    end
+    assert @account.reload.comped?
+
+    untenanted do
+      post saas.uncomp_admin_account_path(@account)
+    end
+    assert_not @account.reload.comped?
+  end
+
+  test "override and reset update the account limits" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.override_admin_account_path(@account), params: { card_count: 950, bytes_used: 123 }
+    end
+
+    assert_equal 950, @account.reload.effective_cards_count
+    assert_equal 123, @account.bytes_used
+
+    untenanted do
+      delete saas.override_admin_account_path(@account)
+    end
+
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "non staff cannot access accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/billing/checkouts_controller_test.rb b/saas/test/controllers/billing/checkouts_controller_test.rb
