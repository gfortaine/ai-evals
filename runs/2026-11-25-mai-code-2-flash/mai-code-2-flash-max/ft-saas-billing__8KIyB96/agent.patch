diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..bd32b41
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,48 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  def active?
+    status.blank? || status.in?(%w[ active trialing past_due ])
+  end
+
+  def canceled?
+    status.in?(%w[ canceled cancelled unpaid incomplete_expired ])
+  end
+
+  def paid?
+    active? && normalized_plan_key.in?(%w[ unlimited unlimited_plus ])
+  end
+
+  def plan_name
+    case normalized_plan_key
+    when "unlimited"
+      "Unlimited"
+    when "unlimited_plus"
+      "Unlimited+"
+    else
+      "Free"
+    end
+  end
+
+  def key
+    normalized_plan_key
+  end
+
+  def normalized_plan_key
+    ::Subscription.normalize_plan_key(plan_key)
+  end
+
+  def plan_class
+    ::Subscription.for(normalized_plan_key)
+  end
+
+  def storage_limit
+    plan_class.storage_limit
+  end
+
+  def card_limit
+    plan_class.card_limit
+  end
+end
