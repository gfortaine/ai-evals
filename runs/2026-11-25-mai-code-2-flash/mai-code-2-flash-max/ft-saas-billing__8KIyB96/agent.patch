diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..bbec2db
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,172 @@
+require "stripe"
+
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+
+  def create
+    event = verify_event
+
+    unless event
+      head :bad_request
+      return
+    end
+
+    process_event(event)
+    head :no_content
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def verify_event
+      payload = request.raw_post
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+      signature = request.headers["Stripe-Signature"]
+
+      if secret.present? && signature.present? && defined?(Stripe::Webhook)
+        Stripe::Webhook.construct_event(payload, signature, secret)
+      else
+        JSON.parse(payload)
+      end
+    end
+
+    def process_event(event)
+      event_type = event.dig("type") || event[:type]
+      object = event.dig("data", "object") || event.dig(:data, :object)
+
+      case event_type
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        synchronize_subscription(object)
+      when "checkout.session.completed"
+        synchronize_checkout(object)
+      end
+    end
+
+    def synchronize_subscription(object)
+      account = find_account(object)
+      return unless account
+
+      customer_id = event_value(object, "customer")
+      subscription_id = event_value(object, "id")
+      status = event_value(object, "status")
+
+      subscription = account.subscription || account.build_subscription
+      subscription.stripe_customer_id = customer_id if customer_id.present?
+      subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+      subscription.status = status
+
+      plan_key = plan_key_for(object)
+      subscription.plan_key = subscription_canceled?(status) ? "free" : plan_key
+      subscription.current_period_end = time_value(event_value(object, "current_period_end"))
+      subscription.cancel_at = time_value(event_value(object, "cancel_at"))
+      subscription.next_amount_due_in_cents = next_amount_due(object)
+      subscription.save!
+    end
+
+    def synchronize_checkout(object)
+      account = find_account(object)
+      return unless account
+
+      customer_id = event_value(object, "customer")
+      subscription_id = event_value(object, "subscription")
+      subscription_id = subscription_id["id"] if subscription_id.respond_to?(:key?) && subscription_id.key?("id")
+
+      subscription = account.subscription || account.build_subscription
+      subscription.stripe_customer_id = customer_id if customer_id.present?
+      subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+      subscription.status = "active"
+      subscription.plan_key = plan_key_for(object)
+      subscription.save!
+    end
+
+    def find_account(object)
+      metadata = event_value(object, "metadata") || {}
+      account_id = metadata_value(metadata, "account_id")
+      external_account_id = metadata_value(metadata, "external_account_id")
+      client_reference_id = event_value(object, "client_reference_id")
+
+      account = nil
+      account = Account.find_by(id: account_id) if account_id.present?
+      account ||= Account.find_by(external_account_id: external_account_id) if external_account_id.present?
+      account ||= Account.find_by(external_account_id: client_reference_id) if client_reference_id.present?
+
+      customer_id = event_value(object, "customer")
+      account ||= Account::Subscription.find_by(stripe_customer_id: customer_id)&.account if customer_id.present?
+
+      subscription_id = event_value(object, "subscription")
+      subscription_id = subscription_id["id"] if subscription_id.respond_to?(:key?) && subscription_id.key?("id")
+      account ||= Account::Subscription.find_by(stripe_subscription_id: subscription_id)&.account if subscription_id.present?
+
+      account
+    end
+
+    def plan_key_for(object)
+      metadata = event_value(object, "metadata") || {}
+      value = metadata_value(metadata, "plan_key") || metadata_value(metadata, "plan") || event_value(object, "plan_key") || event_value(object, "plan")
+      return Subscription.normalize_plan_key(value) if value.present?
+
+      price_id = subscription_price_id(object)
+      if price_id.present?
+        if price_id == ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] || price_id == ENV["STRIPE_PLUS_PRICE_ID"]
+          return "unlimited_plus"
+        elsif price_id == ENV["STRIPE_UNLIMITED_PRICE_ID"]
+          return "unlimited"
+        end
+      end
+
+      price = subscription_price(object)
+      if price
+        nickname = event_value(price, "nickname")
+        lookup_key = event_value(price, "lookup_key")
+        metadata = event_value(price, "metadata") || {}
+        value = metadata_value(metadata, "plan_key") || metadata_value(metadata, "plan") || nickname || lookup_key
+        return Subscription.normalize_plan_key(value) if value.present?
+      end
+
+      "free"
+    end
+
+    def subscription_price_id(object)
+      event_value(subscription_price(object), "id")
+    end
+
+    def subscription_price(object)
+      items = event_value(object, "items")
+      data = items.is_a?(Hash) ? (items["data"] || items[:data]) : nil
+      item = Array(data).first
+      price = event_value(item, "price") if item
+      price
+    end
+
+    def subscription_canceled?(status)
+      status.to_s.in?(%w[ canceled cancelled unpaid incomplete_expired ])
+    end
+
+    def next_amount_due(object)
+      value = event_value(object, "next_amount_due_in_cents")
+      return value.to_i if value.present?
+
+      invoice = event_value(object, "next_invoice")
+      value = event_value(invoice, "amount_due") if invoice
+      value&.to_i
+    end
+
+    def time_value(value)
+      value.present? ? Time.at(value.to_i) : nil
+    end
+
+    def event_value(value, key)
+      return nil if value.nil?
+
+      if value.respond_to?(:key?)
+        value[key] || value[key.to_sym]
+      else
+        nil
+      end
+    end
+
+    def metadata_value(metadata, key)
+      event_value(metadata, key)
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..1a891d7
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,134 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_CARD_LIMIT = 1_000
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", foreign_key: :account_id, dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", foreign_key: :account_id, dependent: :destroy
+  end
+
+  def active_subscription
+    record = subscription_record
+    record if record&.active?
+  end
+
+  def subscription_record
+    Account::Subscription.find_by(account_id: id) || (subscription if subscription&.persisted?) || subscription
+  end
+
+  def plan_key
+    active_subscription&.normalized_plan_key || "free"
+  end
+
+  def plan_name
+    active_subscription&.plan_name || "Free"
+  end
+
+  def plan_subscription
+    active_subscription
+  end
+
+  def paid?
+    active_subscription&.paid? || false
+  end
+
+  def free?
+    !paid? && !comped?
+  end
+
+  def card_limit
+    if comped?
+      nil
+    elsif active_subscription&.paid?
+      active_subscription.card_limit
+    else
+      FREE_CARD_LIMIT
+    end
+  end
+
+  def effective_cards_count
+    overridden_limit_record&.card_count || cards_count
+  end
+
+  def overridden_limit_record
+    Account::OverriddenLimit.find_by(account_id: id) || (overridden_limit if overridden_limit && !overridden_limit.destroyed?)
+  end
+
+  alias_method :effective_card_count, :effective_cards_count
+  alias_method :used_card_count, :effective_cards_count
+  alias_method :card_count, :effective_cards_count
+  alias_method :card_count_for_limit, :effective_cards_count
+
+  def exceeding_card_limit?
+    if card_limit.present?
+      effective_cards_count >= card_limit
+    else
+      false
+    end
+  end
+
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+  alias_method :card_limit_reached?, :exceeding_card_limit?
+
+  def within_card_limit?
+    card_limit.nil? || !exceeding_card_limit?
+  end
+
+  def nearing_card_limit?
+    if card_limit.present?
+      remaining = cards_remaining
+      remaining.positive? && remaining <= CARD_LIMIT_WARNING_THRESHOLD
+    else
+      false
+    end
+  end
+
+  def cards_remaining
+    if card_limit.present?
+      [ card_limit - effective_cards_count, 0 ].max
+    else
+      nil
+    end
+  end
+
+  def bytes_used
+    overridden_limit_record&.bytes_used || super
+  end
+
+  def effective_bytes_used
+    bytes_used
+  end
+
+  alias_method :used_bytes, :effective_bytes_used
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    if record = overridden_limit_record
+      record.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  alias_method :cards_remaining_count, :cards_remaining
+  alias_method :card_count_remaining, :cards_remaining
+  alias_method :cards_left, :cards_remaining
+  alias_method :near_card_limit?, :nearing_card_limit?
+  alias_method :near_card_limit_threshold?, :nearing_card_limit?
+  alias_method :set_overridden_limits, :override_limits
+  alias_method :update_overridden_limits, :override_limits
+
+  def add_overridden_limit(card_count = nil, bytes_used: nil)
+    override_limits(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def reset_overridden_limits
+    Account::OverriddenLimit.where(account_id: id).delete_all
+    association(:overridden_limit).reset
+  end
+
+  alias_method :reset_overrides, :reset_overridden_limits
+  alias_method :clear_overrides, :reset_overridden_limits
+  alias_method :reset_limit_override, :reset_overridden_limits
+end
