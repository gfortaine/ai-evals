diff --git a/saas/test/controllers/card/card_limit_test.rb b/saas/test/controllers/card/card_limit_test.rb
new file mode 100644
index 0000000..0f8dcbd
--- /dev/null
+++ b/saas/test/controllers/card/card_limit_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Card::CardLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free account cannot create cards via JSON at the limit" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "free account can still create drafts at the limit" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "free account cannot publish at the limit" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "paid account can create cards via JSON" do
+    sign_in_as :mike
+    Account::Subscription.create!(
+      account: @account,
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      status: "active"
+    )
+    @account.update_column(:cards_count, 1_000)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Allowed card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "draft footer warns before the limit and offers upgrade at the limit" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_select "strong", text: /50 cards left/
+
+    @account.update_column(:cards_count, 1_000)
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+end
