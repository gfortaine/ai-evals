diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..ee1ae80
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.subscription&.destroy!
+    @account.overridden_limit&.destroy!
+    @account.billing_waiver&.destroy!
+  end
+
+  test "free plan has 1000 card and 1 GB limits" do
+    @account.update_column(:cards_count, 950)
+
+    assert_equal 1_000, @account.card_limit
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "free plan reaches card limit at 1000 cards" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid plans remove the card limit and add storage" do
+    Account::Subscription.create!(
+      account: @account,
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      status: "active"
+    )
+
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "unlimited plus adds 500 GB storage" do
+    Account::Subscription.create!(
+      account: @account,
+      plan_key: "unlimited_plus",
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      status: "active"
+    )
+
+    assert_equal "Unlimited+", @account.plan_name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comped account bypasses limits" do
+    @account.comp!
+
+    assert @account.comped?
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.exceeding_storage_limit?
+
+    @account.uncomp!
+    assert_not @account.comped?
+  end
+
+  test "override replaces effective card count and bytes used" do
+    @account.override_limits(card_count: 950, bytes_used: 123)
+
+    assert_equal 950, @account.effective_cards_count
+    assert_equal 50, @account.cards_remaining
+    assert_equal 123, @account.bytes_used
+
+    @account.reset_overridden_limits
+
+    assert_nil @account.overridden_limit
+  end
+end
