+require "stripe"
+
+class Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"] if ENV["STRIPE_SECRET_KEY"].present?
+    customer_id = Current.account.active_subscription&.stripe_customer_id
+
+    if customer_id.blank?
+      redirect_to saas.billing_checkout_path, alert: "Start a subscription before managing billing"
+      return
+    end
+
+    session = Stripe::BillingPortal::Session.create(
+      customer: customer_id,
+      return_url: account_settings_url(script_name: Current.account.slug)
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+end
