+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "subscription updated event sets paid plan" do
+    payload = {
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_test",
+          customer: "cus_test",
+          status: "active",
+          plan_key: "unlimited",
+          metadata: { account_id: @account.id },
+          current_period_end: 1.day.from_now.to_i
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload, as: :json
+
+    assert_response :no_content
+    subscription = @account.reload.subscription
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "cus_test", subscription.stripe_customer_id
+    assert_equal "sub_test", subscription.stripe_subscription_id
+  end
+
+  test "subscription deleted event removes paid plan" do
+    @account.subscription&.destroy!
+    @account.create_subscription!(
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_test",
+      stripe_subscription_id: "sub_test",
+      status: "active"
+    )
+
+    payload = {
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_test",
+          customer: "cus_test",
+          status: "canceled",
