+    when "unlimited+", "plus", "unlimitedplus", "unlimited_plus", "unlimited_plus_v1", "unlimitedplusv1"
+      "unlimited_plus"
+    else
+      "free"
+    end
+  end
+
+  def self.for(value)
+    case normalize_plan_key(value)
+    when "unlimited"
+      Unlimited
+    when "unlimited_plus"
