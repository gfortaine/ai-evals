diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..c0c1d32 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -1,6 +1,9 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  DELETED_AUTHOR = "Deleted author"
+  LEGACY_DEACTIVATED_EMAIL_PATTERN = /\A(.+)-deactivated-[^@]+@([^@]+)\z/i
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -17,16 +20,87 @@ class User < ApplicationRecord
     self == Current.user
   end
 
-  def deactivate
+  def erase
+    destroy
+  end
+
+  def delete
+    erase
+  end
+
+  def destroy
     transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+      erase_associated_data
+      super
     end
   end
 
+  alias_method :deactivate, :erase
+
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    def erase_associated_data
+      addresses = sign_in_email_addresses.map(&:downcase)
+      SignInEvent.where("LOWER(email_address) IN (?)", addresses).delete_all
+      sessions.delete_all
+      accesses.delete_all
+      reading_marks.delete_all
+
+      created_books.with_everyone_access.find_each do |book|
+        book.update!(creator: nil, author: DELETED_AUTHOR)
+      end
+
+      created_books.where.not(everyone_access: true).find_each do |book|
+        purge_private_book_data(book)
+        book.destroy!
+      end
+
+      sessions.reset
+      accesses.reset
+      reading_marks.reset
+      created_books.reset
+    end
+
+    def sign_in_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      if !active? && (match = email_address&.match(LEGACY_DEACTIVATED_EMAIL_PATTERN))
+        "#{match[1]}@#{match[2]}"
+      else
+        email_address
+      end
+    end
+
+    def purge_private_book_data(book)
+      purge_active_storage_for("Book", book.id)
+
+      book.leaves.find_each do |leaf|
+        leaf.send(:remove_from_search_index) if leaf.respond_to?(:remove_from_search_index, true)
+        purge_leafable_attachment_data(leaf.leafable)
+
+        leaf.edits.find_each do |edit|
+          purge_leafable_attachment_data(edit.leafable)
+        end
+      end
+    end
+
+    def purge_leafable_attachment_data(record)
+      return unless record
+
+      purge_active_storage_for(record.class.base_class.name, record.id)
+
+      if record.is_a?(Page)
+        ActionText::Markdown.where(record_type: "Page", record_id: record.id).find_each do |markdown|
+          purge_active_storage_for("ActionText::Markdown", markdown.id)
+        end
+      end
+    end
+
+    def purge_active_storage_for(record_type, record_id)
+      ActiveStorage::Attachment
+        .where(record_type: record_type, record_id: record_id)
+        .find_each(&:purge)
     end
 
     def grant_access_to_everyone_books
