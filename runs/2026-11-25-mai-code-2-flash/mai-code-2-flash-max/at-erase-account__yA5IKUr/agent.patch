+
+  test "destroy erases a legacy deactivated user" do
+    sign_in :david
+    user = users(:kevin)
+    original_address = user.email_address
+    legacy_address = "kevin-deactivated-#{SecureRandom.uuid}@example.com"
+    user.update!(active: false, email_address: legacy_address)
+    SignInEvent.create!(action: :signed_in, email_address: original_address)
+
+    delete user_url(user)
+
+    assert_redirected_to users_url
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.where(email_address: original_address).exists?
+    assert_not SignInEvent.where(email_address: legacy_address).exists?
+  end
 end
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..98bce1a 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,62 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase removes associated data and private books" do
+    user = User.create!(name: "Erased Person", email_address: "erased@example.com", password: "secret123456")
+    session = user.sessions.start!(user_agent: "Test", ip_address: "127.0.0.1")
+    reading_mark = ReadingMark.create!(user: user, leaf: leaves(:welcome_page), last_read_at: Time.current)
+    SignInEvent.create!(action: :signed_in, email_address: user.email_address)
+
+    shared_book = Book.create!(title: "Shared", author: user.name, everyone_access: true, creator: user)
+    private_leaf = Book.create!(title: "Private", author: user.name, everyone_access: false, creator: user)
+      .press(Page.new(body: "erasure-search-token"), title: "Private Page")
+    private_leaf.reindex
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(session.id)
+    assert_not ReadingMark.exists?(reading_mark.id)
+    assert_not SignInEvent.where(email_address: "erased@example.com").exists?
+    assert_not Access.exists?(user_id: user.id)
+    assert_not Book.exists?(title: "Private")
+    assert_not Leaf.search("erasure-search-token").exists?
+
+    assert shared_book.reload.persisted?
+    assert_nil shared_book.creator
+    assert_equal "Deleted author", shared_book.author
+  end
+
+  test "erase removes legacy deactivated user and their original sign-in events" do
+    user = User.create!(name: "Legacy User", email_address: "legacy-deactivated-#{SecureRandom.uuid}@example.com", password: "secret123456", active: false)
+    original_address = "legacy@example.com"
+    SignInEvent.create!(action: :signed_in, email_address: original_address)
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.where(email_address: original_address).exists?
+  end
+
+  test "erase purges private book attachments and edit leafables" do
+    user = User.create!(name: "Attachment User", email_address: "attachment-user@example.com", password: "secret123456")
+    book = Book.create!(title: "Private Attachments", everyone_access: false, creator: user)
+    book.cover.attach(io: File.open(Rails.root.join("test/fixtures/files/reading.webp")), filename: "reading.webp", content_type: "image/webp")
+
+    picture = Picture.new(caption: "Private picture")
+    picture.image.attach(io: File.open(Rails.root.join("test/fixtures/files/white-rabbit.webp")), filename: "white-rabbit.webp", content_type: "image/webp")
+    leaf = book.press(picture, title: "Private Picture")
+    leaf.edit leafable_params: { caption: "Updated private picture" }
+
+    blob_ids = [ book.cover.blob.id, picture.image.blob.id ]
+
+    user.erase
+
+    assert_not Book.exists?(book.id)
+    assert_not Picture.exists?(picture.id)
+    assert_not Leaf.exists?(leaf.id)
+    assert_not Edit.exists?(leaf_id: leaf.id)
+    assert_not ActiveStorage::Blob.where(id: blob_ids).exists?
+  end
 end
