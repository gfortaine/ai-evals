diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..7b19239 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,45 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy archives every current access and removes the accesses" do
+    book = Book.create!(title: "Archived Book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    assert_difference -> { AccessArchive.count }, +2 do
+      assert_difference -> { Access.count }, -2 do
+        assert_difference -> { Book.count }, -1 do
+          book.destroy!
+        end
+      end
+    end
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal "reader", archives.fetch(users(:jz).id).level
+    assert_equal "editor", archives.fetch(users(:kevin).id).level
+  end
+
+  test "destroy excludes an access revoked before deletion" do
+    book = Book.create!(title: "Revoked Access", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    assert_difference -> { AccessArchive.count }, +1 do
+      book.destroy!
+    end
+
+    archive = AccessArchive.where(book_id: book.id).sole
+    assert_equal users(:kevin).id, archive.user_id
+    assert_equal "editor", archive.level
+  end
+
+  test "destroying a book with no accesses creates no archives" do
+    book = Book.create!(title: "Private Book", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+  end
 end
