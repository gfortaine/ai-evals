@@ -0,0 +1,81 @@
+<%
+  app_host = ENV.fetch("APP_HOST", "fizzy.example.com")
+  server_host = ENV.fetch("SERVER_HOST", "203.0.113.10")
+  smtp_address = ENV.fetch("SMTP_ADDRESS", ENV.fetch("SMTP_HOST", "smtp.example.com"))
+  smtp_port = ENV.fetch("SMTP_PORT", "587")
+  mailer_from_address = ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <noreply@#{app_host}>")
+
+  github_repository = ENV["GITHUB_REPOSITORY"]
+  unless github_repository
+    origin = `git config --get remote.origin.url 2>/dev/null`.strip
+    github_repository = origin[%r{github\.com[:/](.+?)(?:\.git)?\z}, 1]
+  end
+  github_repository ||= "your-github-username/fizzy"
+%>
+
+service: fizzy
+image: <%= github_repository.downcase %>
+asset_path: /rails/public/assets
+secrets_path: .kamal/secrets
+
+servers:
+  web:
+    hosts:
+      - "<%= server_host %>"
+
+proxy:
+  ssl: true
+  host: "<%= app_host %>"
+  app_port: 80
+  forward_headers: true
+  healthcheck:
+    path: /up
+
+ssh:
+  user: <%= ENV.fetch("SSH_USER", "root") %>
+
+registry:
+  server: ghcr.io
+  username:
+    - KAMAL_REGISTRY_USERNAME
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: <%= ENV.fetch("KAMAL_ARCH", "amd64") %>
+
+volumes:
+  - fizzy:/rails/storage
+
+retain_containers: 2
+
+env:
+  clear:
+    RAILS_ENV: production
+    SAAS: "false"
+    DATABASE_ADAPTER: sqlite
+    APP_HOST: "<%= app_host %>"
+    APP_FQDN: "<%= app_host %>"
+    ASSUME_SSL: "true"
+    FORCE_SSL: "true"
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    JOB_CONCURRENCY: "1"
+    WEB_CONCURRENCY: "1"
+    RAILS_LOG_LEVEL: info
+    MAILER_FROM_ADDRESS: "<%= mailer_from_address %>"
+    SMTP_ADDRESS: "<%= ENV.fetch("SMTP_ADDRESS", ENV.fetch("SMTP_HOST", smtp_address)) %>"
+    SMTP_HOST: "<%= ENV.fetch("SMTP_HOST", ENV.fetch("SMTP_ADDRESS", smtp_address)) %>"
+    SMTP_PORT: "<%= smtp_port %>"
+    SMTP_DOMAIN: "<%= ENV.fetch("SMTP_DOMAIN", app_host) %>"
+    SMTP_AUTHENTICATION: "<%= ENV.fetch("SMTP_AUTHENTICATION", "") %>"
+    SMTP_ENABLE_STARTTLS_AUTO: "<%= ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") %>"
+    SMTP_TLS: "<%= ENV.fetch("SMTP_TLS", "false") %>"
+    SMTP_OPENSSL_VERIFY_MODE: "<%= ENV.fetch("SMTP_OPENSSL_VERIFY_MODE", "peer") %>"
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
