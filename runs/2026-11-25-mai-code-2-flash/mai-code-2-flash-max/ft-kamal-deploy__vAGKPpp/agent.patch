new file mode 100644
index 0000000..8eda28d
--- /dev/null
+++ b/.kamal/secrets.example
@@ -0,0 +1,20 @@
+# Copy this file to .kamal/secrets and fill in the values before kamal setup.
+
+# GitHub Container Registry credentials. The PAT needs read and write packages.
+KAMAL_REGISTRY_USERNAME=your-github-username
+KAMAL_REGISTRY_PASSWORD=replace-with-a-github-pat
+
+# Generate once with: bin/rails secret
+# Keep this value stable across deploys or existing sessions will be invalidated.
+SECRET_KEY_BASE=replace-with-a-long-random-secret
+
+# Optional unless this app uses Rails encrypted credentials.
+RAILS_MASTER_KEY=
+
+# Optional SMTP credentials. Leave both empty for a mail server with no authentication.
+SMTP_USERNAME=
+SMTP_PASSWORD=
+
+# Optional web-push keys. Generate with WebPush.generate_key in a Rails console.
+VAPID_PUBLIC_KEY=
+VAPID_PRIVATE_KEY=
