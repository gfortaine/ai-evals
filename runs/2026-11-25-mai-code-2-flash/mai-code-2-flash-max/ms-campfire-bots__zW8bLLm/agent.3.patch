diff --git a/test/jobs/bot/joined_webhook_job_test.rb b/test/jobs/bot/joined_webhook_job_test.rb
new file mode 100644
index 0000000..17471db
--- /dev/null
+++ b/test/jobs/bot/joined_webhook_job_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Bot::JoinedWebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(
+      name: "Deploy Bot",
+      creator: users(:david),
+      webhook_url: "https://example.com/hooks/deploy"
+    )
+    @room = rooms(:hq)
+  end
+
+  test "posts the joined payload and accepts a text synchronous reply once" do
+    stub_request(:post, @bot.webhook_url).with do |request|
+      payload = JSON.parse(request.body)
+
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal "joined", payload["event"]
+      assert_equal @room.id, payload["room"]["id"]
+      assert_equal @room.name, payload["room"]["name"]
+      assert_equal "/rooms/#{@room.id}/#{@bot.bot_code}/messages", payload["room"]["reply_to"]
+
+      true
+    end.to_return(status: 200, body: "Hello from the bot", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::JoinedWebhookJob.new.perform(@bot, @room)
+      Bot::JoinedWebhookJob.new.perform(@bot, @room)
+    end
+
+    reply = Message.order(:created_at).last
+    assert_equal @bot, reply.creator
+    assert_equal @room, reply.room
+    assert_equal "Hello from the bot", reply.plain_text_body
+  end
+
+  test "accepts an HTML synchronous reply" do
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      body: "<div>Hello from the bot</div>",
+      headers: { "Content-Type" => "text/html" }
+    )
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::JoinedWebhookJob.new.perform(@bot, @room)
+    end
+
+    assert_equal "Hello from the bot", Message.order(:created_at).last.plain_text_body
+  end
+
+  test "does not post or create an event for a direct room" do
+    direct = rooms(:david_and_jason)
+
+    stub = stub_request(:post, @bot.webhook_url).to_return(status: 200, body: "Hello")
+
+    assert_no_difference -> { Message.count } do
+      Bot::JoinedWebhookJob.new.perform(@bot, direct)
+    end
+
+    assert_not_requested stub
+    assert_not BotRoomJoinEvent.exists?(bot: @bot, room: direct)
+  end
+
+  test "204 does not post a reply" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      Bot::JoinedWebhookJob.new.perform(@bot, @room)
+    end
+  end
+end
