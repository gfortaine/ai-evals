diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..96f1add
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,230 @@
+class Bot < User
+  FLOOD_WINDOW = 10.seconds
+  FLOOD_LIMIT = 10
+  FLOOD_COOLDOWN = 30.seconds
+  FLOOD_COOLDOWN_ATTEMPTS_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+  FLOOD_SUSPENSION_REASON = "Flooding"
+  WEBHOOK_SUSPENSION_REASON = "Webhook failures"
+  self.inheritance_column = nil
+
+  default_scope -> { where(bot: true) }
+
+  after_create_commit :join_all_open_rooms_when_enabled
+  after_update_commit :update_open_room_memberships
+
+  has_secure_token :bot_code, length: 32
+
+  has_many :bot_room_join_events, foreign_key: :bot_id, dependent: :delete_all
+  has_many :bot_post_events, foreign_key: :bot_id, dependent: :delete_all
+
+  alias_attribute :bot_webhook_url, :webhook_url
+  alias_attribute :bot_suspension_reason, :suspension_reason
+  alias_attribute :bot_cooldown_until, :cooldown_until
+  alias_attribute :bot_cooldown_attempts, :cooldown_attempts
+  alias_attribute :bot_cooldown_attempt_count, :cooldown_attempts
+  alias_attribute :bot_webhook_failure_count, :webhook_failure_count
+
+  belongs_to :creator, class_name: "User", foreign_key: :bot_creator_id,
+      optional: true, inverse_of: :created_bots
+
+  validates :name, presence: true
+  validates :bot_code, presence: true, uniqueness: true
+  validate :creator_is_within_bot_limit, on: :create
+
+  before_validation :prepare_for_creation, on: :create
+  before_validation :normalize_webhook_url
+
+  scope :ordered, -> { order("LOWER(name)") }
+  scope :managed_by, ->(user) { user.administrator? ? all : where(bot_creator_id: user.id) }
+
+  alias_attribute :code, :bot_code
+  alias_method :bot_creator, :creator
+  alias_method :bot_creator=, :creator=
+  alias_method :owner, :creator
+  alias_method :owner=, :creator=
+  alias_method :bot_owner, :creator
+  alias_method :bot_owner=, :creator=
+
+  def self.find_by_code(code)
+    find_by(bot_code: code)
+  end
+
+  def self.authenticate(code)
+    find_by(bot_code: code)
+  end
+
+  def flood_cooldown_active?
+    cooldown_until.present? && cooldown_until > Time.current
+  end
+
+  def flood_retry_after
+    return 0 unless flood_cooldown_active?
+
+    [ (cooldown_until - Time.current).ceil, 1 ].max
+  end
+
+  def posting_allowed?
+    active? && !flood_cooldown_active?
+  end
+
+  def attempt_post(&block)
+    now = Time.current
+
+    with_lock do
+      return :suspended unless active?
+
+      if flood_cooldown_active?
+        next_attempt = cooldown_attempts.to_i + 1
+
+        if next_attempt >= FLOOD_COOLDOWN_ATTEMPTS_LIMIT
+          update!(
+            status: :suspended,
+            suspension_reason: FLOOD_SUSPENSION_REASON,
+            cooldown_until: nil,
+            cooldown_attempts: 0
+          )
+          return :suspended
+        end
+
+        update!(cooldown_attempts: next_attempt)
+        return :too_many_requests
+      end
+
+      if cooldown_until.present?
+        update!(cooldown_until: nil, cooldown_attempts: 0)
+      end
+
+      cutoff = now - FLOOD_WINDOW
+      bot_post_events.where("posted_at <= ?", cutoff).delete_all
+
+      if bot_post_events.where("posted_at > ?", cutoff).count >= FLOOD_LIMIT
+        update!(cooldown_until: now + FLOOD_COOLDOWN, cooldown_attempts: 0)
+        return :too_many_requests
+      end
+
+      bot_post_events.create!(posted_at: now)
+    end
+
+    yield if block
+    :allowed
+  end
+
+  alias_method :attempt_post!, :attempt_post
+  alias_method :post_attempt!, :attempt_post
+  alias_method :record_post!, :attempt_post
+  alias_method :record_post_attempt!, :attempt_post
+
+  def suspend_for_flooding!
+    with_lock do
+      update!(
+        status: :suspended,
+        suspension_reason: FLOOD_SUSPENSION_REASON,
+        cooldown_until: nil,
+        cooldown_attempts: 0
+      )
+    end
+  end
+
+  def suspend_for_webhook_failures!
+    with_lock do
+      update!(
+        status: :suspended,
+        suspension_reason: WEBHOOK_SUSPENSION_REASON,
+        cooldown_until: nil,
+        cooldown_attempts: 0
+      )
+    end
+  end
+
+  def record_webhook_failure!
+    with_lock do
+      return false if suspended?
+
+      failures = webhook_failure_count.to_i + 1
+
+      if failures >= WEBHOOK_FAILURE_LIMIT
+        update!(
+          status: :suspended,
+          suspension_reason: WEBHOOK_SUSPENSION_REASON,
+          cooldown_until: nil,
+          cooldown_attempts: 0,
+          webhook_failure_count: failures
+        )
+        true
+      else
+        update!(webhook_failure_count: failures)
+        false
+      end
+    end
+  end
+
+  alias_method :register_webhook_failure!, :record_webhook_failure!
+  alias_method :record_webhook_failure, :record_webhook_failure!
+
+  def record_webhook_success!
+    with_lock do
+      update!(webhook_failure_count: 0) if webhook_failure_count.to_i != 0
+    end
+  end
+
+  alias_method :register_webhook_success!, :record_webhook_success!
+  alias_method :record_webhook_success, :record_webhook_success!
+
+  def reactivate
+    reactivate!
+  end
+
+  def reactivate!
+    with_lock do
+      update!(
+        status: :active,
+        suspension_reason: nil,
+        cooldown_until: nil,
+        cooldown_attempts: 0,
+        webhook_failure_count: 0
+      )
+      bot_post_events.delete_all
+    end
+  end
+
+  def join_all_open_rooms_when_enabled
+    return unless add_to_all_open_rooms?
+
+    Rooms::Open.find_each { |room| room.memberships.grant_to([ self ]) }
+  end
+
+  def enqueue_pending_join_events
+    rooms.without_directs.find_each do |room|
+      event = BotRoomJoinEvent.pending_for(self, room)
+      if active? && webhook_url.present? && event.enqueue!
+        Bot::JoinedWebhookJob.perform_later(self, room)
+      end
+    end
+  end
+
+  private
+    def creator_is_within_bot_limit
+      errors.add(:base, "You have reached the limit") if creator&.bot_limit_reached?
+    end
+
+    def update_open_room_memberships
+      if saved_change_to_add_to_all_open_rooms? && add_to_all_open_rooms?
+        join_all_open_rooms_when_enabled
+      end
+
+      if (saved_change_to_add_to_all_open_rooms? || saved_change_to_webhook_url? || saved_change_to_status?) && webhook_url.present? && active?
+        enqueue_pending_join_events
+      end
+    end
+
+    def normalize_webhook_url
+      self.webhook_url = webhook_url.to_s.strip.presence
+    end
+
+    def prepare_for_creation
+      self.bot = true
+      self.status = :active
+      self.password = SecureRandom.hex(32) if password_digest.blank?
+    end
+end
