+class BotRoomJoinEvent < ApplicationRecord
+  belongs_to :bot, class_name: "Bot"
+  belongs_to :room
+
+  validates :bot_id, uniqueness: { scope: :room_id }
+
+  def self.pending_for(bot, room)
+    find_or_create_by!(bot_id: bot.id, room_id: room.id)
+  end
+
+  def enqueue!
+    with_lock do
+      if queued_at.nil? && dispatched_at.nil?
+        update!(queued_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def claim!
+    with_lock do
+      if dispatched_at.nil?
+        update!(dispatched_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  end
+end
