@@ -0,0 +1,95 @@
+require "net/http"
+require "uri"
+
+class Bot::MentionWebhookJob < ApplicationJob
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  def perform(bot, message)
+    return unless bot.active? && bot.webhook_url.present?
+
+    begin
+      uri = URI.parse(bot.webhook_url)
+      raise URI::InvalidURIError unless uri.is_a?(URI::HTTP)
+
+      response = Net::HTTP.start(
+        uri.host,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT
+      ) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri)
+        request["Content-Type"] = "application/json"
+        request.body = payload_for(bot, message).to_json
+        http.request(request)
+      end
+    rescue StandardError => error
+      bot.record_webhook_failure!
+      Rails.logger.warn "Bot webhook failed for bot #{bot&.id}: #{error.class}: #{error.message}"
+      return
+    end
+
+    if response.is_a?(Net::HTTPSuccess)
+      bot.record_webhook_success!
+      post_synchronous_reply(bot, message, response)
+    else
+      bot.record_webhook_failure!
+    end
+  end
+
+  private
+    def payload_for(bot, message)
+      {
+        event: "mention",
+        author: {
+          id: message.creator.id,
+          name: message.creator.name
+        },
+        room: {
+          id: message.room.id,
+          name: room_name(message),
+          reply_to: "/rooms/#{message.room.id}/#{bot.bot_code}/messages"
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: mention_text(message, bot),
+            html: message.body&.body&.to_html.to_s
+          },
+          link: "/rooms/#{message.room.id}/@#{message.id}"
+        }
+      }
+    end
+
+    def room_name(message)
+      if message.room.direct?
+        message.room.users.without(message.creator).pluck(:name).to_sentence.presence || message.creator.name
+      else
+        message.room.name
+      end
+    end
+
+    def mention_text(message, bot)
+      text = message.body&.to_plain_text.to_s
+      text = text.gsub(/@#{Regexp.escape(bot.name)}/i, "")
+      text = text.gsub(/\A[[:space:],:;]+/, "")
+      text.gsub(/[[:space:]]+/, " ").strip
+    end
+
+    def post_synchronous_reply(bot, message, response)
+      return unless response.is_a?(Net::HTTPOK)
+      return unless bot.active?
+
+      content_type = response["Content-Type"].to_s.split(";", 2).first.to_s.strip.downcase
+      return unless %w[text/plain text/html].include?(content_type)
+
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+      return if body.strip.blank?
+
+      bot.attempt_post do
+        reply = message.room.messages.create_with_attachment!(creator: bot, body: body)
+        reply.broadcast_create
+      end
+    end
+end
diff --git a/app/jobs/bot/webhook_job.rb b/app/jobs/bot/webhook_job.rb
