@@ -0,0 +1,133 @@
+require "test_helper"
+
+class Bot::MentionWebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(
+      name: "Deploy Bot",
+      creator: users(:david),
+      webhook_url: "https://example.com/hooks/deploy"
+    )
+    @room = rooms(:hq)
+  end
+
+  test "posts the mention payload and accepts a text synchronous reply" do
+    message = mention_message("restart the build please")
+
+    stub_request(:post, @bot.webhook_url).with do |request|
+      payload = JSON.parse(request.body)
+
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal "mention", payload["event"]
+      assert_equal users(:david).id, payload["author"]["id"]
+      assert_equal "David", payload["author"]["name"]
+      assert_equal @room.id, payload["room"]["id"]
+      assert_equal @room.name, payload["room"]["name"]
+      assert_equal "/rooms/#{@room.id}/#{@bot.bot_code}/messages", payload["room"]["reply_to"]
+      assert_equal "restart the build please", payload["message"]["body"]["text"]
+      assert_includes payload["message"]["body"]["html"], "Deploy Bot"
+      assert_equal "/rooms/#{@room.id}/@#{message.id}", payload["message"]["link"]
+
+      true
+    end.to_return(status: 200, body: "Build complete", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::MentionWebhookJob.new.perform(@bot, message)
+    end
+
+    reply = Message.order(:created_at).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build complete", reply.plain_text_body
+  end
+
+  test "accepts an HTML synchronous reply" do
+    message = mention_message("restart")
+
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      body: "<div>Build complete</div>",
+      headers: { "Content-Type" => "text/html" }
+    )
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::MentionWebhookJob.new.perform(@bot, message)
+    end
+
+    assert_equal "Build complete", Message.order(:created_at).last.plain_text_body
+  end
+
+  test "204 does not post a reply" do
+    message = mention_message("restart")
+
+    stub_request(:post, @bot.webhook_url).to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      Bot::MentionWebhookJob.new.perform(@bot, message)
+    end
+  end
+
+  test "other 200 content types do not post a reply" do
+    message = mention_message("restart")
+
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      body: '{"ok":true}',
+      headers: { "Content-Type" => "application/json" }
+    )
+
+    assert_no_difference -> { Message.count } do
+      Bot::MentionWebhookJob.new.perform(@bot, message)
+    end
+  end
+
+test "ten consecutive failed deliveries suspend the bot" do
+  message = mention_message("restart")
+  stub_request(:post, @bot.webhook_url).to_return(status: 500)
+
+  10.times do
+    Bot::MentionWebhookJob.new.perform(@bot, message)
+  end
+
+  assert @bot.reload.suspended?
+  assert_equal Bot::WEBHOOK_SUSPENSION_REASON, @bot.suspension_reason
+  assert_equal 10, @bot.webhook_failure_count
+end
+
+test "timeouts count as failed deliveries" do
+  message = mention_message("restart")
+  stub_request(:post, @bot.webhook_url).to_timeout
+
+  Bot::MentionWebhookJob.new.perform(@bot, message)
+
+  assert_equal 1, @bot.reload.webhook_failure_count
+end
+
+test "a successful delivery resets consecutive failures" do
+  message = mention_message("restart")
+  stub_request(:post, @bot.webhook_url).to_return([ { status: 500 }, { status: 204 } ])
+
+  Bot::MentionWebhookJob.new.perform(@bot, message)
+  assert_equal 1, @bot.reload.webhook_failure_count
+
+  Bot::MentionWebhookJob.new.perform(@bot, message)
+  assert_equal 0, @bot.reload.webhook_failure_count
+end
+
+test "suspended bots receive no webhooks" do
+  message = mention_message("restart")
+  @bot.update!(status: :suspended, suspension_reason: Bot::WEBHOOK_SUSPENSION_REASON)
+  stub = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+
+  Bot::MentionWebhookJob.new.perform(@bot, message)
+
+  assert_not_requested stub
+end
+
+private
+    def mention_message(command)
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for_bot(@bot)} #{command}</div>",
+        client_message_id: "bot-mention-#{command}-#{SecureRandom.hex(4)}"
+      )
+    end
+end
