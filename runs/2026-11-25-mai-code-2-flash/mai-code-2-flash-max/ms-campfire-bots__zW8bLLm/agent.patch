diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..df44cdf
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "raw body creates a bot message and returns the location" do
+    assert_difference -> { Message.count }, 1 do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Deploy of v1.2.3 finished ✅"
+    end
+
+    message = Message.order(:created_at).last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.location
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "invalid bot code is unauthorized" do
+    post room_bot_messages_url(@room, "not-a-valid-code"), params: "Deploy finished"
+
+    assert_response :unauthorized
+  end
+
+  test "bad room id is not found" do
+    post room_bot_messages_url(-1, @bot.bot_code), params: "Deploy finished"
+
+    assert_response :not_found
+  end
+
+  test "room without bot membership is not found" do
+    post room_bot_messages_url(rooms(:watercooler), @bot.bot_code), params: "Deploy finished"
+
+    assert_response :not_found
+  end
+
+  test "empty body is unprocessable" do
+    post room_bot_messages_url(@room, @bot.bot_code), params: ""
+
+    assert_response :unprocessable_entity
+  end
+
+  test "attachment-only bot message is accepted" do
+    assert_difference -> { Message.count }, 1 do
+      post room_bot_messages_url(@room, @bot.bot_code), params: {
+        attachment: fixture_file_upload("moon.jpg", "image/jpeg")
+      }
+    end
+
+    assert_response :created
+    assert_equal "moon.jpg", Message.order(:created_at).last.plain_text_body
+  end
+
+  test "deleted bot can no longer post" do
+    bot_code = @bot.bot_code
+    @bot.destroy!
+
+    post room_bot_messages_url(@room, bot_code), params: "Deploy finished"
+
+    assert_response :unauthorized
+  end
+
+test "the eleventh message is rejected with retry information" do
+  10.times do |index|
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Message #{index + 1}"
+    assert_response :created
+  end
+
+  assert_no_difference -> { Message.count } do
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Message 11"
+  end
+
+  assert_response :too_many_requests
+  retry_after = response.headers["Retry-After"].to_i
+  assert_operator retry_after, :>, 0
+  assert_operator retry_after, :<=, 30
+end
+
+test "five cooldown attempts suspend the bot and it gets forbidden" do
+  10.times { |index| post room_bot_messages_url(@room, @bot.bot_code), params: "Message #{index + 1}" }
+  post room_bot_messages_url(@room, @bot.bot_code), params: "Triggering message"
+  assert_response :too_many_requests
+
+  4.times do
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Cooldown attempt"
+    assert_response :too_many_requests
+  end
+
+  post room_bot_messages_url(@room, @bot.bot_code), params: "Suspending attempt"
+  assert_response :forbidden
+
+  assert @bot.reload.suspended?
+  assert_equal Bot::FLOOD_SUSPENSION_REASON, @bot.suspension_reason
+
+  post room_bot_messages_url(@room, @bot.bot_code), params: "After suspension"
+  assert_response :forbidden
+end
+
+test "cooldown expires after thirty seconds and posting resumes" do
+  travel_to Time.current do
+    10.times { |index| post room_bot_messages_url(@room, @bot.bot_code), params: "Message #{index + 1}" }
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Trigger"
+    assert_response :too_many_requests
+
+    travel 30.seconds
+
+    post room_bot_messages_url(@room, @bot.bot_code), params: "After cooldown"
+    assert_response :created
+  end
+end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..48d0774
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,204 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "account link and bots index" do
+    get edit_account_url
+    assert_response :success
+    assert_select "a", text: "Set up chat bots"
+
+    get bots_url
+    assert_response :success
+    assert_select "a", text: "Add a chat bot"
+  end
+
+  test "create a bot" do
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    bot = Bot.find_by!(name: "Deploy Bot")
+    assert_equal users(:david), bot.creator
+    assert bot.bot_code.present?
+    assert_redirected_to bots_url
+  end
+
+  test "member only sees and manages their own bots" do
+    own_bot = Bot.create!(name: "My Bot", creator: users(:jz))
+    other_bot = Bot.create!(name: "Other Bot", creator: users(:david))
+
+    sign_in :jz
+
+    get bots_url
+    assert_response :success
+    assert_select "strong", text: "My Bot"
+    assert_select "strong", text: "Other Bot", count: 0
+
+    get edit_bot_url(own_bot)
+    assert_response :success
+
+    get edit_bot_url(other_bot)
+    assert_response :not_found
+  end
+
+  test "administrator sees all bots with read only codes and edit links" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:jz))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "label", text: /Bot code/
+    assert_select "input[readonly][value='#{bot.bot_code}']"
+    assert_select "a", text: "Edit Deploy Bot"
+  end
+
+  test "create and update a bot webhook URL" do
+    post bots_url, params: { bot: { name: "Deploy Bot", webhook_url: "  https://example.com/hooks/deploy  " } }
+
+    bot = Bot.find_by!(name: "Deploy Bot")
+    assert_equal "https://example.com/hooks/deploy", bot.webhook_url
+
+    patch bot_url(bot), params: { bot: { webhook_url: "" } }
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "bot forms label and submit the add to all open rooms switch" do
+    get new_bot_url
+    assert_response :success
+    assert_select "label", text: /Add to all open rooms/
+    assert_select "input[type='checkbox'][name='bot[add_to_all_open_rooms]'][aria-label='Add to all open rooms']"
+
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "1" } }
+    assert bot.reload.add_to_all_open_rooms?
+
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "0" } }
+    assert_not bot.reload.add_to_all_open_rooms?
+  end
+
+  test "bot forms label the webhook URL" do
+    get new_bot_url
+    assert_response :success
+    assert_select "label", text: /Webhook URL/
+    assert_select "input[aria-label='Webhook URL'][placeholder='Webhook URL']"
+
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://example.com/hook")
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "input[name='bot[webhook_url]'][value='https://example.com/hook']"
+  end
+
+  test "update and delete a bot" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "member is blocked at the bot limit and deleting frees a slot" do
+    sign_in :jz
+    accounts(:signal).update!(settings: { "bots_per_member" => "1" })
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "First Bot" } }
+    end
+
+    bot = Bot.find_by!(name: "First Bot")
+
+    get bots_url
+    assert_response :success
+    assert_select "a", text: "Add a chat bot", count: 0
+    assert_select "p", text: /reached the limit/
+
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "Second Bot" } }
+    end
+    assert_response :forbidden
+
+    get new_bot_url
+    assert_response :forbidden
+
+    delete bot_url(bot)
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Replacement Bot" } }
+    end
+  end
+
+  test "lowering the bot limit does not remove existing bots" do
+    sign_in :jz
+    3.times { |index| Bot.create!(name: "Existing Bot #{index}", creator: users(:jz)) }
+
+    accounts(:signal).update!(settings: { "bots_per_member" => "1" })
+
+    get bots_url
+    assert_response :success
+    assert_select "strong", text: /Existing Bot/, count: 3
+    assert_select "a", text: "Add a chat bot", count: 0
+    assert_select "p", text: /reached the limit/
+  end
+
+  test "administrator is not limited by bots per member" do
+    accounts(:signal).update!(settings: { "bots_per_member" => "0" })
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Admin Bot" } }
+    end
+
+    get bots_url
+    assert_response :success
+    assert_select "a", text: "Add a chat bot"
+  end
+
+  test "name is required" do
+    post bots_url, params: { bot: { name: "" } }
+
+    assert_response :unprocessable_entity
+  end
+
+test "administrator sees suspended state and reactivates with confirmation" do
+  bot = Bot.create!(name: "Suspended Bot", creator: users(:jz))
+  bot.update!(status: :suspended, suspension_reason: Bot::WEBHOOK_SUSPENSION_REASON, webhook_failure_count: 10)
+
+  get bots_url
+
+  assert_response :success
+  assert_select "strong", text: "Suspended"
+  assert_select "strong", text: "Suspended Bot"
+  assert_select "li", text: /Webhook failures/
+  assert_select "button", text: "Reactivate", count: 1
+  assert_select "button[data-turbo-confirm='Are you sure you want to reactivate this bot?']", count: 1
+
+  post reactivate_bot_url(bot)
+
+  assert_redirected_to bots_url
+  assert bot.reload.active?
+  assert_nil bot.suspension_reason
+  assert_equal 0, bot.webhook_failure_count
+end
+
+test "only administrators can reactivate suspended bots" do
+  bot = Bot.create!(name: "Owned Bot", creator: users(:jz))
+  bot.update!(status: :suspended, suspension_reason: Bot::FLOOD_SUSPENSION_REASON)
+
+  sign_in :jz
+
+  get bots_url
+  assert_response :success
+  assert_select "strong", text: "Suspended"
+  assert_select "button", text: "Reactivate", count: 0
+
+  post reactivate_bot_url(bot)
+  assert_response :forbidden
+  assert bot.reload.suspended?
+end
+end
