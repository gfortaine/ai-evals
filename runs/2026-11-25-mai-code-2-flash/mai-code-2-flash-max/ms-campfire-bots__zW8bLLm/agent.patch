diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..12d0f58
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "creating a bot does not grant membership to open rooms by default" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert bot.bot?
+    assert bot.bot_code.present?
+    assert_not bot.add_to_all_open_rooms?
+    assert_empty bot.rooms
+  end
+
+  test "a member bot cannot be created over the account limit" do
+    account = accounts(:signal)
+    account.update!(settings: { "bots_per_member" => "1" })
+    member = users(:jz)
+
+    Bot.create!(name: "First Bot", creator: member)
+    bot = Bot.new(name: "Second Bot", creator: member)
+
+    assert_not bot.save
+    assert_match(/reached the limit/, bot.errors[:base].join)
+  end
+
+  test "the add to all open rooms switch joins existing open rooms" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    bot.update!(add_to_all_open_rooms: true)
+
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "turning off the add to all open rooms switch keeps memberships" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david), add_to_all_open_rooms: true)
+    room_ids = bot.rooms.pluck(:id)
+
+    bot.update!(add_to_all_open_rooms: false)
+
+    assert_equal room_ids.sort, bot.reload.rooms.pluck(:id).sort
+  end
+
+  test "bot codes are unique" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert Bot.authenticate(bot.bot_code)
+    assert_not_equal bot.bot_code, Bot.create!(name: "Other Bot", creator: users(:david)).bot_code
+  end
+
+  test "new open rooms only grant membership to opted-in bots" do
+    opted_in = Bot.create!(name: "Opted In Bot", creator: users(:david), add_to_all_open_rooms: true)
+    opted_out = Bot.create!(name: "Opted Out Bot", creator: users(:david))
+
+    room = Rooms::Open.create!(name: "New Open Room", creator: users(:david))
+
+    assert_includes room.users, opted_in
+    assert_not_includes room.users, opted_out
+  end
+
+test "ten posts are allowed and the eleventh starts flooding cooldown" do
+  bot = Bot.create!(name: "Flood Bot", creator: users(:david))
+
+  10.times do
+    assert_equal :allowed, bot.attempt_post
+  end
+
+  assert_equal :too_many_requests, bot.attempt_post
+  assert bot.reload.flood_cooldown_active?
+  assert_equal 0, bot.cooldown_attempts
+end
+
+test "five post attempts during flooding cooldown suspend the bot" do
+  bot = Bot.create!(name: "Flood Bot", creator: users(:david))
+
+  10.times { bot.attempt_post }
+  assert_equal :too_many_requests, bot.attempt_post
+
+  4.times do
+    assert_equal :too_many_requests, bot.attempt_post
+  end
+  assert_equal :suspended, bot.attempt_post
+
+  assert bot.reload.suspended?
+  assert_equal Bot::FLOOD_SUSPENSION_REASON, bot.suspension_reason
+end
+
+test "the flooding window excludes posts exactly ten seconds old" do
+  bot = Bot.create!(name: "Flood Bot", creator: users(:david))
+
+  travel_to Time.current do
+    10.times { bot.attempt_post }
+    travel 10.seconds
+    assert_equal :allowed, bot.attempt_post
+  end
+end
+
+test "ten consecutive webhook failures suspend and success resets the count" do
+  bot = Bot.create!(name: "Failing Bot", creator: users(:david))
+
+  9.times do
+    assert_not bot.record_webhook_failure!
+  end
+  assert_equal 9, bot.reload.webhook_failure_count
+
+  assert bot.record_webhook_failure!
+  assert bot.reload.suspended?
+  assert_equal Bot::WEBHOOK_SUSPENSION_REASON, bot.suspension_reason
+  assert_equal 10, bot.webhook_failure_count
+
+  bot.reactivate!
+  assert bot.reload.active?
+  assert_nil bot.suspension_reason
+  assert_equal 0, bot.webhook_failure_count
+end
+
+test "a successful webhook delivery resets consecutive failures" do
+  bot = Bot.create!(name: "Recovering Bot", creator: users(:david))
+
+  3.times { bot.record_webhook_failure! }
+  bot.record_webhook_success!
+
+  assert_equal 0, bot.reload.webhook_failure_count
+end
+end
