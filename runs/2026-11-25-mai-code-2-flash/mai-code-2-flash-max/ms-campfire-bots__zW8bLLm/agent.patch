@@ -0,0 +1,9 @@
+class Bot::WebhookJob < ApplicationJob
+  def perform(bot, subject)
+    if subject.is_a?(Message)
+      Bot::MentionWebhookJob.new.perform(bot, subject)
+    elsif subject.is_a?(Room)
+      Bot::JoinedWebhookJob.new.perform(bot, subject)
+    end
+  end
+end
