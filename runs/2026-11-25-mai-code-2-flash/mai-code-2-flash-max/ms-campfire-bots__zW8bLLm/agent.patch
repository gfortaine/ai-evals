diff --git a/app/jobs/bot/joined_webhook_job.rb b/app/jobs/bot/joined_webhook_job.rb
new file mode 100644
index 0000000..bae1314
--- /dev/null
+++ b/app/jobs/bot/joined_webhook_job.rb
@@ -0,0 +1,72 @@
+require "net/http"
+require "uri"
+
+class Bot::JoinedWebhookJob < ApplicationJob
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  def perform(bot, room)
+    return if room.direct?
+    return unless bot.active? && bot.webhook_url.present?
+
+    event = BotRoomJoinEvent.pending_for(bot, room)
+    return unless event.claim!
+
+    begin
+      uri = URI.parse(bot.webhook_url)
+      raise URI::InvalidURIError unless uri.is_a?(URI::HTTP)
+
+      response = Net::HTTP.start(
+        uri.host,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT
+      ) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri)
+        request["Content-Type"] = "application/json"
+        request.body = payload_for(bot, room).to_json
+        http.request(request)
+      end
+    rescue StandardError => error
+      bot.record_webhook_failure!
+      Rails.logger.warn "Bot joined webhook failed for bot #{bot&.id}: #{error.class}: #{error.message}"
+      return
+    end
+
+    if response.is_a?(Net::HTTPSuccess)
+      bot.record_webhook_success!
+      post_synchronous_reply(bot, room, response)
+    else
+      bot.record_webhook_failure!
+    end
+  end
+
+  private
+    def payload_for(bot, room)
+      {
+        event: "joined",
+        room: {
+          id: room.id,
+          name: room.name,
+          reply_to: "/rooms/#{room.id}/#{bot.bot_code}/messages"
+        }
+      }
+    end
+
+    def post_synchronous_reply(bot, room, response)
+      return unless response.is_a?(Net::HTTPOK)
+      return unless bot.active?
+
+      content_type = response["Content-Type"].to_s.split(";", 2).first.to_s.strip.downcase
+      return unless %w[text/plain text/html].include?(content_type)
+
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+      return if body.strip.blank?
+
+      bot.attempt_post do
+        reply = room.messages.create_with_attachment!(creator: bot, body: body)
+        reply.broadcast_create
+      end
+    end
+end
