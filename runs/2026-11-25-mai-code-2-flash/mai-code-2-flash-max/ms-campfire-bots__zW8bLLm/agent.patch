diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..bd8a5af
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,73 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    bot = Bot.authenticate(params[:bot_code])
+    return head :unauthorized unless bot
+    return head :forbidden unless bot.active?
+
+    post_reserved = false
+
+    if bot.flood_cooldown_active?
+      posting_status = bot.attempt_post
+
+      case posting_status
+      when :too_many_requests
+        response.set_header("Retry-After", bot.reload.flood_retry_after.to_s)
+        return head :too_many_requests
+      when :suspended
+        return head :forbidden
+      when :allowed
+        post_reserved = true
+      end
+    end
+
+    room = Room.find_by(id: params[:room_id])
+    return head :not_found unless room
+    return head :not_found unless room.memberships.exists?(user_id: bot.id)
+
+    attachment = params[:attachment] || params.dig(:message, :attachment)
+    body = request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+
+    if body.blank? || (attachment.present? && request.form_data?)
+      body = params[:body].presence || params.dig(:message, :body).presence || ""
+    elsif params[:body].present? && body.start_with?("body=")
+      body = params[:body]
+    end
+
+    return head :unprocessable_entity if body.strip.blank? && attachment.blank?
+
+    message = nil
+
+    if post_reserved
+      message = room.messages.create_with_attachment!(
+        creator: bot,
+        body: body.presence,
+        attachment: attachment
+      )
+      message.broadcast_create
+      return head :created, location: "/messages/#{message.id}"
+    end
+
+    posting_status = bot.attempt_post do
+      message = room.messages.create_with_attachment!(
+        creator: bot,
+        body: body.presence,
+        attachment: attachment
+      )
+
+      message.broadcast_create
+    end
+
+    case posting_status
+    when :allowed
+      head :created, location: "/messages/#{message.id}"
+    when :too_many_requests
+      response.set_header("Retry-After", bot.reload.flood_retry_after.to_s)
+      head :too_many_requests
+    when :suspended
+      head :forbidden
+    end
+  end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..652edb4
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,64 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy reactivate ]
+  before_action :ensure_can_reactivate, only: :reactivate
+  before_action :ensure_bot_creation_allowed, only: %i[ new create ]
+
+  def index
+    @bots = Bot.managed_by(Current.user).with_attached_avatar.ordered
+    @bot_limit_reached = Current.user.bot_limit_reached?
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Bot.new(bot_params)
+    @bot.creator = Current.user
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url
+  end
+
+  def reactivate
+    @bot.reactivate!
+    redirect_to bots_url
+  end
+
+  private
+    def ensure_can_reactivate
+      head :forbidden unless Current.user.administrator?
+    end
+
+    def ensure_bot_creation_allowed
+      head :forbidden unless Current.user.can_create_bots?
+    end
+
+    def set_bot
+      @bot = Bot.managed_by(Current.user).find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms)
+    end
+end
