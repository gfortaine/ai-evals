+    def grant_membership_to_mentioned_bots(message)
+      new_bots = message.mentioned_bots.reject { |bot| memberships.exists?(user_id: bot.id) }
+      memberships.grant_to(new_bots) if new_bots.any?
+    end
+
+    def bot_mentions_later(message)
+      message.mentioned_bots.each do |bot|
