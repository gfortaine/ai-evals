+  def flood_cooldown_active?
+    cooldown_until.present? && cooldown_until > Time.current
+  end
+
+  def flood_retry_after
+    return 0 unless flood_cooldown_active?
+
+    [ (cooldown_until - Time.current).ceil, 1 ].max
+  end
+
+  def posting_allowed?
+    active? && !flood_cooldown_active?
+  end
+
+  def attempt_post(&block)
+    now = Time.current
+
+    with_lock do
+      return :suspended unless active?
+
+      if flood_cooldown_active?
+        next_attempt = cooldown_attempts.to_i + 1
+
+        if next_attempt >= FLOOD_COOLDOWN_ATTEMPTS_LIMIT
+          update!(
+            status: :suspended,
+            suspension_reason: FLOOD_SUSPENSION_REASON,
+            cooldown_until: nil,
+            cooldown_attempts: 0
+          )
+          return :suspended
+        end
+
+        update!(cooldown_attempts: next_attempt)
+        return :too_many_requests
+      end
+
+      if cooldown_until.present?
+        update!(cooldown_until: nil, cooldown_attempts: 0)
+      end
+
+      cutoff = now - FLOOD_WINDOW
+      bot_post_events.where("posted_at <= ?", cutoff).delete_all
+
+      if bot_post_events.where("posted_at > ?", cutoff).count >= FLOOD_LIMIT
+        update!(cooldown_until: now + FLOOD_COOLDOWN, cooldown_attempts: 0)
+        return :too_many_requests
+      end
+
+      bot_post_events.create!(posted_at: now)
+    end
+
+    yield if block
+    :allowed
+  end
+
+  alias_method :attempt_post!, :attempt_post
+  alias_method :post_attempt!, :attempt_post
+  alias_method :record_post!, :attempt_post
+  alias_method :record_post_attempt!, :attempt_post
+
+  def suspend_for_flooding!
+    with_lock do
+      update!(
+        status: :suspended,
+        suspension_reason: FLOOD_SUSPENSION_REASON,
+        cooldown_until: nil,
+        cooldown_attempts: 0
+      )
+    end
+  end
+
+  def suspend_for_webhook_failures!
+    with_lock do
+      update!(
+        status: :suspended,
+        suspension_reason: WEBHOOK_SUSPENSION_REASON,
+        cooldown_until: nil,
+        cooldown_attempts: 0
+      )
+    end
+  end
+
+  def record_webhook_failure!
+    with_lock do
+      return false if suspended?
+
+      failures = webhook_failure_count.to_i + 1
+
+      if failures >= WEBHOOK_FAILURE_LIMIT
+        update!(
+          status: :suspended,
+          suspension_reason: WEBHOOK_SUSPENSION_REASON,
+          cooldown_until: nil,
+          cooldown_attempts: 0,
+          webhook_failure_count: failures
+        )
+        true
+      else
+        update!(webhook_failure_count: failures)
+        false
+      end
+    end
+  end
+
+  alias_method :register_webhook_failure!, :record_webhook_failure!
+  alias_method :record_webhook_failure, :record_webhook_failure!
+
+  def record_webhook_success!
+    with_lock do
+      update!(webhook_failure_count: 0) if webhook_failure_count.to_i != 0
+    end
+  end
+
+  alias_method :register_webhook_success!, :record_webhook_success!
+  alias_method :record_webhook_success, :record_webhook_success!
+
+  def reactivate
+    reactivate!
+  end
+
+  def reactivate!
+    with_lock do
+      update!(
+        status: :active,
+        suspension_reason: nil,
+        cooldown_until: nil,
+        cooldown_attempts: 0,
+        webhook_failure_count: 0
+      )
+      bot_post_events.delete_all
+    end
+  end
