     end
   end
 
-  private
+test "ten consecutive failed deliveries suspend the bot" do
+  message = mention_message("restart")
+  stub_request(:post, @bot.webhook_url).to_return(status: 500)
+
+  10.times do
+    Bot::MentionWebhookJob.new.perform(@bot, message)
+  end
+
+  assert @bot.reload.suspended?
+  assert_equal Bot::WEBHOOK_SUSPENSION_REASON, @bot.suspension_reason
+  assert_equal 10, @bot.webhook_failure_count
+end
+
+test "timeouts count as failed deliveries" do
+  message = mention_message("restart")
+  stub_request(:post, @bot.webhook_url).to_timeout
+
+  Bot::MentionWebhookJob.new.perform(@bot, message)
+
