+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "creating a bot grants membership to open rooms" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert bot.bot?
+    assert bot.bot_code.present?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "bot codes are unique" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert Bot.authenticate(bot.bot_code)
+    assert_not_equal bot.bot_code, Bot.create!(name: "Other Bot", creator: users(:david)).bot_code
+  end
+
+  test "new open rooms grant membership to bots" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    room = Rooms::Open.create!(name: "New Open Room", creator: users(:david))
+
+    assert_includes room.users, bot
+  end
+end
