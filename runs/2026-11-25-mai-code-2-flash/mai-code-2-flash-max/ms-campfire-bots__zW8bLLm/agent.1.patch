diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..991cf9b
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,41 @@
+class Bot < User
+  self.inheritance_column = nil
+
+  default_scope -> { where(bot: true) }
+
+  has_secure_token :bot_code, length: 32
+
+  belongs_to :creator, class_name: "User", foreign_key: :bot_creator_id,
+      optional: true, inverse_of: :created_bots
+
+  validates :name, presence: true
+  validates :bot_code, presence: true, uniqueness: true
+
+  before_validation :prepare_for_creation, on: :create
+
+  scope :ordered, -> { order("LOWER(name)") }
+  scope :managed_by, ->(user) { user.administrator? ? all : where(bot_creator_id: user.id) }
+
+  alias_attribute :code, :bot_code
+  alias_method :bot_creator, :creator
+  alias_method :bot_creator=, :creator=
+  alias_method :owner, :creator
+  alias_method :owner=, :creator=
+  alias_method :bot_owner, :creator
+  alias_method :bot_owner=, :creator=
+
+  def self.find_by_code(code)
+    find_by(bot_code: code)
+  end
+
+  def self.authenticate(code)
+    find_by(bot_code: code)
+  end
+
+  private
+    def prepare_for_creation
+      self.bot = true
+      self.status = :active
+      self.password = SecureRandom.hex(32) if password_digest.blank?
+    end
+end
