diff --git a/test/controllers/concerns/set_locale_test.rb b/test/controllers/concerns/set_locale_test.rb
new file mode 100644
index 0000000..786d6fa
--- /dev/null
+++ b/test/controllers/concerns/set_locale_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class SetLocaleTest < ActionDispatch::IntegrationTest
+  test "ja query locale renders Japanese and is stored in a cookie" do
+    untenanted do
+      get new_session_path(locale: "ja")
+    end
+
+    assert_response :success
+    assert_select "html[lang=?]", "ja"
+    assert_select "h1", text: "Fizzyにログイン"
+    assert_equal "ja", cookies[:locale]
+  end
+
+  test "unsupported query locale leaves the default locale unchanged" do
+    untenanted do
+      get new_session_path(locale: "xx")
+    end
+
+    assert_response :success
+    assert_select "html[lang=?]", "en"
+    assert_select "h1", text: "Get into Fizzy"
+  end
+
+  test "no locale keeps the existing English rendering" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang=?]", "en"
+    assert_select "h1", text: "Get into Fizzy"
+  end
+
+  test "authenticated locale persists on the identity and current session" do
+    sign_in_as :kevin
+
+    get cards_path(locale: "ja")
+
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_equal "ja", cookies[:locale]
+    assert_select "html[lang=?]", "ja"
+  end
+
+  test "invalid locale does not override an identity preference" do
+    sign_in_as :kevin
+    identities(:kevin).update!(locale: "ja")
+
+    get cards_path(locale: "xx")
+
+    assert_response :success
+    assert_select "html[lang=?]", "ja"
+  end
+
+  test "identity preference survives a clean browser sign in" do
+    sign_in_as :kevin
+    identities(:kevin).update!(locale: "ja")
+
+    cookies.delete :session_token
+    sign_in_as :kevin
+    get cards_path
+
+    assert_response :success
+    assert_select "html[lang=?]", "ja"
+  end
+
+  test "static error pages contain English and Japanese" do
+    %w[400 404 422 500 406-unsupported-browser].each do |status|
+      page = Rails.root.join("public", "#{status}.html").read
+
+      assert_includes page, 'lang="ja"'
+      assert_includes page, 'lang="en"'
+      assert_match(/[ぁ-んァ-ン一-龯]/, page)
+    end
+  end
+end
