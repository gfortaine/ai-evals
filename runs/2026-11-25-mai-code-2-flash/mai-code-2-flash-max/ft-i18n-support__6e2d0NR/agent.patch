--- a/app/mailers/application_mailer.rb
+++ b/app/mailers/application_mailer.rb
@@ -13,4 +13,22 @@ class ApplicationMailer < ActionMailer::Base
         super
       end
     end
+
+    def with_locale_for(identity)
+      I18n.with_locale(locale_for(identity)) { yield }
+    end
+
+    def locale_for(identity)
+      locale = identity&.locale.to_s
+
+      if locale.in?(I18n.available_locales.map(&:to_s))
+        locale
+      elsif identity
+        identity.users.includes(:settings).filter_map { |user| user.settings&.locale }.find do |preferred_locale|
+          preferred_locale.in?(I18n.available_locales.map(&:to_s))
+        end || I18n.default_locale
+      else
+        I18n.default_locale
+      end
+    end
 end
