diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..ac8db45
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,131 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_locale
+
+    helper_method :locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def set_locale
+      if requested_locale = locale_from_params
+        persist_locale(requested_locale)
+      else
+        locale = locale_from_identity || locale_from_session || locale_from_cookie || I18n.default_locale
+        I18n.locale = locale
+      end
+
+      begin
+        I18n.with_locale(I18n.locale) { yield }
+      ensure
+        I18n.locale = I18n.default_locale
+      end
+    end
+
+    def locale
+      I18n.locale
+    end
+
+    def locale_from_params
+      locale = params[:locale].to_s
+
+      locale if offered_locale?(locale)
+    end
+
+    def locale_from_identity
+      identity = identity_for_locale
+
+      locale_from_record(identity) || locale_from_identity_settings(identity)
+    end
+
+    def locale_from_session
+      locale_from_record(session_for_locale)
+    end
+
+    def locale_from_cookie
+      locale = cookies[:locale].to_s
+
+      locale if offered_locale?(locale)
+    end
+
+    def locale_from_record(record)
+      if record&.respond_to?(:locale)
+        locale = record.locale.to_s
+        locale if offered_locale?(locale)
+      end
+    end
+
+    def locale_from_identity_settings(identity)
+      if identity
+        identity.users.includes(:settings).find_each do |user|
+          if locale = locale_from_record(user.settings)
+            return locale
+          end
+        end
+      end
+
+      nil
+    end
+
+    def identity_for_locale
+      if Current.identity
+        Current.identity
+      elsif Current.session
+        Current.session.identity
+      elsif cookies.signed[:session_token].present?
+        Session.find_signed(cookies.signed[:session_token])&.identity
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def session_for_locale
+      if Current.session
+        Current.session
+      elsif cookies.signed[:session_token].present?
+        Session.find_signed(cookies.signed[:session_token])
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def offered_locale?(locale)
+      locale.to_sym.in?(I18n.available_locales)
+    end
+
+    def persist_locale(locale)
+      return unless offered_locale?(locale)
+
+      I18n.locale = locale
+      cookies.permanent[:locale] = { value: locale, httponly: false, same_site: :lax }
+
+      if identity = identity_for_locale
+        identity.update_column(:locale, locale)
+
+        identity.users.includes(:settings).find_each do |user|
+          user.settings&.update_column(:locale, locale)
+        end
+      end
+
+      if session = session_for_locale
+        session.update_column(:locale, locale)
+      end
+    end
+
+    def apply_locale_preference(session)
+      if locale = locale_from_params
+        persist_locale(locale)
+      elsif locale = locale_from_record(session.identity)
+        persist_locale(locale)
+      elsif locale = locale_from_identity_settings(session.identity)
+        persist_locale(locale)
+      elsif locale = locale_from_record(session)
+        persist_locale(locale)
+      elsif locale = locale_from_cookie
+        persist_locale(locale)
+      end
+    end
+end
