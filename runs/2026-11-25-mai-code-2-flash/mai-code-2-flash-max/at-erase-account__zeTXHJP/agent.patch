-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
-    end
+  def erase
+    transaction { destroy! }
   end
 
+  def delete
+    erase
+  end
+
+  alias_method :remove, :erase
+  alias_method :deactivate, :erase
+
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    def erase_personal_data
+      SignInEvent.where(email_address: sign_in_addresses).delete_all
+
+      sessions.delete_all
+      reading_marks.delete_all
+      accesses.delete_all
+
+      shared_books = []
+      private_books = []
+
+      created_books.find_each do |book|
+        if book.everyone_access?
+          shared_books << book
+        else
+          private_books << book
+        end
+      end
+
+      shared_books.each do |book|
+        book.update!(creator_id: nil, author: DELETED_AUTHOR)
+        ensure_everyone_access(book)
+      end
+
+      purge_private_book_attachments(private_books)
+
+      private_books.each do |book|
+        book.leaves.find_each do |leaf|
+          leaf.edits.find_each(&:destroy!)
+        end
+
+        remove_private_search_entries(book)
+        book.destroy!
+      end
+    end
+
+    def sign_in_addresses
+      addresses = [ email_address ].compact
+
+      if match = email_address&.match(/\A(.+)-deactivated-[^@]+@(.+)\z/)
+        addresses << "#{match[1]}@#{match[2]}"
+      end
+
+      addresses.uniq
+    end
+
+    def ensure_everyone_access(book)
+      active_user_ids = User.active.where.not(id: id).ids
+      existing_user_ids = book.accesses.where(user_id: active_user_ids).pluck(:user_id)
+
+      missing_user_ids = active_user_ids - existing_user_ids
+      if missing_user_ids.any?
+        book.accesses.insert_all missing_user_ids.map { |user_id|
+          { user_id: user_id, level: :reader }
+        }
+      end
+    end
+
+    def remove_private_search_entries(book)
+      book.leaves.ids.each do |leaf_id|
+        Leaf.connection.execute Leaf.sanitize_sql([
+          "delete from leaf_search_index where rowid = ?", leaf_id
+        ])
+      end
+    end
+
+    def purge_private_book_attachments(private_books)
+      private_books.each do |book|
+        book.cover.purge if book.cover.attached?
+
+        book.leaves.find_each do |leaf|
+          purge_leafable_attachments(leaf.leafable)
+
+          leaf.edits.find_each do |edit|
+            purge_leafable_attachments(edit.leafable)
+          end
+        end
+      end
+    end
+
+    def purge_leafable_attachments(leafable)
+      return unless leafable
+
+      leafable.attachment_reflections.each_key do |name|
+        attachment = leafable.public_send(name)
+        attachment.purge if attachment.attached?
+      end
+
+      if leafable.respond_to?(:body)
+        markdown = leafable.body
+        markdown.uploads.purge if markdown.is_a?(ActionText::Markdown) && markdown.persisted? && markdown.uploads.attached?
+      end
     end
 
     def grant_access_to_everyone_books
