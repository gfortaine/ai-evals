diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..28c0a3b 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,55 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase removes the user and all personal data" do
+    kevin = users(:kevin)
+
+    Session.create!(user: kevin, ip_address: "127.0.0.1", user_agent: "Test browser")
+    ReadingMark.create!(user: kevin, leaf: leaves(:welcome_page), last_read_at: Time.current)
+    SignInEvent.create!(email_address: kevin.email_address, action: :signed_in)
+
+    private_book = Book.create!(title: "Private erasure book", everyone_access: false, published: true, creator: kevin)
+    private_leaf = private_book.press(Section.new(body: "private unique search text"), title: "Private unique title")
+    private_leaf.reindex
+
+    shared_book = Book.create!(title: "Shared erasure book", author: "Kevin", everyone_access: true, creator: kevin)
+
+    kevin.erase
+
+    assert_not User.exists?(kevin.id)
+    assert_not Session.exists?(user_id: kevin.id)
+    assert_not ReadingMark.exists?(user_id: kevin.id)
+    assert_not Access.exists?(user_id: kevin.id)
+    assert_not SignInEvent.exists?(email_address: "kevin@example.com")
+
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_empty Leaf.search("private unique search text")
+
+    assert shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert shared_book.accessable?(user: users(:david))
+  end
+
+  test "erase handles a legacy deactivated address and removes sign-in events for the original address" do
+    alice = User.create!(
+      name: "Alice",
+      email_address: "alice-deactivated-11111111@example.com",
+      password: "secret123456",
+      active: false
+    )
+
+    original_event = SignInEvent.create!(email_address: "alice@example.com", action: :signed_in)
+    rewritten_event = SignInEvent.create!(email_address: alice.email_address, action: :signed_out)
+    unrelated_event = SignInEvent.create!(email_address: "someone@example.com", action: :signed_in)
+
+    alice.erase
+
+    assert_not User.exists?(alice.id)
+    assert_not SignInEvent.exists?(original_event.id)
+    assert_not SignInEvent.exists?(rewritten_event.id)
+    assert SignInEvent.exists?(unrelated_event.id)
+  end
 end
