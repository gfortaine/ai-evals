diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..3f8df28
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,86 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatFullDate,
+  formatFutureTime,
+  formatLocalDate,
+  formatLocalDateTime,
+  formatLocalTime,
+  formatRelativeTime,
+  formatStampDate
+} from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: String, prefix: String, suffix: String }
+
+  #timer
+
+  connect() {
+    this.update()
+    this.#timer = setInterval(() => this.update(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  update() {
+    const value = this.element.dateTime || this.element.getAttribute("datetime") || this.element.dataset.timestamp
+
+    if (!value) return
+
+    let date
+
+    if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+      const [year, month, day] = value.split("-").map(Number)
+      date = new Date(year, month - 1, day, 12)
+    } else {
+      date = new Date(value)
+    }
+
+    if (Number.isNaN(date.getTime())) return
+
+    const text = this.#format(date)
+    const prefix = this.hasPrefixValue ? this.prefixValue : ""
+    const suffix = this.hasSuffixValue ? this.suffixValue : ""
+
+    this.element.textContent = `${prefix}${text}${suffix}`
+
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+      this.element.title = formatLocalDateTime(date)
+    } else {
+      this.element.title = formatFullDate(date)
+    }
+  }
+
+  #format(date) {
+    const format = this.hasFormatValue ? this.formatValue : this.element.dataset.format
+
+    switch (format) {
+      case "time":
+        return formatLocalTime(date)
+      case "date":
+      case "short-date":
+      case "short_date":
+      case "month-day":
+      case "month_day":
+        return formatLocalDate(date)
+      case "full-date":
+      case "full_date":
+        return formatFullDate(date)
+      case "datetime":
+      case "date-time":
+      case "date_time":
+      case "long":
+        return formatLocalDateTime(date)
+      case "stamp":
+        return formatStampDate(date)
+      case "future":
+        return formatFutureTime(date)
+      case "relative":
+      default:
+        return formatRelativeTime(date)
+    }
+  }
+}
