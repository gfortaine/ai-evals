diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..f94df39
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "local_time_tag sends an ISO timestamp without server-rendered words" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    assert_select parse(local_time_tag(time)), "time"
+    assert_select parse(local_time_tag(time)), "time[datetime='2025-09-12T13:42:00Z'][data-controller='local-time'][data-local-time-format-value='relative']"
+  end
+
+  test "local_time_tag supports a date-only timestamp" do
+    assert_select parse(local_time_tag(Date.new(2025, 9, 12), format: :full_date)), "time[datetime='2025-09-12'][data-local-time-format-value='full-date']"
+  end
+
+  test "local_time_tag supports custom prefix and suffix values" do
+    html = local_time_tag(Time.utc(2025, 9, 12, 13, 42), format: :future, prefix: "Due ", suffix: "!")
+
+    assert_select parse(html), "time[data-local-time-prefix-value='Due '][data-local-time-suffix-value='!']"
+  end
+
+  test "relative_time_tag uses the relative format" do
+    assert_select parse(relative_time_tag(Time.utc(2025, 9, 12, 13, 42))), "time[data-local-time-format-value='relative']"
+  end
+
+  test "local_time_tag returns nothing for a missing timestamp" do
+    assert_nil local_time_tag(nil)
+  end
+end
