diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..81f364f 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,41 @@
 module TimeHelper
+  def local_time_tag(time, format = :relative, **options, &block)
+    if options.key?(:format)
+      format = options.delete(:format)
+    end
+
+    if options.key?(:mode)
+      format = options.delete(:mode)
+    end
+
+    prefix = options.delete(:prefix)
+    suffix = options.delete(:suffix)
+
+    data = options.delete(:data) || {}
+    data[:controller] = [ data[:controller], "local-time" ].compact.reject(&:blank?).join(" ")
+    data[:local_time_format_value] = format.to_s.tr("_", "-")
+    data[:local_time_prefix_value] = prefix if prefix.present?
+    data[:local_time_suffix_value] = suffix if suffix.present?
+
+    if time
+      options[:datetime] = time.respond_to?(:iso8601) ? time.iso8601 : time.to_s
+      tag.time(block_given? ? capture(&block) : nil, data: data, **options)
+    end
+  end
+
+  def local_time(time, format = :relative, **options, &block)
+    local_time_tag(time, format, **options, &block)
+  end
+
+  def relative_time_tag(time, **options)
+    local_time_tag(time, :relative, **options)
+  end
+
+  def local_date_tag(time, format = :date, **options)
+    local_time_tag(time, format, **options)
+  end
+
+  def local_datetime_tag(time, **options)
+    local_time_tag(time, :datetime, **options)
+  end
 end
