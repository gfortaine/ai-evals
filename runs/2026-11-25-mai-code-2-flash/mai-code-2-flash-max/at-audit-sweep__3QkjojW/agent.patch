diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..98d565f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "library search uses the term as literal text" do
+    percent_page = books(:handbook).press(Page.new(body: "Percent page"), title: "Save 50% off")
+    underscore_page = books(:handbook).press(Page.new(body: "Underscore page"), title: "Snake_case")
+    apostrophe_page = books(:handbook).press(Page.new(body: "Apostrophe page"), title: "Bob's Page")
+    Leaf.reindex_all
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_in_body "Snake_case"
+
+    get library_search_path, params: { q: "Bob's" }
+    assert_response :success
+    assert_in_body "Bob&#39;s Page"
+
+    assert percent_page.present?
+    assert underscore_page.present?
+    assert apostrophe_page.present?
+  end
+
+  test "library search only returns leaves from readable books" do
+    secret_page = books(:manual).press(Page.new(body: "Private manual content"), title: "Secret Manual Page")
+    secret_page.reindex
+
+    get library_search_path, params: { q: "Secret Manual" }
+
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "library search does not interpret SQL injection text" do
+    get library_search_path, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_in_body "No matches"
+  end
+
+  test "library search returns ordinary title matches" do
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome"
+  end
+end
