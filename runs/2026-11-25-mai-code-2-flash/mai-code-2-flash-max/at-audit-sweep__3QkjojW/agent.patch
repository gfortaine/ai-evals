diff --git a/test/models/leaf/searchable_test.rb b/test/models/leaf/searchable_test.rb
index 4446433..81301a1 100644
--- a/test/models/leaf/searchable_test.rb
+++ b/test/models/leaf/searchable_test.rb
@@ -81,4 +81,23 @@ class Leaf::SearchableTest < ActiveSupport::TestCase
     leaves = Leaf.search("findme")
     assert_equal "<mark>findme</mark> fake highlight", leaves.first.title_match
   end
+
+  test "percent and underscore searches match literal title characters" do
+    percent_leaf = books(:handbook).press(Page.new(body: "Percent page"), title: "Save 50% off")
+    underscore_leaf = books(:handbook).press(Page.new(body: "Underscore page"), title: "Snake_case")
+    percent_leaf.reindex
+    underscore_leaf.reindex
+
+    assert_includes Leaf.search("%"), percent_leaf
+    assert_not_includes Leaf.search("%"), leaves(:welcome_page)
+    assert_includes Leaf.search("_"), underscore_leaf
+    assert_not_includes Leaf.search("_"), leaves(:welcome_page)
+  end
+
+  test "apostrophe searches do not return an FTS error" do
+    apostrophe_leaf = books(:handbook).press(Page.new(body: "It's a page"), title: "Bob's Page")
+    apostrophe_leaf.reindex
+
+    assert_includes Leaf.search("Bob's Page"), apostrophe_leaf
+  end
 end
