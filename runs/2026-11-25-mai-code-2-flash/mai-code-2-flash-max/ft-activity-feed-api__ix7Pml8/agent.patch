@@ -0,0 +1,31 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Event
+        .preloaded
+        .where(account: Current.account)
+        .where(board: Current.user.boards)
+        .where(action: Event::API_TIMELINEABLE_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+
+    def creator_ids
+      @creator_ids ||= filter_ids(:creator_ids)
+    end
+
+    def board_ids
+      @board_ids ||= filter_ids(:board_ids)
+    end
+
+    def filter_ids(key)
+      Array(params[key]).flat_map { |value| value.to_s.split(",") }.compact_blank
+    end
+end
