diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..00e30ce
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,54 @@
+json.id event.id
+json.action event.action.to_s
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text.to_s
+
+raw_particulars = event.particulars.is_a?(Hash) ? event.particulars : {}
+nested_particulars = raw_particulars["particulars"] || raw_particulars[:particulars]
+nested_particulars = nested_particulars.is_a?(Hash) ? nested_particulars : {}
+
+particular_value = lambda do |key|
+  value = raw_particulars[key] if raw_particulars.key?(key)
+  value = raw_particulars[key.to_sym] if value.nil? && raw_particulars.key?(key.to_sym)
+
+  if value.nil?
+    value = nested_particulars[key] if nested_particulars.key?(key)
+    value = nested_particulars[key.to_sym] if value.nil? && nested_particulars.key?(key.to_sym)
+  end
+
+  value
+end
+
+particulars = {}
+case event.action.to_s
+when "card_assigned", "card_unassigned"
+  particulars[:assignee_ids] = Array(particular_value.call("assignee_ids")).compact_blank
+when "card_board_changed"
+  particulars[:old_board] = particular_value.call("old_board").to_s.presence || ""
+  particulars[:new_board] = particular_value.call("new_board").to_s.presence || ""
+when "card_title_changed"
+  particulars[:old_title] = particular_value.call("old_title").to_s.presence || ""
+  particulars[:new_title] = particular_value.call("new_title").to_s.presence || ""
+when "card_triaged", "card_sent_back_to_triage"
+  particulars[:column] = particular_value.call("column").to_s.presence || ""
+end
+json.particulars particulars
+
+if event.action.comment_created?
+  comment = event.eventable
+  json.url card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment))
+else
+  json.url card_url(event.card)
+end
+
+json.eventable_type event.eventable_type
+
+case event.eventable
+when Card
+  json.eventable event.eventable, partial: "cards/card", as: :card
+when Comment
+  json.eventable event.eventable, partial: "cards/comments/comment", as: :comment
+end
+
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
