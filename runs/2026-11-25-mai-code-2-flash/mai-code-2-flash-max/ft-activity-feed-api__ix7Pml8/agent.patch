diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..b9ab488
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns a flat newest-first array with the API event shape" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any?
+
+    @response.parsed_body.each do |activity|
+      assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], activity.keys.sort
+    end
+
+    timestamps = @response.parsed_body.pluck("created_at").map { |timestamp| Time.zone.parse(timestamp) }
+    assert_equal timestamps.sort.reverse, timestamps
+  end
+
+  test "includes title changes and exposes title particulars" do
+    event = Event.create!(
+      account: Current.account,
+      board: boards(:writebook),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } },
+      created_at: 1.minute.from_now
+    )
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert activity
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity["particulars"])
+  end
+
+  test "does not include deprecated collection changes" do
+    event = Event.create!(
+      account: Current.account,
+      board: boards(:writebook),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_collection_changed",
+      particulars: { particulars: { new_collection: "Old collection" } },
+      created_at: 1.minute.from_now
+    )
+
+    get activities_path(format: :json)
+
+    assert_not @response.parsed_body.any? { |item| item["id"] == event.id }
+  end
+
+  test "comment URL jumps to the comment and comment eventable uses the comment representation" do
+    event = events(:layout_commented)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert activity
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), activity["url"]
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+  end
+
+  test "assignment board title and triage particulars use empty fallbacks" do
+    assignment = Event.create!(
+      account: Current.account,
+      board: boards(:writebook),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_assigned",
+      particulars: { particulars: { assignee_ids: [ users(:david).id ] } }
+    )
+    board_change = Event.create!(
+      account: Current.account,
+      board: boards(:writebook),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_board_changed",
+      particulars: {}
+    )
+    title_change = Event.create!(
+      account: Current.account,
+      board: boards(:writebook),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: {}
+    )
+    triage = Event.create!(
+      account: Current.account,
+      board: boards(:writebook),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_triaged",
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+
+    activities = @response.parsed_body.index_by { |item| item["id"] }
+    assert_equal [ users(:david).id ], activities.dig(assignment.id, "particulars", "assignee_ids")
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.dig(board_change.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.dig(title_change.id, "particulars"))
+    assert_equal({ "column" => "" }, activities.dig(triage.id, "particulars"))
+  end
+
+  test "filters by creator and board and excludes inaccessible board activity" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ])
+
+    assert_response :success
+    @response.parsed_body.each do |activity|
+      assert_equal users(:kevin).id, activity.dig("creator", "id")
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+    end
+
+    get activities_path(format: :json, board_ids: [ ActiveRecord::FixtureSet.identify("miltons_wish_list", :uuid) ])
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "uses geared pagination headers and next links" do
+    31.times do |index|
+      Event.create!(
+        account: Current.account,
+        board: boards(:writebook),
+        creator: users(:kevin),
+        eventable: cards(:logo),
+        action: "card_published",
+        created_at: 2.hours.ago + index.minutes
+      )
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert @response.headers["X-Total-Count"].to_i > 15
+    assert_match(/rel="next"/, @response.headers["Link"])
+
+    next_url = @response.headers["Link"].match(/<([^>]+)>;\s*rel="next"/).captures.first
+    get URI.parse(next_url).request_uri
+
+    assert_response :success
+    assert @response.parsed_body.size.between?(1, 30)
+  end
+end
