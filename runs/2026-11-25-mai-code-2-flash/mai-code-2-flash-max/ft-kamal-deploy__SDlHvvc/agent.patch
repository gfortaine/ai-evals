@@ -0,0 +1,54 @@
+# Replace the example host, registry, and SMTP values for your deployment.
+
+service: fizzy
+image: your-github-username/fizzy
+asset_path: /rails/public/assets
+secrets_path: .kamal/secrets
+
+servers:
+  web:
+    hosts:
+      - fizzy.example.com
+
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+registry:
+  server: ghcr.io
+  username:
+    - KAMAL_REGISTRY_USERNAME
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+volumes:
+  - fizzy-storage:/rails/storage
+
+env:
+  clear:
+    RAILS_ENV: production
+    RAILS_LOG_LEVEL: info
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    APP_HOST: fizzy.example.com
+    MAILER_FROM_ADDRESS: Fizzy <notifications@fizzy.example.com>
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: fizzy.example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    ASSUME_SSL: true
+    FORCE_SSL: true
+    SOLID_QUEUE_IN_PUMA: true
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
