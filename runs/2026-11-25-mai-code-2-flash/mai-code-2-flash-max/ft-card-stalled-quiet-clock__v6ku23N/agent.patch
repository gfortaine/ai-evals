diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..ba88319
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,95 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 14.days
+
+  included do
+    scope :bursted, -> { where(id: all.to_a.filter(&:burst?).map(&:id)) }
+    scope :bursting, -> { bursted }
+    scope :stalled, -> { where(id: all.active.to_a.filter(&:stalled?).map(&:id)) }
+
+    after_update_commit :reset_stalled_activity_after_card_update, if: :card_activity_changed?
+
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  alias_method :bursted?, :burst?
+  alias_method :had_burst?, :burst?
+  alias_method :bursty?, :burst?
+
+  def burst_at
+    [ last_burst_at, detected_burst_at ].compact.max
+  end
+
+  def burst_at=(value)
+    self.last_burst_at = value
+  end
+
+  def mark_burst!(at: Time.current)
+    at = at.presence || Time.current
+
+    if last_burst_at.nil? || at > last_burst_at
+      self.class.where(id: id).where("last_burst_at IS NULL OR last_burst_at < ?", at).update_all(last_burst_at: at, updated_at: Time.current)
+      self.last_burst_at = at unless destroyed? || frozen?
+    end
+  end
+
+  def register_burst_from_comments
+    if burst_at = comment_burst_at
+      mark_burst!(at: burst_at)
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    if burst_at && last_active_at
+      effective_activity_at = [ burst_at, last_active_at ].compact.max
+      effective_activity_at <= (as_of - STALLED_AFTER)
+    else
+      false
+    end
+  end
+
+  def detected_burst_at
+    [ comment_burst_at, assignment_or_reopen_burst_at ].compact.max
+  end
+
+  private
+    def reset_stalled_activity_after_card_update
+      touch_last_active_at
+    end
+
+    def card_activity_changed?
+      return false if saved_change_to_last_active_at? || saved_change_to_last_burst_at?
+
+      (saved_changes.keys - %w[ created_at updated_at last_active_at last_burst_at ]).any?
+    end
+
+    def comment_burst_at
+      window = auto_postpone_period / 3.0
+      comments_by_creator = comments.by_user.chronologically.pluck(:created_at, :creator_id)
+      left = 0
+
+      comments_by_creator.each_with_index do |(created_at, _creator_id), right|
+        window_start = created_at - window
+        left += 1 while left <= right && comments_by_creator[left][0] < window_start
+
+        window_comments = comments_by_creator[left..right]
+        if window_comments.length >= 3 && window_comments.map(&:last).uniq.length >= 2
+          return created_at
+        end
+      end
+
+      nil
+    end
+
+    def assignment_or_reopen_burst_at
+      [
+        assignments.maximum(:created_at),
+        events.where(action: [ "card_assigned", "card_reopened" ]).maximum(:created_at)
+      ].compact.max
+    end
+
+end
