diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..d907db7
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people within a third of the close period create a burst" do
+    card = cards(:buy_domain)
+    card.comments.delete_all
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+
+    [ users(:david), users(:jz), users(:david) ].each do |creator|
+      card.comments.create!(body: "Comment", creator: creator)
+    end
+
+    assert card.reload.burst?
+    assert card.last_burst_at.present?
+  end
+
+  test "comments outside the comment burst window do not create a burst" do
+    card = cards(:buy_domain)
+    card.comments.delete_all
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+
+    travel_to 31.days.ago do
+      card.comments.create!(body: "First", creator: users(:david))
+    end
+    travel_to 15.days.ago do
+      card.comments.create!(body: "Second", creator: users(:jz))
+    end
+    travel_to Time.current do
+      card.comments.create!(body: "Third", creator: users(:david))
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "comments from only one person do not create a burst" do
+    card = cards(:buy_domain)
+    card.comments.delete_all
+
+    3.times do
+      card.comments.create!(body: "Comment", creator: users(:david))
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "assignment and reopen create bursts" do
+    assigned_card = cards(:buy_domain)
+    assigned_card.toggle_assignment users(:kevin)
+    assert assigned_card.reload.burst?
+
+    reopened_card = cards(:shipping)
+    reopened_card.reopen
+    assert reopened_card.reload.burst?
+  end
+
+  test "a burst becomes stalled after two weeks with no activity" do
+    card = cards(:buy_domain)
+    freeze_time
+
+    card.update!(last_burst_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+
+    card.touch_last_active_at
+
