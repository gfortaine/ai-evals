diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..1581d23
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,36 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction">
+  <div class="reactions__list">
+    <% comment.reactions.chronologically.includes(:creator).each do |reaction| %>
+      <%= render "cards/comments/reactions/reaction", reaction: reaction, comment: comment %>
+    <% end %>
+  </div>
+
+  <% if Current.user && comment.card.commentable? %>
+    <%= form_with url: card_comment_reactions_path(comment.card, comment), method: :post,
+          html: { hidden: true },
+          class: "reaction reaction__form",
+          data: { reaction_target: "form", action: "turbo:submit-end->reaction#submitEnd keydown.esc->reaction#cancel" } do |form| %>
+      <label class="reaction__form-label">
+        <span class="for-screen-reader">Reaction</span>
+        <%= form.text_field :content, name: "reaction[content]", maxlength: 16, required: true,
+              autocomplete: "off", placeholder: "React…", class: "reaction__input input",
+              data: { reaction_target: "input" } %>
+      </label>
+
+      <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle",
+            aria: { label: "Confirm reaction" } do %>
+        <%= icon_tag "check" %>
+      <% end %>
+
+      <%= form.button type: :button, class: "reaction__cancel-btn btn btn--circle",
+            aria: { label: "Cancel reaction" }, data: { action: "reaction#cancel" } do %>
+        <%= icon_tag "close" %>
+      <% end %>
+    <% end %>
+
+    <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add reaction"
+          data-reaction-target="trigger" data-action="reaction#open">
+      <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    </button>
+  <% end %>
+</div>
