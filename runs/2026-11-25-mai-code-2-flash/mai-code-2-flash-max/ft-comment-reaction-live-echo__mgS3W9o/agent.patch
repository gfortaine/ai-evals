diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..47e3d0b
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,104 @@
+module Cards
+  module Comments
+    class ReactionsController < ApplicationController
+      wrap_parameters :reaction, include: %i[ content body text reaction ]
+
+      before_action :set_card
+      before_action :set_comment
+      before_action :set_reaction, only: %i[ show destroy ]
+      before_action :ensure_card_is_commentable, only: :create
+      before_action :ensure_reaction_ownership, only: :destroy
+
+      def index
+        respond_to do |format|
+          format.json
+        end
+      end
+
+      def show
+        respond_to do |format|
+          format.json
+        end
+      end
+
+      def create
+        @reaction = @comment.reactions.create(reaction_params)
+
+        broadcast_reactions if @reaction.persisted?
+
+        respond_to do |format|
+          if @reaction.persisted?
+            format.turbo_stream { render_reactions_replacement }
+            format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+          else
+            format.turbo_stream { head :unprocessable_entity }
+            format.json { render json: { errors: @reaction.errors.full_messages }, status: :unprocessable_entity }
+          end
+        end
+      end
+
+      def destroy
+        @reaction.destroy
+        broadcast_reactions
+
+        respond_to do |format|
+          format.turbo_stream { render_reactions_replacement }
+          format.json { head :no_content }
+        end
+      end
+
+      private
+        def set_card
+          if params[:card_id]
+            @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
+          else
+            comment = Comment.includes(:card).find(params[:comment_id])
+            @card = Current.user.accessible_cards.find(comment.card_id)
+          end
+        end
+
+        def set_comment
+          @comment = @card.comments.find(params[:comment_id])
+        end
+
+        def set_reaction
+          @reaction = if params[:id]
+            @comment.reactions.find(params[:id])
+          else
+            @comment.reactions.find_by!(creator: Current.user)
+          end
+        end
+
+        def ensure_card_is_commentable
+          head :forbidden unless @card.commentable?
+        end
+
+        def ensure_reaction_ownership
+          head :forbidden unless @reaction.creator == Current.user
+        end
+
+        def reaction_params
+          attributes = if params[:reaction].present?
+            params.expect(reaction: [ :content, :body, :text, :reaction ])
+          else
+            params.permit(:content, :body, :text, :reaction)
+          end
+
+          attributes.merge(creator: Current.user)
+        end
+
+        def broadcast_reactions
+          @comment.association(:reactions).reset
+
+          @reaction.broadcast_replace_to @card,
+            target: ActionView::RecordIdentifier.dom_id(@comment, :reactions),
+            partial: "cards/comments/reactions",
+            locals: { comment: @comment }
+        end
+
+        def render_reactions_replacement
+          render turbo_stream: turbo_stream.replace([ @comment, :reactions ], partial: "cards/comments/reactions", locals: { comment: @comment })
+        end
+    end
+  end
+end
