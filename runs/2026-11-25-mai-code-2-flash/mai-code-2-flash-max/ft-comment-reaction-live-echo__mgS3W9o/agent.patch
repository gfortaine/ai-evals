diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..091e09c
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "renders a reaction strip with an add control" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_path(card, comment)
+
+    assert_response :success
+    assert_select "##{dom_id(comment, :reactions)}.reactions"
+    assert_select "button.reactions__trigger"
+    assert_select "input.reaction__input[maxlength='16']"
+  end
+
+  test "broadcasts a reaction update to the card" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    assert_turbo_stream_broadcasts(card, count: 1) do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+  end
+
+  test "create" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, 1 do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "create as JSON" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, 1 do
+      post card_comment_reactions_path(card, comment), params: { content: "Nice" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Nice", @response.parsed_body["content"]
+  end
+
+  test "rejects reactions longer than 16 characters" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "x" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy own reaction" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(creator: users(:kevin), content: "👍")
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "cannot destroy another user's reaction" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(creator: users(:jz), content: "👍")
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..84ddb0d
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "content is required and limited to 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_not Reaction.new(comment: comment, creator: users(:kevin), content: "").valid?
+    assert_not Reaction.new(comment: comment, creator: users(:kevin), content: "x" * 17).valid?
+    assert Reaction.new(comment: comment, creator: users(:kevin), content: "x" * 16).valid?
+  end
+
+  test "same person can add more than one reaction" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, 2 do
+      comment.reactions.create!(creator: users(:kevin), content: "👍")
+      comment.reactions.create!(creator: users(:kevin), content: "Agreed")
+    end
+  end
+end
