diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..26a953d
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,48 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  initialize() {
+    if (!this.currentUserId) {
+      if (this.hasTriggerTarget) this.triggerTarget.hidden = true
+      if (this.hasFormTarget) this.formTarget.hidden = true
+    }
+  }
+
+  open(event) {
+    event.preventDefault()
+    if (!this.currentUserId) return
+
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    if (!this.hasFormTarget || !this.hasTriggerTarget) return
+
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.inputTarget.value = ""
+    this.triggerTarget.hidden = false
+  }
+
+  submitEnd(event) {
+    if (event.detail?.success) this.cancel()
+  }
+
+  toggleDelete(event) {
+    const reaction = event.currentTarget
+
+    if (!this.currentUserId || reaction.dataset.reactionOwnerId !== this.currentUserId) return
+
+    reaction.classList.toggle("expanded")
+  }
+
+  get currentUserId() {
+    return this.element.closest("[data-current-user-id]")?.dataset.currentUserId || null
+  }
+}
