new file mode 100644
index 0000000..88b7337
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,267 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  connect() {
+    this.draggedCard = null
+    this.originalContainer = null
+    this.originalColumn = null
+    this.originalNextSibling = null
+    this.hoverColumn = null
+  }
+
+  dragStart(event) {
+    const card = event.target.closest?.(".card")
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedCard = card
+    this.originalContainer = card.closest(".cards__list")
+    this.originalColumn = card.closest(".cards")
+    this.originalNextSibling = card.nextElementSibling
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+
+    card.classList.add("drag-and-drop__dragged-item")
+  }
+
+  dragEnter(event) {
+    this.#hoverOver(event)
+  }
+
+  dragOver(event) {
+    this.#hoverOver(event)
+  }
+
+  dragLeave(event) {
+    const column = event.target.closest?.(".cards")
+    if (!column) return
+
+    if (event.relatedTarget && column.contains(event.relatedTarget)) return
+    if (this.hoverColumn === column) this.#clearHover()
+  }
+
+  drop(event) {
+    const column = event.target.closest?.(".cards")
+    if (!column || !this.draggedCard) return
+
+    event.preventDefault()
+    event.stopPropagation()
+
+    const card = this.draggedCard
+    const sourceContainer = this.originalContainer
+    const originalNextSibling = this.originalNextSibling
+    const sourceColumn = this.originalColumn || sourceContainer?.closest(".cards")
+
+    if (sourceColumn === column) {
+      this.#finishDrag(card)
+      return
+    }
+
+    const destinationList = this.#destinationList(column)
+    if (!destinationList) {
+      this.#finishDrag(card)
+      return
+    }
+
+    destinationList.append(card)
+    this.#updateCard(card, column)
+    this.#saveMove(card, column, sourceContainer, originalNextSibling)
+    this.#finishDrag(card)
+  }
+
+  dragEnd() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove("drag-and-drop__dragged-item")
+    }
+    this.#clearHover()
+    this.draggedCard = null
+  }
+
+  // Private
+
+  #hoverOver(event) {
+    if (!this.draggedCard) return
+
+    const column = event.target.closest?.(".cards")
+    if (!column) return
+
+    event.preventDefault()
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    if (this.hoverColumn !== column) {
+      this.#clearHover()
+      this.hoverColumn = column
+
+      const collapsibleController = this.application.getControllerForElementAndIdentifier(this.element, "collapsible-columns")
+      collapsibleController?.focusOnColumn({ target: column })
+
+      column.classList.add("drag-and-drop__hover-container")
+      column.querySelector(".cards__transition-container")?.classList.add("drag-and-drop__hover-container")
+    }
+  }
+
+  #clearHover() {
+    if (this.hoverColumn) {
+      this.hoverColumn.classList.remove("drag-and-drop__hover-container")
+      this.hoverColumn.querySelector(".cards__transition-container")?.classList.remove("drag-and-drop__hover-container")
+    }
+    this.hoverColumn = null
+  }
+
+  #finishDrag(card) {
+    card.classList.remove("drag-and-drop__dragged-item")
+    this.#clearHover()
+    this.draggedCard = null
+  }
+
+  #destinationList(column) {
+    const existingList = column.querySelector(".cards__list")
+    if (existingList) return existingList
+
+    const transitionContainer = column.querySelector(".cards__transition-container")
+    if (!transitionContainer) return null
+
+    const list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    transitionContainer.append(list)
+    return list
+  }
+
+  #destinationStatus(column) {
+    const status = column.dataset.dragAndDropStatus
+    if (status) return status
+
+    if (column.dataset.columnId) return "column"
+    if (column.id?.startsWith("column_")) return "column"
+    return null
+  }
+
+  #columnId(column) {
+    return column.dataset.columnId || column.dataset.dragAndDropColumnId || column.id?.replace(/^column_/, "")
+  }
+
+  #triageUrl(card, column) {
+    const url = card.dataset.cardTriageUrl
+    if (!url) return null
+
+    const columnId = this.#columnId(column)
+    if (!columnId) return null
+
+    const separator = url.includes("?") ? "&" : "?"
+    return `${url}${separator}column_id=${encodeURIComponent(columnId)}`
+  }
+
+  async #saveMove(card, column, originalContainer, originalNextSibling) {
+    const status = this.#destinationStatus(column)
+
+    try {
+      let response
+
+      if (status === "maybe") {
+        if (card.dataset.cardTriageUrl) {
+          response = await destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+        }
+      } else if (status === "closed") {
+        if (card.dataset.cardClosureUrl) {
+          response = await post(card.dataset.cardClosureUrl, { responseKind: "json" })
+        }
+      } else if (status === "not_now") {
+        if (card.dataset.cardNotNowUrl) {
+          response = await post(card.dataset.cardNotNowUrl, { responseKind: "json" })
+        }
+      } else if (status === "column") {
+        const url = this.#triageUrl(card, column)
+        if (url) {
+          response = await post(url, { responseKind: "json" })
+        }
+      }
+
+      if (response && !response.ok) {
+        this.#restoreCard(card, originalContainer, originalNextSibling)
+      }
+    } catch (_error) {
+      this.#restoreCard(card, originalContainer, originalNextSibling)
+    }
+  }
+
+  #restoreCard(card, originalContainer, originalNextSibling) {
+    if (originalContainer?.isConnected) {
+      if (originalNextSibling?.isConnected && originalNextSibling.parentElement === originalContainer) {
+        originalContainer.insertBefore(card, originalNextSibling)
+      } else {
+        originalContainer.append(card)
+      }
+    }
+  }
+
+  #updateCard(card, column) {
+    const status = this.#destinationStatus(column)
+
+    card.dataset.cardStatus = status
+
+    if (status === "closed") {
+      card.classList.remove("card--active", "card--postponed")
+      this.#clearCardColumn(card)
+    } else if (status === "not_now") {
+      card.classList.remove("card--active")
+      card.classList.add("card--postponed")
+      this.#clearCardColumn(card)
+    } else {
+      card.classList.remove("card--postponed")
+      card.classList.add("card--active")
+
+      if (status === "column") {
+        this.#setCardColumn(card, column)
+      } else {
+        this.#clearCardColumn(card)
+      }
+    }
+  }
+
+  #setCardColumn(card, column) {
+    const name = column.dataset.columnName
+    const columnId = this.#columnId(column)
+
+    if (columnId) card.dataset.cardColumnId = columnId
+
+    const headerLabel = card.querySelector(".card__header .card__column-name")
+    if (headerLabel) {
+      const labelText = headerLabel.querySelector(".overflow-ellipsis")
+      if (labelText) {
+        labelText.textContent = name
+      }
+    } else if (name) {
+      const header = card.querySelector(".card__header")
+      if (header) {
+        const label = document.createElement("span")
+        label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        const labelText = document.createElement("span")
+        labelText.className = "overflow-ellipsis"
+        labelText.textContent = name
+        label.append(labelText)
+        header.append(label)
+      }
+    }
+
+    card.querySelectorAll(".card__stages .card__column-name").forEach(label => {
+      const isCurrent = label.textContent.trim() === name
+      label.classList.toggle("card__column-name--current", isCurrent)
+    })
+  }
+
+  #clearCardColumn(card) {
+    card.removeAttribute("data-card-column-id")
+
+    card.querySelector(".card__header .card__column-name")?.remove()
+
+    card.querySelectorAll(".card__stages .card__column-name").forEach(label => {
+      label.classList.remove("card__column-name--current")
+    })
+  }
+}
