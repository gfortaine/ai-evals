--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "content is required and limited to sixteen characters" do
+    card = cards(:logo)
+
+    assert_not card.reactions.build(content: "").valid?
+    assert_not card.reactions.build(content: "A" * 17).valid?
+    assert card.reactions.build(content: "A" * 16).valid?
+  end
+
+  test "reacts to cards and comments" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    card_reaction = card.reactions.create!(reacter: users(:kevin), content: "Great")
+    comment_reaction = comment.reactions.create!(reacter: users(:jz), content: "👍")
+
+    assert_equal card, card_reaction.reactable
+    assert_equal comment, comment_reaction.reactable
+    assert_equal card, card_reaction.card
+    assert_equal card, comment_reaction.card
+  end
+end
