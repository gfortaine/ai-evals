+++ b/app/views/cards/reactions/_reaction.html.erb
@@ -0,0 +1,33 @@
+<% own_reaction = reaction.owned_by?(Current.user) %>
+<% reaction_classes = class_names("reaction", "reaction--deleteable" => own_reaction) %>
+
+<div id="<%= dom_id(reaction) %>" class="<%= reaction_classes %>"
+    title="Reaction by <%= reaction.reacter.name %>"
+    <%= tag.attributes(data: own_reaction ? { controller: "reaction", reaction_target: "item", action: "click->reaction#toggleDelete keydown.enter->reaction#toggleDelete" } : {}) %>
+    <%= tag.attributes(role: own_reaction ? "button" : nil, tabindex: own_reaction ? 0 : nil) %>>
+  <span class="reaction__avatar">
+    <%= avatar_preview_tag reaction.reacter, hidden_for_screen_reader: false %>
+  </span>
+
+  <% if reaction.emoji? %>
+    <span class="txt-small txt-medium"><%= reaction.content %></span>
+  <% else %>
+    <span class="txt-small"><%= reaction.content %></span>
+  <% end %>
+
+  <span class="for-screen-reader">Reaction by <%= reaction.reacter.name %></span>
+
+  <% if own_reaction %>
+    <% if reaction.reactable.is_a?(Comment) %>
+      <% delete_url = card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction) %>
+    <% else %>
+      <% delete_url = card_reaction_path(reaction.reactable, reaction) %>
+    <% end %>
+
+    <%= form_with url: delete_url, method: :delete, class: "reaction__delete", data: { turbo_frame: "_top" } do %>
+      <button type="submit" class="btn btn--circle borderless" title="Remove reaction" aria-label="Remove reaction">
+        <%= icon_tag "trash" %>
+      </button>
+    <% end %>
+  <% end %>
+</div>
