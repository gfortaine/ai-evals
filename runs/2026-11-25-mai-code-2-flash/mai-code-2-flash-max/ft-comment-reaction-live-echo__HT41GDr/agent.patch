@@ -0,0 +1,37 @@
+require "application_system_test_case"
+
+class ReactionTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:layout)
+    @comment = comments(:layout_overflowing_david)
+  end
+
+  test "adds, cancels, and removes a comment reaction" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      assert_selector ".reaction__input", visible: true
+
+      find(".reaction__input").set("Canceled")
+      find(".reaction__cancel-btn").click
+      assert_selector ".reactions__trigger", visible: true
+
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nice")
+      find(".reaction__submit-btn").click
+
+      assert_text "Nice", wait: 5
+      assert_selector ".reactions__trigger", visible: true
+
+      find(".reaction", text: "Nice").click
+      assert_selector ".reaction__delete", visible: true
+      find(".reaction__delete button").click
+
+      assert_no_text "Nice", wait: 5
+    end
+  end
+end
