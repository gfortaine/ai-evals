diff --git a/app/views/cards/reactions/_reactions.html.erb b/app/views/cards/reactions/_reactions.html.erb
new file mode 100644
index 0000000..4d1a5fa
--- /dev/null
+++ b/app/views/cards/reactions/_reactions.html.erb
@@ -0,0 +1,54 @@
+<% reactions = reactable.reactions.includes(:reacter).chronologically %>
+<% if reactable.is_a?(Comment) %>
+  <% create_url = card_comment_reactions_path(reactable.card, reactable) %>
+<% else %>
+  <% create_url = card_reactions_path(reactable) %>
+<% end %>
+
+<div id="<%= dom_id(reactable, :reactions) %>" class="reactions" data-controller="reaction">
+  <div class="reactions__list">
+    <%= render partial: "cards/reactions/reaction", collection: reactions, as: :reaction %>
+  </div>
+
+  <% unless reactable.is_a?(Comment) && reactable.creator.system? %>
+    <button type="button" class="reactions__trigger btn btn--circle" data-reaction-target="trigger" data-action="click->reaction#open" aria-label="Add a reaction">
+      <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    </button>
+
+    <%= form_with url: create_url, scope: :reaction, class: "reaction__form flex align-center gap-half",
+          html: { hidden: true },
+          data: { reaction_target: "form", controller: "form",
+                  action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit keydown.esc->reaction#cancel:stop turbo:submit-end->reaction#submitted" } do |form| %>
+      <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+        <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="click->dialog#toggle:stop" aria-label="Choose an emoji" aria-haspopup="dialog">
+          <%= icon_tag "reaction" %>
+        </button>
+
+        <dialog class="reaction__popup popup panel flex-column align-start gap-half fill-white shadow" data-dialog-target="dialog">
+          <div class="reaction__emoji-list">
+            <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+              <button type="button" class="btn btn--plain" title="<%= label %>" aria-label="<%= label %>"
+                  data-reaction-emoji-param="<%= emoji %>" data-action="click->reaction#pickEmoji click->dialog#close">
+                <%= emoji %>
+              </button>
+            <% end %>
+          </div>
+        </dialog>
+      </div>
+
+      <label class="reaction__form-label">
+        <%= form.text_field :content, class: "reaction__input input", maxlength: 16,
+              autocomplete: "off", autofocus: true, placeholder: "Reaction",
+              aria: { label: "Reaction" },
+              data: { reaction_target: "input", form_target: "input", action: "keydown.enter->reaction#submit:prevent compositionstart->form#compositionStart compositionend->form#compositionEnd" } %>
+      </label>
+
+      <button type="submit" class="reaction__submit-btn btn btn--circle borderless" aria-label="Add reaction">
+        <%= icon_tag "check" %>
+      </button>
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reaction#cancel" aria-label="Cancel">
+        <%= icon_tag "close" %>
+      </button>
+    <% end %>
+  <% end %>
+</div>
