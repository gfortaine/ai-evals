diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..3572139
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,46 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "item" ]
+
+  open() {
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = true
+    if (this.hasFormTarget) {
+      this.formTarget.hidden = false
+      this.formTarget.classList.add("expanded")
+    }
+    this.inputTarget?.focus()
+  }
+
+  cancel() {
+    if (this.hasFormTarget) {
+      this.formTarget.reset()
+      this.formTarget.classList.remove("expanded")
+      this.formTarget.hidden = true
+    }
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = false
+  }
+
+  submit() {
+    if (this.hasFormTarget) this.formTarget.requestSubmit()
+  }
+
+  submitted({ detail }) {
+    if (detail.success) this.cancel()
+  }
+
+  pickEmoji({ params }) {
+    if (this.hasInputTarget && params.emoji) {
+      this.inputTarget.value = params.emoji
+      this.inputTarget.focus()
+    }
+  }
+
+  toggleDelete(event) {
+    if (event.target.closest("form")) return
+
+    if (this.hasItemTarget) {
+      this.itemTarget.classList.toggle("expanded")
+    }
+  }
+}
