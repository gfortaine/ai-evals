diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..838b93b
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,71 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(reacter: [ :avatar_attachment, :account ]) }
+
+  before_validation :normalize_content
+
+  after_create_commit :touch_reactable_card
+  after_destroy_commit :touch_reactable_card
+
+  def to_partial_path
+    "cards/reactions/reaction"
+  end
+
+  def emoji?
+    content.all_emoji?
+  end
+
+  def owned_by?(user)
+    reacter == user
+  end
+
+  def card
+    reactable.is_a?(Comment) ? reactable.card : reactable
+  end
+
+  def comment
+    reactable if reactable.is_a?(Comment)
+  end
+
+  def text
+    content
+  end
+
+  def text=(value)
+    self.content = value
+  end
+
+  def creator
+    reacter
+  end
+
+  def creator=(user)
+    self.reacter = user
+  end
+
+  def creator_id
+    reacter_id
+  end
+
+  def creator_id=(id)
+    self.reacter_id = id
+  end
+
+  private
+    def normalize_content
+      self.content = content&.strip
+    end
+
+    def touch_reactable_card
+      if reactable&.persisted?
+        reactable.touch
+        card.broadcast_refresh_later
+      end
+    end
+end
