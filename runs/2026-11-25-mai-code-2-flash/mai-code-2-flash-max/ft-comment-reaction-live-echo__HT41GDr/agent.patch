--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,56 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.includes(:reacter).chronologically
+    fresh_when etag: @reactions
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+    @reaction.card.broadcast_refresh_later
+
+    respond_to do |format|
+      format.turbo_stream { render_reactions_replacement }
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      format.html { redirect_back fallback_location: card_path(@card), allow_other_host: false }
+    end
+  end
+
+  def destroy
+    if @reaction.owned_by?(Current.user)
+      @reaction.destroy!
+      @reaction.card.broadcast_refresh_later
+
+      respond_to do |format|
+        format.turbo_stream { render_reactions_replacement }
+        format.json { head :no_content }
+        format.html { redirect_back fallback_location: card_path(@card), allow_other_host: false }
+      end
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions_replacement
+      render turbo_stream: turbo_stream.replace(helpers.dom_id(@comment, :reactions), partial: "cards/reactions/reactions", locals: { reactable: @comment })
+    end
+end
