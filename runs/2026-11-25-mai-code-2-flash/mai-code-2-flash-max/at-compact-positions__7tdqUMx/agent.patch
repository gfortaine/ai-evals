diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..97db3b5 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -37,6 +37,45 @@ class BookTest < ActiveSupport::TestCase
     assert_not_includes books(:handbook).markable, leaves(:summary_page).title
   end
 
+  test "compact positions preserves manually arranged order" do
+    handbook = books(:handbook)
+
+    leaves(:welcome_page).update_column(:position_score, 10)
+    leaves(:reading_picture).update_column(:position_score, 20)
+    leaves(:summary_page).update_column(:position_score, 30)
+    leaves(:welcome_section).update_column(:position_score, 40)
+
+    handbook.compact_positions!
+
+    assert_equal [ leaves(:welcome_page), leaves(:reading_picture), leaves(:summary_page), leaves(:welcome_section) ], handbook.leaves.positioned
+    assert_equal [ 1, 2, 3, 4 ], handbook.leaves.positioned.pluck(:position_score)
+  end
+
+  test "restored leaf returns to its compacted position" do
+    handbook = books(:handbook)
+
+    leaves(:welcome_section).update_column(:position_score, 10)
+    leaves(:welcome_page).update_column(:position_score, 20)
+    leaves(:summary_page).update_column(:position_score, 30)
+    leaves(:reading_picture).update_column(:position_score, 40)
+
+    leaves(:summary_page).trashed!
+    handbook.compact_positions!
+    leaves(:summary_page).update!(status: :active)
+
+    assert_equal [ leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page), leaves(:reading_picture) ], handbook.leaves.active.positioned
+  end
+
+  test "live leaf count excludes trashed leaves" do
+    handbook = books(:handbook)
+
+    assert_equal 4, handbook.live_leaf_count
+
+    leaves(:summary_page).trashed!
+
+    assert_equal 3, handbook.live_leaf_count
+  end
+
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
