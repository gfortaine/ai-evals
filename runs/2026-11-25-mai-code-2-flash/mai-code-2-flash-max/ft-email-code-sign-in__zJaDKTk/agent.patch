diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..907762f
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generates a six-character code" do
+    magic_link = MagicLink.generate(email_address: "person@example.com")
+
+    assert_equal 6, magic_link.code.length
+    assert_match(/\A[A-Z0-9]{6}\z/, magic_link.code)
+  end
+
+  test "a code verifies for fifteen minutes" do
+    magic_link = MagicLink.generate(email_address: "person@example.com")
+    token = magic_link.token
+
+    assert MagicLink.verify(token, code: magic_link.code)
+
+    travel_to 16.minutes.from_now do
+      assert_nil MagicLink.verify(token, code: magic_link.code)
+    end
+  end
+
+  test "the code and pending token include the authentication purpose" do
+    magic_link = MagicLink.generate(
+      email_address: "person@example.com",
+      purpose: MagicLink::SIGN_UP
+    )
+
+    found = MagicLink.find(magic_link.token)
+
+    assert_equal "person@example.com", found.email_address
+    assert_equal MagicLink::SIGN_UP, found.purpose
+  end
+end
