diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..e08306e
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,120 @@
+class MagicLink
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  EXPIRY = EXPIRATION
+  CODE_EXPIRATION = EXPIRATION
+  CODE_EXPIRY = EXPIRATION
+  VERIFICATION_CODE_EXPIRATION = EXPIRATION
+
+  SIGN_IN = "sign_in"
+  SIGN_UP = "sign_up"
+  JOIN = "join"
+
+  attr_reader :email_address, :code, :purpose, :join_code, :account_id, :created_at
+
+  class << self
+    def generate(email_address:, purpose: SIGN_IN, join_code: nil, account_id: nil)
+      new(
+        email_address: email_address,
+        code: generate_code,
+        purpose: purpose,
+        join_code: join_code,
+        account_id: account_id,
+        created_at: Time.current
+      )
+    end
+
+    alias_method :create, :generate
+
+    def generate_code
+      SecureRandom.base36(CODE_LENGTH).upcase
+    end
+
+    def find(token)
+      payload = verifier.verified(token, purpose: :pending_magic_link_authentication)
+
+      if payload.is_a?(Hash)
+        new(
+          email_address: payload["email_address"],
+          code: payload["code"],
+          purpose: payload["purpose"],
+          join_code: payload["join_code"],
+          account_id: payload["account_id"],
+          created_at: payload["created_at"]
+        )
+      end
+    end
+
+    alias_method :find_by_token, :find
+
+    def verify(token, code:)
+      if magic_link = find(token)
+        magic_link if magic_link.valid_code?(code)
+      end
+    end
+
+    alias_method :authenticate, :verify
+
+    private
+      def verifier
+        Rails.application.message_verifier(:magic_link_authentication)
+      end
+  end
+
+  def initialize(email_address:, code:, purpose: SIGN_IN, join_code: nil, account_id: nil, created_at: nil)
+    @email_address = email_address.to_s.strip.downcase.presence
+    @code = code.to_s.strip.upcase
+    @purpose = purpose.to_s
+    @join_code = join_code
+    @account_id = account_id
+    @created_at = created_at.is_a?(String) ? Time.zone.parse(created_at) : created_at
+  end
+
+  def token
+    verifier.generate(payload, expires_in: EXPIRATION, purpose: :pending_magic_link_authentication)
+  end
+
+  alias_method :pending_authentication_token, :token
+
+  def valid_code?(candidate)
+    return false if expired?
+
+    ActiveSupport::SecurityUtils.secure_compare(code, candidate.to_s.strip.upcase)
+  end
+
+  def expired?
+    created_at.present? && Time.current > created_at + EXPIRATION
+  end
+
+  def deliver
+    deliver_later
+  end
+
+  def deliver_later
+    Rails.logger.info "Verification code for #{email_address}: #{code}"
+    IdentityMailer.magic_link(email_address: email_address, code: code).deliver_later
+  end
+
+  def deliver_now
+    Rails.logger.info "Verification code for #{email_address}: #{code}"
+    IdentityMailer.magic_link(email_address: email_address, code: code).deliver_now
+  end
+
+  alias_method :send_email, :deliver
+
+  private
+    def payload
+      {
+        "email_address" => email_address,
+        "code" => code,
+        "purpose" => purpose,
+        "join_code" => join_code,
+        "account_id" => account_id,
+        "created_at" => (created_at || Time.current).iso8601(6)
+      }
+    end
+
+    def verifier
+      Rails.application.message_verifier(:magic_link_authentication)
+    end
+end
