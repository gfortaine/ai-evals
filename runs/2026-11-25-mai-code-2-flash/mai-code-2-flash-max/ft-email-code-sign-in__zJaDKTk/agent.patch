+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,108 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @pending_authentication_token = pending_authentication_token
+    @magic_link = pending_authentication_magic_link
+  end
+
+  def create
+    token = pending_authentication_token
+    magic_link = MagicLink.verify(token, code: params[:code])
+
+    if magic_link
+      complete_authentication(magic_link)
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def complete_authentication(magic_link)
+      if magic_link.purpose == MagicLink::SIGN_IN
+        complete_sign_in(magic_link)
+      elsif magic_link.purpose == MagicLink::SIGN_UP
+        complete_sign_up(magic_link)
+      elsif magic_link.purpose == MagicLink::JOIN
+        complete_join(magic_link)
+      else
+        invalid_code
+      end
+    end
+
+    def complete_sign_in(magic_link)
+      if identity = Identity.find_by(email_address: magic_link.email_address)
+        start_new_session_for identity
+        clear_pending_authentication
+
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        invalid_code
+      end
+    end
+
+    def complete_sign_up(magic_link)
+      identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+      start_new_session_for identity
+      clear_pending_authentication
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path(script_name: nil) }
+        format.json do
+          render json: { session_token: session_token }, status: :created
+        end
+      end
+    end
+
+    def complete_join(magic_link)
+      join_code = Account::JoinCode.find_by(code: magic_link.join_code)
+
+      if join_code&.active?
+        identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+        start_new_session_for identity
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by!(account: join_code.account, identity: identity)
+        clear_pending_authentication
+
+        respond_to do |format|
+          format.html do
+            if user.setup?
+              redirect_to landing_url(script_name: join_code.account.slug)
+            else
+              redirect_to new_users_verification_url(script_name: join_code.account.slug)
+            end
+          end
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        invalid_code
+      end
+    end
+
+    def invalid_code
+      clear_pending_authentication if params[:clear_pending_authentication]
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: "That code didn't work. Try again." }
+        format.json do
+          render json: { message: "That code didn't work. Try again.", error: "That code didn't work. Try again." }, status: :unauthorized
+        end
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
