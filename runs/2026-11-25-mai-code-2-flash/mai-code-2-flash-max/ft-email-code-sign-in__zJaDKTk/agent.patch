new file mode 100644
index 0000000..63e9777
--- /dev/null
+++ b/app/views/sessions/magic_links/new.html.erb
@@ -0,0 +1,33 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <p>Enter the six-character code we sent to your email.</p>
+
+  <% if !Rails.env.production? && @magic_link %>
+    <p>Psst, here's your code: <strong><%= @magic_link.code %></strong></p>
+  <% end %>
+
+  <%= form_with url: session_magic_link_path(script_name: nil), method: :post, class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+    <%= form.text_field :code,
+          required: true,
+          maxlength: 6,
+          class: "input txt-x-large txt-align-center",
+          autofocus: true,
+          autocomplete: "one-time-code",
+          autocapitalize: "characters",
+          placeholder: "ABC123" %>
+
+    <%= form.hidden_field :pending_authentication_token, value: @pending_authentication_token %>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
