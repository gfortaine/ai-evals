diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..c467860
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,98 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 14.days
+
+  included do
+    scope :burst, -> { where.not(burst_at: nil) }
+    scope :bursted, -> { where.not(burst_at: nil) }
+    scope :bursting, -> { bursted }
+    scope :with_burst, -> { bursted }
+    scope :stalled, -> { bursted.where(last_active_at: ..STALLED_AFTER.ago) }
+
+    after_update :reset_burst_after_card_update
+  end
+
+  def burst?
+    burst_at.present?
+  end
+  alias_method :bursted?, :burst?
+  alias_method :has_burst?, :burst?
+  alias_method :burst, :burst?
+  alias_method :bursting?, :burst?
+
+  def stalled?
+    burst? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def burst!(at: Time.current)
+    if persisted? && board.present?
+      update_columns(burst_at: at, last_active_at: at, updated_at: Time.current)
+    end
+  end
+  alias_method :mark_burst!, :burst!
+  alias_method :trigger_burst!, :burst!
+
+  def reset_burst!
+    if persisted? && board.present?
+      update_columns(burst_at: nil, updated_at: Time.current)
+    end
+  end
+  alias_method :clear_burst!, :reset_burst!
+
+  def reset_card_activity!(at: Time.current)
+    if persisted? && board.present?
+      update_columns(burst_at: nil, last_active_at: at, updated_at: Time.current)
+    end
+  end
+
+  def comment_burst_at(through: nil)
+    window = board.auto_postpone_period / 3.0
+    comments = self.comments.by_user.order(:created_at, :id).pluck(:creator_id, :created_at)
+    comments = comments.select { |_, comment_at| comment_at <= through } if through
+
+    left = 0
+    burst_at = nil
+
+    comments.each_with_index do |(_, comment_at), right|
+      while left <= right && comment_at - comments[left].last > window
+        left += 1
+      end
+
+      window_comments = comments[left..right]
+      if window_comments.length >= 3 && window_comments.map(&:first).uniq.length >= 2
+        if through
+          burst_at = comment_at if comment_at == through
+        else
+          burst_at = comment_at
+        end
+      end
+    end
+
+    burst_at
+  end
+
+  def comment_burst?
+    comment_burst_at.present?
+  end
+
+  def register_comment_burst!(through: nil)
+    if at = comment_burst_at(through: through)
+      burst!(at: at)
+    end
+  end
+
+  private
+    def reset_burst_after_card_update
+      return unless persisted? && board.present?
+
+      changed_keys = saved_changes.keys.map(&:to_s)
+      activity_changes = changed_keys - %w[ burst_at last_active_at updated_at board_id column_id ]
+
+      if activity_changes.any?
+        reset_card_activity!
+      elsif changed_keys == [ "updated_at" ]
+        reset_card_activity!
+      end
+    end
+end
