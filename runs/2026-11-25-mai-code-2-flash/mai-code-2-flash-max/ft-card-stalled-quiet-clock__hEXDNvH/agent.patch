diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..31af21d
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people create a burst" do
+    card = cards(:text)
+    card.comments.delete_all
+
+    travel_to 1.hour.ago do
+      card.comments.create!(body: "One", creator: users(:david))
+      card.comments.create!(body: "Two", creator: users(:kevin))
+      card.comments.create!(body: "Three", creator: users(:david))
+    end
+
+    assert card.reload.burst?
+    assert card.comment_burst?
+    assert_not card.stalled?
+  end
+
+  test "comments outside the burst window do not create a burst" do
+    card = cards(:text)
+    card.comments.delete_all
+
+    travel_to 40.days.ago do
+      card.comments.create!(body: "One", creator: users(:david))
+    end
+    travel_to 20.days.ago do
+      card.comments.create!(body: "Two", creator: users(:kevin))
+    end
+    travel_to Time.current do
+      card.comments.create!(body: "Three", creator: users(:david))
+    end
+
+    assert_not card.reload.burst?
+    assert_not card.comment_burst?
+  end
+
+  test "assignment creates a burst that becomes stalled" do
+    card = cards(:text)
+
+    travel_to 20.days.ago do
+      card.toggle_assignment users(:david)
+    end
+
+    assert card.reload.burst?
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "reopening creates a burst that becomes stalled" do
+    card = cards(:shipping)
+
+    travel_to 20.days.ago do
+      card.reopen
+    end
+
+    assert card.reload.burst?
+    assert card.stalled?
+  end
+
+  test "any activity resets a burst" do
+    card = cards(:text)
+
+    travel_to 20.days.ago do
+      card.toggle_assignment users(:david)
+    end
+    assert card.reload.stalled?
+
+    card.comments.create!(body: "Reset", creator: users(:kevin))
+
+    assert_not card.reload.burst?
+    assert_not card.stalled?
+  end
+
+  test "stalled cards are available through the filter" do
+    card = cards(:text)
+
+    travel_to 20.days.ago do
+      card.toggle_assignment users(:david)
+    end
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_includes filter.cards, card
+  end
+end
