diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..a5d7900
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "local_time sends a raw UTC timestamp to the browser" do
+    time = Time.utc(2025, 9, 12, 13, 42, 0)
+    element = parse(local_time(time)).at_css("time")
+
+    assert_equal time.iso8601, element["datetime"]
+    assert_equal "time", element["data-controller"]
+    assert_equal "relative", element["data-time-format-value"]
+    assert_equal "relative", element["data-local-time-format"]
+    assert_empty element.text
+  end
+
+  test "local_time accepts a format keyword" do
+    time = Time.utc(2025, 9, 12, 13, 42, 0)
+    element = parse(local_time(time, format: "full-date")).at_css("time")
+
+    assert_equal "full-date", element["data-time-format-value"]
+  end
+
+  test "local_time preserves additional element attributes" do
+    time = Time.utc(2025, 9, 12, 13, 42, 0)
+    element = parse(local_time(time, class: "timestamp")).at_css("time")
+
+    assert_equal "timestamp", element["class"]
+  end
+end
