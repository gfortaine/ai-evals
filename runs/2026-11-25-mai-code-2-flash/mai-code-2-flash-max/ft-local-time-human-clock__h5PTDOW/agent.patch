diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..3fd1945
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,56 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatFullDate,
+  formatMonthDay,
+  formatMonthDayYear,
+  formatRelativeTime,
+  formatShortDateTime,
+  formatTime
+} from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.update()
+
+    this.observer = new MutationObserver(() => this.update())
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+
+    if (this.formatValue === "relative") {
+      this.timer = setInterval(() => this.update(), 60_000)
+    }
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+    clearInterval(this.timer)
+  }
+
+  update() {
+    const datetime = this.element.getAttribute("datetime")
+    const date = datetime ? new Date(datetime) : null
+
+    if (!date || Number.isNaN(date.getTime())) return
+
+    const formatted = this.#format(date)
+    if (formatted) this.element.textContent = formatted
+  }
+
+  #format(date) {
+    switch (this.formatValue) {
+      case "time":
+        return formatTime(date)
+      case "date":
+        return formatMonthDay(date)
+      case "full-date":
+        return formatFullDate(date)
+      case "month-day-year":
+        return formatMonthDayYear(date)
+      case "short-date-time":
+        return formatShortDateTime(date)
+      default:
+        return formatRelativeTime(date)
+    }
+  }
+}
