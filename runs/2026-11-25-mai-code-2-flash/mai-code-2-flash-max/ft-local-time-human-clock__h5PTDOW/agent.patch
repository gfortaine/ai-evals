@@ -1,2 +1,29 @@
 module TimeHelper
+  def local_time(time, format = nil, **options)
+    format = options.delete(:format) || options.delete("format") || format || :relative
+
+    if time
+      data = options.delete(:data) || {}
+      data = data.stringify_keys
+      data["controller"] = [ data["controller"], "time" ].compact.reject(&:blank?).join(" ")
+      data["time-format-value"] = format.to_s
+      data["local-time-format"] = format.to_s
+
+      tag.time datetime: time.utc.iso8601, data: data, **options
+    else
+      ""
+    end
+  end
+
+  alias_method :local_time_tag, :local_time
+  alias_method :local_datetime, :local_time
+  alias_method :local_relative_time, :local_time
+
+  def local_time_ago(time, **options)
+    local_time time, :relative, **options
+  end
+
+  def local_date(time, **options)
+    local_time time, :date, **options
+  end
 end
