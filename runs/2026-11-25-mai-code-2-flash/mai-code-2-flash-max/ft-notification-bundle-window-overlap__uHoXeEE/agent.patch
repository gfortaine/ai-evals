diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..ddc6f12
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,40 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle_or_user = nil, notification_list = nil, user: nil, bundle: nil, notifications: nil)
+    if bundle
+      @bundle = bundle
+      @notifications = bundle.notifications.preloaded
+      @user = bundle.user
+      @account = bundle.account
+    elsif bundle_or_user.respond_to?(:notifications)
+      @bundle = bundle_or_user
+      @notifications = bundle_or_user.notifications.preloaded
+      @user = bundle_or_user.user
+      @account = bundle_or_user.account
+    else
+      notification_list = notifications if notifications
+      @notifications = Array(notification_list || bundle_or_user)
+      @user = user || (bundle_or_user.is_a?(User) ? bundle_or_user : @notifications.first&.user)
+      @account = @user&.account
+      @bundle = nil
+    end
+
+    @notifications = @notifications.to_a
+
+    Current.with_account(@account) do
+      mail(
+        to: @user.identity.email_address,
+        subject: "Your Fizzy notification digest (#{@notifications.length})"
+      )
+    end
+  end
+
+  def bundle(bundle)
+    digest(bundle)
+  end
+
+  def notification_digest(bundle)
+    digest(bundle)
+  end
+end
+
+Notification::Mailer = NotificationMailer
