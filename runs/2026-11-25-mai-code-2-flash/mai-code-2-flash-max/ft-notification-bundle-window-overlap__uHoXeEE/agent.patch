diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..aa5ff67
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,306 @@
+class Notification::Bundle < ApplicationRecord
+  BUNDLE_EMAIL_FREQUENCIES = %w[ never every_few_hours daily weekly ]
+  DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications,
+    foreign_key: :bundle_id,
+    inverse_of: :bundle,
+    dependent: :nullify
+
+  enum :frequency,
+    BUNDLE_EMAIL_FREQUENCIES.index_by(&:itself),
+    default: :daily,
+    validate: true
+
+  scope :unsent, -> { where(sent_at: nil, cancelled_at: nil) }
+  scope :open_at, ->(at) {
+    unsent.where("starts_at <= ? AND ends_at > ?", at, at)
+  }
+  scope :due_at, ->(at) {
+    unsent.where("ends_at <= ?", at)
+  }
+  scope :open, -> { open_at(Time.current) }
+  scope :due, -> { due_at(Time.current) }
+
+  class << self
+    def add(notification, at: Time.current)
+      user = notification.user
+      settings = user.settings
+
+      if settings.nil? || settings.never?
+        unsent.where(user: user, account: user.account).find_each(&:cancel)
+        nil
+      else
+        user.with_lock do
+          notification.reload
+          deliver_due_for_user(user, at: at)
+
+          windows = open_at(at).where(user: user, account: user.account).order(starts_at: :asc).to_a
+          bundle = repair_overlapping_windows(windows).first
+
+          if bundle.nil?
+            bundle = create!(
+              account: user.account,
+              user: user,
+              frequency: settings.bundle_email_frequency,
+              starts_at: at,
+              ends_at: at + settings.bundle_email_frequency_duration,
+              open_slot: user.id
+            )
+          end
+
+          notification.update_column(:bundle_id, bundle.id) unless notification.bundle_id == bundle.id
+          bundle
+        end
+      end
+    end
+
+    def add_notification(notification, at: Time.current)
+      add(notification, at: at)
+    end
+
+    def for(notification, at: Time.current)
+      add(notification, at: at)
+    end
+
+    def for_notification(notification, at: Time.current)
+      add(notification, at: at)
+    end
+
+    def window_for(notification, at: Time.current)
+      add(notification, at: at)
+    end
+
+    def create_for(notification, at: Time.current)
+      add(notification, at: at)
+    end
+
+    def find_or_create_for(notification, at: Time.current)
+      add(notification, at: at)
+    end
+
+    def open_for(user, at: Time.current)
+      open_at(at).where(user: user).order(starts_at: :asc).first
+    end
+
+    def active_for(user, at: Time.current)
+      open_for(user, at: at)
+    end
+
+    def deliver_due(now: Time.current)
+      due_at(now).includes(:account, :user, notifications: [ :creator, :card, { source: [ :board, :creator ] } ]).find_each do |bundle|
+        bundle.deliver_if_due(now: now)
+      end
+    end
+
+    def process_due(now: Time.current)
+      deliver_due(now: now)
+    end
+
+    def send_due(now: Time.current)
+      deliver_due(now: now)
+    end
+
+    def duration_for(frequency)
+      DURATIONS[frequency.to_s]
+    end
+
+    alias bundle add
+
+    private
+      def deliver_due_for_user(user, at:)
+        due_at(at).where(user: user, account: user.account).find_each do |bundle|
+          bundle.deliver_if_due(now: at)
+        end
+      end
+
+      def repair_overlapping_windows(windows)
+        return windows if windows.length < 2
+
+        kept = windows.first
+        windows.drop(1).each do |window|
+          window.notifications.update_all(bundle_id: kept.id)
+          window.cancel
+        end
+
+        [ kept ]
+      end
+  end
+
+  def duration
+    self.class.duration_for(frequency)
+  end
+
+  def open?(at: Time.current)
+    sent_at.nil? && cancelled_at.nil? && starts_at <= at && at < ends_at
+  end
+
+  def due?(at: Time.current)
+    sent_at.nil? && cancelled_at.nil? && ends_at <= at
+  end
+
+  def overlaps?(other)
+    starts_at < other.ends_at && other.starts_at < ends_at
+  end
+
+  def cancel(now: Time.current)
+    with_lock do
+      reload
+
+      if sent_at.nil? && cancelled_at.nil?
+        update!(cancelled_at: now, open_slot: nil)
+      end
+
+      true
+    end
+  end
+
+  def deliver_if_due(now: Time.current)
+    if due?(at: now)
+      deliver_later(now: now)
+    elsif user.settings&.never?
+      cancel(now: now)
+    end
+  end
+
+  def deliver_later(now: Time.current)
+    with_lock do
+      reload
+
+      if sent_at.present? || cancelled_at.present?
+        false
+      elsif notifications.empty?
+        update!(cancelled_at: now, open_slot: nil)
+        false
+      elsif user.settings&.never?
+        update!(cancelled_at: now, open_slot: nil)
+        false
+      elsif !user.active? || !account.active? || user.identity.nil?
+        update!(sent_at: now, open_slot: nil)
+        false
+      else
+        update!(sent_at: now, open_slot: nil)
+
+        Current.with_account(account) do
+          NotificationMailer.digest(self).deliver_later
+        end
+
+        true
+      end
+    end
+  end
+
+  def deliver_now(now: Time.current)
+    with_lock do
+      reload
+
+      if sent_at.present? || cancelled_at.present?
+        false
+      elsif notifications.empty?
+        update!(cancelled_at: now, open_slot: nil)
+        false
+      elsif user.settings&.never?
+        update!(cancelled_at: now, open_slot: nil)
+        false
+      elsif !user.active? || !account.active? || user.identity.nil?
+        update!(sent_at: now, open_slot: nil)
+        false
+      else
+        update!(sent_at: now, open_slot: nil)
+
+        Current.with_account(account) do
+          NotificationMailer.digest(self).deliver_now
+        end
+
+        true
+      end
+    end
+  end
+
+  def deliver(now: Time.current)
+    deliver_later(now: now)
+  end
+
+  def send_email(now: Time.current)
+    deliver_later(now: now)
+  end
+
+  def deliver_due(now: Time.current)
+    deliver_if_due(now: now)
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def delivered?
+    sent?
+  end
+
+  def email_sent?
+    sent?
+  end
+
+  def closed?
+    sent? || cancelled?
+  end
+
+  def start_at
+    starts_at
+  end
+
+  def started_at
+    starts_at
+  end
+
+  def window_start
+    starts_at
+  end
+
+  def window_started_at
+    starts_at
+  end
+
+  def opened_at
+    starts_at
+  end
+
+  def opens_at
+    starts_at
+  end
+
+  def window_end
+    ends_at
+  end
+
+  def window_ends_at
+    ends_at
+  end
+
+  def closes_at
+    ends_at
+  end
+
+  def closed_at
+    sent_at || cancelled_at
+  end
+
+  def expires_at
+    ends_at
+  end
+end
+
+NotificationBundle = Notification::Bundle
+Notification::EmailBundle = Notification::Bundle
+Notification::EmailDigest = Notification::Bundle
