diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..1fa0de3
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "digest sends the notifications in a bundle" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    user.notifications.destroy_all
+
+    travel_to Time.zone.parse("2026-11-23 10:00") do
+      notification = Notification.create!(
+        user: user,
+        source: events(:layout_commented),
+        creator: users(:david)
+      )
+
+      email = NotificationMailer.digest(notification.bundle)
+
+      assert_equal [ user.identity.email_address ], email.to
+      assert_includes email.subject, "notification digest"
+      assert_includes email.text_part.body.decoded, "Layout is broken"
+    end
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..48db2c6
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @creator = users(:david)
+    @user.notifications.destroy_all
+  end
+
+  test "defaults to never and exposes the supported frequencies" do
+    assert @user.settings.never?
+    assert_equal %w[ never every_few_hours daily weekly ], User::Settings::BUNDLE_EMAIL_FREQUENCIES
+  end
+
+  test "notification lands in the already-open window" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    travel_to Time.zone.parse("2026-11-23 10:00") do
+      first = Notification.create!(
+        user: @user,
+        source: events(:layout_commented),
+        creator: @creator
+      )
+      late = Notification.create!(
+        user: @user,
+        source: events(:logo_published),
+        creator: @creator,
+        created_at: 2.hours.before
+      )
+
+      assert_equal first.bundle, late.bundle
+      assert_equal Time.zone.parse("2026-11-23 10:00"), late.bundle.starts_at
+      assert_equal 1.day.from_now, late.bundle.ends_at
+    end
+  end
+
+  test "every few hours, daily, and weekly choose the matching duration" do
+    {
+      "every_few_hours" => 4.hours,
+      "daily" => 1.day,
+      "weekly" => 1.week
+    }.each do |frequency, duration|
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      travel_to Time.zone.parse("2026-11-23 10:00") do
+        notification = Notification.create!(
+          user: @user,
+          source: events(:layout_commented),
+          creator: @creator
+        )
+
+        assert_equal duration, notification.bundle.ends_at - notification.bundle.starts_at
+      end
+
+      @user.notifications.destroy_all
+      Notification::Bundle.where(user: @user).destroy_all
+    end
+  end
+
+  test "a notification after the end opens the next window without overlap" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    first = travel_to Time.zone.parse("2026-11-23 10:00") do
+      Notification.create!(
+        user: @user,
+        source: events(:layout_commented),
+        creator: @creator
+      )
+    end
+
+    second = travel_to Time.zone.parse("2026-11-23 14:00") do
+      Notification.create!(
+        user: @user,
+        source: events(:logo_published),
+        creator: @creator
+      )
+    end
+
+    assert_not_equal first.bundle_id, second.bundle_id
+    assert_operator first.bundle.ends_at, :<=, second.bundle.starts_at
+  end
+
+  test "a due window sends once" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    bundle = travel_to Time.zone.parse("2026-11-23 10:00") do
+      Notification.create!(
+        user: @user,
+        source: events(:layout_commented),
+        creator: @creator
+      ).bundle
+    end
+
+    travel_to bundle.ends_at do
+      assert_difference -> { ActionMailer::Base.deliveries.length }, 1 do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_due
+        end
+      end
+
+      assert bundle.reload.sent?
+
+      assert_no_difference -> { ActionMailer::Base.deliveries.length } do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_due
+        end
+      end
+    end
+  end
+
+test "changing to never cancels the open window" do
+  @user.settings.update!(bundle_email_frequency: "daily")
+
+  bundle = travel_to Time.zone.parse("2026-11-23 10:00") do
+    Notification.create!(
+      user: @user,
+      source: events(:layout_commented),
+      creator: @creator
+    ).bundle
+  end
+
+  travel_to Time.zone.parse("2026-11-23 11:00") do
+    @user.settings.update!(bundle_email_frequency: "never")
+  end
+
+  assert bundle.reload.cancelled?
+end
+
+  test "never does not create an email bundle" do
+    notification = Notification.create!(
+      user: @user,
+      source: events(:layout_commented),
+      creator: @creator
+    )
+
+    assert_nil notification.bundle
+    assert_empty Notification::Bundle.where(user: @user)
+  end
+end
