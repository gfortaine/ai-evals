+class Notification::BundleDeliveryJob < ApplicationJob
+  def perform(now = nil, **options)
+    now ||= options[:now]
+    if now
+      Notification::Bundle.deliver_due(now: now.respond_to?(:to_time) ? now : Time.zone.parse(now.to_s))
+    else
+      Notification::Bundle.deliver_due
+    end
+  end
+end
