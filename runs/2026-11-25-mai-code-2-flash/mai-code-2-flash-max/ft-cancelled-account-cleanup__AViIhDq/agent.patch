diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..833a0ae 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,93 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+    scope :due_for_incineration, -> { incineration_due }
+
+    before_destroy :purge_account_join_table_rows
+    before_destroy :purge_account_scoped_database_records
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    destroy!
+  end
+
+  def incineration_due?
+    cancellation.present? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  def due_for_incineration?
+    incineration_due?
+  end
+
+  private
+    def purge_account_join_table_rows
+      user_ids = users.ids
+      board_ids = boards.ids
+      filter_ids = Filter.where(account_id: id).ids
+      tag_ids = Tag.where(account_id: id).ids
+
+      delete_join_table_rows "assignees_filters", "assignee_id", user_ids
+      delete_join_table_rows "assigners_filters", "assigner_id", user_ids
+      delete_join_table_rows "closers_filters", "closer_id", user_ids
+      delete_join_table_rows "creators_filters", "creator_id", user_ids
+      delete_join_table_rows "boards_filters", "board_id", board_ids
+      delete_join_table_rows "filters_tags", "filter_id", filter_ids
+      delete_join_table_rows "filters_tags", "tag_id", tag_ids
+    end
+
+    def delete_join_table_rows(table, column, ids)
+      return if ids.empty?
+
+      connection = self.class.connection
+      return unless connection.data_source_exists?(table)
+
+      quoted_ids = ids.map { |record_id| connection.quote(record_id) }.join(", ")
+      connection.execute \
+        "DELETE FROM #{connection.quote_table_name(table)} " \
+        "WHERE #{connection.quote_column_name(column)} IN (#{quoted_ids})"
+    end
+
+    def purge_account_scoped_database_records
+      purge_search_records
+      purge_active_storage
+      purge_storage_totals
+      purge_account_scoped_tables
+    end
+
+    def purge_search_records
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+    end
+
+    def purge_active_storage
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
+
+    def purge_storage_totals
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: boards.ids).delete_all
+    end
+
+    def purge_account_scoped_tables
+      connection = self.class.connection
+
+      connection.tables.each do |table|
+        next if table == "accounts"
+
+        if connection.columns(table).any? { |column| column.name == "account_id" }
+          connection.execute \
+            "DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(id)}"
+        end
+      end
+    end
 end
