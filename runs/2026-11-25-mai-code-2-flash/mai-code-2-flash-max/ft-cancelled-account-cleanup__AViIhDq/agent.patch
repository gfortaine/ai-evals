diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..74a911d
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than 30 days ago" do
+    due_account = Account.create!(name: "Due account")
+    due_account.create_cancellation!(initiated_by: users(:david))
+    due_account.cancellation.update!(created_at: 31.days.ago)
+
+    recent_account = Account.create!(name: "Recent account")
+    recent_account.create_cancellation!(initiated_by: users(:david))
+    recent_account.cancellation.update!(created_at: 29.days.ago)
+
+    board = Board.create!(account: due_account, creator: users(:david), name: "Due board")
+    card = Card.create!(account: due_account, board: board, creator: users(:david), title: "Due card")
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due_account.id)
+    assert_not Board.exists?(board.id)
+    assert_not Card.exists?(card.id)
+    assert Account.exists?(recent_account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..6bd9f13
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @initiated_by = users(:david)
+  end
+
+  test "accounts with cancellations older than the grace period are due" do
+    @account.create_cancellation!(initiated_by: @initiated_by)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_includes Account.incineration_due, @account
+
+    @account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_not_includes Account.incineration_due, @account
+  end
+
+  test "an account is due only after the grace period" do
+    @account.create_cancellation!(initiated_by: @initiated_by)
+
+    travel_to Time.current do
+      @account.cancellation.update!(created_at: 30.days.ago)
+
+      assert_not_includes Account.incineration_due, @account
+      assert_not @account.incineration_due?
+
+      @account.cancellation.update!(created_at: 30.days.ago - 1.second)
+
+      assert_includes Account.incineration_due, @account
+      assert @account.incineration_due?
+    end
+  end
+
+  test "incinerating an account removes its tenant data" do
+    board = Board.create!(account: @account, creator: @initiated_by, name: "Due account board")
+    card = Card.create!(account: @account, board: board, creator: @initiated_by, title: "Due account card")
+
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("account data"),
+      filename: "account.txt",
+      content_type: "text/plain"
+    )
+    card.image.attach(blob)
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_not Board.exists?(board.id)
+    assert_not Card.exists?(card.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+  end
+end
