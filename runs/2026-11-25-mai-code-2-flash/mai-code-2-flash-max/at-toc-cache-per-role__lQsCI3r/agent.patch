diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..edffce4 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -108,10 +108,85 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_not_in_body "&lt;"
   end
 
+  test "editor controls are not shared between viewers" do
+    with_fragment_cache do
+      get book_slug_url(books(:handbook))
+
+      assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", minimum: 1
+
+      sign_out
+      sign_in :jz
+      get book_slug_url(books(:handbook))
+
+      assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", count: 0
+      assert_select "form[action='#{leafable_path(leaves(:welcome_page))}']", count: 0
+
+      sign_out
+      sign_in :kevin
+      get book_slug_url(books(:handbook))
+
+      assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", minimum: 1
+    end
+  end
+
+  test "a renamed entry is visible to the next viewer" do
+    with_fragment_cache do
+      get book_slug_url(books(:handbook))
+      assert_select ".toc__leaf span.overflow-ellipsis", text: "Welcome to The Handbook!"
+
+      put leafable_path(leaves(:welcome_page)), params: {
+        leaf: { title: "Renamed entry" },
+        page: { body: "Updated body" }
+      }
+
+      sign_out
+      sign_in :jz
+      get book_slug_url(books(:handbook))
+
+      assert_select ".toc__leaf span.overflow-ellipsis", text: "Renamed entry"
+      assert_select ".toc__leaf span.overflow-ellipsis", text: "Welcome to The Handbook!", count: 0
+    end
+  end
+
+  test "show loads book access without one lookup per entry" do
+    sign_out
+    sign_in :jz
+
+    access_queries = 0
+    callback = ->(_name, _start, _finish, _id, payload) do
+      access_queries += 1 if payload[:sql].to_s.match?(/SELECT\s+"?accesses"?\.\*/i)
+    end
+
+    ActiveSupport::Notifications.subscribed(callback, "sql.active_record") do
+      get book_slug_url(books(:handbook))
+    end
+
+    assert_response :success
+    assert_operator access_queries, :<=, 1
+  end
+
   test "show includes link to markdown format" do
     get book_slug_path(books(:handbook))
 
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  private
+    def with_fragment_cache
+      original_performing_caching = ActionController::Base.perform_caching
+      original_cache = Rails.cache
+      original_collection_cache = ActionView::PartialRenderer.collection_cache
+      cache = ActiveSupport::Cache::MemoryStore.new
+
+      ActionController::Base.perform_caching = true
+      Rails.cache = cache
+      ActionView::PartialRenderer.collection_cache = cache
+
+      yield
+    ensure
+      ActionController::Base.perform_caching = original_performing_caching
+      Rails.cache = original_cache
+      ActionView::PartialRenderer.collection_cache = original_collection_cache
+    end
 end
