+  def perform(last_leaf_id = nil, **options)
+    last_leaf_id ||= options[:cursor] || options[:from_id] || options[:start_leaf_id] || options[:start_at]
+
+    leaves = Leaf.order(:id).where(title_cleanup_completed_at: nil)
+    leaves = leaves.where("leaves.id >= ?", last_leaf_id) if last_leaf_id.present?
+
+    leaves.find_each do |leaf|
+      Leaf.transaction do
+        leaf.lock!
+        next if leaf.title_cleanup_completed_at?
+
+        leaf.update!(title: cleaned(leaf.title), title_cleanup_completed_at: Time.current)
+      end
     end
   end
 
   private
     def cleaned(title)
-      title.delete_prefix('"').delete_suffix('"')
+      return title unless title.length >= 2 && title.start_with?('"') && title.end_with?('"')
+
+      title[1...-1]
     end
 end
