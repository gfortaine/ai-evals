diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..4d85dd7
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  test "removes only the outer quotes and preserves inner quotes" do
+    first = leaves(:welcome_page)
+    second = leaves(:summary_page)
+    third = leaves(:reading_picture)
+
+    first.update!(title: '"Welcome to the Handbook"')
+    second.update!(title: '""Quoted phrase" Chapter"')
+    third.update!(title: '"Legitimate "quoted" title"')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Welcome to the Handbook", first.reload.title
+    assert_equal '"Quoted phrase" Chapter', second.reload.title
+    assert_equal 'Legitimate "quoted" title', third.reload.title
+  end
+
+  test "resumes after an interruption without reprocessing completed leaves" do
+    first = leaves(:welcome_page)
+    second = leaves(:summary_page)
+    third = leaves(:reading_picture)
+
+    first.update!(title: '"First"')
+    second.update!(title: '"Second"')
+    third.update!(title: '"Third"')
+
+    job = TitleCleanupJob.new
+    job.define_singleton_method(:cleaned) do |title|
+      raise "deploy interrupted" if title == '"Second"'
+
+      title.delete_prefix('"').delete_suffix('"')
+    end
+
+    assert_raises(RuntimeError) { job.perform }
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "First", first.reload.title
+    assert_equal "Second", second.reload.title
+    assert_equal "Third", third.reload.title
+  end
+
+  test "leaves titles that are not wrapped in quotes unchanged" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: '"Quoted phrase" continues')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Quoted phrase" continues', leaf.reload.title
+  end
+end
