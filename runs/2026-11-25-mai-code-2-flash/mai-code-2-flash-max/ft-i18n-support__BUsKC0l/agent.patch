diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..b4aad75
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,44 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_locale
+    helper_method :current_locale
+  end
+
+  private
+    def set_locale
+      locale = requested_locale || identity_locale || cookie_locale || I18n.default_locale
+
+      I18n.locale = locale
+      Current.locale = locale
+
+      if requested_locale.present?
+        cookies.permanent[:locale] = locale.to_s
+        Current.identity&.update!(locale: locale.to_s)
+      elsif identity_locale.present?
+        cookies.permanent[:locale] = locale.to_s
+      elsif cookie_locale.present?
+        cookies.permanent[:locale] = locale.to_s
+      end
+    end
+
+    def requested_locale
+      locale = params[:locale].to_s
+      locale.to_sym if I18n.available_locales.map(&:to_s).include?(locale)
+    end
+
+    def identity_locale
+      locale = Current.identity&.locale.to_s
+      locale.to_sym if I18n.available_locales.map(&:to_s).include?(locale)
+    end
+
+    def cookie_locale
+      locale = cookies[:locale].to_s
+      locale.to_sym if I18n.available_locales.map(&:to_s).include?(locale)
+    end
+
+    def current_locale
+      I18n.locale
+    end
+end
