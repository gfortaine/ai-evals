diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..4d45c3e
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "Japanese query locale renders Japanese and sticks in the cookie and identity" do
+    sign_in_as :kevin
+
+    get cards_path(locale: :ja)
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", cookies[:locale]
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "Japanese locale sticks across subsequent clean requests" do
+    sign_in_as :kevin
+    get cards_path(locale: :ja)
+
+    get cards_path
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "unsupported query locale never switches the locale" do
+    sign_in_as :kevin
+
+    get cards_path(locale: :xx)
+
+    assert_response :success
+    assert_select "html[lang='en']"
+  end
+
+  test "people with no locale choice keep the existing English experience" do
+    sign_in_as :kevin
+    identities(:kevin).update!(locale: nil)
+
+    get cards_path
+
+    assert_response :success
+    assert_select "html[lang='en']"
+  end
+
+  test "cookie locale survives sign out and a clean sign in" do
+    sign_in_as :kevin
+    get cards_path(locale: :ja)
+    sign_out
+
+    sign_in_as :kevin
+
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "static error pages contain English and Japanese" do
+    %w[400 404 406-unsupported-browser 422 500].each do |status|
+      body = File.read(Rails.root.join("public/#{status}.html"))
+      assert_includes body, "lang=\"en\""
+      assert_includes body, "lang=\"ja\""
+    end
+  end
+
+  test "magic link email uses the identity locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    email = identity.send_magic_link
+    magic_link = identity.magic_links.order(created_at: :desc).first
+    mail = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_includes mail.subject, "確認コード"
+    assert_includes mail.text_part&.body&.decoded.to_s, "確認コード"
+  end
+end
