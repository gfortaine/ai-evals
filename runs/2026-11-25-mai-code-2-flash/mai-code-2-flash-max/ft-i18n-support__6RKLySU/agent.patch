diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..7b1fb74
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "people without a choice stay in English" do
+    untenanted { get new_session_path }
+
+    assert_response :success
+    assert_select "html[lang='en']"
+  end
+
+  test "ja query parameter switches the locale and is stored in cookies and the session" do
+    untenanted { get new_session_path(locale: "ja") }
+
+    assert_response :success
