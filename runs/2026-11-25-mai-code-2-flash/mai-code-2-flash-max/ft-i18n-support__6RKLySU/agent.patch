   helper AvatarsHelper, HtmlHelper
 
   private
+    def with_recipient_locale(record = nil)
+      locale = recipient_locale(record)
+      I18n.with_locale(locale) { yield }
+    end
+
+    def recipient_locale(record = nil)
+      identity = if record.is_a?(Identity)
+        record
+      elsif record.respond_to?(:identity)
+        record.identity
+      elsif record.respond_to?(:user)
+        record.user&.identity
+      end
+
+      locale = identity&.locale.presence
+      locale.in?(I18n.available_locales.map(&:to_s)) ? locale.to_sym : I18n.default_locale
+    end
+
     def default_url_options
       if Current.account
