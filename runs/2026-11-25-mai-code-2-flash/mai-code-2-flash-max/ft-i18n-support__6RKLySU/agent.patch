diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..208aedd
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,95 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[ en ja ].freeze
+
+  included do
+    around_action :set_current_locale
+
+    helper_method :current_locale
+
+    etag { current_locale }
+  end
+
+  private
+    def set_current_locale(&)
+      locale = resolved_locale
+
+      I18n.with_locale(locale) do
+        if @locale_was_chosen
+          session[:locale] = locale
+          session[:locale_explicit] = true
+          persist_locale_cookie(locale)
+        end
+
+        yield
+      ensure
+        persist_identity_locale(locale) if @locale_was_chosen
+      end
+    end
+
+    def resolved_locale
+      if locale = requested_locale
+        @locale_was_chosen = true
+        locale
+      elsif locale = identity_locale
+        @locale_was_chosen = true
+        locale
+      elsif locale = session_locale
+        @locale_was_chosen = true
+        locale
+      elsif locale = locale_cookie
+        @locale_was_chosen = true
+        locale
+      else
+        @locale_was_chosen = false
+        I18n.default_locale.to_s
+      end
+    end
+
+    def requested_locale
+      locale = params[:locale].to_s
+      locale if locale.in?(SUPPORTED_LOCALES)
+    end
+
+    def identity_locale
+      locale = identity_for_locale_request&.locale
+      locale if locale.in?(SUPPORTED_LOCALES)
+    end
+
+    def session_locale
+      if session[:locale_explicit]
+        locale = session[:locale].to_s
+        locale if locale.in?(SUPPORTED_LOCALES)
+      end
+    end
+
+    def locale_cookie
+      locale = cookies[:locale].presence
+      locale = locale.to_s
+      locale if locale.in?(SUPPORTED_LOCALES)
+    rescue ArgumentError
+      nil
+    end
+
+    def identity_for_locale_request
+      Current.identity || Session.find_signed(cookies.signed[:session_token])&.identity
+    rescue ArgumentError
+      nil
+    end
+
+    def persist_identity_locale(locale)
+      if identity = identity_for_locale_request
+        identity.update_column(:locale, locale) unless identity.locale == locale
+      end
+    end
+
+    def persist_locale_cookie(locale)
+      cookies.permanent[:locale] = { value: locale, httponly: false, same_site: :lax }
+      cookies.signed.permanent[:locale] = { value: locale, httponly: false, same_site: :lax }
+    end
+
+    def current_locale
+      I18n.locale.to_s
+    end
+end
