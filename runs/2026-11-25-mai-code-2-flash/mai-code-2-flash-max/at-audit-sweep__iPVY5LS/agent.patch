diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..e697424
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "apostrophes are treated as literal title text" do
+    sign_in :kevin
+    apostrophe_leaf = books(:handbook).press(Page.new(body: ""), title: "O'Brien")
+
+    get library_search_url, params: { q: "O'Brien" }
+
+    assert_response :success
+    assert_includes response.body, "O&#39;Brien"
+  end
+
+  test "library search only includes readable books" do
+    sign_in :kevin
+    private_leaf = books(:manual).press(Page.new(body: ""), title: "Private result")
+
+    get library_search_url, params: { q: "Private result" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /#{Regexp.escape(private_leaf.title)}/, count: 0
+  end
+
+  test "published books are searchable by signed-out users" do
+    books(:handbook).update!(published: true)
+    published_leaf = books(:handbook).press(Page.new(body: ""), title: "Published result")
+
+    get library_search_url, params: { q: "Published result" }
+
+    assert_response :success
+    assert_includes response.body, published_leaf.title
+  end
+
+  test "percent and underscore are literal wildcard characters" do
+    sign_in :kevin
+    percent_leaf = books(:handbook).press(Page.new(body: ""), title: "Save 50% off")
+    underscore_leaf = books(:handbook).press(Page.new(body: ""), title: "Save 50_off")
+
+    get library_search_url, params: { q: "%" }
+    assert_response :success
+    assert_includes response.body, percent_leaf.title
+    assert_not_includes response.body, underscore_leaf.title
+
+    get library_search_url, params: { q: "_" }
+    assert_response :success
+    assert_includes response.body, underscore_leaf.title
+    assert_not_includes response.body, percent_leaf.title
+  end
+
+  test "search syntax cannot escape the title predicate" do
+    sign_in :kevin
+    private_leaf = books(:manual).press(Page.new(body: ""), title: "Injection target")
+
+    get library_search_url, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_not_includes response.body, private_leaf.title
+  end
+end
