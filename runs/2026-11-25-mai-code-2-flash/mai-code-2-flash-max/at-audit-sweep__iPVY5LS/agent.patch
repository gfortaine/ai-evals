diff --git a/test/models/leaf/searchable_test.rb b/test/models/leaf/searchable_test.rb
index 4446433..3f4b7a0 100644
--- a/test/models/leaf/searchable_test.rb
+++ b/test/models/leaf/searchable_test.rb
@@ -81,4 +81,28 @@ class Leaf::SearchableTest < ActiveSupport::TestCase
     leaves = Leaf.search("findme")
     assert_equal "<mark>findme</mark> fake highlight", leaves.first.title_match
   end
+  test "percent and underscore are literal search characters" do
+    percent_leaf = books(:handbook).press(Page.new(body: ""), title: "Save 50% off")
+    underscore_leaf = books(:handbook).press(Page.new(body: ""), title: "Save 50_off")
+
+    assert_includes Leaf.search("%"), percent_leaf
+    assert_not_includes Leaf.search("%"), underscore_leaf
+    assert_includes Leaf.search("_"), underscore_leaf
+  end
+
+  test "apostrophes and punctuation do not produce FTS errors" do
+    apostrophe_leaf = books(:handbook).press(Page.new(body: ""), title: "O'Brien")
+
+    assert_includes Leaf.search("O'Brien"), apostrophe_leaf
+    assert_empty Leaf.search("^$")
+  end
+
+  test "punctuation in page body is searchable literally" do
+    apostrophe_leaf = books(:handbook).press(Page.new(body: "The O'Brien account"), title: "Apostrophe body")
+    ampersand_leaf = books(:handbook).press(Page.new(body: "Tom & Jerry"), title: "Ampersand body")
+
+    assert_includes Leaf.search("O'Brien"), apostrophe_leaf
+    assert_includes Leaf.search("&"), ampersand_leaf
+  end
+
 end
