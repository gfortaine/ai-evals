diff --git a/script/library_report.rb b/script/library_report.rb
index 76294dc..3c276d2 100644
--- a/script/library_report.rb
+++ b/script/library_report.rb
@@ -1,15 +1,43 @@
 books = Book.order(:id).to_a
 
-Rails.logger.info "Library report: #{books.size} books"
+report_lines = [ [ :info, "Library report: #{books.size} books" ] ]
 
 books.each do |book|
   pages = book.leaves.count
 
   if pages.zero?
-    Rails.logger.warn "Library report: #{book.title} has no pages"
+    report_lines << [ :warn, "Library report: #{book.title} has no pages" ]
   else
-    Rails.logger.info "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
+    report_lines << [ :info, "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}" ]
   end
 end
 
-Rails.logger.info "Library report: done"
+report_lines << [ :info, "Library report: done" ]
+
+terminal_logger = ActiveSupport::Logger.new($stdout)
+terminal_logger.formatter = ->(_severity, _datetime, _progname, message) { "#{message}\n" }
+
+original_logger = Rails.logger
+original_level = original_logger.level
+
+if original_logger.respond_to?(:broadcast_to)
+  original_logger.broadcast_to terminal_logger
+else
+  Rails.logger = ActiveSupport::BroadcastLogger.new(original_logger, terminal_logger)
+end
+
+begin
+  Rails.logger.level = ActiveSupport::Logger::DEBUG
+
+  report_lines.each do |severity, message|
+    Rails.logger.public_send(severity, message)
+  end
+ensure
+  if original_logger.respond_to?(:broadcast_to)
+    original_logger.stop_broadcasting_to terminal_logger
+    original_logger.level = original_level
+  else
+    Rails.logger = original_logger
+    original_logger.level = original_level
+  end
+end
