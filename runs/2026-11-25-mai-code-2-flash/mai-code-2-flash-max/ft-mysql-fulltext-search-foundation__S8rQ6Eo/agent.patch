diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..1303569
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches published cards by title" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "article.search-result", count: 1
+    assert_select "article.search-result" do
+      assert_select "mark", text: "logo"
+    end
+  end
+
+  test "searches published cards by description" do
+    cards(:layout).update!(description: "A special needle for the layout")
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select "article.search-result", count: 1
+    assert_select ".search-result__description mark", text: "needle"
+  end
+
+  test "searches published cards by comment body" do
+    cards(:layout).comments.create!(creator: users(:kevin), body: "A matching comet note")
+
+    get search_path(q: "comet")
+
+    assert_response :success
+    assert_select "article.search-result", count: 1
+    assert_select ".search-result__comment mark", text: "comet"
+  end
+
+  test "returns only cards from boards the user can access" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "article.search-result", count: 0
+  end
+
+  test "draft cards do not turn up" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Secret draft needle")
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_no_match draft.title, response.body
+  end
+
+  test "results are newest first" do
+    older, newer = Current.set(user: users(:kevin)) do
+      older = boards(:writebook).cards.create!(creator: users(:kevin), status: :published, title: "Search older")
+      newer = boards(:writebook).cards.create!(creator: users(:kevin), status: :published, title: "Search newer")
+      [ older, newer ]
+    end
+    older.update_columns(created_at: 2.days.ago)
+    newer.update_columns(created_at: 1.day.ago)
+
+    get search_path(q: "search")
+
+    assert_response :success
+    assert_select "article.search-result" do |results|
+      assert_equal [ dom_id(newer), dom_id(older) ], results.map { |result| result["id"] }
+    end
+  end
+
+  test "blank searches show an empty state" do
+    get search_path(q: "")
+
+    assert_response :success
+    assert_select ".blank-slate", text: "Enter a search term"
+  end
+end
