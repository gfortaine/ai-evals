+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @search_terms = @query.split
+    @cards = search_cards
+    @results = @cards
+  end
+
+  private
+    def search_cards
+      if @search_terms.empty?
+        []
+      else
+        cards = Current.user.accessible_cards
+          .where(account: Current.account)
+          .published
+          .search(@query)
+          .reverse_chronologically
+          .preloaded
+          .preload(comments: :rich_text_body)
+          .distinct
+          .to_a
+
+        cards.select do |card|
+          text = searchable_text(card)
+          text.present? && @search_terms.all? { |term| text.include?(term.downcase) }
+        end
+      end
+    end
+
+    def searchable_text(card)
+      @searchable_texts ||= {}
+      @searchable_texts.fetch(card.id) do
+        text = [ card.title, card.description.to_plain_text ]
+        text.concat card.comments.map { |comment| comment.body.to_plain_text }
+        @searchable_texts[card.id] = text.compact.join(" ").downcase
+      end
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..269ae73
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,42 @@
+module SearchHelper
+  def highlight_search_matches(text, search_terms)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    escaped_text = ERB::Util.html_escape(plain_text)
+
+    terms = search_terms.filter(&:present?).uniq.sort_by { |term| -term.length }
+    if terms.empty?
+      escaped_text.html_safe
+    else
+      pattern = Regexp.new(terms.map { |term| Regexp.escape(ERB::Util.html_escape(term)) }.join("|"), Regexp::IGNORECASE)
+      escaped_text.gsub(pattern) { |match| "<mark>#{match}</mark>" }.html_safe
+    end
+  end
+
+  def search_excerpt(text, search_terms, length: 240)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    plain_text = plain_text.squish
+    return plain_text if plain_text.length <= length
+
+    first_match = search_terms.filter_map do |term|
+      plain_text.downcase.index(term.downcase)
+    end.min
+
+    if first_match
+      start = [ first_match - (length / 3), 0 ].max
+    else
+      start = 0
+    end
+
+    excerpt = plain_text[start, length].strip
+    excerpt = "…#{excerpt}" if start.positive?
+    excerpt = "#{excerpt}…" if start + length < plain_text.length
+    excerpt
+  end
+
+  def search_matches?(text, search_terms)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    downcased_text = plain_text.downcase
+
+    search_terms.any? { |term| downcased_text.include?(term.downcase) }
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..015ac9e 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -25,6 +25,41 @@ class Card < ApplicationRecord
   scope :with_users,              -> { preload(creator: [ :avatar_attachment, :account ], assignees: [ :avatar_attachment, :account ]) }
   scope :preloaded,               -> { with_users.preload(:column, :tags, :steps, :closure, :goldness, :activity_spike, :image_attachment, reactions: :reacter, board: [ :entropy, :columns ], not_now: [ :user ]).with_rich_text_description_and_embeds }
 
+  scope :search, ->(query) do
+    terms = query.to_s.split
+
+    if terms.empty?
+      where(id: [])
+    else
+      terms.reduce(all) do |relation, term|
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+        escaped_pattern = "%#{ActiveRecord::Base.sanitize_sql_like(ERB::Util.html_escape(term).to_s)}%"
+
+        relation.where(<<~SQL.squish, pattern: pattern, escaped_pattern: escaped_pattern)
+          cards.title LIKE :pattern
+          OR EXISTS (
+            SELECT 1
+            FROM action_text_rich_texts AS card_rich_text
+            WHERE card_rich_text.record_type = 'Card'
+              AND card_rich_text.record_id = cards.id
+              AND card_rich_text.name = 'description'
+              AND (card_rich_text.body LIKE :pattern OR card_rich_text.body LIKE :escaped_pattern)
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments AS matching_comments
+            INNER JOIN action_text_rich_texts AS comment_rich_text
+              ON comment_rich_text.record_type = 'Comment'
+              AND comment_rich_text.record_id = matching_comments.id
+              AND comment_rich_text.name = 'body'
+            WHERE matching_comments.card_id = cards.id
+              AND (comment_rich_text.body LIKE :pattern OR comment_rich_text.body LIKE :escaped_pattern)
+          )
+        SQL
+      end.distinct
+    end
+  end
+
   scope :indexed_by, ->(index) do
     case index
     when "stalled" then stalled
