diff --git a/app/views/search/_result.html.erb b/app/views/search/_result.html.erb
new file mode 100644
index 0000000..6a8d5df
--- /dev/null
+++ b/app/views/search/_result.html.erb
@@ -0,0 +1,28 @@
+<li>
+  <article class="search-result panel flex flex-column gap" id="<%= dom_id(card) %>">
+    <header class="flex flex-column gap-half">
+      <%= link_to card_path(card), class: "card__title txt-large font-weight-black" do %>
+        <%= highlight_search_matches(card.title.presence || "Untitled", @search_terms) %>
+      <% end %>
+
+      <div class="txt-small">
+        in <%= link_to card.board.name, card.board %>
+      </div>
+    </header>
+
+    <% if search_matches?(card.description, @search_terms) %>
+      <div class="search-result__description">
+        <%= highlight_search_matches(search_excerpt(card.description, @search_terms), @search_terms) %>
+      </div>
+    <% end %>
+
+    <% card.comments.with_rich_text_body.each do |comment| %>
+      <% if search_matches?(comment.body, @search_terms) %>
+        <div class="search-result__comment txt-small">
+          <strong>Comment</strong>
+          <div><%= highlight_search_matches(search_excerpt(comment.body, @search_terms), @search_terms) %></div>
+        </div>
+      <% end %>
+    <% end %>
+  </article>
+</li>
