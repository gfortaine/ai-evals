+class Account::StorageUsageJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  discard_on ActiveJob::DeserializationError
+
+  queue_as :backend
+
+  def perform(account)
+    step :boards do |step|
+      account.boards.find_each(start: step.cursor) do |board|
+        board.calculate_bytes_used_now
+        step.advance! from: board.id
+      end
+    end
+
+    account.calculate_bytes_used_now
+  end
+end
