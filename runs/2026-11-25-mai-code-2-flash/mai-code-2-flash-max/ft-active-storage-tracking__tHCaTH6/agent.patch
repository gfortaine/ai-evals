diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..54bdb47 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,84 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorageAttachmentStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :calculate_storage_usage_later
+    after_destroy_commit :calculate_storage_usage_later
+  end
+
+  private
+    def calculate_storage_usage_later
+      storage_usage_board&.calculate_bytes_used_later
+    end
+
+    def storage_usage_board
+      case record
+      when Card
+        record.board
+      when ActionText::RichText
+        storage_usage_board_for_rich_text(record.record)
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def storage_usage_board_for_rich_text(rich_text_record)
+      case rich_text_record
+      when Board
+        rich_text_record
+      when Card
+        rich_text_record.board
+      when Comment
+        rich_text_record.card.board
+      end
+    end
+end
+
+module ActiveStorageBlobStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_update_commit :calculate_storage_usage_later, if: :byte_size_changed?
+  end
+
+  private
+    def byte_size_changed?
+      saved_change_to_byte_size?
+    end
+
+    def calculate_storage_usage_later
+      attachments.includes(:record).filter_map do |attachment|
+        storage_usage_board_for_attachment(attachment)
+      end.uniq.each(&:calculate_bytes_used_later)
+    end
+
+    def storage_usage_board_for_attachment(attachment)
+      case attachment.record
+      when Card
+        attachment.record.board
+      when ActionText::RichText
+        case attachment.record.record
+        when Board
+          attachment.record.record
+        when Card
+          attachment.record.record.board
+        when Comment
+          attachment.record.record.card.board
+        end
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorageAttachmentStorageUsage
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  include ActiveStorageBlobStorageUsage
+end
