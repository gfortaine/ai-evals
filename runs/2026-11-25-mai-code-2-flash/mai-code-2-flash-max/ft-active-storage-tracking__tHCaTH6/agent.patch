diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..fa104d1
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "counts card images and rich text embeds for the board and account" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    image = create_blob("image file", "image.txt")
+    embed = create_blob("embedded file", "embed.txt")
+
+    card.image.attach(image)
+    board.update!(public_description: attachment_html(embed))
+    card.update!(description: attachment_html(embed))
+    card.comments.create!(creator: users(:david), body: attachment_html(embed))
+
+    perform_enqueued_jobs
+
+    assert_equal image.byte_size + embed.byte_size, board.reload.bytes_used
+    assert_equal image.byte_size + embed.byte_size, account.reload.bytes_used
+  end
+
+  test "counts a shared blob once within a board and account" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    blob = create_blob("shared file", "shared.txt")
+
+    card.image.attach(blob)
+    board.update!(public_description: attachment_html(blob))
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+    assert_equal blob.byte_size, account.reload.bytes_used
+  end
+
+  test "does not count unrelated attachments" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    export = Account::Export.create!(account: account, user: users(:david))
+    export.file.attach(create_blob("export file", "export.zip"))
+    card.creator.avatar.attach(create_blob("avatar", "avatar.png"))
+
+    perform_enqueued_jobs
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "removes usage when an image is purged" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    card.image.attach(create_blob("image file", "image.txt"))
+    perform_enqueued_jobs
+
+    assert_operator board.reload.bytes_used, :>, 0
+
+    card.image.purge_later
+    perform_enqueued_jobs
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "updates the old and new boards when a card moves" do
+    account = accounts("37s")
+    old_board = boards(:writebook)
+    new_board = boards(:private)
+    card = cards(:logo)
+
+    card.image.attach(create_blob("image file", "image.txt"))
+    perform_enqueued_jobs
+
+    usage = old_board.reload.bytes_used
+    assert_operator usage, :>, 0
+
+    card.move_to(new_board)
+    perform_enqueued_jobs
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal usage, new_board.reload.bytes_used
+    assert_equal usage, account.reload.bytes_used
+  end
+
+  private
+    def create_blob(contents, filename)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: filename,
+        content_type: "text/plain"
+      )
+    end
+
+    def attachment_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
