diff --git a/app/jobs/storage_usage_job.rb b/app/jobs/storage_usage_job.rb
new file mode 100644
index 0000000..b6344f7
--- /dev/null
+++ b/app/jobs/storage_usage_job.rb
@@ -0,0 +1,35 @@
+class StorageUsageJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform(container = nil)
+    case container
+    when Account
+      recalculate_account(container)
+    when Board
+      recalculate_board(container)
+    else
+      step :accounts do |step|
+        Account.find_each(start: step.cursor) do |account|
+          recalculate_account(account)
+          step.advance! from: account.id
+        end
+      end
+    end
+  end
+
+  private
+    def recalculate_account(account)
+      account.boards.find_each do |board|
+        board.calculate_bytes_used_now
+      end
+
+      account.calculate_bytes_used_now
+    end
+
+    def recalculate_board(board)
+      board.calculate_bytes_used_now
+      board.account.calculate_bytes_used_now
+    end
+end
