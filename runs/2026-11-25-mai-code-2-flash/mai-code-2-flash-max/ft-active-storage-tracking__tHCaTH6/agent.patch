diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
new file mode 100644
index 0000000..b72ab35
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,150 @@
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_touch :calculate_storage_usage_later
+    after_destroy_commit :calculate_storage_usage_after_destroy_later
+  end
+
+  def bytes_used
+    if has_attribute?(:bytes_used)
+      read_attribute(:bytes_used).to_i
+    else
+      0
+    end
+  end
+
+  def calculate_bytes_used
+    case self
+    when Account
+      calculate_account_bytes_used
+    when Board
+      calculate_board_bytes_used
+    when Card
+      board.calculate_bytes_used
+    when Comment
+      card.board.calculate_bytes_used
+    else
+      0
+    end
+  end
+
+  def calculate_bytes_used_now
+    value = calculate_bytes_used
+
+    if is_a?(Account) || is_a?(Board)
+      update_column(:bytes_used, value)
+    end
+
+    value
+  end
+
+  def calculate_bytes_used_later
+    case self
+    when Account
+      Account::StorageUsageJob.perform_later(self)
+    when Board
+      Board::StorageUsageJob.perform_later(self)
+    when Card
+      Board::StorageUsageJob.perform_later(board)
+    when Comment
+      Board::StorageUsageJob.perform_later(card.board)
+    end
+  end
+
+  alias_method :calculate_bytes_used!, :calculate_bytes_used_now
+  alias_method :recalculate_bytes_used, :calculate_bytes_used_now
+  alias_method :recalculate_bytes_used!, :calculate_bytes_used_now
+
+  private
+    def calculate_storage_usage_later
+      calculate_bytes_used_later
+    end
+
+    def calculate_storage_usage_after_destroy_later
+      case self
+      when Account
+        nil
+      when Board
+        Account::StorageUsageJob.perform_later(account)
+      when Card
+        Board::StorageUsageJob.perform_later(board)
+        Account::StorageUsageJob.perform_later(account)
+      when Comment
+        Board::StorageUsageJob.perform_later(card.board)
+        Account::StorageUsageJob.perform_later(card.account)
+      end
+    end
+
+    def storage_usage_account_id
+      if is_a?(Account)
+        id
+      else
+        account_id
+      end
+    end
+
+    def calculate_account_bytes_used
+      direct_blob_ids = ActiveStorage::Attachment
+        .where(account_id: storage_usage_account_id, record_type: "Card", name: "image", record_id: cards.select(:id))
+        .select(:blob_id)
+
+      rich_text_ids = rich_text_ids_for_account
+
+      embed_blob_ids = ActiveStorage::Attachment
+        .where(account_id: storage_usage_account_id, record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids.select(:id))
+        .select(:blob_id)
+
+      sum_unique_blob_bytes(direct_blob_ids, embed_blob_ids)
+    end
+
+    def calculate_board_bytes_used
+      card_ids = cards.select(:id)
+      comment_ids = Comment.where(account_id: storage_usage_account_id, card_id: card_ids).select(:id)
+
+      direct_blob_ids = ActiveStorage::Attachment
+        .where(account_id: storage_usage_account_id, record_type: "Card", name: "image", record_id: card_ids)
+        .select(:blob_id)
+
+      rich_text_ids = ActionText::RichText
+        .where(account_id: storage_usage_account_id, record_type: "Board", record_id: id, name: "public_description")
+        .select(:id)
+        .or(ActionText::RichText
+          .where(account_id: storage_usage_account_id, record_type: "Card", record_id: card_ids, name: "description")
+          .select(:id))
+        .or(ActionText::RichText
+          .where(account_id: storage_usage_account_id, record_type: "Comment", record_id: comment_ids, name: "body")
+          .select(:id))
+
+      embed_blob_ids = ActiveStorage::Attachment
+        .where(account_id: storage_usage_account_id, record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids.select(:id))
+        .select(:blob_id)
+
+      sum_unique_blob_bytes(direct_blob_ids, embed_blob_ids)
+    end
+
+    def rich_text_ids_for_account
+      board_rich_text_ids = ActionText::RichText
+        .where(account_id: storage_usage_account_id, record_type: "Board", record_id: boards.select(:id), name: "public_description")
+        .select(:id)
+
+      card_rich_text_ids = ActionText::RichText
+        .where(account_id: storage_usage_account_id, record_type: "Card", record_id: cards.select(:id), name: "description")
+        .select(:id)
+
+      comment_rich_text_ids = ActionText::RichText
+        .where(account_id: storage_usage_account_id, record_type: "Comment", record_id: Comment.where(account_id: storage_usage_account_id, card_id: cards.select(:id)).select(:id), name: "body")
+        .select(:id)
+
+      board_rich_text_ids
+        .or(card_rich_text_ids)
+        .or(comment_rich_text_ids)
+    end
+
+    def sum_unique_blob_bytes(direct_blob_ids, embed_blob_ids)
+      direct_blobs = ActiveStorage::Blob.where(id: direct_blob_ids)
+      embedded_blobs = ActiveStorage::Blob.where(id: embed_blob_ids)
+
+      direct_blobs.or(embedded_blobs).sum(:byte_size)
+    end
+end
