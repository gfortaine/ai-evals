diff --git a/test/models/bot/mention_webhook_test.rb b/test/models/bot/mention_webhook_test.rb
new file mode 100644
index 0000000..97287bc
--- /dev/null
+++ b/test/models/bot/mention_webhook_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class Bot::MentionWebhookTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @bot = Bot.create!(
+      name: "Deploy Bot",
+      webhook_url: "https://example.com/mention",
+      creator: users(:david)
+    )
+    @room = rooms(:hq)
+  end
+
+  test "mention job posts the payload and a 200 text plain response" do
+    payload = nil
+    WebMock.stub_request(:post, "https://example.com/mention")
+      .with do |request|
+        payload = JSON.parse(request.body)
+        true
+      end
+      .to_return(status: 200, body: "Build restarted", headers: { "Content-Type" => "text/plain" })
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      @message = @room.messages.create!(
+        body: "<div>#{mention_attachment_for_bot(@bot)} restart the build please</div>",
+        creator: users(:jason),
+        client_message_id: Random.uuid
+      )
+    end
+
+    assert_equal "mention", payload["event"]
+    assert_equal users(:jason).id, payload.dig("author", "id")
+    assert_equal "Jason", payload.dig("author", "name")
+    assert_equal @room.id, payload.dig("room", "id")
+    assert_equal @room.name, payload.dig("room", "name")
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_code}/messages", payload.dig("room", "reply_to")
+    assert_equal @message.id, payload.dig("message", "id")
+    assert_equal "restart the build please", payload.dig("message", "body", "text")
+    assert_includes payload.dig("message", "body", "html"), "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{@message.id}", payload.dig("message", "link")
+
+    reply = @room.messages.where(creator: @bot).last
+    assert_equal "Build restarted", reply.plain_text_body
+  end
+
+  test "literal bot mention in plain text triggers the webhook" do
+    payload = nil
+    WebMock.stub_request(:post, "https://example.com/mention")
+      .with do |request|
+        payload = JSON.parse(request.body)
+        true
+      end
+      .to_return(status: 204)
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      @room.messages.create!(
+        body: "<div>@Deploy Bot restart the build please</div>",
+        creator: users(:jason),
+        client_message_id: Random.uuid
+      )
+    end
+
+    assert_equal "restart the build please", payload.dig("message", "body", "text")
+  end
+
+  test "204 response posts no reply" do
+    WebMock.stub_request(:post, "https://example.com/mention")
+      .to_return(status: 204)
+
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      perform_enqueued_jobs only: Room::PushMessageJob do
+        @room.messages.create!(
+          body: "<div>#{mention_attachment_for_bot(@bot)} status</div>",
+          creator: users(:jason),
+          client_message_id: Random.uuid
+        )
+      end
+    end
+
+    assert_requested :post, "https://example.com/mention", times: 1
+  end
+
+  test "200 text html response posts rich bot reply" do
+    WebMock.stub_request(:post, "https://example.com/mention")
+      .to_return(status: 200, body: "<strong>Deployment complete</strong>", headers: { "Content-Type" => "text/html" })
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      @room.messages.create!(
+        body: "<div>#{mention_attachment_for_bot(@bot)} deploy</div>",
+        creator: users(:jason),
+        client_message_id: Random.uuid
+      )
+    end
+
+    reply = @room.messages.where(creator: @bot).last
+    assert_equal "Deployment complete", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>Deployment complete</strong>"
+  end
+
+  test "bot messages do not trigger bot webhooks" do
+    WebMock.stub_request(:post, "https://example.com/mention").to_return(status: 204)
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      @room.messages.create!(
+        body: "<div>#{mention_attachment_for_bot(@bot)} deploy</div>",
+        creator: @bot,
+        client_message_id: Random.uuid
+      )
+    end
+
+    assert_not_requested :post, "https://example.com/mention"
+  end
+
+  private
+    def mention_attachment_for_bot(bot)
+      attachment_body = ApplicationController.render partial: "users/mention", locals: { user: bot }
+      "<action-text-attachment sgid=\"#{bot.attachable_sgid}\" content-type=\"application/vnd.campfire.mention\" content=\"#{attachment_body.gsub('"', '&quot;')}\"></action-text-attachment>"
+    end
+end
