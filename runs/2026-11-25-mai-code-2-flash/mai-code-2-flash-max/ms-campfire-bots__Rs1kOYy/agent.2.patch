diff --git a/app/models/bot/mention_webhook.rb b/app/models/bot/mention_webhook.rb
new file mode 100644
index 0000000..83757f2
--- /dev/null
+++ b/app/models/bot/mention_webhook.rb
@@ -0,0 +1,107 @@
+require "net/http"
+require "uri"
+
+class Bot::MentionWebhook
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 5
+
+  attr_reader :room, :message
+
+  def initialize(room:, message:)
+    @room = room
+    @message = message
+  end
+
+  def deliver
+    return if message.creator.is_a?(Bot)
+
+    message.mentioned_bots.each do |bot|
+      next unless bot.active?
+
+      room.memberships.grant_to(bot) unless room.users.exists?(bot.id)
+      dispatch(bot) if bot.webhook_url.present?
+    end
+  end
+
+  private
+    def dispatch(bot)
+      uri = URI.parse(bot.webhook_url)
+      return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+      response = Net::HTTP.start(
+        uri.host,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT
+      ) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri)
+        request["Content-Type"] = "application/json"
+        request.body = payload_for(bot).to_json
+        http.request(request)
+      end
+
+      post_response(bot, response)
+    rescue StandardError => error
+      Rails.logger.warn "Bot webhook failed for #{bot.id}: #{error.class}: #{error.message}"
+    end
+
+    def payload_for(bot)
+      {
+        event: "mention",
+        author: {
+          id: message.creator.id,
+          name: message.creator.name
+        },
+        room: {
+          id: room.id,
+          name: room_name(bot),
+          reply_to: Rails.application.routes.url_helpers.room_bot_messages_path(room.id, bot.bot_code)
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: message_text_without_mention(bot),
+            html: message.body&.body&.to_html.to_s
+          },
+          link: Rails.application.routes.url_helpers.room_at_message_path(room.id, message.id)
+        }
+      }
+    end
+
+    def room_name(bot)
+      return room.name if room.name.present?
+
+      room.users.without(bot).pluck(:name).to_sentence.presence || bot.name
+    end
+
+    def message_text_without_mention(bot)
+      text = message.body&.to_plain_text.to_s
+      text = text.gsub(/@#{Regexp.escape(bot.name)}(?:\z|(?=[^[:alnum:]_]))/i, "")
+      text = text.gsub(/\s+/, " ").strip
+      text.sub(/\A(?:[:;,.-]+)\s*/, "")
+    end
+
+    def post_response(bot, response)
+      return unless response.is_a?(Net::HTTPOK)
+
+      content_type = response["Content-Type"].to_s.split(";", 2).first.strip.downcase
+      return unless %w[text/plain text/html].include?(content_type)
+
+      response_body = response.body.to_s.force_encoding(Encoding::UTF_8)
+      return if response_body.blank?
+
+      body = if content_type == "text/plain"
+        "<div>#{ERB::Util.html_escape(response_body)}</div>"
+      else
+        response_body
+      end
+
+      posted_message = room.messages.create_with_attachment!(
+        body: body,
+        creator: bot,
+        client_message_id: Random.uuid
+      )
+      posted_message.broadcast_create
+    end
+end
