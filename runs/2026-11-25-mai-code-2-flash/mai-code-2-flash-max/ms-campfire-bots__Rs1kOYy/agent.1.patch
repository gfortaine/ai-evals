diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..4db564f
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    @room = rooms(:watercooler)
+  end
+
+  test "posts raw request body and returns created with location" do
+    @room.memberships.grant_to(@bot)
+
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Deploy of v1.2.3 finished ✅", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :created
+    assert_match %r{\A/messages/\d+\z}, response.headers["Location"]
+
+    message = Message.last
+    assert_equal @bot, message.creator
+    assert_equal @room, message.room
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "bad room id returns not found" do
+    post room_bot_messages_url(Room.maximum(:id).to_i + 1000, @bot.bot_code), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :not_found
+  end
+
+  test "invalid bot code returns unauthorized" do
+    post room_bot_messages_url(@room, "not-a-valid-code"), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :unauthorized
+  end
+
+  test "empty body without attachment returns unprocessable content" do
+    @room.memberships.grant_to(@bot)
+
+    post room_bot_messages_url(@room, @bot.bot_code), params: "", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :unprocessable_content
+  end
+
+  test "non-member bot cannot post to the room" do
+    assert_not @room.users.exists?(@bot.id)
+
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :not_found
+  end
+
+  test "deleted bot code is unauthorized" do
+    @room.memberships.grant_to(@bot)
+    code = @bot.bot_code
+    @bot.destroy!
+
+    post room_bot_messages_url(@room, code), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :unauthorized
+  end
+
+  test "attachment without text creates a message" do
+    @room.memberships.grant_to(@bot)
+
+    post room_bot_messages_url(@room, @bot.bot_code),
+      params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+
+    assert_response :created
+    message = Message.last
+    assert_equal @bot, message.creator
+    assert message.attachment.attached?
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..1e99e42
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "index lists all bots for administrators" do
+    own_bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    other_bot = Bot.create!(name: "Monitor Bot", creator: users(:kevin))
+
+    get bots_url
+
+    assert_response :success
+    assert_select ".message__author", count: 0
+    assert_select "li", text: /Deploy Bot/
+    assert_select "li", text: /Monitor Bot/
+    assert_select "input[readonly][aria-label='Bot code']", text: "", count: 2
+    assert_select "input[value='#{own_bot.bot_code}']"
+    assert_select "input[value='#{other_bot.bot_code}']"
+  end
+
+  test "members only list bots they created" do
+    sign_in :kevin
+    own_bot = Bot.create!(name: "Deploy Bot", creator: users(:kevin))
+    Bot.create!(name: "Monitor Bot", creator: users(:david))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li", text: /Deploy Bot/
+    assert_select "li", text: /Monitor Bot/, count: 0
+    assert_select "input[value='#{own_bot.bot_code}']"
+  end
+
+  test "new and create" do
+    get new_bot_url
+    assert_response :success
+    assert_select "input[placeholder='Name the bot'][required]"
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    assert_redirected_to bots_url
+    bot = Bot.last
+    assert_equal "Deploy Bot", bot.name
+    assert_equal users(:david), bot.creator
+    assert bot.bot_code.present?
+  end
+
+  test "create requires a name" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "edit and update" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "input[value='Deploy Bot']"
+    assert_select "button", text: /Delete this chat bot/
+
+    put bot_url(bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+  end
+
+  test "member cannot manage another member's bot" do
+    sign_in :kevin
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    get edit_bot_url(bot)
+    assert_response :forbidden
+
+    put bot_url(bot), params: { bot: { name: "Changed" } }
+    assert_response :forbidden
+  end
+
+  test "delete destroys bot and invalidates its code" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+
+    assert_redirected_to bots_url
+    assert_nil Bot.find_by(bot_code: bot.bot_code)
+  end
+
+  test "new bot joins every open room" do
+    open_room_ids = Rooms::Open.pluck(:id)
+
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert_equal open_room_ids.sort, bot.room_ids.sort
+  end
+end
