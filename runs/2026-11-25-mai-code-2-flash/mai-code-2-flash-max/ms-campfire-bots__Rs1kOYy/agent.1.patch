new file mode 100644
index 0000000..99cbb7e
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,39 @@
+class Bots::MessagesController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    room = Room.find_by(id: params[:room_id])
+    return head :not_found unless room
+
+    bot = Bot.active.find_by(bot_code: params[:bot_code])
+    return head :unauthorized unless bot
+
+    return head :not_found unless room.users.exists?(bot.id)
+
+    body = message_body
+    attachment = params[:attachment]
+    return head :unprocessable_content if body.blank? && !attachment.present?
+
+    message = room.messages.create_with_attachment!(
+      body: body,
+      attachment: attachment,
+      creator: bot,
+      client_message_id: Random.uuid
+    )
+
+    message.broadcast_create
+    head :created, location: message_path(message.id)
+  end
+
+  private
+    def message_body
+      if request.media_type&.start_with?("multipart/")
+        params[:body].to_s
+      else
+        request.raw_post.to_s.force_encoding(Encoding::UTF_8)
+      end
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..de84e5c
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,65 @@
+class BotsController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  before_action :set_bot, only: %i[ show edit update destroy ]
+  before_action :ensure_can_manage_bot, only: %i[ show edit update destroy ]
+
+  def index
+    @bots = visible_bots.ordered
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Bot.new(bot_params.merge(creator: Current.user))
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def show
+    redirect_to edit_bot_url(@bot)
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url
+  end
+
+  private
+    def visible_bots
+      if Current.user.administrator?
+        Bot.active
+      else
+        Bot.active.where(creator: Current.user)
+      end
+    end
+
+    def set_bot
+      @bot = Bot.find(params[:id])
+    end
+
+    def ensure_can_manage_bot
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..3cb5ffc
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,32 @@
+class Bot < User
+  has_secure_token :bot_code
+
+  belongs_to :creator, class_name: "User", optional: true, inverse_of: :bots
+
+  before_validation :ensure_password_digest
+
+  validates :name, presence: true
+
+  def code
+    bot_code
+  end
+
+  def owner
+    creator
+  end
+
+  class << self
+    def find_by_code(code)
+      find_by(bot_code: code)
+    end
+
+    def find_by_code!(code)
+      find_by!(bot_code: code)
+    end
+  end
+
+  private
+    def ensure_password_digest
+      self.password_digest = "" if password_digest.blank?
+    end
+end
