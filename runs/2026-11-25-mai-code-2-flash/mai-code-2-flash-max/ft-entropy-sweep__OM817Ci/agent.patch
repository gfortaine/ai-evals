diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..00ba50b 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,16 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due scope falls back to account entropy for an invalid board period" do
+    entropies(:writebook_board).update_column(:auto_postpone_period, 999.days.to_i)
+    card = cards(:logo)
+    card.update!(last_active_at: 1.day.ago - entropies("37s_account").auto_postpone_period)
+
+    assert_includes Card.due_to_be_postponed, card
+  end
+
+  test "cards have an entropy sweep index" do
+    assert Card.connection.index_exists?(:cards, [ :status, :last_active_at ], name: "index_cards_on_status_and_last_active_at")
+  end
 end
