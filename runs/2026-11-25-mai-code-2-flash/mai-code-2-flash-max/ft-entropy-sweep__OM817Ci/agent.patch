diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..5e387a2 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -1,32 +1,55 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  def self.effective_auto_postpone_period_sql
+    allowed_periods = Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.join(", ")
+    default_period = Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i
+
+    <<~SQL.squish
+      CASE
+        WHEN entropies.auto_postpone_period IN (#{allowed_periods}) THEN entropies.auto_postpone_period
+        WHEN account_entropies.auto_postpone_period IN (#{allowed_periods}) THEN account_entropies.auto_postpone_period
+        ELSE #{default_period}
+      END
+    SQL
+  end
+
   included do
     scope :due_to_be_postponed, -> do
+      now = Time.current
+      effective_period = Card::Entropic.effective_auto_postpone_period_sql
+
       active
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
         .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+        .where(last_active_at: ..(now - Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.min))
+        .where("last_active_at <= #{connection.date_subtract('?', effective_period)}", now)
     end
 
     scope :postponing_soon, -> do
-      now = Time.now
+      now = Time.current
+      effective_period = Card::Entropic.effective_auto_postpone_period_sql
+
       active
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
         .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at > #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) * 0.75')}", now)
+        .where(last_active_at: (now - Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.max)..)
+        .where("last_active_at > #{connection.date_subtract('?', effective_period)}", now)
+        .where("last_active_at <= #{connection.date_subtract('?', "#{effective_period} * 0.75")}", now)
     end
 
     delegate :auto_postpone_period, to: :board
   end
 
   class_methods do
-    def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+    def auto_postpone_all_due(batch_size: 1000)
+      system_users = {}
+
+      due_to_be_postponed.preload(board: :account).find_each(batch_size: batch_size) do |card|
+        system_user = system_users[card.account_id] ||= card.account.system_user
+        card.auto_postpone(user: system_user)
       end
     end
   end
