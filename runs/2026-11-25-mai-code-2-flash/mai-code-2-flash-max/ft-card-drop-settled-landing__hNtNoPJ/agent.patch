diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..3d095d6
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,412 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  connect() {
+    this.draggedItem = null
+    this.hoverContainer = null
+  }
+
+  disconnect() {
+    this.#clearDragState()
+  }
+
+  dragStart(event) {
+    const card = event.target?.closest(".card")
+    if (!card || !this.#sourceKey(card)) return
+
+    this.draggedItem = card
+    card.classList.add(this.#draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragEnd() {
+    this.#clearDragState()
+  }
+
+  dragEnter(event) {
+    if (!this.draggedItem) return
+    this.#highlightColumn(event)
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const column = this.#highlightColumn(event)
+    if (column) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    const column = event.target?.closest(".cards")
+    if (!column || (event.relatedTarget && column.contains(event.relatedTarget))) return
+
+    if (this.hoverContainer === column) {
+      this.#removeHover(column)
+      this.hoverContainer = null
+    }
+  }
+
+  drop(event) {
+    const column = event.target?.closest(".cards")
+    if (!column) return
+
+    event.preventDefault()
+
+    const card = this.#getDraggedCard(event)
+    if (!card) return
+
+    const sourceKey = this.#sourceKey(card)
+    const destinationKey = this.#destinationKey(column)
+
+    if (!sourceKey || !destinationKey || sourceKey === destinationKey) {
+      this.#clearDragState()
+      return
+    }
+
+    const move = this.#captureMove(card, column)
+    this.#moveCard(card, column, destinationKey)
+    this.#clearDragState()
+
+    this.#saveMove(card, sourceKey, destinationKey, move.sourceColumnId).then(saved => {
+      if (!saved) this.#restoreMove(card, move)
+    })
+  }
+
+  #highlightColumn(event) {
+    const column = event.target?.closest(".cards")
+    if (!column) return null
+
+    if (this.hoverContainer && this.hoverContainer !== column) {
+      this.#removeHover(this.hoverContainer)
+    }
+
+    column.classList.add(this.#hoverContainerClass)
+    this.hoverContainer = column
+    return column
+  }
+
+  #getDraggedCard(event) {
+    if (this.draggedItem?.isConnected) return this.draggedItem
+
+    const cardId = event.dataTransfer?.getData("text/plain")
+    if (cardId) {
+      const card = document.getElementById(cardId)
+      if (card?.classList.contains("card")) return card
+    }
+
+    return null
+  }
+
+  #sourceKey(card) {
+    const status = card.dataset.dragAndDropStatus
+    if (status) return `status:${status}`
+
+    const columnId = card.dataset.dragAndDropColumnId
+    if (columnId) return `column:${columnId}`
+
+    return null
+  }
+
+  #destinationKey(column) {
+    const status = column.dataset.dragAndDropStatus
+    if (status) return `status:${status}`
+
+    const columnId = column.dataset.dragAndDropColumnId
+    if (columnId) return `column:${columnId}`
+
+    return null
+  }
+
+  #captureMove(card, destinationColumn) {
+    const sourceColumn = card.closest(".cards")
+    const sourceList = card.closest(".cards__list")
+    const destinationList = destinationColumn.querySelector(".cards__list")
+    const nameElement = card.querySelector(".card__header > .card__column-name")
+
+    const dataset = {}
+    for (const key of [ "dragAndDropStatus", "dragAndDropColumnId" ]) {
+      dataset[key] = card.dataset[key] ?? null
+    }
+
+    return {
+      sourceColumn,
+      destinationColumn,
+      sourceList,
+      destinationList,
+      sourceParent: card.parentElement,
+      sourceNextSibling: card.nextElementSibling,
+      sourceColumnId: card.dataset.dragAndDropColumnId || null,
+      sourceCount: this.#countText(sourceColumn),
+      destinationCount: this.#countText(destinationColumn),
+      dataset,
+      nameClone: nameElement?.cloneNode(true) || null,
+      nameParent: nameElement?.parentElement || null,
+      nameNextSibling: nameElement?.nextElementSibling || null,
+      destinationBlankSlates: destinationList
+        ? Array.from(destinationList.querySelectorAll(".blank-slate"))
+        : []
+    }
+  }
+
+  #moveCard(card, column, destinationKey) {
+    const sourceColumn = card.closest(".cards")
+    let destinationList = column.querySelector(".cards__list")
+
+    if (!destinationList) {
+      destinationList = document.createElement("div")
+      destinationList.className = "cards__list hide-scrollbar"
+
+      const frame = column.querySelector("turbo-frame")
+      if (frame) {
+        frame.append(destinationList)
+      } else {
+        column.append(destinationList)
+      }
+    }
+
+    destinationList.querySelectorAll(".blank-slate").forEach(blankSlate => blankSlate.remove())
+    destinationList.prepend(card)
+
+    if (sourceColumn && sourceColumn !== column) {
+      this.#updateColumnCount(sourceColumn, -1)
+      this.#updateColumnCount(column, 1)
+    }
+
+    const sourceList = sourceColumn?.querySelector(".cards__list")
+    if (sourceList && !sourceList.querySelector(".card")) {
+      this.#ensureDragBlankSlate(sourceList)
+    }
+
+    this.#setCardDestination(card, column, destinationKey)
+
+    if (column.isConnected) column.focus({ preventScroll: true })
+  }
+
+  async #saveMove(card, sourceKey, destinationKey, sourceColumnId) {
+    const triageUrl = card.dataset.cardTriageUrl
+    const notNowUrl = card.dataset.cardNotNowUrl
+    const closureUrl = card.dataset.cardClosureUrl
+
+    try {
+      if (destinationKey.startsWith("column:")) {
+        if (!triageUrl) return false
+
+        let reopened = null
+        if (sourceKey === "status:closed" && closureUrl) {
+          reopened = await destroy(closureUrl, { responseKind: "json" })
+          if (!reopened.ok) return false
+        }
+
+        const response = await post(triageUrl, {
+          query: { column_id: destinationKey.slice("column:".length) },
+          responseKind: "json"
+        })
+
+        if (!response.ok && reopened) {
+          await post(closureUrl, { responseKind: "json" })
+        }
+
+        return response.ok
+      }
+
+      const status = destinationKey.slice("status:".length)
+
+      if (status === "maybe") {
+        if (!triageUrl) return false
+
+        if (sourceKey === "status:closed" && closureUrl) {
+          const reopened = await destroy(closureUrl, { responseKind: "json" })
+          if (!reopened.ok) return false
+
+          if (sourceColumnId) {
+            const returnedToTriage = await destroy(triageUrl, { responseKind: "json" })
+            if (!returnedToTriage.ok) {
+              await post(closureUrl, { responseKind: "json" })
+            }
+            return returnedToTriage.ok
+          }
+
+          return true
+        }
+
+        if (sourceKey === "status:maybe") return true
+
+        const response = await destroy(triageUrl, { responseKind: "json" })
+        return response.ok
+      }
+
+      if (status === "not_now") {
+        if (!notNowUrl) return false
+        const response = await post(notNowUrl, { responseKind: "json" })
+        return response.ok
+      }
+
+      if (status === "closed") {
+        if (!closureUrl) return false
+        const response = await post(closureUrl, { responseKind: "json" })
+        return response.ok
+      }
+
+      return false
+    } catch (_error) {
+      return false
+    }
+  }
+
+  #setCardDestination(card, column, destinationKey) {
+    if (destinationKey.startsWith("column:")) {
+      const columnId = destinationKey.slice("column:".length)
+      delete card.dataset.dragAndDropStatus
+      card.dataset.dragAndDropColumnId = columnId
+      this.#updateCardColumnName(card, column.dataset.columnName)
+    } else {
+      const status = destinationKey.slice("status:".length)
+      card.dataset.dragAndDropStatus = status
+
+      if (status !== "closed") {
+        delete card.dataset.dragAndDropColumnId
+      }
+
+      this.#removeCardColumnName(card)
+    }
+  }
+
+  #updateCardColumnName(card, name) {
+    if (!name) return
+
+    let nameElement = card.querySelector(".card__header > .card__column-name")
+    if (nameElement) {
+      const label = nameElement.querySelector(".overflow-ellipsis")
+      if (label) {
+        label.textContent = name
+      } else {
+        nameElement.textContent = name
+      }
+      return
+    }
+
+    const header = card.querySelector(".card__header")
+    if (!header) return
+
+    nameElement = document.createElement("span")
+    nameElement.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+    const label = document.createElement("span")
+    label.className = "overflow-ellipsis"
+    label.textContent = name
+    nameElement.append(label)
+    header.append(nameElement)
+  }
+
+  #removeCardColumnName(card) {
+    card.querySelector(".card__header > .card__column-name")?.remove()
+  }
+
+  #restoreMove(card, move) {
+    if (!card.isConnected) return
+
+    for (const [ key, value ] of Object.entries(move.dataset)) {
+      if (value === null) {
+        delete card.dataset[key]
+      } else {
+        card.dataset[key] = value
+      }
+    }
+
+    card.querySelector(".card__header > .card__column-name")?.remove()
+    if (move.nameClone && move.nameParent?.isConnected) {
+      if (move.nameNextSibling?.isConnected) {
+        move.nameParent.insertBefore(move.nameClone, move.nameNextSibling)
+      } else {
+        move.nameParent.append(move.nameClone)
+      }
+    }
+
+    if (move.sourceParent) {
+      if (move.sourceNextSibling?.isConnected) {
+        move.sourceParent.insertBefore(card, move.sourceNextSibling)
+      } else {
+        move.sourceParent.append(card)
+      }
+    }
+
+    if (move.sourceList) {
+      move.sourceList.querySelectorAll(".blank-slate").forEach(blankSlate => blankSlate.remove())
+    }
+
+    if (move.destinationList) {
+      for (const blankSlate of move.destinationBlankSlates) {
+        if (!blankSlate.isConnected) move.destinationList.append(blankSlate)
+      }
+    }
+
+    this.#setCountText(move.sourceColumn, move.sourceCount)
+    this.#setCountText(move.destinationColumn, move.destinationCount)
+  }
+
+  #ensureDragBlankSlate(list) {
+    if (list.querySelector(".blank-slate--drag")) return
+
+    const blankSlate = document.createElement("div")
+    blankSlate.className = "blank-slate blank-slate--drag overflow-ellipsis"
+    blankSlate.textContent = "Drag cards here"
+    list.prepend(blankSlate)
+  }
+
+  #countText(column) {
+    return column?.querySelector(".cards__expander-count")?.textContent || null
+  }
+
+  #setCountText(column, text) {
+    if (!column || text === null) return
+
+    const count = column.querySelector(".cards__expander-count")
+    if (count) count.textContent = text
+  }
+
+  #updateColumnCount(column, change) {
+    const count = column?.querySelector(".cards__expander-count")
+    if (!count) return
+
+    const current = count.textContent === "99+" ? 100 : (Number.parseInt(count.textContent, 10) || 0)
+    const next = Math.max(0, current + change)
+    count.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  #removeHover(column) {
+    column.classList.remove(this.#hoverContainerClass)
+  }
+
+  #clearDragState() {
+    this.draggedItem?.classList.remove(this.#draggedItemClass)
+
+    if (this.hoverContainer) {
+      this.#removeHover(this.hoverContainer)
+    }
+
+    this.draggedItem = null
+    this.hoverContainer = null
+  }
+
+  get #draggedItemClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+}
