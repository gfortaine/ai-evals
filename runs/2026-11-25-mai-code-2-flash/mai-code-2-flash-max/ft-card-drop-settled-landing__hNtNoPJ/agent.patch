+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "drags an awaiting-triage card into a column" do
+    sign_in_as(users(:david))
+
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+
+    assert_selector "##{dom_id(card, :article)}"
+
+    page.execute_script(<<~JS, dom_id(card, :article), dom_id(column))
+      const card = document.getElementById(arguments[0])
+      const column = document.getElementById(arguments[1])
+      const transfer = new DataTransfer()
+
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+      column.dispatchEvent(new DragEvent("dragenter", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+      column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+      column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+      card.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+    JS
+
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all, wait: 5
+
+    50.times do
+      card.reload
+      break if card.column == column
+      sleep 0.1
+    end
+
+    assert_equal column, card.reload.column
+  end
+end
