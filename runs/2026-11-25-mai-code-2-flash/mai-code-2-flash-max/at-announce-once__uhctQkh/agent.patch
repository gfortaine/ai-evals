diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..8390629 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,31 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_create :capture_created_publication_state
+    before_update :capture_updated_publication_state
+
+    after_create_commit :announce_publication
+    after_update_commit :announce_publication
+    after_rollback :forget_publication_sitting
   end
 
   private
+    def capture_created_publication_state
+      @published_before_sitting = false
+    end
+
+    def capture_updated_publication_state
+      @published_before_sitting = published_in_database unless instance_variable_defined?(:@published_before_sitting)
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      published_before_sitting = @published_before_sitting
+      forget_publication_sitting
+
+      AnnouncePublicationJob.perform_later(self) if published_before_sitting == false && published?
+    end
+
+    def forget_publication_sitting
+      remove_instance_variable(:@published_before_sitting) if instance_variable_defined?(:@published_before_sitting)
     end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..65718b3 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -1,6 +1,67 @@
 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  test "publishing a book enqueues one announcement" do
+    book = books(:manual)
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ book ]) do
+      book.update!(published: true)
+    end
+  end
+
+  test "publishing a book and changing pages announces once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.press Page.new(body: ""), title: "A new page"
+      end
+    end
+  end
+
+  test "saving an already-live book does not announce again" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: true)
+    end
+  end
+
+  test "saving a draft does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(title: "Updated manual")
+    end
+  end
+
+  test "taking a live book down does not announce" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+  end
+
+  test "a failed sitting leaves a draft and announces nothing" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not_predicate book.reload, :published?
+  end
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
