+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActiveSupport::TestCase
+  test "weekly digest formats book update dates" do
+    book = books(:handbook)
+    book.update!(published: true, updated_at: Time.utc(2024, 11, 21, 13, 45, 6))
+
+    mail = ReportDigestMailer.weekly(users(:david))
+
+    assert_includes mail.body.encoded, "last edited 21 Nov"
+  end
+end
