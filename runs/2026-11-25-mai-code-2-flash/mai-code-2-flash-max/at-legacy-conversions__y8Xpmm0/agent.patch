diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..25ff676
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,13 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveSupport::TestCase
+  test "archive header restores the default timestamp format" do
+    book = books(:handbook)
+    timestamp = Time.utc(2024, 11, 21, 13, 45, 6)
+    book.leaves.active.update_all(updated_at: timestamp)
+
+    header = ReportArchiveJob.new.send(:header, book)
+
+    assert_equal "# archived #{book.last_edited_at.to_s}", header
+  end
+end
diff --git a/test/lib/report_card_test.rb b/test/lib/report_card_test.rb
new file mode 100644
index 0000000..d19d04f
--- /dev/null
+++ b/test/lib/report_card_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class ReportCardTest < ActiveSupport::TestCase
+  test "formats dates and record ids" do
+    book = books(:handbook)
+    book.update!(
+      created_at: Time.utc(2023, 2, 3, 4, 5, 6),
+      updated_at: Time.utc(2024, 11, 21, 13, 45, 6)
+    )
+
+    text = Publishing::ReportCard.new(book).to_text
+
+    assert_includes text, "Started: February 03, 2023 04:05"
+    assert_includes text, "Updated: 21 Nov 13:45"
+    assert_includes text, "Covers: #{book.leaves.active.positioned.pluck(:id).join(",")}"
+  end
+
+  test "formats an empty record list as null" do
+    text = Publishing::ReportCard.new(books(:manual)).to_text
+
+    assert_includes text, "Covers: null"
+  end
+end
