diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..8636ff0 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -76,6 +76,36 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_in_body "title: \"Reading\""
   end
 
+  test "show and fetch a picture without processing it twice" do
+    leaf = leaves(:reading_picture)
+    picture = leaf.leafable
+    perform_enqueued_jobs do
+      picture.image.attach io: file_fixture("reading.webp").open,
+        filename: "reading.webp", content_type: "image/webp"
+    end
+
+    blob = picture.image.blob
+    assert_equal 1, blob.variant_records.count
+
+    transformations = 0
+    callback = ->(*_args) { transformations += 1 }
+
+    ActiveSupport::Notifications.subscribed(callback, "transform.active_storage") do
+      get leafable_slug_path(leaf)
+      assert_response :success
+
+      picture_url = css_select("figure.page--picture img").first["src"]
+      get picture_url
+      assert_response :redirect
+
+      follow_redirect!
+      assert_response :success
+    end
+
+    assert_equal 0, transformations
+    assert_equal 1, blob.variant_records.count
+  end
+
   test "show a picture whose image cannot be resized" do
     leaves(:reading_picture).leafable.image.attach io: file_fixture("pixel.bmp").open,
       filename: "pixel.bmp", content_type: "image/bmp"
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..20eee69 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -17,6 +17,23 @@ class PictureTest < ActiveSupport::TestCase
     assert_kind_of ActiveStorage::VariantWithRecord, pictures(:reading).large_image
   end
 
+  test "named variant and representation share one derived copy" do
+    picture = pictures(:reading)
+    picture.image.attach io: file_fixture("reading.webp").open,
+      filename: "reading.webp", content_type: "image/webp"
+
+    named_variant = picture.large_image
+    named_variant.processed
+    assert named_variant.processed?
+
+    represented_variant = picture.image.blob.representation(named_variant.variation.key)
+
+    assert_equal named_variant.variation.digest, represented_variant.variation.digest
+    assert represented_variant.processed?
+    assert_equal named_variant.download, represented_variant.download
+    assert_equal 1, picture.image.blob.variant_records.count
+  end
+
   test "large_image is the original image when the image cannot be resized" do
     picture = pictures(:reading)
     picture.image.attach io: file_fixture("pixel.bmp").open, filename: "pixel.bmp", content_type: "image/bmp"
