@@ -0,0 +1,133 @@
+class EmailVerificationCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  EMAIL_VERIFICATION_EXPIRATION = EXPIRATION
+  VALIDITY_DURATION = EXPIRATION
+  EXPIRES_IN = EXPIRATION
+  CODE_EXPIRATION = EXPIRATION
+
+  PURPOSE_SIGN_IN = "sign_in"
+  PURPOSE_SIGNUP = "signup"
+  PURPOSE_JOIN = "join"
+
+  belongs_to :account, optional: true
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  before_validation :normalize_email_address
+  before_validation :set_purpose, on: :create
+  before_validation :set_expiration, on: :create
+  before_validation :generate_code, on: :create
+
+  validates :email_address, presence: true, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true, uniqueness: true, format: { with: /\A\d{6}\z/ }
+  validates :purpose, presence: true, inclusion: { in: [ PURPOSE_SIGN_IN, PURPOSE_SIGNUP, PURPOSE_JOIN ] }
+  validates :expires_at, presence: true
+
+  scope :active, -> { where(redeemed_at: nil).where("expires_at > ?", Time.current) }
+
+  def self.issue(email_address:, purpose:, account: nil, join_code: nil)
+    normalized_email = normalize_email_address(email_address)
+
+    transaction do
+      where(email_address: normalized_email, purpose: purpose, redeemed_at: nil)
+        .merge(join_scope(account: account, join_code: join_code))
+        .where("expires_at > ?", Time.current)
+        .update_all(redeemed_at: Time.current, updated_at: Time.current)
+
+      create!(
+        email_address: normalized_email,
+        purpose: purpose,
+        account: account,
+        join_code: join_code
+      )
+    end
+  end
+
+  def self.create_for(email_address:, purpose:, account: nil, join_code: nil)
+    issue(email_address: email_address, purpose: purpose, account: account, join_code: join_code)
+  end
+
+  def self.authenticate(code:, purpose:, account: nil, join_code: nil)
+    relation = active.where(purpose: purpose)
+    relation = relation.where(account: account) if account
+    relation = relation.where(join_code: join_code) if join_code
+
+    if verification = relation.find_by(code: code.to_s)
+      verification.redeem_with(code)
+    end
+  end
+
+  def self.verify(code:, purpose:, account: nil, join_code: nil)
+    authenticate(code: code, purpose: purpose, account: account, join_code: join_code)
+  end
+
+  def self.find_by_code(code)
+    find_by(code: code.to_s)
+  end
+
+  def self.normalize_email_address(email_address)
+    email_address.to_s.strip.downcase.presence
+  end
+
+  def active?
+    redeemed_at.nil? && expires_at.present? && expires_at > Time.current
+  end
+
+  def expired?
+    !active?
+  end
+
+  def valid_code?(code)
+    active? && ActiveSupport::SecurityUtils.secure_compare(self.code, code.to_s)
+  end
+
+  def verify(code)
+    redeem_with(code)
+  end
+
+  def redeem_with(code)
+    if active? && ActiveSupport::SecurityUtils.secure_compare(self.code, code.to_s)
+      with_lock do
+        if active?
+          update!(redeemed_at: Time.current)
+          self
+        end
+      end
+    end
+  end
+
+  def deliver_later
+    IdentityMailer.email_verification_code(email_address: email_address, code: code).deliver_later
+  end
+
+  private
+    def set_purpose
+      self.purpose = PURPOSE_SIGN_IN if purpose.blank?
+    end
+
+    def normalize_email_address
+      self.email_address = self.class.normalize_email_address(email_address)
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION.from_now
+    end
+
+    def generate_code
+      if code.blank?
+        self.code = loop do
+          candidate = SecureRandom.random_number(10**CODE_LENGTH).to_s.rjust(CODE_LENGTH, "0")
+          break candidate unless self.class.exists?(code: candidate)
+        end
+      end
+    end
+
+    def self.join_scope(account:, join_code:)
+      scope = all
+      scope = scope.where(account: account) if account
+      scope = scope.where(join_code: join_code) if join_code
+      scope
+    end
+end
+
+EmailVerification = EmailVerificationCode
