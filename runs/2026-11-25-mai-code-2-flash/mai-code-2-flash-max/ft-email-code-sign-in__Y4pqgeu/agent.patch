diff --git a/test/controllers/email_verification_codes_controller_test.rb b/test/controllers/email_verification_codes_controller_test.rb
new file mode 100644
index 0000000..c0ff5df
--- /dev/null
+++ b/test/controllers/email_verification_codes_controller_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class EmailVerificationCodesControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign-in email sends a code and the next screen accepts it" do
+    identity = identities(:david)
+
+    assert_emails 1 do
+      untenanted do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    assert_redirected_to new_session_url(script_name: nil)
+
+    verification = EmailVerificationCode.find_by!(email_address: identity.email_address, purpose: EmailVerificationCode::PURPOSE_SIGN_IN)
+
+    untenanted do
+      post session_path, params: { code: verification.code }
+    end
+
+    assert_response :redirect
+    assert cookies[:session_token].present?
+  end
+
+  test "sign-up email sends a code and code creates the identity and session" do
+    email_address = "signup-code@example.com"
+
+    assert_emails 1 do
+      untenanted do
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+    end
+
+    assert_redirected_to new_signup_url(script_name: nil)
+
+    verification = EmailVerificationCode.find_by!(email_address: email_address, purpose: EmailVerificationCode::PURPOSE_SIGNUP)
+
+    assert_difference -> { Identity.count }, 1 do
+      untenanted do
+        post signup_code_path, params: { code: verification.code }
+      end
+    end
+
+    assert_redirected_to new_signup_completion_path
+    assert cookies[:session_token].present?
+  end
+
+  test "join email sends a code and code joins the account" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "join-code@example.com"
+
+    assert_emails 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+    end
+
+    assert_redirected_to join_path(code: join_code.code)
+
+    verification = EmailVerificationCode.find_by!(
+      email_address: email_address,
+      purpose: EmailVerificationCode::PURPOSE_JOIN,
+      join_code: join_code
+    )
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        post join_path(code: join_code.code, script_name: account.slug), params: { code: verification.code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert cookies[:session_token].present?
+  end
+end
