+class JoinCodes::CodesController < ApplicationController
+  allow_unauthenticated_access
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def new
+    @email_verification = pending_email_verification(
+      purpose: EmailVerificationCode::PURPOSE_JOIN,
+      join_code: @join_code
+    )
+  end
+
+  def create
+    verification_code = request.request_parameters[:code].presence || request.request_parameters["code"].presence || params[:email_verification_code].presence
+
+    if verification = authenticate_email_verification_code(
+      code: verification_code,
+      purpose: EmailVerificationCode::PURPOSE_JOIN,
+      account: @join_code.account,
+      join_code: @join_code
+    )
+      identity = Identity.find_or_create_by!(email_address: verification.email_address)
+      start_new_session_for identity
+      clear_pending_email_verification
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { head :no_content }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to join_code_verification_path(code: @join_code.code), alert: "That code didn't work or has expired. Try again." }
+        format.json { render json: { message: "That code didn't work or has expired." }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+    def set_join_code
+      join_code = request.path_parameters[:code].presence || params[:join_code].presence
+      @join_code = Account::JoinCode.find_by(code: join_code, account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+end
