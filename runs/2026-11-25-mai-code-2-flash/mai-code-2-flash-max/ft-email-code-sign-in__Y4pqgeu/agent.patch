+require "test_helper"
+
+class EmailVerificationCodeTest < ActiveSupport::TestCase
+  test "issues a six digit code that expires in fifteen minutes" do
+    verification = EmailVerificationCode.issue(
+      email_address: " Test@Example.com ",
+      purpose: EmailVerificationCode::PURPOSE_SIGN_IN
+    )
+
+    assert_equal "test@example.com", verification.email_address
+    assert_match(/\A\d{6}\z/, verification.code)
+    assert_in_delta 15.minutes.to_i, verification.expires_at - Time.current, 2
+  end
+
+  test "expires after fifteen minutes" do
+    verification = EmailVerificationCode.issue(
+      email_address: "test@example.com",
+      purpose: EmailVerificationCode::PURPOSE_SIGN_IN
+    )
+
+    travel_to 15.minutes.from_now + 1.second do
+      assert_not verification.active?
+      assert_nil EmailVerificationCode.authenticate(
+        code: verification.code,
+        purpose: EmailVerificationCode::PURPOSE_SIGN_IN
+      )
+    end
+  end
+
+  test "redeems only once" do
+    verification = EmailVerificationCode.issue(
+      email_address: "test@example.com",
+      purpose: EmailVerificationCode::PURPOSE_SIGN_IN
+    )
+
+    assert_equal verification, verification.redeem_with(verification.code)
+    assert_nil verification.redeem_with(verification.code)
+  end
+end
