diff --git a/app/jobs/title_cleanup_job.rb b/app/jobs/title_cleanup_job.rb
index 13721ed..41ee5ca 100644
--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,12 +1,24 @@
 class TitleCleanupJob < ApplicationJob
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    Leaf.where(title_cleanup_completed: false).find_each(order: :asc) do |leaf|
+      leaf.with_lock do
+        next if leaf.title_cleanup_completed?
+
+        cleaned_title = cleaned(leaf.title)
+
+        if cleaned_title == leaf.title
+          leaf.update_column :title_cleanup_completed, true
+        else
+          leaf.update! title: cleaned_title, title_cleanup_completed: true
+        end
+      end
     end
   end
 
   private
     def cleaned(title)
+      return title unless title.start_with?('"') && title.end_with?('"')
+
       title.delete_prefix('"').delete_suffix('"')
     end
 end
