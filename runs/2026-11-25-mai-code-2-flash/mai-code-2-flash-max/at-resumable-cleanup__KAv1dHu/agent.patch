diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..045e1aa
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  test "cleans legacy wrappers and preserves inner quotes" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: '"A "quoted" phrase"')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal 'A "quoted" phrase', leaf.reload.title
+  end
+
+  test "does not clean a title that only legitimately opens with a quote" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: '"A quoted phrase')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal '"A quoted phrase', leaf.reload.title
+  end
+
+  test "resumes after an interruption without reprocessing completed leaves" do
+    first = leaves(:welcome_section)
+    second = leaves(:welcome_page)
+    third = leaves(:summary_page)
+
+    first.update!(title: '"First title"')
+    second.update!(title: '"Second title"')
+    third.update!(title: '"Third title"')
+
+    interrupting_job = Class.new(TitleCleanupJob) do
+      def cleaned(title)
+        raise "deploy interrupted the job" if title == '"Second title"'
+
+        super
+      end
+    end
+
+    assert_raises(RuntimeError) do
+      interrupting_job.perform_now
+    end
+
+    assert_equal "First title", first.reload.title
+    assert_equal '"Second title"', second.reload.title
+    assert_equal '"Third title"', third.reload.title
+
+    assert first.reload.title_cleanup_completed?
+    assert_not second.reload.title_cleanup_completed?
+    assert_not third.reload.title_cleanup_completed?
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "First title", first.reload.title
+    assert_equal "Second title", second.reload.title
+    assert_equal "Third title", third.reload.title
+  end
+end
