diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..bf08241
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:handbook)
+    @timestamp = Time.zone.local(2024, 3, 14, 15, 9, 26)
+    @book.update_columns(created_at: @timestamp, updated_at: @timestamp)
+
+    sign_in :kevin
+  end
+
+  test "show formats the last updated date" do
+    get book_report_path(@book)
+
+    assert_response :success
+    assert_in_body "Last updated March 14, 2024"
+  end
+
+  test "text format returns the card with a formatted filename" do
+    get book_report_path(@book, format: :text)
+
+    assert_response :success
+    assert_includes response.body, "Started: March 14, 2024 15:09"
+    assert_includes response.body, "Updated: 14 Mar 15:09"
+    assert_includes response.headers["Content-Disposition"], "shelf-report-20240314150926.txt"
+  end
+end
diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..78585a6
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveSupport::TestCase
+  test "archives the last edited timestamp in database format" do
+    book = books(:handbook)
+    timestamp = Time.utc(2024, 3, 14, 15, 9, 26)
+    book.leaves.active.update_all(updated_at: timestamp)
+
+    path = Rails.root.join("storage/archives", "book-#{book.id}.txt")
+
+    begin
+      ReportArchiveJob.new.perform(book)
+
+      assert_includes File.read(path), "# archived 2024-03-14 15:09:26"
+    ensure
+      FileUtils.rm_f(path)
+    end
+  end
+end
