@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportCardTest < ActiveSupport::TestCase
+  test "formats the cover list as database record ids" do
+    book = books(:handbook)
+
+    card = Publishing::ReportCard.new(book).to_text
+
+    ids = book.leaves.active.positioned.to_a.to_fs(:db)
+    assert_includes card, "Covers: #{ids}"
+  end
+end
