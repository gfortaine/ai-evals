diff --git a/config/initializers/upgrade_compatibility.rb b/config/initializers/upgrade_compatibility.rb
new file mode 100644
index 0000000..418fe31
--- /dev/null
+++ b/config/initializers/upgrade_compatibility.rb
@@ -0,0 +1,62 @@
+# frozen_string_literal: true
+
+# Keep signed mail links and cookie values readable while the key generator
+# digest moves between the Rails 6.1 SHA1 default and the Rails 7.0 SHA256 default.
+Rails.application.config.after_initialize do
+  secret_key_base = Rails.application.secret_key_base
+  next unless secret_key_base
+
+  iterations = 1000
+
+  sha1_secret = lambda do |salt, key_length|
+    OpenSSL::PKCS5.pbkdf2_hmac_sha1(secret_key_base, salt, iterations, key_length)
+  end
+
+  sha256_secret = lambda do |salt, key_length|
+    OpenSSL::PKCS5.pbkdf2_hmac(
+      secret_key_base,
+      salt,
+      iterations,
+      key_length,
+      OpenSSL::Digest::SHA256.new
+    )
+  end
+
+  mail_links = Rails.application.message_verifier(:mail_links)
+  mail_links.rotate(sha1_secret.call('mail_links', 64), serializer: Marshal)
+  mail_links.rotate(sha256_secret.call('mail_links', 64), serializer: Marshal)
+
+  rotations = Rails.application.config.action_dispatch.cookies_rotations
+
+  signed_cookie_salt = Rails.application.config.action_dispatch.signed_cookie_salt
+  rotations.rotate(:signed, sha1_secret.call(signed_cookie_salt, 64))
+  rotations.rotate(:signed, sha256_secret.call(signed_cookie_salt, 64))
+
+  authenticated_cookie_salt = Rails.application.config.action_dispatch.authenticated_encrypted_cookie_salt
+  authenticated_key_length = ActiveSupport::MessageEncryptor.key_len('aes-256-gcm')
+  rotations.rotate(
+    :encrypted,
+    sha1_secret.call(authenticated_cookie_salt, authenticated_key_length),
+    nil,
+    cipher: 'aes-256-gcm'
+  )
+  rotations.rotate(
+    :encrypted,
+    sha256_secret.call(authenticated_cookie_salt, authenticated_key_length),
+    nil,
+    cipher: 'aes-256-gcm'
+  )
+
+  # Rails 6.1 applications upgraded from older releases may still encounter
+  # authenticated AES-CBC cookies. Keep accepting their SHA1-derived keys.
+  legacy_cookie_salt = Rails.application.config.action_dispatch.encrypted_cookie_salt
+  legacy_sign_salt = Rails.application.config.action_dispatch.encrypted_signed_cookie_salt
+  legacy_key_length = ActiveSupport::MessageEncryptor.key_len('aes-256-cbc')
+  rotations.rotate(
+    :encrypted,
+    sha1_secret.call(legacy_cookie_salt, legacy_key_length),
+    sha1_secret.call(legacy_sign_salt, 64),
+    cipher: 'aes-256-cbc',
+    digest: 'SHA1'
+  )
+end
diff --git a/docs/UPGRADE.md b/docs/UPGRADE.md
new file mode 100644
index 0000000..d9bda07
--- /dev/null
+++ b/docs/UPGRADE.md
@@ -0,0 +1,23 @@
+# Rails and Ruby Upgrade Notes
+
+## Rails 6.1 / Ruby 3.2 release
+
+- Production is moving from Ruby 3.0.7 to Ruby 3.2.9 while remaining on Rails 6.1.7.10.
+- `Gemfile` permits Ruby 3.2 only. `Gemfile.next` resolves the application with Rails 7.0.8.7.
+- `config.load_defaults 6.1` remains the framework-default baseline for this release.
+
+### Compatibility decisions
+
+- Mail links use a two-way key-derivation compatibility rotation. Rails 6.1 SHA1-derived and Rails 7.0 SHA256-derived mail-link keys can both verify until old mail expires.
+- Session and signed-cookie key rotations retain both SHA1 and SHA256 derived keys, including the legacy AES-CBC cookie fallback.
+- `config.action_dispatch.cookies_serializer = :hybrid` reads existing Marshal cookies and writes new JSON cookies. This avoids signing users out during the staged rollout.
+- The Action View resolver patch works with both Rails 6.1's cached resolver API and Rails 7.0's uncached `_find_all` API.
+- `config.active_support.key_generator_hash_digest_class` and `config.active_support.hash_digest_class` are staged to SHA256 so Rails 7.0 will not introduce a new key/cache digest on upgrade.
+- Cache entries remain on the Rails 6.1 format. `config.active_support.cache_format_version = 7.0` is not enabled until rollback is no longer possible.
+
+### Next release work
+
+- Run the Rails 7.0 application through `Gemfile.next` and complete the Rails 7.0 defaults upgrade.
+- Set `config.load_defaults 7.0`, then keep the hybrid cookie serializer until any remaining Marshal cookies have been migrated.
+- Keep the mail-link and cookie key rotations while tokens or cookies created before the Rails 7.0 release can still be active.
+- Review and enable any remaining Rails 7.0 framework defaults, then remove temporary compatibility settings that are no longer needed.
