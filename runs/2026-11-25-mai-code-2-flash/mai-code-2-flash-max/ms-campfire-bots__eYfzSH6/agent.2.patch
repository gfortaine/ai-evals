diff --git a/app/jobs/bot/webhook_job.rb b/app/jobs/bot/webhook_job.rb
new file mode 100644
index 0000000..ded8c43
--- /dev/null
+++ b/app/jobs/bot/webhook_job.rb
@@ -0,0 +1,90 @@
+require "cgi"
+require "json"
+require "net/http"
+require "uri"
+
+class Bot::WebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 5
+
+  def perform(bot, room, message)
+    return unless bot.active? && bot.webhook_url.present?
+
+    uri = URI.parse(bot.webhook_url)
+    return unless uri.is_a?(URI::HTTP)
+
+    response = post_webhook(uri, payload_for(bot:, room:, message:))
+    post_response(bot:, room:, response:) if response.is_a?(Net::HTTPOK)
+  rescue URI::InvalidURIError, ArgumentError, SocketError, SystemCallError,
+         Timeout::Error, Net::HTTPError, OpenSSL::SSL::SSLError
+    nil
+  end
+
+  private
+    def payload_for(bot:, room:, message:)
+      {
+        event: "mention",
+        author: {
+          id: message.creator.id,
+          name: message.creator.name
+        },
+        room: {
+          id: room.id,
+          name: room.name,
+          reply_to: Rails.application.routes.url_helpers.room_bot_messages_path(room_id: room.id, bot_code: bot.bot_code)
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: mentioned_message_text(bot:, message:),
+            html: message.body&.body&.to_html.to_s
+          },
+          link: Rails.application.routes.url_helpers.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def mentioned_message_text(bot:, message:)
+      text = message.body&.body&.to_plain_text.to_s
+      mention = /@#{Regexp.escape(bot.name)}(?=\z|[^[:alnum:]_])/
+      text = text.gsub(mention, "")
+
+      text.lines.map(&:strip).join("\n")
+        .gsub(/[ \t]{2,}/, " ")
+        .sub(/\A[\s,;:—-]+/, "")
+        .strip
+    end
+
+    def post_webhook(uri, payload)
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request["Content-Type"] = "application/json"
+      request["Accept"] = "application/json"
+      request.body = JSON.generate(payload)
+
+      Net::HTTP.start(
+        uri.host,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT
+      ) do |http|
+        http.request(request)
+      end
+    end
+
+    def post_response(bot:, room:, response:)
+      content_type = response["Content-Type"].to_s.split(";", 2).first.to_s.strip.downcase
+      return unless %w[text/plain text/html].include?(content_type)
+
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+      return if body.blank?
+
+      rich_text_body = content_type == "text/plain" ? CGI.escapeHTML(body) : body
+      message = room.messages.create_with_attachment!(creator: bot, body: rich_text_body)
+      message.broadcast_create
+    end
+end
+
+Bot::MentionWebhookJob = Bot::WebhookJob
