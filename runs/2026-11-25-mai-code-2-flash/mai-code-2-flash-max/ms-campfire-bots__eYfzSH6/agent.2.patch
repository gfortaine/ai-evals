diff --git a/test/jobs/bot/webhook_job_test.rb b/test/jobs/bot/webhook_job_test.rb
new file mode 100644
index 0000000..aecc798
--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(
+      name: "Deploy Bot",
+      creator: users(:david),
+      webhook_url: "https://hooks.example.test/deploy"
+    )
+    @room = rooms(:hq)
+    @message = @room.messages.create!(
+      creator: users(:david),
+      body: "@Deploy Bot restart the build please",
+      client_message_id: "deploy-mention"
+    )
+  end
+
+  test "posts the mention payload and creates a text response as the bot" do
+    stub_request(:post, @bot.webhook_url)
+      .with(headers: { "Content-Type" => "application/json" })
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Build restarted")
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::WebhookJob.new.perform(@bot, @room, @message)
+    end
+
+    assert_requested(:post, @bot.webhook_url, times: 1) do |request|
+      body = JSON.parse(request.body)
+
+      body["event"] == "mention" &&
+        body.dig("author", "id") == users(:david).id &&
+        body.dig("author", "name") == "David" &&
+        body.dig("room", "id") == @room.id &&
+        body.dig("room", "name") == @room.name &&
+        body.dig("room", "reply_to") == "/rooms/#{@room.id}/#{@bot.bot_code}/messages" &&
+        body.dig("message", "id") == @message.id &&
+        body.dig("message", "body", "text") == "restart the build please" &&
+        body.dig("message", "body", "html").include?("Deploy Bot") &&
+        body.dig("message", "link") == "/rooms/#{@room.id}/@#{@message.id}"
+    end
+
+    reply = Message.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build restarted", reply.plain_text_body
+  end
+
+  test "posts rich HTML as the bot message" do
+    stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, headers: { "Content-Type" => "text/html; charset=utf-8" }, body: "<div><strong>Build restarted</strong></div>")
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::WebhookJob.new.perform(@bot, @room, @message)
+    end
+
+    reply = Message.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.body.to_html, "Build restarted"
+  end
+
+  test "plain text stays plain when it contains HTML characters" do
+    stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "<b>Build restarted</b>")
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::WebhookJob.new.perform(@bot, @room, @message)
+    end
+
+    reply = Message.order(:id).last
+    assert_equal "<b>Build restarted</b>", reply.plain_text_body
+  end
+
+  test "204 response posts no message" do
+    stub_request(:post, @bot.webhook_url)
+      .to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      Bot::WebhookJob.new.perform(@bot, @room, @message)
+    end
+  end
+end
