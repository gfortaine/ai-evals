diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..86861a6
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,64 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    room = Room.find_by(id: params[:room_id])
+    return head :not_found unless room
+
+    bot = Bot.active.find_by(bot_code: params[:bot_code])
+    return head :unauthorized unless bot
+    return head :not_found unless room.users.exists?(bot.id)
+
+    body = raw_message_body
+    attachment = message_attachment
+
+    if body.to_s.strip.blank? && attachment.blank?
+      return head :unprocessable_content
+    end
+
+    message = room.messages.create_with_attachment!(
+      creator: bot,
+      body: body,
+      attachment: attachment
+    )
+    message.broadcast_create
+
+    head :created, location: message_path(message)
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_content
+  end
+
+  private
+    def raw_message_body
+      if multipart_request?
+        utf8(params[:body].to_s.presence || params.dig(:message, :body).to_s)
+      elsif form_request?
+        utf8(params[:body].to_s.presence || params.dig(:message, :body).to_s.presence || raw_request_body)
+      else
+        utf8(raw_request_body)
+      end
+    end
+
+    def message_attachment
+      params[:attachment].presence || params[:file].presence || params.dig(:message, :attachment).presence
+    end
+
+    def utf8(value)
+      value.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+    end
+
+    def multipart_request?
+      request.media_type == "multipart/form-data"
+    end
+
+    def form_request?
+      request.media_type == "application/x-www-form-urlencoded"
+    end
+
+    def raw_request_body
+      request.raw_post.to_s
+    rescue EOFError, IOError
+      ""
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..2c50282
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,59 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ show edit update destroy ]
+  before_action :ensure_can_manage_bot, only: %i[ show edit update destroy ]
+
+  def index
+    @bots = bots_scope.ordered
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Bot.new(bot_params.merge(creator: Current.user))
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def show
+    redirect_to edit_bot_url(@bot)
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url
+  end
+
+  private
+    def bots_scope
+      Current.user.administrator? ? Bot.all : Bot.where(creator: Current.user)
+    end
+
+    def set_bot
+      @bot = Bot.find(params[:id])
+    end
+
+    def ensure_can_manage_bot
+      head :forbidden unless Current.user.administrator? || @bot.creator == Current.user
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..0f55635
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,43 @@
+class Bot < User
+  belongs_to :creator, class_name: "User", optional: true
+
+  has_secure_token :bot_code
+
+  alias_attribute :code, :bot_code
+  alias_attribute :owner_id, :creator_id
+
+  validates :name, presence: true
+  validates :bot_code, presence: true, uniqueness: true
+
+  before_validation :ensure_bot_code, on: :create
+  before_validation :ensure_password_digest, on: :create
+
+  def user
+    self
+  end
+
+  def owner
+    creator
+  end
+
+  def owner=(user)
+    self.creator = user
+  end
+
+  def created_by
+    creator
+  end
+
+  def created_by=(user)
+    self.creator = user
+  end
+
+  private
+    def ensure_bot_code
+      self.bot_code ||= SecureRandom.base58(24)
+    end
+
+    def ensure_password_digest
+      self.password = SecureRandom.hex(24) if password_digest.blank?
+    end
+end
