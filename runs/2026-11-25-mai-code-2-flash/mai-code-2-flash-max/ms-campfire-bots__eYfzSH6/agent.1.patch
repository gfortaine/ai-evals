+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "creates a named bot with a unique code and password" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert_equal "Deploy Bot", bot.name
+    assert bot.bot_code.present?
+    assert_equal bot.bot_code, bot.code
+    assert bot.password_digest.present?
+  end
+
+  test "requires a name" do
