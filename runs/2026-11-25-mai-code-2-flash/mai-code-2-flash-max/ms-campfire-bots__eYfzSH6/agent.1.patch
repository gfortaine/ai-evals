diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..f8d83b6
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    @room = rooms(:hq)
+  end
+
+  test "posts raw text as the bot and returns the message location" do
+    post "/rooms/#{@room.id}/#{@bot.bot_code}/messages",
+      params: "Deploy of v1.2.3 finished ✅",
+      headers: { "Content-Type" => "text/plain" }
+
+    assert_response :created
+    message = Message.order(:id).last
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "returns not found for a bad room id" do
+    post "/rooms/999999/#{@bot.bot_code}/messages",
+      params: "Deploy finished",
+      headers: { "Content-Type" => "text/plain" }
+
+    assert_response :not_found
+  end
+
+  test "returns unauthorized for an invalid bot code" do
+    post "/rooms/#{@room.id}/not-a-valid-code/messages",
+      params: "Deploy finished",
+      headers: { "Content-Type" => "text/plain" }
+
+    assert_response :unauthorized
+  end
+
+  test "returns unprocessable content for an empty body without an attachment" do
+    post "/rooms/#{@room.id}/#{@bot.bot_code}/messages",
+      params: "",
+      headers: { "Content-Type" => "text/plain" }
+
+    assert_response :unprocessable_content
+  end
+
+  test "deleted bot can no longer post" do
+    bot_code = @bot.bot_code
+    @bot.destroy!
+
+    post "/rooms/#{@room.id}/#{bot_code}/messages",
+      params: "Deploy finished",
+      headers: { "Content-Type" => "text/plain" }
+
+    assert_response :unauthorized
+  end
+
+  test "accepts an attachment when there is no text body" do
+    post "/rooms/#{@room.id}/#{@bot.bot_code}/messages",
+      params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+
+    assert_response :created
+    assert Message.order(:id).last.attachment.attached?
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..ff58189
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    sign_in :david
+  end
+
+  test "account settings exposes the bots link" do
+    get edit_account_url
+
+    assert_response :success
+    assert_select "a[aria-label='Set up chat bots']"
+  end
+
+  test "index lists every bot to an administrator and includes bot codes" do
+    owned = Bot.create!(name: "Owned Bot", creator: users(:david))
+    other = Bot.create!(name: "Other Bot", creator: users(:kevin))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "input[readonly][aria-label='Bot code']", count: 2
+    assert_select "li", text: /Owned Bot/
+    assert_select "li", text: /Other Bot/
+    assert_select "input[value='#{owned.bot_code}']", count: 1
+    assert_select "input[value='#{other.bot_code}']", count: 1
+  end
+
+  test "member only sees bots they created" do
+    sign_in :kevin
+    owned = Bot.create!(name: "Kevin's Bot", creator: users(:kevin))
+    Bot.create!(name: "David's Bot", creator: users(:david))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li", text: /Kevin's Bot/
+    assert_select "li", text: /David's Bot/, count: 0
+    assert_select "input[value='#{owned.bot_code}']", count: 1
+  end
+
+  test "new and create bot" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "input[placeholder='Name the bot'][required]"
+    assert_select "button", text: "Save changes"
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    assert_redirected_to bots_url
+    bot = Bot.find_by!(name: "Deploy Bot")
+    assert_equal users(:david), bot.creator
+    assert bot.bot_code.present?
+  end
+
+  test "update bot" do
+    bot = Bot.create!(name: "Old Name", creator: users(:david))
+
+    patch bot_url(bot), params: { bot: { name: "New Name" } }
+
+    assert_redirected_to bots_url
+    assert_equal "New Name", bot.reload.name
+  end
+
+  test "delete bot" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+
+    assert_redirected_to bots_url
+  end
+
+  test "member cannot manage another member's bot" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    sign_in :kevin
+
+    patch bot_url(bot), params: { bot: { name: "Changed" } }
+
+    assert_response :forbidden
+  end
+end
