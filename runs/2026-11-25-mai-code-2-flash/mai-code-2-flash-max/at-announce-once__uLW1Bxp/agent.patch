diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..aa5362e 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,32 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_create :remember_initial_publication
+    before_update :remember_publication_transition
+    after_save_commit :announce_publication
+    after_rollback :forget_publication_transition
   end
 
   private
+    def remember_initial_publication
+      @publication_initial_state = false if published?
+    end
+
+    def remember_publication_transition
+      if will_save_change_to_published? && @publication_initial_state.nil?
+        @publication_initial_state = attribute_in_database("published")
+      end
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      if @publication_initial_state == false && published?
+        AnnouncePublicationJob.perform_later self
+      end
+    ensure
+      @publication_initial_state = nil
+    end
+
+    def forget_publication_transition
+      @publication_initial_state = nil
     end
 end
