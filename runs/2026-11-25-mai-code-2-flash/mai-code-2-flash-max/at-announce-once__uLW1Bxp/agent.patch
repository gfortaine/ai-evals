+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
@@ -40,4 +42,75 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "creating a live book announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create!(title: "Live at creation", slug: "live-at-creation", published: true)
+    end
+  end
+
+  test "publishing a book announces it once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.update!(published: true)
+    end
+  end
+
+  test "publishing with another change announces once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.press Page.new(body: ""), title: "Added page"
+      end
+    end
+  end
+
+  test "saving an already live book does not announce" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(title: "Renamed manual")
+    end
+  end
+
+  test "unpublishing a book does not announce" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+  end
+
+  test "publishing and unpublishing in one sitting does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.update!(published: false)
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "a rollback after publishing leaves the book draft and does not announce" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not book.reload.published?
+  end
 end
