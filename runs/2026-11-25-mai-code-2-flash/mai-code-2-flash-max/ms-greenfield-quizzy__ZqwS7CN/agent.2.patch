diff --git a/app/models/quiz.rb b/app/models/quiz.rb
index 3130c92..64b9c91 100644
--- a/app/models/quiz.rb
+++ b/app/models/quiz.rb
@@ -1,4 +1,8 @@
+require "json"
+
 class Quiz < ApplicationRecord
+  class ImportError < StandardError; end
+
   has_many :questions, dependent: :destroy
 
   validates :title, presence: true
@@ -6,4 +10,140 @@ class Quiz < ApplicationRecord
   def ordered_questions
     questions.reorder(position: :asc, id: :asc)
   end
+
+  def export_payload
+    {
+      title: title,
+      questions: ordered_questions.map do |question|
+        {
+          text: question.text,
+          active: question.active?,
+          options: question.ordered_options.map do |option|
+            {
+              text: option.text,
+              correct: option.correct?
+            }
+          end
+        }
+      end
+    }
+  end
+
+  def export_json
+    JSON.pretty_generate(export_payload)
+  end
+
+  def self.import_from_json(json)
+    payload = JSON.parse(json)
+    normalized = normalize_import_payload(payload)
+
+    quiz = nil
+    transaction do
+      quiz = create!(title: normalized[:title])
+
+      normalized[:questions].each_with_index do |question_data, index|
+        question = quiz.questions.build(
+          text: question_data[:text],
+          active: question_data[:active],
+          position: index + 1,
+          option_rows: question_data[:options]
+        )
+
+        unless question.save
+          raise ImportError, question.errors.full_messages.to_sentence
+        end
+
+        question.replace_options!(question_data[:options])
+      end
+    end
+
+    quiz
+  rescue JSON::ParserError
+    raise ImportError, "Invalid JSON"
+  rescue ImportError
+    raise
+  rescue ActiveRecord::RecordInvalid => error
+    message = error.record.errors.full_messages.to_sentence
+    raise ImportError, message.presence || "The imported quiz is invalid"
+  end
+
+  def self.normalize_import_payload(payload)
+    unless payload.is_a?(Hash)
+      raise ImportError, "The JSON must contain a quiz object"
+    end
+
+    unless payload["title"].is_a?(String) && payload["title"].present?
+      raise ImportError, "Quiz title is required"
+    end
+
+    unless payload["questions"].is_a?(Array)
+      raise ImportError, "Questions must be an array"
+    end
+
+    questions = payload["questions"].each_with_index.map do |question_data, question_index|
+      unless question_data.is_a?(Hash)
+        raise ImportError, "Question #{question_index + 1} must be an object"
+      end
+
+      unless question_data["text"].is_a?(String) && question_data["text"].present?
+        raise ImportError, "Question #{question_index + 1} text is required"
+      end
+
+      active = true
+      if question_data.key?("active")
+        active = question_data["active"]
+        unless active == true || active == false
+          raise ImportError, "Question #{question_index + 1} active must be true or false"
+        end
+      end
+
+      unless question_data["options"].is_a?(Array)
+        raise ImportError, "Question #{question_index + 1} options must be an array"
+      end
+
+      options = []
+      question_data["options"].each_with_index do |option_data, option_index|
+        unless option_data.is_a?(Hash)
+          raise ImportError, "Option #{option_index + 1} in question #{question_index + 1} must be an object"
+        end
+
+        unless option_data.key?("text") && option_data["text"].is_a?(String)
+          raise ImportError, "Option #{option_index + 1} in question #{question_index + 1} text is required"
+        end
+
+        correct = false
+        if option_data.key?("correct")
+          correct = option_data["correct"]
+          unless correct == true || correct == false
+            raise ImportError, "Option #{option_index + 1} in question #{question_index + 1} correct must be true or false"
+          end
+        end
+
+        text = option_data["text"].strip
+        next if text.blank?
+
+        options << { text: text, correct: correct }
+      end
+
+      if options.length < 2
+        raise ImportError, "Add at least two options"
+      end
+
+      unless options.any? { |option| option[:correct] }
+        raise ImportError, "Mark at least one option as correct"
+      end
+
+      {
+        text: question_data["text"],
+        active: active,
+        options: options
+      }
+    end
+
+    {
+      title: payload["title"],
+      questions: questions
+    }
+  end
+  private_class_method :normalize_import_payload
 end
