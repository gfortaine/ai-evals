diff --git a/test/integration/moderate_test.rb b/test/integration/moderate_test.rb
index 7ad3c26..1f48546 100644
--- a/test/integration/moderate_test.rb
+++ b/test/integration/moderate_test.rb
@@ -93,6 +93,127 @@ class ModerateTest < ActionDispatch::IntegrationTest
     assert_not_includes response.body, "Inactive question"
   end
 
+  test "import quiz page and export pages use the required labels" do
+    get import_moderate_quizzes_path, headers: auth_headers
+    assert_response :success
+    assert_includes response.body, "Quiz JSON"
+    assert_includes response.body, "Import"
+
+    get "/moderate", headers: auth_headers
+    assert_response :success
+    assert_includes response.body, "Import quiz"
+
+    quiz = Quiz.create!(title: "Export Quiz")
+    get export_moderate_quiz_path(quiz), headers: auth_headers
+    assert_response :success
+    assert_select "pre", 1
+  end
+
+  test "import creates a new quiz with ordered questions and options" do
+    Quiz.create!(title: "Conference Quiz")
+
+    payload = {
+      "title" => "Conference Quiz",
+      "questions" => [
+        {
+          "text" => "First question",
+          "active" => false,
+          "options" => [
+            { "text" => "First option", "correct" => true },
+            { "text" => "Second option" }
+          ]
+        },
+        {
+          "text" => "Second question",
+          "options" => [
+            { "text" => "Correct option", "correct" => true },
+            { "text" => "Other option", "correct" => false }
+          ]
+        }
+      ]
+    }.to_json
+
+    assert_difference "Quiz.count", 1 do
+      post import_moderate_quizzes_path, headers: auth_headers, params: { quiz_json: payload }
+    end
+
+    imported = Quiz.where(title: "Conference Quiz").order(id: :asc).last
+    assert_redirected_to moderate_quiz_path(imported)
+
+    questions = imported.ordered_questions.to_a
+    assert_equal ["First question", "Second question"], questions.map(&:text)
+    assert_equal [false, true], questions.map(&:active?)
+    assert_equal ["First option", "Second option"], questions.first.ordered_options.map(&:text)
+    assert_equal [true, false], questions.first.ordered_options.map(&:correct?)
+  end
+
+  test "invalid import does not save any part of the quiz" do
+    payload = {
+      "title" => "Atomic Quiz",
+      "questions" => [
+        {
+          "text" => "Valid question",
+          "options" => [
+            { "text" => "A", "correct" => true },
+            { "text" => "B", "correct" => false }
+          ]
+        },
+        {
+          "text" => "Invalid question",
+          "options" => [
+            { "text" => "A", "correct" => false },
+            { "text" => "B", "correct" => false }
+          ]
+        }
+      ]
+    }.to_json
+
+    assert_no_difference ["Quiz.count", "Question.count", "Option.count"] do
+      post import_moderate_quizzes_path, headers: auth_headers, params: { quiz_json: payload }
+    end
+
+    assert_response :unprocessable_entity
+    assert_includes response.body, "Mark at least one option as correct"
+    assert_includes response.body, "Quiz JSON"
+  end
+
+  test "malformed JSON does not create a quiz" do
+    assert_no_difference "Quiz.count" do
+      post import_moderate_quizzes_path, headers: auth_headers, params: { quiz_json: "{not json" }
+    end
+
+    assert_response :unprocessable_entity
+    assert_includes response.body, "Invalid JSON"
+  end
+
+  test "export contains only importable quiz content in stored order" do
+    quiz = Quiz.create!(title: "Export Quiz")
+
+    first = quiz.questions.create!(text: "First", active: true, position: 1,
+      option_rows: [{ text: "A", correct: true }, { text: "B", correct: false }])
+    first.replace_options!(first.option_rows)
+
+    second = quiz.questions.create!(text: "Second", active: false, position: 2,
+      option_rows: [{ text: "C", correct: false }, { text: "D", correct: true }])
+    second.replace_options!(second.option_rows)
+
+    get export_moderate_quiz_path(quiz), headers: auth_headers
+    assert_response :success
+
+    payload = JSON.parse(Nokogiri::HTML(response.body).at_css("pre").text)
+    assert_equal ["title", "questions"], payload.keys
+    assert_equal ["First", "Second"], payload["questions"].map { |question| question["text"] }
+    assert_equal [true, false], payload["questions"].map { |question| question["active"] }
+    assert_equal ["A", "B"], payload["questions"].first["options"].map { |option| option["text"] }
+
+    payload["questions"].each do |question|
+      assert_equal ["text", "active", "options"], question.keys
+      question["options"].each do |option|
+        assert_equal ["text", "correct"], option.keys
+      end
+    end
+  end
+
   private
 
   def auth_headers(username = "moderator", password = "secret")
