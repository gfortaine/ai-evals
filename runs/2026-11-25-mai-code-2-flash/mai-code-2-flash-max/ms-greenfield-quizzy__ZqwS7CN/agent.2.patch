+<% content_for :title, "Import quiz · Quizzy" %>
+<header class="admin-header">
+  <a class="admin-header__logo logo" href="<%= moderate_root_path %>"><span class="logo__mark">?</span>Quizzy</a>
+  <span class="admin-header__tag">Moderator</span>
+</header>
+
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+
+  <div class="card">
+    <% if @import_error.present? %>
+      <div class="errors"><%= @import_error %></div>
+    <% end %>
+
+    <%= form_with url: import_moderate_quizzes_path, method: :post, data: { turbo: false } do %>
+      <div class="field">
+        <label for="quiz_json">Quiz JSON</label>
+        <textarea id="quiz_json" name="quiz_json" class="input input--code" rows="18"><%= @quiz_json %></textarea>
+      </div>
+
+      <div class="buttons">
+        <button type="submit" class="btn btn--pink">Import</button>
+        <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
