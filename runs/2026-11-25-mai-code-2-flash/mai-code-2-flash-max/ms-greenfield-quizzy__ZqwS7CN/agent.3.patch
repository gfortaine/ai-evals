+<% content_for :title, "#{@game.quiz.title} · Quizzy" %>
+<main class="play"
+      data-controller="live-player"
+      data-live-player-url-value="<%= play_state_path(join_code: @game.join_code) %>">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @game.quiz.title %></span>
+  </div>
+
+  <div class="play__body" data-live-player-target="body">
+    <% if @game.ended? || @mode == :ended %>
+      <section class="result-card">
+        <h1>The quiz is over</h1>
+      </section>
+    <% elsif @player %>
+      <% if @game.lobby? %>
+        <section class="waiting">
+          <div class="waiting__gem">?</div>
+          <h1>Hi, <%= @player.name %>!</h1>
+          <p class="play-lead">Waiting for the quiz to start</p>
+        </section>
+      <% elsif @game.open? %>
+        <% question = @game.current_question %>
+        <% if question %>
+          <% answer = @game.answers.find_by(player: @player, question: question) %>
+          <section class="play-question">
+            <div class="play-question__num">Question <%= @game.current_question_number %> of <%= @game.active_question_count %></div>
+            <div class="play-question__body"><%= question.text %></div>
+            <div class="play-options">
+              <% question.ordered_options.each_with_index do |option, index| %>
+                <form action="<%= answer_play_path(join_code: @game.join_code) %>" method="post" data-action="submit->live-player#answer">
+                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
+                  <%= hidden_field_tag :option_id, option.id %>
+                  <button type="submit" class="play-option <%= "is-picked" if answer&.option_id == option.id %>">
+                    <span class="play-option__letter"><%= ("A".ord + index).chr %></span>
+                    <span class="play-option__title"><%= option.text %></span>
+                    <% if answer&.option_id == option.id %>
+                      <span class="play-option__mark">Your answer</span>
+                    <% end %>
+                  </button>
+                </form>
+              <% end %>
+            </div>
+          </section>
+        <% end %>
+      <% elsif @game.closed? %>
+        <% question = @game.current_question %>
+        <% if question %>
+          <% answer = @game.answers.find_by(player: @player, question: question) %>
+          <section class="play-question">
+            <div class="play-question__num">Question <%= @game.current_question_number %> of <%= @game.active_question_count %></div>
+            <div class="play-question__body"><%= question.text %></div>
+
+            <div class="play-options is-locked is-revealed">
+              <% question.ordered_options.each_with_index do |option, index| %>
+                <button type="button"
+                        class="play-option <%= "is-correct" if option.correct? %> <%= "is-picked" if answer&.option_id == option.id %>"
+                        disabled>
+                  <span class="play-option__letter"><%= ("A".ord + index).chr %></span>
+                  <span class="play-option__title"><%= option.text %></span>
+                  <% if answer&.option_id == option.id %>
+                    <span class="play-option__mark">Your answer</span>
+                  <% end %>
+                </button>
+              <% end %>
+            </div>
+
+            <% if answer %>
+              <div class="play-status <%= answer.option.correct? ? "play-status--right" : "play-status--wrong" %>"><%= answer.option.correct? ? "Correct!" : "Wrong!" %></div>
+            <% else %>
+              <div class="play-status play-status--neutral">No answer</div>
+            <% end %>
+          </section>
+        <% end %>
+      <% end %>
+    <% else %>
+      <section>
+        <h1 class="play-title">Join the quiz</h1>
+        <% if @join_error %>
+          <div class="errors"><%= @join_error %></div>
+        <% end %>
+        <%= form_with url: join_play_path(join_code: @game.join_code), method: :post, scope: :player, local: true, html: { class: "join-form" } do |form| %>
+          <label for="player_name">Your name</label>
+          <input class="input" id="player_name" name="player[name]" type="text" placeholder="Your name" autocomplete="name" required>
+          <button type="submit" class="btn btn--pink">Join</button>
+        <% end %>
+      </section>
+    <% end %>
+  </div>
+</main>
