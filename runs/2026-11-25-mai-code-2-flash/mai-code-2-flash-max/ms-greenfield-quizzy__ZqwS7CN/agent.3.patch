diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..8f012af
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,219 @@
+class PlayController < ApplicationController
+  before_action :set_game
+
+  def show
+    if @game.ended?
+      @mode = :ended
+      render :show
+      return
+    end
+
+    @player = remembered_player
+    if @player
+      @join_error = nil
+    else
+      @join_error = nil
+    end
+
+    render :show
+  end
+
+  def join
+    if @game.ended?
+      render_ended
+      return
+    end
+
+    @player = remembered_player
+    unless @player
+      name = params.dig(:player, :name)
+      name = params[:name] if name.nil?
+      name = name.to_s.strip
+
+      if name.blank?
+        @join_error = "Enter your name"
+        @player = nil
+        render :show, status: :unprocessable_entity
+        return
+      end
+
+      @player = @game.players.create!(name: name)
+      remember_player(@player)
+    end
+
+    redirect_to play_path(join_code: @game.join_code)
+  end
+
+  def answer
+    unless request.format.json? || request.headers["Accept"].to_s.include?("application/json")
+      answer_question
+      return
+    end
+
+    answer_question
+  end
+
+  def state
+    player = remembered_player
+    render json: player_state(player)
+  end
+
+  private
+
+  def set_game
+    code = params[:join_code].to_s
+    @game = Game.includes(:quiz, :players, :answers, :current_question).find_by("LOWER(join_code) = ?", code.downcase)
+    raise ActiveRecord::RecordNotFound unless @game
+  end
+
+  def remembered_player
+    token = player_cookie_map[@game.join_code]
+    token ||= player_cookie_map[@game.id.to_s]
+    return nil if token.blank?
+
+    @game.players.find_by(token: token)
+  end
+
+  def player_cookie_map
+    raw = cookies.signed[:quizzy_players]
+    parsed = raw.present? ? JSON.parse(raw) : {}
+    parsed.is_a?(Hash) ? parsed : {}
+  rescue JSON::ParserError
+    {}
+  end
+
+  def remember_player(player)
+    map = player_cookie_map
+    map[@game.join_code] = player.token
+    map[@game.id.to_s] = player.token
+    cookies.signed[:quizzy_players] = {
+      value: map.to_json,
+      expires: 1.year.from_now,
+      httponly: true,
+      same_site: :lax
+    }
+  end
+
+  def answer_question
+    if @game.ended?
+      return render(json: { status: "ended" }, status: :unprocessable_entity) if json_request?
+
+      render_ended
+      return
+    end
+
+    player = remembered_player
+    unless player
+      return render(json: { error: "Join the quiz first" }, status: :unauthorized) if json_request?
+
+      redirect_to play_path(join_code: @game.join_code)
+      return
+    end
+
+    unless @game.open? && @game.current_question
+      return render(json: { status: @game.status }, status: :unprocessable_entity) if json_request?
+
+      redirect_to play_path(join_code: @game.join_code)
+      return
+    end
+
+    option_id = params[:option_id]
+    option_id = params.dig(:answer, :option_id) if option_id.nil?
+    option_id = params[:option] if option_id.nil?
+
+    option = @game.current_question.ordered_options.find_by(id: option_id)
+    unless option
+      return render(json: { error: "Choose a valid option" }, status: :unprocessable_entity) if json_request?
+
+      redirect_to play_path(join_code: @game.join_code)
+      return
+    end
+
+    answer = @game.answers.find_or_initialize_by(player: player, question: @game.current_question)
+    answer.option = option
+    answer.game = @game
+
+    unless answer.save
+      return render(json: { error: answer.errors.full_messages.to_sentence }, status: :unprocessable_entity) if json_request?
+
+      redirect_to play_path(join_code: @game.join_code)
+      return
+    end
+
+    if json_request?
+      render json: player_state(player)
+    else
+      redirect_to play_path(join_code: @game.join_code)
+    end
+  end
+
+  def json_request?
+    request.format.json? || request.xhr? || request.headers["Accept"].to_s.include?("application/json")
+  end
+
+  def render_ended
+    @mode = :ended
+    render :show
+  end
+
+  def player_state(player)
+    state = {
+      status: @game.status,
+      join_url: "#{request.base_url}#{play_path(join_code: @game.join_code)}",
+      player_count: @game.players.count
+    }
+
+    if player
+      state[:player_name] = player.name
+    end
+
+    if @game.ended?
+      state[:status] = "ended"
+      return state
+    end
+
+    if [ "lobby", "open", "closed" ].include?(@game.status)
+      if @game.lobby?
+        state[:waiting] = true
+        return state
+      end
+
+      question = @game.current_question
+      if question
+        number = @game.current_question_number
+        total = @game.active_question_count
+        answer = player ? @game.answers.find_by(player: player, question: question) : nil
+
+        state[:question] = {
+          id: question.id,
+          text: question.text,
+          number: number,
+          total: total
+        }
+
+        state[:question][:answer_url] = answer_play_path(join_code: @game.join_code)
+        state[:question][:selected_option_id] = answer.option_id if answer
+
+        state[:question][:options] = question.ordered_options.map do |option|
+          row = { id: option.id, text: option.text }
+
+          if @game.closed?
+            row[:correct] = option.correct?
+          end
+
+          row
+        end
+
+        if @game.closed?
+          if answer
+            state[:question][:result] = answer.option.correct? ? "correct" : "wrong"
+          else
+            state[:question][:result] = "none"
+          end
+        end
+      end
+    end
+
+    state
+  end
+end
diff --git a/app/javascript/controllers/live_game_controller.js b/app/javascript/controllers/live_game_controller.js
new file mode 100644
index 0000000..306a00f
--- /dev/null
+++ b/app/javascript/controllers/live_game_controller.js
@@ -0,0 +1,151 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["body", "controls", "playerCount", "joinUrl"]
+
+  connect() {
+    this.status = null
+    this.timer = window.setInterval(() => this.refresh(), 1500)
+    this.refresh()
+  }
+
+  disconnect() {
+    if (this.timer) window.clearInterval(this.timer)
+  }
+
+  async refresh() {
+    try {
+      const response = await fetch(this.urlValue, {
+        headers: { Accept: "application/json" },
+        cache: "no-store"
+      })
+      if (!response.ok) return
+      const state = await response.json()
+      this.applyState(state)
+    } catch (_error) {
+      // Keep the last rendered state when the connection is temporarily unavailable.
+    }
+  }
+
+  async act(event) {
+    event.preventDefault()
+    const form = event.currentTarget
+
+    try {
+      const response = await fetch(form.action, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "X-CSRF-Token": this.csrfToken()
+        },
+        body: new FormData(form),
+        cache: "no-store"
+      })
+
+      if (!response.ok) return
+      const state = await response.json()
+      this.applyState(state)
+    } catch (_error) {
+      form.submit()
+    }
+  }
+
+  applyState(state) {
+    if (this.hasPlayerCountTarget) {
+      this.playerCountTarget.textContent = "Players: " + state.player_count
+    }
+
+    if (state.status === "lobby") {
+      this.status = "lobby"
+      return
+    }
+
+    if (state.status === "ended") {
+      this.status = "ended"
+      this.bodyTarget.innerHTML = '<section class="result-card"><h1>The quiz is over</h1></section>'
+      this.controlsTarget.innerHTML = '<a href="' + this.escape(state.quiz_url) + '">← Back to quiz</a>'
+      if (this.timer) window.clearInterval(this.timer)
+      return
+    }
+
+    if (!state.question) return
+
+    if (state.status === "open") {
+      this.status = "open"
+      const question = state.question
+      let options = ""
+
+      question.options.forEach((option, index) => {
+        options += '<li class="stage-option">' +
+          '<span class="stage-option__letter">' + this.letter(index) + '</span>' +
+          '<span class="stage-option__title">' + this.escape(option.text) + '</span>' +
+          '</li>'
+      })
+
+      this.bodyTarget.innerHTML = '<section class="stage-question">' +
+        '<div class="stage-question__num">Question ' + question.number + ' of ' + question.total + '</div>' +
+        '<div class="stage-question__body">' + this.escape(question.text) + '</div>' +
+        '<ul class="stage-options">' + options + '</ul>' +
+        '</section>'
+
+      this.controlsTarget.innerHTML = '<div class="answers-counter">Answers: ' + question.answer_count + ' / ' + state.player_count + '</div>' +
+        this.actionForm(state.action_urls.finish, "Finish")
+      return
+    }
+
+    if (state.status === "closed") {
+      this.status = "closed"
+      const question = state.question
+      let options = ""
+
+      question.options.forEach((option, index) => {
+        const correctClass = option.correct ? " is-correct" : ""
+        const correctMark = option.correct ? '<span class="stage-option__mark">Correct</span>' : ""
+        const count = option.answer_count || 0
+        options += '<li class="stage-option' + correctClass + '">' +
+          '<span class="stage-option__letter">' + this.letter(index) + '</span>' +
+          '<span class="stage-option__title">' + this.escape(option.text) + '</span>' +
+          correctMark +
+          '<span class="stage-option__count">' + count + ' answer' + (count === 1 ? '' : 's') + '</span>' +
+          '</li>'
+      })
+
+      this.bodyTarget.innerHTML = '<section class="stage-question">' +
+        '<div class="stage-question__num">Question ' + question.number + ' of ' + question.total + '</div>' +
+        '<div class="stage-question__body">' + this.escape(question.text) + '</div>' +
+        '<ul class="stage-options stage-options--results">' + options + '</ul>' +
+        '</section>'
+
+      const lastQuestion = question.number === question.total
+      const actionUrl = lastQuestion ? state.action_urls.end_quiz : state.action_urls.next
+      this.controlsTarget.innerHTML = '<a href="' + this.escape(state.quiz_url) + '">← Back to quiz</a>' +
+        this.actionForm(actionUrl, lastQuestion ? "End quiz" : "Next")
+    }
+  }
+
+  actionForm(actionUrl, label) {
+    return '<form action="' + this.escape(actionUrl) + '" method="post" data-action="submit->live-game#act">' +
+      '<input type="hidden" name="authenticity_token" value="' + this.escape(this.csrfToken()) + '">' +
+      '<button type="submit" class="btn btn--pink">' + label + '</button>' +
+      '</form>'
+  }
+
+
+  get urlValue() {
+    return this.element.dataset.liveGameUrlValue
+  }
+
+  csrfToken() {
+    return document.querySelector('meta[name="csrf-token"]')?.content || ''
+  }
+
+  letter(index) {
+    return String.fromCharCode(65 + index)
+  }
+
+  escape(value) {
+    const element = document.createElement("span")
+    element.textContent = value == null ? "" : String(value)
+    return element.innerHTML
+  }
+}
