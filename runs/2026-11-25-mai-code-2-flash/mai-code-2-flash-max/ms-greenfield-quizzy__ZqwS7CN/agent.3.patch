+class Answer < ApplicationRecord
+  belongs_to :game
+  belongs_to :player
+  belongs_to :question
+  belongs_to :option
+
+  validates :game_id, uniqueness: { scope: [ :player_id, :question_id ] }
+  validate :answer_matches_game_and_question
+
+  private
+
+  def answer_matches_game_and_question
+    if player && player.game_id != game_id
+      errors.add(:player, "must belong to this game")
+    end
+    if question && !game&.active_questions&.any? { |item| item.id == question_id }
+      errors.add(:question, "is not an active question in this game")
+    end
+    if option && option.question_id != question_id
+      errors.add(:option, "must belong to this question")
+    end
+  end
+end
diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..3fe7dd7
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,134 @@
+require "securerandom"
+
+class Game < ApplicationRecord
+  belongs_to :quiz
+  belongs_to :current_question, class_name: "Question", optional: true
+
+  has_many :players, dependent: :destroy
+  has_many :answers, dependent: :destroy
+
+  validates :join_code, presence: true, uniqueness: true
+  validates :status, inclusion: { in: %w[lobby open closed ended] }
+
+  before_validation :generate_join_code, on: :create
+  before_validation :snapshot_active_questions, on: :create
+
+  def lobby?; status == "lobby"; end
+  def open?; status == "open"; end
+  def closed?; status == "closed"; end
+  def ended?; status == "ended"; end
+
+  def waiting?; lobby?; end
+  def question_open?; open?; end
+  def question_closed?; closed?; end
+  def finished?; ended?; end
+  def running?; open? || closed?; end
+
+  def active_questions
+    if lobby?
+      return quiz.ordered_questions.where(active: true).includes(:options).to_a
+    end
+
+    snapshot = Array(question_ids).map(&:to_i).select(&:positive?)
+    if snapshot.any?
+      by_id = quiz.ordered_questions.where(id: snapshot, active: true).includes(:options).index_by(&:id)
+      snapshot.filter_map { |id| by_id[id] }
+    else
+      quiz.ordered_questions.where(active: true).includes(:options).to_a
+    end
+  end
+
+  def current_question_number
+    return nil unless current_question
+
+    index = active_questions.index { |question| question.id == current_question.id }
+    index ? index + 1 : nil
+  end
+
+  def active_question_count
+    active_questions.length
+  end
+
+  def start!
+    return unless lobby?
+
+    transaction do
+      questions = quiz.ordered_questions.where(active: true).includes(:options).to_a
+      self.question_ids = questions.map(&:id)
+
+      if questions.empty?
+        update!(status: "ended", current_question: nil, question_ids: [])
+      else
+        update!(status: "open", current_question: questions.first, question_ids: questions.map(&:id))
+      end
+    end
+  end
+  alias start_game! start!
+
+  def finish!
+    update!(status: "closed") if open?
+  end
+  alias finish_question! finish!
+  alias close! finish!
+  alias close_question! finish!
+
+  def next!
+    return unless closed?
+
+    questions = active_questions
+    index = questions.index { |question| question.id == current_question_id }
+
+    if index && index < questions.length - 1
+      update!(status: "open", current_question: questions[index + 1])
+    else
+      end_quiz!
+    end
+  end
+  alias next_question! next!
+  alias advance! next!
+
+  def end_quiz!
+    update!(status: "ended", current_question: nil)
+  end
+  alias end_game! end_quiz!
+  alias end! end_quiz!
+
+  def last_question?
+    return false unless current_question
+
+    active_questions.last&.id == current_question.id
+  end
+
+  def answer_count_for_question(question = current_question)
+    return 0 unless question
+
+    answers.where(question: question).distinct.count(:player_id)
+  end
+
+  def option_answer_counts(question = current_question)
+    return {} unless question
+
+    answers.where(question: question).group(:option_id).count
+  end
+
+  private
+
+  def generate_join_code
+    return if join_code.present?
+
+    alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+    loop do
+      candidate = Array.new(6) { alphabet[SecureRandom.random_number(alphabet.length)] }.join
+      unless self.class.exists?(join_code: candidate)
+        self.join_code = candidate
+        break
+      end
+    end
+  end
+
+  def snapshot_active_questions
+    return unless quiz
+
+    self.question_ids = quiz.ordered_questions.where(active: true).pluck(:id) if new_record?
+  end
+end
