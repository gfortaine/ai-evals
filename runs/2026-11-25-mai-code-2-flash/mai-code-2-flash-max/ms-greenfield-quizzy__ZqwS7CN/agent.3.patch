diff --git a/test/integration/live_game_test.rb b/test/integration/live_game_test.rb
new file mode 100644
index 0000000..e03d294
--- /dev/null
+++ b/test/integration/live_game_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class LiveGameTest < ActionDispatch::IntegrationTest
+  setup do
+    @old_username = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @old_password = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+
+    @quiz = Quiz.create!(title: "Live Conference Quiz")
+
+    @first = @quiz.questions.create!(text: "First active question", active: true, position: 1,
+      option_rows: [ { text: "Alpha", correct: true }, { text: "Beta", correct: false } ])
+    @first.replace_options!(@first.option_rows)
+
+    @inactive = @quiz.questions.create!(text: "Inactive question", active: false, position: 2,
+      option_rows: [ { text: "Hidden", correct: true }, { text: "Skip", correct: false } ])
+    @inactive.replace_options!(@inactive.option_rows)
+
+    @last = @quiz.questions.create!(text: "Last active question", active: true, position: 3,
+      option_rows: [ { text: "Yes", correct: false }, { text: "No", correct: true } ])
+    @last.replace_options!(@last.option_rows)
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @old_username
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @old_password
+  end
+
+  test "moderator starts a game and advances only active questions" do
+    post moderate_quiz_games_path(@quiz), headers: auth_headers
+    assert_redirected_to %r{/moderate/games/\d+}
+
+    game = @quiz.games.order(created_at: :desc).first
+    assert_equal "lobby", game.status
+
+    get moderate_game_path(game), headers: auth_headers
+    assert_response :success
+    assert_includes response.body, "Live Conference Quiz"
+    assert_includes response.body, "/play/#{game.join_code}"
+    assert_includes response.body, "Players: 0"
+    assert_includes response.body, "Start"
+    assert_select "svg", minimum: 1
+
+    post start_moderate_game_path(game), headers: auth_headers.merge("HTTP_ACCEPT" => "application/json")
+    assert_response :success
+    game.reload
+    assert_equal "open", game.status
+    assert_equal @first.id, game.current_question_id
+
+    state = JSON.parse(response.body)
+    assert_equal "open", state["status"]
+    assert_equal "Question 1 of 2", "Question #{state["question"]["number"]} of #{state["question"]["total"]}"
+    assert_not_includes response.body, '"correct"'
+
+    post finish_moderate_game_path(game), headers: auth_headers.merge("HTTP_ACCEPT" => "application/json")
+    assert_response :success
+    game.reload
+    assert_equal "closed", game.status
+
+    post next_moderate_game_path(game), headers: auth_headers.merge("HTTP_ACCEPT" => "application/json")
+    assert_response :success
+    game.reload
+    assert_equal "open", game.status
+    assert_equal @last.id, game.current_question_id
+
+    get moderate_game_path(game), headers: auth_headers
+    assert_response :success
+    assert_includes response.body, "Question 2 of 2"
+    assert_includes response.body, "Last active question"
+    assert_not_includes response.body, "Inactive question"
+
+    post finish_moderate_game_path(game), headers: auth_headers.merge("HTTP_ACCEPT" => "application/json")
+    assert_response :success
+
+    post end_quiz_moderate_game_path(game), headers: auth_headers.merge("HTTP_ACCEPT" => "application/json")
+    assert_response :success
+    game.reload
+    assert_equal "ended", game.status
+
+    get moderate_game_path(game), headers: auth_headers
+    assert_includes response.body, "The quiz is over"
+  end
+
+  test "players join remember themselves answer and receive finish results" do
+    game = @quiz.games.create!
+
+    post join_play_path(join_code: game.join_code), params: { player: { name: "Alice" } }
+    assert_redirected_to play_path(join_code: game.join_code)
+
+    get play_path(join_code: game.join_code)
+    assert_response :success
+    assert_includes response.body, "Hi, Alice!"
+
+    game.start!
+
+    get play_path(join_code: game.join_code)
+    assert_response :success
+    assert_includes response.body, "First active question"
+    assert_not_includes response.body, "Your answer"
+    assert_not_includes response.body, "Correct!"
+
+    alpha = @first.ordered_options.find_by!(text: "Alpha")
+    beta = @first.ordered_options.find_by!(text: "Beta")
+
+    post answer_play_path(join_code: game.join_code), params: { option_id: beta.id }
+    assert_redirected_to play_path(join_code: game.join_code)
+
+    post answer_play_path(join_code: game.join_code), params: { option_id: alpha.id }
+    assert_redirected_to play_path(join_code: game.join_code)
+
+    player = game.players.find_by!(name: "Alice")
+    answer = game.answers.find_by!(player: player, question: @first)
+    assert_equal alpha.id, answer.option_id
+
+    get play_state_path(join_code: game.join_code)
+    state = JSON.parse(response.body)
+    assert_not_includes state["question"]["options"].first.keys, "correct"
+
+    game.finish!
+
+    get play_path(join_code: game.join_code)
+    assert_includes response.body, "Correct!"
+    assert_includes response.body, "Your answer"
+
+    game.end_quiz!
+
+    get play_path(join_code: game.join_code)
+    assert_includes response.body, "The quiz is over"
+    assert_not_includes response.body, "Join"
+
+    post join_play_path(join_code: game.join_code), params: { player: { name: "Intruder" } }
+    assert_includes response.body, "The quiz is over"
+  end
+
+  test "finish has answer totals and no answer result" do
+    game = @quiz.games.create!
+    player = game.players.create!(name: "Solo")
+
+    game.start!
+    game.finish!
+
+    get play_path(join_code: game.join_code)
+    assert_response :success
+  end
+
+  private
+
+  def auth_headers(username = "moderator", password = "secret")
+    {
+      "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+    }
+  end
+end
