--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,123 @@
+class Moderate::GamesController < Moderate::BaseController
+  before_action :set_game, except: [ :create ]
+
+  def create
+    quiz = Quiz.find(params[:quiz_id] || params[:id])
+    game = quiz.games.create!
+    redirect_to moderate_game_path(game)
+  end
+
+  def show
+    @join_url = join_url_for(@game)
+    @qr_svg = RQRCode::QRCode.new(@join_url).as_svg(
+      module_size: 7,
+      standalone: true,
+      use_path: true,
+      viewbox: true
+    )
+  end
+
+  def screen
+    show
+  end
+
+  def start
+    @game.start!
+    respond_action
+  end
+
+  def finish
+    @game.finish!
+    respond_action
+  end
+
+  def next
+    @game.next!
+    respond_action
+  end
+
+  def end_quiz
+    @game.end_quiz!
+    respond_action
+  end
+
+  alias start_question start
+  alias finish_question finish
+  alias next_question next
+  alias end_game end_quiz
+  alias end end_quiz
+
+  def state
+    render json: moderator_state
+  end
+
+  private
+
+  def set_game
+    @game = Game.includes(:quiz, :players, :answers, :current_question).find(params[:id])
+  end
+
+  def join_url_for(game)
+    "#{request.base_url}#{play_path(join_code: game.join_code)}"
+  end
+
+  def respond_action
+    if json_request?
+      render json: moderator_state
+    else
+      redirect_to moderate_game_path(@game)
+    end
+  end
+
+  def json_request?
+    request.format.json? || request.xhr? || request.headers["Accept"].to_s.include?("application/json")
+  end
+
+  def moderator_state
+    question = @game.current_question
+    player_count = @game.players.count
+
+    state = {
+      status: @game.status,
+      quiz_title: @game.quiz.title,
+      join_url: join_url_for(@game),
+      quiz_url: moderate_quiz_path(@game.quiz),
+      player_count: player_count,
+      action_urls: {
+        start: start_moderate_game_path(@game),
+        finish: finish_moderate_game_path(@game),
+        next: next_moderate_game_path(@game),
+        end_quiz: end_quiz_moderate_game_path(@game)
+      }
+    }
+
+    if [ "open", "closed" ].include?(@game.status) && question
+      number = @game.current_question_number
+      total = @game.active_question_count
+      answer_count = @game.answer_count_for_question(question)
+      counts = @game.option_answer_counts(question)
+
+      state[:question] = {
+        id: question.id,
+        text: question.text,
+        number: number,
+        total: total
+      }
+
+      state[:question][:answer_count] = answer_count
+
+      state[:question][:options] = question.ordered_options.map do |option|
+        row = { id: option.id, text: option.text }
+
+        if @game.closed?
+          row[:answer_count] = counts.fetch(option.id, 0)
+          row[:correct] = option.correct?
+        end
+
+        row
+      end
+    end
+
+    state
+  end
+end
