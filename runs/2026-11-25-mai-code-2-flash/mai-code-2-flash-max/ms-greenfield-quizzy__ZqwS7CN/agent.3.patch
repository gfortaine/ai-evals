--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  test "a game snapshots and skips inactive questions" do
+    quiz = Quiz.create!(title: "Game model quiz")
+    active = quiz.questions.create!(text: "Active", active: true, position: 1,
+      option_rows: [ { text: "A", correct: true }, { text: "B", correct: false } ])
+    active.replace_options!(active.option_rows)
+
+    inactive = quiz.questions.create!(text: "Inactive", active: false, position: 2,
+      option_rows: [ { text: "C", correct: true }, { text: "D", correct: false } ])
+    inactive.replace_options!(inactive.option_rows)
+
+    game = Game.create!(quiz: quiz)
+    game.start!
+
+    assert_equal [active.id], game.active_questions.map(&:id)
+    assert_equal active.id, game.current_question_id
+  end
+end
