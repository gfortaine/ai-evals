new file mode 100644
index 0000000..0965af8
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,88 @@
+<% content_for :title, "#{@game.quiz.title} · Quizzy" %>
+<main class="screen cover cover--night"
+      data-controller="live-game"
+      data-live-game-url-value="<%= state_moderate_game_path(@game) %>">
+  <div class="screen__top">
+    <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @game.quiz.title %></span>
+  </div>
+
+  <div class="screen__body" data-live-game-target="body">
+    <% if @game.lobby? %>
+      <div class="lobby">
+        <div>
+          <h1 class="lobby__title"><%= @game.quiz.title %></h1>
+          <div class="lobby__join">Join at</div>
+          <div class="lobby__url" data-live-game-target="joinUrl"><%= @join_url %></div>
+          <div class="counter-pill" data-live-game-target="playerCount">Players: <%= @game.players.count %></div>
+        </div>
+        <div class="qr" aria-label="QR code for join link" title="Join <%= @join_url %>"><%= raw @qr_svg %></div>
+      </div>
+    <% elsif @game.open? %>
+      <% question = @game.current_question %>
+      <% if question %>
+        <section class="stage-question">
+          <div class="stage-question__num">Question <%= @game.current_question_number %> of <%= @game.active_question_count %></div>
+          <div class="stage-question__body"><%= question.text %></div>
+          <ul class="stage-options">
+            <% question.ordered_options.each_with_index do |option, index| %>
+              <li class="stage-option">
+                <span class="stage-option__letter"><%= ("A".ord + index).chr %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+              </li>
+            <% end %>
+          </ul>
+        </section>
+      <% end %>
+    <% elsif @game.closed? %>
+      <% question = @game.current_question %>
+      <% if question %>
+        <% counts = @game.option_answer_counts(question) %>
+        <section class="stage-question">
+          <div class="stage-question__num">Question <%= @game.current_question_number %> of <%= @game.active_question_count %></div>
+          <div class="stage-question__body"><%= question.text %></div>
+          <ul class="stage-options stage-options--results">
+            <% question.ordered_options.each_with_index do |option, index| %>
+              <li class="stage-option <%= "is-correct" if option.correct? %>">
+                <span class="stage-option__letter"><%= ("A".ord + index).chr %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <% if option.correct? %>
+                  <span class="stage-option__mark">Correct</span>
+                <% end %>
+                <span class="stage-option__count"><%= counts.fetch(option.id, 0) %> answer<%= "s" unless counts.fetch(option.id, 0) == 1 %></span>
+              </li>
+            <% end %>
+          </ul>
+        </section>
+      <% end %>
+    <% else %>
+      <section class="result-card">
+        <h1>The quiz is over</h1>
+      </section>
+    <% end %>
+  </div>
+
+  <div class="screen-controls" data-live-game-target="controls">
+    <% if @game.lobby? %>
+      <%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz) %>
+      <form action="<%= start_moderate_game_path(@game) %>" method="post" data-action="submit->live-game#act">
+        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
+        <button type="submit" class="btn btn--pink">Start</button>
+      </form>
+    <% elsif @game.open? %>
+      <div class="answers-counter">Answers: <%= @game.answer_count_for_question %> / <%= @game.players.count %></div>
+      <form action="<%= finish_moderate_game_path(@game) %>" method="post" data-action="submit->live-game#act">
+        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
+        <button type="submit" class="btn btn--pink">Finish</button>
+      </form>
+    <% elsif @game.closed? %>
+      <%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz) %>
+      <form action="<%= @game.last_question? ? end_quiz_moderate_game_path(@game) : next_moderate_game_path(@game) %>" method="post" data-action="submit->live-game#act">
+        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
+        <button type="submit" class="btn btn--pink"><%= @game.last_question? ? "End quiz" : "Next" %></button>
+      </form>
+    <% else %>
+      <%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz) %>
+    <% end %>
+  </div>
+</main>
