+
+      grants.each_with_index do |grant, index|
+        return index unless Access.levels.key?(grant[:level])
+
+        user_id = grant[:user_id]
+        if existing_user_ids.include?(user_id) || seen_user_ids.include?(user_id)
+          return index
+        end
+
+        unless valid_user_ids.include?(user_id)
+          access = @book.accesses.build(user_id: user_id, level: grant[:level])
+          access.valid?
+          raise ActiveRecord::RecordInvalid.new(access)
+        end
+
+        seen_user_ids.add(user_id)
+      end
+
+      nil
+    end
