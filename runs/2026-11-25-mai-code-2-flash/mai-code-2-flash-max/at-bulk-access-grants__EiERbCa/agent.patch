diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..e856e61
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  test "imports all grants and enqueues notifications" do
+    book = Book.create!(title: "Roster", everyone_access: false)
+
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, [
+        { user_id: users(:jz).id, level: :reader },
+        { user_id: users(:kevin).id, level: :editor }
+      ]).import
+
+      assert_nil result.duplicate_index
+      assert_equal 2, result.accesses.length
+      assert result.accesses.all?(&:persisted?)
+    end
+
+    assert_equal 2, book.accesses.count
+  end
+
+  test "rejects an existing duplicate without inserting or notifying" do
+    book = Book.create!(title: "Existing duplicate", everyone_access: false)
+    book.accesses.create!(user: users(:kevin), level: :reader)
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, [
+        { user_id: users(:jz).id, level: :reader },
+        { user_id: users(:kevin).id, level: :editor }
+      ]).import
+
+      assert_equal 1, result.duplicate_index
+      assert_empty result.accesses
+    end
+
+    assert_equal [ users(:kevin).id ], book.accesses.pluck(:user_id)
+  end
+
+  test "rejects a repeated grant without partially inserting or notifying" do
+    book = Book.create!(title: "Repeated grant", everyone_access: false)
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, [
+        { user_id: users(:jz).id, level: :reader },
+        { user_id: users(:jz).id, level: :editor }
+      ]).import
+
+      assert_equal 1, result.duplicate_index
+      assert_empty result.accesses
+    end
+
+    assert_empty book.accesses
+  end
+
+  test "rejects an unknown level without partially inserting or notifying" do
+    book = Book.create!(title: "Unknown level", everyone_access: false)
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, [
+        { user_id: users(:jz).id, level: :reader },
+        { user_id: users(:kevin).id, level: :owner }
+      ]).import
+
+      assert_equal 1, result.duplicate_index
+      assert_empty result.accesses
+    end
+
+    assert_empty book.accesses
+  end
+
+  test "uses one access insert for small and large rosters" do
+    extra_users = 12.times.map do |index|
+      User.create!(
+        name: "Roster #{index}",
+        email_address: "roster#{index}@example.com",
+        password: "secret123456"
+      )
+    end
+    roster = [ users(:david), users(:jason), users(:jz), users(:kevin), *extra_users ]
+
+    small_book = Book.create!(title: "Small roster", everyone_access: false)
+    small_insert_count = count_access_inserts do
+      Book::AccessImport.new(small_book, roster.first(4).map { |user| { user_id: user.id, level: :reader } }).import
+    end
+
+    large_book = Book.create!(title: "Large roster", everyone_access: false)
+    large_insert_count = count_access_inserts do
+      Book::AccessImport.new(large_book, roster.map { |user| { user_id: user.id, level: :reader } }).import
+    end
+
+    assert_equal 1, small_insert_count
+    assert_equal 1, large_insert_count
+  end
+
+  private
+    def count_access_inserts
+      count = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_name, _started, _finished, _unique_id, payload|
+        count += 1 if payload[:sql].include?("INSERT INTO \"accesses\"")
+      end
+
+      begin
+        yield
+      ensure
+        ActiveSupport::Notifications.unsubscribe(subscriber)
+      end
+
+      count
+    end
+end
