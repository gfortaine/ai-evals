+++ b/app/channels/being_edited_channel.rb
@@ -0,0 +1,21 @@
+class BeingEditedChannel < ApplicationCable::Channel
+  extend Turbo::Streams::Broadcasts, Turbo::Streams::StreamName
+  include Turbo::Streams::StreamName::ClassMethods
+
+  def subscribed
+    if (stream_name = verified_stream_name_from_params) && subscription_authorized?(stream_name)
+      stream_from stream_name
+    else
+      reject
+    end
+  end
+
+  private
+    def subscription_authorized?(stream_name)
+      if leaf = Leaf.active.find_by(id: params[:leaf_id])
+        leaf.book.editable?(user: current_user) &&
+          (leaf.book.accessable?(user: current_user) || leaf.book.published?) &&
+          stream_name == self.class.send(:stream_name_from, [ leaf, :being_edited, current_user ])
+      end
+    end
+end
diff --git a/app/controllers/leafables_controller.rb b/app/controllers/leafables_controller.rb
index c1aa391..534daa4 100644
--- a/app/controllers/leafables_controller.rb
+++ b/app/controllers/leafables_controller.rb
@@ -67,7 +67,22 @@ class LeafablesController < ApplicationController
     end
 
     def broadcast_being_edited_indicator
-      Turbo::StreamsChannel.broadcast_render_later_to @leaf, :being_edited,
-        partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      being_edited_recipients.each do |recipient|
+        Turbo::StreamsChannel.broadcast_render_later_to @leaf, :being_edited, recipient,
+          partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      end
+    end
+
+    def being_edited_recipients
+      recipients = @book.accesses.includes(:user).filter_map do |access|
+        access.user if access.user.active? && (access.editor? || access.user.administrator?)
+      end
+
+      administrator_recipients = User.active.administrator.filter_map do |administrator|
+        administrator if @book.accessable?(user: administrator) || @book.published?
+      end
+
+      recipients.concat administrator_recipients
+      recipients.uniq.delete_if { |recipient| recipient == Current.user }
     end
 end
