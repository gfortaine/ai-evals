diff --git a/test/channels/being_edited_channel_test.rb b/test/channels/being_edited_channel_test.rb
new file mode 100644
index 0000000..c7523bb
--- /dev/null
+++ b/test/channels/being_edited_channel_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class BeingEditedChannelTest < ActionCable::Channel::TestCase
+  tests BeingEditedChannel
+
+  setup do
+    stub_connection current_user: users(:kevin)
+  end
+
+  test "subscribes editors to their private presence stream" do
+    leaf = leaves(:welcome_page)
+    signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, users(:kevin) ])
+
+    subscribe signed_stream_name: signed_stream_name, leaf_id: leaf.id
+
+    assert subscription.confirmed?
+    assert_has_stream BeingEditedChannel.send(:stream_name_from, [ leaf, :being_edited, users(:kevin) ])
+  end
+
+  test "rejects a subscription after the collaborator is removed" do
+    leaf = leaves(:welcome_page)
+    books(:handbook).access_for(user: users(:kevin)).destroy!
+    signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, users(:kevin) ])
+
+    subscribe signed_stream_name: signed_stream_name, leaf_id: leaf.id
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects a subscription after the collaborator is downgraded to reader" do
+    leaf = leaves(:welcome_page)
+    books(:handbook).access_for(user: users(:kevin)).update! level: :reader
+    signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, users(:kevin) ])
+
+    subscribe signed_stream_name: signed_stream_name, leaf_id: leaf.id
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects a removed administrator" do
+    leaf = leaves(:welcome_page)
+    stub_connection current_user: users(:david)
+    books(:handbook).access_for(user: users(:david)).destroy!
+    signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, users(:david) ])
+
+    subscribe signed_stream_name: signed_stream_name, leaf_id: leaf.id
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+end
