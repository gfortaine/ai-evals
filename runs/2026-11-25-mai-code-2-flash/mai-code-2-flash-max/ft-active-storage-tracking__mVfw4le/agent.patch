diff --git a/app/models/concerns/storage_usage_tracking.rb b/app/models/concerns/storage_usage_tracking.rb
new file mode 100644
index 0000000..79b8da7
--- /dev/null
+++ b/app/models/concerns/storage_usage_tracking.rb
@@ -0,0 +1,106 @@
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :recalculate_counted_storage_usage_later
+    after_update :recalculate_counted_storage_usage_later, if: :saved_change_to_blob_id?
+    after_destroy :recalculate_counted_storage_usage_later
+  end
+
+  private
+    def recalculate_counted_storage_usage_later
+      if counted_card_image?
+        recalculate_card_image_usage
+      elsif counted_rich_text_embed?
+        recalculate_rich_text_embed_usage
+      end
+    end
+
+    def counted_card_image?
+      record_type == "Card" && name == "image"
+    end
+
+    def counted_rich_text_embed?
+      record_type == "ActionText::RichText" && name == "embeds"
+    end
+
+    def recalculate_card_image_usage
+      if card = Card.find_by(id: record_id)
+        card.board.recalculate_bytes_used_later
+      elsif account
+        account.recalculate_bytes_used_later
+      end
+    end
+
+    def recalculate_rich_text_embed_usage
+      rich_text = ActionText::RichText.find_by(id: record_id)
+
+      if rich_text
+        case rich_text.record
+        when Board
+          rich_text.record.recalculate_bytes_used_later
+        when Card
+          rich_text.record.board&.recalculate_bytes_used_later
+        when Comment
+          rich_text.record.card&.board&.recalculate_bytes_used_later
+        end
+      elsif account
+        account.recalculate_bytes_used_later
+      end
+    end
+end
+
+module ActiveStorageAttachmentPurgeTracking
+  def delete
+    super
+  ensure
+    recalculate_counted_storage_usage_later
+  end
+
+  def purge
+    super
+  ensure
+    recalculate_counted_storage_usage_later
+  end
+
+  def purge_later
+    super
+  ensure
+    recalculate_counted_storage_usage_later
+  end
+end
+
+module ActiveStorageBlobStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :recalculate_attachments_storage_usage_later, if: :saved_change_to_byte_size?
+  end
+
+  private
+    def recalculate_attachments_storage_usage_later
+      boards = []
+
+      ActiveStorage::Attachment.where(account_id: account_id, blob_id: id).find_each do |attachment|
+        if attachment.record_type == "Card" && attachment.name == "image"
+          if card = Card.find_by(id: attachment.record_id)
+            boards << card.board
+          end
+        elsif attachment.record_type == "ActionText::RichText" && attachment.name == "embeds"
+          if rich_text = ActionText::RichText.find_by(id: attachment.record_id)
+            case rich_text.record
+            when Board
+              boards << rich_text.record
+            when Card
+              boards << rich_text.record.board
+            when Comment
+              boards << rich_text.record.card&.board
+            end
+          end
+        end
+      end
+
+      boards.compact.uniq(&:id).each(&:recalculate_bytes_used_later)
+      account&.recalculate_bytes_used_later
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..069e373
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,62 @@
+class StorageUsage
+  class << self
+    def for_account(account)
+      ApplicationRecord.connected_to(role: :writing) do
+        card_ids = Card.where(account_id: account.id).select(:id)
+        board_ids = Board.where(account_id: account.id).select(:id)
+        comment_ids = Comment.where(account_id: account.id).select(:id)
+
+        rich_text_ids = ActionText::RichText
+          .where(account_id: account.id)
+          .where(
+            "(record_type = ? AND record_id IN (?) AND name = ?) OR " \
+            "(record_type = ? AND record_id IN (?) AND name = ?) OR " \
+            "(record_type = ? AND record_id IN (?) AND name = ?)",
+            "Board", board_ids, "public_description",
+            "Card", card_ids, "description",
+            "Comment", comment_ids, "body"
+          )
+          .select(:id)
+
+        counted_blob_ids(account, card_ids, rich_text_ids)
+          .then { |blob_ids| ActiveStorage::Blob.where(account_id: account.id, id: blob_ids).sum(:byte_size).to_i }
+      end
+    end
+
+    def for_board(board)
+      ApplicationRecord.connected_to(role: :writing) do
+        card_ids = Card.where(account_id: board.account_id, board_id: board.id).select(:id)
+        comment_ids = Comment.where(account_id: board.account_id, card_id: card_ids).select(:id)
+
+        rich_text_ids = ActionText::RichText
+          .where(account_id: board.account_id)
+          .where(
+            "(record_type = ? AND record_id = ? AND name = ?) OR " \
+            "(record_type = ? AND record_id IN (?) AND name = ?) OR " \
+            "(record_type = ? AND record_id IN (?) AND name = ?)",
+            "Board", board.id, "public_description",
+            "Card", card_ids, "description",
+            "Comment", comment_ids, "body"
+          )
+          .select(:id)
+
+        counted_blob_ids(board.account, card_ids, rich_text_ids)
+          .then { |blob_ids| ActiveStorage::Blob.where(account_id: board.account_id, id: blob_ids).sum(:byte_size).to_i }
+      end
+    end
+
+    private
+      def counted_blob_ids(account, card_ids, rich_text_ids)
+        ActiveStorage::Attachment
+          .where(account_id: account.id)
+          .where(
+            "(record_type = ? AND name = ? AND record_id IN (?)) OR " \
+            "(record_type = ? AND name = ? AND record_id IN (?))",
+            "Card", "image", card_ids,
+            "ActionText::RichText", "embeds", rich_text_ids
+          )
+          .select(:blob_id)
+          .distinct
+      end
+  end
+end
