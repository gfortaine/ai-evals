diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..3df9a03
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "card image is counted for the board and account" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card.image.attach(blob)
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, board.bytes_used
+    assert_equal blob.byte_size, board.account.bytes_used
+  end
+
+  test "board descriptions card descriptions and comments count embedded blobs once" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    attachment_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    board.update!(public_description: "<p>Board: #{attachment_html}</p>")
+    card.update!(description: "<p>Card: #{attachment_html}</p>")
+    card.comments.create!(body: "<p>Comment: #{attachment_html}</p>")
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, board.bytes_used
+    assert_equal blob.byte_size, board.account.bytes_used
+  end
+
+  test "card images and rich text embeds sharing a blob are counted once" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    attachment_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    card.image.attach(blob)
+    card.update!(description: "<p>Card: #{attachment_html}</p>")
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, board.bytes_used
+    assert_equal blob.byte_size, board.account.bytes_used
+  end
+
+  test "moving a card moves its usage to the destination board" do
+    old_board = boards(:writebook)
+    new_board = boards(:private)
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card.image.attach(blob)
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, old_board.bytes_used
+
+    card.update!(board: new_board)
+    perform_enqueued_jobs
+
+    assert_equal 0, old_board.bytes_used
+    assert_equal blob.byte_size, new_board.bytes_used
+    assert_equal blob.byte_size, card.account.bytes_used
+  end
+
+  test "purging a card image removes it from board and account usage" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card.image.attach(blob)
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, board.bytes_used
+
+    card.image.purge
+    perform_enqueued_jobs
+
+    assert_equal 0, board.bytes_used
+    assert_equal 0, board.account.bytes_used
+  end
+
+test "detaching a card image removes it from board and account usage" do
+  board = boards(:writebook)
+  card = cards(:logo)
+  blob = ActiveStorage::Blob.create_and_upload!(
+    io: file_fixture("moon.jpg").open,
+    filename: "moon.jpg",
+    content_type: "image/jpeg"
+  )
+
+  card.image.attach(blob)
+  perform_enqueued_jobs
+  assert_equal blob.byte_size, board.bytes_used
+
+  card.image.detach
+  perform_enqueued_jobs
+
+  assert_equal 0, board.bytes_used
+  assert_equal 0, board.account.bytes_used
+end
+
+  test "removing an embedded card image removes it from board and account usage" do
+    board = boards(:writebook)
+    card = cards(:logo)
