+class Board::StorageUsageJob < ApplicationJob
+  queue_as :backend
+
+  limits_concurrency key: ->(board) { "board/#{board.id}" }, to: 1, on_conflict: :block
+
+  def perform(board)
+    ApplicationRecord.connected_to(role: :writing) do
+      if board
+        board.recalculate_bytes_used
+        board.account&.recalculate_bytes_used
+      end
+    end
+  end
+end
diff --git a/app/jobs/storage_usage_recalculation_job.rb b/app/jobs/storage_usage_recalculation_job.rb
new file mode 100644
index 0000000..5a89db4
--- /dev/null
+++ b/app/jobs/storage_usage_recalculation_job.rb
@@ -0,0 +1,21 @@
+class StorageUsageRecalculationJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform(batch_size: 500)
+    step :boards do |step|
+      Board.find_each(start: step.cursor, batch_size: batch_size) do |board|
+        board.recalculate_bytes_used
+        step.advance! from: board.id
+      end
+    end
+
+    step :accounts do |step|
+      Account.find_each(start: step.cursor, batch_size: batch_size) do |account|
+        account.recalculate_bytes_used
+        step.advance! from: account.id
+      end
+    end
+  end
+end
