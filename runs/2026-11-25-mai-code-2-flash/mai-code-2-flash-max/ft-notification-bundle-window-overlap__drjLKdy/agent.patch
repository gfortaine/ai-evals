+class NotificationMailer < ApplicationMailer
+  def digest(user = nil, notifications = nil, **options)
+    user ||= options[:user]
+    notifications ||= options[:notifications]
+
+    @user = user
+    @notifications = Array(notifications)
+
+    mail to: user.identity.email_address, subject: digest_subject
+  end
+
+  def notification_digest(user = nil, notifications = nil, **options)
+    user ||= options[:user]
+    notifications ||= options[:notifications]
+
+    @user = user
+    @notifications = Array(notifications)
+
+    mail to: user.identity.email_address, subject: digest_subject
+  end
+
+  private
+    def digest_subject
+      count = @notifications.count
+      "#{count} new notification#{"s" unless count == 1}"
+    end
+end
