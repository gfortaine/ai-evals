new file mode 100644
index 0000000..0e80ca9
--- /dev/null
+++ b/app/models/notification/email_digest.rb
@@ -0,0 +1,156 @@
+class Notification::EmailDigest < ApplicationRecord
+  self.table_name = "notification_email_digests"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, foreign_key: :email_digest_id, inverse_of: :email_digest, dependent: :nullify
+
+  BUNDLE_EMAIL_FREQUENCIES = %w[ never every_few_hours daily weekly ].freeze
+
+  validates :frequency, inclusion: { in: BUNDLE_EMAIL_FREQUENCIES }
+  validates :started_at, :ends_at, presence: true
+
+  scope :open, -> { where.not(open_key: nil).where(sent_at: nil, cancelled_at: nil) }
+  scope :due, ->(now = Time.current) { open.where("ends_at <= ?", now) }
+
+  class << self
+    def duration_for(frequency)
+      case frequency
+      when "every_few_hours" then 4.hours
+      when "daily" then 1.day
+      when "weekly" then 1.week
+      else nil
+      end
+    end
+
+    def open_for(user)
+      open.where(user: user)
+    end
+
+    def bundle(notification, now: Time.current)
+      user = notification.user
+
+      if eligible_for_email?(notification)
+        user.with_lock do
+          settings = user.settings || user.create_settings!
+          frequency = settings.bundle_email_frequency
+
+          if frequency != "never"
+            digest = open_for(user).lock.first
+
+            if digest
+              digest.add_notification(notification)
+            else
+              digest = create!(
+                account: notification.account,
+                user: user,
+                frequency: frequency,
+                started_at: now,
+                ends_at: now + duration_for(frequency)
+              )
+              digest.activate
+              digest.add_notification(notification)
+              Notification::EmailDigestJob.set(wait_until: digest.ends_at).perform_later(digest)
+            end
+
+            digest
+          end
+        end
+      end
+    end
+
+    def bundle_for(notification, now: Time.current)
+      bundle(notification, now: now)
+    end
+
+    def deliver_due(now: Time.current)
+      due(now).find_each do |digest|
+        digest.deliver(now: now)
+      end
+    end
+
+    def send_due(now: Time.current)
+      deliver_due(now: now)
+    end
+
+    private
+      def eligible_for_email?(notification)
+        notification.user.active? &&
+          notification.account.active? &&
+          notification.creator.present? &&
+          !notification.creator.system? &&
+          notification.user.identity.present?
+      end
+  end
+
+  def activate
+    update!(open_key: id)
+  end
+
+  def open?
+    open_key.present? && sent_at.nil? && cancelled_at.nil?
+  end
+
+  def add_notification(notification)
+    if notification.email_digest_id != id
+      notification.update!(email_digest_id: id)
+    end
+
+    notification
+  end
+
+  def update_frequency!(frequency)
+    duration = self.class.duration_for(frequency)
+
+    if duration
+      with_lock do
+        update!(frequency: frequency, ends_at: started_at + duration)
+        Notification::EmailDigestJob.set(wait_until: ends_at).perform_later(self)
+      end
+    end
+  end
+
+  def cancel
+    with_lock do
+      if open?
+        update!(cancelled_at: Time.current, open_key: nil)
+      end
+    end
+  end
+
+  def deliver(now: Time.current)
+    with_lock do
+      if open? && ends_at <= now
+        notifications_for_delivery = notifications.preloaded.ordered.to_a
+
+        if notifications_for_delivery.any? && user.active? && account.active? && user.identity.present?
+          NotificationMailer.digest(user: user, notifications: notifications_for_delivery).deliver_later
+        end
+
+        update!(sent_at: now, open_key: nil)
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def deliver_now
+    with_lock do
+      if open?
+        notifications_for_delivery = notifications.preloaded.ordered.to_a
+
+        if notifications_for_delivery.any? && user.active? && account.active? && user.identity.present?
+          NotificationMailer.digest(user: user, notifications: notifications_for_delivery).deliver_now
+        end
+
+        update!(sent_at: Time.current, open_key: nil)
+        true
+      else
+        false
+      end
+    end
+  end
+end
+
+Notification::EmailBundle = Notification::EmailDigest
