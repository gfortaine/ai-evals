new file mode 100644
index 0000000..db36e4f
--- /dev/null
+++ b/app/jobs/notification/email_digest_job.rb
@@ -0,0 +1,16 @@
+class Notification::EmailDigestJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(digest_or_id, now: nil)
+    digest = if digest_or_id.is_a?(Notification::EmailDigest)
+      digest_or_id
+    else
+      Notification::EmailDigest.find_by(id: digest_or_id)
+    end
+
+    if digest
+      delivery_time = now.present? ? Time.zone.parse(now) : Time.current
+      digest.deliver(now: delivery_time)
+    end
+  end
+end
