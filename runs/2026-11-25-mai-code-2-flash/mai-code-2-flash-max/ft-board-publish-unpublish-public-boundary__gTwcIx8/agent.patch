+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to @board.name, public_board_path(@board.public_key), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="card-perma">
+  <div class="card-perma__bg">
+    <div class="card">
+      <div class="card__body justify-space-between">
+        <div class="card__content">
+          <h1 class="card__title"><%= card_html_title(@card) %></h1>
+          <% unless @card.description.blank? %>
+            <div class="card__description lexxy-content"><%= @card.description %></div>
+          <% end %>
+
+          <% if @card.steps.any? %>
+            <ul>
+              <% @card.steps.each do |step| %>
+                <li><%= step.completed? ? "&#10003;".html_safe : "&#9675;".html_safe %> <%= step.content %></li>
