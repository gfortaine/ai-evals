diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..a6a3815
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,71 @@
+module Board::Publication
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(public_key: nil).where.not(public_key: "") }
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  alias_method :public?, :published?
+
+  def publish
+    if published?
+      self
+    else
+      update!(public_key: generate_public_key)
+      self
+    end
+  end
+
+  def publish!
+    publish
+  end
+
+  def unpublish
+    update!(public_key: nil)
+    self
+  end
+
+  def unpublish!
+    unpublish
+  end
+
+  def public_url
+    Rails.application.routes.url_helpers.public_board_path(public_key, script_name: nil) if published?
+  end
+
+  def publication_key
+    public_key
+  end
+
+  def publication_key=(key)
+    self.public_key = key
+  end
+
+  def public_id
+    public_key
+  end
+
+  def public_id=(id)
+    self.public_key = id
+  end
+
+  def public_token
+    public_key
+  end
+
+  def public_token=(token)
+    self.public_key = token
+  end
+
+  private
+    def generate_public_key
+      loop do
+        key = SecureRandom.base58(24)
+        return key unless self.class.exists?(public_key: key)
+      end
+    end
+end
