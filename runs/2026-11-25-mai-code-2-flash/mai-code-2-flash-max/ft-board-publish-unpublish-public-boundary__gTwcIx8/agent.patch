+            </ul>
+          <% end %>
+        </div>
+      </div>
+
+      <% if @card.tags.any? %>
+        <footer class="card__footer">
+          <% @card.tags.each do |tag| %>
+            <span class="card__tag"><%= tag.title %></span>
+          <% end %>
+        </footer>
+      <% end %>
+
+      <% if @card.comments.any? %>
+        <section class="card__comments">
+          <% @card.comments.chronologically.includes(:creator).each do |comment| %>
+            <div class="comment">
+              <strong><%= comment.creator.name %></strong>
+              <div class="lexxy-content"><%= comment.body %></div>
+            </div>
+          <% end %>
+        </section>
+      <% end %>
+    </div>
+  </div>
+</article>
