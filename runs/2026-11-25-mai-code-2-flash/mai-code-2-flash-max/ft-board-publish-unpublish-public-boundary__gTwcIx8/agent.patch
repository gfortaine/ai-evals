+
+  test "show via route helper regardless of the integration account prefix" do
+    get public_board_path(@board.public_key)
+
+    assert_response :success
+  end
+
+  test "show published board by public key" do
+    get "/public/boards/#{@board.public_key}"
+
+    assert_response :success
+  end
+
+  test "show returns not found after board is unpublished" do
+    key = @board.public_key
+    @board.unpublish
+
+    get "/public/boards/#{key}"
+
+    assert_response :not_found
+  end
+
+  test "show as JSON includes only published cards" do
+    published_card = cards(:logo)
+    draft = @board.cards.create!(creator: users(:kevin), status: :drafted, title: "Private draft")
+
+    get "/public/boards/#{@board.public_key}", as: :json
+
+    assert_response :success
+    numbers = @response.parsed_body["cards"].pluck("number")
+    assert_includes numbers, published_card.number
+    assert_not_includes numbers, draft.number
+  end
+
+  test "invalid public key returns not found" do
+    get "/public/boards/not-a-real-key"
+
+    assert_response :not_found
+  end
+end
