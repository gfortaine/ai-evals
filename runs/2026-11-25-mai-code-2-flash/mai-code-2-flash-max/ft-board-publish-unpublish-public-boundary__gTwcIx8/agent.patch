+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show published card by public board key" do
+    card = cards(:logo)
+
+    get "/public/boards/#{@board.public_key}/cards/#{card.number}"
+
+    assert_response :success
+  end
+
+  test "cannot show drafted card" do
+    draft = @board.cards.create!(creator: users(:kevin), status: :drafted)
+
+    get "/public/boards/#{@board.public_key}/cards/#{draft.number}"
+
+    assert_response :not_found
+  end
+
+  test "cannot show card from another board" do
+    card = cards(:radio)
+    card.update!(number: 999_999)
+
+    get "/public/boards/#{@board.public_key}/cards/#{card.number}"
+
+    assert_response :not_found
+  end
+
+  test "show published card as JSON" do
+    card = cards(:logo)
+
+    get "/public/boards/#{@board.public_key}/cards/#{card.number}", as: :json
+
+    assert_response :success
+    assert_equal card.number, @response.parsed_body["number"]
+    assert_equal public_board_card_url(@board.public_key, card, script_name: nil), @response.parsed_body["url"]
+  end
+end
