diff --git a/saas/app/models/account/card_limited.rb b/saas/app/models/account/card_limited.rb
new file mode 100644
index 0000000..7d38d02
--- /dev/null
+++ b/saas/app/models/account/card_limited.rb
@@ -0,0 +1,97 @@
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  DEFAULT_CARD_LIMIT = 1_000
+  CARD_LIMIT = DEFAULT_CARD_LIMIT
+  FREE_CARD_LIMIT = DEFAULT_CARD_LIMIT
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def effective_card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def card_count_for_limit
+    effective_card_count
+  end
+
+  alias_method :effective_cards_count, :effective_card_count
+  alias_method :card_count, :effective_card_count
+
+  def card_limit
+    if comped? || normalized_paid_plan?
+      nil
+    else
+      DEFAULT_CARD_LIMIT
+    end
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && effective_card_count >= card_limit
+  end
+
+  alias_method :exceeded_card_limit?, :exceeding_card_limit?
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+  alias_method :cards_exhausted?, :exceeding_card_limit?
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && effective_card_count >= card_limit - NEAR_CARD_LIMIT_THRESHOLD
+  end
+
+  alias_method :near_card_limit?, :nearing_card_limit?
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - effective_card_count, 0 ].max
+    end
+  end
+
+  alias_method :remaining_cards, :cards_remaining
+  alias_method :cards_left, :cards_remaining
+  alias_method :remaining_card_count, :cards_remaining
+
+  def add_overridden_limits(card_count: nil, bytes_used: nil)
+    override_limits(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def add_card_count_override(card_count)
+    override_limits(card_count: card_count)
+  end
+
+  def override_card_count(card_count)
+    override_limits(card_count: card_count)
+  end
+
+  def override_bytes_usage(bytes_used)
+    override_limits(bytes_used: bytes_used)
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    limit = overridden_limit || build_overridden_limit
+
+    attributes = {}
+    attributes[:card_count] = card_count unless card_count.nil?
+    attributes[:bytes_used] = bytes_used unless bytes_used.nil?
+    limit.update!(attributes)
+    limit
+  end
+
+  alias_method :set_overrides, :override_limits
+  alias_method :set_overridden_limits, :override_limits
+
+  def reset_overridden_limits
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  alias_method :reset_overrides, :reset_overridden_limits
+  alias_method :reset_override, :reset_overridden_limits
+
+  private
+    def normalized_paid_plan?
+      Subscription.paid_plan_key?(plan)
+    end
+end
