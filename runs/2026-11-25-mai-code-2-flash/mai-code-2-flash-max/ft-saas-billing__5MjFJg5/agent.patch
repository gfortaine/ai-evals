@@ -0,0 +1,32 @@
+class Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_account
+
+  def create
+    if @account.subscription&.stripe_customer_id.present?
+      session = Stripe::BillingPortal::Session.create(
+        customer: @account.subscription.stripe_customer_id,
+        return_url: account_settings_url(script_name: @account.slug)
+      )
+      redirect_to session_url(session), allow_other_host: true
+    else
+      redirect_to account_settings_path, alert: "There is no Stripe billing account for this account yet."
+    end
+  rescue Stripe::StripeError => error
+    Rails.logger.error(error)
+    redirect_to account_settings_path, alert: "We couldn't open the billing portal. Please try again."
+  end
+
+  private
+    def set_account
+      @account = Current.account
+    end
+
+    def session_url(session)
+      if session.respond_to?(:url)
+        session.url
+      else
+        session[:url] || session["url"]
+      end
+    end
+end
