diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..e225bcc
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  teardown do
+    Account::BillingWaiver.delete_all
+    Account::OverriddenLimit.delete_all
+  end
+
+  setup do
+    sign_in_as :david
+  end
+
+  test "staff can list accounts" do
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: accounts(:initech).name
+  end
+
+  test "staff can open an account and comp it" do
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+
+      post saas.comp_admin_account_path(account)
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert account.reload.comped?
+  end
+
+  test "staff can uncomp an account" do
+    account = accounts(:initech)
+    account.comp!
+
+    untenanted do
+      post saas.uncomp_admin_account_path(account)
+    end
+
+    assert_not account.reload.comped?
+  end
+
+  test "staff can override usage and reset the override" do
+    account = accounts(:initech)
+
+    untenanted do
+      patch saas.override_admin_account_path(account), params: {
+        overridden_limit: { card_count: 950, bytes_used: 123_456 }
+      }
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert_equal 950, account.reload.effective_card_count
+    assert_equal 123_456, account.reload.bytes_used
+
+    untenanted do
+      delete saas.reset_admin_account_path(account)
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert_nil account.reload.overridden_limit
+  end
+
+  test "non-staff cannot access account tools" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/billing_controller_test.rb b/saas/test/controllers/billing_controller_test.rb
