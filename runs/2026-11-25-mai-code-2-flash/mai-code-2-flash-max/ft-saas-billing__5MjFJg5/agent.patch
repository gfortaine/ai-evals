diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..51c9056
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,105 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ACTIVE_STATUSES = %w[ active trialing past_due incomplete ].freeze
+  CANCELED_STATUSES = %w[ canceled unpaid incomplete_expired paused inactive ].freeze
+
+  def active?
+    status.blank? || status.in?(ACTIVE_STATUSES)
+  end
+
+  def paid?
+    active? && plan_key.present? && !plan_key.start_with?("Free")
+  end
+
+  def canceled?
+    status.in?(CANCELED_STATUSES)
+  end
+
+  def class_name
+    ::Subscription.normalize_plan_key(plan_key)
+  end
+
+  def plan_name
+    ::Subscription.plan_name(plan_key)
+  end
+
+  def sync_from_stripe(stripe_subscription)
+    object = stripe_subscription
+
+    attributes = {}
+    customer_id = read(object, :customer)
+    customer_id = read(customer_id, :id) if customer_id.respond_to?(:id)
+    attributes[:stripe_customer_id] = customer_id.to_s if customer_id.present?
+
+    subscription_id = read(object, :id)
+    attributes[:stripe_subscription_id] = subscription_id.to_s if subscription_id.present?
+
+    status = read(object, :status)
+    attributes[:status] = status if status.present?
+
+    if status.present? && status.to_s.in?(CANCELED_STATUSES)
+      attributes[:plan_key] = "FreeV1"
+    else
+      attributes[:plan_key] = plan_key_from(stripe_subscription)
+    end
+
+    current_period_end = time_from(read(object, :current_period_end))
+    attributes[:current_period_end] = current_period_end if current_period_end.present?
+
+    cancel_at = time_from(read(object, :cancel_at))
+    attributes[:cancel_at] = cancel_at if cancel_at.present?
+
+    next_amount = integer_from(read(object, :next_amount_due_in_cents))
+    attributes[:next_amount_due_in_cents] = next_amount if next_amount.present?
+
+    update!(attributes)
+  end
+
+  private
+    def plan_key_from(stripe_subscription)
+      metadata = read(stripe_subscription, :metadata)
+      metadata_plan = read(metadata, :plan_key) || read(metadata, :plan)
+      return ::Subscription.normalize_plan_key(metadata_plan) if metadata_plan.present?
+
+      price_ids = []
+      items = read(stripe_subscription, :items)
+      item_data = read(items, :data)
+      item_data ||= (items.is_a?(Array) ? items : [])
+
+      Array(item_data).each do |item|
+        price = read(item, :price)
+        price_id = read(price, :id)
+        price_ids << price_id if price_id.present?
+      end
+
+      extra_price_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      if extra_price_id.present? && price_ids.include?(extra_price_id)
+        "UnlimitedPlusV1"
+      elsif price_ids.present?
+        "UnlimitedV1"
+      else
+        ::Subscription.normalize_plan_key(read(stripe_subscription, :plan_key))
+      end
+    end
+
+    def read(object, key)
+      if object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[])
+        object[key] || object[key.to_s]
+      end
+    end
+
+    def time_from(value)
+      if value.respond_to?(:to_time)
+        value.to_time
+      elsif value.present?
+        Time.at(value.to_i)
+      end
+    end
+
+    def integer_from(value)
+      value.to_i if value.present?
+    end
+end
diff --git a/saas/app/models/subscription.rb b/saas/app/models/subscription.rb
index 5efb1a7..d7cc294 100644
--- a/saas/app/models/subscription.rb
+++ b/saas/app/models/subscription.rb
@@ -1,13 +1,73 @@
 class Subscription < Queenbee::Subscription
-  SHORT_NAMES = %w[ FreeV1 ]
+  SHORT_NAMES = %w[ FreeV1 UnlimitedV1 UnlimitedPlusV1 UnlimitedExtraV1 ].freeze
 
   def self.short_name
     name.demodulize
   end
 
+  def self.normalize_plan_key(plan_key)
+    raw = plan_key.to_s.downcase
+    return "UnlimitedPlusV1" if raw.include?("plus") || raw.include?("extra") || raw.include?("+")
+
+    case raw.gsub(/[^a-z0-9]+/, "")
+    when "free", "freev1", "freev1subscription"
+      "FreeV1"
+    when "unlimited", "unlimitedv1", "unlimitedv1subscription"
+      "UnlimitedV1"
+    else
+      "FreeV1"
+    end
+  end
+
+  def self.plan_name(plan_key)
+    case normalize_plan_key(plan_key)
+    when "UnlimitedPlusV1"
+      "Unlimited+"
+    when "UnlimitedV1"
+      "Unlimited"
+    else
+      "Free"
+    end
+  end
+
+  def self.paid_plan_key?(plan_key)
+    normalize_plan_key(plan_key).in?(%w[ UnlimitedV1 UnlimitedPlusV1 ])
+  end
+
+  def self.storage_limit(plan_key)
+    case normalize_plan_key(plan_key)
+    when "UnlimitedPlusV1"
+      500.gigabytes
+    when "UnlimitedV1"
+      5.gigabytes
+    else
+      1.gigabyte
+    end
+  end
+
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
-    property :price,        0
-    property :frequency,    "yearly"
+    property :proper_name, "Free"
+    property :price, 0
+    property :frequency, "monthly"
+    property :card_limit, 1_000
+    property :storage_limit, 1.gigabyte
+  end
+
+  class UnlimitedV1 < Subscription
+    property :proper_name, "Unlimited"
+    property :price, 20
+    property :frequency, "monthly"
+    property :card_limit, nil
+    property :storage_limit, 5.gigabytes
   end
+
+  class UnlimitedPlusV1 < Subscription
+    property :proper_name, "Unlimited+"
+    property :price, 25
+    property :frequency, "monthly"
+    property :card_limit, nil
+    property :storage_limit, 500.gigabytes
+  end
+
+  UnlimitedExtraV1 = UnlimitedPlusV1
 end
