@@ -0,0 +1,60 @@
+require "test_helper"
+
+class BillingControllerTest < ActionDispatch::IntegrationTest
+  teardown do
+    Account::Subscription.delete_all
+  end
+
+  setup do
+    sign_in_as :mike
+  end
+
+  test "free account settings show its plan and Upgrade" do
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "paid account settings show Manage" do
+    account = accounts(:initech)
+    Account::Subscription.create!(
+      account: account,
+      stripe_customer_id: "cus_manage",
+      plan_key: "UnlimitedV1",
+      status: "active"
+    )
+
+    get account_settings_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited"
+    assert_select "a", text: "Manage"
+  end
+
+  test "checkout redirects to a hosted Stripe session" do
+    session = Struct.new(:url).new("https://checkout.stripe.test/session")
+    Stripe::Checkout::Session.stubs(:create).returns(session)
+
+    post saas.billing_checkouts_path(plan: "Unlimited", script_name: accounts(:initech).slug)
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  end
+
+  test "portal redirects to a hosted Stripe session" do
+    account = accounts(:initech)
+    Account::Subscription.create!(
+      account: account,
+      stripe_customer_id: "cus_portal",
+      plan_key: "UnlimitedV1",
+      status: "active"
+    )
+    session = Struct.new(:url).new("https://billing.stripe.test/session")
+    Stripe::BillingPortal::Session.stubs(:create).returns(session)
+
+    post saas.billing_portals_path(script_name: account.slug)
+
+    assert_redirected_to "https://billing.stripe.test/session"
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..344668e
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  test "cannot create cards via JSON at the card limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can still create draft cards via HTML at the card limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+
+    assert Card.last.drafted?
+  end
+
+  test "cannot publish cards at the card limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "draft footer gives way to Upgrade at the card limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "draft footer counts down from 100 cards left" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select "strong", text: /50 cards left/
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..0a97feb
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+
+  teardown do
+    Account::Subscription.delete_all
+  end
+  test "subscription updates set a paid plan" do
+    account = accounts(:initech)
+
+    payload = {
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_unlimited",
+          customer: "cus_unlimited",
+          status: "active",
+          plan_key: "UnlimitedV1",
+          metadata: { account_id: account.id }
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    account.reload
+    assert_equal "UnlimitedV1", account.subscription.plan_key
+    assert account.paid?
+  end
+
+  test "deleted subscriptions return to Free" do
+    account = accounts(:initech)
+    account.subscription = Account::Subscription.create!(
+      account: account,
+      stripe_customer_id: "cus_free",
+      stripe_subscription_id: "sub_free",
+      plan_key: "UnlimitedV1",
+      status: "active"
+    )
+
+    payload = {
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_free",
+          customer: "cus_free",
+          status: "canceled",
+          metadata: { account_id: account.id }
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    assert_equal "FreeV1", account.reload.plan
+  end
+end
diff --git a/saas/test/models/account/card_limited_test.rb b/saas/test/models/account/card_limited_test.rb
new file mode 100644
index 0000000..6c36447
--- /dev/null
+++ b/saas/test/models/account/card_limited_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Account::CardLimitedTest < ActiveSupport::TestCase
+
+  teardown do
+    Account::BillingWaiver.delete_all
+    Account::OverriddenLimit.delete_all
+  end
+  test "free accounts are limited at 1,000 cards" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 999)
+
+    assert_not account.exceeding_card_limit?
+    assert account.nearing_card_limit?
+    assert_equal 1, account.cards_remaining
+
+    account.update_column(:cards_count, 1_000)
+
+    assert account.exceeding_card_limit?
+    assert_not account.nearing_card_limit?
+    assert_equal 0, account.cards_remaining
+  end
+
+  test "card count overrides the measured card count" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 999)
+    account.override_limits(card_count: 950)
+
+    assert_equal 950, account.effective_card_count
+    assert_equal 50, account.cards_remaining
+
+    account.reset_overridden_limits
+    assert_equal 999, account.effective_card_count
+  end
+
+  test "paid plans have no card limit" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 10_000)
+    account.subscription = Account::Subscription.new(
+      stripe_customer_id: "cus_test",
+      plan_key: "UnlimitedV1",
+      status: "active"
+    )
+
+    assert_not account.exceeding_card_limit?
+    assert_nil account.card_limit
+  end
+
+  test "comped accounts have no card limit" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 10_000)
+    account.comp!
+
+    assert account.comped?
+    assert_not account.exceeding_card_limit?
+    assert_nil account.card_limit
+  end
+end
