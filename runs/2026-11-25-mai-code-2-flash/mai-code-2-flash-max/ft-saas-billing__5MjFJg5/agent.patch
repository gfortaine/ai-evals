diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..ae2db3e
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,53 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+    set_account
+  end
+
+  def comp
+    set_account
+    @account.comp!
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  def uncomp
+    set_account
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  def override
+    set_account
+
+    values = params[:overridden_limit] || params[:override] || params[:account] || params
+    card_count = integer_value(values[:card_count] || values[:cards_count])
+    bytes_used = integer_value(values[:bytes_used])
+
+    @account.override_limits(card_count: card_count, bytes_used: bytes_used)
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  def reset
+    set_account
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id])
+      @account ||= Account.find_by(external_account_id: params[:id])
+      @account ||= Account.find(params[:id])
+    end
+
+    def integer_value(value)
+      Integer(value) if value.present?
+    rescue ArgumentError, TypeError
+      nil
+    end
+end
diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..47cc88c
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,43 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_account
+
+  def create
+    plan_key = Subscription.normalize_plan_key(params[:plan].presence || "UnlimitedV1")
+    line_items = [ { price: ENV["STRIPE_MONTHLY_V1_PRICE_ID"], quantity: 1 } ]
+
+    if plan_key == "UnlimitedPlusV1" && ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].present?
+      line_items << { price: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"], quantity: 1 }
+    end
+
+    session_params = {
+      mode: "subscription",
+      line_items: line_items,
+      success_url: account_settings_url(script_name: @account.slug),
+      cancel_url: account_settings_url(script_name: @account.slug),
+      client_reference_id: @account.external_account_id.to_s,
+      customer: @account.subscription&.stripe_customer_id,
+      customer_email: @account.subscription&.stripe_customer_id ? nil : @account.owner_email,
+      metadata: { account_id: @account.id, external_account_id: @account.external_account_id.to_s, plan_key: plan_key }
+    }.compact
+
+    session = Stripe::Checkout::Session.create(**session_params)
+    redirect_to session_url(session), allow_other_host: true
+  rescue Stripe::StripeError => error
+    Rails.logger.error(error)
+    redirect_to account_settings_path, alert: "We couldn't start checkout. Please try again."
+  end
+
+  private
+    def set_account
+      @account = Current.account
+    end
+
+    def session_url(session)
+      if session.respond_to?(:url)
+        session.url
+      else
+        session[:url] || session["url"]
+      end
+    end
+end
diff --git a/saas/app/controllers/billing/portals_controller.rb b/saas/app/controllers/billing/portals_controller.rb
