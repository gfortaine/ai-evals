diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..39b9249
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,138 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = verify_event
+
+    if event
+      handle_event(event)
+      head :ok
+    else
+      head :bad_request
+    end
+  rescue JSON::ParserError
+    head :bad_request
+  rescue Stripe::StripeError => error
+    Rails.logger.error(error)
+    head :bad_request
+  end
+
+  private
+    def verify_event
+      payload = request.raw_post
+      signature = request.headers["Stripe-Signature"]
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+      if (Rails.env.test? || Rails.env.local?) && signature.blank?
+        JSON.parse(payload)
+      elsif secret.present? || signature.present?
+        Stripe::Webhook.construct_event(payload, signature, secret)
+      elsif Rails.env.test? || Rails.env.local?
+        JSON.parse(payload)
+      else
+        nil
+      end
+    end
+
+    def handle_event(event)
+      type = read(event, :type)
+      object = read(read(event, :data), :object) || read(event, :object)
+
+      case type
+      when "checkout.session.completed"
+        sync_checkout_session(object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        sync_subscription(object)
+      when "invoice.paid", "invoice.payment_failed"
+        sync_invoice(object)
+      end
+    end
+
+    def sync_checkout_session(object)
+      account = find_account(object)
+      return unless account
+
+      subscription_id = read(object, :subscription)
+      subscription_id = read(subscription_id, :id) if subscription_id.respond_to?(:id)
+      subscription_id ||= read(object, :subscription_id)
+
+      customer_id = read(object, :customer)
+      customer_id = read(customer_id, :id) if customer_id.respond_to?(:id)
+
+      subscription = account.subscription || account.build_subscription(stripe_customer_id: customer_id.to_s)
+      subscription.stripe_customer_id = customer_id.to_s if customer_id.present?
+
+      if subscription_id.present?
+        subscription.stripe_subscription_id = subscription_id.to_s
+      end
+
+      metadata = read(object, :metadata)
+      plan_key = read(metadata, :plan_key) || read(metadata, :plan)
+      subscription.plan_key = Subscription.normalize_plan_key(plan_key) if plan_key.present?
+      subscription.status ||= "active"
+      subscription.save!
+
+      if subscription_id.present?
+        sync_subscription_by_id(subscription, subscription_id)
+      end
+    end
+
+    def sync_subscription(object)
+      account = find_account(object)
+      account ||= subscription_account(object)
+      return unless account
+
+      subscription = account.subscription || account.build_subscription(stripe_customer_id: read(object, :customer).to_s)
+      subscription.sync_from_stripe(object)
+      account.reload
+    end
+
+    def sync_subscription_by_id(subscription, subscription_id)
+      return unless subscription.stripe_subscription_id == subscription_id.to_s
+
+      subscription.stripe_subscription_id = subscription_id.to_s
+      subscription.save! if subscription.changed?
+    end
+
+    def sync_invoice(object)
+      customer_id = read(object, :customer)
+      customer_id = read(customer_id, :id) if customer_id.respond_to?(:id)
+
+      subscription = Account::Subscription.find_by(stripe_customer_id: customer_id.to_s) if customer_id.present?
+      return unless subscription
+
+      next_amount = read(object, :amount_due)
+      subscription.update!(next_amount_due_in_cents: next_amount.to_i) if next_amount.present?
+    end
+
+    def find_account(object)
+      metadata = read(object, :metadata)
+      account_id = read(metadata, :account_id)
+      external_account_id = read(metadata, :external_account_id)
+      client_reference_id = read(object, :client_reference_id)
+
+      account = Account.find_by(id: account_id) if account_id.present?
+      account ||= Account.find_by(external_account_id: external_account_id) if external_account_id.present?
+      account ||= Account.find_by(external_account_id: client_reference_id) if client_reference_id.present?
+      account
+    end
+
+    def subscription_account(object)
+      customer_id = read(object, :customer)
+      customer_id = read(customer_id, :id) if customer_id.respond_to?(:id)
+
+      subscription = Account::Subscription.find_by(stripe_subscription_id: read(object, :id))
+      subscription ||= Account::Subscription.find_by(stripe_customer_id: customer_id.to_s) if customer_id.present?
+      subscription&.account
+    end
+
+    def read(object, key)
+      if object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[])
+        object[key] || object[key.to_s]
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..4b776da
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,53 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+  end
+
+  def paid?
+    comped? || active_subscription&.paid?
+  end
+
+  def active_subscription
+    subscription if subscription&.active? && !subscription.canceled?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  alias_method :complementary?, :comped?
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      comp!
+    else
+      uncomp!
+    end
+  end
+
+  def comp!
+    create_billing_waiver! unless billing_waiver
+    association(:billing_waiver).reset
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  alias_method :comp, :comp!
+  alias_method :comped!, :comp!
+  alias_method :uncomped!, :uncomp!
+  alias_method :uncomp, :uncomp!
+
+  def plan_name
+    if comped?
+      "Comped"
+    else
+      Subscription.plan_name(plan)
+    end
+  end
+end
