+require "rails_helper"
+
+RSpec.describe ActiveStorageProfileImage do
+  it "attaches new user profile images to Active Storage" do
+    user = create(:user)
+
+    expect(user.profile_image_active_storage).to be_attached
+    expect(user.profile_image_url).to start_with("/rails/active_storage/")
+  end
+
+  it "attaches new organization profile images to Active Storage" do
+    organization = create(:organization)
+
+    expect(organization.profile_image_active_storage).to be_attached
+    expect(organization.profile_image_url).to start_with("/rails/active_storage/")
+  end
+
+  it "falls back to the existing CarrierWave URL when Active Storage is absent" do
+    user = create(:user)
+    user.profile_image_active_storage.purge
+    user.update_column(:profile_image, "legacy-profile.jpg")
+
+    expect(user.profile_image_url).to include("/uploads/user/profile_image/")
+  end
+end
