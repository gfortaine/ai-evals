new file mode 100644
index 0000000..bf6359a
--- /dev/null
+++ b/app/models/concerns/active_storage_profile_image.rb
@@ -0,0 +1,126 @@
+module ActiveStorageProfileImage
+  extend ActiveSupport::Concern
+
+  # rubocop:disable Metrics/BlockLength
+  included do
+    mount_uploader :profile_image, ProfileImageUploader
+    has_one_attached :profile_image_active_storage
+
+    def profile_image
+      legacy = super
+      return legacy if legacy.present?
+
+      active_storage_profile_image.attached? ? active_storage_profile_image : legacy
+    end
+
+    def profile_image=(value)
+      @profile_image_changed_by_active_storage = true
+
+      if value.blank?
+        super(nil)
+        detach_active_storage_profile_image
+      elsif value.is_a?(String) && value.match?(%r{\Ahttps?://}i)
+        self.remote_profile_image_url = value
+      else
+        super(value)
+        attach_profile_image_upload(value)
+      end
+    end
+
+    def profile_image?
+      profile_image.present?
+    end
+
+    def profile_image_url
+      if active_storage_profile_image.attached?
+        Rails.application.routes.url_helpers.rails_blob_path(active_storage_profile_image.blob, only_path: true)
+      else
+        super
+      end
+    end
+
+    def remote_profile_image_url=(url)
+      @profile_image_changed_by_active_storage = true
+
+      if url.blank?
+        super(nil)
+        detach_active_storage_profile_image
+        return
+      end
+
+      super(url)
+      attach_profile_image_from_url(url)
+    end
+  end
+  # rubocop:enable Metrics/BlockLength
+
+  def active_storage_profile_image
+    @active_storage_profile_image ||= ActiveStorage::Attached::One.new(:profile_image_active_storage, self)
+  end
+
+  def profile_image_upload
+    active_storage_profile_image
+  end
+
+  def profile_image_attachment
+    active_storage_profile_image
+  end
+
+  private
+
+  def attach_profile_image_upload(upload)
+    io, filename, content_type = profile_image_upload_parts(upload)
+    active_storage_profile_image.attach(io: io, filename: filename, content_type: content_type)
+  rescue StandardError => e
+    Rails.logger.warn("Could not attach profile image to Active Storage: #{e.class}: #{e.message}")
+  end
+
+  def attach_profile_image_from_url(url)
+    uri = URI.parse(url)
+    app_host = ENV["APP_DOMAIN"].to_s.split(":").first
+    return if uri.host.blank? || uri.host == app_host
+
+    response = Faraday.get(url)
+    return unless response.status.between?(200, 299)
+
+    uri = URI.parse(url)
+    filename = File.basename(uri.path).presence || "profile-image"
+    content_type = response.headers["content-type"]
+
+    active_storage_profile_image.attach(
+      io: StringIO.new(response.body),
+      filename: filename,
+      content_type: content_type,
+    )
+  rescue StandardError => e
+    Rails.logger.warn("Could not download profile image into Active Storage: #{e.class}: #{e.message}")
+  end
+
+  def detach_active_storage_profile_image
+    active_storage_profile_image.detach
+  rescue StandardError => e
+    Rails.logger.warn("Could not detach profile image from Active Storage: #{e.class}: #{e.message}")
+  end
+
+  def profile_image_upload_parts(upload)
+    filename = upload.original_filename if upload.respond_to?(:original_filename)
+    content_type = upload.content_type if upload.respond_to?(:content_type)
+
+    source = if upload.respond_to?(:tempfile)
+               upload.tempfile
+             elsif upload.respond_to?(:path)
+               upload.path
+             elsif upload.respond_to?(:file) && upload.file.respond_to?(:path)
+               upload.file.path
+             else
+               upload
+             end
+
+    io = source.is_a?(String) ? File.open(source, "rb") : source
+    filename ||= File.basename(source.path) if source.respond_to?(:path)
+    filename ||= "profile-image"
+    content_type ||= Marcel::MimeType.for(io) if io.respond_to?(:path)
+
+    [io, filename, content_type]
+  end
+end
