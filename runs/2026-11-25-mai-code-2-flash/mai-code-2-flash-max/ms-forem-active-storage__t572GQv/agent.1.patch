+
+  def url(*args)
+    if model.respond_to?(:active_storage_profile_image) && model.active_storage_profile_image.attached?
+      Rails.application.routes.url_helpers.rails_blob_path(model.active_storage_profile_image.blob, only_path: true)
+    else
