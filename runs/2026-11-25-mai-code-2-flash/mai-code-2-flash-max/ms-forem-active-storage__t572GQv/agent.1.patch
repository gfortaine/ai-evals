diff --git a/lib/active_storage/service/fog_service.rb b/lib/active_storage/service/fog_service.rb
new file mode 100644
index 0000000..80b7fc7
--- /dev/null
+++ b/lib/active_storage/service/fog_service.rb
@@ -0,0 +1,138 @@
+module ActiveStorage
+  class Service
+    class FogService < Service
+      def initialize(bucket:, aws_access_key_id: nil, aws_secret_access_key: nil, region: nil, public: false, **)
+        super()
+        @bucket = bucket
+        @public = public
+        @storage = Fog::Storage.new(credentials(aws_access_key_id, aws_secret_access_key, region))
+      end
+
+      def upload(key, io, checksum: nil, **)
+        instrument :upload, key: key, checksum: checksum do
+          io.rewind if io.respond_to?(:rewind)
+          body = io.read
+          io.rewind if io.respond_to?(:rewind)
+
+          ensure_integrity_of(body, checksum) if checksum
+          @storage.put_object(@bucket, key, body, "x-amz-acl" => public? ? "public-read" : "private")
+        end
+      end
+
+      def download(key, &block)
+        if block
+          instrument :streaming_download, key: key do
+            @storage.get_object(@bucket, key) { |chunk, _remaining| yield(chunk) }.body
+          end
+        else
+          instrument :download, key: key do
+            @storage.get_object(@bucket, key).body
+          end
+        end
+      rescue Excon::Error::NotFound
+        raise ActiveStorage::FileNotFoundError
+      end
+
+      def download_chunk(key, range)
+        instrument :download_chunk, key: key, range: range do
+          @storage.get_object(@bucket, key, "Range" => "bytes=#{range.begin}-#{range.end}").body
+        end
+      rescue Excon::Error::NotFound
+        raise ActiveStorage::FileNotFoundError
+      end
+
+      def delete(key)
+        instrument :delete, key: key do
+          @storage.delete_object(@bucket, key)
+        rescue Excon::Error::NotFound
+          nil
+        end
+      end
+
+      def delete_prefixed(prefix)
+        instrument :delete_prefixed, prefix: prefix do
+          marker = nil
+          loop do
+            options = { "prefix" => prefix }
+            options["marker"] = marker if marker
+            response = @storage.get_bucket(@bucket, options)
+            keys = Array(response.body["Contents"]).filter_map { |entry| entry["Key"] }
+            keys.each { |key| @storage.delete_object(@bucket, key) }
+            break unless response.body["IsTruncated"]
+
+            marker = keys.last
+            break if marker.blank?
+          end
+        end
+      end
+
+      def exist?(key)
+        instrument :exist, key: key do |payload|
+          @storage.head_object(@bucket, key)
+          payload[:exist] = true
+        rescue Excon::Error::NotFound
+          payload[:exist] = false
+          false
+        end
+      end
+
+      def compose(source_keys, destination_key, **)
+        body = source_keys.reduce("") { |acc, elem| acc + download(elem).to_s }
+        @storage.put_object(@bucket, destination_key, body, "x-amz-acl" => public? ? "public-read" : "private")
+      end
+
+      def url_for_direct_upload(key, expires_in:, content_type:, content_length:, checksum:, custom_metadata: {})
+        headers = custom_metadata.transform_keys { |name| "x-amz-meta-#{name}" }
+        headers["Content-Type"] = content_type
+        headers["Content-Length"] = content_length.to_s
+        headers["Content-MD5"] = checksum if checksum
+
+        expires = Time.now.to_i + expires_in.to_i
+        @storage.put_object_url(@bucket, key, expires, headers)
+      end
+
+      def headers_for_direct_upload(_key, content_type:, **)
+        { "Content-Type" => content_type }
+      end
+
+      private
+
+      def credentials(access_key_id, secret_access_key, region)
+        result = { provider: "AWS", region: region }
+
+        if access_key_id.present? && secret_access_key.present?
+          result[:aws_access_key_id] = access_key_id
+          result[:aws_secret_access_key] = secret_access_key
+        else
+          result[:use_iam_profile] = true
+        end
+
+        result
+      end
+
+      def ensure_integrity_of(body, checksum)
+        actual_checksum = Digest::MD5.base64digest(body)
+        raise ActiveStorage::IntegrityError unless actual_checksum == checksum
+      end
+
+      def private_url(key, expires_in:, filename:, disposition:, content_type:, **)
+        expires = Time.now.to_i + expires_in.to_i
+        @storage.get_object_url(
+          @bucket,
+          key,
+          expires,
+          "response-content-disposition" => content_disposition_with(type: disposition, filename: filename),
+          "response-content-type" => content_type,
+        )
+      end
+
+      def public_url(key, **)
+        protocol = ENV["APP_PROTOCOL"].presence || "https://"
+        host = ENV["APP_DOMAIN"].presence
+        return "#{protocol}#{host}/remoteimages/#{key}" if host
+
+        @storage.get_object_http_url(@bucket, key, Time.now.to_i + 7.days.to_i)
+      end
+    end
+  end
+end
