diff --git a/test/channels/being_edited_channel_test.rb b/test/channels/being_edited_channel_test.rb
new file mode 100644
index 0000000..3110247
--- /dev/null
+++ b/test/channels/being_edited_channel_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class BeingEditedChannelTest < ActionCable::Channel::TestCase
+  tests BeingEditedChannel
+
+  test "subscribes an editor to the page" do
+    leaf = leaves(:welcome_page)
+    user = users(:kevin)
+
+    stub_connection(current_user: user)
+
+    stream_name = Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, user ])
+    signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, user ])
+
+    subscribe signed_stream_name: signed_stream_name, leaf_id: leaf.id, user_id: user.id
+
+    assert_has_stream stream_name
+  end
+
+  test "rejects a removed collaborator" do
+    leaf = leaves(:welcome_page)
+    user = users(:jz)
+
+    leaf.book.update_access(editors: [ users(:kevin).id ], readers: [])
+    stub_connection(current_user: user)
+
+    signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, user ])
+
+    subscribe signed_stream_name: signed_stream_name, leaf_id: leaf.id, user_id: user.id
+
+    assert_no_streams
+  end
+end
