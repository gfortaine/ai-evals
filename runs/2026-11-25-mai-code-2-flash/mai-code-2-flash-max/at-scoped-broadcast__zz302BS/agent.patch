@@ -0,0 +1,21 @@
+class BeingEditedChannel < ApplicationCable::Channel
+  extend Turbo::Streams::Broadcasts, Turbo::Streams::StreamName
+  include Turbo::Streams::StreamName::ClassMethods
+
+  def subscribed
+    if (stream_name = verified_stream_name_from_params) && subscription_allowed?(stream_name)
+      stream_from stream_name
+    else
+      reject
+    end
+  end
+
+  private
+    def subscription_allowed?(stream_name)
+      leaf = Leaf.find_by(id: params[:leaf_id])
+      user = User.find_by(id: params[:user_id])
+
+      leaf.present? && user == current_user && leaf.book.editable?(user: current_user) &&
+        stream_name == Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, user ])
+    end
+end
