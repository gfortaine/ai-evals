diff --git a/test/integration/moderator_flow_test.rb b/test/integration/moderator_flow_test.rb
index 1241e21..dc1f7e9 100644
--- a/test/integration/moderator_flow_test.rb
+++ b/test/integration/moderator_flow_test.rb
@@ -97,6 +97,104 @@ class ModeratorFlowTest < ActionDispatch::IntegrationTest
     assert_not first.reload.active?
   end
 
+  test "import creates a quiz with ordered questions and options" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+
+    get "/moderate/quizzes/import", headers: auth_headers
+    assert_response :success
+    assert_select "label", text: "Quiz JSON"
+    assert_select "textarea[name=quiz_json]"
+    assert_select "input[type=submit][value=Import]"
+
+    payload = {
+      title: "Frontend Fest 2026",
+      questions: [
+        {
+          text: "Which HTTP status code means Too Many Requests?",
+          active: false,
+          options: [
+            { text: "418", correct: false },
+            { text: "429", correct: true }
+          ]
+        },
+        {
+          text: "Second question",
+          options: [
+            { text: "First option" },
+            { text: "Second option", correct: true }
+          ]
+        }
+      ]
+    }
+
+    post "/moderate/quizzes/import", headers: auth_headers, params: { quiz_json: payload.to_json }
+    assert_response :redirect
+
+    imported = Quiz.where(title: "Frontend Fest 2026").where.not(id: existing.id).sole
+    assert_equal [ "Which HTTP status code means Too Many Requests?", "Second question" ], imported.questions.ordered.pluck(:text)
+
+    first = imported.questions.ordered.first
+    assert_not first.active?
+    assert_equal [ "418", "429" ], first.options.ordered.pluck(:text)
+    assert_equal [ false, true ], first.options.ordered.pluck(:correct)
+
+    second = imported.questions.ordered.second
+    assert second.active?
+    assert_equal [ false, true ], second.options.ordered.pluck(:correct)
+  end
+
+  test "export contains exactly importable quiz content in order" do
+    quiz = Quiz.create!(title: "Export Quiz")
+    question = quiz.questions.create!(text: "One", active: false, position: 1)
+    question.options.create!(text: "A", correct: false, position: 1)
+    question.options.create!(text: "B", correct: true, position: 2)
+
+    get "/moderate/quizzes/#{quiz.id}/export", headers: auth_headers
+    assert_response :success
+    assert_select "pre", count: 1
+
+    exported = JSON.parse(Nokogiri::HTML(@response.body).at_css("pre").text)
+    assert_equal [ "title", "questions" ], exported.keys
+    assert_equal "Export Quiz", exported["title"]
+    assert_equal [ "text", "active", "options" ], exported["questions"].first.keys
+    assert_equal [ "text", "correct" ], exported["questions"].first["options"].first.keys
+    assert_equal false, exported["questions"].first["active"]
+    assert_equal [ "A", "B" ], exported["questions"].first["options"].map { |option| option["text"] }
