+    def import_json_param
+      direct = params[:quiz_json] || params[:json] || params[:payload] || params[:data]
+      return direct if direct
+
+      nested = params.dig(:quiz, :quiz_json) || params.dig(:quiz, :json) || params.dig(:quiz, :payload)
+      return nested if nested
+
+      quiz_param = params[:quiz]
+      if quiz_param.is_a?(String)
+        quiz_param
+      elsif quiz_param.respond_to?(:to_unsafe_h)
+        quiz_param.to_unsafe_h
+      else
+        nil
+      end
+    end
+
+    def build_imported_quiz(payload)
+      errors = []
+
+      unless payload.is_a?(Hash)
+        return [ nil, [], [ "Invalid quiz JSON: expected a JSON object" ] ]
+      end
+
+      title = payload["title"]
+      title_is_valid = title.is_a?(String) && title.present?
+      quiz = Quiz.new(title: title_is_valid ? title : nil)
+      errors.concat(quiz.errors.full_messages) unless quiz.valid?
+
+      unless payload.key?("questions") && payload["questions"].is_a?(Array)
+        errors << "Questions must be a JSON array"
+        return [ quiz, [], errors ]
+      end
+
+      questions_attributes = []
+
+      payload["questions"].each_with_index do |question_payload, question_index|
+        question_number = question_index + 1
+
+        unless question_payload.is_a?(Hash)
+          errors << "Question #{question_number}: must be a JSON object"
+          next
+        end
+
+        text = question_payload["text"]
+        if text.nil? || (text.is_a?(String) && text.blank?)
+          text_is_valid = false
+          errors << "Question #{question_number}: Text can't be blank"
+        elsif !text.is_a?(String)
+          text_is_valid = false
+          errors << "Question #{question_number}: Text must be a string"
+        else
+          text_is_valid = true
+        end
+
+        active = true
+        active_is_valid = true
+        if question_payload.key?("active")
+          unless [ true, false ].include?(question_payload["active"])
+            active_is_valid = false
+            errors << "Question #{question_number}: Active must be true or false"
+          else
+            active = question_payload["active"]
+          end
+        end
+
+        unless question_payload.key?("options") && question_payload["options"].is_a?(Array)
+          errors << "Question #{question_number}: Options must be a JSON array"
+          next
+        end
+
+        option_values = []
+
+        question_payload["options"].each_with_index do |option_payload, option_index|
+          option_number = option_index + 1
+
+          unless option_payload.is_a?(Hash)
+            errors << "Question #{question_number}, option #{option_number}: must be a JSON object"
+            next
+          end
+
+          unless option_payload.key?("text")
+            errors << "Question #{question_number}, option #{option_number}: Text is required"
+            next
+          end
+
+          unless option_payload["text"].is_a?(String)
+            errors << "Question #{question_number}, option #{option_number}: Text must be a string"
+            next
+          end
+
+          correct = false
+          correct_is_valid = true
+          if option_payload.key?("correct")
+            unless [ true, false ].include?(option_payload["correct"])
+              correct_is_valid = false
+              errors << "Question #{question_number}, option #{option_number}: Correct must be true or false"
+            else
+              correct = option_payload["correct"]
+            end
+          end
+
+          option_text = option_payload["text"].strip
+          next if option_text.blank? || !correct_is_valid
+
+          option_values << { text: option_text, correct: correct }
+        end
+
+        if option_values.length < 2
+          errors << "Question #{question_number}: Add at least two options"
+        end
+        unless option_values.any? { |option| option[:correct] }
+          errors << "Question #{question_number}: Mark at least one option as correct"
+        end
+
+        if text_is_valid && active_is_valid
+          questions_attributes << {
+            text: text,
+            active: active,
+            options: option_values
+          }
+        end
+      end
+
+      [ quiz, questions_attributes, errors ]
+    end
   end
 end
