@@ -0,0 +1,31 @@
+<% content_for :title, "Quizzy · Import quiz" %>
+<%= render "moderate/moderator_header" %>
+
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_path %></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+
+  <div class="card">
+    <%= form_with url: import_moderate_quizzes_path, method: :post, local: true do %>
+      <% if @import_errors.present? %>
+        <div class="errors">
+          <ul>
+            <% @import_errors.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <div class="field">
+        <%= label_tag :quiz_json, "Quiz JSON" %>
+        <%= text_area_tag :quiz_json, @quiz_json, id: "quiz_json", class: "input", rows: 18, required: true, aria: { label: "Quiz JSON" } %>
+      </div>
+
+      <div class="buttons">
+        <%= submit_tag "Import", class: "btn btn--pink" %>
+        <%= link_to "Cancel", moderate_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
