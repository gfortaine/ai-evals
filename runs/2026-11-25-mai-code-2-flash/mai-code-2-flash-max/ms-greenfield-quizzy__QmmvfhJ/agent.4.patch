@@ -119,6 +129,98 @@ class Game < ApplicationRecord
     answers.find_by(player: player, question: current_question)
   end
 
+  def points_for(player)
+    return 0 unless player
+
+    active_ids = active_questions.map(&:id)
+    answers.includes(:option).where(player: player).to_a.count do |answer|
+      active_ids.include?(answer.question_id) && answer.option&.correct?
+    end
+  end
+
+  def score_for(player)
+    points_for(player)
+  end
+
+  def total_correct_answer_time_ms_for(player)
+    return 0 unless player
+
+    active_ids = active_questions.map(&:id)
+    answers.includes(:option).where(player: player).to_a.sum do |answer|
+      if active_ids.include?(answer.question_id) && answer.option&.correct?
+        answer.response_time_milliseconds
+      else
+        0
+      end
+    end
+  end
+
+  def total_time_for(player)
+    total_correct_answer_time_ms_for(player)
+  end
+
+  def leaderboard
+    players.includes(answers: :option).to_a.sort_by do |player|
+      [
+        -points_for(player),
+        total_correct_answer_time_ms_for(player),
+        player.name.to_s.downcase,
+        player.id
+      ]
+    end
+  end
+
+  def ranked_players
+    leaderboard
+  end
+
+  def place_for(player)
+    return nil unless player
+
+    index = leaderboard.index { |ranked_player| ranked_player.id == player.id }
+    index ? index + 1 : nil
+  end
+
+  def pick_top_winners!
+    positive_players = leaderboard.select { |player| points_for(player) > 0 }
+    winner_count = [ quiz.number_of_winners, positive_players.length ].min
+    winner_ids = positive_players.first(winner_count).map(&:id)
+
+    Game.transaction do
+      players.update_all(winner: false)
+      players.where(id: winner_ids).update_all(winner: true) if winner_ids.any?
+    end
+
+    broadcast_refresh!
+  end
+
+  def draw_winners!
+    positive_players = leaderboard.select { |player| points_for(player) > 0 }
+    prize_count = quiz.number_of_winners
+
+    winner_ids = if positive_players.length < prize_count
+      positive_players.map(&:id)
+    else
+      threshold_points = points_for(positive_players[prize_count - 1])
+      guaranteed = positive_players.select { |player| points_for(player) > threshold_points }
+      remaining = prize_count - guaranteed.length
+      tied = positive_players.select { |player| points_for(player) == threshold_points }
+
+      (guaranteed.map(&:id) + tied.shuffle.first([ remaining, tied.length ].min).map(&:id)).uniq
+    end
+
+    Game.transaction do
+      players.update_all(winner: false)
+      players.where(id: winner_ids).update_all(winner: true) if winner_ids.any?
+    end
+
+    broadcast_refresh!
+  end
+
+  def reset_winners!
+    players.update_all(winner: false)
+    broadcast_refresh!
+  end
   def broadcast_refresh!
     GameChannel.broadcast_to(self, { refresh: true })
   end
