@@ -0,0 +1,157 @@
+require "test_helper"
+require "base64"
+
+class PrizesTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "password"
+
+    @quiz = Quiz.create!(title: "Prize Quiz", number_of_winners: 2)
+    @question1 = @quiz.questions.create!(text: "One", active: true, position: 1)
+    @q1_correct = @question1.options.create!(text: "A", correct: true, position: 1)
+    @question1.options.create!(text: "B", correct: false, position: 2)
+
+    @question2 = @quiz.questions.create!(text: "Two", active: true, position: 2)
+    @q2_correct = @question2.options.create!(text: "C", correct: true, position: 1)
+    @question2.options.create!(text: "D", correct: false, position: 2)
+  end
+
+  test "number of winners defaults to three and settings enforce at least one" do
+    default_quiz = Quiz.create!(title: "Default Prize Count")
+    assert_equal 3, default_quiz.number_of_winners
+
+    get "/moderate/quizzes/new", headers: auth_headers
+    assert_response :success
+    assert_select "label", text: "Number of winners"
+    assert_select "input[type=number][name='quiz[number_of_winners]'][min='1'][value='3']"
+
+    post "/moderate/quizzes", headers: auth_headers, params: {
+      quiz: { title: "Two Winners", number_of_winners: "2" }
+    }
+    assert_response :redirect
+    assert_equal 2, Quiz.find_by!(title: "Two Winners").number_of_winners
+
+    post "/moderate/quizzes", headers: auth_headers, params: {
+      quiz: { title: "Invalid Winners", number_of_winners: "0" }
+    }
+    assert_response :unprocessable_entity
+    assert_nil Quiz.find_by(title: "Invalid Winners")
+  end
+
+  test "leaderboard uses points then correct-answer speed and finished screens show exact results" do
+    game = @quiz.games.create!
+    post "/play/#{game.code}/join", params: { name: "Alice" }
+    alice = game.players.find_by!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+
+    Answer.create!(game: game, player: alice, question: @question1, option: @q1_correct, response_time_ms: 500)
+    Answer.create!(game: game, player: alice, question: @question2, option: @q2_correct, response_time_ms: 700)
+
+    Answer.create!(game: game, player: bob, question: @question1, option: @q1_correct, response_time_ms: 300)
+    Answer.create!(game: game, player: bob, question: @question2, option: @q2_correct, response_time_ms: 400)
+
+    wrong = @question1.options.find_by!(correct: false)
+    Answer.create!(game: game, player: carol, question: @question1, option: wrong, response_time_ms: 100)
+
+    game.end_quiz!
+
+    assert_equal [ bob, alice, carol ], game.leaderboard
+    assert_equal [ 2, 2, 0 ], game.leaderboard.map { |player| game.points_for(player) }
+    assert_equal [ 700, 1200, 0 ], game.leaderboard.map { |player| game.total_correct_answer_time_ms_for(player) }
+
+    get "/moderate/games/#{game.id}", headers: auth_headers
+    assert_response :success
+    assert_select ".leaderboard > li", count: 3
+    assert_select ".leader", 3
+    assert_includes @response.body, "2 points"
+    assert_includes @response.body, "0 points"
+
+    get "/play/#{game.code}"
+    assert_includes @response.body, "Place 2 of 3"
+    assert_includes @response.body, "2 points"
+  end
+
+  test "top draw and reset update winners and 0-point players never win" do
+    @quiz.update!(number_of_winners: 2)
+    game = @quiz.games.create!
+
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+    zoe = game.players.create!(name: "Zoe")
+
+    Answer.create!(game: game, player: alice, question: @question1, option: @q1_correct, response_time_ms: 100)
+    Answer.create!(game: game, player: alice, question: @question2, option: @q2_correct, response_time_ms: 100)
+    Answer.create!(game: game, player: bob, question: @question1, option: @q1_correct, response_time_ms: 100)
+    Answer.create!(game: game, player: carol, question: @question1, option: @q1_correct, response_time_ms: 200)
+
+    game.end_quiz!
+
+    post "/moderate/games/#{game.id}/top", headers: auth_headers
+    assert_response :redirect
+    assert_equal [ alice.id, bob.id ].sort, game.players.where(winner: true).pluck(:id).sort
+
+    get "/moderate/games/#{game.id}", headers: auth_headers
+    assert_includes @response.body, "Top 2"
+    assert_select ".leader__badge", text: "Winner", count: 2
+
+    post "/moderate/games/#{game.id}/draw", headers: auth_headers
+    assert_response :redirect
+
+    winner_ids = game.players.where(winner: true).pluck(:id)
+    assert_includes winner_ids, alice.id
+    assert_not_includes winner_ids, zoe.id
+    assert_equal 2, winner_ids.length
+
+    post "/moderate/games/#{game.id}/reset_winners", headers: auth_headers
+    assert_response :redirect
+    assert_equal 0, game.players.where(winner: true).count
+
+    zoe_only = @quiz.games.create!
+    low_a = zoe_only.players.create!(name: "Low A")
+    low_b = zoe_only.players.create!(name: "Low B")
+    zoe_only.end_quiz!
+
+    zoe_only.pick_top_winners!
+    assert_equal 0, zoe_only.players.where(winner: true).count
+  end
+
+  test "draw fills fewer than N positive players and redraws a tied point pool" do
+    @quiz.update!(number_of_winners: 3)
+    game = @quiz.games.create!
+
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+
+    Answer.create!(game: game, player: alice, question: @question1, option: @q1_correct, response_time_ms: 100)
+    Answer.create!(game: game, player: bob, question: @question1, option: @q1_correct, response_time_ms: 200)
+
+    game.end_quiz!
+    game.draw_winners!
+
+    assert_equal [ alice.id, bob.id ].sort, game.players.where(winner: true).pluck(:id).sort
+
+    @quiz.update!(number_of_winners: 2)
+    Answer.create!(game: game, player: alice, question: @question2, option: @q2_correct, response_time_ms: 100)
+    tied_a = game.players.create!(name: "Tied A")
+    tied_b = game.players.create!(name: "Tied B")
+    Answer.create!(game: game, player: tied_a, question: @question1, option: @q1_correct, response_time_ms: 400)
+    Answer.create!(game: game, player: tied_b, question: @question1, option: @q1_correct, response_time_ms: 800)
+
+    3.times do
+      game.draw_winners!
+      winners = game.players.where(winner: true).to_a
+      assert_equal 2, winners.length
+      assert_equal 1, winners.count { |player| player.id == alice.id }
+      assert_equal 1, winners.count { |player| [ bob.id, tied_a.id, tied_b.id ].include?(player.id) }
+    end
+  end
+
+  private
+
+  def auth_headers
+    { "HTTP_AUTHORIZATION" => "Basic #{Base64.strict_encode64("moderator:password")}" }
+  end
+end
