diff --git a/app/views/moderate/games/_screen.html.erb b/app/views/moderate/games/_screen.html.erb
new file mode 100644
index 0000000..181f9a0
--- /dev/null
+++ b/app/views/moderate/games/_screen.html.erb
@@ -0,0 +1,92 @@
+<% game = local_assigns[:game] || @game %>
+<% join_url = local_assigns[:join_url] || "#{request.base_url}#{play_path(game.code)}" %>
+
+<div class="screen__top">
+  <%= link_to moderate_quiz_path(game.quiz), class: "logo screen__logo", aria: { label: "Quizzy" } do %>
+    <span class="logo__mark">?</span>Quizzy
+  <% end %>
+  <span><%= game.quiz.title %></span>
+</div>
+
+<div class="screen__body">
+  <% if game.finished? %>
+    <h1>The quiz is over</h1>
+  <% elsif game.lobby? %>
+    <div class="lobby">
+      <div>
+        <h1 class="lobby__title"><%= game.quiz.title %></h1>
+        <div class="lobby__join">Join at</div>
+        <div class="lobby__url"><%= join_url %></div>
+        <div class="counter-pill">Players: <%= game.players.count %></div>
+      </div>
+
+      <div class="qr" role="img" aria-label="QR code for <%= join_url %>">
+        <% qr = RQRCode::QRCode.new(join_url) %>
+        <%= raw qr.as_svg(module_size: 6, standalone: true) %>
+      </div>
+    </div>
+  <% elsif game.question_open? || game.question_closed? %>
+    <% question = game.current_question %>
+    <div class="stage-question__num">
+      Question <%= game.question_number %> of <%= game.active_questions.length %>
+    </div>
+    <div class="stage-question__body"><%= question.text %></div>
+
+    <ul class="stage-options <%= "stage-options--results" if game.question_closed? %>">
+      <% question.options.ordered.each_with_index do |option, index| %>
+        <% count = game.question_closed? ? game.answer_count_for(option) : nil %>
+        <li class="stage-option <%= "is-correct" if game.question_closed? && option.correct? %>">
+          <span class="stage-option__letter"><%= ("A".ord + index).chr %></span>
+          <span class="stage-option__title"><%= option.text %></span>
+          <% if game.question_closed? %>
+            <span class="stage-option__count"><%= count %></span>
+            <% if option.correct? %>
+              <span class="stage-option__mark">Correct</span>
+            <% end %>
+          <% end %>
+          <% if game.question_closed? %>
+            <span class="stage-option__bar" style="--share: <%= game.players.count.zero? ? 0 : (count * 100 / [game.players.count, 1].max) %>%"></span>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+  <% end %>
+</div>
+
+<div class="screen-controls">
+  <div class="screen-controls__info">
+    <% if game.lobby? %>
+      <span>Waiting to start</span>
+    <% elsif game.question_open? %>
+      <span class="answers-counter">Answers: <%= game.answered_count %> / <%= game.players.count %></span>
+    <% elsif game.question_closed? %>
+      <span>Answers: <%= game.answered_count %> / <%= game.players.count %></span>
+    <% end %>
+  </div>
+
+  <div class="buttons">
+    <% if game.lobby? %>
+      <form action="<%= start_moderate_game_path(game) %>" method="post" data-live-submit>
+        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+        <button type="submit" class="btn btn--pink">Start</button>
+      </form>
+    <% elsif game.question_open? %>
+      <form action="<%= finish_moderate_game_path(game) %>" method="post" data-live-submit>
+        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+        <button type="submit" class="btn btn--pink">Finish</button>
+      </form>
+    <% elsif game.question_closed? %>
+      <% if game.question_number && game.question_number >= game.active_questions.length %>
+        <form action="<%= end_moderate_game_path(game) %>" method="post" data-live-submit>
+          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+          <button type="submit" class="btn btn--pink">End quiz</button>
+        </form>
+      <% else %>
+        <form action="<%= next_moderate_game_path(game) %>" method="post" data-live-submit>
+          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+          <button type="submit" class="btn btn--pink">Next</button>
+        </form>
+      <% end %>
+    <% end %>
+  </div>
+</div>
