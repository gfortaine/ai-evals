diff --git a/test/integration/live_game_test.rb b/test/integration/live_game_test.rb
new file mode 100644
index 0000000..8eef2c1
--- /dev/null
+++ b/test/integration/live_game_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+require "base64"
+
+class LiveGameTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "password"
+
+    @quiz = Quiz.create!(title: "Live Quiz")
+    first = @quiz.questions.create!(text: "First?", active: true, position: 1)
+    @first_correct = first.options.create!(text: "Yes", correct: true, position: 1)
+    first.options.create!(text: "No", correct: false, position: 2)
+
+    inactive = @quiz.questions.create!(text: "Inactive?", active: false, position: 2)
+    inactive.options.create!(text: "Hidden", correct: true, position: 1)
+    inactive.options.create!(text: "Also hidden", correct: false, position: 2)
+
+    second = @quiz.questions.create!(text: "Second?", active: true, position: 3)
+    @second_correct = second.options.create!(text: "A", correct: true, position: 1)
+    second.options.create!(text: "B", correct: false, position: 2)
+  end
+
+  test "game advances through active questions and player answers update live state" do
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: auth_headers
+    assert_response :redirect
+
+    game = @quiz.games.sole
+    assert_match(/\A[A-Z2-9]{5}\z/, game.code)
+
+    get "/moderate/games/#{game.id}", headers: auth_headers
+    assert_response :success
+    assert_includes @response.body, "Live Quiz"
+    assert_includes @response.body, "Players: 0"
+    assert_includes @response.body, "Join at"
+
+    get "/play/#{game.code}"
+    assert_response :success
+    assert_select "label", text: "Your name"
+    assert_select "input[name=name][placeholder='Your name']"
+
+    post "/play/#{game.code}/join", params: { name: "Alice" }
+    assert_response :redirect
+
+    post "/play/#{game.code}/join", params: { name: "Mallory" }
+    assert_response :redirect
+    assert_equal 1, game.players.count
+
+    get "/play/#{game.code}"
+    assert_includes @response.body, "Hi, Alice!"
+
+    post "/moderate/games/#{game.id}/start", headers: auth_headers
+    assert_response :redirect
+    assert_equal "running", game.reload.status
+
+    get "/play/#{game.code}"
+    assert_includes @response.body, "First?"
+    assert_includes @response.body, "Yes"
+    assert_not_includes @response.body, "Correct"
+    assert_not_includes @response.body, "Correct!"
+
+    wrong = game.current_question.options.find_by!(text: "No")
+    post "/play/#{game.code}/answer", params: { option_id: wrong.id }
+    assert_response :redirect
+
+    get "/moderate/games/#{game.id}", headers: auth_headers
+    assert_includes @response.body, "Answers: 1 / 1"
+
+    post "/play/#{game.code}/answer", params: { option_id: @first_correct.id }
+    assert_response :redirect
+    assert_equal @first_correct.id, game.answers.joins(:player).where(players: { name: "Alice" }).sole.option_id
+
+    post "/moderate/games/#{game.id}/finish", headers: auth_headers
+    assert_response :redirect
+
+    get "/moderate/games/#{game.id}", headers: auth_headers
+    assert_includes @response.body, "Correct"
+    assert_includes @response.body, "Next"
+
+    get "/play/#{game.code}"
+    assert_includes @response.body, "Correct!"
+
+    post "/moderate/games/#{game.id}/next", headers: auth_headers
+    assert_response :redirect
+    assert_equal "Second?", game.reload.current_question.text
+
+    get "/play/#{game.code}"
+    assert_includes @response.body, "Second?"
+    assert_not_includes @response.body, "Inactive?"
+
+    post "/moderate/games/#{game.id}/finish", headers: auth_headers
+    assert_response :redirect
+    get "/moderate/games/#{game.id}", headers: auth_headers
