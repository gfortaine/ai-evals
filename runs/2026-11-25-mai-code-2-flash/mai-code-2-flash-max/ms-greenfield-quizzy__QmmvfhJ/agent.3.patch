--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,12 @@
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    game = if params[:game_id].present?
+      Game.find_by(id: params[:game_id])
+    elsif params[:code].present?
+      Game.find_by(code: params[:code].to_s.upcase)
+    end
+
+    reject unless game
+    stream_for game if game
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..7c83c28
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,96 @@
+require "rqrcode"
+
+module Moderate
+  class GamesController < BaseController
+    before_action :set_quiz, only: [ :create ]
+    before_action :set_game, except: [ :create ]
+
+    def create
+      game = @quiz.games.create!
+      redirect_to moderate_quiz_game_path(@quiz, game)
+    end
+
+    def show
+      prepare_live_state
+    end
+
+    def live
+      prepare_live_state
+      render partial: "moderate/games/screen", layout: false
+    end
+
+    def state
+      render json: game_state
+    end
+
+    def start
+      @game.start!
+      respond_to_action
+    end
+
+    def finish
+      @game.finish_question!
+      respond_to_action
+    end
+
+    def next
+      @game.next_question!
+      respond_to_action
+    end
+
+    def end_quiz
+      @game.end_quiz!
+      respond_to_action
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = Game.find(params[:id])
+      @quiz = @game.quiz
+    end
+
+    def prepare_live_state
+      @join_url = "#{request.base_url}#{play_path(@game.code)}"
+    end
+
+    def respond_to_action
+      if request.xhr?
+        head :ok
+      else
+        redirect_to moderate_quiz_game_path(@quiz, @game)
+      end
+    end
+
+    def game_state
+      question = @game.current_question
+
+      options = if question
+        question.options.ordered.map do |option|
+          {
+            id: option.id,
+            text: option.text,
+            correct: @game.question_closed? ? option.correct? : nil,
+            answers: @game.question_closed? ? @game.answer_count_for(option) : nil
+          }.compact
+        end
+      else
+        []
+      end
+
+      {
+        status: @game.status,
+        question_status: @game.question_status,
+        question_number: @game.question_number,
+        question_count: @game.active_questions.length,
+        question: question ? { id: question.id, text: question.text, options: options } : nil,
+        players: @game.players.count,
+        answered: @game.answered_count
+      }
+    end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..96e4bf8
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,129 @@
+class PlayController < ApplicationController
+  before_action :set_game
+  before_action :set_player, only: [ :show, :live, :state, :answer ]
+
+  def show
+  end
+
+  def join
+    if @game.finished?
+      return render_finished
+    end
+
+    existing_id = cookies.signed[cookie_name]
+    existing_player = @game.players.find_by(id: existing_id) if existing_id
+    if existing_player
+      @player = existing_player
+      @game.broadcast_refresh!
+      return redirect_to play_path(@game.code)
+    end
+
+    name = params[:name].to_s.strip
+    if name.blank?
+      @join_error = "Enter your name"
+      return render :show, status: :unprocessable_entity
+    end
+
+    player = @game.players.create!(name: name)
+    cookies.signed.permanent[cookie_name] = player.id
+    @player = player
+    @game.broadcast_refresh!
+
+    if request.xhr?
+      head :ok
+    else
+      redirect_to play_path(@game.code)
+    end
+  end
+
+  def answer
+    if @game.question_open? && @player
+      option_id = params[:option_id] || params.dig(:answer, :option_id)
+      option_id ||= params[:option]
+      option = @game.current_question.options.find_by(id: option_id)
+
+      if option
+        answer = @game.answers.find_or_initialize_by(
+          player: @player,
+          question: @game.current_question
+        )
+        answer.game = @game
+        answer.option = option
+        answer.save!
+        @game.broadcast_refresh!
+
+        return head(:ok) if request.xhr?
+        return redirect_to play_path(@game.code)
+      end
+    end
+
+    if request.xhr?
+      head :unprocessable_entity
+    else
+      redirect_to play_path(@game.code)
+    end
+  end
+
+  def live
+    render partial: "play/live", layout: false
+  end
+
+  def state
+    answer = @game.answer_for(@player)
+
+    result = nil
+    if @game.question_closed?
+      result = if answer.nil?
+        "No answer"
+      elsif answer.option.correct?
+        "Correct!"
+      else
+        "Wrong!"
+      end
+    end
+
+    question = if @game.current_question
+      options = @game.current_question.options.ordered.map do |option|
+        payload = { id: option.id, text: option.text }
+        if @game.question_closed?
+          payload[:correct] = option.correct?
+        end
+        payload
+      end
+
+      { id: @game.current_question.id, text: @game.current_question.text, options: options }
+    end
+
+    render json: {
+      status: @game.status,
+      question_status: @game.question_status,
+      question: question,
+      picked_option_id: answer&.option_id,
+      result: result,
+      players: @game.players.count,
+      answered: @game.answered_count,
+      name: @player&.name
+    }
+  end
+
+  private
+
+  def set_game
+    code = params[:code].to_s.upcase
+    @game = Game.find_by!(code: code)
+  end
+
+  def set_player
+    player_id = cookies.signed[cookie_name]
+    @player = @game.players.find_by(id: player_id) if player_id
+  end
+
+  def cookie_name
+    "quizzy_player_#{@game.id}"
+  end
+
+  def render_finished
+    @player = nil
+    render :show, status: :ok
+  end
+end
diff --git a/app/javascript/controllers/live_game_controller.js b/app/javascript/controllers/live_game_controller.js
new file mode 100644
index 0000000..b6fc488
--- /dev/null
+++ b/app/javascript/controllers/live_game_controller.js
@@ -0,0 +1,71 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  connect() {
+    this.submitHandler = this.submit.bind(this)
+    this.element.addEventListener("submit", this.submitHandler)
+    this.refresh()
+
+    this.timer = window.setInterval(() => this.refresh(), 2500)
+
+    const gameId = this.element.dataset.channelGameId
+    const code = this.element.dataset.channelCode
+
+    if (gameId || code) {
+      const params = gameId ? { channel: "GameChannel", game_id: gameId } : { channel: "GameChannel", code: code }
+      this.subscription = createConsumer().subscriptions.create(params, {
+        received: () => this.refresh()
+      })
+    }
+  }
+
+  disconnect() {
+    this.element.removeEventListener("submit", this.submitHandler)
+    if (this.timer) window.clearInterval(this.timer)
+    if (this.subscription) this.subscription.unsubscribe()
+  }
+
+  async refresh() {
+    const url = this.element.dataset.liveUrl
+    if (!url) return
+
+    try {
+      const response = await fetch(url, {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { "Accept": "text/html" }
+      })
+
+      if (response.ok) {
+        this.element.innerHTML = await response.text()
+      }
+    } catch (_error) {
+      // Polling continues when a temporary connection issue interrupts Action Cable.
+    }
+  }
+
+  async submit(event) {
+    const form = event.target.closest("form[data-live-submit]")
+    if (!form) return
+
+    event.preventDefault()
+
+    const submitButton = form.querySelector("button[type='submit'], input[type='submit']")
+    if (submitButton) submitButton.disabled = true
+
+    try {
+      await fetch(form.action, {
+        method: "POST",
+        credentials: "same-origin",
+        headers: {
+          "Accept": "text/html",
+          "X-Requested-With": "XMLHttpRequest"
+        },
+        body: new FormData(form)
+      })
+    } finally {
+      await this.refresh()
+    }
+  }
+}
