+</div>
+
+<div class="play__body <%= "play__body--top" if player && (game.lobby? || game.running?) %>">
+  <% if game.finished? %>
+    <h1>The quiz is over</h1>
+  <% elsif player.nil? %>
+    <h1 class="play-title"><%= game.quiz.title %></h1>
+    <% if join_error %>
+      <div class="errors"><%= join_error %></div>
+    <% end %>
+
+    <form action="<%= join_game_path(game.code) %>" method="post" class="join-form" data-live-submit>
+      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+      <label for="player_name">Your name</label>
+      <input id="player_name" name="name" class="input" type="text" placeholder="Your name" required autocomplete="name">
+      <button type="submit" class="btn btn--pink">Join</button>
+    </form>
+  <% elsif game.lobby? %>
+    <div class="waiting">
+      <div class="waiting__gem">?</div>
+      <h1>Hi, <%= player.name %>!</h1>
+      <p class="play-lead">Waiting for the quiz to start</p>
+    </div>
+  <% elsif game.question_open? %>
+    <% question = game.current_question %>
+    <% answer = game.answer_for(player) %>
+    <div class="play-question__num">Question <%= game.question_number %> of <%= game.active_questions.length %></div>
+    <div class="play-question__body"><%= question.text %></div>
+
+    <div class="play-options">
+      <% question.options.ordered.each_with_index do |option, index| %>
+        <% picked = answer&.option_id == option.id %>
+        <form action="<%= play_answer_path(game.code) %>" method="post" data-live-submit>
+          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+          <input type="hidden" name="option_id" value="<%= option.id %>">
+          <button type="submit" class="play-option <%= "is-picked" if picked %>" aria-label="<%= option.text %>">
+            <span class="play-option__letter"><%= ("A".ord + index).chr %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% end %>
+          </button>
+        </form>
+      <% end %>
+    </div>
+  <% elsif game.question_closed? %>
+    <% question = game.current_question %>
+    <% answer = game.answer_for(player) %>
+    <% status = if answer.nil?
+      "No answer"
+    elsif answer.option.correct?
+      "Correct!"
+    else
+      "Wrong!"
+    end %>
+
+    <div class="play-question__num">Question <%= game.question_number %> of <%= game.active_questions.length %></div>
+    <div class="play-question__body"><%= question.text %></div>
+
+    <div class="play-options is-locked is-revealed">
+      <% question.options.ordered.each_with_index do |option, index| %>
+        <% picked = answer&.option_id == option.id %>
+        <button type="button" class="play-option <%= "is-correct" if option.correct? %> <%= "is-picked" if picked %>" aria-label="<%= option.text %>">
+          <span class="play-option__letter"><%= ("A".ord + index).chr %></span>
+          <span class="play-option__title"><%= option.text %></span>
+          <% if picked %>
+            <span class="play-option__mark">Your answer</span>
+          <% end %>
+        </button>
+      <% end %>
+    </div>
+
+    <div class="play-status <%= "play-status--right" if status == "Correct!" %><%= " play-status--wrong" if status == "Wrong!" %><%= " play-status--neutral" if status == "No answer" %>"><%= status %></div>
+  <% end %>
+</div>
