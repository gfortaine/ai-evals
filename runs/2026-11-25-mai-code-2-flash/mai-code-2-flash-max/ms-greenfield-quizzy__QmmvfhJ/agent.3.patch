diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..5c6805b
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,139 @@
+class Game < ApplicationRecord
+  belongs_to :quiz
+  belongs_to :current_question, class_name: "Question", optional: true
+
+  has_many :players, dependent: :destroy
+  has_many :answers, dependent: :destroy
+
+  validates :code, presence: true, uniqueness: true
+
+  before_validation :generate_code, on: :create
+
+  def active_questions
+    quiz.questions.active.to_a
+  end
+
+  def lobby?
+    status == "lobby"
+  end
+
+  def running?
+    status == "running"
+  end
+
+  def finished?
+    status == "finished"
+  end
+
+  def waiting?
+    lobby?
+  end
+
+  def ended?
+    finished?
+  end
+
+  def over?
+    finished?
+  end
+
+  def question_open?
+    running? && question_status == "open"
+  end
+
+  def question_closed?
+    running? && question_status == "closed"
+  end
+
+  def start!
+    first_question = active_questions.first
+
+    if first_question
+      update!(status: "running", current_question: first_question, question_status: "open")
+    else
+      end_quiz!
+    end
+
+    broadcast_refresh!
+  end
+
+  def finish_question!
+    update!(question_status: "closed") if running?
+    broadcast_refresh!
+  end
+
+  def next_question!
+    questions = active_questions
+    index = questions.index { |question| question.id == current_question_id }
+
+    if index.nil? || index >= questions.length - 1
+      end_quiz!
+    else
+      update!(status: "running", current_question: questions[index + 1], question_status: "open")
+      broadcast_refresh!
+    end
+  end
+
+  def end_quiz!
+    update!(status: "finished", question_status: nil)
+    broadcast_refresh!
+  end
+
+  def question_number
+    questions = active_questions
+    index = questions.index { |question| question.id == current_question_id }
+    index ? index + 1 : nil
+  end
+
+  def answered_count
+    return 0 unless running? && current_question
+
+    answers.where(question: current_question).distinct.count(:player_id)
+  end
+
+  def answer_count_for(option)
+    answers.where(question: current_question, option: option).count
+  end
+
+  def advance!
+    next_question!
+  end
+
+  def finish!
+    end_quiz!
+  end
+
+  def end!
+    end_quiz!
+  end
+
+  def last_question?
+    return false unless current_question
+
+    active_questions.last&.id == current_question.id
+  end
+
+  def answer_for(player)
+    return nil unless player
+
+    answers.find_by(player: player, question: current_question)
+  end
+
+  def broadcast_refresh!
+    GameChannel.broadcast_to(self, { refresh: true })
+  end
+
+  private
+
+  def generate_code
+    alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+
+    loop do
+      candidate = 5.times.map { alphabet[SecureRandom.random_number(alphabet.length)] }.join
+      unless self.class.exists?(code: candidate)
+        self.code = candidate
+        break
+      end
+    end
+  end
+end
