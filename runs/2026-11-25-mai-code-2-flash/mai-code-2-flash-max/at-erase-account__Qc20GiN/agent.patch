diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..49b2997 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -1,6 +1,8 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  DELETED_AUTHOR = "Deleted author"
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -13,20 +15,110 @@ class User < ApplicationRecord
   scope :active, -> { where(active: true) }
   scope :ordered, -> { order(:name) }
 
+  before_destroy :erase_associated_personal_data
+
   def current?
     self == Current.user
   end
 
   def deactivate
-    transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
-    end
+    erase
+  end
+
+  def erase
+    destroy!
   end
 
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    def erase_associated_personal_data
+      sign_in_addresses = sign_in_email_addresses
+
+      erase_created_books
+      sessions.delete_all
+      accesses.delete_all
+      reading_marks.delete_all
+      erase_sign_in_events(sign_in_addresses)
+    end
+
+    def erase_created_books
+      blob_ids = []
+
+      created_books.to_a.each do |book|
+        if book.everyone_access?
+          editor_ids = book.accesses.where(level: "editor").where.not(user_id: id).pluck(:user_id)
+          book.update!(creator: nil, author: DELETED_AUTHOR)
+          book.update_access(editors: editor_ids, readers: [])
+        else
+          blob_ids.concat(active_storage_blob_ids_for(book))
+          book.leaves.to_a.each(&:remove_from_search_index)
+          book.destroy!
+        end
+      end
+
+      purge_active_storage_blobs(blob_ids)
+    end
+
+    def erase_sign_in_events(sign_in_addresses)
+      SignInEvent.where(email_address: sign_in_addresses).delete_all
+    end
+
+    def sign_in_email_addresses
+      addresses = [ email_address, original_email_address ].compact
+
+      sessions.find_each do |session|
+        events = SignInEvent.all
+        events = events.where(ip_address: session.ip_address) if session.ip_address.present?
+        events = events.where(user_agent: session.user_agent) if session.user_agent.present?
+        addresses.concat(events.pluck(:email_address)) if session.ip_address.present? || session.user_agent.present?
+      end
+
+      addresses.uniq
+    end
+
+    def original_email_address
+      if match = email_address&.match(/\A(.+)-deactivated-[^@]+@([^@]+)\z/i)
+        "#{match[1]}@#{match[2]}"
+      end
+    end
+
+    def active_storage_blob_ids_for(book)
+      blob_ids = []
+
+      blob_ids.concat(book.cover.blobs.map(&:id)) if book.cover.attached?
+
+      book.leaves.includes(:leafable, :edits).each do |leaf|
+        blob_ids.concat(active_storage_blob_ids_for_record(leaf.leafable))
+        leaf.edits.each do |edit|
+          blob_ids.concat(active_storage_blob_ids_for_record(edit.leafable))
+        end
+      end
+
+      blob_ids
+    end
+
+    def active_storage_blob_ids_for_record(record)
+      return [] unless record
+
+      blob_ids = []
+
+      record.attachment_reflections.each_key do |name|
+        attachment = record.public_send(name)
+        blob_ids.concat(attachment.blobs.map(&:id)) if attachment.respond_to?(:blobs)
+      end
+
+      if record.respond_to?(:body)
+        body = record.body
+        blob_ids.concat(body.uploads.blobs.map(&:id)) if body.respond_to?(:uploads)
+      end
+
+      blob_ids
+    end
+
+    def purge_active_storage_blobs(blob_ids)
+      blob_ids.uniq.each do |blob_id|
+        blob = ActiveStorage::Blob.find_by(id: blob_id)
+        blob.purge if blob && blob.attachments.none?
+      end
     end
 
     def grant_access_to_everyone_books
