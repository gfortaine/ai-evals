@@ -17,4 +17,50 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase removes personal data and keeps shared created books" do
+    user = users(:kevin)
+    user_id = user.id
+
+    private_book = Book.create!(title: "Private Erasure Book", everyone_access: false, creator: user)
+    private_leaf = private_book.press(Section.new(body: "privatereasuretoken"), title: "Private Erasure Leaf")
+
+    shared_book = Book.create!(title: "Shared Retained Book", author: "Kevi N", everyone_access: true, creator: user)
+    shared_leaf = shared_book.press(Section.new(body: "sharedretainedtoken"), title: "Shared Retained Leaf")
+
+    Session.create!(user: user, ip_address: "127.0.0.1", user_agent: "Test browser")
+    ReadingMark.create!(user: user, leaf: private_leaf, last_read_at: Time.current)
+
+    user.erase
+
+    assert_not User.exists?(user_id)
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_not Leaf.search("privatereasuretoken").exists?
+
+    assert Book.exists?(shared_book.id)
+    assert shared_book.reload.creator.nil?
+    assert_equal "Deleted author", shared_book.author
+    assert Leaf.exists?(shared_leaf.id)
+
+    assert_not Session.exists?(user_id: user_id)
+    assert_not Access.exists?(user_id: user_id)
+    assert_not ReadingMark.exists?(user_id: user_id)
+    assert_not SignInEvent.where(email_address: "kevin@example.com").exists?
+  end
+
+  test "erase removes deactivated user and events under the original sign-in address" do
+    user = users(:kevin)
+    rewritten_address = "kevin-deactivated-#{SecureRandom.uuid}@example.com"
+    user.update_columns(active: false, email_address: rewritten_address)
+
+    SignInEvent.create!(email_address: "kevin@example.com", action: "signed_in")
+    SignInEvent.create!(email_address: rewritten_address, action: "signed_out")
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.where(email_address: "kevin@example.com").exists?
+    assert_not SignInEvent.where(email_address: rewritten_address).exists?
+  end
 end
