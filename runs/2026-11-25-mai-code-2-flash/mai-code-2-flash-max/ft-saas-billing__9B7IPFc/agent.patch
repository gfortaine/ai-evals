+class Admin::AccountsController < AdminController
+  layout "public"
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+    @account = Account.find(params[:id])
+  end
+
+  def comp
+    @account = Account.find(params[:id])
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account = Account.find(params[:id])
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    @account = Account.find(params[:id])
+    limits = params[:overridden_limit].presence || params[:override].presence || params[:limits].presence || params[:account].presence || params
+    @account.override_limits(card_count: limits[:card_count], bytes_used: limits[:bytes_used])
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  end
+
+  def destroy_override
+    @account = Account.find(params[:id])
+    @account.reset_override!
+    redirect_to saas.admin_account_path(@account), notice: "Limits reset"
+  end
+
+  def reset
+    destroy_override
+  end
+end
diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..82f2a73
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,59 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+  end
+
+  def create
+    plan = (params[:plan].presence || params[:plan_key].presence || "unlimited").to_s.downcase
+    plan = "unlimited_plus" if plan.match?(/plus|unlimited_plus|extra|500/)
+    plan = "unlimited" if plan.match?(/unlimited/) && plan != "unlimited_plus"
+
+    if defined?(Stripe::Checkout::Session)
+      subscription = Current.account.subscription
+      customer = subscription&.stripe_customer_id
+
+      customer ||= begin
+        result = Stripe::Customer.create(email: Current.identity.email_address, name: Current.account.name,
+          metadata: { account_id: Current.account.id, external_account_id: Current.account.external_account_id })
+        customer = result.respond_to?(:id) ? result.id : result["id"]
+        if subscription
+          subscription.update!(stripe_customer_id: customer)
+        else
+          subscription = Current.account.create_subscription!(stripe_customer_id: customer)
+        end
+        customer
+      end
+
+      price_id = if plan.to_s.in?(%w[ unlimited_plus unlimited+ plus ])
+        ENV["STRIPE_UNLIMITED_PLUS_V1_PRICE_ID"] || ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      else
+        ENV["STRIPE_UNLIMITED_V1_PRICE_ID"] || ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      end
+
+      session = Stripe::Checkout::Session.create(
+        customer: customer,
+        mode: "subscription",
+        line_items: [ { price: price_id, quantity: 1 } ],
+        subscription_data: { metadata: { account_id: Current.account.id, external_account_id: Current.account.external_account_id, plan_key: plan } },
+        success_url: billing_success_url(plan: plan),
+        cancel_url: billing_cancel_url,
+        metadata: { account_id: Current.account.id, plan_key: plan }
+      )
+
+      session_url = session.respond_to?(:url) ? session.url : session["url"]
+      redirect_to session_url, allow_other_host: true, status: :see_other
+    else
+      redirect_to account_settings_path, alert: "Stripe is not available in this environment"
+    end
+  end
+
+  private
+    def billing_success_url(plan:)
+      account_settings_url(plan: plan)
+    end
+
+    def billing_cancel_url
+      account_settings_url
+    end
+end
