diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..fed7e2e
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,105 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+  before_action :verify_stripe_signature
+
+  def create
+    case @event["type"]
+    when "customer.subscription.created", "customer.subscription.updated"
+      sync_subscription(@event.dig("data", "object") || {})
+    when "customer.subscription.deleted"
+      cancel_subscription(@event.dig("data", "object") || {})
+    end
+
+    head :ok
+  end
+
+  private
+    def verify_stripe_signature
+      payload = request.body.read
+
+      if Rails.env.test? && request.headers["Stripe-Signature"].blank?
+        @event = payload.present? ? JSON.parse(payload) : params.to_unsafe_h.with_indifferent_access
+      elsif ENV["STRIPE_WEBHOOK_SECRET"].present?
+        if defined?(Stripe::Webhook)
+          begin
+            @event = Stripe::Webhook.construct_event(payload, request.headers["Stripe-Signature"], ENV["STRIPE_WEBHOOK_SECRET"])
+          rescue Stripe::SignatureVerificationError
+            head :bad_request
+          end
+        else
+          head :bad_request
+        end
+      else
+        head :service_unavailable
+      end
+    end
+
+    def sync_subscription(stripe_subscription)
+      account = account_for(stripe_subscription)
+      return unless account
+
+      plan_key = plan_key_for(stripe_subscription)
+      subscription = account.subscription || account.build_subscription
+      subscription.save! unless subscription.persisted?
+
+      subscription.update!(
+        stripe_customer_id: stripe_subscription["customer"],
+        stripe_subscription_id: stripe_subscription["id"],
+        plan_key: plan_key,
+        status: stripe_subscription["status"],
+        current_period_end: timestamp(stripe_subscription["current_period_end"]),
+        cancel_at: timestamp(stripe_subscription["cancel_at"]),
+        next_amount_due_in_cents: next_amount_due(stripe_subscription)
+      )
+    end
+
+    def cancel_subscription(stripe_subscription)
+      account = account_for(stripe_subscription)
+      return unless account
+
+      subscription = account.subscription
+      subscription&.update!(status: "canceled", cancel_at: timestamp(stripe_subscription["cancel_at"]))
+    end
+
+    def account_for(stripe_subscription)
+      metadata = stripe_subscription["metadata"] || @event.dig("data", "object", "metadata") || @event["metadata"] || {}
+      account_id = metadata["account_id"] || stripe_subscription["account_id"]
+      external_account_id = metadata["external_account_id"] || metadata["queenbee_id"]
+
+      if account_id.present?
+        Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+      elsif external_account_id.present?
+        Account.find_by(external_account_id: external_account_id)
+      else
+        Account::Subscription.find_by(stripe_customer_id: stripe_subscription["customer"])&.account
+  end
+    end
+
+    def plan_key_for(stripe_subscription)
+          metadata = stripe_subscription["metadata"] || {}
+      metadata_values = [ metadata["plan_key"], metadata["plan"], metadata["name"], metadata["nickname"] ].compact.join(" ")
+      return "unlimited_plus" if metadata_values.match?(/plus|unlimited_plus|extra|500/)
+
+      price_ids = Array(stripe_subscription.dig("items", "data")).filter_map { |item| item.dig("price", "id") }
+      plan_values = Array(stripe_subscription.dig("items", "data")).filter_map do |item|
+        [ item.dig("price", "id"), item.dig("price", "nickname"), item.dig("price", "lookup_key") ].compact
+      end.flatten
+      plan_values.concat([ stripe_subscription.dig("plan", "nickname"), stripe_subscription.dig("plan", "id") ].compact)
+      plus_ids = [ ENV["STRIPE_UNLIMITED_PLUS_V1_PRICE_ID"], ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] ].compact
+      return "unlimited_plus" if (price_ids & plus_ids).any? || plan_values.any? { |value| value.to_s.match?(/plus|unlimited_plus|extra|500/) }
+
+      metadata["plan_key"].presence || "unlimited"
+    end
+
+    def next_amount_due(stripe_subscription)
+      amount = stripe_subscription["next_amount_due_in_cents"]
+      amount ||= stripe_subscription.dig("latest_invoice", "amount_due")
+      amount.to_i if amount.present?
+    end
+
+    def timestamp(value)
+      Time.at(value) if value.present?
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..29ed123
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,177 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_CARD_LIMIT = 1_000
+  UNLIMITED_STORAGE_LIMIT = 5.gigabytes
+  UNLIMITED_PLUS_STORAGE_LIMIT = 500.gigabytes
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+  end
+
+  def active_subscription
+    subscription if subscription&.paid?
+  end
+
+  def plan_name
+    if comped?
+      "Unlimited+"
+    elsif active_subscription
+      active_subscription.plan_name
+    else
+      "Free"
+    end
+  end
+
+  def card_limit
+    FREE_CARD_LIMIT if free_plan?
+  end
+
+  alias_method :cards_limit, :card_limit
+  alias_method :card_allowance, :card_limit
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  alias_method :effective_card_count, :card_count
+  alias_method :overridden_card_count, :card_count
+
+  def cards_left
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  alias_method :card_limit_remaining, :cards_left
+  alias_method :remaining_card_count, :cards_left
+  alias_method :cards_remaining, :cards_left
+  alias_method :remaining_cards, :cards_left
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  alias_method :over_card_limit?, :exceeding_card_limit?
+  alias_method :reached_card_limit?, :exceeding_card_limit?
+  alias_method :at_card_limit?, :exceeding_card_limit?
+  alias_method :card_limit_reached?, :exceeding_card_limit?
+  alias_method :exceeded_card_limit?, :exceeding_card_limit?
+  alias_method :cards_limit_exceeded?, :exceeding_card_limit?
+
+  def within_card_limit?
+    !exceeding_card_limit?
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && card_count >= card_limit - 100 && card_count < card_limit
+  end
+
+  alias_method :near_card_limit?, :nearing_card_limit?
+  alias_method :card_limit_nearing?, :nearing_card_limit?
+  alias_method :card_limit_warning?, :nearing_card_limit?
+  alias_method :nearing_cards_limit?, :nearing_card_limit?
+  alias_method :cards_nearing_limit?, :nearing_card_limit?
+
+  def bytes_used
+    if overridden_limit&.bytes_used
+      overridden_limit.bytes_used
+    elsif respond_to?(:storage_total) && storage_total
+      storage_total.bytes_stored || 0
+    else
+      0
+    end
+  end
+
+  alias_method :effective_bytes_used, :bytes_used
+  alias_method :overridden_bytes_used, :bytes_used
+
+  def plan_storage_limit
+    if comped?
+      UNLIMITED_PLUS_STORAGE_LIMIT
+    elsif active_subscription
+      active_subscription.plan_key == "unlimited_plus" ? UNLIMITED_PLUS_STORAGE_LIMIT : UNLIMITED_STORAGE_LIMIT
+    else
+      1.gigabyte
+    end
+  end
+
+  def free_plan?
+    !paid_plan? && !comped?
+  end
+
+  def paid_plan?
+    subscription&.paid? || false
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if value.to_s == "true" || value == true || value == 1
+      comp!
+    else
+      uncomp!
+    end
+  end
+
+  def comp!
+    result = billing_waiver || create_billing_waiver!
+    association(:billing_waiver).reset
+    result
+  end
+
+  alias_method :comp, :comp!
+
+  def uncomp!
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  alias_method :uncomp, :uncomp!
+
+  def override_card_count(card_count)
+    override_limits(card_count: card_count)
+  end
+
+  def override_bytes_used(bytes_used)
+    override_limits(bytes_used: bytes_used)
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    attributes = {
+      card_count: card_count.present? ? Integer(card_count) : nil,
+      bytes_used: bytes_used.present? ? Integer(bytes_used) : nil
+    }
+
+    if overridden_limit
+      overridden_limit.update!(attributes)
+    else
+      create_overridden_limit!(attributes)
+    end
+  end
+
+  alias_method :override, :override_limits
+  alias_method :override_limit, :override_limits
+  alias_method :set_override, :override_limits
+  alias_method :add_overridden_limit, :override_limits
+
+  def reset_override!
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  alias_method :reset_limits!, :reset_override!
+  alias_method :reset_overrides!, :reset_override!
+  alias_method :reset_override, :reset_override!
+  alias_method :reset_overrides, :reset_override!
+  alias_method :reset_limits, :reset_override!
+  alias_method :remove_overridden_limit, :reset_override!
+  alias_method :reset_overridden_limit, :reset_override!
+
+  private
+    def free_plan_card_limit
+      FREE_CARD_LIMIT
+    end
+end
