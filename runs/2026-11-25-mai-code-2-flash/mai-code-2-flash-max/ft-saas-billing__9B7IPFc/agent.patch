diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..6cb2053
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,54 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :account_id, uniqueness: true
+
+  PAID_STATUSES = %w[ active trialing past_due ].freeze
+
+  def plan_key
+    normalize_plan_key(super)
+  end
+
+  def paid?
+    PAID_STATUSES.include?(status.to_s) && plan_key.present? && plan_key != "free"
+  end
+
+  alias_method :active?, :paid?
+
+  def cancelled?
+    status.in?(%w[ canceled cancelled ])
+  end
+
+  def plan_name
+    case plan_key
+    when "unlimited_plus" then "Unlimited+"
+    when "unlimited" then "Unlimited"
+    else "Free"
+    end
+  end
+
+  def storage_limit
+    case plan_key
+    when "unlimited_plus" then Account::Billing::UNLIMITED_PLUS_STORAGE_LIMIT
+    when "unlimited" then Account::Billing::UNLIMITED_STORAGE_LIMIT
+    else 1.gigabyte
+    end
+  end
+
+  def card_limit
+    nil
+  end
+
+  private
+    def normalize_plan_key(value)
+      value = value.to_s.downcase
+
+      if value.match?(/unlimited.?plus|extra|plus|500gb/)
+        "unlimited_plus"
+      elsif value.match?(/unlimited|monthly_v1|monthly/) || value == "unlimitedv1"
+        "unlimited"
+      else
+        "free"
+      end
+    end
+end
