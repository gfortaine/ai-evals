diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..460596d
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "staff can list accounts and open an account" do
+    untenanted do
+      get saas.admin_accounts_path
+    end
+    assert_response :success
+
+    untenanted do
+      get saas.admin_account_path(accounts(:initech))
+    end
+    assert_response :success
+    assert_select "button", text: "Comp"
+  end
+
+  test "comp and uncomp an account" do
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account)
+      assert account.reload.comped?
+
+      post saas.admin_account_uncomp_path(account)
+      assert_not account.reload.comped?
+    end
+  end
+
+  test "override and reset usage" do
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_override_path(account), params: { card_count: 950, bytes_used: 123 }
+    end
+
+    assert_equal 950, account.reload.card_count
+    assert_equal 123, account.bytes_used
+
+    untenanted do
+      post saas.admin_account_reset_path(account)
+    end
+
+    assert_nil account.reload.overridden_limit
+  end
+
+  test "non-staff cannot access support tools" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..c255af7
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription created event syncs an unlimited plan" do
+    account = accounts(:initech)
+
+    post "/stripe/webhooks", params: {
+      type: "customer.subscription.created",
+      data: { object: {
+        id: "sub_test",
+        customer: "cus_test",
+        status: "active",
+        metadata: { account_id: account.id, plan_key: "unlimited" },
+        items: { data: [ { price: { id: "price_unlimited" } } ] }
+      } }
+    }.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+
+    subscription = account.reload.subscription
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "sub_test", subscription.stripe_subscription_id
+  end
+
+  test "subscription updated event syncs unlimited plus" do
+    account = accounts(:initech)
+
+    post "/stripe/webhooks", params: {
+      type: "customer.subscription.updated",
+      data: { object: {
+        id: "sub_test_plus",
+        customer: "cus_test_plus",
+        status: "active",
+        metadata: { account_id: account.id, plan_key: "unlimited_plus" }
+      } }
+    }.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    assert_equal "unlimited_plus", account.reload.subscription.plan_key
+  end
+
+  test "subscription deleted event cancels the local subscription" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_test")
+
+    post "/stripe/webhooks", params: {
+      type: "customer.subscription.deleted",
+      data: { object: {
+        id: "sub_test",
+        customer: "cus_test",
+        status: "canceled",
+        metadata: { account_id: account.id }
+      } }
+    }.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    assert_equal "canceled", account.reload.subscription.status
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..7531ff4
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan has the approved card limit" do
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1_000, @account.cards_left
+  end
+
+  test "card warning starts 100 cards out" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_left
+  end
+
+  test "card limit is reached at 1000 cards" do
+    @account.update_column(:cards_count, 1_000)
+    assert @account.exceeding_card_limit?
+  end
+
+  test "paid unlimited plan has card and storage allowances" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active")
+
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.plan_storage_limit
+  end
+
+  test "paid unlimited plus plan has card and storage allowances" do
+    @account.create_subscription!(plan_key: "unlimited_plus", status: "active")
+
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.plan_storage_limit
+  end
+
+  test "support override replaces usage counts" do
+    @account.override_limits(card_count: 950, bytes_used: 123)
+
+    assert_equal 950, @account.card_count
+    assert_equal 123, @account.bytes_used
+
+    @account.reset_override!
+    assert_equal @account.cards_count, @account.card_count
+  end
+
+  test "comped account has unlimited plus storage and no card limit" do
+    @account.comp!
+
+    assert @account.comped?
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.plan_storage_limit
+  end
+end
