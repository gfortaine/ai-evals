 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
   end
 
+  test "releasing a book caches the released title and published status" do
+    book = Book.create!(title: "Working title")
+
+    assert Book.finalize_release(book.id, title: "Released title")
+
+    assert_equal({ title: "Released title", published: true }, book.cached_recap)
+  end
+
+  test "saving a book only updates that book's recap" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "First title")
+    manual.update!(title: "Second title")
+
+    assert_equal "First title", handbook.cached_recap[:title]
+    assert_equal "Second title", manual.cached_recap[:title]
+
+    handbook.update!(title: "Renamed title")
+
+    assert_equal "Renamed title", handbook.cached_recap[:title]
+    assert_equal "Second title", manual.cached_recap[:title]
+  end
+
+  test "recaps expire after the configured duration" do
+    original_expires_in = Rails.application.config.x.recap.expires_in
+    Rails.application.config.x.recap.expires_in = 10.minutes
+
+    book = Book.create!(title: "Temporary recap")
+    book.update!(title: "Temporary recap updated")
+
+    travel_to Time.current do
+      assert_not_nil book.cached_recap
+      travel 11.minutes
+      assert_nil book.cached_recap
+    end
+  ensure
+    Rails.application.config.x.recap.expires_in = original_expires_in
+  end
+
