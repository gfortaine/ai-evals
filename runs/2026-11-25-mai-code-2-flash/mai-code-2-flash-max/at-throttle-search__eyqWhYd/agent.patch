 class Books::SearchesControllerTest < ActionDispatch::IntegrationTest
   setup do
+    Rails.cache.clear
     sign_in :kevin
 
     Leaf.reindex_all
   end
 
+  test "create allows thirty searches from an address in a minute" do
+    30.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }
+      assert_response :success
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }
+    assert_response :too_many_requests
+  end
+
+  test "create recovers after one minute without manual unblocking" do
+    freeze_time do
+      31.times do |index|
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }
+        assert_response(index < 30 ? :success : :too_many_requests)
+      end
+
+      travel 1.minute
+
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }
+      assert_response :success
+    end
+  end
+
+  test "create limits addresses independently" do
+    integration_session.remote_addr = "198.51.100.10"
+
+    31.times do |index|
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }
+      assert_response(index < 30 ? :success : :too_many_requests)
+    end
+
+    integration_session.remote_addr = "198.51.100.11"
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }
+    assert_response :success
+  end
+
+  test "create limiting does not block opening a published book" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    31.times do |index|
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }
+      assert_response(index < 30 ? :success : :too_many_requests)
+    end
+
+    get book_slug_path(books(:handbook))
+    assert_response :success
+  end
+
