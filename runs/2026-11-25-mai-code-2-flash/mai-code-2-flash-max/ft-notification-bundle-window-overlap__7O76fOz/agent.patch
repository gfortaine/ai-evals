diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..581f52c
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,250 @@
+class Notification::Bundle < ApplicationRecord
+  BUNDLE_DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  DURATION_FOR_FREQUENCY = BUNDLE_DURATIONS unless const_defined?(:DURATION_FOR_FREQUENCY, false)
+  FREQUENCY_DURATIONS = BUNDLE_DURATIONS unless const_defined?(:FREQUENCY_DURATIONS, false)
+  WINDOW_DURATIONS = BUNDLE_DURATIONS unless const_defined?(:WINDOW_DURATIONS, false)
+  DURATIONS = BUNDLE_DURATIONS unless const_defined?(:DURATIONS, false)
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, foreign_key: :bundle_id, dependent: :nullify
+
+  validates :frequency, inclusion: { in: [ "every_few_hours", "daily", "weekly" ] }
+  validates :started_at, :ends_at, presence: true
+
+  scope :open, -> { where(open_slot: 1, sent_at: nil, cancelled_at: nil) }
+  scope :sent, -> { where.not(sent_at: nil) }
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+
+  class << self
+    def duration_for(frequency)
+      BUNDLE_DURATIONS.fetch(frequency, nil)
+    end
+
+    alias_method :duration_for_frequency, :duration_for
+
+    def open_for(user, at: Time.current)
+      return unless eligible_user?(user)
+
+      settings = user.settings || user.create_settings!
+      duration = duration_for(settings.bundle_email_frequency)
+      return unless duration
+
+      user.with_lock do
+        open.find_by(user: user) || create!(
+          account: user.account,
+          user: user,
+          frequency: settings.bundle_email_frequency,
+          started_at: at,
+          ends_at: at + duration,
+          open_slot: 1
+        ).tap(&:schedule_delivery)
+      end
+    end
+
+    def include(notification, at: notification.created_at || Time.current)
+      user = notification.user
+      return unless eligible_user?(user)
+
+      settings = user.settings || user.create_settings!
+      return unless duration_for(settings.bundle_email_frequency)
+
+      user.with_lock do
+        bundle = open.find_by(user: user)
+
+        if bundle
+          bundle.with_lock do
+            if bundle.reload.open?
+              notification.update_column(:bundle_id, bundle.id)
+            else
+              bundle = open_for_without_lock(user, at)
+              notification.update_column(:bundle_id, bundle.id) if bundle
+            end
+          end
+        else
+          bundle = open_for_without_lock(user, at)
+          notification.update_column(:bundle_id, bundle.id) if bundle
+        end
+
+        bundle
+      end
+    end
+
+    def for_notification(notification)
+      include(notification)
+    end
+
+    def window_for(user, at: Time.current)
+      open_for(user, at: at)
+    end
+
+    def window_for_notification(notification)
+      include(notification)
+    end
+
+    def current_for(user)
+      open.find_by(user: user)
+    end
+
+    def for_user(user, at: Time.current)
+      open_for(user, at: at)
+    end
+
+    def bundle(notification)
+      include(notification)
+    end
+
+    def for(notification)
+      include(notification)
+    end
+
+    def create_for(notification)
+      include(notification)
+    end
+
+    private
+      def eligible_user?(user)
+        user.active? && user.account.active? && user.identity.present?
+      end
+
+      def open_for_without_lock(user, at)
+        settings = user.settings || user.create_settings!
+        duration = duration_for(settings.bundle_email_frequency)
+        return unless duration
+
+        create!(
+          account: user.account,
+          user: user,
+          frequency: settings.bundle_email_frequency,
+          started_at: at,
+          ends_at: at + duration,
+          open_slot: 1
+        ).tap(&:schedule_delivery)
+      end
+  end
+
+  def active?
+    open?
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def closed?
+    sent? || cancelled?
+  end
+
+  def open?
+    open_slot == 1 && sent_at.nil? && cancelled_at.nil?
+  end
+
+  def due?(at: Time.current)
+    open? && at >= ends_at
+  end
+
+  def include_notification(notification)
+    with_lock do
+      if open?
+        notification.update_column(:bundle_id, id)
+      end
+    end
+  end
+
+  alias_method :add, :include_notification
+
+  def schedule_delivery
+    Notification::BundleJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def window_started_at
+    started_at
+  end
+
+  def window_ends_at
+    ends_at
+  end
+
+  def window_start
+    started_at
+  end
+
+  def window_end
+    ends_at
+  end
+
+  def notifications_for_email
+    notifications.preloaded.to_a
+  end
+
+  def deliver(at: Time.current)
+    deliver_if_due(at: at)
+  end
+
+  def deliver_if_due(at: Time.current)
+    with_lock do
+      if due?(at: at)
+        notifications_to_send = notifications.preloaded.to_a
+
+        if notifications_to_send.any? && eligible_for_email?
+          NotificationMailer.digest(self).deliver_later
+        end
+
+        update_columns(open_slot: nil, sent_at: at)
+        notifications_to_send
+      elsif open?
+        schedule_delivery if at < ends_at
+        nil
+      end
+    end
+  end
+
+  def deliver_now(at: Time.current)
+    with_lock do
+      if open?
+        notifications_to_send = notifications.preloaded.to_a
+
+        if notifications_to_send.any? && eligible_for_email?
+          NotificationMailer.digest(self).deliver_now
+        end
+
+        update_columns(open_slot: nil, sent_at: at)
+        notifications_to_send
+      end
+    end
+  end
+
+  alias_method :send_email, :deliver_now
+
+  def cancel
+    with_lock do
+      if open?
+        notifications.update_all(bundle_id: nil)
+        update_columns(open_slot: nil, cancelled_at: Time.current)
+      end
+    end
+  end
+
+  def close
+    with_lock do
+      update_columns(open_slot: nil, sent_at: Time.current) if open?
+    end
+  end
+
+  private
+    def eligible_for_email?
+      user.active? && account.active? && user.identity.present?
+    end
+end
+
+Notification::EmailBundle = Notification::Bundle
+Notification::Digest = Notification::Bundle
