diff --git a/test/jobs/notification/bundle_job_test.rb b/test/jobs/notification/bundle_job_test.rb
new file mode 100644
index 0000000..b71f40e
--- /dev/null
+++ b/test/jobs/notification/bundle_job_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Notification::BundleJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.delete_all
+    Notification::Bundle.delete_all
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "scheduled job does not deliver before the window ends" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to Time.utc(2026, 11, 23, 10)
+    notification = Notification.create!(
+      user: @user,
+      source: events(:layout_commented),
+      creator: users(:david)
+    )
+    bundle = notification.bundle
+
+    travel 1.hour
+    Notification::BundleJob.perform_now(bundle)
+
+    assert bundle.reload.open?
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "scheduled job closes the window when it is due" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to Time.utc(2026, 11, 23, 10)
+    notification = Notification.create!(
+      user: @user,
+      source: events(:layout_commented),
+      creator: users(:david)
+    )
+    bundle = notification.bundle
+
+    travel 4.hours
+    perform_enqueued_jobs only: [ Notification::BundleJob, ActionMailer::MailDeliveryJob ] do
+      Notification::BundleJob.perform_now(bundle)
+    end
+
+    assert_not bundle.reload.open?
+    assert_equal 1, ActionMailer::Base.deliveries.size
+  end
+end
diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..43f007c
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.delete_all
+    Notification::Bundle.delete_all
+    @user.settings.update!(bundle_email_frequency: "daily")
+  end
+
+  test "digest sends to the user and includes the bundled notifications" do
+    first = Notification.create!(
+      user: @user,
+      source: events(:layout_commented),
+      creator: users(:david)
+    )
+    Notification.create!(
+      user: @user,
+      source: events(:buy_domain_sent_back_to_triage),
+      creator: users(:david)
+    )
+
+    email = NotificationMailer.digest(first.bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "Your Fizzy notification digest", email.subject
+    assert_match "Layout is broken", email.body.encoded
+  end
+
+  test "digest accepts a user and notification list" do
+    notification = Notification.create!(
+      user: @user,
+      source: events(:layout_commented),
+      creator: users(:david)
+    )
+
+    email = NotificationMailer.digest(user: @user, notifications: [ notification ])
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..06725eb
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.delete_all
+    Notification::Bundle.delete_all
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "the clock starts when the first notification lands" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    travel_to Time.utc(2026, 11, 23, 10) do
+      notification = create_notification(events(:layout_commented))
+
+      bundle = notification.reload.bundle
+
+      assert_equal Time.utc(2026, 11, 23, 10), bundle.started_at
+      assert_equal Time.utc(2026, 11, 24, 10), bundle.ends_at
+    end
+  end
+
+  test "every few hours uses a four hour window" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to Time.utc(2026, 11, 23, 10) do
+      bundle = create_notification(events(:layout_commented)).reload.bundle
+
+      assert_equal 4.hours, bundle.ends_at - bundle.started_at
+    end
+  end
+
+  test "weekly uses a seven day window" do
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    travel_to Time.utc(2026, 11, 23, 10) do
+      bundle = create_notification(events(:layout_commented)).reload.bundle
+
+      assert_equal 1.week, bundle.ends_at - bundle.started_at
+    end
+  end
+
+  test "late notifications join the open window" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to Time.utc(2026, 11, 23, 10)
+    first = create_notification(events(:layout_commented))
+
+    travel 3.hours
+    late = create_notification(events(:buy_domain_sent_back_to_triage))
+
+    assert_equal first.reload.bundle, late.reload.bundle
+    assert_equal 1, Notification::Bundle.open.where(user: @user).count
+  end
+
+  test "sending closes the window before the next notification opens another" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to Time.utc(2026, 11, 23, 10)
+    first = create_notification(events(:layout_commented))
+    first_bundle = first.reload.bundle
+
+    travel 4.hours
+    assert_equal [ first ], first_bundle.deliver_now
+
+    late = create_notification(events(:buy_domain_sent_back_to_triage))
+
+    assert_not_equal first_bundle, late.reload.bundle
+    assert_equal 1, Notification::Bundle.open.where(user: @user).count
+  end
+
+  test "a never setting prevents a bundle" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    notification = create_notification(events(:layout_commented))
+
+    assert_nil notification.reload.bundle
+  end
+
+  test "a never setting cancels an open window" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    notification = create_notification(events(:layout_commented))
+    bundle = notification.reload.bundle
+
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_not bundle.reload.open?
+    assert_nil notification.reload.bundle
+  end
+
+  test "delivering one window sends one email for all notifications" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    first = create_notification(events(:layout_commented))
+    second = create_notification(events(:buy_domain_sent_back_to_triage))
+    bundle = first.reload.bundle
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      bundle.deliver_now
+    end
+
+    assert_not bundle.reload.open?
+    assert_equal 2, bundle.notifications.count
+    assert_equal bundle, second.reload.bundle
+  end
+
+  private
+    def create_notification(source)
+      Notification.create!(
+        user: @user,
+        source: source,
+        creator: users(:david)
+      )
+    end
+end
