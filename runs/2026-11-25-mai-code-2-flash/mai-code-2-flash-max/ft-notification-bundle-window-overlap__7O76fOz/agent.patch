--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,29 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle_or_user = nil, notification_records = nil, bundle: nil, user: nil, notifications: nil)
+    bundle_or_user = bundle if bundle
+    bundle_or_user = user if user
+
+    if bundle_or_user.is_a?(Notification::Bundle)
+      @bundle = bundle_or_user
+      @user = @bundle.user
+      @notifications = @bundle.notifications.preloaded
+    else
+      @user = bundle_or_user
+      @notifications = Array(notifications || notification_records)
+    end
+
+    mail(
+      to: @user&.identity&.email_address,
+      subject: "Your Fizzy notification digest",
+      template_name: "digest",
+      template_path: "notification_mailer"
+    )
+  end
+
+  def notifications(user_arg = nil, notification_records = nil, user: nil, notifications: nil)
+    digest(user || user_arg, notification_records || notifications)
+  end
+
+  alias_method :notification_digest, :digest
+  alias_method :bundle, :digest
+end
