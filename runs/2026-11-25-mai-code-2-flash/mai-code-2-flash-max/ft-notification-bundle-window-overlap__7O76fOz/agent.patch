+++ b/app/jobs/notification/bundle_job.rb
@@ -0,0 +1,13 @@
+class Notification::BundleJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bundle)
+    if bundle.is_a?(Notification::Bundle)
+      bundle.deliver_if_due
+    elsif bundle.is_a?(User)
+      Notification::Bundle.open.find_by(user: bundle)&.deliver_if_due
+    else
+      Notification::Bundle.find_by(id: bundle)&.deliver_if_due
+    end
+  end
+end
