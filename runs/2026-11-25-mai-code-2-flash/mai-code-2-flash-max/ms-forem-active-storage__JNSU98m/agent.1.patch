diff --git a/spec/models/profile_imageable_spec.rb b/spec/models/profile_imageable_spec.rb
new file mode 100644
index 0000000..0e374a9
--- /dev/null
+++ b/spec/models/profile_imageable_spec.rb
@@ -0,0 +1,57 @@
+require "rails_helper"
+
+RSpec.describe "ProfileImageable" do
+  def png_attachable
+    {
+      io: StringIO.new(Rails.root.join("app/assets/images/1.png").binread),
+      filename: "profile.png",
+      content_type: "image/png"
+    }
+  end
+
+  describe User do
+    it "stores new profile images with Active Storage" do
+      user = create(:user)
+
+      user.profile_image.attach(png_attachable)
+      user.save!
+
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image_attachment).to be_present
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "falls back to an existing CarrierWave profile image" do
+      user = create(:user)
+      user.profile_image.purge
+      user.update_column(:profile_image, "legacy-profile.png")
+      user.reload
+
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to be_present
+    end
+  end
+
+  describe Organization do
+    it "stores new profile images with Active Storage" do
+      organization = create(:organization)
+
+      organization.profile_image.attach(png_attachable)
+      organization.save!
+
+      expect(organization.profile_image).to be_attached
+      expect(organization.profile_image_attachment).to be_present
+      expect(organization.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "falls back to an existing CarrierWave profile image" do
+      organization = create(:organization)
+      organization.profile_image.purge
+      organization.update_column(:profile_image, "legacy-profile.png")
+      organization.reload
+
+      expect(organization.profile_image).not_to be_attached
+      expect(organization.profile_image_url).to be_present
+    end
+  end
+end
