diff --git a/app/models/concerns/profile_imageable.rb b/app/models/concerns/profile_imageable.rb
new file mode 100644
index 0000000..98de90b
--- /dev/null
+++ b/app/models/concerns/profile_imageable.rb
@@ -0,0 +1,267 @@
+require "tempfile"
+
+module ProfileImageable
+  extend ActiveSupport::Concern
+
+  PROFILE_IMAGE_MAX_SIZE = 8.megabytes
+  PROFILE_IMAGE_EXTENSION_ALLOWLIST = %w[jpg jpeg jpe gif png ico bmp dng webp].freeze
+
+  included do
+    mount_uploader :legacy_profile_image, ProfileImageUploader, mount_on: :profile_image
+    has_one_attached :profile_image
+
+    validate :validate_profile_image_attachment
+  end
+
+  def profile_image
+    attachment = @active_storage_profile_image ||=
+      ActiveStorage::Attached::One.new("profile_image", self)
+
+    configure_profile_image_attachment(attachment, legacy_profile_image)
+    attachment
+  end
+
+  def profile_image=(attachable)
+    @profile_image_changed = true
+    @profile_image_invalid_size = false
+
+    if attachable.nil? || attachable == ""
+      self[:profile_image] = nil
+    end
+
+    if attachable.is_a?(String) && attachable.start_with?("http")
+      self.remote_profile_image_url = attachable
+      return
+    end
+
+    attachable = prepare_profile_image_attachable(attachable)
+
+    attachment_changes["profile_image"] =
+      if attachable.nil? || attachable == ""
+        ActiveStorage::Attached::Changes::DeleteOne.new("profile_image", self)
+      else
+        ActiveStorage::Attached::Changes::CreateOne.new("profile_image", self, attachable)
+      end
+  end
+
+  def remote_profile_image_url=(url)
+    @remote_profile_image_url = url
+    @profile_image_changed = true
+    return if url.blank?
+    return unless url.to_s.start_with?("http")
+
+    require "open-uri"
+
+    downloaded = nil
+    downloaded = URI.parse(url).open(read_timeout: 10, open_timeout: 10)
+    filename = File.basename(URI.parse(url).path)
+    filename = "profile_image" if filename.blank?
+
+    tempfile = Tempfile.new(["profile_image", File.extname(filename)])
+    tempfile.binmode
+    IO.copy_stream(downloaded, tempfile)
+    tempfile.rewind
+
+    content_type = begin
+      downloaded.content_type
+    rescue StandardError
+      nil
+    end
+    content_type ||= Marcel::MimeType.for(tempfile.path)
+
+    self.profile_image = {
+      io: tempfile,
+      filename: filename,
+      content_type: content_type
+    }
+  rescue StandardError => e
+    Rails.logger.warn("Could not store remote profile image: #{e.message}")
+  ensure
+    downloaded&.close
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url || profile_image_url
+  end
+
+  def profile_image_url
+    if profile_image.attached?
+      active_storage_blob_url(profile_image.blob)
+    else
+      legacy_profile_image_url
+    end
+  rescue StandardError
+    legacy_profile_image_url
+  end
+
+  def profile_image_url_for(length:)
+    if profile_image.attached?
+      blob = profile_image.blob
+      return active_storage_blob_url(blob) unless blob.variable?
+
+      begin
+        variant = blob.variant(resize_to_fill: [length, length])
+        active_storage_variant_url(variant)
+      rescue StandardError
+        active_storage_blob_url(blob)
+      end
+    else
+      Images::Profile.call(legacy_profile_image_url, length: length)
+    end
+  end
+
+  def profile_image_changed?
+    @profile_image_changed ||
+      (profile_image_attachment.respond_to?(:previous_changes) && profile_image_attachment.previous_changes.present?)
+  end
+
+  private
+
+  def configure_profile_image_attachment(attachment, legacy)
+    attachment.define_singleton_method(:present?) do
+      attachment.attached? || legacy.present?
+    end
+    attachment.define_singleton_method(:blank?) do
+      !attachment.attached? && legacy.blank?
+    end
+
+    attachment.define_singleton_method(:url) do |*args|
+      if attachment.attached?
+        blob = attachment.blob
+        attachment.record.__send__(:active_storage_blob_url, blob)
+      else
+        legacy.url(*args)
+      end
+    end
+
+    attachment.define_singleton_method(:to_s) do
+      if attachment.attached?
+        attachment.record.__send__(:active_storage_blob_url, attachment.blob)
+      else
+        legacy.url.to_s
+      end
+    rescue StandardError
+      legacy.url.to_s
+    end
+
+    attachment.define_singleton_method(:path) do
+      if attachment.attached?
+        attachment.record.__send__(:configure_profile_image_path, attachment)
+      else
+        legacy.path
+      end
+    end
+
+    attachment.define_singleton_method(:file) do
+      if attachment.attached?
+        path = attachment.path
+        path ? CarrierWave::SanitizedFile.new(path) : attachment.blob
+      else
+        legacy.file
+      end
+    end
+
+    attachment.define_singleton_method(:identifier) do
+      attachment.attached? ? attachment.blob.filename.to_s : legacy.identifier
+    end
+  end
+
+  def configure_profile_image_path(attachment)
+    blob = attachment.blob
+    if blob.service.respond_to?(:path_for)
+      blob.service.path_for(blob.key)
+    else
+      tempfile = attachment.instance_variable_get(:@profile_image_tempfile)
+      unless tempfile
+        tempfile = Tempfile.new(["profile_image", File.extname(blob.filename.to_s)])
+        tempfile.binmode
+        blob.download { |chunk| tempfile.write(chunk) }
+        tempfile.flush
+        tempfile.rewind
+        attachment.instance_variable_set(:@profile_image_tempfile, tempfile)
+      end
+      tempfile.path
+    end
+  end
+
+  def active_storage_url_options
+    options = Rails.application.routes.default_url_options.to_h.dup
+    host = options[:host].presence || Rails.application.config.app_domain.presence || ENV["APP_DOMAIN"].presence
+    options[:host] = host if host.present?
+    options[:protocol] ||= "http" if Rails.env.local?
+    options
+  end
+
+  def active_storage_blob_url(blob)
+    Rails.application.routes.url_helpers.rails_blob_url(blob, **active_storage_url_options)
+  rescue StandardError
+    ActiveStorage::Current.set(url_options: active_storage_url_options) do
+      blob.url
+    end
+  end
+
+  def active_storage_variant_url(variant)
+    Rails.application.routes.url_helpers.rails_representation_url(variant, **active_storage_url_options)
+  rescue StandardError
+    ActiveStorage::Current.set(url_options: active_storage_url_options) do
+      variant.url
+    end
+  end
+
+  def prepare_profile_image_attachable(attachable)
+    path = profile_image_attachable_path(attachable)
+    validate_profile_image_processing(path) if path
+
+    attachable
+  rescue StandardError => e
+    Rails.logger.warn("Could not process profile image before Active Storage upload: #{e.message}")
+    attachable
+  end
+
+  def profile_image_attachable_path(attachable)
+    if attachable.is_a?(Hash)
+      io = attachable[:io] || attachable["io"]
+      return io.path if io.respond_to?(:path)
+      return io.tempfile.path if io.respond_to?(:tempfile)
+    elsif attachable.respond_to?(:path)
+      return attachable.path
+    elsif attachable.respond_to?(:tempfile)
+      return attachable.tempfile.path
+    end
+
+    nil
+  end
+
+  def validate_profile_image_processing(path)
+    @profile_image_invalid_size = true if File.size(path) > ProfileImageUploader::MAX_FILE_SIZE
+
+    image = MiniMagick::Image.open(path)
+    @profile_image_invalid_size = true if image.width > 4096 || image.height > 4096
+    image.auto_orient
+    image.strip unless image.frames.count > 150
+    image.write(path)
+  end
+
+  def validate_profile_image_attachment
+    if @profile_image_invalid_size
+      max_size = (ProfileImageUploader::MAX_FILE_SIZE / 1.megabyte.to_f).round
+      errors.add(:profile_image, "File size should be less than #{max_size} MB")
+    end
+
+    return unless profile_image.attached?
+
+    blob = profile_image.blob
+    extension = blob.filename.extension.to_s.downcase
+
+    unless PROFILE_IMAGE_EXTENSION_ALLOWLIST.include?(extension)
+      errors.add(:profile_image, :invalid)
+    end
+
+    if blob.byte_size.blank? || blob.byte_size <= 0
+      errors.add(:profile_image, :blank)
+    elsif blob.byte_size > ProfileImageUploader::MAX_FILE_SIZE
+      max_size = (ProfileImageUploader::MAX_FILE_SIZE / 1.megabyte.to_f).round
+      errors.add(:profile_image, "File size should be less than #{max_size} MB")
+    end
+  end
+end
