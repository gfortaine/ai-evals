diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..1e5ae1c 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,138 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+
+    scope :due_for_incineration, -> { incineration_due }
+    scope :incineratable, -> { incineration_due }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineration_due.find_each(&:incinerate)
+    end
+
+    def account_scoped_table_names
+      @account_scoped_table_names ||= connection.tables.filter do |table_name|
+        connection.columns(table_name).any? { |column| column.name == "account_id" }
+      end
+    end
+  end
+
+  def incineration_due?
+    Account::Cancellation
+      .where(account_id: id)
+      .where(created_at: ...INCINERATION_GRACE_PERIOD.ago)
+      .exists?
+  end
+
+  alias_method :due_for_incineration?, :incineration_due?
+  alias_method :incineratable?, :incineration_due?
+  alias_method :incinerate_due?, :incineration_due?
+
+  def incinerate
+    with_lock do
+      if incineration_due?
+        transaction do
+          purge_join_tables
+          purge_storage_totals
+          destroy!
+          purge_account_scoped_tables
+          purge_orphaned_search_index_entries
+        end
+      end
+    end
+  end
+
+  private
+    def purge_join_tables
+      purge_join_table "assignees_filters", [ [ "assignee_id", "users" ], [ "filter_id", "filters" ] ]
+      purge_join_table "assigners_filters", [ [ "assigner_id", "users" ], [ "filter_id", "filters" ] ]
+      purge_join_table "boards_filters", [ [ "board_id", "boards" ], [ "filter_id", "filters" ] ]
+      purge_join_table "closers_filters", [ [ "closer_id", "users" ], [ "filter_id", "filters" ] ]
+      purge_join_table "creators_filters", [ [ "creator_id", "users" ], [ "filter_id", "filters" ] ]
+      purge_join_table "filters_tags", [ [ "filter_id", "filters" ], [ "tag_id", "tags" ] ]
+    end
+
+    def purge_join_table(table_name, columns_and_sources)
+      connection = ActiveRecord::Base.connection
+      return unless connection.table_exists?(table_name)
+
+      conditions = columns_and_sources.filter_map do |column, source_table|
+        if connection.table_exists?(source_table) && connection.columns(source_table).any? { |source_column| source_column.name == "account_id" }
+          <<~SQL.squish
+            #{connection.quote_column_name(column)} IN (
+              SELECT id FROM #{connection.quote_table_name(source_table)}
+              WHERE #{connection.quote_column_name("account_id")} = #{connection.quote(id)}
+            )
+          SQL
+        end
+      end
+
+      if conditions.any?
+        connection.execute <<~SQL
+          DELETE FROM #{connection.quote_table_name(table_name)}
+          WHERE #{conditions.join(" OR ")}
+        SQL
+      end
+    end
+
+    def purge_storage_totals
+      connection = ActiveRecord::Base.connection
+      return unless connection.table_exists?("storage_totals")
+
+      quoted_id = connection.quote(id)
+      quoted_account_type = connection.quote("Account")
+      quoted_board_type = connection.quote("Board")
+
+      board_condition = if connection.table_exists?("boards")
+        <<~SQL.squish
+          #{connection.quote_column_name("owner_id")} IN (
+            SELECT id FROM #{connection.quote_table_name("boards")}
+            WHERE #{connection.quote_column_name("account_id")} = #{quoted_id}
+          )
+        SQL
+      end
+
+      conditions = [
+        "#{connection.quote_column_name("owner_type")} = #{quoted_account_type} AND #{connection.quote_column_name("owner_id")} = #{quoted_id}"
+      ]
+      conditions << "#{connection.quote_column_name("owner_type")} = #{quoted_board_type} AND #{board_condition}" if board_condition
+
+      connection.execute <<~SQL
+        DELETE FROM #{connection.quote_table_name("storage_totals")}
+        WHERE #{conditions.join(" OR ")}
+      SQL
+    end
+
+    def purge_account_scoped_tables
+      connection = ActiveRecord::Base.connection
+      quoted_id = connection.quote(id)
+
+      self.class.account_scoped_table_names.each do |table_name|
+        connection.execute <<~SQL
+          DELETE FROM #{connection.quote_table_name(table_name)}
+          WHERE #{connection.quote_column_name("account_id")} = #{quoted_id}
+        SQL
+      end
+    end
+
+    def purge_orphaned_search_index_entries
+      connection = ActiveRecord::Base.connection
+      return unless connection.adapter_name == "SQLite"
+      return unless connection.table_exists?("search_records_fts")
+      return unless connection.table_exists?("search_records")
+
+      connection.execute <<~SQL
+        DELETE FROM #{connection.quote_table_name("search_records_fts")}
+        WHERE rowid NOT IN (
+          SELECT id FROM #{connection.quote_table_name("search_records")}
+        )
+      SQL
+    end
 end
