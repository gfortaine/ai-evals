diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..cb6d4b0
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @due_account = accounts(:initech)
+    @recent_account = accounts(:acme)
+    @initiator = users(:david)
+  end
+
+  test "incinerates canceled accounts whose grace period has passed" do
+    cancel @due_account, 31.days.ago
+    cancel @recent_account, 29.days.ago
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@due_account.id)
+    assert Account.exists?(@recent_account.id)
+  end
+
+  test "removes account-scoped data" do
+    due_user = @due_account.users.create!(identity: @initiator.identity, name: "Initech user")
+    board = @due_account.boards.create!(name: "Initech board", creator: due_user)
+    card = board.cards.create!(title: "Initech card", creator: due_user, number: 987654)
+    tag = @due_account.tags.create!(title: "initech")
+
+    cancel @due_account, 31.days.ago
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not User.exists?(due_user.id)
+    assert_not Board.exists?(board.id)
+    assert_not Card.exists?(card.id)
+    assert_not Tag.exists?(tag.id)
+  end
+
+  private
+    def cancel(account, canceled_at)
+      account.cancel(initiated_by: @initiator)
+      account.cancellation.update_column(:created_at, canceled_at)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..d331287
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "incineration is due more than 30 days after cancellation" do
+    @account.cancel(initiated_by: @user)
+
+    @account.cancellation.update_column(:created_at, 31.days.ago)
+    assert @account.incineration_due?
+
+    @account.cancellation.update_column(:created_at, 29.days.ago)
+    assert_not @account.incineration_due?
+  end
+
+  test "incinerate permanently destroys the account and its data" do
+    Current.with_account(@account) do
+      Current.user = @user
+      board = @account.boards.create!(name: "Temporary", creator: @user)
+      card = board.cards.create!(title: "Temporary card", creator: @user, number: 987655, status: :published)
+      comment = card.comments.create!(body: "Temporary comment", creator: @user)
+
+      @account.cancel(initiated_by: @user)
+      @account.cancellation.update_column(:created_at, 31.days.ago)
+
+      @account.incinerate
+
+      assert_not Account.exists?(@account.id)
+      assert_not Board.exists?(board.id)
+      assert_not Card.exists?(card.id)
+      assert_not Comment.exists?(comment.id)
+    end
+  end
+end
