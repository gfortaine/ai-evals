diff --git a/app/models/concerns/profile_image_attachment.rb b/app/models/concerns/profile_image_attachment.rb
new file mode 100644
index 0000000..b66c16a
--- /dev/null
+++ b/app/models/concerns/profile_image_attachment.rb
@@ -0,0 +1,326 @@
+require "open-uri"
+require "tempfile"
+
+module ProfileImageAttachment
+  extend ActiveSupport::Concern
+
+  CarrierWaveCompatibilityFile = Struct.new(:file)
+
+  module AttachmentCompatibility
+    def blank?
+      !attached? && record.__send__(:carrierwave_profile_image).blank?
+    end
+
+    def file
+      if attached?
+        CarrierWaveCompatibilityFile.new(downloaded_profile_image_file.path)
+      else
+        record.__send__(:carrierwave_profile_image).file
+      end
+    end
+
+    def path
+      attached? ? downloaded_profile_image_file.path : record.__send__(:carrierwave_profile_image).path
+    end
+
+    def url
+      record.profile_image_url
+    end
+
+    def identifier
+      attached? ? blob.filename.to_s : record.__send__(:carrierwave_profile_image).identifier
+    end
+
+    private
+
+    def downloaded_profile_image_file
+      @downloaded_profile_image_file ||= begin
+        tempfile = Tempfile.new(["profile-image", ".#{blob.filename.extension}"])
+        tempfile.binmode
+        blob.download { |chunk| tempfile.write(chunk) }
+        tempfile.flush
+        tempfile.rewind
+        tempfile
+      end
+    end
+  end
+
+  included do
+    has_one_attached :profile_image
+
+    validate :profile_image_must_be_present
+    after_save :clear_legacy_profile_image_after_active_storage_write, if: :profile_image_attachment_changed?
+
+    after_commit :clear_profile_image_attachment_change_after_create, on: :create
+    after_commit :clear_profile_image_attachment_change_after_org_update,
+                 on: :update,
+                 if: :profile_image_attachment_change_owner?
+  end
+
+  def profile_image
+    proxy = active_storage_profile_image_proxy
+    proxy.extend(AttachmentCompatibility)
+    proxy
+  end
+
+  def profile_image=(attachable)
+    case attachable
+    when nil, ""
+      @profile_image_attachment_changed = true
+      set_active_storage_profile_image_attachable(nil)
+      write_attribute(:profile_image, nil) if has_attribute?(:profile_image)
+    when Hash
+      attach_profile_image(attachable)
+    when String
+      attach_profile_image_from_url(attachable)
+    when ActiveStorage::Blob, ActiveStorage::Attachment
+      attach_profile_image_blob(attachable)
+    when ActiveStorage::Attached::One
+      attach_profile_image_blob(attachable.blob) if attachable.attached?
+    else
+      attach_profile_image_from_file(attachable)
+    end
+  end
+
+  def carrierwave_profile_image
+    uploader = ProfileImageUploader.new(self, :profile_image)
+    identifier = self[:profile_image]
+    uploader.retrieve_from_store!(identifier) if identifier.present?
+    uploader
+  end
+
+  def profile_image_url
+    if active_storage_profile_image_proxy.attached?
+      begin
+        blob = active_storage_profile_image_proxy.blob
+        url = rails_blob_url_for(blob) if blob
+        return url if url.present?
+      rescue StandardError => e
+        Rails.logger.warn("Failed to generate Active Storage profile image URL: #{e.message}")
+      end
+    end
+
+    carrierwave_profile_image.url
+  end
+
+  def rails_blob_url_for(blob)
+    route_options = Rails.application.routes.default_url_options || {}
+    host = route_options[:host].presence ||
+      (respond_to?(:app_domain) ? app_domain : nil).presence ||
+      (Rails.application.config.respond_to?(:app_domain) && Rails.application.config.app_domain.presence) ||
+      ENV["APP_DOMAIN"].presence ||
+      "localhost"
+    protocol = route_options[:protocol].presence || (ENV["APP_PROTOCOL"].presence || "http")
+
+    Rails.application.routes.url_helpers.rails_blob_url(blob, host: host, protocol: protocol.to_s.delete_suffix("://"))
+  rescue StandardError
+    begin
+      blob.url
+    rescue StandardError
+      nil
+    end
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url.presence || profile_image_url
+  end
+
+  def remote_profile_image_url=(url)
+    @remote_profile_image_url = url
+    self.profile_image = url
+  end
+
+  def active_storage_profile_image_proxy
+    @active_storage_profile_image_proxy ||= ActiveStorage::Attached::One.new("profile_image", self)
+  end
+
+  def set_active_storage_profile_image_attachable(attachable)
+    attachment_changes["profile_image"] =
+      if attachable.nil? || attachable == ""
+        ActiveStorage::Attached::Changes::DeleteOne.new("profile_image", self)
+      else
+        ActiveStorage::Attached::Changes::CreateOne.new("profile_image", self, attachable)
+      end
+  end
+
+  def profile_image_attachment_changed?
+    !!@profile_image_attachment_changed
+  end
+
+  def profile_image_present?
+    active_storage_profile_image_proxy.attached? || carrierwave_profile_image.present?
+  end
+
+  private
+
+  def profile_image_must_be_present
+    return unless is_a?(Organization)
+
+    errors.add(:profile_image, :blank) unless profile_image_present?
+  end
+
+  def profile_image_attachment_change_owner?
+    respond_to?(:conditionally_update_articles, true)
+  end
+
+  def clear_legacy_profile_image_after_active_storage_write
+    update_column(:profile_image, nil) if persisted? && active_storage_profile_image_proxy.attached?
+  end
+
+  def clear_profile_image_attachment_change_after_create
+    @profile_image_attachment_changed = false
+  end
+
+  def clear_profile_image_attachment_change_after_org_update
+    @profile_image_attachment_changed = false
+  end
+
+  def attach_profile_image_from_url(url)
+    if url.blank?
+      self.profile_image = nil
+      return
+    end
+
+    unless url.start_with?("http://", "https://")
+      begin
+        blob = ActiveStorage::Blob.find_signed(url)
+        return attach_profile_image_blob(blob) if blob
+      rescue StandardError
+        nil
+      end
+      @profile_image_attachment_changed = false
+      return
+    end
+
+    begin
+      uri = URI.parse(url)
+      raise URI::InvalidURIError unless uri.is_a?(URI::HTTP)
+
+      local_asset = local_profile_image_asset(uri)
+      if local_asset
+        attach_profile_image_from_file(local_asset)
+        return
+      end
+
+      downloaded = URI.open(url) # rubocop:disable Security/Open
+      filename = File.basename(uri.path)
+      filename = "profile-image#{File.extname(filename)}" if filename.blank? || File.extname(filename).blank?
+      content_type = downloaded.respond_to?(:meta) ? downloaded.meta["content-type"] : nil
+
+      attach_profile_image(
+        io: downloaded,
+        filename: filename,
+        content_type: content_type,
+      )
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      attach_profile_image_signed_or_remote_url(url)
+    rescue URI::InvalidURIError
+      @profile_image_attachment_changed = false
+    rescue StandardError => e
+      @profile_image_attachment_changed = false
+      Rails.logger.warn("Failed to download profile image #{url}: #{e.message}")
+    end
+  end
+
+  def local_profile_image_asset(uri)
+    return unless uri.path&.start_with?("/assets/")
+
+    basename = File.basename(uri.path, File.extname(uri.path))
+    basename = basename.sub(/-[0-9a-f]{20,}\z/i, "")
+    extensions = [".png", ".jpg", ".jpeg", ".gif", ".webp"]
+
+    candidates = extensions.map { |extension| Rails.root.join("app/assets/images/#{basename}#{extension}") }
+    candidates.concat(Dir.glob(Rails.root.join("app/assets/**/*/#{basename}{.png,.jpg,.jpeg,.gif,.webp}").to_s))
+    candidates.concat(Dir.glob(Rails.root.join("public/assets/**/*/#{basename}-*#{File.extname(uri.path)}").to_s))
+
+    path = candidates.detect { |candidate| File.exist?(candidate) }
+    File.open(path, "rb") if path
+  end
+
+  def attach_profile_image_signed_or_remote_url(url)
+    downloaded = URI.open(url) # rubocop:disable Security/Open
+    uri = URI.parse(url)
+    filename = File.basename(uri.path)
+    filename = "profile-image#{File.extname(filename)}" if filename.blank? || File.extname(filename).blank?
+    content_type = downloaded.respond_to?(:meta) ? downloaded.meta["content-type"] : nil
+
+    attach_profile_image(
+      io: downloaded,
+      filename: filename,
+      content_type: content_type,
+    )
+  rescue StandardError => e
+    @profile_image_attachment_changed = false
+    Rails.logger.warn("Failed to attach remote profile image #{url}: #{e.message}")
+  end
+
+  def attach_profile_image_from_file(attachable)
+    io = attachable.respond_to?(:tempfile) ? attachable.tempfile : attachable
+    filename = if attachable.respond_to?(:original_filename)
+                 attachable.original_filename
+               elsif attachable.respond_to?(:path) && attachable.path.present?
+                 File.basename(attachable.path)
+               elsif attachable.respond_to?(:filename)
+                 attachable.filename
+               else
+                 "profile-image"
+               end
+    content_type = attachable.respond_to?(:content_type) ? attachable.content_type : nil
+
+    processed = process_profile_image(io)
+    attach_profile_image(
+      io: processed || io,
+      filename: filename.presence || "profile-image",
+      content_type: content_type,
+    )
+  rescue StandardError => e
+    @profile_image_attachment_changed = false
+    Rails.logger.warn("Failed to attach profile image: #{e.message}")
+  end
+
+  def attach_profile_image_blob(attachable)
+    blob = attachable.is_a?(ActiveStorage::Attachment) ? attachable.blob : attachable
+    set_active_storage_profile_image_attachable(blob)
+    @profile_image_attachment_changed = true
+    return unless has_attribute?(:profile_image)
+
+    legacy_identifier = blob.respond_to?(:filename) ? blob.filename.to_s : nil
+    self[:profile_image] = legacy_identifier if legacy_identifier.present?
+  end
+
+  def attach_profile_image(attachable)
+    attachable = attachable.to_h
+    set_active_storage_profile_image_attachable(attachable)
+    @profile_image_attachment_changed = true
+    return unless has_attribute?(:profile_image)
+
+    legacy_identifier = attachable[:filename].presence || attachable["filename"].presence
+    self[:profile_image] = legacy_identifier if legacy_identifier.present?
+  end
+
+  def process_profile_image(io)
+    path = io.respond_to?(:path) ? io.path : nil
+    return unless path.present? && File.exist?(path)
+
+    image = MiniMagick::Image.open(path)
+    exif = begin
+      image.exif
+    rescue StandardError
+      {}
+    end
+    return if exif.blank?
+
+    image.auto_orient
+    image.strip
+
+    tempfile = Tempfile.new(["processed-profile-image", File.extname(path)])
+    tempfile.binmode
+    image.write(tempfile.path)
+    tempfile.flush
+    tempfile.rewind
+    tempfile
+  rescue StandardError => e
+    Rails.logger.warn("Failed to process profile image: #{e.message}")
+    nil
+  end
+end
