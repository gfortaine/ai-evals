+require "rails_helper"
+
+RSpec.describe ProfileImageAttachment do
+  it "stores new user profile images in Active Storage" do
+    user = create(:user)
+
+    expect(user.profile_image).to be_attached
+    expect(user.profile_image.blob).to be_persisted
+    expect(user[:profile_image]).to be_nil
+  end
+
+  it "stores new organization profile images in Active Storage" do
+    organization = create(:organization)
+
+    expect(organization.profile_image).to be_attached
+    expect(organization.profile_image.blob).to be_persisted
+    expect(organization[:profile_image]).to be_nil
+  end
+
+  it "falls back to the legacy CarrierWave URL when no attachment exists" do
+    user = build(:user, profile_image: nil)
+    legacy_uploader = instance_double(ProfileImageUploader, url: "https://legacy.example/profile.jpg")
+    allow(user).to receive(:carrierwave_profile_image).and_return(legacy_uploader)
+
+    expect(user.profile_image).not_to be_attached
+    expect(user.profile_image_url).to eq("https://legacy.example/profile.jpg")
+  end
+end
