@@ -0,0 +1,129 @@
+module ActiveStorage
+  class Service
+    class FogService < Service
+      def initialize(access_key_id:, secret_access_key:, region:, bucket:, public: false, **)
+        super()
+        credentials = {
+          provider: "AWS",
+          region: region,
+          aws_access_key_id: access_key_id,
+          aws_secret_access_key: secret_access_key
+        }
+        credentials[:use_iam_profile] = true if access_key_id.blank? || secret_access_key.blank?
+
+        @storage = Fog::Storage.new(credentials)
+        @bucket = bucket
+        @public = public
+      end
+
+      def upload(key, io, checksum: nil, filename: nil, content_type: nil, disposition: nil, custom_metadata: {}, **)
+        verify_integrity_of(io, checksum) if checksum
+
+        io.rewind if io.respond_to?(:rewind)
+        directory.files.create(
+          key: key,
+          body: io,
+          public: public?,
+          content_type: content_type,
+          content_disposition: content_disposition_with(type: disposition,
+                                                        filename: ActiveStorage::Filename.wrap(filename)),
+          metadata: custom_metadata,
+        )
+      end
+
+      def download(key, &block)
+        body = nil
+        file = directory.files.get(key)
+        raise ActiveStorage::FileNotFoundError unless file
+
+        body = file.body
+        if block
+          if body.respond_to?(:read)
+            body.rewind if body.respond_to?(:rewind)
+            while (chunk = body.read(16.kilobytes))
+              yield(chunk)
+            end
+          else
+            yield(body)
+          end
+        else
+          body.respond_to?(:read) ? body.read : body
+        end
+      ensure
+        body.close if body.respond_to?(:close) && body.closed? == false
+      end
+
+      def download_chunk(key, range)
+        body = download(key)
+        start_range, end_range = range.to_s.delete_prefix("bytes=").split("-").map { |value| value.presence&.to_i }
+        end_range ||= body.bytesize - 1
+        body.byteslice(start_range, end_range - start_range + 1)
+      end
+
+      def delete(key)
+        directory.files.get(key)&.destroy
+      end
+
+      def delete_prefixed(prefix)
+        directory.files.all(prefix: prefix).find_each(&:destroy)
+      end
+
+      def exist?(key)
+        directory.files.head(key).present?
+      rescue StandardError
+        false
+      end
+
+      def url_for_direct_upload(key, expires_in:, content_type:, content_length:, checksum:, **_options)
+        @storage.put_object_url(
+          @bucket,
+          key,
+          Time.now.to_i + expires_in,
+          "Content-Type" => content_type,
+          "Content-Length" => content_length.to_s,
+          "x-amz-meta-md5" => checksum,
+        )
+      end
+
+      def headers_for_direct_upload(_key, filename:, content_type:, content_length:, **_options)
+        {
+          "Content-Type" => content_type,
+          "Content-Length" => content_length.to_s,
+          "Content-Disposition" => content_disposition_with(type: "inline",
+                                                            filename: ActiveStorage::Filename.wrap(filename))
+        }
+      end
+
+      private
+
+      def directory
+        @directory ||= @storage.directories.get(@bucket) || @storage.directories.create(key: @bucket)
+      end
+
+      def public_url(key, **)
+        file = directory.files.get(key)
+        return file.public_url if file&.public_url
+
+        "https://#{@bucket}.s3.amazonaws.com/#{ERB::Util.url_encode(key)}"
+      end
+
+      def private_url(key, expires_in:, filename:, disposition:, content_type:, **)
+        headers = {}
+        headers["response-content-disposition"] = content_disposition_with(type: disposition, filename: filename)
+        headers["response-content-type"] = content_type
+        @storage.get_object_url(@bucket, key, Time.now.to_i + expires_in, headers)
+      end
+
+      def verify_integrity_of(io, checksum)
+        io.rewind if io.respond_to?(:rewind)
+        actual = Digest::MD5.base64digest(io.read)
+        io.rewind if io.respond_to?(:rewind)
+        raise ActiveStorage::IntegrityError unless actual == checksum
+      end
+
+      def custom_metadata_headers(metadata)
+        metadata.transform_keys { |key| "x-amz-meta-#{key}" }
+      end
+    end
+  end
+end
