     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    inserted_by_user_id = inserted.to_a.index_by { |attributes| attributes["user_id"] }
+    accesses = rows.map do |row|
+      Access.instantiate(inserted_by_user_id[row[:user_id]]).tap do |access|
