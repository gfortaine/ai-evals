+
+  test "apply_edit defers jobs until the outer transaction commits" do
+    book = books(:handbook)
+
+    assert_enqueued_jobs(1, only: Book::SearchIndexJob) do
+      Book.transaction do
+        book.apply_edit(title: "Updated Handbook")
+      end
+    end
+  end
+
+  test "apply_edit drops jobs when the outer transaction rolls back" do
+    book = books(:handbook)
+
+    assert_no_enqueued_jobs do
+      Book.transaction do
+        book.apply_edit(title: "Abandoned Handbook", cover: Rack::Test::UploadedFile.new(Rails.root.join("test/fixtures/files/reading.webp").to_s, "image/webp"))
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "apply_edit enqueues cover and search jobs after a cover change" do
+    book = books(:handbook)
+
+    assert_enqueued_jobs(2) do
+      book.apply_edit(title: "Updated Handbook", cover: Rack::Test::UploadedFile.new(Rails.root.join("test/fixtures/files/reading.webp").to_s, "image/webp"))
+    end
+  end
+
+  test "cover processing stamps the cover SHA-256 fingerprint" do
+    book = books(:handbook)
+    book.cover.attach(io: StringIO.new("cover bytes"), filename: "cover.bin", content_type: "application/octet-stream")
+
+    Book::CoverProcessingJob.perform_now(book)
+
+    assert_equal Digest::SHA256.hexdigest("cover bytes"), book.cover.blob.reload.metadata["sha256"]
+  end
 end
