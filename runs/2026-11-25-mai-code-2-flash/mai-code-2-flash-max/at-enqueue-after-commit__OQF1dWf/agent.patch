diff --git a/test/controllers/books/imports_controller_test.rb b/test/controllers/books/imports_controller_test.rb
new file mode 100644
index 0000000..55d6cea
--- /dev/null
+++ b/test/controllers/books/imports_controller_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "successful batch defers edit jobs until the batch commits" do
+    assert_enqueued_jobs(1, only: Book::SearchIndexJob) do
+      post books_import_path, params: {
+        books: {
+          books(:handbook).id => { title: "Imported Handbook" }
+        }
+      }
+    end
+
+    assert_redirected_to root_url
+  end
+
+  test "failed batch rolls back edit jobs and enqueues import failure" do
+    assert_enqueued_jobs(1, only: Books::ImportFailureJob) do
+      post books_import_path, params: {
+        books: {
+          books(:handbook).id => { title: "Rolled Back Handbook" },
+          999999 => { title: "Missing Book" }
+        }
+      }
+    end
+
+    assert_response :not_found
+  end
+end
