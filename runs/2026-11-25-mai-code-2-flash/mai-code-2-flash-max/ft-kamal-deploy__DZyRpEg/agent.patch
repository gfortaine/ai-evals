--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,56 @@
+# Deploy Fizzy to one Linux server. Replace the placeholders before setup.
+service: fizzy
+image: <your-github-username>/fizzy
+asset_path: /rails/public/assets
+secrets_path: .kamal/secrets
+
+servers:
+  web:
+    hosts:
+      - <your-server-ip-or-hostname>
+
+proxy:
+  ssl: true
+  host: <your-fizzy-hostname>
+
+registry:
+  server: ghcr.io
+  username:
+    - KAMAL_REGISTRY_USERNAME
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+volumes:
+  - "fizzy:/rails/storage"
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    PRIMARY_DATACENTER: true
+    SOLID_QUEUE_IN_PUMA: true
+    APP_HOST: <your-fizzy-hostname>
+    ASSUME_SSL: true
+    FORCE_SSL: true
+    SMTP_ADDRESS: <your-smtp-host>
+    SMTP_PORT: 587
+    SMTP_DOMAIN: <your-fizzy-hostname>
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    MAILER_FROM_ADDRESS: "Fizzy <noreply@your-fizzy-hostname>"
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
