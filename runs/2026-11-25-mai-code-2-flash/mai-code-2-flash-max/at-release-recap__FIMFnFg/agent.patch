diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..187a62e 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -1,11 +1,63 @@
 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
   end
 
+  test "finalizing a release caches the final title and published state" do
+    book = books(:manual)
+    book.update!(title: "Working title")
+
+    assert Book.finalize_release(book.id, title: "Final title", subtitle: "Final subtitle")
+
+    assert_equal({ title: "Final title", published: true }, book.cached_recap)
+    assert_equal "Final title", book.reload.title
+    assert_equal "Final subtitle", book.subtitle
+    assert_predicate book, :published?
+  end
+
+  test "recaps stay per book when another book is saved" do
+    first = books(:manual)
+    second = books(:handbook)
+
+    first.update!(title: "First title")
+    second.update!(title: "Second title")
+
+    assert_equal({ title: "First title", published: false }, first.cached_recap)
+    assert_equal({ title: "Second title", published: false }, second.cached_recap)
+
+    first.update!(title: "Renamed first")
+
+    assert_equal({ title: "Renamed first", published: false }, first.cached_recap)
+    assert_equal({ title: "Second title", published: false }, second.cached_recap)
+  end
+
+  test "recaps expire using the configured duration" do
+    original_expiry = Rails.application.config.x.recap.expires_in
+    Rails.application.config.x.recap.expires_in = 1.second
+    book = books(:manual)
+
+    book.update!(title: "Temporary title")
+    assert_not_nil book.cached_recap
+
+    travel 2.seconds do
+      assert_nil book.cached_recap
+    end
+  ensure
+    Rails.application.config.x.recap.expires_in = original_expiry
+  end
+
   test "press a leafable" do
     leaf = books(:manual).press Page.new(body: "Important words"), title: "Introduction"
 
