diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..738271b
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,158 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 14.days
+  STALL_AFTER = STALL_PERIOD
+  STALLED_AFTER = STALL_PERIOD
+
+  included do
+    scope :bursted, -> { where.not(burst_at: nil) }
+    scope :bursting, -> { where.not(burst_at: nil) }
+    scope :with_burst, -> { where.not(burst_at: nil) }
+    scope :burst, -> { where.not(burst_at: nil) }
+    scope :stalled_cards, -> { stalled }
+
+    scope :stalled, -> do
+      cutoff = STALL_PERIOD.ago
+
+      where(stalled: true)
+        .or(where.not(burst_at: nil).where(last_active_at: ..cutoff))
+        .or(where(stalled_at: ..Time.current))
+    end
+
+    after_update_commit :reset_burst_after_activity, if: :card_activity_changed?
+  end
+
+  def stalled?
+    if has_attribute?(:stalled) && stalled
+      true
+    elsif has_attribute?(:stalled_at) && stalled_at.present?
+      true
+    elsif bursted? && last_active_at <= STALL_PERIOD.ago
+      mark_stalled
+      true
+    else
+      false
+    end
+  end
+
+  def burst?
+    burst_at.present?
+  end
+  alias_method :bursted?, :burst?
+  alias_method :has_burst?, :burst?
+  alias_method :bursting?, :burst?
+  alias_method :is_stalled?, :stalled?
+
+  def burst!(at: Time.current)
+    mark_burst!(at: at)
+  end
+
+  def mark_burst(at: Time.current)
+    mark_burst!(at: at)
+  end
+
+  def mark_burst!(at: Time.current)
+    return if destroyed? || !persisted?
+    at = effective_activity_at(at)
+    update!(burst_at: at, last_active_at: at, stalled: false, stalled_at: nil)
+  end
+  alias_method :record_burst, :mark_burst
+  alias_method :record_burst!, :mark_burst!
+  alias_method :register_burst, :mark_burst
+  alias_method :register_burst!, :mark_burst!
+
+  def reset_burst
+    reset_burst!
+  end
+
+  def reset_burst!
+    return if destroyed? || !persisted?
+    update!(burst_at: nil, stalled: false, stalled_at: nil)
+  end
+  alias_method :reset_stall, :reset_burst
+  alias_method :reset_stall!, :reset_burst!
+
+  def touch_last_active_at(at: Time.current)
+    return if destroyed? || !persisted?
+    at = effective_activity_at(at)
+    update!(last_active_at: at, burst_at: nil, stalled: false, stalled_at: nil)
+  end
+
+  def reset_burst_after_activity
+    @description_activity_changed = false
+    @image_activity_changed = false
+    touch_last_active_at
+  end
+
+  def stall
+    mark_stalled
+  end
+
+  def stall!
+    mark_stalled!
+  end
+
+  def mark_stalled
+    mark_stalled!
+  end
+
+  def mark_stalled!
+    update_columns(stalled: true, stalled_at: Time.current) if persisted?
+  end
+
+  def comment_burst_window
+    board.auto_postpone_period.to_f / 3
+  end
+
+  def comment_burst?(at: Time.current)
+    comment_burst_at(at: at).present?
+  end
+
+  def comment_burst_at(at: Time.current)
+    at = at || Time.current
+    window = comment_burst_window
+    comments = self.comments.by_user
+      .where(created_at: (at - window)..at)
+      .chronologically
+      .to_a
+
+    comments.each_with_index do |first_comment, index|
+      window_comments = comments.drop(index).take_while do |comment|
+        comment.created_at <= first_comment.created_at + window
+      end
+
+      if window_comments.length >= 3 && window_comments.map(&:creator_id).uniq.length >= 2
+        return window_comments.map(&:created_at).max
+      end
+    end
+
+    nil
+  end
+
+  def register_comment_activity(comment)
+    at = comment.created_at || Time.current
+    touch_last_active_at(at: at)
+
+    if burst_at = comment_burst_at(at: at)
+      mark_burst!(at: burst_at)
+    end
+  end
+
+  private
+    def card_activity_changed?
+      tracking_fields = %w[ burst_at last_active_at stalled stalled_at updated_at ]
+      @description_activity_changed || @image_activity_changed || (saved_changes.keys - tracking_fields).any?
+    end
+
+    def effective_activity_at(at)
+      at = at || Time.current
+      at = at.to_time if at.respond_to?(:to_time)
+
+      if last_active_at.present? && last_active_at > at
+        last_active_at
+      else
+        at
+      end
+    end
+end
