+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people in a third of the auto-close period make a burst" do
+    freeze_time
+
+    card = published_card
+    card.board.update!(auto_postpone_period: 30.days)
+
+    card.comments.create!(creator: users(:david), body: "First")
+    card.comments.create!(creator: users(:jz), body: "Second")
+    card.comments.create!(creator: users(:kevin), body: "Third")
+
+    assert card.reload.bursted?
+  end
+
+  test "three comments from one person do not make a burst" do
+    freeze_time
+
+    card = published_card
+
+    3.times do
+      card.comments.create!(creator: users(:david), body: "One person")
+    end
+
+    assert_not card.reload.bursted?
+  end
+
+  test "comments outside the burst window do not make a burst" do
+    card = published_card
+    card.board.update!(auto_postpone_period: 30.days)
+
+    travel_to 20.days.ago do
+      card.comments.create!(creator: users(:david), body: "First")
+    end
+
+    travel_to 2.days.ago do
+      card.comments.create!(creator: users(:jz), body: "Second")
+      card.comments.create!(creator: users(:kevin), body: "Third")
+    end
+
+    assert_not card.reload.bursted?
+  end
+
+  test "a burst stalls after two weeks without activity" do
+    freeze_time
+
+    card = published_card
+    card.mark_burst!
+
+    assert_not card.stalled?
+
+    travel 14.days
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "editing a card resets a burst" do
+    freeze_time
+
+    card = published_card
+    card.mark_burst!
+
+    card.update!(title: "New activity")
+
+    assert_not card.reload.bursted?
+  end
+
+  test "editing a card description resets a burst" do
+    freeze_time
+
+    card = published_card
+    card.mark_burst!
+
+    card.update!(description: "New description")
+
+    assert_not card.reload.bursted?
+  end
+
+  test "activity resets a burst and stalled state" do
+    freeze_time
+
+    card = published_card
+    card.mark_burst!
+
+    travel 14.days
+    assert card.reload.stalled?
+
+    card.touch_last_active_at
+
+    assert_not card.reload.bursted?
+    assert_not card.stalled?
+  end
+
+  test "assignment and reopen create bursts" do
+    freeze_time
+
+    card = published_card
+    card.toggle_assignment users(:jz)
+    assert card.reload.bursted?
+
+    card.reset_burst!
+
+    cards(:shipping).reopen
+    assert cards(:shipping).reload.bursted?
+  end
+
+  test "direct burst timestamp persists" do
+    card = published_card
+    card.update!(burst_at: Time.current)
+
+    assert card.reload.burst?
+  end
+
+  private
+    def published_card
+      boards(:writebook).cards.create!(
+        creator: users(:david),
+        status: :published,
+        title: "A stalled card"
+      )
+    end
+end
