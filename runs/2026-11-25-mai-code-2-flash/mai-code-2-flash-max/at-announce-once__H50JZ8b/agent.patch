diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..03c03db 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,38 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_create :remember_draft_before_sitting
+    before_update :remember_published_before_sitting
+    after_commit :announce_publication_after_sitting, on: [ :create, :update ]
+    after_rollback :restore_published_after_rollback
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def remember_draft_before_sitting
+      @published_before_sitting = false
+    end
+
+    def remember_published_before_sitting
+      unless instance_variable_defined?(:@published_before_sitting)
+        @published_before_sitting = attribute_in_database("published")
+      end
+    end
+
+    def announce_publication_after_sitting
+      return unless instance_variable_defined?(:@published_before_sitting)
+
+      published_before_sitting = remove_instance_variable(:@published_before_sitting)
+      if !published_before_sitting && published?
+        AnnouncePublicationJob.perform_later self
+      end
+    end
+
+    def restore_published_after_rollback
+      database_published = id ? self.class.unscoped.where(id: id).pick(:published) : false
+      self.published = database_published == true
+
+      if self.class.connection.open_transactions.zero? && instance_variable_defined?(:@published_before_sitting)
+        remove_instance_variable(:@published_before_sitting)
+      end
     end
 end
