   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
@@ -40,4 +42,116 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "announces once when an update takes a draft book live" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      books(:manual).update!(published: true)
+    end
+  end
+
+  test "does not announce when an already-live book is saved again" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(title: "Saved Again")
+    end
+  end
+
+  test "does not announce when a draft book is saved without going live" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:manual).update!(title: "Draft Edit")
+    end
+  end
+
+  test "does not announce when a live book is taken down" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+  end
+
+  test "announces once when taking a book live also adds a page" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.press Page.new(body: ""), { title: "Added Page" }
+      end
+    end
+
+    assert book.reload.published?
+    assert_includes book.leaves.map(&:title), "Added Page"
+  end
+
+  test "rolled back sitting leaves the book draft and announces nothing" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.press Page.new(body: ""), { title: "Not Committed" }
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not book.published?
+    assert_not book.reload.published?
+    assert_not_includes book.leaves.map(&:title), "Not Committed"
+  end
+
+  test "a nested rollback does not erase a publication from the sitting" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.transaction(requires_new: true) do
+          book.update!(title: "Discarded Savepoint Edit")
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert book.reload.published?
+    assert_equal "Manual", book.title
+  end
+
+  test "nested rollback preserves unrelated outer sitting changes" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(title: "Outer Title")
+        book.transaction(requires_new: true) do
+          book.update!(published: true)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert_not book.published?
+    assert_equal "Outer Title", book.reload.title
+  end
+
+  test "rolling back a nested publication leaves the book draft" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.transaction(requires_new: true) do
+          book.update!(published: true)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert_not book.published?
+    assert_not book.reload.published?
+  end
 end
