index 0000000..6e78284
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,39 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    export = Current.account.exports.create!(
+      user: Current.user,
+      scope: "account"
+    )
+    export.export_later
+
+    respond_to do |format|
+      format.html do
+        redirect_to account_settings_path, notice: "Your account export is being prepared. We'll email you when it's ready."
+      end
+      format.json do
+        render json: { id: export.id, status: export.status }, status: :accepted
+      end
+    end
+  end
+
+  def show
+    export = find_export
+
+    if export&.file&.attached?
+      redirect_to rails_blob_path(export.file, disposition: "attachment"), allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def find_export
+      if params[:id].to_s.present? && (export = Export.find_signed(params[:id], purpose: :download))
+        export
+      else
+        Current.account.exports.find_by(id: params[:id])
+      end
+    end
+end
