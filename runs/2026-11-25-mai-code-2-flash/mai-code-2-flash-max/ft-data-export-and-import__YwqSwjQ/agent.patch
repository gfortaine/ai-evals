diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..8971619
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,66 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+
+  def new
+  end
+
+  def create
+    import_record = Import.create!(
+      identity: Current.identity,
+      initiated_by: Current.user,
+      account: Current.account
+    )
+
+    if file = uploaded_file
+      import_record.file.attach(file)
+      import_record.import_later
+
+      respond_to do |format|
+        format.html do
+          redirect_to account_import_path(import_record), notice: "Your account import is being prepared. We'll email you when it's done."
+        end
+        format.json do
+          render json: { id: import_record.id, status: import_record.status }, status: :accepted
+        end
+      end
+    else
+      import_record.destroy!
+      respond_to do |format|
+        format.html do
+          redirect_to new_account_import_path, alert: "Choose an account .zip file to import.", status: :unprocessable_entity
+        end
+        format.json { render json: { error: "Choose an account .zip file to import." }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def show
+    @import = import_record
+
+    respond_to do |format|
+      format.html
+      format.json { render json: { id: @import.id, status: @import.status, account_id: @import.account_id, error: @import.error } }
+    end
+  end
+
+  private
+    def import_record
+      if params[:id].present?
+        Import.where(identity: Current.identity).find(params[:id])
+      else
+        Import.where(identity: Current.identity).order(created_at: :desc).first!
+      end
+    end
+
+    def uploaded_file
+      if data = params[:account_import]
+        data[:file] || data[:zip] || data[:account_file] || data[:upload]
+      elsif data = params[:import]
+        data[:file] || data[:zip] || data[:account_file] || data[:upload]
+      elsif data = params[:account]
+        data[:file] || data[:zip] || data[:account_file] || data[:upload]
+      else
+        params[:file] || params[:zip] || params[:account_file] || params[:upload]
+      end
+    end
+end
