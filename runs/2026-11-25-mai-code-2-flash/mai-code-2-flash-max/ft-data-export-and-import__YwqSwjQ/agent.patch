diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..c314787
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,388 @@
+class Account::DataTransfer::Importer
+  attr_reader :import_record
+
+  def initialize(import_record)
+    @import_record = import_record
+    @id_map = {}
+    @identity_map = {}
+    @created_blobs = []
+  end
+
+  def import
+    raise "No account file was uploaded" unless import_record.file.attached?
+
+    imported_account = nil
+
+    import_record.file.blob.open do |download|
+      Zip::File.open(download.path) do |zip|
+        account_rows = json_entries(zip, "accounts")
+        account_rows = json_entries(zip, "account") if account_rows.empty?
+
+        if account_rows.empty?
+          root_account_paths = %w[ account.json accounts.json manifest.json ].select { |path| zip.find_entry(path) }
+          account_rows = root_account_paths
+        end
+
+        raise "This is not a Fizzy account export" if account_rows.empty?
+
+
+        account_row = JSON.parse(read_entry(zip, account_rows.first))
+        old_account_id = account_row["id"]
+
+        imported_account = ActiveRecord::Base.transaction do
+          account = Account.create!(name: account_row["name"])
+          @id_map[old_account_id] = account.id if old_account_id.present?
+
+          if account_row["cards_count"]
+            account.update_column(:cards_count, account_row["cards_count"])
+          end
+
+          if account_row.key?("created_at") && account_row["created_at"].present?
+            account.update_columns(created_at: parse_time(account_row["created_at"]), updated_at: parse_time(account_row["updated_at"] || account_row["created_at"]))
+          end
+
+          system_user = account.users.create!(role: :system, name: "System")
+          import_users_and_identity(zip, account, system_user)
+          create_blobs(zip, account)
+          premap_remaining_ids(zip)
+          import_generic_record_sets(zip, account)
+          import_framework_records(zip, account)
+          import_join_tables(zip)
+          account.reload
+        end
+      end
+    end
+
+    imported_account
+  rescue => error
+    purge_created_blobs
+    raise error
+  end
+
+  private
+    def json_entries(zip, directory)
+      zip.entries.map(&:name).select do |name|
+        name.start_with?("#{directory}/") && name.end_with?(".json")
+      end
+    end
+
+    def read_entry(zip, path)
+      entry = zip.find_entry(path)
+      raise "Missing #{path} in account export" unless entry
+      entry.get_input_stream.read
+    end
+
+    def entry_names(zip)
+      zip.entries.map(&:name)
+    end
+
+    def find_entry(zip, candidates)
+      candidates.each do |candidate|
+        if entry = zip.find_entry(candidate)
+          return entry
+        end
+      end
+
+      nil
+    end
+
+    def parse_time(value)
+      Time.zone.parse(value.to_s) rescue Time.parse(value.to_s)
+    end
+
+    def import_users_and_identity(zip, account, system_user)
+      identities_by_old_id = {}
+
+      json_entries(zip, "identities").each do |path|
+        row = JSON.parse(read_entry(zip, path))
+        old_id = row["id"]
+
+        identity = Identity.find_or_create_by!(email_address: row["email_address"])
+        identity.update!(staff: row["staff"]) if row.key?("staff")
+
+        if row["created_at"] && row["updated_at"]
+          identity.update_columns(created_at: parse_time(row["created_at"]), updated_at: parse_time(row["updated_at"]))
+        end
+
+        @identity_map[old_id] = identity.id if old_id.present?
+        identities_by_old_id[old_id] = identity
+      end
+
+      current_identity = import_record.identity
+      current_matched = false
+
+      json_entries(zip, "users").each do |path|
+        row = JSON.parse(read_entry(zip, path))
+        old_id = row["id"]
+        role = row["role"].presence || "member"
+
+        if role == "system"
+          @id_map[old_id] = system_user.id if old_id.present?
+          next
+        end
+
+        identity = identity_for_user(row, identities_by_old_id)
+
+        if role == "owner" && current_identity.present? && identity&.id != current_identity.id
+          role = "admin"
+        end
+
+        if current_identity.present? && identity&.id == current_identity.id
+          role = "owner"
+          current_matched = true
+        end
+
+        user = account.users.create!(
+          identity: identity,
+          name: row["name"].presence || identity&.email_address || "Person",
+          role: role,
+          active: row.fetch("active", true),
+          verified_at: row["verified_at"].present? ? parse_time(row["verified_at"]) : nil
+        )
+
+        if row["created_at"] || row["updated_at"]
+          user.update_columns(
+            created_at: row["created_at"].present? ? parse_time(row["created_at"]) : user.created_at,
+            updated_at: row["updated_at"].present? ? parse_time(row["updated_at"]) : user.updated_at
+          )
+        end
+
+        @id_map[old_id] = user.id if old_id.present?
+      end
+
+      if current_identity.present? && !account.users.exists?(identity: current_identity)
+        account.users.create!(
+          identity: current_identity,
+          name: current_identity.email_address,
+          role: :owner,
+          active: true,
+          verified_at: Time.current
+        )
+      elsif current_identity.present? && !current_matched
+        account.users.find_by(identity: current_identity)&.update!(role: :owner)
+      end
+
+      account.users.where(role: :owner).where.not(identity: current_identity).find_each do |owner|
+        owner.update!(role: :admin) if current_identity.present? && account.users.where(identity: current_identity).exists?
+      end
+
+      account.reload
+    end
+
+    def identity_for_user(row, identities_by_old_id)
+      identity_id = row["identity_id"]
+      if identity_id.present? && identities_by_old_id.key?(identity_id)
+        identities_by_old_id[identity_id]
+      elsif identity_id.present? && @identity_map.key?(identity_id)
+        Identity.find_by(id: @identity_map[identity_id])
+      elsif row["identity"].is_a?(Hash) && row.dig("identity", "email_address").present?
+        Identity.find_or_create_by!(email_address: row.dig("identity", "email_address"))
+      elsif row["email_address"].present?
+        Identity.find_or_create_by!(email_address: row["email_address"])
+      else
+        nil
+      end
+    end
+
+    def create_blobs(zip, account)
+      Current.with_account(account) do
+        json_entries(zip, "active_storage_blobs").each do |path|
+          row = JSON.parse(read_entry(zip, path))
+          old_id = row["id"]
+          filename = row["filename"]
+
+          raise "Missing filename in blob #{old_id}" if filename.blank?
+
+          candidates = [
+            "active_storage_blobs/#{old_id}/#{filename}",
+            "files/#{old_id}/#{filename}",
+            "files/#{old_id}",
+            "attachments/#{filename}"
+          ]
+
+          entry = find_entry(zip, candidates)
+          raise "Missing file #{filename} in account export" unless entry
+
+          metadata = row["metadata"]
+          metadata = JSON.parse(metadata) if metadata.is_a?(String)
+
+          blob = nil
+          entry.get_input_stream do |io|
+            blob = ActiveStorage::Blob.create_and_upload!(
+              io: io,
+              filename: filename,
+              content_type: row["content_type"],
+              metadata: metadata || {}
+            )
+          end
+
+          blob.update_columns(
+            created_at: row["created_at"].present? ? parse_time(row["created_at"]) : blob.created_at,
+            byte_size: row["byte_size"] || blob.byte_size
+          )
+
+          @created_blobs << blob
+          @id_map[old_id] = blob.id if old_id.present?
+        end
+      end
+    end
+
+    def premap_remaining_ids(zip)
+      entry_names = zip.entries.map(&:name)
+
+      entry_names.select { |name| name.end_with?(".json") }.each do |path|
+        next if path.start_with?("accounts/") || path.start_with?("account/")
+        next if path.start_with?("identities/") || path.start_with?("users/")
+        next if path.start_with?("active_storage_blobs/")
+
+        row = JSON.parse(read_entry(zip, path))
+        old_id = row["id"]
+        if old_id.present? && !@id_map.key?(old_id)
+          @id_map[old_id] = ActiveRecord::Type::Uuid.generate
+        end
+      end
+    end
+
+    def import_generic_record_sets(zip, account)
+      manifest = Account::DataTransfer::Manifest.new(account)
+
+      manifest.each_record_set do |record_set|
+        model = record_set.respond_to?(:model) ? record_set.model : nil
+        next unless model
+
+        table_name = model.table_name
+        next if table_name.in?(%w[ accounts identities users active_storage_blobs active_storage_variant_records active_storage_attachments action_text_rich_texts ])
+
+        json_entries(zip, table_name).each do |path|
+          row = JSON.parse(read_entry(zip, path))
+          attrs = remap_attributes(row, account)
+
+          if model == Entropy
+            existing = Entropy.find_by(
+              account_id: attrs["account_id"],
+              container_type: attrs["container_type"],
+              container_id: attrs["container_id"]
+            )
+
+            if existing
+              existing.update_columns(attrs.except("id"))
+            else
+              model.insert_all!([ attrs ])
+            end
+          elsif model == Account::JoinCode
+            existing = Account::JoinCode.find_by(account_id: attrs["account_id"])
+
+            if existing
+              existing.update_columns(attrs.except("id", "code"))
+            else
+              attrs["code"] = SecureRandom.base58(Account::JoinCode::CODE_LENGTH).scan(/.{4}/).join("-")
+              model.insert_all!([ attrs ])
+            end
+          elsif model == Board::Publication
+            attrs["key"] = SecureRandom.base58(24)
+            model.insert_all!([ attrs ])
+          elsif model == User::Settings
+            existing = User::Settings.find_by(user_id: attrs["user_id"])
+
+            if existing
+              existing.update_columns(attrs.except("id"))
+            else
+              model.insert_all!([ attrs ])
+            end
+          else
+            model.insert_all!([ attrs ])
+          end
+        end
+      end
+    end
+
+    def import_framework_records(zip, account)
+      import_variant_records(zip, account)
+      import_attachments(zip, account)
+      import_rich_texts(zip, account)
+    end
+
+    def import_variant_records(zip, account)
+      json_entries(zip, "active_storage_variant_records").each do |path|
+        row = JSON.parse(read_entry(zip, path))
+        attrs = remap_attributes(row, account)
+        ActiveStorage::VariantRecord.insert_all!([ attrs ])
+      end
+    end
+
+    def import_attachments(zip, account)
+      json_entries(zip, "active_storage_attachments").each do |path|
+        row = JSON.parse(read_entry(zip, path))
+        attrs = remap_attributes(row, account)
+        attrs["account_id"] = account.id
+        ActiveStorage::Attachment.insert_all!([ attrs ])
+      end
+    end
+
+    def import_rich_texts(zip, account)
+      json_entries(zip, "action_text_rich_texts").each do |path|
+        row = JSON.parse(read_entry(zip, path))
+        attrs = remap_attributes(row, account)
+        attrs["account_id"] = account.id
+        attrs["body"] = rewrite_rich_text_body(attrs["body"])
+        ActionText::RichText.insert_all!([ attrs ])
+      end
+    end
+
+    def import_join_tables(zip)
+      %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ].each do |table_name|
+        json_entries(zip, table_name).each do |path|
+          row = JSON.parse(read_entry(zip, path))
+          attrs = remap_attributes(row, nil)
+
+          columns = attrs.keys.map { |column| connection.quote_column_name(column) }.join(", ")
+          values = attrs.values.map { |value| connection.quote(value) }.join(", ")
+          connection.execute("INSERT INTO #{connection.quote_table_name(table_name)} (#{columns}) VALUES (#{values})")
+        end
+      end
+    end
+
+    def remap_attributes(row, account)
+      attrs = row.deep_dup
+
+      attrs.each do |key, value|
+        next unless value.is_a?(String)
+
+        if key == "account_id" && account
+          attrs[key] = account.id
+        elsif key == "id" && @id_map.key?(value)
+          attrs[key] = @id_map[value]
+        elsif @id_map.key?(value)
+          attrs[key] = @id_map[value]
+        elsif @identity_map.key?(value)
+          attrs[key] = @identity_map[value]
+        end
+      end
+
+      attrs["account_id"] = account.id if account && attrs.key?("account_id")
+      attrs
+    end
+
+    def rewrite_rich_text_body(body)
+      return body unless body.is_a?(String)
+
+      body.gsub(/gid:\/\/[^\"\s<]+/) do |gid|
+        @id_map.each do |old_id, new_id|
+          if gid.end_with?("/#{old_id}")
+            gid = gid.sub(/#{Regexp.escape(old_id)}\z/, new_id)
+          end
+        end
+        gid
+      end
+    end
+
+    def purge_created_blobs
+      @created_blobs.each do |blob|
+        blob.purge rescue nil
+      end
+    end
+
+    def connection
+      ActiveRecord::Base.connection
+    end
+end
