diff --git a/app/models/account/data_transfer/table_record_set.rb b/app/models/account/data_transfer/table_record_set.rb
new file mode 100644
index 0000000..863a8f7
--- /dev/null
+++ b/app/models/account/data_transfer/table_record_set.rb
@@ -0,0 +1,70 @@
+class Account::DataTransfer::TableRecordSet
+  attr_reader :account, :table_name
+
+  def initialize(account:, table_name:)
+    @account = account
+    @table_name = table_name
+  end
+
+  def export_to(zip)
+    rows = if connection.columns(table_name).map(&:name).include?("account_id")
+      connection.select_all("SELECT * FROM #{quote_table(table_name)} WHERE account_id = #{connection.quote(account.id)}").to_a
+    else
+      export_join_rows
+    end
+
+    rows.each_with_index do |row, index|
+      id = row["id"] || index
+      zip.add_file("#{table_name}/#{id}.json", JSON.pretty_generate(row))
+    end
+
+    zip
+  end
+
+  def export(zip)
+    export_to(zip)
+  end
+
+  def import_from(zip)
+    zip.glob("#{table_name}/*.json").map do |path|
+      JSON.parse(zip.read(path))
+    end
+  end
+
+  def import(zip)
+    import_from(zip)
+  end
+
+  def read_from(zip)
+    import_from(zip)
+  end
+
+  private
+    def connection
+      ActiveRecord::Base.connection
+    end
+
+    def quote_table(name)
+      connection.quote_table_name(name)
+    end
+
+    def export_join_rows
+      join_columns = connection.columns(table_name).map(&:name)
+
+      if join_columns.include?("board_id")
+        ids = Board.where(account: account).pluck(:id)
+        return [] if ids.empty?
+        connection.select_all("SELECT * FROM #{quote_table(table_name)} WHERE board_id IN (#{ids.map { |id| connection.quote(id) }.join(", ")})").to_a
+      elsif join_columns.include?("filter_id")
+        ids = Filter.where(account: account).pluck(:id)
+        return [] if ids.empty?
+        connection.select_all("SELECT * FROM #{quote_table(table_name)} WHERE filter_id IN (#{ids.map { |id| connection.quote(id) }.join(", ")})").to_a
+      elsif join_columns.include?("user_id")
+        ids = User.where(account: account).pluck(:id)
+        return [] if ids.empty?
+        connection.select_all("SELECT * FROM #{quote_table(table_name)} WHERE user_id IN (#{ids.map { |id| connection.quote(id) }.join(", ")})").to_a
+      else
+        []
+      end
+    end
+end
