diff --git a/test/models/export_import_test.rb b/test/models/export_import_test.rb
new file mode 100644
index 0000000..5696f2f
--- /dev/null
+++ b/test/models/export_import_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class ExportImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+  end
+
+  test "account export contains account records and attachment files" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("image-data"), filename: "cover.txt", content_type: "text/plain")
+
+    export = Export.create!(account: @account, user: @user, scope: "account")
+    export.export_now
+
+    assert export.completed?
+    assert export.file.attached?
+
+    export.file.blob.open do |download|
+      Zip::File.open(download.path) do |zip|
+        assert zip.entries.map(&:name).include?("accounts/#{@account.id}.json")
+        assert zip.entries.map(&:name).any? { |name| name.start_with?("cards/") && name.end_with?(".json") }
+        assert zip.entries.map(&:name).any? { |name| name.start_with?("active_storage_blobs/") }
+      end
+    end
+  end
+
+  test "profile export contains accessible cards and comments" do
+    card = cards(:logo)
+    card.comments.create!(creator: @user, body: "An exported comment")
+
+    export = Export.create!(account: @account, user: @user, scope: "cards")
+    export.export_now
+
+    assert export.completed?
+
+    export.file.blob.open do |download|
+      Zip::File.open(download.path) do |zip|
+        entry = zip.find_entry("cards/#{card.number}.json")
+        assert entry
+
+        data = JSON.parse(entry.get_input_stream.read)
+        assert_equal card.title, data["title"]
+        assert data["comments"].any? { |comment| comment["body"]&.include?("An exported comment") }
+      end
+    end
+  end
+
+  test "account import recreates a new account and rolls back on a bad file" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("image-data"), filename: "cover.txt", content_type: "text/plain")
+
+    export = Export.create!(account: @account, user: @user, scope: "account")
+    export.export_now
+
+    account_count = Account.count
+    import_record = Import.create!(identity: identities(:jz), initiated_by: users(:jz), account: @account)
+    import_record.file.attach(io: StringIO.new(export.file.blob.download), filename: "account.zip", content_type: "application/zip")
+
+    imported_account = import_record.import_now
+
+    assert import_record.completed?
+    assert imported_account
+    assert_equal account_count + 1, Account.count
+    assert_equal @account.name, imported_account.name
+    assert imported_account.cards.exists?(number: card.number)
+    imported_card = imported_account.cards.find_by!(number: card.number)
+    assert imported_card.image.attached?
+    assert_equal "cover.txt", imported_card.image.filename.to_s
+    assert imported_account.boards.exists?
+    assert imported_account.users.where.not(role: :system).any?
+
+    bad_import = Import.create!(identity: identities(:jz), initiated_by: users(:jz), account: @account)
+    bad_import.file.attach(io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip")
+
+    bad_import.import_now
+
+    assert bad_import.failed?
+    assert_equal account_count + 1, Account.count
+  end
+end
