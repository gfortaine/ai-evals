diff --git a/test/controllers/account_exports_imports_test.rb b/test/controllers/account_exports_imports_test.rb
new file mode 100644
index 0000000..b2d379d
--- /dev/null
+++ b/test/controllers/account_exports_imports_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class AccountExportsImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "account admin starts an account export" do
+    assert_difference "Export.count", 1 do
+      post account_export_path
+    end
+
+    assert_response :redirect
+    assert_equal "account", Export.order(created_at: :desc).first.scope
+  end
+
+  test "account member cannot start an account export" do
+    logout_and_sign_in_as :david
+
+    post account_export_path
+
+    assert_response :forbidden
+  end
+
+  test "profile owner starts a card export" do
+    assert_difference "Export.count", 1 do
+      post user_export_path(users(:kevin))
+    end
+
+    assert_response :redirect
+    assert_equal "cards", Export.order(created_at: :desc).first.scope
+  end
+
+  test "signed export link downloads an attached file" do
+    export = Export.create!(account: Current.account, user: users(:kevin), scope: "account")
+    export.file.attach(io: StringIO.new("zip-data"), filename: "account.zip", content_type: "application/zip")
+
+    untenanted do
+      get export_path(export.download_token)
+    end
+
+    assert_response :redirect
+  end
+
+  test "signed in identity can open the account import page without an account prefix" do
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :success
+  end
+
+  test "signed in identity can open the account import page" do
+    get new_account_import_path
+
+    assert_response :success
+  end
+
+  test "signed in identity can upload an account import" do
+    tempfile = Tempfile.new([ "account", ".zip" ])
+    tempfile.binmode
+    tempfile.write("zip-data")
+    tempfile.rewind
+
+    uploaded = fixture_file_upload(tempfile.path, "application/zip")
+
+    assert_difference "Import.count", 1 do
+      post account_imports_path, params: { file: uploaded }
+    end
+
+    assert_response :redirect
+    assert Import.order(created_at: :desc).first.file.attached?
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
