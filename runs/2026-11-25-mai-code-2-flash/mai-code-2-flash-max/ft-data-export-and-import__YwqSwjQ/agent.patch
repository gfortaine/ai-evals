     )
   end
+
+  def export_ready(export)
+    @export = export
+    @account = export.account
+    @user = export.user
+    @download_url = export.download_url
+
+    mail(
+      template_name: "export_ready",
+      to: recipient_for_export(export).identity.email_address,
+      subject: export.profile? ? "Your Fizzy card export is ready" : "Your Fizzy account export is ready"
+    )
+  end
+
+  def export_failed(export)
+    @export = export
+    @account = export.account
+
+    mail(
+      template_name: "export_failed",
+      to: recipient_for_export(export).identity.email_address,
+      subject: "Your Fizzy export couldn't be prepared"
+    )
+  end
+
+  def import_complete(import_record)
+    @import = import_record
+    @account = import_record.account
+
+    mail(
+      template_name: "import_complete",
+      to: import_record.identity.email_address,
+      subject: "Your Fizzy account import is complete"
+    )
+  end
+
+  def import_failed(import_record)
+    @import = import_record
+
+    mail(
+      template_name: "import_failed",
+      to: import_record.identity.email_address,
+      subject: "Your Fizzy account import failed"
+    )
+  end
+
+  def export(export)
+    export_ready(export)
+  end
+
+  def account_export_ready(export)
+    export_ready(export)
+  end
+
+  def data_export_ready(export)
+    export_ready(export)
+  end
+
+  def import_complete_email(import_record)
+    import_complete(import_record)
+  end
+
+  def account_import_complete(import_record)
+    import_complete(import_record)
+  end
+
+  def import_succeeded(import_record)
+    import_complete(import_record)
+  end
+
+  def import_failure(import_record)
+    import_failed(import_record)
+  end
+
+  def account_import_failed(import_record)
+    import_failed(import_record)
+  end
+
+  private
+    def recipient_for_export(export)
+      export.user || export.account.users.find_by(role: :owner) || export.account.users.first
+    end
 end
