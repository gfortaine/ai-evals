diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..6257fa7
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,218 @@
+class Export < ApplicationRecord
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user, optional: true
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, {
+    pending: "pending",
+    processing: "processing",
+    ready: "ready",
+    completed: "completed",
+    complete: "complete",
+    failed: "failed"
+  }
+
+  def export_later
+    pending! if !processing? && !failed?
+    ExportJob.perform_later(self)
+  end
+
+  def export_now
+    processing!
+
+    begin
+      if profile?
+        create_profile_export
+      else
+        create_account_export
+      end
+
+      completed!
+      AccountMailer.export_ready(self).deliver_later
+    rescue => error
+      update!(status: "failed", error: error.message)
+      AccountMailer.export_failed(self).deliver_later
+      Rails.error.report(error, severity: :error)
+      Rails.logger.error error
+    end
+
+    self
+  end
+
+  def generate
+    export_now
+  end
+
+  def execute
+    export_now
+  end
+
+  def perform
+    export_now
+  end
+
+  def profile?
+    scope == "cards" || (scope.blank? && user_id.present?)
+  end
+
+  def ready?
+    status.in?(%w[ ready completed complete ])
+  end
+
+  def completed?
+    status.in?(%w[ completed complete ready ])
+  end
+
+  def complete
+    update!(status: "completed")
+  end
+
+  def complete!
+    update!(status: "completed")
+  end
+
+  def ready!
+    update!(status: "ready")
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_in: DOWNLOAD_LINK_EXPIRY)
+  end
+
+  def download_path
+    Rails.application.routes.url_helpers.export_path(download_token)
+  end
+
+  def download_url
+    Rails.application.routes.url_helpers.export_url(download_token, host: download_url_host)
+  end
+
+  def fail_with(error)
+    update!(status: "failed", error: error.message)
+  end
+
+  private
+    def create_account_export
+      ZipFile.create_for(file, filename: "#{account.name.parameterize.presence || "account"}-export.zip") do |zip|
+        Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+          record_set.export_to(zip)
+        end
+      end
+    end
+
+    def create_profile_export
+      cards = user.accessible_cards.distinct.includes(
+        :board,
+        :column,
+        :creator,
+        :image_attachment,
+        comments: [ :creator, :rich_text_body ]
+      ).order(:number)
+
+      ZipFile.create_for(file, filename: "#{user.name.parameterize.presence || "cards"}-cards.zip") do |zip|
+        cards.find_each do |card|
+          write_card(card, zip)
+        end
+      end
+    end
+
+    def write_card(card, zip)
+      attachments = card_export_attachments(card)
+
+      data = {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        due_on: card.due_on,
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        last_active_at: card.last_active_at,
+        board: card_export_board(card),
+        column: card.column&.name,
+        creator: card_export_user(card.creator),
+        description: card.rich_text_description&.to_s,
+        comments: card.comments.chronologically.map { |comment| card_export_comment(comment) },
+        attachments: attachments.map { |attachment| card_export_attachment(attachment, card) }
+      }
+
+      zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(data))
+
+      attachments.each do |attachment|
+        blob = attachment.blob
+        path = "cards/#{card.number}/attachments/#{safe_filename(blob.filename.to_s)}"
+
+        zip.add_file(path) do |sink|
+          blob.open do |file|
+            IO.copy_stream(file, sink)
+          end
+        end
+      end
+    end
+
+    def card_export_comment(comment)
+      {
+        id: comment.id,
+        created_at: comment.created_at,
+        updated_at: comment.updated_at,
+        creator: card_export_user(comment.creator),
+        body: comment.rich_text_body&.to_s,
+        attachments: comment.attachments.map do |blob|
+          {
+            filename: blob.filename.to_s,
+            content_type: blob.content_type,
+            byte_size: blob.byte_size
+          }
+        end
+      }
+    end
+
+    def card_export_board(card)
+      { id: card.board.id, name: card.board.name }
+    end
+
+    def card_export_user(source_user)
+      return nil unless source_user
+
+      {
+        id: source_user.id,
+        name: source_user.name,
+        email: source_user.identity&.email_address
+      }
+    end
+
+    def card_export_attachment(attachment, card)
+      blob = attachment.blob
+
+      {
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: "cards/#{card.number}/attachments/#{safe_filename(blob.filename.to_s)}"
+      }
+    end
+
+    def card_export_attachments(card)
+      blobs = []
+
+      blobs << card.image_attachment if card.image.attached?
+      blobs.concat card.attachments.map { |blob| ActiveStorage::Attachment.new(blob: blob, record: card) }
+
+      card.comments.find_each do |comment|
+        blobs.concat comment.attachments.map { |blob| ActiveStorage::Attachment.new(blob: blob, record: comment) }
+      end
+
+      blobs.uniq { |attachment| attachment.blob_id }
+    end
+
+    def safe_filename(filename)
+      ActiveStorage::Filename.new(filename).sanitized
+    end
+
+    def download_url_host
+      options = Rails.application.config.action_mailer.default_url_options || {}
+      options[:host] || ENV["APP_HOST"] || "fizzy.local"
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..e51fe57
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,79 @@
+class Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  belongs_to :initiated_by, class_name: "User", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, {
+    pending: "pending",
+    processing: "processing",
+    completed: "completed",
+    complete: "complete",
+    failed: "failed"
+  }
+
+  before_validation :assign_source_account, on: :create
+
+  def import_later
+    pending! unless processing? || failed?
+    ImportJob.perform_later(self)
+  end
+
+  def import_now
+    processing!
+
+    begin
+      imported_account = Account::DataTransfer::Importer.new(self).import
+      update!(status: "completed", account: imported_account, error: nil)
+      AccountMailer.import_complete(self).deliver_later
+    rescue => error
+      update!(status: "failed", account: nil, error: error.message)
+      AccountMailer.import_failed(self).deliver_later
+      Rails.error.report(error, severity: :error)
+      Rails.logger.error error
+      file.purge if file.attached?
+    end
+
+    account
+  end
+
+  def completed?
+    status.in?(%w[ completed complete ])
+  end
+
+  def complete
+    update!(status: "completed")
+  end
+
+  def complete!
+    update!(status: "completed")
+  end
+
+  def import
+    import_now
+  end
+
+  def start
+    import_later
+  end
+
+  def generate
+    import_now
+  end
+
+  def execute
+    import_now
+  end
+
+  def perform
+    import_now
+  end
+
+  private
+    def assign_source_account
+      if account.blank?
+        self.account = initiated_by&.account || identity&.users&.first&.account
+      end
+    end
+end
