index 0000000..ea53b2f
--- /dev/null
+++ b/test/models/board/publication_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "board is private by default" do
+    assert_nil @board.public_key
+    assert_not @board.published?
+    assert_nil @board.public_url
+  end
+
+  test "publish generates a stable public key and URL" do
+    @board.publish
+
+    assert @board.published?
+    assert_not_nil @board.public_key
+    assert_equal "/public/boards/#{@board.public_key}", @board.public_url
+
+    public_key = @board.public_key
+    @board.publish
+    assert_equal public_key, @board.reload.public_key
+  end
+
+  test "unpublish removes the public key" do
+    @board.publish
+    @board.unpublish
+
+    assert_nil @board.reload.public_key
+    assert_not @board.published?
+    assert_nil @board.public_url
+  end
+end
