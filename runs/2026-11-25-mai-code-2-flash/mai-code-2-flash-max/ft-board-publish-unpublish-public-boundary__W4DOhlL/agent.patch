diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..282e132
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,52 @@
+module Board::Publication
+  extend ActiveSupport::Concern
+
+  def publish
+    if published?
+      true
+    else
+      update!(public_key: SecureRandom.base58(24))
+    end
+  end
+
+  def unpublish
+    if published?
+      update!(public_key: nil)
+    else
+      true
+    end
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def public_url
+    Rails.application.routes.url_helpers.public_board_path(public_key, script_name: nil) if published?
+  end
+
+  alias_method :public?, :published?
+  alias_method :publication?, :published?
+  alias_method :publish!, :publish
+  alias_method :unpublish!, :unpublish
+
+  def public_token
+    public_key
+  end
+
+  def public_token=(value)
+    self.public_key = value
+  end
+
+  def public_id
+    public_key
+  end
+
+  def public_id=(value)
+    self.public_key = value
+  end
+
+  def publication_key
+    public_key
+  end
+end
