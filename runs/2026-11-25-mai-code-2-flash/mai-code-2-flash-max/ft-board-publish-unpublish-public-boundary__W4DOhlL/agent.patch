diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..0f7edda
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "create publishes a board" do
+    assert_changes -> { @board.reload.public_key }, from: nil do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "create as JSON includes the public URL" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal @board.reload.public_url.sub("/public/", "http://www.example.com/public/"), @response.parsed_body["public_url"]
+  end
+
+  test "destroy unpublishes a board" do
+    @board.publish
+
+    assert_changes -> { @board.reload.public_key }, to: nil do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "destroy as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_nil @board.reload.public_key
+  end
+
+  test "non-board-admin cannot publish or unpublish" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_nil @board.reload.public_key
+
+    @board.publish
+
+    delete board_publication_path(@board)
+    assert_response :forbidden
+    assert_not_nil @board.reload.public_key
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..d3a11d8
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.update!(public_key: "public-test-key")
+  end
+
+  test "show renders a published board" do
+    untenanted do
+      get public_board_path("public-test-key")
+    end
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a", text: cards(:logo).title
+  end
+
+  test "show as JSON exposes published cards and the public URL" do
+    untenanted do
+      get public_board_path("public-test-key", format: :json)
+    end
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal "http://www.example.com/public/boards/public-test-key", @response.parsed_body["public_url"]
+    assert_includes @response.parsed_body["cards"].pluck("number"), cards(:logo).number
+  end
+
+  test "unknown key returns not found" do
+    untenanted do
+      get public_board_path("unknown-key")
+    end
+
+    assert_response :not_found
+  end
+
+  test "unpublished board returns not found" do
+    @board.update!(public_key: nil)
+
+    untenanted do
+      get public_board_path("public-test-key")
+    end
+
+    assert_response :not_found
+  end
+
+  test "draft cards are excluded" do
+    draft = @board.cards.create!(creator: users(:kevin), status: :drafted, title: "A private draft")
+
+    untenanted do
+      get public_board_path("public-test-key")
+    end
+
+    assert_response :success
+    assert_select "a", text: "A private draft", count: 0
+
+    untenanted do
+      get public_board_card_path("public-test-key", draft.number)
+    end
+    assert_response :not_found
+  end
+
+  test "published column can be opened directly" do
+    column = columns(:writebook_in_progress)
+
+    untenanted do
+      get public_board_column_path("public-test-key", column)
+    end
+
+    assert_response :success
+    assert_select "h1", text: column.name
+  end
+
+  test "column from another board returns not found" do
+    column = columns(:writebook_in_progress)
+    column.update!(board: boards(:private))
+
+    untenanted do
+      get public_board_column_path("public-test-key", column)
+    end
+
+    assert_response :not_found
+  end
+
+  test "published card can be opened directly" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path("public-test-key", card.number)
+    end
+
+    assert_response :success
+    assert_select "h1", text: card.title
+  end
+
+  test "column and card JSON can be opened directly" do
+    column = columns(:writebook_in_progress)
+    card = cards(:text)
+
+    untenanted do
+      get public_board_column_path("public-test-key", column, format: :json)
+    end
+    assert_response :success
+    assert_includes @response.parsed_body["cards"].pluck("number"), card.number
+
+    untenanted do
+      get public_board_card_path("public-test-key", card.number, format: :json)
+    end
+    assert_response :success
+    assert_equal card.number, @response.parsed_body["number"]
+  end
+end
diff --git a/test/models/board/publication_test.rb b/test/models/board/publication_test.rb
