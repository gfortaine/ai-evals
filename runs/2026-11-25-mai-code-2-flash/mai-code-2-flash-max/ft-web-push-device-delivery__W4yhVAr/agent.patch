diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..f0bb280
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,82 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  include NotificationsHelper
+
+  included do
+    after_create_commit :push_later
+    after_update_commit :push_later, if: :push_after_update?
+  end
+
+  def push_later
+    if pushable? && user.push_subscriptions.exists?
+      Notification::PushJob.perform_later(self)
+    end
+  end
+
+  def push_now
+    if pushable? && account.active? && user.active?
+      payload = push_payload
+      user.push_subscriptions.find_each { |subscription| subscription.push(payload) }
+    end
+  end
+
+  def push_payload
+    {
+      title: push_title,
+      body: push_body,
+      icon: "/app-icon-192.png",
+      badge: "/app-icon-192.png",
+      tag: "notification-#{id}",
+      url: push_card_url,
+      card_url: push_card_url,
+      data: { url: push_card_url, notification_id: id }
+    }
+  end
+
+  def push_title
+    if source.is_a?(Mention)
+      "#{source.mentioner.first_name} @mentioned you"
+    elsif source.is_a?(Event)
+      event_notification_title(source)
+    else
+      card.title.presence || "Card #{card.number}"
+    end
+  end
+
+  def push_body
+    if source.is_a?(Mention)
+      source.source.respond_to?(:mentionable_content) ? source.source.mentionable_content.truncate(200) : card.title.presence || "Card #{card.number}"
+    elsif source.is_a?(Event)
+      event_notification_body(source)
+    else
+      creator.name
+    end
+  end
+
+  def push_card_url
+    Rails.application.routes.url_helpers.card_url(
+      card,
+      push_url_options.merge(script_name: account.slug)
+    )
+  end
+
+  def push
+    push_now
+  end
+
+  private
+    def push_after_update?
+      !read? && (saved_change_to_source_id? || saved_change_to_source_type? || saved_change_to_creator_id? || saved_change_to_unread_count?)
+    end
+
+    def pushable?
+      !read?
+    end
+
+    def push_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence ||
+        { host: "localhost", protocol: "http" }
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..2f1cc22
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,34 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  def push(payload)
+    deliver(payload)
+  end
+
+  def deliver(payload)
+    if vapid_keys_configured?
+      WebPush.payload_send(
+        endpoint: endpoint,
+        message: payload.is_a?(String) ? payload : payload.to_json,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: {
+          subject: ENV.fetch("VAPID_SUBJECT", "mailto:sender@example.com"),
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        }
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  end
+
+  private
+    def vapid_keys_configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+end
