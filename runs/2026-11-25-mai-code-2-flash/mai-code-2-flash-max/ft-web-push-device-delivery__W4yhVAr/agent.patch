new file mode 100644
index 0000000..8189722
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,52 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.assign_attributes(push_subscription_params)
+
+    if @push_subscription.save
+      respond_to do |format|
+        format.html { head :created }
+        format.json { render json: { id: @push_subscription.id }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { head :unprocessable_entity }
+        format.json { render json: { errors: @push_subscription.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @push_subscription = if params[:id].present?
+      @user.push_subscriptions.find_by(id: params[:id]) || @user.push_subscriptions.find_by(endpoint: params[:id])
+    else
+      endpoint = params[:endpoint].presence || params.dig(:push_subscription, :endpoint)
+      @user.push_subscriptions.find_by(endpoint: endpoint)
+    end
+
+    @push_subscription&.destroy!
+
+    respond_to do |format|
+      format.html { head :no_content }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..084cde8
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,173 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "toggle", "details" ]
+  static values = { publicKey: String, subscriptionUrl: String }
+
+  connect() {
+    this.#refresh()
+    this.#listenForSubscriptionChanges()
+  }
+
+  async toggle() {
+    if (this.toggleTarget.checked) {
+      await this.#subscribe()
+    } else {
+      await this.#unsubscribe()
+    }
+
+    await this.#refresh()
+  }
+
+  async subscriptionChanged(event = {}) {
+    if (event.oldSubscription) await this.#deleteSubscription(event.oldSubscription)
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = event.newSubscription || await registration.pushManager.getSubscription()
+
+    if (subscription) {
+      await this.#saveSubscription(subscription)
+      this.#setEnabled(true)
+    } else {
+      this.#setEnabled(false)
+    }
+  }
+
+  async #listenForSubscriptionChanges() {
+    if (!("serviceWorker" in navigator)) return
+
+    const registration = await navigator.serviceWorker.ready
+    registration.addEventListener("pushsubscriptionchange", event => this.subscriptionChanged(event))
+  }
+
+  async #refresh() {
+    if (!("serviceWorker" in navigator) || !("Notification" in window) || !("PushManager" in window)) {
+      this.#setSupported(false)
+      this.#showDetails(true)
+      return
+    }
+
+    this.#setSupported(true)
+
+    if (Notification.permission === "denied") {
+      this.#setEnabled(false)
+      this.toggleTarget.disabled = true
+      this.#showDetails(true)
+      return
+    }
+
+    this.toggleTarget.disabled = false
+    this.#showDetails(false)
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && Notification.permission === "granted") {
+      await this.#saveSubscription(subscription)
+      this.#setEnabled(true)
+    } else {
+      this.#setEnabled(false)
+    }
+  }
+
+  async #subscribe() {
+    if (!("serviceWorker" in navigator) || !("PushManager" in window) || !this.publicKeyValue) {
+      this.#showDetails(true)
+      this.#setEnabled(false)
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.toggleTarget.disabled = permission === "denied"
+      this.#showDetails(true)
+      this.#setEnabled(false)
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey(this.publicKeyValue)
+      })
+    }
+
+    await this.#saveSubscription(subscription)
+    this.#showDetails(false)
+    this.#setEnabled(true)
+  }
+
+  async #unsubscribe() {
+    if ("serviceWorker" in navigator) {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#deleteSubscription(subscription)
+        await subscription.unsubscribe()
+      }
+    }
+
+    this.#setEnabled(false)
+  }
+
+  async #saveSubscription(subscription) {
+    const json = subscription.toJSON()
+
+    await fetch(this.subscriptionUrlValue, {
+      method: "POST",
+      credentials: "same-origin",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content
+      },
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      })
+    })
+  }
+
+  async #deleteSubscription(subscription) {
+    const json = subscription.toJSON()
+
+    await fetch(this.subscriptionUrlValue, {
+      method: "DELETE",
+      credentials: "same-origin",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content
+      },
+      body: JSON.stringify({ push_subscription: { endpoint: json.endpoint } })
+    })
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    this.toggleTarget.checked = enabled
+  }
+
+  #setSupported(supported) {
+    this.toggleTarget.disabled = !supported
+  }
+
+  #showDetails(show) {
+    this.detailsTargets.forEach(target => target.toggleAttribute("hidden", !show))
+  }
+
+  #applicationServerKey(base64Key) {
+    const base64 = base64Key.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")
+    const binary = atob(padded)
+
+    return Uint8Array.from(binary, character => character.charCodeAt(0))
+  }
+}
