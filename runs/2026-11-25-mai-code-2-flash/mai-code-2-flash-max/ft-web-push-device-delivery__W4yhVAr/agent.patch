diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..4ccf8e6
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create stores a push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example/subscriptions/one",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example/subscriptions/one", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+  end
+
+  test "create accepts flat JSON parameters" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        endpoint: "https://push.example/subscriptions/two",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create updates an existing subscription for the endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example/subscriptions/three",
+      p256dh_key: "old-p256dh",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "new-p256dh",
+          auth_key: "new-auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh", subscription.reload.p256dh_key
+    assert_equal "new-auth", subscription.auth_key
+  end
+
+  test "destroy removes a push subscription by id" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example/subscriptions/four",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy removes a push subscription by endpoint" do
+    endpoint = "https://push.example/subscriptions/five"
+    @user.push_subscriptions.create!(endpoint: endpoint, p256dh_key: "p256dh-key", auth_key: "auth-key")
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { endpoint: endpoint }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "users can only manage their own subscriptions" do
+    logout_and_sign_in_as :kevin
+
+    post user_push_subscriptions_path(@user), params: {
+      endpoint: "https://push.example/subscriptions/other",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    }, as: :json
+
+    assert_response :forbidden
+  end
+end
