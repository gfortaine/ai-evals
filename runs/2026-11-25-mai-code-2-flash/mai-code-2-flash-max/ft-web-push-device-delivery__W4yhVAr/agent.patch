@@ -65,3 +65,40 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  let payload = {}
+
+  if (event.data) {
+    try {
+      payload = event.data.json()
+    } catch (error) {
+      payload = { title: "Fizzy", body: event.data.text() }
+    }
+  }
+
+  const options = {
+    body: payload.body || "",
+    icon: payload.icon || "/app-icon-192.png",
+    badge: payload.badge || "/app-icon-192.png",
+    tag: payload.tag || "fizzy",
+    data: payload.data || { url: payload.url || payload.card_url }
+  }
+
+  event.waitUntil(self.registration.showNotification(payload.title || "Fizzy", options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data?.url || event.notification.data?.card_url || "/"
+  event.waitUntil(
+    self.clients.matchAll({ type: "window", includeUncontrolled: true }).then((clients) => {
+      for (const client of clients) {
+        if ("focus" in client && client.url === url) return client.focus()
+      }
+
+      return self.clients.openWindow(url)
+    })
+  )
+})
