   end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..2ab6454 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -1,6 +1,54 @@
 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  test "release caches the final title and published status" do
+    original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    manual = books(:manual)
+    assert Book.finalize_release(manual.id, title: "Released Manual")
+
+    assert_equal({ title: "Released Manual", published: true }, manual.cached_recap)
+  ensure
+    Rails.cache = original_cache
+  end
+
+  test "release marker refreshes the final book title" do
+    original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    manual = books(:manual)
+    marker = ReleaseMarker.for(manual.id)
+
+    manual.update!(title: "Released Manual")
+    marker.publish!
+
+    assert_equal({ title: "Released Manual", published: true }, manual.cached_recap)
+  ensure
+    Rails.cache = original_cache
+  end
+
+  test "saving a book only updates its own recap" do
+    original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    manual = books(:manual)
+    handbook = books(:handbook)
+
+    manual.update!(title: "Renamed Manual")
+    handbook.update!(title: "Renamed Handbook")
+
+    assert_equal({ title: "Renamed Manual", published: false }, manual.cached_recap)
+    assert_equal({ title: "Renamed Handbook", published: false }, handbook.cached_recap)
+
+    manual.update!(title: "Renamed Again")
+
+    assert_equal({ title: "Renamed Again", published: false }, manual.cached_recap)
+    assert_equal({ title: "Renamed Handbook", published: false }, handbook.cached_recap)
+  ensure
+    Rails.cache = original_cache
+  end
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
