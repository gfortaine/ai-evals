diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..7673577
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,51 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "dragging a card to a column moves it immediately and persists" do
+    board = boards(:writebook)
+    card = cards(:buy_domain)
+    destination = columns(:writebook_in_progress)
+
+    visit board_url(board)
+
+    card_element = find("article.card[id='#{dom_id(card, :article)}']", wait: 5)
+    destination_element = find("##{dom_id(destination)}")
+
+    result = page.evaluate_async_script(<<~JS, card_element.native, destination_element.native)
+      const done = arguments[2]
+      const card = arguments[0]
+      const destination = arguments[1]
+      const board = document.querySelector(".card-columns")
+      const controller = window.Stimulus.getControllerForElementAndIdentifier(board, "drag-and-drop")
+      const transfer = new DataTransfer()
+
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+      const started = card.classList.contains("drag-and-drop__dragged-item")
+
+      destination.dispatchEvent(new DragEvent("dragenter", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+      const entered = destination.classList.contains("drag-and-drop__hover-container")
+
+      destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+      const moved = destination.contains(card)
+
+      done({ controller: !!controller, started, entered, moved })
+    JS
+
+    assert result["controller"]
+    assert result["started"]
+    assert result["entered"]
+    assert result["moved"]
+
+    Timeout.timeout(5) do
+      sleep 0.05 until card.reload.column == destination
+    end
+
+    assert_equal destination, card.reload.column
+  end
+end
