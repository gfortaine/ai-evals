diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..faa263c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,346 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  connect() {
+    this.draggedCard = null
+  }
+
+  disconnect() {
+    this.#clearDrag()
+  }
+
+  start(event) {
+    if (!this.#isDesktop) return
+
+    const card = event.currentTarget
+    if (!card.classList.contains("card")) return
+
+    this.draggedCard = card
+    card.classList.add(this.#draggedItemClassName)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+      event.dataTransfer.setData("application/x-card-id", card.id)
+    }
+  }
+
+  end() {
+    this.#clearDrag()
+  }
+
+  enter(event) {
+    if (!this.draggedCard) return
+
+    event.preventDefault()
+    this.#highlightColumn(event.currentTarget)
+  }
+
+  over(event) {
+    if (!this.draggedCard) return
+
+    event.preventDefault()
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#highlightColumn(event.currentTarget)
+  }
+
+  leave(event) {
+    const column = event.currentTarget
+
+    if (event.relatedTarget instanceof Node && column.contains(event.relatedTarget)) return
+
+    this.#removeHighlight(column)
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    event.preventDefault()
+    event.stopPropagation()
+
+    const card = this.draggedCard
+    const destination = event.currentTarget
+
+    card.classList.remove(this.#draggedItemClassName)
+    this.draggedCard = null
+    this.#clearHighlights()
+
+    const source = card.closest(".cards")
+    if (source === destination) return
+
+    if (!this.#destinationFor(destination)) return
+
+    const sourceList = this.#cardListFor(source)
+    const destinationList = this.#cardListFor(destination)
+    const sourceParent = card.parentElement
+    const sourceNextSibling = card.nextElementSibling
+    const originalLabel = card.querySelector(".card__column-name--current")?.outerHTML
+    const originalActive = card.classList.contains("card--active")
+    const originalPostponed = card.classList.contains("card--postponed")
+
+    this.#moveCard(card, destinationList, destination)
+    this.#refreshEmptyState(sourceList)
+    this.#refreshEmptyState(destinationList)
+    this.#updateCount(source, -1)
+    this.#updateCount(destination, 1)
+
+    const move = {
+      card,
+      source,
+      sourceList,
+      sourceParent,
+      destination,
+      destinationList,
+      sourceNextSibling,
+      originalLabel,
+      originalActive,
+      originalPostponed
+    }
+
+    this.#saveMove(card, destination).then(saved => {
+      if (!saved) this.#rollbackMove(move)
+    })
+  }
+
+  async #saveMove(card, destination) {
+    const triageUrl = card.dataset.cardTriageUrl
+
+    try {
+      if (destination.dataset.dragAndDropStatus) {
+        switch (destination.dataset.dragAndDropStatus) {
+          case "maybe":
+            if (!triageUrl) return false
+            return (await destroy(triageUrl, { responseKind: "json" })).ok
+          case "not-now":
+            if (!card.dataset.cardNotNowUrl) return false
+            return (await post(card.dataset.cardNotNowUrl, { responseKind: "json" })).ok
+          case "closed":
+            if (!card.dataset.cardClosureUrl) return false
+            return (await post(card.dataset.cardClosureUrl, { responseKind: "json" })).ok
+        }
+      }
+
+      const columnId = destination.dataset.dragAndDropColumnId
+      if (columnId && triageUrl) {
+        return (await post(triageUrl, {
+          query: { column_id: columnId },
+          responseKind: "json"
+        })).ok
+      }
+
+      return false
+    } catch (error) {
+      console.error("Card move failed", error)
+      return false
+    }
+  }
+
+  #moveCard(card, destinationList, destination) {
+    card.remove()
+
+    const status = destination.dataset.dragAndDropStatus
+
+    if (status === "closed" || status === "not-now") {
+      destinationList.prepend(card)
+      card.querySelector(".card__column-name--current")?.remove()
+
+      if (status === "not-now") {
+        card.classList.remove("card--active")
+        card.classList.add("card--postponed")
+      } else {
+        card.classList.remove("card--active", "card--postponed")
+      }
+    } else if (status === "maybe") {
+      this.#insertCardByServerOrder(card, destinationList)
+      card.querySelector(".card__column-name--current")?.remove()
+      card.classList.add("card--active")
+      card.classList.remove("card--postponed")
+    } else {
+      this.#insertCardByServerOrder(card, destinationList)
+      this.#setCardColumn(card, destination.dataset.columnName)
+      card.classList.add("card--active")
+      card.classList.remove("card--postponed")
+    }
+  }
+
+  #insertCardByServerOrder(card, list) {
+    if (card.classList.contains("golden-effect")) {
+      list.prepend(card)
+      return
+    }
+
+    const firstNonGoldenCard = Array.from(list.querySelectorAll(".card"))
+      .find(listCard => !listCard.classList.contains("golden-effect"))
+
+    if (firstNonGoldenCard) {
+      const parent = firstNonGoldenCard.parentElement
+      if (parent && list.contains(parent)) {
+        parent.insertBefore(card, firstNonGoldenCard)
+      } else {
+        list.append(card)
+      }
+    } else {
+      list.append(card)
+    }
+  }
+
+  #setCardColumn(card, columnName) {
+    if (!columnName) return
+
+    let label = card.querySelector(".card__column-name--current")
+
+    if (!label) {
+      label = document.createElement("span")
+      label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+      const text = document.createElement("span")
+      text.className = "overflow-ellipsis"
+      label.append(text)
+
+      card.querySelector(".card__header")?.append(label)
+    }
+
+    const text = label.querySelector(".overflow-ellipsis")
+    if (text) text.textContent = columnName
+  }
+
+  #rollbackMove({ card, source, sourceList, sourceParent, destination, destinationList, sourceNextSibling, originalLabel, originalActive, originalPostponed }) {
+    card.remove()
+
+    if (sourceParent?.isConnected) {
+      if (sourceNextSibling?.parentNode === sourceParent) {
+        sourceParent.insertBefore(card, sourceNextSibling)
+      } else {
+        sourceParent.append(card)
+      }
+    } else {
+      sourceList.append(card)
+    }
+
+    this.#updateCount(source, 1)
+    this.#updateCount(destination, -1)
+    this.#refreshEmptyState(sourceList)
+    this.#refreshEmptyState(destinationList)
+
+    card.classList.toggle("card--active", originalActive)
+    card.classList.toggle("card--postponed", originalPostponed)
+
+    card.querySelector(".card__column-name--current")?.remove()
+
+    if (originalLabel) {
+      card.querySelector(".card__header")?.insertAdjacentHTML("beforeend", originalLabel)
+    }
+  }
+
+  #cardListFor(column) {
+    let list = column.querySelector(".cards__list")
+
+    if (list) return list
+
+    const frame = column.querySelector("turbo-frame")
+
+    if (frame) {
+      list = document.createElement("div")
+      list.className = "cards__list hide-scrollbar"
+      frame.append(list)
+      return list
+    }
+
+    const transitionContainer = column.querySelector(".cards__transition-container")
+
+    if (transitionContainer) {
+      list = document.createElement("div")
+      list.className = "cards__list hide-scrollbar"
+      transitionContainer.append(list)
+      return list
+    }
+
+    list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    column.append(list)
+    return list
+  }
+
+  #destinationFor(destination) {
+    return destination.dataset.dragAndDropStatus || destination.dataset.dragAndDropColumnId
+  }
+
+  #updateCount(column, change) {
+    const count = column.querySelector(".cards__expander-count")
+    const button = column.querySelector(".cards__expander")
+
+    if (!count) return
+
+    const current = count.textContent.trim() === "99+" ? 100 : parseInt(count.textContent, 10)
+    if (Number.isNaN(current)) return
+
+    const next = Math.max(0, current + change)
+    count.textContent = next > 99 ? "99+" : next.toString()
+
+    if (button) {
+      button.style.setProperty("--card-count", Math.min(next, 15))
+    }
+  }
+
+  #highlightColumn(column) {
+    this.#clearHighlights(column)
+
+    column.classList.add(this.#hoverContainerClassName)
+    column.querySelector(".cards__transition-container")?.classList.add(this.#hoverContainerClassName)
+  }
+
+  #removeHighlight(column) {
+    column.classList.remove(this.#hoverContainerClassName)
+    column.querySelector(".cards__transition-container")?.classList.remove(this.#hoverContainerClassName)
+  }
+
+  #clearHighlights(except) {
+    this.element.querySelectorAll(`.${this.#hoverContainerClassName}`).forEach(element => {
+      if (element !== except) element.classList.remove(this.#hoverContainerClassName)
+    })
+  }
+
+  #clearDrag() {
+    this.draggedCard?.classList.remove(this.#draggedItemClassName)
+    this.draggedCard = null
+    this.#clearHighlights()
+  }
+
+
+  #refreshEmptyState(list) {
+    if (list.querySelector(".card")) {
+      list.querySelectorAll(":scope > .blank-slate").forEach(blank => blank.remove())
+    } else {
+      if (!list.querySelector(".blank-slate")) {
+        const defaultBlank = document.createElement("div")
+        defaultBlank.className = "blank-slate blank-slate--default"
+        defaultBlank.textContent = "No cards here"
+
+        const dragBlank = document.createElement("div")
+        dragBlank.className = "blank-slate blank-slate--drag overflow-ellipsis"
+        dragBlank.textContent = "Drag cards here"
+
+        list.append(defaultBlank, dragBlank)
+      }
+    }
+  }
+
+  get #draggedItemClassName() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClassName() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+
+  get #isDesktop() {
+    return typeof window.matchMedia !== "function" || window.matchMedia("(min-width: 640px)").matches
+  }
+}
