@@ -0,0 +1,33 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from accessible_activities
+  end
+
+  private
+    def accessible_activities
+      activities = Event
+        .preloaded
+        .where(account: Current.account)
+        .where(board: Current.user.boards)
+        .where(action: Event::ACTIVITY_ACTIONS)
+
+      activities = activities.where(creator_id: creator_ids) if creator_ids.present?
+      activities = activities.where(board: Current.user.boards.where(id: board_ids)) if board_ids.present?
+
+      activities.order(created_at: :desc, id: :desc)
+    end
+
+    def creator_ids
+      @creator_ids ||= param_ids(:creator_ids)
+    end
+
+    def board_ids
+      @board_ids ||= param_ids(:board_ids)
+    end
+
+    def param_ids(name)
+      value = params[name]
+      values = value.is_a?(Array) ? value : value.to_s.split(",")
+      values.filter_map { |id| id.to_s.strip.presence }
+    end
+end
