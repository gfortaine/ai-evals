diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..1af868c
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat newest-first activity array" do
+    get activities_path(format: :json)
+
+    assert_response :success
+
+    json = @response.parsed_body
+    assert json.is_a?(Array)
+
+    event = json.first
+    assert event.key?("id")
+    assert event.key?("action")
+    assert event.key?("created_at")
+    assert event.key?("description")
+    assert event.key?("particulars")
+    assert event.key?("url")
+    assert event.key?("eventable_type")
+    assert event.key?("eventable")
+    assert event.key?("board")
+    assert event.key?("creator")
+  end
+
+  test "index as JSON includes card and comment event details" do
+    get activities_path(format: :json)
+
+    json = @response.parsed_body
+
+    assignment = json.find do |event|
+      event["action"] == "card_assigned" &&
+        event["eventable"]["id"] == cards(:logo).id &&
+        event["particulars"]["assignee_ids"] == [ users(:kevin).id ]
+    end
+    assert_equal [ users(:kevin).id ], assignment["particulars"]["assignee_ids"]
+
+    comment = json.find { |event| event["action"] == "comment_created" }
+    comment_record = Comment.find(comment["eventable"]["id"])
+    assert_equal card_url(comment_record.card,
+      anchor: ActionView::RecordIdentifier.dom_id(comment_record)), comment["url"]
+  end
+
+  test "index as JSON exposes event particulars" do
+    events(:logo_published).update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+    events(:logo_assignment_jz).update_columns(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "New board" } }
+    )
+    events(:layout_assignment_jz).update_columns(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+
+    missing_title = events(:text_published)
+    missing_title.update_columns(action: "card_title_changed", particulars: {})
+
+    get activities_path(format: :json)
+
+    json = @response.parsed_body
+
+    title = json.find { |event| event["id"] == events(:logo_published).id }
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, title["particulars"])
+
+    board = json.find { |event| event["id"] == events(:logo_assignment_jz).id }
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, board["particulars"])
+
+    triage = json.find { |event| event["id"] == events(:layout_assignment_jz).id }
+    assert_equal({ "column" => "In Progress" }, triage["particulars"])
+
+    missing = json.find { |event| event["id"] == missing_title.id }
+    assert_equal({ "old_title" => "", "new_title" => "" }, missing["particulars"])
+
+    published = json.find { |event| event["action"] == "card_published" }
+    assert_equal({}, published["particulars"])
+  end
+
+  test "index as JSON can filter by creator and board" do
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:david).id ],
+      board_ids: [ boards(:writebook).id ]
+    }
+
+    assert_response :success
+    @response.parsed_body.each do |event|
+      assert_equal users(:david).id, event["creator"]["id"]
+      assert_equal boards(:writebook).id, event["board"]["id"]
+    end
+  end
+
+test "index as JSON paginates in newest-first order" do
+  account = accounts("37s")
+  board = boards("writebook")
+  creator = users("kevin")
+  card = cards("logo")
+  newest = Time.current.change(usec: 0)
+
+  rows = 200.times.map do |index|
+    {
+      id: ActiveRecord::Type::Uuid.generate,
+      account_id: account.id,
+      board_id: board.id,
+      creator_id: creator.id,
+      eventable_id: card.id,
+      eventable_type: "Card",
+      action: "card_published",
+      particulars: {},
+      created_at: newest - index.seconds,
+      updated_at: newest - index.seconds
+    }
+  end
+  Event.insert_all(rows)
+
+  expected_ids = Event
+    .where(account: account, board: account.boards.where(id: board.id), action: Event::ACTIVITY_ACTIONS)
+    .order(created_at: :desc, id: :desc)
+    .pluck(:id)
+
+  actual_ids = []
+  next_page = activities_path(format: :json)
+  page_count = 0
+
+  while next_page
+    get next_page, as: :json
+    assert_response :success
+
+    page_count += 1
+    actual_ids.concat(@response.parsed_body.map { |event| event["id"] })
+    next_page = next_page_from_link_header(@response.headers["Link"])
+  end
+
+  assert_equal expected_ids, actual_ids
+  assert_operator page_count, :>, 1
+end
+
+  test "index as JSON omits inaccessible and deprecated activity" do
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_published",
+      created_at: 1.minute.ago
+    )
+
+    deprecated_event = boards(:writebook).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_collection_changed",
+      created_at: 30.seconds.ago
+    )
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+
+    ids = @response.parsed_body.map { |event| event["id"] }
+    assert_not_includes ids, private_event.id
+    assert_not_includes ids, deprecated_event.id
+  end
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>; *rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
