diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..117ae5e
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,69 @@
+particulars = activity.particulars.is_a?(Hash) ? activity.particulars : {}
+nested_particulars = particulars["particulars"] || particulars[:particulars]
+details = nested_particulars.is_a?(Hash) ? nested_particulars : particulars
+
+particular_value = lambda do |key|
+  if details.key?(key)
+    details[key]
+  elsif details.key?(key.to_sym)
+    details[key.to_sym]
+  elsif particulars.key?(key)
+    particulars[key]
+  else
+    particulars[key.to_sym]
+  end
+end
+
+api_particulars = case activity.action.to_s
+when "card_assigned", "card_unassigned"
+  assignee_ids = particular_value.call("assignee_ids") || activity.assignee_ids
+  { "assignee_ids" => Array(assignee_ids).compact_blank }
+when "card_board_changed"
+  old_board = particular_value.call("old_board")
+  new_board = particular_value.call("new_board")
+  {
+    "old_board" => old_board.nil? ? "" : old_board.to_s,
+    "new_board" => new_board.nil? ? "" : new_board.to_s
+  }
+when "card_title_changed"
+  old_title = particular_value.call("old_title")
+  new_title = particular_value.call("new_title")
+  {
+    "old_title" => old_title.nil? ? "" : old_title.to_s,
+    "new_title" => new_title.nil? ? "" : new_title.to_s
+  }
+when "card_triaged", "card_sent_back_to_triage"
+  column = particular_value.call("column")
+  { "column" => column.nil? ? "" : column.to_s }
+else
+  {}
+end
+
+json.(activity, :id)
+json.action activity.action.to_s
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text
+json.particulars api_particulars
+
+case activity.eventable
+when Card
+  json.url card_url(activity.eventable)
+when Comment
+  json.url card_url(activity.eventable.card,
+    anchor: ActionView::RecordIdentifier.dom_id(activity.eventable))
+else
+  json.url nil
+end
+
+json.eventable_type activity.eventable_type
+json.eventable do
+  case activity.eventable
+  when Card
+    json.partial! "cards/card", card: activity.eventable
+  when Comment
+    json.partial! "cards/comments/comment", comment: activity.eventable
+  end
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
