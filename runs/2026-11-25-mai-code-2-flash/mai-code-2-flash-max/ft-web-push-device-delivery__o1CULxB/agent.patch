diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..7171fc7
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,52 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription_params = push_subscription_params
+    @push_subscription = PushSubscription.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @push_subscription.assign_attributes(subscription_params)
+    @push_subscription.user = @user
+    @push_subscription.account = Current.account
+    @push_subscription.save!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned on" }
+      format.json { render json: { id: @push_subscription.id }, status: :created }
+    end
+  end
+
+  def destroy
+    @push_subscription = find_push_subscription
+    @push_subscription&.destroy!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned off" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+
+    def find_push_subscription
+      if params[:id].present?
+        @user.push_subscriptions.find_by(id: params[:id]) || @user.push_subscriptions.find_by(endpoint: params[:id])
+      else
+        endpoint = params[:endpoint] || params.dig(:push_subscription, :endpoint)
+        @user.push_subscriptions.find_by(endpoint: endpoint) if endpoint
+      end
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..8c602b8
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,113 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["details", "unsupported"]
+  static values = { url: String, userId: String, vapidPublicKey: String }
+
+  async connect() {
+    if (!("serviceWorker" in navigator && "PushManager" in window && "Notification" in window)) {
+      this.element.classList.remove("notifications--on")
+      this.unsupportedTarget.hidden = false
+      this.element.querySelectorAll(".notifications__status button").forEach(button => button.disabled = true)
+      return
+    }
+
+    this.unsupportedTarget.hidden = true
+    await navigator.serviceWorker.register("/service-worker.js")
+    await this.refresh()
+  }
+
+  async subscribe(event) {
+    event?.preventDefault()
+
+    if (!this.vapidPublicKeyValue) return
+
+    const permission = Notification.permission === "granted" ? "granted" : await Notification.requestPermission()
+    if (permission !== "granted") {
+      await this.refresh()
+      return
+    }
+
+    await navigator.serviceWorker.register("/service-worker.js")
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey()
+      })
+    }
+
+    const subscriptionJSON = subscription.toJSON()
+    await this.#send("POST", {
+      push_subscription: {
+        endpoint: subscription.endpoint,
+        p256dh_key: subscriptionJSON.keys.p256dh,
+        auth_key: subscriptionJSON.keys.auth
+      }
+    })
+
+    await this.refresh()
+  }
+
+  async unsubscribe(event) {
+    event?.preventDefault()
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription) {
+      await this.#send("DELETE", { push_subscription: { endpoint: subscription.endpoint } })
+      await subscription.unsubscribe()
+    }
+
+    await this.refresh()
+  }
+
+  toggle(event) {
+    if (this.element.classList.contains("notifications--on")) {
+      this.unsubscribe(event)
+    } else {
+      this.subscribe(event)
+    }
+  }
+
+  async refresh() {
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription()
+    const subscribed = subscription && Notification.permission === "granted"
+
+    this.element.classList.toggle("notifications--on", !!subscribed)
+
+    this.detailsTargets.forEach(details => {
+      details.hidden = subscribed || Notification.permission === "default"
+    })
+
+    this.element.querySelectorAll(".notifications__status button").forEach(button => {
+      button.disabled = Notification.permission === "denied"
+    })
+  }
+
+  #applicationServerKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+    const bytes = atob(padded)
+
+    return Uint8Array.from(bytes, character => character.charCodeAt(0))
+  }
+
+  async #send(method, body) {
+    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content
+
+    await fetch(this.urlValue, {
+      method,
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": csrfToken
+      },
+      body: JSON.stringify(body)
+    })
+  }
+}
