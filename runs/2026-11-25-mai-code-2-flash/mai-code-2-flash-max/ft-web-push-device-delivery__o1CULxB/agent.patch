+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = PushSubscription.new(
+      user: users(:david),
+      endpoint: "https://push.example.test/subscription",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+  end
+
+  test "belongs to the user account" do
+    @subscription.save!
+
+    assert_equal users(:david), @subscription.user
+    assert_equal users(:david).account, @subscription.account
+  end
+
+  test "delivers the notification payload with VAPID keys" do
+    @subscription.save!
+    notification = notifications(:logo_assignment_kevin)
+
+    old_public_key = ENV["VAPID_PUBLIC_KEY"]
+    old_private_key = ENV["VAPID_PRIVATE_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = "public-key"
+    ENV["VAPID_PRIVATE_KEY"] = "private-key"
+
+    WebPush.expects(:payload_send).with do |options|
+      assert_equal @subscription.endpoint, options[:endpoint]
+      assert_equal @subscription.p256dh_key, options[:p256dh]
+      assert_equal @subscription.auth_key, options[:auth]
+      assert_equal "public-key", options[:vapid][:public_key]
+      assert_equal "private-key", options[:vapid][:private_key]
+
+      payload = JSON.parse(options[:message])
+      assert_equal notification.push_payload[:title], payload["title"]
+      assert_equal notification.push_payload[:body], payload["body"]
+      assert_equal notification.push_payload[:url], payload["url"]
+      true
+    end
+
+    @subscription.deliver(notification)
+  ensure
+    ENV["VAPID_PUBLIC_KEY"] = old_public_key
+    ENV["VAPID_PRIVATE_KEY"] = old_private_key
+  end
+end
