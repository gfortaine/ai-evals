+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+  end
+
+  test "create registers a push subscription as JSON" do
+    assert_difference -> { PushSubscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscription",
+          p256dh_key: "p256dh",
+          auth_key: "auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal @user, subscription.user
+    assert_equal @user.account, subscription.account
+    assert_equal "https://push.example.test/subscription", subscription.endpoint
+  end
+
+  test "create reuses a subscription for the same endpoint" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: {
+        endpoint: "https://push.example.test/subscription",
+        p256dh_key: "old-p256dh",
+        auth_key: "old-auth"
+      }
+    }, as: :json
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscription",
+          p256dh_key: "new-p256dh",
+          auth_key: "new-auth"
+        }
+      }, as: :json
+    end
+
+    subscription = @user.push_subscriptions.find_by!(endpoint: "https://push.example.test/subscription")
+    assert_equal "new-p256dh", subscription.p256dh_key
+    assert_equal "new-auth", subscription.auth_key
+  end
+
+  test "cannot register a subscription for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: {
+      push_subscription: {
+        endpoint: "https://push.example.test/subscription",
+        p256dh_key: "p256dh",
+        auth_key: "auth"
+      }
+    }, as: :json
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes a push subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscription",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy accepts the subscription endpoint" do
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscription",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "https://push.example.test/subscription" }
+      }, as: :json
+    end
+
+    assert_response :no_content
+  end
+end
