@@ -71,6 +71,67 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
     assert_nil result[:error]
   end
 
+  test "deliver_now posts exactly once and records a successful response" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 200, body: "ok")
+
+    assert delivery.deliver_now
+    assert_not delivery.deliver_now
+    assert_requested :post, webhook.url, times: 1
+
+    assert delivery.reload.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_nil delivery.response[:error]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request.dig("headers", "User-Agent")
+    assert_equal "application/json", delivery.request.dig("headers", "Content-Type")
+    assert delivery.request.dig("headers", "X-Webhook-Signature").present?
+  end
+
+  test "deliver_now records HTTP failures and non-2xx responses" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 422, body: "unprocessable")
+
+    delivery.deliver_now
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 422, delivery.response[:code]
+  end
+
+  test "deliver_now records unreachable destinations as errored" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_timeout
+
+    delivery.deliver_now
+
+    assert delivery.reload.errored?
+    assert delivery.failed?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "cleanup deletes deliveries older than one week" do
+    webhook = webhooks(:active)
+    old_delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    old_delivery.update_column(:created_at, 8.days.ago)
+
+    recent_delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+
   test "response_summary returns nil when response is blank" do
     delivery = webhook_deliveries(:pending)
     delivery.update_columns(response: nil)
