@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  test "relay_now creates exactly one delivery for each subscribed webhook" do
+    webhook = webhooks(:active)
+    event = board.events.create!(
+      action: "card_published",
+      creator: users(:david),
+      eventable: cards(:logo)
+    )
+
+    assert_difference -> { webhook.deliveries.where(event: event).count }, 1 do
+      event.relay_now
+    end
+
+    assert_no_difference -> { webhook.deliveries.where(event: event).count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now ignores inactive and unsubscribed webhooks" do
+    board = boards(:writebook)
+    board.webhooks.active.update_all(active: false)
+
+    inactive_event = board.events.create!(
+      action: "card_published",
+      creator: users(:david),
+      eventable: cards(:logo)
+    )
+
+    assert_no_difference "Webhook::Delivery.count" do
+      inactive_event.relay_now
+    end
+
+    board.webhooks.find_each { |record| record.update!(active: true, subscribed_actions: [ "card_closed" ]) }
+    unsubscribed_event = board.events.create!(
+      action: "card_published",
+      creator: users(:david),
+      eventable: cards(:logo)
+    )
+
+    assert_no_difference "Webhook::Delivery.count" do
+      unsubscribed_event.relay_now
+    end
+  end
+
+  private
+    def board
+      boards(:writebook)
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
