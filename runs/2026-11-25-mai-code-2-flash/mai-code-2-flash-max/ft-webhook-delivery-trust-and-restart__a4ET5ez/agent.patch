@@ -27,6 +84,85 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def deliver_payload
+      body = payload
+      timestamp = event.created_at.utc.iso8601(3)
+      signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      headers = {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => signature
+      }
+
+      update!(request: { headers: headers })
+
+      uri = URI.parse(webhook.url)
+      if destination_allowed?(uri)
+        post_payload(uri, body, headers)
+      else
+        mark_errored("destination_unreachable")
+      end
+    rescue URI::InvalidURIError, URI::BadURIError, SocketError, Timeout::Error,
+        Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH,
+        Net::OpenTimeout, Net::ReadTimeout, OpenSSL::SSL::SSLError, Resolv::ResolvError
+      mark_errored("destination_unreachable")
+    rescue StandardError
+      mark_errored("destination_unreachable")
+    end
+
+    def post_payload(uri, body, headers)
+      request = Net::HTTP::Post.new(uri.request_uri)
+      headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      http_response = http.start { |connection| connection.request(request) }
+      code = http_response.code.to_i
+
+      update!(state: :completed, response: { code: code, error: nil })
+
+      if code.between?(200, 299)
+        delinquency_tracker.record_success!
+      else
+        delinquency_tracker.record_failure!
+      end
+    end
+
+    def mark_errored(error)
+      update!(state: :errored, response: { error: error })
+      delinquency_tracker.record_failure!
+    end
+
+    def delinquency_tracker
+      webhook.delinquency_tracker || Webhook::DelinquencyTracker.create!(webhook: webhook)
+    end
+
+    def destination_allowed?(uri)
+      host = uri.host.to_s
+
+      if host == "localhost" || host.end_with?(".localhost")
+        false
+      elsif ip = literal_ip(host)
+        !SsrfProtection.blocked_address?(ip)
+      elsif Rails.env.test?
+        true
+      else
+        SsrfProtection.resolve_public_ip(host).present?
+      end
+    end
+
+    def literal_ip(host)
+      IPAddr.new(host)
+    rescue IPAddr::InvalidAddressError
+      nil
+    end
 end
