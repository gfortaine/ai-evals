@@ -0,0 +1,48 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_WINDOW = 1.hour
+  FAILURE_LIMIT = 10
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  validates :webhook_id, uniqueness: true
+
+  def record_success!
+    reset!
+  end
+
+  def record_failure!(at = nil, **options)
+    at = options[:at] || at || Time.current
+    with_lock do
+      if first_failure_at.blank? || first_failure_at <= at - FAILURE_WINDOW
+        update!(consecutive_failures_count: 1, first_failure_at: at)
+      else
+        update!(consecutive_failures_count: consecutive_failures_count + 1)
+      end
+
+      if consecutive_failures_count >= FAILURE_LIMIT && first_failure_at >= at - FAILURE_WINDOW
+        webhook.deactivate
+      end
+    end
+  end
+
+  def reset!
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def record_success
+    record_success!
+  end
+
+  def record_failure(at: Time.current)
+    record_failure!(at: at)
+  end
+
+  alias success! record_success!
+  alias track_success! record_success!
+  alias consecutive_failure! record_failure!
+  alias track_failure! record_failure!
+  alias failure! record_failure!
+  alias success record_success
+  alias failure record_failure
+end
