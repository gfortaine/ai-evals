+    if (ActiveSupport::IsolatedExecutionState[KEY] || 0).positive?
+      false
+    else
+      super
+    end
+  end
+end
+
+ActionDispatch::ExceptionWrapper.prepend(RaisedExceptionsTestSupport)
 
 module ActiveSupport
