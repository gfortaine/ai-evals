index 0000000..f25fb80
--- /dev/null
+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest formats the last edited date" do
+    book = books(:handbook)
+    book.update!(published: true, updated_at: Time.zone.local(2026, 11, 23, 12, 34, 56))
+
+    mail = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes mail.body.encoded, "Handbook, last edited 23 Nov"
+  end
+end
