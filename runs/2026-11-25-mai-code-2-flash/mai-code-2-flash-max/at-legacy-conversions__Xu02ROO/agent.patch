diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..fbc2cd2
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show formats the shelf report date and summary" do
+    book = books(:handbook)
+    book.update!(updated_at: Time.zone.local(2026, 11, 23, 12, 34, 56))
+
+    get book_report_path(book)
+
+    assert_response :success
+    assert_in_body "Last updated November 23, 2026"
+  end
+
+  test "text card uses formatted dates, filename timestamp, and cover ids" do
+    book = books(:handbook)
+    book.update_columns(
+      created_at: Time.zone.local(2026, 11, 23, 12, 34, 56),
+      updated_at: Time.zone.local(2026, 11, 23, 12, 34, 56)
+    )
+
+    get book_report_path(book, format: :text)
+
+    assert_response :success
+    assert_in_body "Started: November 23, 2026"
+    assert_in_body "Updated: 23 Nov"
+    assert_in_body "Covers: #{book.leaves.active.positioned.map(&:id).join(",")}"
+    assert_includes response.headers["Content-Disposition"], "shelf-report-20261123123456.txt"
+  end
+end
diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..57b6115
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  setup do
+    @book = books(:handbook)
+    @path = Rails.root.join("storage/archives", "book-#{@book.id}.txt")
+  end
+
+  teardown do
+    FileUtils.rm_f @path
+  end
+
+  test "perform writes the database formatted archive timestamp" do
+    timestamp = Time.zone.local(2026, 11, 23, 12, 34, 56)
+    @book.leaves.active.update_all(updated_at: timestamp)
+
+    ReportArchiveJob.perform_now(@book)
+
+    assert_includes File.read(@path), "# archived 2026-11-23 12:34:56"
+  end
+end
diff --git a/test/mailers/report_digest_mailer_test.rb b/test/mailers/report_digest_mailer_test.rb
