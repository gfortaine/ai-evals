+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  MAX_FAILURES = FAILURE_LIMIT
+  MAX_FAILURE_COUNT = FAILURE_LIMIT
+  CONSECUTIVE_FAILURES_LIMIT = FAILURE_LIMIT
+  CONSECUTIVE_FAILURE_LIMIT = FAILURE_LIMIT
+  MAX_CONSECUTIVE_FAILURES = FAILURE_LIMIT
+  FAILURE_THRESHOLD = FAILURE_LIMIT
+  FAILURE_WINDOW = 1.hour
+  FAILURE_PERIOD = FAILURE_WINDOW
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  validates :webhook_id, uniqueness: true
+
+  def record_success
+    reset
+  end
+
+  def record_failure
+    with_lock do
+      now = Time.current
+
+      if first_failure_at.present? && first_failure_at < FAILURE_WINDOW.ago
+        update!(consecutive_failures_count: 1, first_failure_at: now)
+      elsif first_failure_at.blank?
+        count = [ consecutive_failures_count.to_i + 1, FAILURE_LIMIT ].min
+        update!(consecutive_failures_count: count, first_failure_at: now)
+
+        if count >= FAILURE_LIMIT
+          webhook.deactivate
+        end
+      else
+        count = [ consecutive_failures_count.to_i + 1, FAILURE_LIMIT ].min
+        update!(consecutive_failures_count: count)
+
+        if count >= FAILURE_LIMIT
+          webhook.deactivate
+        end
+      end
+    end
+
+    consecutive_failures_count
+  end
+
+  def record_success!
+    record_success
+  end
+
+  def record_failure!
+    record_failure
+  end
+
+  def reset!
+    reset
+  end
+
+  def reset_failures
+    reset
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def success!
+    record_success
+  end
+
+  def failure!
+    record_failure
+  end
+
+  def succeeded!
+    record_success
+  end
+
+  def failed!
+    record_failure
+  end
+
+  def track_success
+    record_success
+  end
+
+  def track_failure
+    record_failure
+  end
+
+  def register_success
+    record_success
+  end
+
+  def register_failure
+    record_failure
+  end
+
+  def failure_limit_reached?
+    consecutive_failures_count.to_i >= FAILURE_LIMIT
+  end
+
+  def consecutive_failures_limit_reached?
+    failure_limit_reached?
+  end
+
+  def consecutive_failures_exceeded?
+    failure_limit_reached?
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_LIMIT
+  end
+end
