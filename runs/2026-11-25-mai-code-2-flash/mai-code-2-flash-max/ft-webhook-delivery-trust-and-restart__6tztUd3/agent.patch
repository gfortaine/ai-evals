+class Webhook::RelayJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(delivery_or_webhook, event = nil)
+    if event
+      delivery = delivery_or_webhook.deliveries.create_or_find_by!(event: event)
+    else
+      delivery = delivery_or_webhook
+    end
+
+    delivery.deliver_now
+  end
+end
