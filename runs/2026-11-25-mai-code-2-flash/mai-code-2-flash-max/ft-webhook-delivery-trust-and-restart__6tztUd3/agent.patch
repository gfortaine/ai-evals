     assert_nil delivery.response_summary
   end
+
+  test "cleanup deletes deliveries older than one week" do
+    old_delivery = webhook_deliveries(:successfully_completed)
+    recent_delivery = webhook_deliveries(:pending)
+
+    old_delivery.update_columns(created_at: 8.days.ago)
+    recent_delivery.update_columns(created_at: 6.days.ago)
+
+    old_count = Webhook::Delivery.count
+    Webhook::Delivery.cleanup
+    assert_operator Webhook::Delivery.count, :<, old_count
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+
+  test "deliveries are unique per webhook and event" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    assert_raises ActiveRecord::RecordInvalid do
+      Webhook::Delivery.create!(webhook: webhook, event: event)
+    end
+
+    assert_equal 1, Webhook::Delivery.where(webhook: webhook, event: event).count
+  end
+
+  test "recording success resets consecutive failures" do
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+    tracker.update!(consecutive_failures_count: 9, first_failure_at: 30.minutes.ago)
+
+    webhook.record_success
+
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "ten failures within an hour deactivate the webhook" do
+    webhook = webhooks(:active)
+
+    9.times { webhook.record_failure }
+    assert webhook.active?
+
+    webhook.record_failure
+
+    assert_not webhook.reload.active?
+    assert_equal 10, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "failures older than one hour start a fresh window" do
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+    tracker.update!(consecutive_failures_count: 9, first_failure_at: 61.minutes.ago)
+
+    webhook.record_failure
+
+    assert webhook.reload.active?
+    assert_equal 1, tracker.reload.consecutive_failures_count
+  end
+
+  test "reactivating resets consecutive failures" do
+    webhook = webhooks(:inactive)
+    tracker = webhook.delinquency_tracker
+    tracker.update!(consecutive_failures_count: 10, first_failure_at: 10.minutes.ago)
+
+    webhook.activate
+
+    assert webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
 end
