+           Errno::EHOSTUNREACH, Errno::ENETUNREACH, IOError
+      update!(state: :errored, response: { error: "destination_unreachable" })
+      webhook.record_failure
+    rescue StandardError
+      update!(state: :errored, response: { error: "destination_unreachable" })
+      webhook.record_failure
+    end
+
+    def post(uri, body, headers)
+      return { error: "destination_unreachable" } unless public_destination?(uri)
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 5
+
+      resolved_ip = SsrfProtection.resolve_public_ip(uri.host)
+      http.ipaddr = resolved_ip if resolved_ip
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      response = http.start { it.request(request) }
+      { code: response.code.to_i, headers: response.to_hash }
+    end
