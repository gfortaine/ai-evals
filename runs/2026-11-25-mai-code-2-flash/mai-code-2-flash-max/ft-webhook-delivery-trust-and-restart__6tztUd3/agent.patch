diff --git a/app/models/webhook/relaying.rb b/app/models/webhook/relaying.rb
new file mode 100644
index 0000000..aed4bdc
--- /dev/null
+++ b/app/models/webhook/relaying.rb
@@ -0,0 +1,76 @@
+module Webhook::Relaying
+  extend ActiveSupport::Concern
+
+  def relay(event)
+    relay_later(event)
+  end
+
+  def relay_later(event)
+    return unless active? && subscribed_actions.include?(event.action.to_s)
+
+    delivery = deliveries.create_or_find_by!(event: event)
+    delivery.deliver_later if delivery.previously_new_record?
+    delivery
+  end
+
+  def relay_now(event)
+    return unless active? && subscribed_actions.include?(event.action.to_s)
+
+    delivery = deliveries.create_or_find_by!(event: event)
+    delivery.deliver_now
+    delivery
+  end
+
+  def deliver_later(event)
+    relay_later(event)
+  end
+
+  def deliver_now(event)
+    relay_now(event)
+  end
+
+  def payload_for(event)
+    description = event.description_for(event.creator).to_plain_text
+    description = CGI.unescapeHTML(description)
+
+    if for_slack?
+      { text: description }.as_json
+    elsif for_campfire?
+      { body: description }.as_json
+    elsif for_basecamp?
+      { content: description }.as_json
+    else
+      env = { script_name: account.slug }
+
+      if default_host = base_url_options[:host]
+        env[:http_host] = default_host
+      end
+
+      if base_url_options[:protocol]
+        env[:https] = base_url_options[:protocol] == "https"
+      end
+
+      ApplicationController.renderer.new(env).render(
+        template: "webhooks/event",
+        formats: [ :json ],
+        assigns: { event: event, account: account }
+      )
+    end
+  end
+
+  private
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+
+  public
+  def webhook_payload(event)
+    payload_for(event)
+  end
+
+  def payload(event)
+    payload_for(event)
+  end
+end
