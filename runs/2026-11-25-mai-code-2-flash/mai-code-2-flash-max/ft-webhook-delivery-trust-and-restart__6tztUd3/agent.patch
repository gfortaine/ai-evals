+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    board.webhooks.active.find_each.filter_map do |webhook|
+      if webhook.subscribed_actions.include?(action.to_s)
+        webhook.relay_later(self)
+      end
+    end
+  end
+
+  def relay(event = nil)
+    relay_later
+  end
+
+  def relay_all_later
+    relay_later
+  end
+
+  def relay_all_now
+    relay_now
+  end
+end
