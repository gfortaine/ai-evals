+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "public board is visible by key without authentication" do
+    get public_board_path(@board.public_id, script_name: nil)
+
+    assert_response :success
+    assert_select "h1", text: /Writebook/
+    assert_match "The logo", response.body
+    assert_match cards(:text).title, response.body
+  end
+
+  test "draft cards are not visible on a public board" do
+    draft = @board.cards.create!(creator: users(:kevin), title: "A secret draft", status: :drafted)
+
+    get public_board_path(@board.public_id, script_name: nil)
+
+    assert_response :success
+    assert_no_match draft.title, response.body
+  end
+
+  test "unpublished board is not visible" do
+    key = @board.public_id
+    @board.unpublish
+
+    get public_board_path(key, script_name: nil)
+
+    assert_response :not_found
+  end
+
+  test "wrong public key is not found" do
+    get public_board_path("not-a-public-key", script_name: nil)
+
+    assert_response :not_found
+  end
+
+  test "board json includes public url" do
+    get public_board_path(@board.public_id, format: :json, script_name: nil)
+
+    assert_response :success
+    assert_equal @board.public_url, @response.parsed_body["public_url"]
+  end
+end
