diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..8451083
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,44 @@
+module Board::Publication
+  extend ActiveSupport::Concern
+
+  included do
+    has_secure_token :public_id
+
+    alias_attribute :public_key, :public_id
+    alias_attribute :publication_key, :public_id
+    alias_attribute :public_token, :public_id
+
+    scope :published, -> { where.not(public_id: nil) }
+  end
+
+  def publish
+    regenerate_public_id unless published?
+  end
+
+  def unpublish
+    update!(public_id: nil)
+  end
+
+  def published?
+    public_id.present?
+  end
+
+  alias_method :public?, :published?
+
+  def public_url
+    public_board_url(public_id, **public_url_options) if published?
+  end
+
+  private
+    def public_board_url(key, **options)
+      Rails.application.routes.url_helpers.public_board_url(key, **options)
+    end
+
+    def public_url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+
+      base_options.merge(script_name: nil)
+    end
+end
