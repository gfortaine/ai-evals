+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publishing creates a public id and public url" do
+    assert_nil @board.public_url
+
+    @board.publish
+
+    assert @board.published?
+    assert_predicate @board.public_id, :present?
+    assert_equal "/public/boards/#{@board.public_id}", URI(@board.public_url).path
+  end
+
+  test "unpublishing removes the public id and public url" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.public_id
+    assert_nil @board.public_url
+  end
+
+  test "public key aliases the public id" do
+    @board.public_key = "test-public-key"
+
+    assert_equal "test-public-key", @board.public_id
+    assert_equal "test-public-key", @board.public_key
+  end
+end
