@@ -0,0 +1,27 @@
+class Boards::PublicationsController < ApplicationController
+  before_action :set_board
+  before_action :ensure_admin
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to board_path(@board), notice: "Board published" }
+      format.json { render "boards/show", status: :created, location: board_url(@board, format: :json) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to board_path(@board), notice: "Board unpublished" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_board
+      @board = Current.account.boards.find(params[:board_id])
+    end
+end
