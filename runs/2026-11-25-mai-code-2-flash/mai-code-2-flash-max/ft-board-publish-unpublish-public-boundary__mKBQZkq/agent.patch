diff --git a/app/views/public/boards/show.html.erb b/app/views/public/boards/show.html.erb
new file mode 100644
index 0000000..952c92c
--- /dev/null
+++ b/app/views/public/boards/show.html.erb
@@ -0,0 +1,38 @@
+<% @page_title = @board.name %>
+<% @body_class = "contained-scrolling" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="cards cards--grid">
+  <div class="cards__list hide-scrollbar">
+    <% @board.columns.sorted.each do |column| %>
+      <% cards = @cards.select { |card| card.column_id == column.id && card.active? } %>
+      <section class="public-board-column">
+        <h2 class="cards__header">
+          <%= link_to column.name, public_board_column_path(@board.public_id, column.id, script_name: nil) %>
+        </h2>
+        <%= render partial: "public/boards/card", collection: cards, as: :card, locals: { public_id: @board.public_id } %>
+      </section>
+    <% end %>
+
+    <% untriaged_cards = @cards.select(&:awaiting_triage?) %>
+    <% if untriaged_cards.any? %>
+      <section class="public-board-column">
+        <h2 class="cards__header">Maybe?</h2>
+        <%= render partial: "public/boards/card", collection: untriaged_cards, as: :card, locals: { public_id: @board.public_id } %>
+      </section>
+    <% end %>
+
+    <% closed_cards = @cards.select(&:closed?) %>
+    <% if closed_cards.any? %>
+      <section class="public-board-column">
+        <h2 class="cards__header">Done</h2>
+        <%= render partial: "public/boards/card", collection: closed_cards, as: :card, locals: { public_id: @board.public_id } %>
+      </section>
+    <% end %>
+  </div>
+</section>
