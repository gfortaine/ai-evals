+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "published card is visible by board key and card number" do
+    card = cards(:logo)
+
+    get public_board_card_path(@board.public_id, card.number, script_name: nil)
+
+    assert_response :success
+    assert_match "The logo", response.body
+  end
+
+  test "draft card is not visible" do
+    draft = @board.cards.create!(creator: users(:kevin), title: "Secret draft", status: :drafted)
+
+    get public_board_card_path(@board.public_id, draft.number, script_name: nil)
+
+    assert_response :not_found
+  end
+
+  test "published card json includes the public url" do
+    card = cards(:logo)
+
+    get public_board_card_path(@board.public_id, card.number, format: :json, script_name: nil)
+
+    assert_response :success
+    assert_equal card.number, @response.parsed_body["number"]
+    assert_match "public/boards", @response.parsed_body["url"]
+  end
+end
