@@ -1,12 +1,28 @@
 class TitleCleanupJob < ApplicationJob
-  def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+  def perform(last_leaf_id = nil)
+    leaves = Leaf.where(title_cleanup_completed: false)
+    leaves = leaves.where(id: last_leaf_id..) if last_leaf_id.present?
+
+    leaves.find_each(order: :asc) do |leaf|
+      leaf.with_lock do
+        next if leaf.title_cleanup_completed?
+
+        leaf.update!(
+          title: cleaned(leaf.title),
+          title_cleanup_completed: true
+        )
+      end
     end
   end
 
   private
     def cleaned(title)
-      title.delete_prefix('"').delete_suffix('"')
+      return title unless title.is_a?(String)
+
+      if title.length >= 2 && title.start_with?("\"") && title.end_with?("\"")
+        title.delete_prefix("\"").delete_suffix("\"")
+      else
+        title
+      end
     end
 end
