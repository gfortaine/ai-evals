diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..302dc3b
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  test "cleans only matching outer quotes and preserves inner quotes" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: '"The "Legacy" Chapter"')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal 'The "Legacy" Chapter', leaf.reload.title
+    assert leaf.title_cleanup_completed?
+  end
+
+  test "preserves a legitimate opening quoted phrase" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: '"Hello" world')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Hello" world', leaf.reload.title
+    assert leaf.title_cleanup_completed?
+  end
+
+  test "restarts after an interruption without repeating completed leaves" do
+    first = leaves(:welcome_section)
+    second = leaves(:welcome_page)
+    third = leaves(:summary_page)
+
+    first.update!(title: '"First Chapter"')
+    second.update!(title: '"Second Chapter"')
+    third.update!(title: '"Third Chapter"')
+
+    job = TitleCleanupJob.new
+    job.define_singleton_method(:cleaned) do |title|
+      raise "interrupted" if title == '"Second Chapter"'
+
+      title.length >= 2 && title.start_with?("\"") && title.end_with?("\"") ?
+        title.delete_prefix("\"").delete_suffix("\"") : title
+    end
+
+    assert_raises(RuntimeError) { job.perform }
+
+    assert_equal "First Chapter", first.reload.title
+    assert first.title_cleanup_completed?
+    assert_equal '"Second Chapter"', second.reload.title
+    refute second.title_cleanup_completed?
+
+    TitleCleanupJob.new.perform
+
+    assert_equal "First Chapter", first.reload.title
+    assert_equal "Second Chapter", second.reload.title
+    assert_equal "Third Chapter", third.reload.title
+    assert first.title_cleanup_completed?
+    assert second.title_cleanup_completed?
+    assert third.title_cleanup_completed?
+
+    TitleCleanupJob.new.perform
+
+    assert_equal "First Chapter", first.reload.title
+    assert_equal "Second Chapter", second.reload.title
+    assert_equal "Third Chapter", third.reload.title
+  end
+
+  test "a cursor resumes at and rechecks the current leaf" do
+    current = leaves(:welcome_page)
+    tail = leaves(:summary_page)
+    current.update!(title: '"Current Chapter"')
+    tail.update!(title: '"Tail Chapter"')
+
+    TitleCleanupJob.perform_now(current.id)
+
+    assert_equal "Current Chapter", current.reload.title
+    assert_equal "Tail Chapter", tail.reload.title
+    assert current.title_cleanup_completed?
+    assert tail.title_cleanup_completed?
+  end
+end
