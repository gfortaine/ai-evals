diff --git a/test/jobs/card/auto_postpone_due_job_test.rb b/test/jobs/card/auto_postpone_due_job_test.rb
new file mode 100644
index 0000000..cea29cd
--- /dev/null
+++ b/test/jobs/card/auto_postpone_due_job_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Card::AutoPostponeDueJobTest < ActiveJob::TestCase
+  test "runs the entropy sweep" do
+    entropies(:writebook_board).destroy
+    card = cards(:logo)
+    card.update!(last_active_at: 1.day.ago - entropies("37s_account").auto_postpone_period)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card::AutoPostponeDueJob.perform_now
+    end
+
+    assert card.reload.postponed?
+  end
+
+  test "queued to backend" do
+    assert_equal "backend", Card::AutoPostponeDueJob.new.queue_name
+  end
+
+  test "has concurrency limit" do
+    job = Card::AutoPostponeDueJob.new
+
+    assert job.concurrency_limited?
+  end
+end
