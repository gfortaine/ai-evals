diff --git a/test/script/library_report_test.rb b/test/script/library_report_test.rb
new file mode 100644
index 0000000..3086498
--- /dev/null
+++ b/test/script/library_report_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "prints and logs each report line in order" do
+    events = []
+    logger = Object.new
+    logger.define_singleton_method(:info) { |message| events << [ :info, message ] }
+    logger.define_singleton_method(:warn) { |message| events << [ :warn, message ] }
+
+    original_logger = Rails.method(:logger)
+    Rails.define_singleton_method(:logger) { logger }
+
+    stdout = capture_io do
+      load Rails.root.join("script/library_report.rb")
+    end.first
+
+    Rails.define_singleton_method(:logger) { original_logger.call }
+
+    messages = events.map(&:last)
+
+    assert_equal messages, stdout.lines(chomp: true)
+    assert_equal [ :info, "Library report: 2 books" ], events.first
+    assert_includes events, [ :info, "Library report: Handbook has 4 pages" ]
+    assert_includes events, [ :warn, "Library report: Manual has no pages" ]
+    assert_equal [ :info, "Library report: done" ], events.last
+  ensure
+    Rails.define_singleton_method(:logger) { original_logger.call } if original_logger
+  end
+end
