diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..a50d2c3 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -1,6 +1,73 @@
 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  test "destroy archives every person who has access" do
+    book = Book.create!(title: "Archive me", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    expected = book.accesses.includes(:user).map do |access|
+      [ access.user_id, access.user.name, access.level ]
+    end
+
+    assert_difference "AccessArchive.count", +2 do
+      book.destroy!
+    end
+
+    archives = AccessArchive.where(book_id: book.id).map do |archive|
+      [ archive.user_id, archive.user_name, archive.level ]
+    end
+    assert_equal expected.sort, archives.sort
+  end
+
+  test "destroy does not archive someone whose access was revoked" do
+    book = Book.create!(title: "Archive current access", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    assert_difference "AccessArchive.count", +1 do
+      book.destroy!
+    end
+
+    archive = AccessArchive.find_by!(book_id: book.id)
+    assert_equal users(:kevin).id, archive.user_id
+    assert_equal users(:kevin).name, archive.user_name
+    assert_equal "editor", archive.level
+  end
+
+  test "destroying a book with no access creates no archive" do
+    book = Book.create!(title: "No access", everyone_access: false)
+
+    assert_no_difference "AccessArchive.count" do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "destroy_all for a book with no access creates no archive" do
+    book = Book.create!(title: "No access through destroy_all", everyone_access: false)
+
+    assert_no_difference "AccessArchive.count" do
+      Book.where(id: book.id).destroy_all
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "a rolled back destruction rolls back both grants and archive" do
+    book = Book.create!(title: "Rollback archive", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    assert_no_difference "AccessArchive.count" do
+      Book.transaction do
+        book.destroy!
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert Book.exists?(book.id)
+    assert_equal 2, book.accesses.count
+  end
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
