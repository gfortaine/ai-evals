+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ]
+
+  def index
+    set_page_and_extract_portion_from timeline_events
+  end
+
+  private
+    def timeline_events
+      events = Event.preloaded
+        .includes(
+          creator: :identity,
+          board: [ :publication, { creator: :identity } ],
+          eventable: [
+            { creator: :identity },
+            :assignees,
+            :tags,
+            :column,
+            { board: [ :publication, { creator: :identity } ] },
+            {
+              card: [
+                :assignees,
+                :tags,
+                :column,
+                { creator: :identity },
+                { board: [ :publication, { creator: :identity } ] }
+              ]
+            }
+          ]
+        )
+        .where(account: Current.account)
+        .where(board: filtered_boards)
+        .where(action: TIMELINEABLE_ACTIONS)
+
+      if creator_ids.any?
+        events = events.where(creator_id: creator_ids)
+      end
+
+      events.order(created_at: :desc, id: :desc)
+    end
+
+    def filtered_boards
+      if board_ids.any?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def board_ids
+      @board_ids ||= filter_ids(:board_ids)
+    end
+
+    def creator_ids
+      @creator_ids ||= filter_ids(:creator_ids)
+    end
+
+    def filter_ids(key)
+      Array(params[key]).flatten.flat_map { |id| id.to_s.split(",") }.compact_blank
+    end
+end
diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..4f123c0
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,50 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text.to_s
+
+  details = (event.particulars || {}).with_indifferent_access
+  details = details[:particulars].with_indifferent_access if details[:particulars].is_a?(Hash)
+
+  particulars = case event.action
+  when "card_assigned", "card_unassigned"
+    { assignee_ids: Array(details[:assignee_ids]).compact }
+  when "card_board_changed"
+    {
+      old_board: details[:old_board].presence || "",
+      new_board: details[:new_board].presence || ""
+    }
+  when "card_title_changed"
+    {
+      old_title: details[:old_title].presence || "",
+      new_title: details[:new_title].presence || ""
+    }
+  when "card_triaged"
+    { column: details[:column].presence || "" }
+  else
+    {}
+  end
+  json.particulars particulars
+
+  if event.action.comment_created?
+    comment = event.eventable
+    json.url card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment))
+  else
+    json.url card_url(event.eventable)
+  end
+
+  json.eventable_type event.eventable_type
+  json.eventable do
+    case event.eventable
+    when Card
+      json.partial! "cards/card", card: event.eventable
+    when Comment
+      json.partial! "cards/comments/comment", comment: event.eventable
+    else
+      json.nil!
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
