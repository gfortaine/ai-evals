diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..faa6525
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,193 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns timeline activity as a flat array" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_instance_of Array, @response.parsed_body
+    assert @response.parsed_body.any?
+
+    event = events(:layout_assignment_jz)
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_not_nil activity
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text.to_s, activity["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal event.eventable_type, activity["eventable_type"]
+    assert_equal event.eventable.id, activity["eventable"]["id"]
+    assert_equal event.board.id, activity["board"]["id"]
+    assert_equal event.creator.id, activity["creator"]["id"]
+  end
+
+  test "comment activity links to the card and comment anchor" do
+    event = events(:layout_commented)
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_not_nil activity
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal event.eventable.card.id, activity["eventable"]["card"]["id"]
+    assert_equal card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), activity["url"]
+  end
+
+  test "omits collection changes and includes title changes" do
+    collection_event = events(:layout_published)
+    collection_event.update_columns(action: "card_collection_changed")
+
+    title_event = events(:logo_published)
+    title_event.update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    ids = @response.parsed_body.map { |item| item["id"] }
+
+    assert_not_includes ids, collection_event.id
+    assert_includes ids, title_event.id
+
+    activity = @response.parsed_body.find { |item| item["id"] == title_event.id }
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity["particulars"])
+  end
+
+  test "returns event-specific particulars with empty missing values" do
+    board_event = events(:logo_published)
+    board_event.update_columns(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old board" } }
+    )
+
+    title_event = events(:layout_published)
+    title_event.update_columns(
+      action: "card_title_changed",
+      particulars: {}
+    )
+
+    triage_event = events(:text_published)
+    triage_event.update_columns(
+      action: "card_triaged",
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    board_activity = @response.parsed_body.find { |item| item["id"] == board_event.id }
+    title_activity = @response.parsed_body.find { |item| item["id"] == title_event.id }
+    triage_activity = @response.parsed_body.find { |item| item["id"] == triage_event.id }
+
+    assert_equal({ "old_board" => "Old board", "new_board" => "" }, board_activity["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, title_activity["particulars"])
+    assert_equal({ "column" => "" }, triage_activity["particulars"])
+  end
+
+  test "other events return empty particulars" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "filters by creator ids" do
+    get activities_path(format: :json, creator_ids: [ users(:david).id ])
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |item| item["creator"]["id"] == users(:david).id }
+  end
+
+  test "filters by board ids and excludes inaccessible boards" do
+    get activities_path(format: :json, board_ids: [ boards(:writebook).id ])
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |item| item["board"]["id"] == boards(:writebook).id }
+
+    sign_out
+    sign_in_as :david
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "does not expose activity from boards the current user cannot access" do
+    private_event = Event.create!(
+      account: accounts("37s"),
+      board: boards(:private),
+      creator: users(:kevin),
+      eventable: boards(:private).cards.create!(
+        title: "Private activity",
+        status: "drafted",
+        creator: users(:kevin)
+      ),
+      action: "card_published",
+      created_at: 1.minute.from_now
+    )
+
+    sign_out
+    sign_in_as :david
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    ids = @response.parsed_body.map { |item| item["id"] }
+    assert_not_includes ids, private_event.id
+  end
+
+  test "is newest first and paginates using the API link convention" do
+    card = cards(:text)
+
+    20.times do |index|
+      Event.create!(
+        account: accounts("37s"),
+        board: card.board,
+        creator: users(:kevin),
+        eventable: card,
+        action: "card_published",
+        created_at: 1.minute.from_now + index.seconds
+      )
+    end
+
+    activity_ids = []
+    next_page = activities_path(format: :json)
+
+    while next_page
+      get next_page
+      assert_response :success
+
+      activity_ids.concat(@response.parsed_body.map { |item| item["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_operator activity_ids.size, :>, 20
+    timestamps = activity_ids.filter_map do |id|
+      @response_body = nil
+      Event.find_by(id: id)&.created_at
+    end
+    assert_equal timestamps.sort.reverse, timestamps
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
