diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..30afac4
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "search handles apostrophes as text" do
+    sign_in :jz
+    leaves(:welcome_page).update!(title: "O'Reilly")
+
+    get library_search_path, params: { q: "O'Reilly" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+  end
+
+  test "search only returns pages in readable books" do
+    sign_in :kevin
+    books(:manual).press(Page.new(body: "Secret"), title: "Secret manual title")
+
+    get library_search_path, params: { q: "Secret manual title" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "search includes published books for signed out users" do
+    sign_out
+    leaves(:welcome_page).update!(title: "Public welcome")
+    books(:handbook).update!(published: true)
+
+    get library_search_path, params: { q: "Public welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+  end
+
+  test "percent signs are literal search characters" do
+    sign_in :jz
+    leaves(:welcome_page).update!(title: "Save 50% off")
+    leaves(:summary_page).update!(title: "Save 50 dollars off")
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+  end
+
+  test "underscores are literal search characters" do
+    sign_in :jz
+    leaves(:welcome_page).update!(title: "Save_50_off")
+    leaves(:summary_page).update!(title: "Save 50 off")
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+  end
+
+  test "ordinary case-insensitive title searches still work" do
+    sign_in :jz
+
+    get library_search_path, params: { q: "welcome to the" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+  end
+
+  test "punctuation and SQL-like text do not cause an error or broaden results" do
+    sign_in :jz
+
+    get library_search_path, params: { q: "%' OR 1=1 --" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+end
