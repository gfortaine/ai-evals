diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..89c5c23
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates canceled accounts after the grace period" do
+    due_account = accounts("37s")
+    recent_account = accounts("initech")
+    initiated_by = users(:david)
+
+    due_account.cancel(initiated_by: initiated_by)
+    recent_account.cancel(initiated_by: initiated_by)
+    due_account.cancellation.update!(created_at: 31.days.ago)
+    recent_account.cancellation.update!(created_at: 29.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..43809f1
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @due_account = accounts("37s")
+    @recent_account = accounts("initech")
+    @initiated_by = users(:david)
+
+    @due_account.cancel(initiated_by: @initiated_by)
+    @recent_account.cancel(initiated_by: @initiated_by)
+    @due_account.cancellation.update!(created_at: 31.days.ago)
+    @recent_account.cancellation.update!(created_at: 29.days.ago)
+  end
+
+  test "incineration due includes accounts canceled more than 30 days ago" do
+    assert_includes Account.incineration_due, @due_account
+    assert_not_includes Account.incineration_due, @recent_account
+  end
+
+  test "incinerate due destroys only canceled accounts past the grace period" do
+    board = boards(:writebook)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(@due_account.id)
+    assert Account.exists?(@recent_account.id)
+    assert_not Board.exists?(board.id)
+  end
+
+  test "an account canceled exactly 30 days ago is not due" do
+    travel_to Time.current do
+      @due_account.cancellation.update!(created_at: 30.days.ago)
+
+      assert_not_includes Account.incineration_due, @due_account
+    end
+  end
+
+  test "incinerate removes account storage entries and events" do
+    board = boards(:writebook)
+    entry = Storage::Entry.record(account: @due_account, board: board, delta: 128, operation: "attach")
+    event = events(:logo_published)
+
+    @due_account.incinerate
+
+    assert_not Storage::Entry.exists?(entry.id)
+    assert_not Event.exists?(event.id)
+  end
+
+  test "incinerate removes all rows keyed by the account" do
+    account_id = @due_account.id
+
+    @due_account.incinerate
+
+    connection = ActiveRecord::Base.connection
+    connection.tables.each do |table|
+      if connection.columns(table).any? { |column| column.name == "account_id" }
+        count = connection.select_value(
+          "SELECT COUNT(*) FROM #{connection.quote_table_name(table)} " \
+          "WHERE #{connection.quote_column_name("account_id")} = #{connection.quote(account_id)}"
+        ).to_i
+
+        assert_equal 0, count, "#{table} retained account #{account_id}"
+      end
+    end
+  end
+
+  test "incinerate removes account framework records" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create!(
+      account: @due_account,
+      key: "incineratable-test-blob",
+      filename: "test.txt",
+      content_type: "text/plain",
+      byte_size: 4,
+      checksum: Digest::MD5.base64digest("test"),
+      service_name: "test",
+      metadata: {}
+    )
+    attachment = ActiveStorage::Attachment.create!(
+      account: @due_account,
+      blob: blob,
+      name: "test_attachment",
+      record: card
+    )
+    rich_text = ActionText::RichText.create!(
+      account: @due_account,
+      record: card,
+      name: "test_rich_text",
+      body: "Test"
+    )
+
+    @due_account.incinerate
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActionText::RichText.exists?(rich_text.id)
+  end
+end
