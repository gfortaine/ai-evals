   end
+
+  private
+    def with_fragment_caching
+      memory_store = ActiveSupport::Cache::MemoryStore.new
+      old_cache_store = Rails.cache
+      old_controller_caching = ApplicationController.perform_caching
+      old_collection_cache = ActionView::PartialRenderer.collection_cache
+
+      Rails.cache = memory_store
+      ActionController::Base.perform_caching = true
+      ApplicationController.perform_caching = true
+      ActionController::Base.cache_store = memory_store
+      ActionView::PartialRenderer.collection_cache = memory_store
+
+      yield
+    ensure
+      Rails.cache.clear
+      Rails.cache = old_cache_store
+      ActionController::Base.perform_caching = old_controller_caching
+      ApplicationController.perform_caching = old_controller_caching
+      ActionController::Base.cache_store = old_cache_store
+      ActionView::PartialRenderer.collection_cache = old_collection_cache
+    end
 end
