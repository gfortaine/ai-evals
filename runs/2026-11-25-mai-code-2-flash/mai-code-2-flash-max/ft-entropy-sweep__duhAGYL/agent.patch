+class Card::AutoPostponeAllDueJob < ApplicationJob
+  queue_as :solid_queue_recurring
+
+  limits_concurrency key: -> { "card-auto-postpone-all-due" },
+    duration: 2.hours,
+    on_conflict: :discard
+
+  def perform
+    Card.auto_postpone_all_due
+  end
+end
