+  def highlight_search_terms(text, terms)
+    phrases = Array(terms).filter_map(&:presence).uniq
+    string = text.to_s
+
+    if phrases.empty?
+      ERB::Util.html_escape(string).html_safe
+    else
+      regex = Regexp.new(phrases.map { |phrase| Regexp.escape(phrase) }.join("|"), Regexp::IGNORECASE)
+      result = +""
+      cursor = 0
+
+      string.scan(regex) do
+        match = Regexp.last_match
+        result << ERB::Util.html_escape(string[cursor...match.begin(0)])
+        result << "<mark>"
+        result << ERB::Util.html_escape(match[0])
+        result << "</mark>"
+        cursor = match.end(0)
+      end
+
+      result << ERB::Util.html_escape(string[cursor..-1])
+      result.html_safe
+    end
+  end
+
+  def format_search_excerpt(content, terms, length: 200)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text = text.gsub(/\s+/, " ").strip
+    return "" if text.blank?
+
+    phrases = Array(terms).filter_map(&:presence)
+    match_indexes = phrases.filter_map { |phrase| text.downcase.index(phrase.downcase) }
+
+    if text.length <= length
+      text
+    elsif match_indexes.any?
+      start_at = [ 0, match_indexes.min - (length / 3) ].max
+      excerpt = text[start_at, length]
+      [ start_at.positive? ? "..." : "", excerpt, text.length > start_at + excerpt.length ? "..." : "" ].join
+    else
+      text.first(length)
+    end
+  end
+
+  def search_text_matches?(text, terms)
+    searchable_text = text.to_s.downcase
+    Array(terms).filter_map(&:presence).all? { |term| searchable_text.include?(term.downcase) }
+  end
+
+  def card_html_search_title(card, terms)
+    card.title.to_s.split(/(`[^`]*`)/).map do |part|
+      if part.start_with?("`") && part.end_with?("`") && part.length > 2
+        tag.code(highlight_search_terms(part[1...-1], terms))
+      else
+        highlight_search_terms(part, terms)
+      end
+    end.join.html_safe
+  end
+
   def card_html_title(card)
     return card.title if card.title.blank?
 
-    ERB::Util.html_escape(card.title).gsub(/`([^`]+)`/, '<code>\1</code>').html_safe
