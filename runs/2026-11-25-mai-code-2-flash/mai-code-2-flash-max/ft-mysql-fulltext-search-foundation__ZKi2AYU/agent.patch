@@ -0,0 +1,82 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles and highlights matches" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select ".search-result", text: /logo/i
+    assert_select ".search-result mark", text: "logo"
+  end
+
+  test "searches card descriptions" do
+    cards(:logo).update!(description: "A unique prism in the ocean")
+
+    get search_path, params: { q: "prism" }
+
+    assert_response :success
+    assert_select ".search-result", text: /prism/i
+    assert_select ".search-result mark", text: "prism"
+  end
+
+  test "searches comment bodies and highlights matches" do
+    cards(:layout).comments.create!(creator: users(:kevin), body: "A comet-shaped issue")
+
+    get search_path, params: { q: "comet" }
+
+    assert_response :success
+    assert_select ".search-result", text: /comet/i
+    assert_select ".search-result mark", text: "comet"
+  end
+
+  test "only searches cards in boards the current user can access" do
+    get search_path, params: { q: "radio" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    board = boards(:writebook)
+    board.update!(all_access: false)
+    board.accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "logo" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "never searches draft cards" do
+    board = boards(:writebook)
+    board.cards.create!(creator: users(:kevin), title: "Hidden chronosearch draft", status: :drafted)
+
+    get search_path, params: { q: "chronosearch" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "returns matches newest first" do
+    board = boards(:writebook)
+    older = nil
+    newer = nil
+    with_current_user(users(:kevin)) do
+      older = board.cards.create!(creator: users(:kevin), title: "Older chronosearch card", status: :published, created_at: 2.hours.ago)
+      newer = board.cards.create!(creator: users(:kevin), title: "Newer chronosearch card", status: :published, created_at: 1.hour.ago)
+    end
+
+    get search_path, params: { q: "chronosearch" }
+
+    assert_response :success
+    assert_operator response.body.index(newer.title), :<, response.body.index(older.title)
+  end
+
+  test "blank searches return no cards" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select ".blank-slate", text: "Enter a search term"
+  end
+end
