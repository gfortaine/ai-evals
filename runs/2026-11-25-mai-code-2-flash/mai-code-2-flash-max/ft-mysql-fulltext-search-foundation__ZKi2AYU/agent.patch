diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..b8091a7
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,60 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<div class="search-page">
+  <%= form_with url: search_path, method: :get, class: "search-page__form", role: "search" do %>
+    <%= search_field_tag :q, @query, placeholder: "Search cards", class: "input full-width", autofocus: true, autocomplete: "off" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <section class="cards cards--grid">
+        <div class="cards__list hide-scrollbar">
+          <% @cards.each do |card| %>
+            <% description = card.description&.to_plain_text.to_s %>
+            <% matching_comments = card.comments.filter_map do |comment|
+              comment_text = comment.body&.to_plain_text.to_s
+              comment if search_text_matches?(comment_text, @search_terms)
+            end %>
+
+            <%= card_article_tag card, class: "card search-result" do %>
+              <%= link_to card_path(card), class: "card__link", data: { turbo_frame: "_top" } do %>
+                <span class="for-screen-reader"><%= card.title %></span>
+              <% end %>
+
+              <header class="card__header">
+                <span class="card__search-board overflow-ellipsis"><%= card.board.name %></span>
+              </header>
+
+              <div class="card__body justify-space-between">
+                <div class="card__content">
+                  <h3 class="card__title overflow-line-clamp"><%= card_html_search_title(card, @search_terms) %></h3>
+
+                  <% if search_text_matches?(description, @search_terms) %>
+                    <div class="search-result__description"><%= highlight_search_terms(format_search_excerpt(description, @search_terms, length: 200), @search_terms) %></div>
+                  <% end %>
+
+                  <% matching_comments.each do |comment| %>
+                    <div class="search-result__comment">
+                      <span class="search-result__comment-label">Comment</span>
+                      <%= highlight_search_terms(format_search_excerpt(comment.body, @search_terms, length: 200), @search_terms) %>
+                    </div>
+                  <% end %>
+                </div>
+              </div>
+            <% end %>
+          <% end %>
+        </div>
+      </section>
+    <% else %>
+      <div class="blank-slate">No cards found</div>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">Enter a search term</div>
+  <% end %>
+</div>
