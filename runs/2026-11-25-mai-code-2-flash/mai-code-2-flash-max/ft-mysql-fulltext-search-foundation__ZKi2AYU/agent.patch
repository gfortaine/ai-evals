+class SearchesController < ApplicationController
+  def show
+    set_search
+    render "searches/show"
+  end
+
+  def index
+    set_search
+    render "searches/show"
+  end
+
+  private
+    def set_search
+      @query = params[:q].to_s.strip
+      @search_terms = @query.split(/\s+/).filter_map(&:presence)
+      @cards = if @query.present?
+        Current.user.accessible_cards.search(@query).includes(:board)
+      else
+        Card.none
+      end
+      @results = @cards
+      @search_results = @cards
+    end
+end
