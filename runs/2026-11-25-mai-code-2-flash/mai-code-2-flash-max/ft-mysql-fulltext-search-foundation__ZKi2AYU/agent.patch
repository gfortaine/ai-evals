@@ -0,0 +1,29 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(term) do
+      search_terms = term.to_s.strip.split(/\s+/).filter_map(&:presence)
+
+      if search_terms.empty?
+        none
+      else
+        searchable = published
+          .with_rich_text_description
+          .includes(comments: :rich_text_body)
+
+        matching_ids = searchable.filter_map do |card|
+          searchable_text = [
+            card.title,
+            card.description&.to_plain_text,
+            card.comments.map { |comment| comment.body&.to_plain_text }
+          ].flatten.compact.join(" ").downcase
+
+          card.id if search_terms.all? { |search_term| searchable_text.include?(search_term.downcase) }
+        end
+
+        searchable.where(id: matching_ids).reverse_chronologically
+      end
+    end
+  end
+end
