diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..5cf7ad5
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,30 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: true
+  validates :p256dh_key, :auth_key, presence: true
+
+  normalizes :endpoint, with: -> { it.strip }
+
+  def deliver(payload)
+    if configured?
+      WebPush.payload_send(
+        message: JSON.generate(payload),
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: {
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        }
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  end
+
+  def configured?
+    ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+  end
+end
