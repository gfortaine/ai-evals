new file mode 100644
index 0000000..a832255
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @subscription = users(:kevin).push_subscriptions.find_or_initialize_by(endpoint: "https://push.example.com/kevin")
+    @subscription.update!(account: users(:kevin).account, p256dh_key: "kevin-p256dh-key", auth_key: "kevin-auth-key")
+  end
+
+  test "create stores the device subscription" do
+    assert_difference -> { PushSubscription.count }, 1 do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/device",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = PushSubscription.find_by!(endpoint: "https://push.example.com/device")
+    assert_equal users(:kevin), subscription.user
+    assert_equal users(:kevin).account, subscription.account
+  end
+
+  test "create updates an existing subscription endpoint" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: @subscription.endpoint,
+          p256dh_key: "new-p256dh-key",
+          auth_key: "new-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh-key", @subscription.reload.p256dh_key
+  end
+
+  test "destroy removes the subscription by endpoint" do
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: { endpoint: @subscription.endpoint }
+      }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy removes the subscription by id" do
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscription_path(users(:kevin), @subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "create accepts browser PushSubscription keys shape" do
+    assert_difference -> { PushSubscription.count }, 1 do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/keys-shape",
+          keys: { p256dh: "browser-p256dh", auth: "browser-auth" }
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    subscription = PushSubscription.find_by!(endpoint: "https://push.example.com/keys-shape")
+    assert_equal "browser-p256dh", subscription.p256dh_key
+    assert_equal "browser-auth", subscription.auth_key
+  end
+
+  test "cannot take over a subscription registered to another user" do
+    david_subscription = users(:david).push_subscriptions.create!(
+      account: users(:david).account,
+      endpoint: "https://push.example.com/shared",
+      p256dh_key: "david-p256dh",
+      auth_key: "david-auth"
+    )
+
+    post user_push_subscriptions_path(users(:kevin)), params: {
+      push_subscription: {
+        endpoint: david_subscription.endpoint,
+        p256dh_key: "kevin-p256dh",
+        auth_key: "kevin-auth"
+      }
+    }, as: :json
+
+    assert_response :unprocessable_entity
+    assert_equal "david-p256dh", david_subscription.reload.p256dh_key
+  end
+
+  test "another user cannot register or remove subscriptions" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/other",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..75580f9
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.find_or_initialize_by(endpoint: "https://push.example.com/kevin")
+    @subscription.update!(account: users(:kevin).account, p256dh_key: "kevin-p256dh-key", auth_key: "kevin-auth-key")
+  end
+
+  test "deliver sends the tray payload with VAPID credentials" do
+    with_env "VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key" do
+      payload = { title: "Layout is broken", body: "David commented", url: "https://example.com/cards/2" }
+
+      WebPush.expects(:payload_send).with(
+        message: JSON.generate(payload),
+        endpoint: @subscription.endpoint,
+        p256dh: @subscription.p256dh_key,
+        auth: @subscription.auth_key,
+        vapid: { public_key: "public-key", private_key: "private-key" }
+      ).once
+
+      @subscription.deliver(payload)
+    end
+  end
+
+  test "deliver does nothing until VAPID credentials are configured" do
+    with_env "VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil do
+      WebPush.expects(:payload_send).never
+      @subscription.deliver(title: "Layout is broken")
+    end
+  end
+
+  test "expired subscription is removed" do
+    with_env "VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key" do
+      response = Struct.new(:body).new("Gone")
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(title: "Layout is broken")
+      end
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
