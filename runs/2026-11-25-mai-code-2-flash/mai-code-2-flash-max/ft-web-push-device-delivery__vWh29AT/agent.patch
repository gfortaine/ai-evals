diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..9dcdd2d
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,65 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_own_user
+
+  def create
+    attributes = push_subscription_params
+    existing = PushSubscription.find_by(endpoint: attributes[:endpoint])
+
+    if existing && existing.user != @user
+      head :unprocessable_entity
+      return
+    end
+
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: attributes[:endpoint])
+    subscription.update!(attributes.merge(user: @user, account: @user.account))
+
+    head :created
+  end
+
+  def destroy
+    subscription = if params[:id].present?
+      @user.push_subscriptions.find(params[:id])
+    elsif push_subscription_params[:endpoint].present?
+      @user.push_subscriptions.find_by(endpoint: push_subscription_params[:endpoint])
+    elsif params[:endpoint].present?
+      @user.push_subscriptions.find_by(endpoint: params[:endpoint])
+    else
+      nil
+    end
+
+    subscription&.destroy!
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_own_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      permitted = if params[:push_subscription].present?
+        params.require(:push_subscription).permit(:endpoint, :p256dh_key, :auth_key, :p256dh, :auth, keys: [ :p256dh, :auth ])
+      else
+        params.permit(:endpoint, :p256dh_key, :auth_key, :p256dh, :auth, keys: [ :p256dh, :auth ])
+      end
+      attributes = permitted.to_h.symbolize_keys
+
+      if attributes[:p256dh_key].blank?
+        attributes[:p256dh_key] = attributes.delete(:p256dh).presence || attributes.dig(:keys, :p256dh) || attributes.dig(:keys, "p256dh")
+      end
+      if attributes[:auth_key].blank?
+        attributes[:auth_key] = attributes.delete(:auth).presence || attributes.dig(:keys, :auth) || attributes.dig(:keys, "auth")
+      end
+
+      attributes = attributes.slice(:endpoint, :p256dh_key, :auth_key)
+      attributes[:p256dh_key] = nil if attributes[:p256dh_key].blank?
+      attributes[:auth_key] = nil if attributes[:auth_key].blank?
+      attributes
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..d606a9d
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,134 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "enableButton", "disableButton", "details" ]
+  static values = {
+    subscriptionsUrl: String,
+    vapidPublicKey: String
+  }
+
+  async connect() {
+    await this.#refresh()
+  }
+
+  async enable() {
+    if (!this.#supported() || !this.vapidPublicKeyValue) return
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      await this.#refresh()
+      return
+    }
+
+    const registration = await this.#serviceWorkerRegistration()
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey()
+    })
+
+    await this.#save(subscription)
+    await this.#refresh()
+  }
+
+  async disable() {
+    const registration = await navigator.serviceWorker?.getRegistration()
+    const subscription = await registration?.pushManager.getSubscription()
+
+    if (subscription) {
+      await destroy(this.subscriptionsUrlValue, {
+        body: { push_subscription: { endpoint: subscription.endpoint } },
+        responseKind: "json"
+      })
+      await subscription.unsubscribe()
+    }
+
+    await this.#refresh()
+  }
+
+  async #refresh() {
+    if (!this.#supported()) {
+      this.element.classList.remove("notifications--on")
+      this.enableButtonTarget.disabled = true
+      this.disableButtonTarget.hidden = true
+      this.enableButtonTarget.hidden = false
+      const permission = "Notification" in window ? Notification.permission : null
+      this.#showDetails(permission === "denied")
+      return
+    }
+
+    if (!this.vapidPublicKeyValue) {
+      this.element.classList.remove("notifications--on")
+      this.enableButtonTarget.disabled = true
+      this.disableButtonTarget.hidden = true
+      this.enableButtonTarget.hidden = false
+      this.#showDetails(false)
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.element.classList.remove("notifications--on")
+      this.enableButtonTarget.disabled = true
+      this.disableButtonTarget.hidden = true
+      this.enableButtonTarget.hidden = false
+      this.#showDetails(true)
+      return
+    }
+
+    const registration = await navigator.serviceWorker?.getRegistration()
+    const subscription = await registration?.pushManager.getSubscription()
+
+    if (Notification.permission === "granted" && subscription) {
+      await this.#save(subscription)
+      this.element.classList.add("notifications--on")
+      this.enableButtonTarget.hidden = true
+      this.disableButtonTarget.hidden = false
+      this.#showDetails(false)
+    } else {
+      this.element.classList.remove("notifications--on")
+      this.enableButtonTarget.disabled = false
+      this.enableButtonTarget.hidden = false
+      this.disableButtonTarget.hidden = true
+      this.#showDetails(false)
+    }
+  }
+
+  #supported() {
+    return "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+
+  async #serviceWorkerRegistration() {
+    await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    return await navigator.serviceWorker.ready
+  }
+
+  #applicationServerKey() {
+    const key = this.vapidPublicKeyValue
+    const base64 = key.replace(/-/g, "+").replace(/_/g, "/")
+    const padding = "=".repeat((4 - base64.length % 4) % 4)
+    const bytes = atob(base64 + padding)
+
+    return Uint8Array.from(bytes, (character) => character.charCodeAt(0))
+  }
+
+  async #save(subscription) {
+    const json = subscription.toJSON()
+
+    await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: json.keys?.p256dh,
+          auth_key: json.keys?.auth
+        }
+      },
+      responseKind: "json"
+    })
+  }
+
+  #showDetails(show) {
+    this.detailsTargets.forEach((details) => {
+      details.hidden = !show
+    })
+  }
+}
