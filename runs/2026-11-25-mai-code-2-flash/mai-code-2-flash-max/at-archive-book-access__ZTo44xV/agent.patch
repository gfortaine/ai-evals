diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..b8774d5 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -1,6 +1,49 @@
 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  test "destroy archives the access snapshot" do
+    book = Book.create!(title: "Archived Book", everyone_access: false)
+    book.accesses.create!(user: users(:kevin), level: :editor)
+    book.accesses.create!(user: users(:jz), level: :reader)
+
+    assert_difference -> { AccessArchive.count }, 2 do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal 2, archives.size
+    assert_equal "Archived Book", archives.fetch(users(:kevin).id).book_title
+    assert_equal "Kevin", archives.fetch(users(:kevin).id).user_name
+    assert_equal "editor", archives.fetch(users(:kevin).id).level
+    assert_equal "JZ", archives.fetch(users(:jz).id).user_name
+    assert_equal "reader", archives.fetch(users(:jz).id).level
+  end
+
+  test "destroy excludes access revoked before deletion" do
+    book = Book.create!(title: "Revoked Access", everyone_access: false)
+    book.accesses.create!(user: users(:kevin), level: :editor)
+    book.update_access(editors: [], readers: [])
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "destroy with no access archives nothing" do
+    book = Book.create!(title: "No Access", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
