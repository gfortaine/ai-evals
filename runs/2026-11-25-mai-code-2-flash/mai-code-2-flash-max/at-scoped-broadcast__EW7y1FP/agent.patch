+++ b/app/channels/being_edited_channel.rb
@@ -0,0 +1,43 @@
+class BeingEditedChannel < ApplicationCable::Channel
+  extend Turbo::Streams::Broadcasts, Turbo::Streams::StreamName
+  include Turbo::Streams::StreamName::ClassMethods
+
+  def subscribed
+    stream_name = verified_stream_name_from_params
+
+    if stream_name && authorized_stream?(stream_name)
+      stream_from stream_name
+    else
+      reject
+    end
+  end
+
+  private
+    def authorized_stream?(stream_name)
+      leaf, user = subscription_records(stream_name)
+
+      return false unless leaf && user
+      return false unless user == current_user
+      return false unless leaf.book.editable?(user: user)
+      return false unless leaf.book.editable_users.exists?(user.id)
+
+      stream_name == self.class.send(:stream_name_from, [ leaf, :being_edited, user ])
+    end
+
+    def subscription_records(stream_name)
+      leaf = Leaf.active.find_by(id: params[:leaf_id]) if params[:leaf_id].present?
+      user = User.active.find_by(id: params[:user_id]) if params[:user_id].present?
+
+      unless leaf && user
+        records = stream_name.split(":").filter_map do |component|
+          global_id = GlobalID.parse(component)
+          global_id.model_class.find_by(id: global_id.model_id) if global_id
+        end
+
+        leaf ||= records.find { |record| record.is_a?(Leaf) }
+        user ||= records.find { |record| record.is_a?(User) }
+      end
+
+      [ leaf, user ]
+    end
+end
