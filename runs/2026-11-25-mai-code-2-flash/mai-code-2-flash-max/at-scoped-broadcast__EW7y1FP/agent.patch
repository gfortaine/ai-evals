diff --git a/test/channels/being_edited_channel_test.rb b/test/channels/being_edited_channel_test.rb
new file mode 100644
index 0000000..dc6903e
--- /dev/null
+++ b/test/channels/being_edited_channel_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class BeingEditedChannelTest < ActionCable::Channel::TestCase
+  tests BeingEditedChannel
+
+  test "subscribes an authorized editor" do
+    leaf = leaves(:welcome_page)
+    user = users(:kevin)
+    stub_connection current_user: user
+
+    subscribe signed_stream_name: BeingEditedChannel.signed_stream_name([ leaf, :being_edited, user ]),
+      leaf_id: leaf.id, user_id: user.id
+
+    assert subscription.confirmed?
+  end
+
+  test "rejects a removed editor" do
+    leaf = leaves(:welcome_page)
+    user = users(:kevin)
+    stub_connection current_user: user
+    leaf.book.accesses.where(user: user).delete_all
+
+    subscribe signed_stream_name: BeingEditedChannel.signed_stream_name([ leaf, :being_edited, user ]),
+      leaf_id: leaf.id, user_id: user.id
+
+    assert subscription.rejected?
+  end
+
+  test "rejects a user who is not the stream recipient" do
+    leaf = leaves(:welcome_page)
+    recipient = users(:kevin)
+    stub_connection current_user: users(:jz)
+
+    subscribe signed_stream_name: BeingEditedChannel.signed_stream_name([ leaf, :being_edited, recipient ]),
+      leaf_id: leaf.id, user_id: recipient.id
+
+    assert subscription.rejected?
+  end
+
+  test "subscribes from the signed stream name when extra metadata is absent" do
+    leaf = leaves(:welcome_page)
+    user = users(:kevin)
+    stub_connection current_user: user
+
+    subscribe signed_stream_name: BeingEditedChannel.signed_stream_name([ leaf, :being_edited, user ])
+
+    assert subscription.confirmed?
+  end
+end
